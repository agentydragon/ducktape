# Dev tools from the flake's devShell.
# nix-direnv caches the evaluation so reload is fast.
# NOTE: bazelisk reads .bazelversion and auto-downloads the correct Bazel version.
watch_file nix/artifact-pins.json
watch_file nix/flake/devtools.nix
watch_file nix/flake/packages.nix
use flake

# Bazel's hermetic Python (python-build-standalone) has OpenSSL compiled with
# default cert paths for standard Linux (/etc/ssl/cert.pem). NixOS doesn't have
# that file — certs live at /etc/ssl/certs/ca-certificates.crt instead.
# Preserve a host-provided bundle (e.g. a runtime proxy CA); use system trust
# only when the caller has not selected one.
export SSL_CERT_FILE=${SSL_CERT_FILE:-/etc/ssl/certs/ca-certificates.crt}

# Hook profile (standalone YAML, loaded by the Rust claude-hook daemon).
export DUCKTAPE_CLAUDE_HOOKS_PROFILE=devinfra/claude/claude_hook/profiles/cli/profile.yaml

# Dev secrets (BuildBuddy API key, Docker mTLS). Does NOT export identity
# secrets (GITHUB_TOKEN, KUBECONFIG) — those come from personal config.
source devinfra/secrets/cli_env.sh
