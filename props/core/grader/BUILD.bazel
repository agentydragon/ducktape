    visibility = ["//props:__subpackages__"],
    deps = [
        ":loop",
        "//props/core:agent_helpers",
        "//props/core/db:session",
        "@pypi//jinja2",
    ],
)

py_binary(
    name = "main",
    srcs = ["main.py"],
    main = "main.py",
    visibility = ["//visibility:public"],
    deps = [":main_lib"],
)

pkg_tar(
    name = "main_tar",
    srcs = [":main"],
    include_runfiles = True,
    package_dir = "/app",
    strip_prefix = ".",
    visibility = ["//props:__subpackages__"],
)

