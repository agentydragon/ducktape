# =============================================================================
# In-container agent loop
# =============================================================================

py_library(
    name = "tools",
    srcs = ["tools.py"],
    imports = ["../../.."],
    visibility = ["//props:__subpackages__"],
    deps = [
        "@pypi//pydantic",
    ],
)

py_library(
    name = "loop",
    srcs = ["loop.py"],
    imports = ["../../.."],
    visibility = ["//props:__subpackages__"],
    deps = [
        ":drift_handler",
