)

critic_variant(
    name = "flag_propagation",
    agent_md = "flag_propagation.md",
)

critic_variant(
    name = "high_recall",
    agent_md = "high_recall_critic.md",
)

critic_variant(
    name = "verbose_docs",
    agent_md = "verbose_docs.md",
)
