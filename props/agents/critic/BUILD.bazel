"""Critic agent - implementation and container image.

Build targets:
    bazel run //props/agents/critic:load  -- Load into local Docker
    bazel run //props/agents/critic:push  -- Push to local registry (localhost:8000)

The container runs an agent loop that:
1. Fetches snapshot to /workspace
2. Renders system prompt from template
3. Queries LLM via proxy (OPENAI_BASE_URL)
4. Executes shell commands via exec tool
5. Handles critic tools (insert_issue, submit, etc.) in Python
6. Exits 0 on successful submit
"""

load("@aspect_rules_py//py:defs.bzl", "py_image_layer", aspect_py_binary = "py_binary")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load", "oci_push")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("//props:oci.bzl", "py_image_entrypoint", "py_image_env", "py_python3_symlink")
load("//tools/testing:defs.bzl", "py_test")

exports_files(
    ["prompt.md.mako"],
    visibility = ["//props:__subpackages__"],
)

# =============================================================================
# In-container agent main entry point
# =============================================================================

py_library(
    name = "main",
    srcs = ["main.py"],
    data = [
        "prompt.md.mako",
        "//props/agents/critic/variants:contract_truthfulness.md",
        "//props/agents/critic/variants:dead_code.md",
        "//props/agents/critic/variants:flag_propagation.md",
        "//props/agents/critic/variants:high_recall_critic.md",
        "//props/agents/critic/variants:verbose_docs.md",
        "//props/agents/docs:db/critiques.md.mako",
        "//props/agents/docs:source_inspection.md.mako",
        "//props/agents/docs:system_access.md",
    ],
    imports = ["../../.."],
    visibility = ["//props:__subpackages__"],
    deps = [
        "//agent_core:agent",
        "//agent_core:direct_provider",
        "//agent_core:handler",
        "//agent_core:logging_handler",
        "//agent_core:loop_control",
        "//mcp_infra/exec:direct",
        "//mcp_infra/exec:models",
        "//mcp_infra/exec:subprocess",
        "//openai_utils:model",
        "//openai_utils:pydantic_strict_mode",
        "//props/agents:runtime",
        "//props/core/models:examples",
        "//props/db:database",
        "//props/db:models",
        "//props/db:snapshots",
        "@pypi//openai",
        "@pypi//pydantic",
    ],
)

py_binary(
    name = "critic",
    imports = ["../../.."],
    main_module = "props.agents.critic.main",
    visibility = ["//visibility:public"],
    deps = [
        ":main",
    ],
)

# Container-specific binary using aspect_rules_py (py_image_layer requires it).
aspect_py_binary(
    name = "critic_bin",
    imports = ["../../.."],
    main = "main.py",
    visibility = ["//props:__subpackages__"],
    deps = [
        ":main",
    ],
)

py_image_layer(
    name = "layers",
    binary = ":critic_bin",
    visibility = ["//props:__subpackages__"],
)

py_python3_symlink(
    name = "python3_symlink",
    binary_name = "critic_bin",
)

# =============================================================================
# Library targets
# =============================================================================

