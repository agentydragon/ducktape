py_test(
    name = "test_reported_issues_constraints",
    srcs = ["test_reported_issues_constraints.py"],
    imports = ["../../.."],
    requires_docker = True,
    deps = [
        ":conftest",
        "//props:conftest",
        "//props/core:ids",
        "//props/db:database",
        "//props/db:examples",
