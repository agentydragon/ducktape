"""Agent runtime libraries shared across all in-container agents."""

load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

py_library(
    name = "schema",
    srcs = ["schema.py"],
    visibility = ["//props:__subpackages__"],
    deps = [
        "//props/db:models",
        "@pypi//pydantic",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "runtime",
    srcs = ["runtime.py"],
    visibility = ["//props:__subpackages__"],
    deps = [
        ":schema",
        "//mako_utils:preprocessor",
        "//props/db:database",
        "//props/db:models",
        "//props/db:queries",
        "//props/db:snapshot_io",
        "@pypi//mako",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "push_images",
    srcs = ["push_images.py"],
    deps = [
        "//util:env",
        "//util:oci",
        "//util/bazel:runfiles",
    ],
)

py_binary(
    name = "push_images_bin",
    data = [
        "//props/agents/critic:image",
        "//props/agents/critic/variants:contract_truthfulness",
        "//props/agents/critic/variants:dead_code",
        "//props/agents/critic/variants:flag_propagation",
        "//props/agents/critic/variants:high_recall",
        "//props/agents/critic/variants:verbose_docs",
        "//props/agents/critic_dev/improve:image",
        "//props/agents/critic_dev/optimize:image",
        "//props/agents/grader:image",
        "@crane",
    ],
    main_module = "props.agents.push_images",
    visibility = ["//visibility:public"],
    deps = [":push_images"],
)

py_test(
    name = "test_system_prompts",
    size = "medium",
    srcs = ["test_system_prompts.py"],
    data = [
        "//props/agents/critic:prompt.md.mako",
        "//props/agents/critic_dev:authoring_agents.md.mako",
        "//props/agents/critic_dev:built_in_critic.md.mako",
        "//props/agents/critic_dev:prompt.md.mako",
        "//props/agents/critic_dev:prompt_base.md.mako",
        "//props/agents/critic_dev:rollouts.md.mako",
        "//props/agents/critic_dev:system_access.md",
        "//props/agents/docs:db/agent_definitions.md.mako",
        "//props/agents/docs:db/agent_runs.md.mako",
        "//props/agents/docs:db/critiques.md.mako",
        "//props/agents/docs:db/evaluation_flow.md.mako",
        "//props/agents/docs:db/examples.md.mako",
        "//props/agents/docs:db/grading.md.mako",
        "//props/agents/docs:db/ground_truth.md.mako",
        "//props/agents/docs:db/llm_requests.md.mako",
        "//props/agents/docs:source_inspection.md.mako",
        "//props/agents/docs:system_access.md",
        "//props/agents/grader:prompt.md.mako",
    ],
    requires_docker = True,
    deps = [
        ":runtime",
        "//:conftest",
        "//props:conftest",
        "//props/core:agent_types",
        "//props/core/models:examples",
        "//props/db:database",
        "//util/testing:undeclared_outputs",
        "@pypi//pytest_asyncio",  # keep
        "@pypi//pytest_bazel",
    ],
)
