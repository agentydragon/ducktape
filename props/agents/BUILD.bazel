"""Agent runtime libraries shared across all in-container agents."""

load("@rules_python//python:defs.bzl", "py_library")
load("//tools/testing:defs.bzl", "py_test")

py_library(
    name = "schema",
    srcs = ["schema.py"],
    imports = ["../.."],
    visibility = ["//props:__subpackages__"],
    deps = [
        "//props/db:models",
        "@pypi//pydantic",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "runtime",
    srcs = ["runtime.py"],
    imports = ["../.."],
    visibility = ["//props:__subpackages__"],
    deps = [
        ":schema",
        "//mako_utils:preprocessor",
        "//openai_utils:model",
        "//openai_utils:retry",
        "//props/db:database",
        "//props/db:models",
        "//props/db:queries",
        "//props/db:snapshot_io",
        "@pypi//mako",
        "@pypi//openai",
        "@pypi//sqlalchemy",
    ],
)

py_test(
    name = "test_system_prompts",
    srcs = ["test_system_prompts.py"],
    data = [
        "//props/agents/critic:prompt.md.mako",
        "//props/agents/critic_dev:authoring_agents.md.mako",
        "//props/agents/critic_dev:built_in_critic.md.mako",
        "//props/agents/critic_dev:prompt.md.mako",
        "//props/agents/critic_dev:prompt_base.md.mako",
        "//props/agents/critic_dev:rollouts.md.mako",
        "//props/agents/critic_dev:system_access.md",
        "//props/agents/docs:db/agent_definitions.md.mako",
        "//props/agents/docs:db/agent_runs.md.mako",
        "//props/agents/docs:db/critiques.md.mako",
        "//props/agents/docs:db/evaluation_flow.md.mako",
        "//props/agents/docs:db/examples.md.mako",
        "//props/agents/docs:db/grading.md.mako",
        "//props/agents/docs:db/ground_truth.md.mako",
        "//props/agents/docs:db/llm_requests.md.mako",
        "//props/agents/docs:source_inspection.md.mako",
        "//props/agents/docs:system_access.md",
        "//props/agents/grader:prompt.md.mako",
    ],
    imports = ["../.."],
    requires_docker = True,
    deps = [
        ":runtime",
        "//props:conftest",
        "//props/core:agent_types",
        "//props/db:database",
