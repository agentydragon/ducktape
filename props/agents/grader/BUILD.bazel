"""Grader agent - implementation and container image.

Build targets:
    bazel run //props/agents/grader:load  -- Load grader image
    bazel run //props/agents/grader:push  -- Push grader image

The container runs a daemon agent loop that:
1. Fetches snapshot to /workspace
2. Renders system prompt from template
3. Queries LLM via proxy (OPENAI_BASE_URL)
4. Executes grader tools (list_pending, insert_edges, etc.)
5. Sleeps on pg_notify, wakes to grade new critiques
"""

load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load", "oci_push")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("//props:oci.bzl", "py_binary_distroless_cmd", "py_binary_distroless_env")
load("//tools/testing:docker.bzl", "docker_py_test")

exports_files(
    ["prompt.md.mako"],
    visibility = ["//props:__subpackages__"],
)

py_library(
    name = "tools",
    srcs = ["tools.py"],
    imports = ["../../.."],
    visibility = ["//props:__subpackages__"],
    deps = [
        "//openai_utils:pydantic_strict_mode",
        "@pypi//pydantic",
    ],
)

# =============================================================================
# In-container agent main entry point (daemon grader)
# =============================================================================

py_library(
    name = "main",
    srcs = ["main.py"],
    data = [
        "prompt.md.mako",
        "//props/agents/docs:database_access.md",
        "//props/agents/docs:db/agent_runs.md.mako",
        "//props/agents/docs:db/critiques.md.mako",
        "//props/agents/docs:db/examples.md.mako",
        "//props/agents/docs:db/grading.md.mako",
        "//props/agents/docs:db/ground_truth.md.mako",
    ],
    imports = ["../../.."],
    visibility = ["//props:__subpackages__"],
    deps = [
        ":drift_handler",
        ":notification_handler",
        ":notifications",
        ":tools",
        "//agent_core:agent",
        "//agent_core:direct_provider",
        "//agent_core:handler",
        "//agent_core:logging_handler",
        "//agent_core:loop_control",
        "//mcp_infra/exec:models",
        "//mcp_infra/exec:subprocess",
        "//openai_utils:model",
        "//props/agents:runtime",
        "//props/core:ids",
        "//props/db:database",
        "//props/db:models",
        "//props/db:snapshot_io",
        "@pypi//asyncpg",
        "@pypi//asyncpg_stubs",
        "@pypi//openai",
        "@pypi//sqlalchemy",
    ],
)

py_binary(
    name = "grader",
    imports = ["../../.."],
    main_module = "props.agents.grader.main",
    visibility = ["//visibility:public"],
    deps = [
        ":main",
    ],
)

pkg_tar(
    name = "main_tar",
    srcs = [":grader"],
    include_runfiles = True,
    package_dir = "/app",
    strip_prefix = ".",
    visibility = ["//props:__subpackages__"],
)

# =============================================================================
# Library targets
# =============================================================================

py_library(
    name = "drift_handler",
    srcs = ["drift_handler.py"],
    imports = ["../../.."],
    visibility = ["//props:__subpackages__"],
    deps = [
