"""Grader agent - implementation and container image.

Build targets:
    bazel run //props/agents/grader:load  -- Load grader image
    bazel run //props/agents/grader:push  -- Push grader image

The container runs a persistent agent loop that:
1. Fetches snapshot to /workspace
2. Renders system prompt from template
3. Queries LLM via proxy (OPENAI_BASE_URL)
4. Executes grader tools (get_drift, insert_edges, etc.)
5. Sleeps on pg_notify, wakes to grade new critiques
"""

load("@aspect_rules_py//py:defs.bzl", "py_image_layer", aspect_py_binary = "py_binary")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load", "oci_push")
load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")
load("//props:oci.bzl", "py_image_entrypoint", "py_image_env", "py_python3_symlink")

exports_files(
    ["prompt.md.mako"],
    visibility = ["//props:__subpackages__"],
)

py_library(
    name = "tools",
    srcs = ["tools.py"],
    visibility = ["//props:__subpackages__"],
    deps = [
        "//openai_utils:pydantic_strict_mode",
        "//props/db:snapshots",
        "@pypi//pydantic",
    ],
)

# =============================================================================
# In-container agent main entry point (snapshot grader)
# =============================================================================

py_library(
    name = "main",
    srcs = ["main.py"],
    data = [
        "prompt.md.mako",
        "//props/agents/docs:db/agent_runs.md.mako",
        "//props/agents/docs:db/critiques.md.mako",
        "//props/agents/docs:db/examples.md.mako",
        "//props/agents/docs:db/grading.md.mako",
        "//props/agents/docs:db/ground_truth.md.mako",
        "//props/agents/docs:source_inspection.md.mako",
        "//props/agents/docs:system_access.md",
    ],
    visibility = ["//props:__subpackages__"],
    deps = [
        ":drift_handler",
        ":notification_middleware",
        ":tools",
        "//openai_utils:errors",
        "//props/agents:runtime",
        "//props/agents/af:exec_tool",
        "//props/agents/af:loop",
        "//props/agents/af:middleware",
        "//props/agents/af:tools",
        "//props/core:ids",
        "//props/db:database",
        "//props/db:models",
        "//props/db:notifications",
        "//props/db:snapshot_io",
        "@pypi//agent_framework_core",
        "@pypi//asyncpg",
        "@pypi//asyncpg_stubs",
        "@pypi//sqlalchemy",
    ],
)

py_binary(
    name = "grader",
    main_module = "props.agents.grader.main",
    visibility = ["//visibility:public"],
    deps = [
        ":main",
    ],
)

# Container-specific binary using aspect_rules_py (py_image_layer requires it).
aspect_py_binary(
    name = "grader_bin",
    main = "main.py",
    visibility = ["//props:__subpackages__"],
    deps = [
        ":main",
    ],
)

py_image_layer(
    name = "layers",
    binary = ":grader_bin",
    visibility = ["//props:__subpackages__"],
)

py_python3_symlink(
    name = "python3_symlink",
    binary_name = "grader_bin",
)

# =============================================================================
# Library targets
# =============================================================================

py_library(
    name = "drift_handler",
    srcs = ["drift_handler.py"],
    visibility = ["//props:__subpackages__"],
    deps = [
        "//props/core:ids",
        "//props/db:database",
        "//props/db:models",
        "@pypi//pydantic",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "notification_middleware",
    srcs = ["notification_middleware.py"],
    visibility = ["//props:__subpackages__"],
    deps = [
        "//props/db:notifications",
        "@pypi//agent_framework_core",
    ],
)

