# =============================================================================
# Container image (snapshot grader)
# =============================================================================

oci_image(
    name = "image",
    base = "@debian_trixie_slim_linux_amd64",
    entrypoint = py_image_entrypoint("grader_bin"),
    env = py_image_env(binary_name = "grader_bin"),
    labels = {"org.opencontainers.image.title": "grader"},
    tars = [
        ":layers",
        ":python3_symlink",
    ],
    visibility = ["//visibility:public"],
    workdir = "/workspace",
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["grader:latest"],
    visibility = ["//visibility:public"],
)

oci_push(
    name = "push",
    image = ":image",
    remote_tags = ["latest"],
    repository = "localhost:8000/grader",
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    visibility = ["//props:__subpackages__"],
    deps = [
        "//props/core/models:examples",
        "//props/db:database",
