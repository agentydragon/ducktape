# =============================================================================
# Container image (daemon grader)
# =============================================================================

oci_image(
    name = "image",
    base = "@distroless_cc_linux_amd64",
    cmd = py_binary_distroless_cmd("grader"),
    env = py_binary_distroless_env("grader"),
    tars = [":main_tar"],
    visibility = ["//visibility:public"],
    workdir = "/workspace",
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["grader:latest"],
    visibility = ["//visibility:public"],
)

oci_push(
    name = "push",
    image = ":image",
    remote_tags = ["latest"],
    repository = "localhost:8000/grader",
)

