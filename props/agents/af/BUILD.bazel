load("//devinfra/python:defs.bzl", "py_library", "py_test")

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    deps = ["@pypi//pytest"],
)

py_test(
    name = "test_client",
    srcs = ["test_client.py"],
    deps = [
        ":client",
        ":conftest",
        "//openai_utils:api_shape",
        "@pypi//agent_framework_core",
        "@pypi//httpx",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",
        "@pypi//pytest_bazel",
        "@pypi//respx",
    ],
)

py_library(
    name = "client",
    srcs = ["client.py"],
    visibility = ["//props:__subpackages__"],
    deps = [
        "//openai_utils:api_shape",
        "//props/agents:runtime",
        "//props/db:database",
        "//props/db:models",
        "@pypi//agent_framework_anthropic",
        "@pypi//agent_framework_core",
        "@pypi//agent_framework_openai",
        "@pypi//anthropic",
    ],
)

py_library(
    name = "tools",
    srcs = ["tools.py"],
    visibility = ["//props:__subpackages__"],
    deps = [
        "@pypi//agent_framework_core",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "exec_tool",
    srcs = ["exec_tool.py"],
    visibility = ["//props:__subpackages__"],
    deps = [
        "//mcp_infra/exec:models",
        "//mcp_infra/exec:subprocess",
        "@pypi//agent_framework_core",
    ],
)

py_library(
    name = "middleware",
    srcs = ["middleware.py"],
    visibility = ["//props:__subpackages__"],
    deps = ["@pypi//agent_framework_core"],
)

py_library(
    name = "loop",
    srcs = ["loop.py"],
    visibility = ["//props:__subpackages__"],
    deps = [
        ":client",
        "//props/db:database",
        "@pypi//agent_framework_core",
    ],
)
