"""Critic developer agent (improve mode) - container image.

Build targets:
    bazel run //props/agents/critic_dev/improve:load  -- Load into local Docker
    bazel run //props/agents/critic_dev/improve:push  -- Push to local registry (localhost:8000)
"""

load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load", "oci_push")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_python//python:defs.bzl", "py_binary")
load("//props:oci.bzl", "py_binary_distroless_cmd", "py_binary_distroless_env")
load("//tools/testing:docker.bzl", "docker_py_test")

py_binary(
    name = "improve",
    main_module = "props.agents.critic_dev.main",
    visibility = ["//visibility:public"],
    deps = ["//props/agents/critic_dev:main"],
)

pkg_tar(
    name = "main_tar",
    srcs = [":improve"],
    include_runfiles = True,
    package_dir = "/app",
    strip_prefix = ".",
    visibility = ["//props:__subpackages__"],
)

docker_py_test(
    name = "test_e2e",
    srcs = ["test_e2e.py"],
    data = [
        ":image",
        "//props/agents/critic:image",
    ],
    imports = ["../../../.."],
    tags = ["e2e"],
    deps = [
        "//agent_core/testing:responses",
        "//mcp_infra/exec:matchers",
        "//props:conftest",
        "//props/agents/critic_dev/testing:mocks",
        "//props/core:oci_utils",
        "//props/db:database",
        "//props/db:examples",
        "//props/db:models",
        "//props/testing",
        "@pypi//pyhamcrest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

oci_image(
    name = "image",
    base = "@distroless_cc_linux_amd64",
    cmd = py_binary_distroless_cmd("improve"),
    env = py_binary_distroless_env("improve"),
    tars = [
        ":main_tar",
        "//props:crane_tar",
    ],
    visibility = ["//visibility:public"],
    workdir = "/workspace",
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["critic_dev_improve:latest"],
    visibility = ["//visibility:public"],
)

oci_push(
    name = "push",
    image = ":image",
    remote_tags = ["latest"],
    repository = "localhost:8000/critic_dev_improve",
)
