"""Shared infrastructure for critic developer agents (optimize and improve modes)."""

load("@rules_oci//oci:defs.bzl", "oci_image")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files", "strip_prefix")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//devinfra/python:defs.bzl", "py_library")
load("//props:py_test.bzl", "py_test")
load("//props/testing:exec_properties.bzl", "CONTAINER_E2E_EXEC_PROPERTIES")

exports_files([
    "authoring_agents.md.mako",
    "built_in_critic.md.mako",
    "prompt_base.md.mako",
    "prompt.md.mako",
    "rollouts.md.mako",
    "system_access.md",
])

# Exported for aspect_py_binary in improve/ and optimize/ (py_image_layer needs
# a file label for `main`, unlike rules_python's `main_module`).
exports_files(
    ["main.py"],
    visibility = ["//props/agents/critic_dev:__subpackages__"],
)

py_library(
    name = "grading",
    srcs = ["grading.py"],
    visibility = ["//props:__subpackages__"],
    deps = [
        "//props/agents:runtime",
        "//props/core:eval_api_models",
        "//props/db:database",
        "//props/db:models",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "main",
    srcs = ["main.py"],
    data = [
        "authoring_agents.md.mako",
        "built_in_critic.md.mako",
        "prompt.md.mako",
        "prompt_base.md.mako",
        "rollouts.md.mako",
        "system_access.md",
        "//props/agents/critic_dev/recipes:build_critic.sh",
        "//props/agents/critic_dev/recipes:custom_critic_for_test.py",
        "//props/agents/docs:db/agent_definitions.md.mako",
        "//props/agents/docs:db/agent_runs.md.mako",
        "//props/agents/docs:db/critiques.md.mako",
        "//props/agents/docs:db/evaluation_flow.md.mako",
        "//props/agents/docs:db/examples.md.mako",
        "//props/agents/docs:db/grading.md.mako",
        "//props/agents/docs:db/ground_truth.md.mako",
        "//props/agents/docs:db/llm_requests.md.mako",
        "//props/agents/docs:source_inspection.md.mako",
        "//props/agents/docs:system_access.md",
    ],
    visibility = ["//props:__subpackages__"],
    deps = [
        ":loop",
        "//devinfra/oci",
        "//props/agents:runtime",
        "//props/agents/af:loop",
        "//props/agents/af:middleware",
        "//props/agents/critic_dev/recipes:examples_and_scopes",
        "//props/agents/critic_dev/recipes:ground_truth",
        "//props/agents/critic_dev/recipes:recall_metrics",
        "//props/agents/critic_dev/recipes:run_analysis",
        "//props/core:agent_types",
        "//props/core:ids",
        "//props/core/models:examples",
        "//props/db:config",
        "//props/db:database",
        "//props/db:models",
        "@pypi//agent_framework_anthropic",  # keep: core's stub __init__ chains into it; mypy needs it present
        "@pypi//agent_framework_claude",  # keep: core's stub __init__ chains into it; mypy needs it present
        "@pypi//agent_framework_core",
        "@pypi//agent_framework_openai",  # keep: core's stub __init__ chains into it; mypy needs it present
        "@pypi//httpx",
        "@pypi//pydantic",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "registry_push_probe",
    testonly = True,
    srcs = ["registry_push_probe.py"],
)

py_library(
    name = "loop",
    srcs = ["loop.py"],
    visibility = ["//props:__subpackages__"],
    deps = [
        ":grading",
        "//openai_utils:pydantic_strict_mode",
        "//props/agents/af:exec_tool",
        "//props/agents/af:tools",
        "//props/core:eval_api_models",
        "//props/db:database",
        "//props/db:models",
        "//props/db:snapshot_io",
        "@pypi//httpx",
        "@pypi//pydantic",
    ],
)

py_test(
    name = "test_e2e",
    size = "medium",
    srcs = ["test_e2e.py"],
    data = [
        ":critic_registry_probe_image",
        "//props/agents/critic:image",
        "//props/agents/critic_dev/optimize:image",
        "//props/agents/grader:image",
    ],
    exec_properties = CONTAINER_E2E_EXEC_PROPERTIES,
    requires_docker = True,
    deps = [
        ":registry_push_probe",
        "//:conftest",
        "//devinfra/oci",
        "//mcp_infra/testing:matchers",
        "//openai_utils/testing:responses",
        "//props:conftest",
        "//props/agents/critic/testing:mocks",
        "//props/agents/critic_dev/testing:mocks",
        "//props/agents/critic_dev/testing:orchestration_fixtures",
        "//props/agents/grader/testing:mocks",
        "//props/agents/testing:e2e_pytest_plugins",
        "//props/core:ids",
        "//props/db:models",
        "//props/testing",
        "//props/testing:models",
        "//util/exec:models",
        "@pypi//more_itertools",
        "@pypi//pyhamcrest",
        "@pypi//pytest_bazel",
    ],
)

pkg_files(
    name = "registry_push_probe_file",
    testonly = True,
    srcs = ["registry_push_probe.py"],
    prefix = "/tmp",
    strip_prefix = strip_prefix.files_only(),
)

pkg_tar(
    name = "registry_push_probe_layer",
    testonly = True,
    srcs = [":registry_push_probe_file"],
)

oci_image(
    name = "critic_registry_probe_image",
    testonly = True,
    base = "//props/agents/critic:image",
    tars = [":registry_push_probe_layer"],
)
