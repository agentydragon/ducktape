# =============================================================================
# Container images
# =============================================================================

# One-off grader (grades single critic run)
oci_image(
    name = "image",
    base = "@python_slim_linux_amd64",
    cmd = ["/app/main"],
    env = {
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONUNBUFFERED": "1",
    },
    tars = [":main_tar"],
    workdir = "/workspace",
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["grader-agent:latest"],
)

oci_push(
    name = "push",
    image = ":image",
    remote_tags = ["latest"],
    repository = "localhost:8000/grader",
)

# Daemon grader (grades all critiques for a snapshot, persistent)
oci_image(
    name = "daemon_image",
    base = "@python_slim_linux_amd64",
    cmd = ["/app/daemon_main"],
    env = {
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONUNBUFFERED": "1",
    },
    tars = [":daemon_main_tar"],
    workdir = "/workspace",
)

oci_load(
    name = "daemon_load",
    image = ":daemon_image",
    repo_tags = ["snapshot_grader:latest"],
)

oci_push(
    name = "daemon_push",
    image = ":daemon_image",
    remote_tags = ["latest"],
    repository = "localhost:8000/snapshot_grader",
)
