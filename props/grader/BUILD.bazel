        "//openai_utils",
        "//props/core:agent_helpers",
        "//props/core:ids",
        "//props/db:models",
        "//props/db:session",
        "@pypi//openai",
        "@pypi//pydantic",
        "@pypi//sqlalchemy",
    ],
)

