"""Alembic database migrations."""

# gazelle:exclude env.py
# gazelle:exclude versions

# Removed py_test load - using defs.bzl version
load("//props:py_test.bzl", "py_test")

filegroup(
    name = "migrations",
    srcs = [
        "README",
        "env.py",
        "script.py.mako",
    ] + glob(["versions/*.py"]),
    visibility = ["//props:__subpackages__"],
)

py_test(
    name = "test_migration_sequence",
    srcs = ["test_migration_sequence.py"],
    data = [":migrations"],
    deps = [
        "//:conftest",
        "//props:conftest",
        "//props/db:conftest",
        "@pypi//alembic",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_materialize_examples",
    size = "medium",
    srcs = ["test_materialize_examples.py"],
    requires_docker = True,
    deps = [
        "//:conftest",
        "//props:conftest",
        "//props/db:config",
        "//props/db:conftest",
        "//util/testing:postgres",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)

py_test(
    name = "test_schema_baseline",
    size = "medium",
    srcs = ["test_schema_baseline.py"],
    requires_docker = True,
    deps = [
        "//:conftest",
        "//props:conftest",
        "//props/db:config",
        "//props/db:conftest",
        "//props/db:setup",
        "//util/testing:postgres",
        "//util/testing:undeclared_outputs",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
        "@pypi//testcontainers",
    ],
)
