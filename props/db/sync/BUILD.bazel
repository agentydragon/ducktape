load("@rules_python//python:defs.bzl", "py_library")
load("//tools/deps:check.bzl", "assert_no_deps")
load("//tools/testing:defs.bzl", "py_test")

# =============================================================================
# Library targets
# =============================================================================

py_library(
    name = "yaml_loader",
    srcs = ["yaml_loader.py"],
    imports = ["../../.."],
    visibility = [
        "//props/db:__subpackages__",
        "//props/specimens/scripts:__pkg__",
    ],
    deps = [
        "//props/core:ids",
        "//props/core/models:true_positive",
        "//props/core/models:types",
        "@pypi//more_itertools",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "export",
    srcs = ["export.py"],
    imports = ["../../.."],
    visibility = ["//props:__subpackages__"],
    deps = [
        "//props/core:ids",
        "//props/db:models",
        "@pypi//pyyaml",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "stats",
    srcs = ["stats.py"],
    imports = ["../../.."],
    visibility = ["//props:__subpackages__"],
)

py_library(
    name = "model_metadata",
    srcs = ["model_metadata.py"],
    imports = ["../../.."],
    visibility = ["//props:__subpackages__"],
    deps = [
        ":stats",
        "//openai_utils:model_metadata",
        "//props:config",
        "//props/db:models",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "sync",
    srcs = ["sync.py"],
    imports = ["../../.."],
    visibility = ["//props:__subpackages__"],
    deps = [
        ":stats",
        ":yaml_loader",
        "//props/core:ids",
        "//props/core:splits",
        "//props/core/models:true_positive",
        "//props/db:models",
        "@pypi//pydantic",
        "@pypi//pyyaml",
        "@pypi//sqlalchemy",
    ],
)

# =============================================================================
# Boundary enforcement
# =============================================================================

# yaml_loader is a pure parsing layer — it must not depend on
# the DB/ORM layer (sqlalchemy, props/db:models).
assert_no_deps(
    name = "test_yaml_loader_no_db_deps",
    forbidden = [
        "@pypi//sqlalchemy",
        "//props/db:models",
    ],
    targets = ["//props/db/sync:yaml_loader"],
)

