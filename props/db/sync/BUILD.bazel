# =============================================================================
# Library targets
# =============================================================================

py_library(
    name = "yaml_loader",
    srcs = ["yaml_loader.py"],
    imports = ["../../.."],
    visibility = ["//props/db:__subpackages__"],
    deps = [
        "//props/core:ids",
        "//props/core/models:true_positive",
        "//props/core/models:types",
        "@pypi//more_itertools",
        "@pypi//pydantic",
        "@pypi//pyyaml",
    ],
)

py_library(
    name = "loader",
    srcs = ["loader.py"],
    imports = ["../../.."],
    visibility = ["//props:__subpackages__"],
    deps = [
        "//props/core/models:snapshot",
        "@pypi//pyyaml",
    ],
)

py_library(
    name = "export",
    srcs = ["export.py"],
    imports = ["../../.."],
    visibility = ["//props:__subpackages__"],
    deps = [
        "//props/core:ids",
        "//props/db:models",
        "@pypi//pyyaml",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "stats",
    srcs = ["stats.py"],
    imports = ["../../.."],
    visibility = ["//props:__subpackages__"],
)

py_library(
    name = "model_metadata",
    srcs = ["model_metadata.py"],
    imports = ["../../.."],
    visibility = ["//props:__subpackages__"],
    deps = [
        ":stats",
        "//openai_utils:model_metadata",
        "//props:config",
        "//props/db:models",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "sync",
    srcs = ["sync.py"],
    imports = ["../../.."],
    visibility = ["//props:__subpackages__"],
    deps = [
        ":loader",
        ":model_metadata",
        ":stats",
        ":yaml_loader",
        "//props:config",
        "//props/core:ids",
        "//props/core:runs_context",
        "//props/core/models:snapshot",
        "//props/core/models:true_positive",
        "//props/db:models",
        "@pypi//opentelemetry_api",
        "@pypi//pygit2",
        "@pypi//sqlalchemy",
    ],
)

# =============================================================================
# Boundary enforcement
# =============================================================================

# yaml_loader and loader are pure parsing layers — they must not depend on
# the DB/ORM layer (sqlalchemy, props/db:models).
assert_no_deps(
    name = "test_yaml_loader_no_db_deps",
    forbidden = [
        "@pypi//sqlalchemy",
        "//props/db:models",
    ],
    targets = ["//props/db/sync:yaml_loader"],
)

assert_no_deps(
    name = "test_loader_no_db_deps",
    forbidden = [
        "@pypi//sqlalchemy",
        "//props/db:models",
    ],
    targets = ["//props/db/sync:loader"],
)

