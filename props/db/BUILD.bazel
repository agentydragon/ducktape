load("@rules_python//python:defs.bzl", "py_library")
load("//tools/deps:check.bzl", "assert_no_deps")
load("//tools/testing:defs.bzl", "py_test")

# =============================================================================
# Leaf modules (no db/ deps)
# =============================================================================

py_library(
    name = "config",
    srcs = ["config.py"],
    imports = ["../.."],
    visibility = ["//props:__subpackages__"],
    deps = [
        "@pypi//asyncpg",
        "@pypi//psycopg2_binary",
        "@pypi//pydantic",
        "@pypi//pydantic_settings",
    ],
)

py_library(
    name = "snapshots",
    srcs = ["snapshots.py"],
    imports = ["../.."],
    visibility = ["//props:__subpackages__"],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "notifications",
    srcs = ["notifications.py"],
    imports = ["../.."],
    visibility = ["//props:__subpackages__"],
    deps = [
        "//props/core:ids",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "snapshot_io",
    srcs = ["snapshot_io.py"],
    imports = ["../.."],
    visibility = ["//props:__subpackages__"],
    deps = [
        ":database",
        ":models",
    ],
)

py_library(
    name = "queries",
    srcs = ["queries.py"],
    imports = ["../.."],
    visibility = ["//props:__subpackages__"],
    deps = [
        ":models",
        "@pypi//sqlalchemy",
    ],
)

