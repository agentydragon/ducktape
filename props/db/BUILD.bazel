# Test support
py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    imports = ["../.."],
    visibility = ["//props:__subpackages__"],
    deps = ["@pypi//pytest"],
)

# db/ must not depend on agent code (container-only)
assert_no_deps(
    name = "test_no_grader_deps",
    forbidden = ["//props/agents/grader"],
    targets = [
        "//props/db:config",
        "//props/db:database",
        "//props/db:examples",
        "//props/db:models",
        "//props/db:notifications",
        "//props/db:queries",
        "//props/db:query_builders",
        "//props/db:setup",
        "//props/db:snapshot_io",
        "//props/db:snapshots",
    ],
)

