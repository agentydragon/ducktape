"""Props backend - FastAPI unified server (dashboard, proxies, eval APIs)."""

load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("//tools/lint:linters.bzl", "ruff_test")

py_library(
    name = "backend",
    srcs = glob(
        ["**/*.py"],
        exclude = [
            ".*/**",
            "tests/**",
        ],
    ),
    imports = ["../.."],
    visibility = ["//visibility:public"],
    deps = [
        "//cli_util",
        "//mcp_infra",
        "//mcp_utils",
        "//openai_utils",
        # props.core modules
        "//props/core:agent_registry",
        "//props/core:agent_types",
        "//props/core:agent_workspace",
        "//props/core:eval_api_models",
        "//props/core:exceptions",
        "//props/core:ids",
        "//props/core:oci_utils",
        "//props/core:splits",
        "//props/cli:common_options",
        "//props/cli:resources",
        "//props/critic:exceptions",
        "//props/critic_dev:shared",
        "//props/db:config",
        "//props/db:examples",
        "//props/db:models",
        "//props/db:session",
        "//props/grader:daemon_manager",
        "//props/core/models:examples",
        "//props/core/models:true_positive",
        "@pypi//aiodocker",
        "@pypi//fastapi",
        "@pypi//httpx",
        "@pypi//mcp",
        "@pypi//openai",
        "@pypi//psycopg",
        "@pypi//pydantic",
        "@pypi//starlette",
        "@pypi//typer",
        "@pypi//uvicorn",
    ],
)

py_binary(
    name = "backend_cli",
    srcs = ["cli.py"],
    main = "cli.py",
    visibility = ["//props/frontend:__pkg__"],
    deps = [
        ":backend",
        "@pypi//typer",
        "@pypi//uvicorn",
    ],
)

py_binary(
    name = "export_schema",
    srcs = ["export_schema.py"],
    main = "export_schema.py",
    deps = [":backend"],
)

genrule(
    name = "openapi_schema",
    outs = ["openapi.json"],
    cmd = "$(location :export_schema) > $@",
    tools = [":export_schema"],
    visibility = ["//props/frontend:__pkg__"],
)

ruff_test(
    name = "ruff",
    srcs = [":backend"],
)
