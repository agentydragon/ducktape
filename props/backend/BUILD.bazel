"""Props backend - FastAPI unified server (dashboard, proxies, eval APIs)."""

load("@aspect_rules_py//py:defs.bzl", "py_image_layer", aspect_py_binary = "py_binary")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files", "strip_prefix")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("//props:oci.bzl", "py_image_entrypoint", "py_image_env")
load("//props/specimens:defs.bzl", "specimen_pkg_files")
load("//tools/testing:defs.bzl", "py_test")

# =============================================================================
# Library targets
# =============================================================================

py_library(
    name = "build_info",
    srcs = ["build_info.py"],
    imports = ["../.."],
    visibility = ["//:__subpackages__"],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "deps",
    srcs = ["deps.py"],
    imports = ["../.."],
    visibility = ["//:__subpackages__"],
    deps = [
        "//props:config",
        "//props/db:database",
        "@pypi//fastapi",
    ],
)

py_library(
    name = "auth",
    srcs = ["auth.py"],
    imports = ["../.."],
    visibility = ["//:__subpackages__"],
    deps = [
        ":deps",
        "//props/db:config",
        "//props/db:database",
        "//props/db:models",
        "@pypi//fastapi",
        "@pypi//psycopg",
    ],
)

py_library(
    name = "app",
    srcs = ["app.py"],
    imports = ["../.."],
    visibility = ["//:__subpackages__"],
    deps = [
        ":build_info",
        "//cli_util:logging",
        "//props:config",
        "//props/backend/routes:agent_definitions",
        "//props/backend/routes:ground_truth",
        "//props/backend/routes:llm",
        "//props/backend/routes:model_metadata",
        "//props/backend/routes:registry",
        "//props/backend/routes:runs",
        "//props/backend/routes:stats",
        "//props/core:oci_utils",
        "//props/db:config",
        "//props/db:database",
        "//props/db:setup",
        "//props/db/sync",
        "//props/db/sync:model_metadata",
        "//props/orchestration:agent_registry",
        "//props/orchestration:executor_factory",
        "//props/orchestration:grader_supervisor",
        "@pypi//asyncpg",
        "@pypi//fastapi",
    ],
)

py_library(
    name = "cli",
    srcs = ["cli.py"],
    imports = ["../.."],
    visibility = ["//:__subpackages__"],
    deps = [
        ":app",
        "//cli_util:logging",
        "@pypi//fastapi",
        "@pypi//typer_slim",
        "@pypi//uvicorn",
    ],
)

py_library(
    name = "export_schema",
    srcs = ["export_schema.py"],
    imports = ["../.."],
    visibility = ["//:__subpackages__"],
    deps = [
        ":app",
        "//props:config",
        "//props/core:oci_utils",
    ],
)

# =============================================================================
# Test support
# =============================================================================

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    imports = ["../.."],
    visibility = ["//props:__subpackages__"],
    deps = ["@pypi//pytest"],
)

# =============================================================================
# Tests
# =============================================================================

py_test(
    name = "test_auth",
    srcs = ["test_auth.py"],
    imports = ["../.."],
    requires_docker = True,
    deps = [
        ":auth",
        ":conftest",
        "//props/db:config",
        "//props/db:database",
        "@pypi//fastapi",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_cli",
    srcs = ["test_cli.py"],
    imports = ["../.."],
    requires_docker = True,
    deps = [
        ":cli",
        "//props:conftest",
        "@pypi//fastapi",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",  # keep
        "@pypi//pytest_bazel",
        "@pypi//uvicorn",
    ],
)

py_test(
    name = "test_agent_db_integration",
    srcs = ["test_agent_db_integration.py"],
    imports = ["../.."],
    requires_docker = True,
    deps = [
        ":auth",
        ":conftest",
        "//props:conftest",
        "//props/core:agent_types",
        "//props/db:database",
        "//props/db:examples",
        "//props/db:models",
        "//props/orchestration:agent_credentials",
        "//props/testing:constants",
        "//props/testing/fixtures:credentials",
        "//props/testing/fixtures:runs",
        "@pypi//asyncpg",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",  # keep
        "@pypi//pytest_bazel",
    ],
)

# =============================================================================
# Binaries
# =============================================================================

py_binary(
    name = "backend_cli",
    imports = ["../.."],
    main_module = "props.backend.cli",
    visibility = ["//props/frontend:__pkg__"],
    deps = [
        ":cli",
    ],
)

py_binary(
    name = "export_schema_bin",
    main_module = "props.backend.export_schema",
    visibility = ["//:__subpackages__"],
    deps = [":export_schema"],
)

genrule(
    name = "openapi_schema",
    outs = ["openapi.json"],
    cmd = "$(location :export_schema_bin) > $@",
    tools = [":export_schema_bin"],
    visibility = ["//props/frontend:__pkg__"],
)

# =============================================================================
# Linting
# =============================================================================

# =============================================================================
# OCI Image
# =============================================================================

# Container-specific binary using aspect_rules_py (py_image_layer requires it).
aspect_py_binary(
    name = "backend_bin",
    imports = ["../.."],
    main = "cli.py",
    visibility = ["//props:__subpackages__"],
    deps = [
        ":cli",
    ],
)

py_image_layer(
    name = "layers",
    binary = ":backend_bin",
)

pkg_files(
    name = "frontend_html_files",
    srcs = ["//props/frontend:index.html"],
    prefix = "/frontend",
    strip_prefix = strip_prefix.files_only(),
)

pkg_files(
    name = "frontend_bundle_files",
    srcs = ["//props/frontend:bundle"],
    prefix = "/frontend/dist",
    strip_prefix = strip_prefix.files_only(),
)

pkg_tar(
    name = "frontend_assets",
    srcs = [
        ":frontend_bundle_files",
        ":frontend_html_files",
    ],
)

# =============================================================================
# Specimen assets (bundled at /specimens/{slug}/ in the image)
# =============================================================================

_SPECIMENS = [
    ("crush/2025-08-30-internal_db", "//props/specimens/crush/2025-08-30-internal_db"),
    ("ducktape/2025-09-03-00", "//props/specimens/ducktape/2025-09-03-00"),
    ("ducktape/2025-11-20-00", "//props/specimens/ducktape/2025-11-20-00"),
    ("ducktape/2025-11-20-01", "//props/specimens/ducktape/2025-11-20-01"),
    ("ducktape/2025-11-21-00", "//props/specimens/ducktape/2025-11-21-00"),
    ("ducktape/2025-11-22-00", "//props/specimens/ducktape/2025-11-22-00"),
    ("ducktape/2025-11-22-01", "//props/specimens/ducktape/2025-11-22-01"),
    ("ducktape/2025-11-22-02", "//props/specimens/ducktape/2025-11-22-02"),
    ("ducktape/2025-11-26-00", "//props/specimens/ducktape/2025-11-26-00"),
    ("ducktape/2025-12-04-00", "//props/specimens/ducktape/2025-12-04-00"),
    ("ducktape/2026-01-17-00", "//props/specimens/ducktape/2026-01-17-00"),
    ("ducktape/2026-01-29-00", "//props/specimens/ducktape/2026-01-29-00"),
    ("ducktape_llm_common/2026-01-03-00", "//props/specimens/ducktape_llm_common/2026-01-03-00"),
    ("gmail-archiver/2025-12-17-00", "//props/specimens/gmail-archiver/2025-12-17-00"),
    ("misc/2025-08-29-pyright_watch_report", "//props/specimens/misc/2025-08-29-pyright_watch_report"),
    ("wt/2025-01-03-00", "//props/specimens/wt/2025-01-03-00"),
]

[specimen_pkg_files(
    name = "specimen_files_" + slug.replace("/", "_").replace("-", "_"),
    slug = slug,
    specimen_package = pkg,
) for slug, pkg in _SPECIMENS]

pkg_tar(
    name = "specimen_assets",
    srcs = [":specimen_files_" + slug.replace("/", "_").replace("-", "_") for slug, _ in _SPECIMENS],
)

oci_image(
    name = "image",
    base = "@debian_slim_linux_amd64",
    entrypoint = py_image_entrypoint("backend_bin") + [
        "serve",
        "--host",
        "0.0.0.0",
        "--static-dir",
        "/frontend",
    ],
    env = py_image_env(),
    tars = [
        ":layers",
        ":frontend_assets",
        ":specimen_assets",
    ],
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["props-backend:latest"],
)
