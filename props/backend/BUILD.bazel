# gazelle:exclude routes
# Props has complex inter-package dependencies that are manually configured

"""Props backend - FastAPI unified server (dashboard, proxies, eval APIs)."""

load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("//tools/lint:linters.bzl", "ruff_test")

py_library(
    name = "backend",
    srcs = [
        "__init__.py",
        "app.py",
        "auth.py",
        "cli.py",
        "export_schema.py",
        "routes/__init__.py",
        "routes/eval.py",
        "routes/ground_truth.py",
        "routes/llm.py",
        "routes/registry.py",
        "routes/runs.py",
        "routes/stats.py",
    ],
    imports = ["../.."],
    visibility = ["//visibility:public"],
    deps = [
        "//cli_util:decorators",
        "//cli_util:logging",
        "//mcp_infra:prefix",
        "//mcp_utils",
        "//openai_utils:model",
        # props orchestration modules
        "//props/orchestration:agent_registry",
        "//props/core:agent_types",
        "//props/core:agent_workspace",
        "//props/core:eval_api_models",
        "//props/core:exceptions",
        "//props/core:ids",
        "//props/core:oci_utils",
        "//props/core:splits",
        "//props/cli:common_options",
        "//props/cli:resources",
        "//props/critic:exceptions",
        "//props/critic_dev:shared",
        "//props/db:config",
        "//props/db:examples",
        "//props/db:models",
        "//props/db:session",
        "//props/orchestration:grader_supervisor",
        "//props/core/models:examples",
        "//props/core/models:true_positive",
        "@pypi//aiodocker",
        "@pypi//asyncpg",
        "@pypi//fastapi",
        "@pypi//httpx",
        "@pypi//mcp",
        "@pypi//openai",
        "@pypi//psycopg",
        "@pypi//pydantic",
        "@pypi//starlette",
        "@pypi//typer",
        "@pypi//uvicorn",
    ],
)

py_binary(
    name = "backend_cli",
    srcs = ["cli.py"],
    main = "cli.py",
    visibility = ["//props/frontend:__pkg__"],
    deps = [
        ":__init__",
        "//cli_util:logging",
        "//props/cli:common_options",
        "@pypi//typer_slim",
        "@pypi//uvicorn",
    ],
)

py_binary(
    name = "export_schema",
    srcs = ["export_schema.py"],
    main = "export_schema.py",
    visibility = ["//:__subpackages__"],
    deps = [":app"],
)

genrule(
    name = "openapi_schema",
    outs = ["openapi.json"],
    cmd = "$(location :export_schema) > $@",
    tools = [":export_schema"],
    visibility = ["//props/frontend:__pkg__"],
)

ruff_test(
    name = "ruff",
    srcs = [":backend"],
)

# =============================================================================
# OCI Image
# =============================================================================

pkg_tar(
    name = "app_tar",
    srcs = [":backend_cli"],
    include_runfiles = True,
    package_dir = "/app",
    strip_prefix = ".",
)

oci_image(
    name = "image",
    base = "@python_slim_linux_amd64",
    entrypoint = [
        "/app/backend_cli",
        "serve",
    ],
    env = {
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONUNBUFFERED": "1",
    },
    tars = [":app_tar"],
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["props-backend:latest"],
)

py_library(
    name = "__init__",
    srcs = ["__init__.py"],
    visibility = ["//:__subpackages__"],
)

py_library(
    name = "app",
    srcs = ["app.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":__init__",
        ":backend",
        "//cli_util:logging",
        "//props/cli:resources",
        "//props/orchestration:agent_registry",
        "//props/orchestration:grader_supervisor",
        "@pypi//aiodocker",
        "@pypi//asyncpg",
        "@pypi//fastapi",
    ],
)

py_library(
    name = "auth",
    srcs = ["auth.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//props/db:config",
        "//props/db:models",
        "//props/db:session",
        "@pypi//fastapi",
        "@pypi//psycopg",
        "@pypi//starlette",
    ],
)
