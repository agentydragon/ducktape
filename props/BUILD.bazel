# Props workspace - top-level package
# gazelle:exclude specimens

load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//devinfra/deps:check.bzl", "assert_no_deps")
load("//devinfra/python:defs.bzl", "py_library")

exports_files([
    "config.toml",
])

# Crane binary for agent images that need OCI push/pull (PO, PI).
pkg_tar(
    name = "crane_tar",
    srcs = ["@crane"],
    mode = "0755",
    package_dir = "/usr/local/bin",
    visibility = ["//props:__subpackages__"],
)

py_library(
    name = "config",
    srcs = ["config.py"],
    visibility = ["//props:__subpackages__"],
    deps = [
        "//openai_utils:api_shape",
        "//openai_utils:model_metadata",
        "@pypi//pydantic",
    ],
)

# Shared pytest configuration for all props tests
py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    visibility = ["//props:__subpackages__"],
    deps = [
        "//agent_core/testing:fixtures",
        "//agent_core/testing:responses",
        "//agent_core/testing/mcp:fixtures",
        "//agent_core/testing/mcp:responses",
        "//mcp_infra/testing:fixtures",
        "//props/testing/fixtures:db",
        "//props/testing/fixtures:e2e",
        "//props/testing/fixtures:e2e_container",
        "//props/testing/fixtures:e2e_infra",
        "//props/testing/fixtures:ground_truth",
        "//props/testing/fixtures:runs",
        "//props/testing/fixtures:scopes",
        "//util/testing:otel_tracing",
        "@pypi//opentelemetry_api",
        "@pypi//pytest",
    ],
)

# =============================================================================
# Boundary enforcement tests
# =============================================================================

# Verify host-side code doesn't depend on agents/ (container-only code)
assert_no_deps(
    name = "test_no_agents_deps",
    forbidden = ["//props/agents"],
    targets = [
        "//props/orchestration:agent_registry",
        "//props/backend:app",
        "//props/core:agent_types",
        "//props/db:notifications",
        "//props/cli:cli",
    ],
)
