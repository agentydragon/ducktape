# gazelle:python_generation_mode file
# gazelle:python_library_naming_convention $package_name$_lib
# Props workspace - top-level package

load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_python//python:defs.bzl", "py_library")

exports_files([
    "config.toml",
])

# Crane binary for agent images that need OCI push/pull (PO, PI).
pkg_tar(
    name = "crane_tar",
    srcs = ["@crane"],
    mode = "0755",
    package_dir = "/usr/local/bin",
    visibility = ["//props:__subpackages__"],
)

py_library(
    name = "config",
    srcs = ["config.py"],
    imports = [".."],
    visibility = ["//props:__subpackages__"],
    deps = [
        "@pypi//pydantic",
    ],
)

# Shared pytest configuration for all props tests
py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    imports = [".."],
    visibility = ["//props:__subpackages__"],
    deps = [
        "//agent_core/testing:fixtures",
        "//agent_core/testing:responses",
        "//agent_core/testing/mcp:fixtures",
        "//agent_core/testing/mcp:responses",
        "//mcp_infra/testing:fixtures",
        "//props/testing",
        "//props/testing/fixtures:db",
        "//props/testing/fixtures:e2e",
        "//props/testing/fixtures:e2e_container",
        "//props/testing/fixtures:e2e_infra",
        "//props/testing/fixtures:ground_truth",
        "//props/testing/fixtures:runs",
        "//props/testing/fixtures:scopes",
        "@pypi//pytest",
    ],
)
