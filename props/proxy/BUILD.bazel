"""Combined Props Proxy OCI image built with Bazel.

The proxy combines LLM proxy and Registry proxy functionality:
- LLM: validates agent tokens, enforces model restrictions, logs requests
- Registry: enforces ACL and records agent image pushes

Build targets:
    bazel run //props/proxy:load  -- Load into local Docker
    bazel run //props/proxy:push  -- Push to local registry (localhost:5050)

Library targets (modular):
    //props/proxy:auth_lib       -- Shared auth middleware and utilities
    //props/proxy:llm_app_lib    -- LLM proxy app (standalone)
    //props/proxy:registry_app_lib -- Registry proxy app (standalone)
    //props/proxy:app_lib        -- Combined app

Test targets:
    //props/proxy:test_llm_app      -- LLM proxy tests
    //props/proxy:test_registry_app -- Registry proxy tests
"""

load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load", "oci_push")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

# =============================================================================
# Library targets (modular)
# =============================================================================

py_library(
    name = "auth_lib",
    srcs = ["auth.py"],
    imports = ["../.."],
    visibility = ["//visibility:public"],
    deps = [
        "@pypi//fastapi",
        "@pypi//psycopg",
        "@pypi//starlette",
    ],
)

py_library(
    name = "llm_app_lib",
    srcs = ["llm_app.py"],
    imports = ["../.."],
    visibility = ["//visibility:public"],
    deps = [
        ":auth_lib",
        "//props/db:models",
        "//props/db:session",
        "@pypi//fastapi",
        "@pypi//httpx",
    ],
)

py_library(
    name = "registry_app_lib",
    srcs = ["registry_app.py"],
    imports = ["../.."],
    visibility = ["//visibility:public"],
    deps = [
        ":auth_lib",
        "//props/core:oci_utils",
        "//props/db:models",
        "//props/db:session",
        "@pypi//fastapi",
        "@pypi//httpx",
    ],
)

py_library(
    name = "app_lib",
    srcs = [
        "__init__.py",
        "app.py",
    ],
    imports = ["../.."],
    visibility = ["//visibility:public"],
    deps = [
        ":auth_lib",
        ":llm_app_lib",
        ":registry_app_lib",
        "@pypi//fastapi",
    ],
)

# =============================================================================
# Binary and OCI image targets
# =============================================================================

py_binary(
    name = "proxy",
    srcs = ["main.py"],
    main = "main.py",
    visibility = ["//visibility:public"],
    deps = [
        ":app_lib",
        "@pypi//typer",
        "@pypi//uvicorn",
    ],
)

pkg_tar(
    name = "app_tar",
    srcs = [":proxy"],
    include_runfiles = True,
    package_dir = "/app",
    strip_prefix = ".",
)

oci_image(
    name = "image",
    base = "@python_slim_linux_amd64",
    cmd = ["/app/proxy"],
    env = {
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONUNBUFFERED": "1",
        "OPENAI_UPSTREAM_URL": "https://api.openai.com",
        "PROPS_REGISTRY_UPSTREAM_URL": "http://props-registry:5000",
        "PORT": "5050",
        "LOG_LEVEL": "info",
    },
    exposed_ports = ["5050/tcp"],
    tars = [":app_tar"],
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["props-proxy:latest"],
)

# Push to local registry (localhost:5050, running via devenv)
# Usage: bazel run //props/proxy:push
oci_push(
    name = "push",
    image = ":image",
    remote_tags = ["latest"],
    repository = "localhost:5050/proxy",
)

# =============================================================================
# Test targets (separate for each module)
# =============================================================================

# Shared test fixtures
py_library(
    name = "test_conftest",
    srcs = ["conftest.py"],
    imports = ["../.."],
    visibility = ["//visibility:public"],
    deps = [
        ":app_lib",
        "//props/db:config",
        "//props/db:examples",
        "//props/db:models",
        "//props/db:session",
        "//props/db:temp_user_manager",
        "//props/testing",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",
        "@pypi//starlette",
    ],
)

py_test(
    name = "test_llm_app",
    srcs = ["test_llm_app.py"],
    env = {
        "PGHOST": "127.0.0.1",
        "PGPORT": "5433",
    },
    imports = ["../.."],
    tags = ["requires_postgres"],
    deps = [
        ":app_lib",
        ":llm_app_lib",
        ":test_conftest",
        "//openai_utils",
        "//props/db:config",
        "//props/db:examples",
        "//props/db:models",
        "//props/db:session",
        "//props/db:temp_user_manager",
        "//props/testing",
        "@pypi//fastapi",
        "@pypi//httpx",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
        "@pypi//starlette",
    ],
)

py_test(
    name = "test_registry_app",
    srcs = ["test_registry_app.py"],
    env = {
        "PGHOST": "127.0.0.1",
        "PGPORT": "5433",
    },
    imports = ["../.."],
    tags = ["requires_postgres"],
    deps = [
        ":app_lib",
        ":registry_app_lib",
        ":test_conftest",
        "//props/db:config",
        "//props/db:models",
        "//props/db:session",
        "//props/testing",
        "@pypi//fastapi",
        "@pypi//httpx",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",
        "@pypi//pytest_bazel",
        "@pypi//starlette",
    ],
)
