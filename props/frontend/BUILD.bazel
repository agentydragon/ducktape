load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library", "js_run_binary", "js_test")
load("@npm_ducktape//:defs.bzl", "npm_link_all_packages")
load("@npm_ducktape//:svelte-check/package_json.bzl", svelte_check_bin = "bin")
load("//devinfra/js:spa_bundle.bzl", "spa_bundle")

# Link npm packages for this workspace member
npm_link_all_packages(name = "node_modules")

# Export config files
exports_files([
    ".prettierrc",
    "tsconfig.json",
])

exports_files(
    ["index.html"],
    visibility = ["//props/backend:__pkg__"],
)

# ============================================================
# App entry point (transitive deps pull in all sources)
# ============================================================

js_library(
    name = "app_css",
    srcs = ["src/app.css"],
)

js_library(
    name = "app",
    srcs = [
        "src/App.svelte",
        "src/main.ts",
    ],
    deps = [
        ":app_css",
        ":node_modules/svelte",
        "//props/frontend/src/components:RunTriggerModal",
        "//props/frontend/src/lib:router",
        "//props/frontend/src/lib:token",
        "//props/frontend/src/lib:types",
        "//props/frontend/src/pages:DefinitionDetailPage",
        "//props/frontend/src/pages:ExamplesPage",
        "//props/frontend/src/pages:OverviewPage",
        "//props/frontend/src/pages:RunDetailPage",
        "//props/frontend/src/pages:RunsPage",
        "//props/frontend/src/pages:SnapshotDetailPage",
        "//props/frontend/src/pages:SnapshotsPage",
    ],
)

# ============================================================
# Development server
# ============================================================

# Run: bazel run //props/frontend:dev
js_binary(
    name = "dev",
    chdir = package_name(),
    data = [
        "dev.mjs",
        "index.html",
        "svelte.config.js",
        "tsconfig.json",
        ":app",
        ":node_modules",
        "//props/backend:backend_cli",
        "//props/frontend/src/lib:schema",
    ],
    entry_point = "dev.mjs",
    no_copy_to_bin = ["//props/backend:backend_cli"],
)

# ============================================================
# Production bundle
# ============================================================

# Svelte + Tailwind plugins for the native esbuild() rule (see spa_bundle).
js_library(
    name = "esbuild_config",
    srcs = ["esbuild_config.mjs"],
    deps = [
        ":node_modules/esbuild-plugin-tailwindcss",
        ":node_modules/esbuild-svelte",
        ":node_modules/svelte",
        ":node_modules/tailwindcss",
    ],
)

# index.html is served separately by the backend (packaged at /frontend, with
# the bundle under /frontend/dist), so it is not copied into the bundle dir.
spa_bundle(
    name = "bundle",
    config = ":esbuild_config",
    entry_point = "src/main.ts",
    index_html = None,
    # esbuild-svelte with `css: injected` rejects "linked" source maps.
    sourcemap = "external",
    splitting = True,
    visibility = ["//props/backend:__pkg__"],
    # The app's components import many npm packages (lucide-svelte, svelte-sonner,
    # highlight.js, chart.js, …) without per-file js_library npm deps; the whole
    # linked node_modules makes them resolvable, as the old driver's nodePaths did.
    deps = [
        ":app",
        ":node_modules",
    ],
)

# ============================================================
# Type checking
# ============================================================

# Run: bazel test //props/frontend:svelte_check_test
svelte_check_bin.svelte_check_test(
    name = "svelte_check_test",
    args = [
        "--tsconfig",
        "tsconfig.json",
    ],
    chdir = package_name(),
    data = [
        "svelte.config.js",
        "tsconfig.json",
        ":app",
        ":node_modules",
        "//props/frontend/src/lib:schema",
    ],
    tags = ["lint"],
)

# ============================================================
# Test harness (visual regression scaffold)
# ============================================================

js_library(
    name = "scenarios",
    srcs = ["tests/harness/scenarios.mjs"],
    visibility = ["//props/frontend/src:__subpackages__"],
)

js_library(
    name = "harness_lib",
    srcs = [
        "tests/harness/harness.ts",
        "tests/harness/index.html",
    ],
    tags = ["no-lint"],
    deps = [
        ":app_css",
        ":node_modules/svelte",
        ":scenarios",
        "//props/frontend/src/components:DefinitionDetail",
        "//props/frontend/src/components:FileViewer",
        "//props/frontend/src/components:LLMRequestViewer",
        "//props/frontend/src/components:RunDetail",
        "//props/frontend/src/components:RunsBrowser",
        "//props/frontend/src/components/stats:CoverageHeatmap",
        "//props/frontend/src/components/stats:DistributionChart",
        "//props/frontend/src/components/stats:OccurrenceStats",
        "//props/frontend/src/pages:SnapshotDetailPage",
    ],
)

js_binary(
    name = "build_harness",
    data = [
        "tests/harness/esbuild.config.mjs",
        ":harness_lib",
        ":node_modules",
    ],
    entry_point = "tests/harness/esbuild.config.mjs",
)

js_run_binary(
    name = "harness_bundle",
    srcs = [
        "tests/harness/esbuild.config.mjs",
        ":harness_lib",
    ],
    outs = [
        "tests/harness/dist/harness.css",
        "tests/harness/dist/harness.js",
    ],
    args = ["tests/harness/dist"],
    chdir = package_name(),
    tool = ":build_harness",
    visibility = ["//props/frontend/src:__subpackages__"],
)

filegroup(
    name = "harness_js",
    srcs = ["tests/harness/dist/harness.js"],
    visibility = ["//props/frontend/src:__subpackages__"],
)

# ============================================================
# Tests
# ============================================================

js_test(
    name = "router_test",
    data = [":node_modules"],
    entry_point = "tests/router.test.mjs",
)

# ============================================================
# Visual regression tests
#
# Every scenario in tests/harness/scenarios.mjs, swept on one browser per shard.
#
# Run all:  bazel test //props/frontend:visual
# Run one:  bazel test //props/frontend:visual --test_filter=DefinitionDetail
# ============================================================

filegroup(
    name = "visual_test_assets",
    srcs = ["tests/harness/index.html"],
    visibility = ["//props/frontend/src:__subpackages__"],
)

VISUAL_DATA = [
    ":harness_bundle",
    ":harness_js",
    ":visual_test_assets",
    "//util/testing/frontend_visual:fonts",
    "//util/testing/frontend_visual:fonts_conf",
    "//util/testing/frontend_visual:visual_test_lib",
    "@playwright_browsers//:chromium-headless-shell",
]

# small: a shard renders 3 scenarios on one Chromium. The 12 per-scenario targets this replaces
# were 6.0-9.4s each, almost all of it browser launch and input staging paid once per scenario.
js_test(
    name = "visual",
    size = "small",
    # :scenarios is copied to bin beside the runner that imports it, unlike the prebuilt harness
    # assets, which are read where they lie.
    data = VISUAL_DATA + [":scenarios"],
    entry_point = "tests/visual_runner.mjs",
    env = {
        "HARNESS_PATH": "$(rootpath :harness_js)",
        "CHROMIUM_HEADLESS_SHELL": "$(rootpath @playwright_browsers//:chromium-headless-shell)",
        "FONTCONFIG_FILE": "$(rootpath //util/testing/frontend_visual:fonts_conf)",
        "FREETYPE_PROPERTIES": "cff:no-stem-darkening=1",
    },
    no_copy_to_bin = VISUAL_DATA,
    shard_count = 4,
)
