load("//devinfra/js:openapi_typescript.bzl", "openapi_typescript")
load("//devinfra/js:ts_library.bzl", "ts_library")

package(default_visibility = [
    "//props/frontend:__pkg__",
    "//props/frontend:__subpackages__",
])

filegroup(
    name = "typed_lint_srcs",
    srcs = glob(
        [
            "*.ts",
            "*.tsx",
            "**/*.ts",
            "**/*.tsx",
        ],
        allow_empty = True,
    ),
    visibility = ["//props/frontend:__pkg__"],
)

openapi_typescript(
    name = "schema",
    out = "api/schema.d.ts",
    schema = "//props/backend:openapi_schema",
)

ts_library(
    name = "llmRequestUtils",
    srcs = ["llmRequestUtils.ts"],
    tsconfig = "//props/frontend:tsconfig",
)

ts_library(
    name = "colors",
    srcs = ["colors.ts"],
    tsconfig = "//props/frontend:tsconfig",
)

ts_library(
    name = "icon_types",
    srcs = ["icon_types.ts"],
    tsconfig = "//props/frontend:tsconfig",
    deps = ["//props/frontend:node_modules/@types/react"],
)

ts_library(
    name = "icons",
    srcs = [
        "icons.tsx",
        "tabler_icons.d.ts",
    ],
    tsconfig = "//props/frontend:tsconfig",
    deps = [
        ":icon_types",
        "//props/frontend:node_modules/@tabler/icons-react",
        "//props/frontend:node_modules/@types/react",
        "//props/frontend:node_modules/react",
    ],
)

ts_library(
    name = "fileTypes",
    srcs = ["fileTypes.ts"],
    tsconfig = "//props/frontend:tsconfig",
    deps = [
        ":icon_types",
        ":icons",
    ],
)

ts_library(
    name = "highlighting",
    srcs = ["highlighting.ts"],
    tsconfig = "//props/frontend:tsconfig",
    deps = ["//props/frontend:node_modules/highlight.js"],
)

ts_library(
    name = "token",
    srcs = ["stores/token.ts"],
    tsconfig = "//props/frontend:tsconfig",
    deps = [
        "//props/frontend:node_modules/@types/react",
        "//props/frontend:node_modules/react",
    ],
)

ts_library(
    name = "types",
    srcs = ["types.ts"],
    tsconfig = "//props/frontend:tsconfig",
    deps = [
        ":schema",
    ],
)

ts_library(
    name = "client",
    srcs = ["api/client.ts"],
    tsconfig = "//props/frontend:tsconfig",
    deps = [
        ":schema",
        ":token",
        "//props/frontend:node_modules/openapi-fetch",
    ],
)

ts_library(
    name = "formatters",
    srcs = ["formatters.ts"],
    tsconfig = "//props/frontend:tsconfig",
    deps = [
        ":schema",
        ":types",
        "//props/frontend:node_modules/date-fns",
    ],
)

ts_library(
    name = "status",
    srcs = ["status.ts"],
    tsconfig = "//props/frontend:tsconfig",
    deps = [
        ":client",
        ":schema",
    ],
)

