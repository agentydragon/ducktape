"""Orchestration package - host-side agent container management.

This package contains HOST-only code that orchestrates agent containers:
- AgentRegistry: unified entry point for running agents
- grader_supervisor: grader container lifecycle management
- agent_credentials: PostgreSQL role creation for agents
"""

load("@rules_python//python:defs.bzl", "py_library")

py_library(
    name = "agent_credentials",
    srcs = ["agent_credentials.py"],
    imports = ["../.."],
    visibility = ["//props:__subpackages__"],
    deps = [
        "//props/db:config",
        "@pypi//asyncpg",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "docker_env",
    srcs = ["docker_env.py"],
    imports = ["../.."],
    visibility = ["//props:__subpackages__"],
)

py_library(
    name = "agent_registry",
    srcs = ["agent_registry.py"],
    imports = ["../.."],
    visibility = ["//props:__subpackages__"],
    deps = [
        ":agent_credentials",
        ":docker_env",
        "//props/core:agent_types",
        "//props/core:display",
        "//props/core:ids",
        "//props/core:oci_utils",
        "//props/core/models:examples",
        "//props/db:config",
        "//props/db:database",
        "//props/db:models",
        "@pypi//aiodocker",
        "@pypi//httpx",
    ],
)

py_library(
    name = "grader_supervisor",
    srcs = ["grader_supervisor.py"],
    imports = ["../.."],
    visibility = ["//props:__subpackages__"],
    deps = [
        ":agent_registry",
        "//props/core:agent_types",
        "//props/core:ids",
        "//props/core:oci_utils",
        "//props/db:config",
        "//props/db:database",
        "//props/db:models",
        "//props/db:notifications",
        "@pypi//asyncpg",
    ],
)
