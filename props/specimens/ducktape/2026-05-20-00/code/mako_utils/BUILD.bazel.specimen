load("@rules_python//python:py_library.bzl", "py_library")
load("//devinfra/python:defs.bzl", "py_test")

py_library(
    name = "preprocessor",
    srcs = ["preprocessor.py"],
    visibility = ["//visibility:public"],
    deps = ["@pypi//mako"],
)

py_test(
    name = "test_preprocessor",
    srcs = ["test_preprocessor.py"],
    deps = [
        ":preprocessor",
        "@pypi//mako",
        "@pypi//pytest_bazel",
    ],
)
