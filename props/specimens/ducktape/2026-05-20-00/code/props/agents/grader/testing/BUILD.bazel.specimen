"""Shared test fixtures for grader agents."""

load("//devinfra/python:defs.bzl", "py_library")

py_library(
    name = "mocks",
    testonly = True,
    srcs = ["mocks.py"],
    visibility = ["//props:__subpackages__"],
    deps = [
        "//agent_core/testing:responses",
        "//openai_utils:model",
        "//props/agents/grader:drift_handler",
        "//props/agents/grader:tools",
        "@pypi//more_itertools",
    ],
)
