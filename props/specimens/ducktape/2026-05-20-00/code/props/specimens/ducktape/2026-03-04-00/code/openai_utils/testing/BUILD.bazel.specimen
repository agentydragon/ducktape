load("@rules_python//python:defs.bzl", "py_library")

py_library(
    name = "fixtures",
    testonly = True,
    srcs = ["fixtures.py"],
    imports = ["../.."],
    visibility = ["//:__subpackages__"],
    deps = [
        "//openai_utils:client_factory",
        "//openai_utils:model",
        "@pypi//httpx",
        "@pypi//openai",
        "@pypi//pytest",
    ],
)

py_library(
    name = "openai_mock",
    srcs = ["openai_mock.py"],
    imports = ["../.."],
    visibility = ["//:__subpackages__"],
    deps = [
        "//openai_utils:model",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "strict_mode_models",
    srcs = ["strict_mode_models.py"],
    imports = ["../.."],
    visibility = ["//:__subpackages__"],
    deps = ["@pypi//pydantic"],
)
