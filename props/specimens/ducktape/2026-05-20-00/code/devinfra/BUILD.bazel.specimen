# gazelle:exclude ci

load("@bazel_gazelle//:def.bzl", "gazelle", "gazelle_binary")
load("@npm_ducktape//:prettier/package_json.bzl", prettier_bin = "bin")
load("@pypi//:requirements.bzl", "all_whl_requirements")
load("@rules_python_gazelle_plugin//manifest:defs.bzl", "gazelle_python_manifest")
load("@rules_python_gazelle_plugin//modules_mapping:def.bzl", "modules_mapping")
load("//devinfra:filter_wheels.bzl", "filter_system_packages")
load("//devinfra/python:defs.bzl", "py_library", "py_test")

exports_files([
    "image_pins.json",
    "lockfile.json",
])

py_library(
    name = "pytest_main",
    srcs = ["pytest_main.py"],
    visibility = ["//visibility:public"],
    deps = ["//util/bazel:workspace"],
)

# === Gazelle (Python BUILD file generator) ===

# Extract import metadata from wheels for Gazelle's Python import resolution
modules_mapping(
    name = "modules_map",
    wheels = filter_system_packages(all_whl_requirements),
)

# Generate gazelle_python.yaml manifest for Gazelle to resolve PyPI imports.
# Run `bazel run //devinfra:gazelle_python_manifest.update` to regenerate.
# The .test target verifies the manifest is up-to-date.
gazelle_python_manifest(
    name = "gazelle_python_manifest",
    modules_mapping = ":modules_map",
    pip_repository_name = "pypi",
    requirements = "//:requirements_bazel.txt",
)

gazelle_binary(
    name = "gazelle_python_binary",
    languages = ["@rules_python_gazelle_plugin//python"],
)

gazelle(
    name = "gazelle",
    data = [":gazelle_python_manifest"],
    gazelle = ":gazelle_python_binary",
)

prettier_bin.prettier_binary(
    name = "prettier_bin",
    data = ["//:prettierrc"],
    fixed_args = [
        "--config",
        "\"$$JS_BINARY__RUNFILES\"/$(rlocationpath //:prettierrc)",
    ],
    visibility = ["//visibility:public"],
)

py_library(
    name = "bbr",
    srcs = ["bbr.py"],
    visibility = ["//:__pkg__"],
    deps = ["@pypi//pygit2"],
)

py_test(
    name = "test_bbr",
    srcs = ["test_bbr.py"],
    deps = [
        ":bbr",
        "@pypi//pygit2",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "prettier",
    srcs = ["prettier.py"],
    data = [":prettier_bin"],
    visibility = ["//visibility:public"],
    deps = ["//util/bazel:runfiles"],
)
