py_test(
    name = "test_integration",
    srcs = ["test_integration.py"],
    data = ["@multitool//tools/ruff"],
    env = {"RUFF_BIN": "$(rlocationpath @multitool//tools/ruff)"},
    deps = [
        ":cli",
        ":conftest",
        "//util/bazel:subprocess",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@rules_python//python/runfiles",
    ],
)

