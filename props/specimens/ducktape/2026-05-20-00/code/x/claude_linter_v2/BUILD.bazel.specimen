load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

py_library(
    name = "checkers_v2",
    srcs = ["checkers_v2.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":rule_registry",
        "//x/claude_linter_v2/config:clean_models",
        "//x/claude_linter_v2/config:models",
    ],
)

py_library(
    name = "cli",
    srcs = ["cli.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//llm:claude_code_api",
        "//x/claude_linter_v2/hooks:exceptions",
        "//x/claude_linter_v2/hooks:handler",
        "//x/claude_linter_v2/session:manager",
        "@pypi//click",
        "@pypi//humanize",
        "@pypi//pytimeparse",
    ],
)

py_library(
    name = "conftest",
    srcs = ["conftest.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":types",
        "//llm:claude_code_api",
        "@pypi//pytest",
    ],
)

py_library(
    name = "llm_analyzer",
    srcs = ["llm_analyzer.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//llm:claude_code_api",
        "//x/claude_linter_v2/config:models",
    ],
)

py_library(
    name = "notifications",
    srcs = ["notifications.py"],
    visibility = ["//:__subpackages__"],
)

py_library(
    name = "pattern_matcher",
    srcs = ["pattern_matcher.py"],
    visibility = ["//:__subpackages__"],
    deps = ["//x/claude_linter_v2/config:models"],
)

py_library(
    name = "rule_registry",
    srcs = ["rule_registry.py"],
    visibility = ["//:__subpackages__"],
    deps = ["//x/claude_linter_v2/config:models"],
)

py_library(
    name = "types",
    srcs = ["types.py"],
    visibility = ["//:__subpackages__"],
    deps = ["//llm:claude_code_api"],
)

py_binary(
    name = "claude_linter_v2",
    srcs = ["cli.py"],
    main = "cli.py",
    deps = [
        ":cli",
        "//llm:claude_code_api",
        "//x/claude_linter_v2/hooks:exceptions",
        "//x/claude_linter_v2/hooks:handler",
        "//x/claude_linter_v2/session:manager",
        "@pypi//click",
        "@pypi//humanize",
    ],
)

py_test(
    name = "test_diff_intelligence",
    srcs = ["test_diff_intelligence.py"],
    deps = [
        ":conftest",
        "//llm:claude_code_api",
        "//x/claude_linter_v2/config:models",
        "//x/claude_linter_v2/diff:categorizer",
        "//x/claude_linter_v2/diff:intelligence",
        "//x/claude_linter_v2/diff:parser",
        "@pypi//pytest_bazel",
    ],
)

