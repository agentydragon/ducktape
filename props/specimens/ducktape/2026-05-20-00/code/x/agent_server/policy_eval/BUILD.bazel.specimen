"""Policy evaluation package - container-based policy execution."""

load("@aspect_rules_py//py:defs.bzl", "py_image_layer", aspect_py_binary = "py_binary")
load("//devinfra/python:defs.bzl", "py_binary", "py_library")

py_binary(
    name = "shim",
    srcs = ["shim.py"],
    main = "shim.py",
    visibility = ["//visibility:public"],
    deps = [
        ":constants",
        "//mcp_infra:constants",
        "//mcp_infra:naming",
        "//x/agent_server:approvals",
        "//x/agent_server/policies:default_policy",
        "//x/agent_server/policies:policy_types",
        "//x/agent_server/policies:scaffold",
    ],
)

aspect_py_binary(
    name = "shim_bin",
    srcs = ["shim.py"],
    main = "shim.py",
    visibility = ["//x/agent_server:__pkg__"],
    deps = [
        ":constants",
        "//mcp_infra:constants",
        "//mcp_infra:naming",
        "//x/agent_server:approvals",
        "//x/agent_server/policies:default_policy",
        "//x/agent_server/policies:policy_types",
        "//x/agent_server/policies:scaffold",
    ],
)

py_image_layer(
    name = "layers",
    binary = ":shim_bin",
    visibility = ["//x/agent_server:__pkg__"],
)

py_library(
    name = "constants",
    srcs = ["constants.py"],
    visibility = ["//:__subpackages__"],
)

py_library(
    name = "container",
    srcs = ["container.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":runner",
        "//x/agent_server/policies:policy_types",
        "//x/agent_server/runtime:images",
        "@pypi//aiodocker",
    ],
)

py_library(
    name = "runner",
    srcs = ["runner.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":constants",
        "//x/agent_server/policies:policy_types",
        "//x/agent_server/runtime:images",
        "@pypi//aiodocker",
    ],
)
