load("//devinfra/python:defs.bzl", "py_library")

py_library(
    name = "graph",
    srcs = ["graph.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":wrappers",
        "//tana/domain:constants",
        "//tana/domain:nodes",
        "//tana/domain:types",
    ],
)

py_library(
    name = "loader",
    srcs = ["loader.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":graph",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "wrappers",
    srcs = ["wrappers.py"],
    visibility = ["//:__subpackages__"],
    deps = ["//tana/domain:nodes"],
)
