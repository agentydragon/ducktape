load("//devinfra/python:defs.bzl", "py_library")

# Core LLM utilities - Claude Code API, hooks, outcomes
py_library(
    name = "claude_code_api",
    srcs = ["claude_code_api.py"],
    visibility = ["//visibility:public"],
    deps = [
        "@pypi//pydantic",
    ],
)

py_library(
    name = "claude_outcomes",
    srcs = ["claude_outcomes.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":claude_code_api",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "claude_hooks",
    srcs = ["claude_hooks.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":claude_code_api",
    ],
)

# Convenience target for the core library
py_library(
    name = "core",
    visibility = ["//visibility:public"],
    deps = [
        ":claude_code_api",
        ":claude_hooks",
        ":claude_outcomes",
    ],
)
