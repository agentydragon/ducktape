# =============================================================================
# Shared CLI packaging (used by all agent images)
# =============================================================================

pkg_tar(
    name = "app_tar",
    srcs = [":cli"],
    include_runfiles = True,
    package_dir = "/app",
    strip_prefix = ".",
    visibility = ["//props:__subpackages__"],
)

# =============================================================================
# OCI Image for GHCR (specimens validation)
# =============================================================================

oci_image(
    name = "image",
    base = "@python_slim_linux_amd64",
    entrypoint = ["/app/cli"],
    env = {
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONUNBUFFERED": "1",
    },
    tars = [":app_tar"],
    workdir = "/specimens",
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["props-cli:latest"],
)

oci_push(
    name = "push_ghcr",
    image = ":image",
    remote_tags = ["latest"],
    repository = "ghcr.io/agentydragon/props-cli",
)
