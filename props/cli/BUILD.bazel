# Props has complex inter-package dependencies that are manually configured

# gazelle:python_library_naming_convention $package_name$_lib
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

# =============================================================================
# Subcommand modules
# =============================================================================

py_library(
    name = "cmd_db",
    srcs = ["cmd_db.py"],
    imports = ["../.."],
    visibility = ["//props:__subpackages__"],
    deps = [
        "//props/db:config",
        "//props/db:database",
        "//props/db:setup",
        "//props/db/sync",
        "//props/db/sync:model_metadata",
        "@pypi//rich",
        "@pypi//typer_slim",
    ],
)

py_library(
    name = "cmd_gepa",
    srcs = ["cmd_gepa.py"],
    imports = ["../.."],
    visibility = ["//props:__subpackages__"],
    deps = [
        "//cli_util:decorators",
        "//openai_utils:client_factory",
        "//props/core:agent_workspace",
        "//props/core/gepa:gepa_adapter",
        "//props/db:database",
        "@pypi//rich",
        "@pypi//typer_slim",
    ],
)

# =============================================================================
# Main entry point
# =============================================================================

py_library(
    name = "main",
    srcs = ["main.py"],
    imports = ["../.."],
    visibility = ["//props:__subpackages__"],
    deps = [
        ":cmd_db",
        ":cmd_gepa",
        "//cli_util:logging",
        "//props/db:database",
        "@pypi//rich",
        "@pypi//typer",
        "@pypi//typer_di",
    ],
)

py_binary(
    name = "cli",
    main_module = "props.cli.main",
    visibility = ["//visibility:public"],
    deps = [":main"],
)
