# Props has complex inter-package dependencies that are manually configured

load("//devinfra/python:defs.bzl", "py_binary", "py_library")

# =============================================================================
# Subcommand modules
# =============================================================================

py_library(
    name = "cmd_db",
    srcs = ["cmd_db.py"],
    visibility = ["//props:__subpackages__"],
    deps = [
        "//props/db:config",
        "//props/db:database",
        "//props/db:setup",
        "//props/db/sync",
        "//props/db/sync:model_metadata",
        "@pypi//rich",
        "@pypi//typer",
    ],
)

# =============================================================================
# Main entry point
# =============================================================================

py_library(
    name = "main",
    srcs = ["main.py"],
    visibility = ["//props:__subpackages__"],
    deps = [
        ":cmd_db",
        "//props/db:database",
        "//util:logging",
        "@pypi//rich",
        "@pypi//typer",
        "@pypi//typer_di",
    ],
)

py_binary(
    name = "cli",
    main_module = "props.cli.main",
    visibility = ["//visibility:public"],
    deps = [":main"],
)
