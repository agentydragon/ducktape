"""Props test infrastructure package."""

load("@rules_python//python:defs.bzl", "py_library")

package(default_testonly = True)

py_library(
    name = "testing",
    srcs = ["mocks.py"],
    imports = ["../.."],
    visibility = ["//visibility:public"],
    deps = [
        "//agent_core/testing:responses",
        "//agent_core/testing/mcp:responses",
        "//mcp_infra/exec:models",
        "//openai_utils:model",
    ],
)

py_library(
    name = "constants",
    srcs = ["constants.py"],
    imports = ["../.."],
    visibility = ["//props:__subpackages__"],
)

py_library(
    name = "fake_openai_server",
    srcs = ["fake_openai_server.py"],
    imports = ["../.."],
    visibility = ["//visibility:public"],
    deps = [
        ":constants",
        "//openai_utils:model",
        "@pypi//fastapi",
        "@pypi//openai",
        "@pypi//pydantic",
        "@pypi//uvicorn",
    ],
