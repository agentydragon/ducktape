"""Props test infrastructure package."""

load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_testonly = True)

py_library(
    name = "testing",
    srcs = ["mocks.py"],
    visibility = ["//visibility:public"],
    deps = [
        "//agent_core/testing:responses",
        "//agent_core/testing/mcp:responses",
        "//openai_utils:model",
        "//util/exec:models",
        "//util/exec:subprocess",
    ],
)

py_library(
    name = "constants",
    srcs = ["constants.py"],
    visibility = ["//props:__subpackages__"],
    deps = [
        "//props/core:ids",
        "//props/core/models:examples",
    ],
)

py_library(
    name = "assertions",
    srcs = ["assertions.py"],
    visibility = ["//visibility:public"],
    deps = [
        "//props/agents/grader:drift_handler",
        "//props/db:database",
    ],
)

py_library(
    name = "fake_openai_server",
    srcs = ["fake_openai_server.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":constants",
        "//openai_utils:model",
        "@pypi//fastapi",
        "@pypi//openai",
        "@pypi//pydantic",
    ],
)

py_test(
    name = "test_fake_openai_server",
    srcs = ["test_fake_openai_server.py"],
    deps = [
        ":fake_openai_server",
        "//:conftest",
        "//openai_utils:model",
        "//props:conftest",
        "//util/testing:asgi",
        "@pypi//httpx",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
