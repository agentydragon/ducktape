"""Gatelet server package."""

# NOTE: No aggregator target - use specific per-file targets like :app, :config, etc.
# This is the Gazelle-compatible pattern (python_generation_mode = file)

load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("//tools/testing:docker.bzl", "docker_py_test")

py_binary(
    name = "server",
    imports = ["../../.."],
    main_module = "experimental.gatelet.server",
    visibility = ["//experimental/gatelet:__pkg__"],
    deps = [":__main__"],
)

py_library(
    name = "__main__",
    srcs = ["__main__.py"],
    imports = ["../../.."],
    visibility = ["//experimental/gatelet:__subpackages__"],
    deps = [
        ":app",
        "@pypi//uvicorn",
    ],
)

py_library(
    name = "app",
    srcs = ["app.py"],
    data = glob([
        "**/*.css",
        "**/*.html.j2",
    ]),
    imports = ["../../.."],
    visibility = ["//experimental/gatelet:__subpackages__"],
    deps = [
        ":database",
        ":lifespan",
        ":models",
        "//experimental/gatelet/server/auth:handlers",
        "//experimental/gatelet/server/auth:webhook_auth",
        "//experimental/gatelet/server/endpoints:admin",
        "//experimental/gatelet/server/endpoints:challenge",
        "//experimental/gatelet/server/endpoints:homeassistant",
        "//experimental/gatelet/server/endpoints:webhook_receive",
        "//experimental/gatelet/server/endpoints:webhook_view",
        "@pypi//fastapi",
        "@pypi//fastapi_csrf_protect",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "config",
    srcs = ["config.py"],
    imports = ["../../.."],
    visibility = ["//experimental/gatelet:__subpackages__"],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "database",
    srcs = ["database.py"],
    imports = ["../../.."],
    visibility = ["//experimental/gatelet:__subpackages__"],
    deps = [
        "@pypi//fastapi",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "lifespan",
    srcs = ["lifespan.py"],
    imports = ["../../.."],
    visibility = ["//experimental/gatelet:__subpackages__"],
    deps = [
        ":config",
        ":database",
        "//experimental/gatelet/server/auth:dependencies",
        "//experimental/gatelet/server/endpoints:activitywatch",
        "//experimental/gatelet/server/endpoints:homeassistant",
        "//experimental/gatelet/server/endpoints:webhook_view",
        "@pypi//fastapi",
        "@pypi//fastapi_csrf_protect",
        "@pypi//jinja2",
        "@pypi//pydantic",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "models",
    srcs = ["models.py"],
    imports = ["../../.."],
    visibility = ["//experimental/gatelet:__subpackages__"],
    deps = ["@pypi//sqlalchemy"],
)

py_library(
    name = "prompts",
    srcs = ["prompts.py"],
    imports = ["../../.."],
    visibility = ["//experimental/gatelet:__subpackages__"],
    deps = [
        ":config",
        ":models",
    ],
)

py_library(
    name = "security",
    srcs = ["security.py"],
    imports = ["../../.."],
    visibility = ["//experimental/gatelet:__subpackages__"],
    deps = ["@pypi//passlib"],
)

py_library(
    name = "shared",
    srcs = ["shared.py"],
    imports = ["../../.."],
    visibility = ["//experimental/gatelet:__subpackages__"],
    deps = [":config"],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    imports = ["../../.."],
    visibility = ["//experimental/gatelet:__subpackages__"],
    deps = [
        ":app",
        ":config",
        ":database",
        ":models",
        "//experimental/gatelet/server/endpoints:webhook_view",
        "//experimental/gatelet/server/tests:utils",
        "@pypi//asgi_lifespan",
        "@pypi//asyncpg",
        "@pypi//httpx",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",
        "@pypi//sqlalchemy",
        "@pypi//testcontainers",
    ],
)

docker_py_test(
    name = "test_admin_webhook_e2e",
    srcs = ["test_admin_webhook_e2e.py"],
    deps = [
        ":conftest",
        ":models",
        "//experimental/gatelet:manage",
        "//experimental/gatelet:manage_lib",
        "@pypi//playwright",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)

docker_py_test(
    name = "test_report_battery",
    srcs = ["test_report_battery.py"],
    deps = [
        ":conftest",
        ":models",
        "//experimental/gatelet:reporter",
        "//experimental/gatelet:reporter_lib",
        "//experimental/gatelet/server/tests:utils",
        "@pypi//httpx",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)

docker_py_test(
    name = "test_report_event",
    srcs = ["test_report_event.py"],
