load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

py_library(
    name = "lbrn2_writer",
    srcs = ["lbrn2_writer.py"],
    imports = ["../.."],
)

py_library(
    name = "material_test_lib",
    srcs = ["material_test.py"],
    imports = ["../.."],
