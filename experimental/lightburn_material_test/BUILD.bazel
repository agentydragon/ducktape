    main_module = "experimental.lightburn_material_test.material_test",
    deps = [":material_test_lib"],
)

py_test(
    name = "test_material_test",
    srcs = ["test_material_test.py"],
    imports = ["../.."],
    deps = [
        ":lbrn2_writer",
        ":material_test_lib",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
