load("@rules_python//python:packaging.bzl", "py_package", "py_wheel")

# gazelle:ignore
load("//devinfra/python:defs.bzl", "py_binary", "py_library")

py_library(
    name = "main",
    srcs = ["main.py"],
    # Requires system libraries (libgirepository1.0-dev, libdbus-1-dev) - manual only
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = [
        "@pypi//absl_py",
        "@pypi//dbus_python",
        "@pypi//pycairo",
        "@pypi//pygobject",
    ],
)

py_binary(
    name = "gterm_theme",
    srcs = ["main.py"],
    main = "main.py",
    tags = ["manual"],
    deps = [":main"],
)

py_package(
    name = "gterm_theme_pkg",
    packages = ["gnome.gterm_theme"],
    tags = ["manual"],
    deps = [":main"],
)

py_wheel(
    name = "wheel",
    distribution = "gterm_theme",
    entry_points = {
        "console_scripts": ["gterm-theme = gnome.gterm_theme.main:main"],
    },
    python_requires = ">=3.11",
    requires = [
        "absl-py",
        "dbus-python",
        "pycairo",
        "pygobject",
    ],
    tags = ["manual"],
    version = "0.1.0",
    deps = [":gterm_theme_pkg"],
)
