# openclaw-exec: DirectExecServer + mcporter + kubectl sidecar image.
#
# Built on top of //mcp_infra/exec:direct_image (debian-slim + Python
# DirectExecServer) with three additional layers:
#
#   kubectl_layer   — single kubectl binary from dl.k8s.io
#   node_bin_layer  — Node.js 'node' binary for running mcporter
#   mcporter_layer  — mcporter CLI bundled to a single CJS file by esbuild
#                     (built in //third_party/mcporter)
#
# No private registry pull is needed at build time: the base image is
# referenced as a Bazel target, not pulled from registry.allegedly.works.

load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load", "oci_push")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

# ── kubectl layer ─────────────────────────────────────────────────────────────

pkg_tar(
    name = "kubectl_layer",
    srcs = ["@kubectl_linux_amd64//file"],
    mode = "0755",
    package_dir = "/usr/local/bin",
)

# ── Node.js binary layer ──────────────────────────────────────────────────────

pkg_tar(
    name = "node_bin_layer",
    srcs = ["@nodejs_linux_amd64//:bin/node"],
    mode = "0755",
    package_dir = "/usr/local/bin",
)

# ── OCI image ─────────────────────────────────────────────────────────────────

oci_image(
    name = "image",
    # debian-slim + Python + DirectExecServer, built hermetically by Bazel —
    # no private registry pull at build time.
    base = "//mcp_infra/exec:direct_image",
    # Layers are added in dependency order; each becomes a separate OCI layer.
    tars = [
        ":kubectl_layer",
        ":node_bin_layer",
        "//third_party/mcporter:mcporter_layer",
    ],
    # DirectExecServer runs as uid 1000; added tool layers are root-owned but
    # world-executable (mode 0755 above).
    user = "1000:1000",
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["openclaw-exec:latest"],
    visibility = ["//visibility:public"],
)

oci_push(
    name = "push",
    image = ":image",
    remote_tags = ["latest"],
    repository = "ghcr.io/agentydragon/openclaw-exec",
)
