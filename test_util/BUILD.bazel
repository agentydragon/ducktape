"""Shared utilities: runfiles (general) and test helpers (testonly)."""

load("@rules_python//python:defs.bzl", "py_library")

py_library(
    name = "runfiles",
    srcs = ["runfiles.py"],
    imports = [".."],
    visibility = ["//visibility:public"],
    deps = [
        "@rules_python//python/runfiles",
    ],
)

py_library(
    name = "test_util",
    testonly = True,
    srcs = ["docker.py"],
    imports = [".."],
    visibility = ["//visibility:public"],
    deps = [
        ":runfiles",
        "@pypi//docker",
        "@pypi//pytest",
    ],
)
