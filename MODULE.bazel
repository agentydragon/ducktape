# rules_distroless 0.9 moved source manifests and package lists into explicit
# extension tags. Keep all images in one extension so they share a coherent
# resolution graph. Bazel 8's facts API owns the repository-resolution cache;
# the former per-image v1 lockfiles were removed because v0.9 no longer reads
# that format.
apt.sources_list(
    architectures = ["amd64"],
    components = ["main"],
    suites = ["forky"],
    types = ["deb"],
    uris = ["https://snapshot.debian.org/archive/debian/20260905T000000Z"],
)
