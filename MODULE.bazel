# aspect_rules_lint's lint actions create empty output files with `touch`, but some
# actions run with a narrow PATH. Use POSIX shell redirection instead. No exact
# upstream issue was found; retire this patch after upstream removes the external
# `touch` dependency, or after a supported narrow-PATH test proves it unnecessary.
single_version_override(
    module_name = "aspect_rules_lint",
    patch_strip = 1,
    patches = ["//patches:aspect_rules_lint_no_external_touch.patch"],
)

# Conda epoch versions (e.g. "1!164.3095") contain '!' which is invalid in Bazel
# repo names. Patch _package_repo_name to sanitize. No exact upstream issue was
# found; retire after a released rules_conda version sanitizes repository names, or
# when Ducktape stops consuming epoch-version packages.
single_version_override(
    module_name = "rules_conda",
    patch_strip = 1,
    patches = [
        "//third_party/patches:rules_conda_sanitize_repo_name.patch",
        "//third_party/patches:rules_conda_rules_python_2_module.patch",
        "//third_party/patches:rules_conda_rules_python_2_extension.patch",
    ],
)

# or-tools@9.15 pulls pybind11_abseil for wrapper targets even when we only
# build the C++ CP-SAT backend. Its module creates a dev-only pip hub named
# "pypi", which collides with Ducktape's root pip hub during module extension
# resolution. Keep pybind11_abseil's apparent @pypi mapping inside that module,
# but give its generated hub a module-specific name. Upstream PR #73 is merged, but
# the fix is not in a released version yet; remove this override only after a
# release containing that PR and a successful OR-Tools consumer build.
single_version_override(
    module_name = "pybind11_abseil",
    patch_strip = 1,
    patches = ["//third_party/patches:pybind11_abseil_rename_pypi_hub.patch"],
)

# Terraform/OpenTofu validation (cluster/)
bazel_dep(name = "rules_tf", version = "0.0.10")

# Patch: check exit code of `tofu/terraform providers mirror` in the repo rule.
# Upstream silently ignores failures (stdout >/dev/null, return code unchecked),
# so a transient registry outage produces an incomplete mirror that Bazel caches,
# causing validate tests to fail with "provider not found in mirror". PR #28 is
# still open; remove the two mirror-check patches only after that fix is merged and
# released, then rerun the mirror validation. `exclude_dotterraform` is a separate
# source-packaging fix and has its own lifecycle.
single_version_override(
    module_name = "rules_tf",
    patch_strip = 1,
    patches = [
        "//patches:rules_tf_check_tofu_mirror.patch",
        "//patches:rules_tf_check_terraform_mirror.patch",
        "//patches:rules_tf_exclude_dotterraform.patch",
        "//patches:rules_tf_tflint064_config.patch",
    ],
)

