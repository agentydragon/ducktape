# The uv lock copier generated by rules_python reuses string variables for
# Path objects and an iterator for its rendered diff. Mypy checks this helper
# when a lock target is analyzed. Keep the small type-preserving rename until
# a released rules_python template is clean under the same check.
single_version_override(
    module_name = "rules_python",
    patch_strip = 1,
    patches = ["//patches:rules_python_lock_copier_mypy.patch"],
    version = "2.4.3",
)

# Gazelle python plugin fixes. In 2.4.3, per-file mode still splits files containing
# `if __name__ == "__main__"` into py_binary targets, stealing the module's library;
# the first hunk disables that split in per-file mode. The closest upstream tracker
# is rules_python issue #1815, but it is not the same proposed behavior. Retire that
# hunk only after a released plugin supplies the equivalent behavior and the Gazelle
# drift check passes. The second hunk redirects emitted loads to Ducktape's wrapper
# macros and is intentional repository integration, with no upstream retirement gate.
# 2.3.3 already fixed the third problem we hit on 1.9.2: deletion of every srcs-less
# main_module py_binary.
single_version_override(
    module_name = "rules_python_gazelle_plugin",
    patch_strip = 1,
    patches = ["//patches:rules_python_gazelle_ducktape.patch"],
)

