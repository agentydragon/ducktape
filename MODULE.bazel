# Wire the Bazel-built aw-webui dist into the build.rs environment.
# build.rs reads AW_WEBUI_DIR and emits cargo:rustc-env=AW_WEBUI_DIR=<path>
# so that rust-embed's interpolate-folder-path proc macro can embed all
# files from that directory into the binary at compile time.
crate.annotation(
    build_script_data = ["@aw_webui//:dist"],
    build_script_env = {
        "AW_WEBUI_DIR": "$(execpath @aw_webui//:dist)",
    },
    compile_data = ["@aw_webui//:dist"],
    crate = "aw-server",
    repositories = ["aw_server_crates"],
)
