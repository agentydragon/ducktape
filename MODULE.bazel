)

# or-tools@9.15 pulls pybind11_abseil for wrapper targets even when we only
# build the C++ CP-SAT backend. Its module creates a dev-only pip hub named
# "pypi", the name rules_python reserves for its generated unified hub. Keep
# pybind11_abseil's apparent @pypi mapping inside that module,
# but give its generated hub a module-specific name. Upstream PR #73 is merged, but
# the fix is not in a released version yet; remove this override only after a
# release containing that PR and a successful OR-Tools consumer build.
single_version_override(
    module_name = "pybind11_abseil",
    patch_strip = 1,
    patches = ["//third_party/patches:pybind11_abseil_rename_pypi_hub.patch"],
)

