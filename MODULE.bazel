tf = use_extension("@rules_tf//tf:extensions.bzl", "tf_repositories")
tf.download(
    # Pre-fetch provider plugins at Bazel fetch time so that tf_module validate
    # and lint targets work hermetically (no network needed at test time).
    # Each version must satisfy the constraints of ALL modules that use it.
    # When modules disagree (e.g., ~>3.0 vs ~>3.7.0), use the tighter range.
    mirror = {
        "authentik": "goauthentik/authentik:2026.8.0",
        "aws": "hashicorp/aws:6.64.0",
        # Intentionally omitted from the global provider mirror while
        # haku/runtime/x/managed_agent/anthropic_hosted/terraform is parked.
        # The community provider is
        # published, but mirroring it here would make unrelated Terraform and
        # image jobs depend on a parked module's provider.
        "external": "hashicorp/external:2.4.2",
        "forgejo": "svalabs/forgejo:1.6.0",
        "github": "integrations/github:6.13.0",
        "gitlab": "gitlabhq/gitlab:19.4.0",
        "helm": "hashicorp/helm:3.3.0",
        "http": "hashicorp/http:3.6.2",
        "kubernetes": "hashicorp/kubernetes:3.2.1",
        # CAUTION: low-user-count community provider; the Upjet Crossplane
        # provider is generated from it, and the one-shot Terraform handoff still
        # uses it to delete the previous key resources. On every version bump,
        # manually review the source diff since the last pinned tag (focus:
        # request construction/egress and release workflow) BEFORE updating.
        # Do not auto-merge Renovate/update_deps bumps.
        "litellm": "ncecere/litellm:2.1.0",
        "local": "hashicorp/local:2.9.1",
        "null": "hashicorp/null:3.3.2",
        "ovh": "ovh/ovh:2.19.0",
        "proxmox": "bpg/proxmox:0.113.1",
        "random": "hashicorp/random:3.9.1",
        # Receives the ducktape-ci password (tf/gitops/forgejo-images), which Forgejo's own
        # provider has no resource to use for a user-level webhook.
        "restapi": "mastercard/restapi:2.0.1",
        "routeros": "terraform-routeros/routeros:1.99.1",
        "sops": "carlpett/sops:1.4.1",
        "talos": "siderolabs/talos:0.11.0",
    },
    tfdoc_version = "0.19.0",
    tflint_version = "0.53.0",
    use_tofu = True,
    version = "1.12.6",  # OpenTofu version (latest checked 2026-09)
)
