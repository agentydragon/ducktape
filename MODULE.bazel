# aw-webui standalone npm universe — separate extension instance because its
# lock file lives in third_party/activitywatch/, a different workspace root
# from the main pnpm-lock.yaml.  rules_js forbids mixing workspace roots within
# a single extension instance ("cannot seed_root twice with different workspaces").
#
# update_pnpm_lock is disabled because pnpm_lock and npm_package_lock are in
# different Bazel workspaces (// vs @aw_webui), and rules_js's seed_root check
# rejects that combination.  To regenerate the pnpm lockfile after bumping the
# aw_webui http_archive:
#   1. bazel run @pnpm//:package/bin/pnpm.cjs -- import \
#        --lockfile-dir third_party/activitywatch \
#        $(bazel info output_base)/external/aw_webui+/package-lock.json
#   2. Or: cp upstream package-lock.json to a temp dir, run `pnpm import`, copy back.
npm_activitywatch = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm", dev_dependency = True, isolate = True)
npm_activitywatch.npm_translate_lock(
    name = "npm_aw_webui",
    bins = {
        "vite": ["vite=./bin/vite.js"],
    },
    # link_workspace must point to @aw_webui so generated store-target labels
    # resolve in the http_archive where npm_link_all_packages() creates them,
    # not in the main workspace where the lockfile lives.
    link_workspace = "aw_webui",
    npmrc = "@@//:.npmrc",
    # vue-demi's postinstall switches lib/index.mjs to the correct Vue version
    # variant, but lifecycle hooks are disabled in sandboxed builds.  Patch the
    # default (Vue 3) stub to add the missing hasInjectionContext export that
    # pinia@2.1.7 imports.
    patches = {
        "vue-demi@0.14.6": ["//third_party/activitywatch/patches:vue-demi-has-injection-context.patch"],
    },
    pnpm_lock = "//:aw-webui-pnpm-lock.yaml",
    # aw-webui imports axios directly (via NewReleaseNotification.vue) but
    # axios is only a dependency of aw-client, not of aw-webui itself.
    # pnpm strict mode hides phantom deps; hoist axios so vite/rollup can resolve it.
    public_hoist_packages = {
        "axios": [""],
    },
    run_lifecycle_hooks = False,
    update_pnpm_lock = False,
    use_pnpm = "@pnpm//:package/bin/pnpm.cjs",
)
use_repo(npm_activitywatch, "npm_aw_webui")

