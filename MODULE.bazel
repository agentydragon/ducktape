    ],
    npmrc = "@@//:.npmrc",
    # Root pnpm-lock.yaml with workspace packages
    pnpm_lock = "//:pnpm-lock.yaml",
    # Hoist ESLint plugins for runtime discovery
    public_hoist_packages = {
