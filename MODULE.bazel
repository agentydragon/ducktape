# ─ Rust crates (crate_universe) ─────────────────────────────────────────────
# Keep this extension visible to downstream modules. Ducktape BUILD files use
# apparent labels such as `@crates//:anyhow`, and those labels are resolved in
# Ducktape's own repository mapping when another workspace consumes Ducktape via
# `bazel_dep` + `git_override`. A downstream workspace's root `@crates`
# repository cannot satisfy those labels. crate_universe refuses a non-root
# `from_cargo` without a `lockfile` (it never repins across module boundaries
# and skips the digest check there), so the lockfile is what dependents render.
crate = use_extension(
    "@rules_rust//crate_universe:extensions.bzl",
    "crate",
)

# If your workspace has Cargo.toml at the root:
crate.from_cargo(
    name = "crates",  # this becomes the repo name
    cargo_lockfile = "//:Cargo.lock",
    lockfile = "//:Cargo.Bazel.lock",
    manifests = ["//:Cargo.toml"],
)

# sqlx-core 0.9.0's `offline` feature changes the Executor trait. crate-universe
# currently propagates that feature to the shared core crate without propagating
# sqlx's corresponding `sqlx-postgres/offline` feature, leaving the generated
# PostgreSQL implementation incompatible with the generated core trait.
crate.annotation(
    crate = "sqlx-postgres",
    crate_features = ["offline"],
)

# sqlx-postgres's offline feature enables serde support on smallvec. Keep the
# shared dependency feature explicit because crate-universe does not currently
# render that feature edge from the annotation above.
crate.annotation(
    crate = "smallvec",
    crate_features = ["serde"],
    deps = ["@crates//:serde"],
)
crate.annotation(
    crate = "swc_ecma_transforms_base",
    patch_args = ["-p1"],
    patches = ["//patches:swc_ecma_transforms_base_49_0_1.patch"],
    version = "49.0.1",
)

# expose the generated repo (↑ name="crates")
use_repo(crate, "crates")

