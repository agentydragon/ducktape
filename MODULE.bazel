# devinfra/buildbuddy_cli respectively). Keep them here; do not re-run
# `bazel mod tidy` without restoring them.
use_repo(
    go_deps,
    "cc_mvdan_garble",
    "com_github_blacktop_go_dwarf",
    "com_github_blacktop_go_macho",
    "com_github_cheynewallace_tabby",
    "com_github_docker_docker",
    "com_github_dustin_go_humanize",
    "com_github_elliotchance_orderedmap",
    "com_github_firebase_genkit_go",
    "com_github_fsouza_go_dockerclient",
    "com_github_go_git_go_git_v5",
    "com_github_google_uuid",
    "com_github_goretk_gore",
    "com_github_goretk_redress",
    "com_github_inconshreveable_mousetrap",
    "com_github_mandiant_goresym",
    "com_github_spf13_cobra",
    "com_github_spf13_pflag",
    "com_github_tcm1911_r2g2",
    "io_opentelemetry_go_otel",
    "io_opentelemetry_go_otel_metric",
    "io_opentelemetry_go_otel_sdk",
    "io_opentelemetry_go_otel_trace",
    "org_golang_google_genproto_googleapis_api",
    "org_golang_google_genproto_googleapis_rpc",
    "org_golang_google_grpc",
    "org_golang_google_protobuf",
    "org_golang_x_arch",
    "org_golang_x_net",
    "org_golang_x_text",
)

# ─ BuildBuddy proto definitions (for bbapi CLI) ──────────────────────────────
buildbuddy_protos = use_extension("//third_party/buildbuddy:buildbuddy_protos.bzl", "buildbuddy_protos")
use_repo(buildbuddy_protos, "buildbuddy_protos")
