# Lint/Format Exclusions
# This file is the source of truth for files excluded from linting and formatting.
# devinfra/format/format.py reads these via `git check-attr`.
# For Python files, patterns must also be mirrored in ruff.toml exclude.
# See README.md "Lint/Format Exclusions" section for details.

# Zsh files - shfmt doesn't support zsh syntax
# TODO: Install a zsh-specific formatter to handle .zsh files properly
*.zsh rules-lint-ignored=true

# Test data files - inputs to tests, not source code
py_detectors/rules/**/bad/** rules-lint-ignored=true
py_detectors/rules/**/ok/** rules-lint-ignored=true
props/testing/fixtures/testdata/** rules-lint-ignored=true
x/sysrw/testdata/** rules-lint-ignored=true
tana/testdata/** rules-lint-ignored=true

# Generated lockfiles - large, not useful to diff
Cargo.Bazel.lock linguist-generated=true
Cargo.lock linguist-generated=true
flake.lock linguist-generated=true
pnpm-lock.yaml linguist-generated=true
package-lock.json linguist-generated=true
requirements_bazel.txt linguist-generated=true
go.sum linguist-generated=true
# rules_distroless apt manifest lockfiles — generated by `bazel run @<name>//:lock`.
**/*.lock.json linguist-generated=true
# `tofu init` provider lockfile.
.terraform.lock.hcl linguist-generated=true
# Pixi (conda) lockfile — skills/freecad/conda/pixi.lock.
pixi.lock linguist-generated=true
# `bb run //devinfra:gazelle_python_manifest.update` output.
gazelle_python.yaml linguist-generated=true
# Flux bootstrap manifests — `flux bootstrap`/`flux install` output.
gotk-components.yaml linguist-generated=true
gotk-sync.yaml linguist-generated=true

