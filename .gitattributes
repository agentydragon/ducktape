# Lint/Format Exclusions
# This file is the source of truth for files excluded from linting and formatting.
# devinfra/format/format.py reads these via `git check-attr`.
# For Python files, patterns must also be mirrored in ruff.toml exclude.
# See README.md "Lint/Format Exclusions" section for details.

# Zsh files - shfmt doesn't support zsh syntax
# TODO: Install a zsh-specific formatter to handle .zsh files properly
*.zsh rules-lint-ignored=true

# Test data files - inputs to tests, not source code
py_detectors/rules/**/bad/** rules-lint-ignored=true
py_detectors/rules/**/ok/** rules-lint-ignored=true
props/testing/fixtures/testdata/** rules-lint-ignored=true
x/sysrw/testdata/** rules-lint-ignored=true
tana/testdata/** rules-lint-ignored=true

# Generated lockfiles - large, not useful to diff
Cargo.Bazel.lock linguist-generated=true
Cargo.lock linguist-generated=true
flake.lock linguist-generated=true
pnpm-lock.yaml linguist-generated=true
package-lock.json linguist-generated=true
requirements_bazel.txt linguist-generated=true
go.sum linguist-generated=true
# rules_distroless apt manifest lockfiles — generated by `bazel run @<name>//:lock`.
**/*.lock.json linguist-generated=true
# `tofu init` provider lockfile.
.terraform.lock.hcl linguist-generated=true
# Pixi (conda) lockfile — skills/freecad/conda/pixi.lock.
pixi.lock linguist-generated=true
# `bb run //devinfra:gazelle_python_manifest.update` output.
gazelle_python.yaml linguist-generated=true
# Flux bootstrap manifests — `flux bootstrap`/`flux install` output.
gotk-components.yaml linguist-generated=true
gotk-sync.yaml linguist-generated=true

# Artifacts captured from live Claude Code containers — not our source code
devinfra/claude/web_env/rootfs/** rules-lint-ignored=true
devinfra/claude/web_env/reference/** rules-lint-ignored=true
devinfra/claude/web_env/live-dpkg-versions.txt rules-lint-ignored=true

# Terraform/k8s - kebab-case is conventional in HCL and k8s manifests
# kebab-case filenames are conventional in HCL and k8s manifests
cluster/** filename-conventions-ignored=true
terraform/** filename-conventions-ignored=true
tf/** filename-conventions-ignored=true

# Archived cluster + tf manifests parked under x/ keep their original
# kebab-case directory names.
x/*/cluster/** filename-conventions-ignored=true
x/*/tf/** filename-conventions-ignored=true

# Logseq page names - dashes are part of the page title
llm/instruct_logseq/pages/** filename-conventions-ignored=true

# Blog posts - filenames are published URLs (date-prefixed kebab-case)
website/posts/** filename-conventions-ignored=true

# Starter k8s manifests Haku copies into haku-state - kebab-case is
# conventional for k8s manifests (and matches the resource/host names).

# agent-box NixOS host: the host dir name must match the hostname (mkNixos reads
# ./nix/nixos/hosts/${hostname}), and the host/DNS name agent-box is kebab by
# k8s/DNS convention. Keep the related Nix host filenames consistent.
nix/nixos/hosts/agent-box/** filename-conventions-ignored=true
nix/home/hosts/agent-box/** filename-conventions-ignored=true

# CPAP gateway NixOS host: the directory name intentionally matches the
# kebab-case Kubernetes/DNS host name used by the VM.
nix/nixos/hosts/cpap-gateway/** filename-conventions-ignored=true

# Non-K8s YAML under cluster/k8s/ - rules_distroless apt manifests for CronJob
# images. cluster/validation/cluster.py reads this attribute via `git check-attr`
# (pygit2) and skips the file from orphan detection + resource parsing.
cluster/k8s/**/trixie_*.yaml cluster-manifest-ignored=true
cluster/k8s/evidence/market-roster/market-roster.yaml cluster-manifest-ignored=true
# rotate.py's rotation list, mounted via configMapGenerator — not a K8s manifest.
cluster/k8s/agents/authentik-jwt-rotation/rotations.yaml cluster-manifest-ignored=true
# rotate.py's token list, mounted via configMapGenerator — not a K8s manifest.
cluster/k8s/agents/attic-jwt-rotation/rotators.yaml cluster-manifest-ignored=true
# provision.py's user→permission policy, mounted via configMapGenerator — not a K8s manifest.
cluster/k8s/grocy/user-perms-base/policy.yaml cluster-manifest-ignored=true
# The Agentplane app's settings file, mounted via configMapGenerator — not a K8s manifest.
cluster/k8s/agentplane-staging/app/config.yaml cluster-manifest-ignored=true
# dispatcher Job template (${...} placeholders), mounted via configMapGenerator — not a live manifest.
cluster/k8s/x/haku/dispatch/dispatcher/job-template.yaml cluster-manifest-ignored=true
# dispatcher zone wiring, mounted via configMapGenerator — not a K8s manifest.
cluster/k8s/x/haku/dispatch/dispatcher/zones.yaml cluster-manifest-ignored=true
# haku-console config, mounted via configMapGenerator — not a K8s manifest.
cluster/k8s/haku/console/config.yaml cluster-manifest-ignored=true
# per-index haku-indexer chunk config slices, mounted via configMapGenerator — not K8s manifests.
cluster/k8s/haku/console/indexer-chunk-*-config.yaml cluster-manifest-ignored=true
# iron-proxy config for the coder agent's egress proxy, mounted via
# configMapGenerator — not a K8s manifest.
cluster/k8s/agents/public-coder-agent/proxy/iron.yaml cluster-manifest-ignored=true
cluster/k8s/agents/haku-egress-proxy/claude-iron.yaml cluster-manifest-ignored=true

# Dotfiles/dotdirs follow their own naming conventions
.* filename-conventions-ignored=true
.*/** filename-conventions-ignored=true

# Specimens — dashes in slugs/filenames are by convention (YYYY-MM-DD-NN, kebab-case issue names)
props/specimens/** filename-conventions-ignored=true
# Specimens committed snapshot code — frozen third-party code, not ours to lint
props/specimens/*/*/code/** rules-lint-ignored=true

# nix/artifact-pins.json - machine-edited by sync-pins workflow, not worth formatting
nix/artifact-pins.json rules-lint-ignored=true

# Golden test files - generated artifacts, not source code
**/golden/*.dxf rules-lint-ignored=true

# TODO: Delete legacy_* roles once all machines switch to Nix home-manager
ansible/roles/legacy_*/** rules-lint-ignored=true
tana/export/references/** rules-lint-ignored=true
cluster/docs/inference/model_comparison/** rules-lint-ignored=true
# Retired Haku dispatch-lane manifests; preserved as non-runnable reference material.
cluster/k8s/x/haku/** cluster-manifest-ignored=true
cluster/k8s/x/agents/haku-zones-mitmproxy/** cluster-manifest-ignored=true
cluster/k8s/x/agents/haku-zones-mitmproxy-namespace/** cluster-manifest-ignored=true
