load("@aspect_rules_py//py:defs.bzl", "py_image_layer", aspect_py_binary = "py_binary")
load("@rules_oci//oci:defs.bzl", "oci_image")
load("//devinfra/python:defs.bzl", "py_library", "py_test")
load("//props:oci.bzl", "py_image_entrypoint", "py_image_env")

# Archive storage and runner ingestion are service internals. App tests must use
# the Sandbox Service client/protobuf boundary, not widen this visibility. The
# History Service reads through the store until the package moves to it.
package(default_visibility = [
    "//agentplane/history_service:__subpackages__",
    "//agentplane/sandbox_service:__subpackages__",
])

py_library(
    name = "db",
    srcs = ["db.py"],
    deps = ["@pypi//sqlalchemy"],
)

py_library(
    name = "store",
    srcs = ["store.py"],
    deps = [
        ":db",
        "//agentplane/protocol:event_log_pb2",
        "//agentplane/sandbox_service:protocol_pb2",
        "@pypi//protobuf",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "ingestion",
    srcs = ["ingestion.py"],
    deps = [
        ":store",
        "//agentplane:grpc_options",
        "//agentplane/protocol:event_log_pb2",
        "//agentplane/runner:client",
        "//agentplane/runner:errors",
        "//agentplane/runner:protocol_pb2",
        "//agentplane/sandbox_service:destinations",
        "//agentplane/sandbox_service:models",
        "//agentplane/sandbox_service:protocol_pb2",
        "//util:agent_sandbox",
        "@pypi//grpcio",
        "@pypi//kubernetes_asyncio",
        "@pypi//protobuf",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "database_migrate",
    srcs = ["database_migrate.py"],
    data = ["//agentplane/sandbox_service/session_history/migrations:files"],
    deps = [
        ":db",
        "//util:db_migrations",
    ],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    deps = [
        ":database_migrate",
        "//util/testing:postgres",
        "//util/testing:postgres_fixtures",
        "@pypi//asyncpg",
        "@pypi//psycopg",
        "@pypi//pytest",
        "@pypi//sqlalchemy",
        "@pypi//testcontainers",
    ],
)

py_test(
    name = "test_store",
    srcs = ["test_store.py"],
    deps = [
        ":conftest",
        ":store",
        "//:conftest",
        "//agentplane/protocol:event_log_pb2",
        "//agentplane/runner:protocol_pb2",
        "//agentplane/sandbox_service:conftest",
        "//agentplane/sandbox_service:protocol_pb2",
        "@pypi//protobuf",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)

# This image runs as a Sandbox Service migration init container.
py_library(
    name = "migrate",
    srcs = ["migrate.py"],
    deps = [
        ":database_migrate",
        "@pypi//pydantic_settings",
    ],
)

aspect_py_binary(
    name = "migration_image_bin",
    main = "migrate.py",
    deps = [":migrate"],
)

py_image_layer(
    name = "migration_layers",
    binary = ":migration_image_bin",
    group = "1000",
    owner = "1000",
)

oci_image(
    name = "migration_image",
    base = "@debian_trixie_slim_linux_amd64",
    entrypoint = py_image_entrypoint("migration_image_bin"),
    env = py_image_env(binary_name = "migration_image_bin"),
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [":migration_layers"],
    user = "1000:1000",
    visibility = ["//visibility:public"],
)

# Operator-run preflight only: not a server startup task or a deployed Job.
aspect_py_binary(
    name = "verify_bin",
    main = "verify.py",
    visibility = ["//visibility:public"],
    deps = [":verify"],
)

py_library(
    name = "verify",
    srcs = ["verify.py"],
    deps = [
        "//agentplane/protocol:event_log_pb2",
        "//agentplane/runner:client",
        "@pypi//asyncpg",
        "@pypi//grpcio",
        "@pypi//protobuf",
        "@pypi//pydantic",
        "@pypi//pydantic_settings",
        "@pypi//sqlalchemy",
    ],
)

py_test(
    name = "test_verify",
    size = "medium",
    srcs = ["test_verify.py"],
    requires_docker = True,
    deps = [
        ":conftest",
        ":store",
        ":verify",
        "//:conftest",
        "//agentplane/protocol:event_log_pb2",
        "//agentplane/protocol:event_pb2",
        "//agentplane/runner:protocol_pb2",
        "//agentplane/sandbox_service:conftest",
        "@pypi//protobuf",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)
