load("//devinfra/python:defs.bzl", "py_library")

package(
    default_testonly = True,
    default_visibility = ["//agentplane:__subpackages__"],
)

py_library(
    name = "kubernetes",
    testonly = True,
    srcs = ["kubernetes.py"],
    deps = [
        "//agentplane:sandbox_resource",
        "//agentplane:subjects",
        "//agentplane/proto:sandboxes_pb2",
        "//agentplane/sandbox_service:egress",
        "//agentplane/sandbox_service:provisioning",
        "//agentplane/sandboxes:inventory",
        "//agentplane/testing:fake_apiserver",
        "//agentplane/workload_auth:principal",
        "//util:kubernetes",
        "@pypi//kubernetes_asyncio",
        "@pypi//protobuf",
    ],
)

py_library(
    name = "grpc_service",
    testonly = True,
    srcs = ["grpc_service.py"],
    deps = [
        "//agentplane:grpc_calls",
        "//agentplane:grpc_serving",
        "//agentplane/sandbox_service:client",
        "//agentplane/sandbox_service:grpc_api",
        "@pypi//grpcio",
    ],
)

py_library(
    name = "backend",
    srcs = ["backend.py"],
    deps = [
        ":fake_inventory",
        ":grpc_service",
        "//agentplane:sandbox_resource",
        "//agentplane:subjects",
        "//agentplane/runner_gateway:client",
        "//agentplane/runner_gateway:destinations",
        "//agentplane/runner_gateway/testing:control_listener",
        "//agentplane/runner_gateway/testing:grpc_service",
        "//agentplane/runner_gateway/testing:resources",
        "//agentplane/sandbox_service:client",
        "//agentplane/sandbox_service:egress",
        "//agentplane/sandbox_service:provisioning",
        "//agentplane/sandboxes:inventory",
        "//agentplane/testing:fake_apiserver",
        "//agentplane/workload_auth:principal",
        "//util:kubernetes",
        "//util/testing:sqlalchemy_engines",
        "@pypi//anyio",
        "@pypi//grpcio",
        "@pypi//kubernetes_asyncio",
    ],
)

py_library(
    name = "connected_runner",
    srcs = ["connected_runner.py"],
    deps = [
        ":grpc_service",
        ":kubernetes",
        "//agentplane:grpc_calls",
        "//agentplane:subjects",
        "//agentplane/runner",
        "//agentplane/runner_gateway:client",
        "//agentplane/runner_gateway:destinations",
        "//agentplane/runner_gateway:grpc_api",
        "//agentplane/runner_gateway/testing:control_listener",
        "//agentplane/runner_gateway/testing:grpc_service",
        "//agentplane/runner_gateway/testing:resources",
        "//agentplane/sandbox_service:client",
        "//agentplane/testing:fake_apiserver",
        "//util/testing:sqlalchemy_engines",
        "@pypi//kubernetes_asyncio",
    ],
)
