load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//agentplane:__subpackages__"])

py_library(
    name = "audience",
    srcs = ["audience.py"],
    visibility = [
        "//agentplane:__subpackages__",
        "//cluster/cdk8s/agentplane:__pkg__",
        "//cluster/cdk8s/public_coder:__pkg__",
    ],
)

py_library(
    name = "listener",
    srcs = ["listener.py"],
    visibility = [
        "//agentplane:__subpackages__",
        "//cluster/cdk8s/agentplane:__pkg__",
    ],
    deps = ["@pypi//pydantic"],
)

py_test(
    name = "test_listener",
    srcs = ["test_listener.py"],
    deps = [
        ":listener",
        "//:conftest",
        "@pypi//pydantic",
        "@pypi//pytest_bazel",
    ],
)
