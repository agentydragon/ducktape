load("@io_bazel_rules_go//go:def.bzl", "go_test")
load("//devinfra/python:defs.bzl", "py_library", "py_test")

py_library(
    name = "process",
    testonly = True,
    srcs = ["process.py"],
    visibility = [
        "//agentplane/notification_service:__subpackages__",
        "//agentplane/x/direct_vm_boot:__pkg__",
    ],
    deps = [
