load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//agentplane/notification_service:__subpackages__"])

go_library(
    name = "state",
    srcs = [
        "commit.go",
        "completion.go",
        "ingest.go",
        "mergeability.go",
        "pr.go",
        "reconcile.go",
        "state.go",
        "status.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/notification_service/internal/sources/github/state",
    deps = [
        "//agentplane/notification_service/internal/storagecodec",
        "//agentplane/notification_service/model",
        "//agentplane/postgres",
        "//agentplane/postgres/lease",
        "@com_github_google_uuid//:uuid",
    ],
)

go_test(
    name = "state_integration_test",
    size = "medium",
    srcs = [
        "fixture_integration_test.go",
        "integration_testmain_test.go",
        "reconcile_integration_test.go",
        "state_integration_test.go",
    ],
    embed = [":state"],
    tags = ["requires_docker"],
    deps = [
        "//agentplane/notification_service/migrations",
        "//agentplane/notification_service/model",
        "//agentplane/postgres",
        "//agentplane/testing/postgres",
        "@com_github_google_uuid//:uuid",
        "@com_github_lib_pq//:pq",
    ],
)
