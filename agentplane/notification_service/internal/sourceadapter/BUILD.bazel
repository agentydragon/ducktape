load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//agentplane/notification_service:__subpackages__"])

go_library(
    name = "sourceadapter",
    srcs = [
        "append.go",
        "authorization.go",
        "due.go",
        "entry_content.go",
        "event_identity.go",
        "event_identity_storage.go",
        "status.go",
        "storage.go",
        "subscription.go",
        "summary.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/notification_service/internal/sourceadapter",
    deps = [
        "//agentplane/notification_service:storage_go_proto",
        "//agentplane/notification_service/internal/sources/github/model",
        "//agentplane/notification_service/internal/sources/github/publication",
        "//agentplane/notification_service/internal/sources/github/state",
        "//agentplane/notification_service/internal/sources/github/storagecodec",
        "//agentplane/notification_service/internal/storagecodec",
        "//agentplane/notification_service/internal/transaction",
        "//agentplane/notification_service/model",
        "@com_github_google_uuid//:uuid",
        "@org_golang_google_protobuf//proto",
    ],
)

go_test(
    name = "sourceadapter_test",
    srcs = [
        "event_identity_storage_test.go",
        "summary_test.go",
    ],
    embed = [":sourceadapter"],
    deps = [
        "//agentplane/notification_service/internal/sources/github/model",
        "//agentplane/notification_service/internal/storagecodec",
        "//agentplane/notification_service/model",
        "@com_github_google_uuid//:uuid",
    ],
)
