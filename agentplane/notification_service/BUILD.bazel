load("@io_bazel_rules_go//proto:def.bzl", "go_proto_library")
load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_oci//oci:defs.bzl", "oci_image")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//agentplane/notification_service:__subpackages__"])

py_library(
    name = "settings",
    srcs = ["settings.py"],
    visibility = [
        "//agentplane/notification_service:__subpackages__",
        "//agentplane/system_tests/deployment:__pkg__",
        "//cluster/cdk8s/agentplane:__pkg__",
    ],
    deps = [
        "//agentplane/identity/auth:listener",
        "//agentplane/net/peertls:config",
        "//util:urls",
        "@pypi//pydantic",
    ],
)

py_test(
    name = "test_settings",
    srcs = ["test_settings.py"],
    deps = [
        ":settings",
        "//:conftest",
        "//agentplane/net/peertls:config",
        "@pypi//pydantic",
        "@pypi//pytest",
    ],
)

proto_library(
    name = "storage_proto",
    srcs = ["storage.proto"],
)

go_proto_library(
    name = "storage_go_proto",
    importpath = "github.com/agentydragon/ducktape/agentplane/notification_service/storagepb",
    proto = ":storage_proto",
)

pkg_tar(
    name = "service_binary_layer",
    srcs = ["//agentplane/notification_service/cmd:notification-service"],
    package_dir = "/usr/local/bin",
)

oci_image(
    name = "service_image",
    base = "@distroless_static_debian13_linux_amd64",
    entrypoint = ["/usr/local/bin/notification-service"],
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [
        ":service_binary_layer",
        "//agentplane/grpc/healthprobe:binary_layer",
    ],
    user = "1000:1000",
    visibility = ["//visibility:public"],
    workdir = "/",
)
