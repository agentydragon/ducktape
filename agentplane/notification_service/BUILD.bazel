load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("@io_bazel_rules_go//proto:def.bzl", "go_proto_library")
load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_oci//oci:defs.bzl", "oci_image")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//devinfra/go:proto_openapi.bzl", "proto_openapi")
load("//devinfra/python:defs.bzl", "py_library", "py_test")
load("//devinfra/python:grpc.bzl", "py_grpc_service_library")
load("//devinfra/python:proto.bzl", "py_proto_library_with_mypy_stubs")

package(default_visibility = ["//agentplane/notification_service:__subpackages__"])

py_library(
    name = "settings",
    srcs = ["settings.py"],
    visibility = [
        "//agentplane/notification_service:__subpackages__",
        "//cluster/cdk8s/agentplane:__pkg__",
    ],
    deps = [
        "//agentplane:log_levels",
        "//util:urls",
        "//util:yaml_file_settings",
        "@pypi//pydantic",
        "@pypi//pydantic_settings",
    ],
)

py_test(
    name = "test_settings",
    srcs = ["test_settings.py"],
    deps = [
        ":settings",
        "//:conftest",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

proto_library(
    name = "notifications_proto",
    srcs = ["notifications.proto"],
    visibility = ["//agentplane:__subpackages__"],
    deps = [
        "@googleapis//google/api:annotations_proto",
        "@protobuf//:struct_proto",
        "@protobuf//:timestamp_proto",
    ],
)

proto_library(
    name = "notifications_operator_proto",
    srcs = ["notifications_operator.proto"],
    visibility = ["//agentplane:__subpackages__"],
    deps = [
        ":notifications_proto",
        "@googleapis//google/api:annotations_proto",
        "@protobuf//:empty_proto",
        "@protobuf//:timestamp_proto",
    ],
)

py_proto_library_with_mypy_stubs(
    name = "notifications_pb2",
    visibility = ["//agentplane:__subpackages__"],
    deps = [":notifications_proto"],
)

py_proto_library_with_mypy_stubs(
    name = "notifications_operator_pb2",
    visibility = ["//agentplane:__subpackages__"],
    deps = [":notifications_operator_proto"],
)

py_grpc_service_library(
    name = "notifications_operator_pb2_grpc",
    proto = ":notifications_operator_proto",
    py_proto = ":notifications_operator_pb2",
    visibility = ["//agentplane:__subpackages__"],
)

go_proto_library(
    name = "notifications_go_proto",
    compilers = [
        "@io_bazel_rules_go//proto:go_proto",
        "@io_bazel_rules_go//proto:go_grpc_v2",
        "//devinfra/go:grpc_gateway",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/notification_service/notificationspb",
    proto = ":notifications_proto",
    visibility = ["//agentplane:__subpackages__"],
    deps = ["@org_golang_google_genproto_googleapis_api//annotations"],
)

go_proto_library(
    name = "notifications_operator_go_proto",
    compilers = [
        "@io_bazel_rules_go//proto:go_proto",
        "@io_bazel_rules_go//proto:go_grpc_v2",
        "//devinfra/go:grpc_gateway",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/notification_service/notifications_operatorpb",
    proto = ":notifications_operator_proto",
    visibility = ["//agentplane:__subpackages__"],
    deps = [
        ":notifications_go_proto",
        "@org_golang_google_genproto_googleapis_api//annotations",
    ],
)

# The agent-facing reference, which the service serves at `/openapi.json`.
proto_openapi(
    name = "notifications_openapi",
    proto = ":notifications_proto",
)

go_library(
    name = "main_lib",
    srcs = [
        "config.go",
        "main.go",
        "workers.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/notification_service",
    deps = [
        ":notifications_go_proto",
        ":notifications_operator_go_proto",
        "//agentplane/action_service:action_service_go_proto",
        "//agentplane/grpc/bearer",
        "//agentplane/grpc/facade",
        "//agentplane/history_service:history_service_go_proto",
        "//agentplane/notification_service/actions",
        "//agentplane/notification_service/api",
        "//agentplane/notification_service/docs",
        "//agentplane/notification_service/github",
        "//agentplane/notification_service/github/client",
        "//agentplane/notification_service/github/settings",
        "//agentplane/notification_service/inboxaccess",
        "//agentplane/notification_service/store",
        "//agentplane/notification_service/webhook",
        "//agentplane/notification_service/worker",
        "//agentplane/observability",
        "//agentplane/policy/reader",
        "//agentplane/postgres/go:postgres",
        "//agentplane/postgres/go/probes",
        "//agentplane/postgres/go/wakeups",
        "//agentplane/runner_gateway/dispatcher:session_dispatcher_go_proto",
        "//agentplane/sandboxes/api",
        "//agentplane/sandboxes/sandboxreader",
        "//agentplane/workload_auth/go/auth",
        "@com_github_lib_pq//:pq",
        "@com_github_spf13_viper//:viper",
        "@io_k8s_apimachinery//pkg/runtime",
        "@io_k8s_client_go//kubernetes",
        "@io_k8s_client_go//rest",
        "@io_k8s_sigs_controller_runtime//pkg/client",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//credentials",
        "@org_golang_google_grpc//health/grpc_health_v1",
    ],
)

go_binary(
    name = "notification-service",
    embed = [":main_lib"],
    pure = "on",
)

pkg_tar(
    name = "service_binary_layer",
    srcs = [
        ":notification-service",
        "//agentplane/notification_service/migrations/cmd:notifications-migrate",
    ],
    package_dir = "/usr/local/bin",
)

oci_image(
    name = "service_image",
    base = "@distroless_static_debian13_linux_amd64",
    entrypoint = ["/usr/local/bin/notification-service"],
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [":service_binary_layer"],
    user = "1000:1000",
    visibility = ["//visibility:public"],
    workdir = "/",
)

go_test(
    name = "unit_test",
    srcs = [
        "config_test.go",
        "docs_test.go",
        "workers_test.go",
    ],
    embed = [":main_lib"],
    deps = [
        "//agentplane/testing/agentdocs",
    ],
)

go_test(
    name = "integration_test",
    size = "medium",
    srcs = [
        "acceptance_github_test.go",
        "acceptance_test.go",
        "integration_testmain_test.go",
        "main_test.go",
    ],
    embed = [":main_lib"],
    tags = ["requires_docker"],
    deps = [
        ":notifications_go_proto",
        "//agentplane/action_service:action_service_go_proto",
        "//agentplane/history_service:history_service_go_proto",
        "//agentplane/notification_service/actions",
        "//agentplane/notification_service/github/testing",
        "//agentplane/notification_service/migrations",
        "//agentplane/policy/api/v1alpha1",
        "//agentplane/postgres/go/probes",
        "//agentplane/proto:command_go_proto",
        "//agentplane/proto:event_go_proto",
        "//agentplane/proto:event_log_go_proto",
        "//agentplane/proto:runner_go_proto",
        "//agentplane/proto:sandboxes_go_proto",
        "//agentplane/runner:runner_service_go_proto",
        "//agentplane/runner_gateway/dispatcher:session_dispatcher_go_proto",
        "//agentplane/sandboxes/api",
        "//agentplane/testing/kubeapiserver",
        "//agentplane/testing/postgres",
        "//agentplane/workload_auth/go/auth",
        "@com_github_google_uuid//:uuid",
        "@com_github_lib_pq//:pq",
        "@io_k8s_api//core/v1:core",
        "@io_k8s_apimachinery//pkg/api/meta",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_apimachinery//pkg/runtime",
        "@io_k8s_client_go//kubernetes/scheme",
        "@io_k8s_client_go//rest",
        "@io_k8s_sigs_controller_runtime//pkg/client",
        "@io_k8s_sigs_controller_runtime//pkg/client/fake",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//credentials/insecure",
        "@org_golang_google_grpc//health/grpc_health_v1",
        "@org_golang_google_grpc//metadata",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)
