load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "github",
    srcs = [
        "client.go",
        "errors.go",
        "ratelimit.go",
        "settings.go",
        "webhook.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/notification_service/github",
    visibility = ["//agentplane/notification_service:__subpackages__"],
    deps = [
        "//agentplane/notification_service/store",
        "@com_github_bradleyfalzon_ghinstallation_v2//:ghinstallation",
        "@com_github_google_go_github_v88//github",
        "@com_github_google_uuid//:uuid",
    ],
)

go_test(
    name = "github_test",
    srcs = [
        "client_test.go",
        "fake_test.go",
        "ratelimit_test.go",
        "settings_test.go",
        "webhook_test.go",
    ],
    data = ["//agentplane/notification_service/store:golden.json"],
    embed = [":github"],
    deps = [
        "//agentplane/notification_service/store",
        "@com_github_google_uuid//:uuid",
        "@com_github_spf13_viper//:viper",
        "@io_bazel_rules_go//go/runfiles",
    ],
)
