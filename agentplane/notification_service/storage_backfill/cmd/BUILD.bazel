load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "storage-backfill-lib",
    srcs = ["main.go"],
    importpath = "github.com/agentydragon/ducktape/agentplane/notification_service/storage_backfill/cmd",
    visibility = ["//visibility:private"],
    deps = [
        "//agentplane/notification_service/store",
        "//agentplane/postgres/go/migrate",
    ],
)

go_binary(
    name = "notification-destination-backfill",
    embed = [":storage-backfill-lib"],
    pure = "on",
    visibility = ["//visibility:public"],
)
