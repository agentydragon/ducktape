load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//agentplane/notification_service:__subpackages__"])

go_library(
    name = "store",
    srcs = [
        "inboxes.go",
        "models.go",
        "store.go",
        "subscriptions.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/notification_service/store",
    deps = ["@com_github_google_uuid//:uuid"],
)

go_test(
    name = "golden_test",
    srcs = [
        "golden_test.go",
        "golden_vectors_test.go",
    ],
    embed = [":store"],
    embedsrcs = ["golden.json"],
)

go_test(
    name = "store_integration_test",
    size = "medium",
    srcs = [
        "golden_vectors_test.go",
        "inboxes_integration_test.go",
        "integration_testmain_test.go",
        "python_rows_integration_test.go",
        "subscriptions_integration_test.go",
        "wakeups_integration_test.go",
    ],
    embed = [":store"],
    embedsrcs = ["golden.json"],
    tags = ["requires_docker"],
    deps = [
        "//agentplane/notification_service/migrations",
        "//agentplane/postgres/go/wakeups",
        "//agentplane/testing/postgres",
        "@com_github_google_uuid//:uuid",
        "@com_github_lib_pq//:pq",
    ],
)

exports_files(
    ["golden.json"],
    visibility = ["//agentplane/notification_service:__pkg__"],
)
