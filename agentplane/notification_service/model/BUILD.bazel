load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//devinfra/go:defs.bzl", "go_test")

package(default_visibility = ["//agentplane/notification_service:__subpackages__"])

go_library(
    name = "model",
    srcs = [
        "event_identity.go",
        "github_commit.go",
        "github_mergeability.go",
        "github_repository.go",
        "github_reviews.go",
        "identity.go",
        "selection.go",
        "subscription.go",
        "validation.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/notification_service/model",
    deps = [
        "@com_github_google_uuid//:uuid",
    ],
)

go_test(
    name = "model_test",
    srcs = ["model_test.go"],
    embed = [":model"],
    deps = [
        "@com_github_google_uuid//:uuid",
    ],
)
