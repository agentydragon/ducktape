load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//agentplane/notification_service:__subpackages__"])

go_library(
    name = "worker",
    srcs = [
        "deliver.go",
        "destination.go",
        "provider.go",
        "settings.go",
        "worker.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/notification_service/worker",
    deps = [
        "//agentplane/action",
        "//agentplane/history_service:history_service_go_proto",
        "//agentplane/notification_service/store",
        "//agentplane/proto:event_log_go_proto",
        "//agentplane/runner_gateway/dispatcher:session_dispatcher_go_proto",
        "//agentplane/sandboxes/sandboxreader",
        "@com_github_google_uuid//:uuid",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
    ],
)

go_test(
    name = "settings_test",
    srcs = ["settings_test.go"],
    embed = [":worker"],
)

go_test(
    name = "integration_test",
    size = "medium",
    srcs = [
        "debounce_integration_test.go",
        "deliver_integration_test.go",
        "destination_integration_test.go",
        "harness_integration_test.go",
        "integration_testmain_test.go",
        "run_integration_test.go",
        "source_integration_test.go",
    ],
    embed = [":worker"],
    tags = ["requires_docker"],
    deps = [
        "//agentplane/action",
        "//agentplane/history_service:history_service_go_proto",
        "//agentplane/notification_service/migrations",
        "//agentplane/notification_service/store",
        "//agentplane/proto:command_go_proto",
        "//agentplane/proto:event_go_proto",
        "//agentplane/proto:event_log_go_proto",
        "//agentplane/runner_gateway/dispatcher:session_dispatcher_go_proto",
        "//agentplane/sandboxes/sandboxreader",
        "//agentplane/testing/postgres",
        "@com_github_google_uuid//:uuid",
        "@com_github_lib_pq//:pq",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//proto",
    ],
)
