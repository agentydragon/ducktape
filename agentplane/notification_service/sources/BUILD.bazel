load("//devinfra/python:defs.bzl", "py_library")

package(default_visibility = ["//agentplane/notification_service:__subpackages__"])

py_library(
    name = "actions",
    srcs = ["actions.py"],
    deps = [
        "//agentplane:subjects",
        "//agentplane/action_service:models",
        "@pypi//httpx",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "github",
    srcs = ["github.py"],
    deps = [
        ":github_models",
        "//agentplane/notification_service:db",
        "//agentplane/notification_service:github_state",
        "//agentplane/notification_service:models",
        "//agentplane/notification_service:settings",
        "//agentplane/notification_service:store",
        "@pypi//cryptography",
        "@pypi//httpx",
        "@pypi//pydantic",
        "@pypi//pyjwt",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "github_models",
    srcs = ["github_models.py"],
    deps = ["@pypi//pydantic"],
)
