load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//devinfra/go:defs.bzl", "go_test")

go_library(
    name = "migrations",
    srcs = [
        "migrations.go",
    ],
    embedsrcs = glob([
        "notifications/*.sql",
    ]),
    importpath = "github.com/agentydragon/ducktape/agentplane/notification_service/migrations",
    visibility = ["//agentplane/notification_service:__subpackages__"],
    deps = [
        "@com_github_pressly_goose_v3//:goose",
        "@com_github_pressly_goose_v3//lock",
    ],
)

go_test(
    name = "baseline_integration_test",
    size = "medium",
    srcs = ["baseline_integration_test.go"],
    embedsrcs = ["notifications/00010_final_schema.sql"],
    tags = ["requires_docker"],
    deps = [
        ":migrations",
        "//agentplane/notification_service/model",
        "//agentplane/notification_service/store",
        "//agentplane/testing/postgres",
        "@com_github_google_uuid//:uuid",
        "@com_github_lib_pq//:pq",
        "@com_github_pressly_goose_v3//:goose",
    ],
)
