load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "cmd_lib",
    srcs = ["main.go"],
    importpath = "github.com/agentydragon/ducktape/agentplane/notification_service/migrations/cmd",
    visibility = ["//visibility:private"],
    deps = [
        "//agentplane/notification_service/migrations",
        "//agentplane/notification_service/store",
        "//agentplane/postgres/go/migrate",
    ],
)

go_binary(
    name = "notifications-migrate",
    embed = [":cmd_lib"],
    pure = "on",
    visibility = ["//agentplane/notification_service:__subpackages__"],
)
