load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = [
    "//agentplane/history_service/internal/ingress:__pkg__",
    "//agentplane/sampler:__pkg__",
])

go_library(
    name = "anthropic",
    srcs = [
        "anthropic.go",
        "compaction.go",
        "config.go",
        "context.go",
        "observations.go",
        "stored.go",
        "wire.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/sampler/providers/anthropic",
    visibility = [
        "//agentplane/history_service/internal/ingress:__pkg__",
        "//agentplane/sampler:__pkg__",
        "//agentplane/sampler:__subpackages__",
        "//agentplane/sampler/internal/settings:__pkg__",
    ],
    deps = [
        "//agentplane/proto:event_go_proto",
        "//agentplane/sampler/internal/content",
        "//agentplane/sampler/internal/providerio",
        "//agentplane/sampler/protocol",
    ],
)

go_test(
    name = "anthropic_test",
    size = "small",
    srcs = [
        "anthropic_test.go",
        "stored_test.go",
    ],
    embed = [":anthropic"],
    race = "on",
    deps = [
        "//agentplane/proto:event_go_proto",
        "//agentplane/sampler/internal/providerio",
        "//agentplane/sampler/protocol",
        "//agentplane/sampler/testing/providerfixture",
        "//agentplane/sampler/testing/wirefixture",
    ],
)
