load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//agentplane/sampler:__subpackages__"])

go_library(
    name = "protocol",
    srcs = [
        "content.go",
        "context.go",
        "errors.go",
        "evidence.go",
        "instructions.go",
        "provider_hooks.go",
        "tool_definitions.go",
        "tool_invocation.go",
        "tool_surface.go",
    ],
    embedsrcs = ["base_instructions.txt"],
    importpath = "github.com/agentydragon/ducktape/agentplane/sampler/protocol",
    visibility = [
        "//agentplane/history_service/internal/ingress:__pkg__",  # real ingress exporter integration test
        "//agentplane/sampler:__subpackages__",
    ],
    deps = [
        "//agentplane/proto:event_go_proto",
    ],
)

go_test(
    name = "protocol_test",
    srcs = ["errors_test.go"],
    embed = [":protocol"],
)
