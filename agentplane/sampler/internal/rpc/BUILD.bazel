load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:private"])

go_library(
    name = "rpc",
    srcs = [
        "admin_service.go",
        "harness_host.go",
        "provider_request_read.go",
        "service.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/sampler/internal/rpc",
    visibility = ["//agentplane/sampler/cmd:__pkg__"],
    deps = [
        "//agentplane/grpc/streaming",
        "//agentplane/harness_host",
        "//agentplane/harness_host:harness_host_go_proto",
        "//agentplane/identity/auth",
        "//agentplane/postgres/wakeups",
        "//agentplane/proto:command_go_proto",
        "//agentplane/proto:event_log_go_proto",
        "//agentplane/proto:identity_go_proto",
        "//agentplane/proto:session_go_proto",
        "//agentplane/sampler/api:sampler_admin_go_proto",
        "//agentplane/sampler/internal/residentruntime",
        "//agentplane/sampler/internal/sessionconfig",
        "//agentplane/sampler/internal/sessionstore",
        "//agentplane/sampler/internal/settings",
        "//agentplane/sampler/protocol",
        "//agentplane/sampler/providers/responses",
        "@com_github_google_uuid//:uuid",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//metadata",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//proto",
    ],
)

go_test(
    name = "unit_test",
    size = "medium",
    srcs = [
        "service_test.go",
        "test_helpers_test.go",
    ],
    embed = [":rpc"],
    race = "on",
    deps = [
        "//agentplane/harness_host:harness_host_go_proto",
        "//agentplane/identity/auth",
        "//agentplane/net/peertls",
        "//agentplane/net/peertls/testing",
        "//agentplane/proto:session_go_proto",
        "//agentplane/sampler/internal/sessionstore",
        "//agentplane/sampler/internal/settings",
        "//agentplane/sampler/protocol",
        "//agentplane/sampler/providers/responses",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//credentials",
        "@org_golang_google_grpc//metadata",
        "@org_golang_google_grpc//peer",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//proto",
    ],
)

go_test(
    name = "integration_test",
    size = "medium",
    srcs = [
        "harness_host_test.go",
        "request_read_service_test.go",
        "test_helpers_test.go",
    ],
    embed = [":rpc"],
    race = "on",
    tags = ["requires_docker"],
    deps = [
        "//agentplane/harness_host",
        "//agentplane/harness_host:harness_host_go_proto",
        "//agentplane/net/peertls",
        "//agentplane/net/peertls/testing",
        "//agentplane/postgres/wakeups",
        "//agentplane/proto:session_go_proto",
        "//agentplane/sampler/api:sampler_admin_go_proto",
        "//agentplane/sampler/internal/providerrequest",
        "//agentplane/sampler/internal/residentruntime",
        "//agentplane/sampler/internal/sessionconfig",
        "//agentplane/sampler/internal/sessionstore",
        "//agentplane/sampler/internal/settings",
        "//agentplane/sampler/internal/testsupport",
        "//agentplane/sampler/migrations",
        "//agentplane/sampler/protocol",
        "//agentplane/sampler/providers/anthropic",
        "//agentplane/sampler/providers/responses",
        "//agentplane/testing/postgres",
        "@com_github_google_uuid//:uuid",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//credentials",
        "@org_golang_google_grpc//metadata",
        "@org_golang_google_grpc//peer",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//proto",
    ],
)
