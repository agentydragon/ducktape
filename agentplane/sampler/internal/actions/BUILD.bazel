load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//agentplane/sampler:__subpackages__"])

go_library(
    name = "actions",
    srcs = ["client.go"],
    importpath = "github.com/agentydragon/ducktape/agentplane/sampler/internal/actions",
    deps = [
        "//agentplane/action_service/api/contracts:action_service_go_proto",
        "//agentplane/identity/auth",
        "//agentplane/net/peertls",
        "//agentplane/observability",
        "//agentplane/proto:delegation_go_proto",
        "//agentplane/proto:identity_go_proto",
        "@com_github_google_uuid//:uuid",
        "@com_github_sethvargo_go_retry//:go-retry",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//metadata",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//proto",
    ],
)

go_test(
    name = "actions_test",
    srcs = ["client_test.go"],
    embed = [":actions"],
    deps = [
        "//agentplane/action_service/api/contracts:action_service_go_proto",
        "//agentplane/identity/auth",
        "//agentplane/net/peertls",
        "//agentplane/net/peertls/testing",
        "//agentplane/proto:delegation_go_proto",
        "//agentplane/proto:identity_go_proto",
        "//agentplane/testing/grpcserver",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//metadata",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/structpb",
    ],
)
