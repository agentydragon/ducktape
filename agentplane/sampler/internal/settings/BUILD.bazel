load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:private"])

go_library(
    name = "settings",
    srcs = [
        "event_block.go",
        "model.go",
        "settings.go",
        "validation.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/sampler/internal/settings",
    visibility = ["//agentplane/sampler:__subpackages__"],
    deps = [
        "//agentplane/eventblock",
        "//agentplane/identity/auth",
        "//agentplane/net/peertls",
        "//agentplane/observability",
        "//agentplane/sampler/protocol",
        "//agentplane/sampler/providers/anthropic",
        "//agentplane/sampler/providers/chatcompletions",
        "//agentplane/sampler/providers/responses",
    ],
)

go_test(
    name = "settings_test",
    srcs = [
        "settings_fixture_test.go",
        "settings_test.go",
    ],
    embed = [":settings"],
    deps = [
        "//agentplane/net/peertls",
        "//agentplane/sampler/protocol",
        "//agentplane/sampler/providers/anthropic",
        "//agentplane/sampler/providers/responses",
    ],
)
