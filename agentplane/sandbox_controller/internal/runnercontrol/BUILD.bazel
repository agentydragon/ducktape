load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "runnercontrol",
    srcs = [
        "observer.go",
        "quiescer.go",
        "suspender.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/sandbox_controller/internal/runnercontrol",
    visibility = ["//agentplane/sandbox_controller/cmd:__pkg__"],
    deps = [
        "//agentplane/env/runtime/control:environment_runtime_go_proto",
        "//agentplane/identity/credentials/workloadid",
        "//agentplane/net/peertls",
        "//agentplane/observability",
        "//agentplane/proto:session_go_proto",
        "//agentplane/sandbox_controller/internal/controller",
        "//agentplane/sandboxes/api",
        "//agentplane/sandboxes/environmentruntimeclient",
        "@io_k8s_api//core/v1:core",
        "@io_opentelemetry_go_otel//attribute",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

go_test(
    name = "runnercontrol_test",
    srcs = [
        "observer_test.go",
        "quiescer_test.go",
    ],
    embed = [":runnercontrol"],
    deps = [
        "//agentplane/env/runtime/control:environment_runtime_go_proto",
        "//agentplane/identity/credentials/workloadid",
        "//agentplane/net/peertls",
        "//agentplane/net/peertls/testing",
        "//agentplane/proto:environment_runtime_state_go_proto",
        "//agentplane/proto:session_go_proto",
        "//agentplane/sandboxes/api",
        "@io_k8s_api//core/v1:core",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@org_golang_google_grpc//:grpc",
    ],
)
