load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")
load("//devinfra/go:defs.bzl", "go_test")

go_library(
    name = "cmd_lib",
    srcs = [
        "config.go",
        "main.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/sandbox_controller/cmd",
    visibility = ["//visibility:private"],
    deps = [
        "//agentplane/observability",
        "//agentplane/policy/api/v1alpha1",
        "//agentplane/sandbox_controller",
        "//agentplane/sandboxes/api",
        "@com_github_go_logr_logr//:logr",
        "@com_github_spf13_viper//:viper",
        "@io_k8s_apimachinery//pkg/api/errors",
        "@io_k8s_apimachinery//pkg/runtime",
        "@io_k8s_client_go//discovery",
        "@io_k8s_client_go//kubernetes/scheme",
        "@io_k8s_client_go//rest",
        "@io_k8s_sigs_controller_runtime//:controller-runtime",
        "@io_k8s_sigs_controller_runtime//pkg/cache",
        "@io_k8s_sigs_controller_runtime//pkg/healthz",
        "@io_k8s_sigs_controller_runtime//pkg/metrics/server",
        "@io_kubevirt_api//core/v1:core",
    ],
)

go_binary(
    name = "sandbox-controller",
    embed = [":cmd_lib"],
    pure = "on",
    visibility = ["//agentplane/sandbox_controller:__pkg__"],
)

go_test(
    name = "config_test",
    srcs = ["config_test.go"],
    embed = [":cmd_lib"],
)
