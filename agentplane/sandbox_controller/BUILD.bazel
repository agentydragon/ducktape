load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

go_library(
    name = "sandbox_controller",
    srcs = [
        "control_service.go",
        "controller.go",
        "identity.go",
        "launch.go",
        "quiescer.go",
        "runner_facts.go",
        "types.go",
        "vm.go",
        "zz_generated.deepcopy.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/sandbox_controller",
    visibility = ["//agentplane/sandbox_controller:__subpackages__"],
    deps = [
        "//agentplane/policy_controller",
        "//agentplane/proto:runner_control_go_proto",
        "//agentplane/proto:runner_go_proto",
        "@io_k8s_api//coordination/v1:coordination",
        "@io_k8s_api//core/v1:core",
        "@io_k8s_apimachinery//pkg/api/equality",
        "@io_k8s_apimachinery//pkg/api/errors",
        "@io_k8s_apimachinery//pkg/api/meta",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_apimachinery//pkg/runtime",
        "@io_k8s_apimachinery//pkg/runtime/schema",
        "@io_k8s_apimachinery//pkg/types",
        "@io_k8s_apimachinery//pkg/util/intstr",
        "@io_k8s_sigs_controller_runtime//:controller-runtime",
        "@io_k8s_sigs_controller_runtime//pkg/builder",
        "@io_k8s_sigs_controller_runtime//pkg/client",
        "@io_k8s_sigs_controller_runtime//pkg/controller/controllerutil",
        "@io_k8s_sigs_controller_runtime//pkg/event",
        "@io_k8s_sigs_controller_runtime//pkg/handler",
        "@io_k8s_sigs_controller_runtime//pkg/predicate",
        "@io_k8s_sigs_controller_runtime//pkg/reconcile",
        "@io_k8s_sigs_controller_runtime//pkg/scheme",
        "@io_kubevirt_api//core/v1:core",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//credentials/insecure",
        "@org_golang_google_grpc//metadata",
    ],
)

go_test(
    name = "sandbox_controller_test",
    srcs = [
        "controller_test.go",
        "identity_test.go",
        "launch_test.go",
        "runner_facts_test.go",
        "vm_test.go",
    ],
    embed = [":sandbox_controller"],
    deps = [
        "//agentplane/policy_controller",
        "@io_k8s_api//coordination/v1:coordination",
        "@io_k8s_api//core/v1:core",
        "@io_k8s_apimachinery//pkg/api/equality",
        "@io_k8s_apimachinery//pkg/api/errors",
        "@io_k8s_apimachinery//pkg/api/meta",
        "@io_k8s_apimachinery//pkg/api/resource",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_apimachinery//pkg/runtime",
        "@io_k8s_apimachinery//pkg/runtime/serializer",
        "@io_k8s_apimachinery//pkg/types",
        "@io_k8s_client_go//kubernetes/scheme",
        "@io_k8s_client_go//testing",
        "@io_k8s_sigs_controller_runtime//pkg/client",
        "@io_k8s_sigs_controller_runtime//pkg/client/fake",
        "@io_k8s_sigs_controller_runtime//pkg/reconcile",
        "@io_kubevirt_api//core/v1:core",
    ],
)

pkg_tar(
    name = "binary_layer",
    srcs = ["//agentplane/sandbox_controller/cmd:sandbox-controller"],
    package_dir = "/usr/local/bin",
)

# Talks only to the API server, through the in-cluster ServiceAccount CA, so it needs no system
# CA bundle.
oci_image(
    name = "image",
    base = "@debian_trixie_slim_linux_amd64",
    entrypoint = ["/usr/local/bin/sandbox-controller"],
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [":binary_layer"],
    user = "1000:1000",
    visibility = ["//visibility:public"],
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["agentplane-sandbox-controller:latest"],
)
