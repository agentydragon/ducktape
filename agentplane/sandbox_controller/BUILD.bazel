pkg_tar(
    name = "binary_layer",
    srcs = ["//agentplane/sandbox_controller/cmd:sandbox-controller"],
    package_dir = "/usr/local/bin",
)

# Talks only to the API server, through the in-cluster ServiceAccount CA, so it needs no system
# CA bundle.
oci_image(
    name = "image",
    base = "@distroless_static_debian13_linux_amd64",
    entrypoint = ["/usr/local/bin/sandbox-controller"],
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [":binary_layer"],
    user = "1000:1000",
    visibility = ["//visibility:public"],
    workdir = "/",
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["agentplane-sandbox-controller:latest"],
)

py_library(
    name = "settings",
    srcs = ["settings.py"],
    visibility = ["//cluster/cdk8s/agentplane:__pkg__"],
    deps = [
        "@pypi//pydantic",
        "@pypi//pydantic_settings",
    ],
)
