# gazelle:resolve proto agentplane/policy/api/v1alpha1/policy_types.proto //agentplane/policy/api/v1alpha1:policy_types_proto
load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@io_bazel_rules_go//proto:def.bzl", "go_proto_library")
