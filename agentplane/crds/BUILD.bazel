# This repo's own Agentplane CRDs (manifests/crd-*.yaml), and the typed cdk8s Python constructs
# generated from them. These are first-party schemas -- their authoritative source, not a
# copy of anything upstream -- so importing directly from them is correct (see
# devinfra/js/cdk8s_import.bzl's crd arg doc, which only warns against vendoring a copy of
# an *upstream* CRD). See cluster/docs/cdk8s.md. `bb run :generate_bin` writes the CRDs'
# derived schemas: the binding CRDs' subject block and the kubeconform schemas under
# cluster/schemas/. Flux packages the CRDs from this same source directory for
# application, so there is no checked-in manifest copy.

# Each *_crds module below is generated at build time by cdk8s_import, not a pip
# package -- gazelle can't resolve it from the requirements manifest.
# gazelle:resolve py agentplane_actionpolicyset_crds //agentplane/crds:actionpolicyset
# gazelle:resolve py agentplane_actionpolicybinding_crds //agentplane/crds:actionpolicybinding
# gazelle:resolve py agentplane_egresspolicy_crds //agentplane/crds:egresspolicy
# gazelle:resolve py agentplane_egresscredential_crds //agentplane/crds:egresscredential
# gazelle:resolve py agentplane_egressbinding_crds //agentplane/crds:egressbinding

load("//devinfra/js:cdk8s_import.bzl", "cdk8s_import")
load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

filegroup(
    name = "crds",
    srcs = glob(["manifests/crd-*.yaml"]),
    visibility = [
        "//cluster/cdk8s:__pkg__",
        "//cluster/validation:__pkg__",
    ],
)

filegroup(
    name = "manifests",
    srcs = glob(["manifests/*.yaml"]),
    visibility = [
        "//cluster/cdk8s:__pkg__",
        "//cluster/validation:__pkg__",
    ],
)

py_library(
    name = "generate",
    srcs = ["generate.py"],
    visibility = ["//cluster/cdk8s:__pkg__"],
    deps = [
        "//agentplane:subjects",
        "//util/bazel:workspace",
        "@pypi//more_itertools",
        "@pypi//pydantic",
        "@pypi//pyyaml",
    ],
)

py_binary(
    name = "generate_bin",
    main_module = "agentplane.crds.generate",
    deps = [":generate"],
)

py_test(
    name = "test_generate",
    srcs = ["test_generate.py"],
    data = [
        ":crds",
        "//cluster/schemas",
    ],
    deps = [
        ":generate",
        "//:conftest",
        "//util/bazel:runfiles",
        "@pypi//jsonschema",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//pyyaml",
        "@pypi//referencing",
    ],
)

# All five CRDs share the agentplane.allegedly.works group; cdk8s import only ingests
# one CRD per invocation, so each kind gets its own target and module_name (distinct
# names so importing several together, as the actions/egress constructs will, doesn't
# collide on one shared top-level Python package).

cdk8s_import(
    name = "actionpolicyset",
    crd = "manifests/crd-actionpolicysets.yaml",
    module_name = "agentplane_actionpolicyset_crds",
    module_path = "works/allegedly/agentplane",
    visibility = ["//visibility:public"],
)

cdk8s_import(
    name = "actionpolicybinding",
    crd = "manifests/crd-actionpolicybindings.yaml",
    module_name = "agentplane_actionpolicybinding_crds",
    module_path = "works/allegedly/agentplane",
    visibility = ["//visibility:public"],
)

cdk8s_import(
    name = "egresspolicy",
    crd = "manifests/crd-egresspolicies.yaml",
    module_name = "agentplane_egresspolicy_crds",
    module_path = "works/allegedly/agentplane",
    visibility = ["//visibility:public"],
)

cdk8s_import(
    name = "egresscredential",
    crd = "manifests/crd-egresscredentials.yaml",
    module_name = "agentplane_egresscredential_crds",
    module_path = "works/allegedly/agentplane",
    visibility = ["//visibility:public"],
)

cdk8s_import(
    name = "egressbinding",
    crd = "manifests/crd-egressbindings.yaml",
    module_name = "agentplane_egressbinding_crds",
    module_path = "works/allegedly/agentplane",
    visibility = ["//visibility:public"],
)
