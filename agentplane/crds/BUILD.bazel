# Sandbox, EgressCredential, PolicySet and PolicyBinding CRDs derive from Go API types. The typed
# cdk8s Python constructs are generated from these first-party manifests, so importing directly
# from them is correct (see
# devinfra/js/cdk8s_import.bzl's crd arg doc, which only warns against vendoring a copy of an
# upstream CRD). See cluster/docs/cdk8s.md. `bb run :generate_bin` writes the Go-derived CRDs.
# Flux packages the CRDs from this same source directory for application, so there is no checked-in
# manifest copy.

# Each *_crds module below is generated at build time by cdk8s_import, not a pip
# package -- gazelle can't resolve it from the requirements manifest.

load("//devinfra/js:cdk8s_import.bzl", "cdk8s_import")
load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

filegroup(
    name = "crds",
    srcs = glob(["manifests/crd-*.yaml"]),
    visibility = [
        "//agentplane/system_tests/k3s:__pkg__",
        "//agentplane/testing:__pkg__",
        "//agentplane/testing/kubeapiserver:__pkg__",
        "//cluster/cdk8s:__pkg__",
        "//cluster/validation:__pkg__",
    ],
)

filegroup(
    name = "manifests",
    srcs = glob(["manifests/*.yaml"]),
    visibility = [
        "//cluster/cdk8s:__pkg__",
        "//cluster/validation:__pkg__",
    ],
)

py_library(
    name = "generate",
    srcs = ["generate.py"],
    visibility = ["//cluster/cdk8s:__pkg__"],
    deps = [
        "//util/bazel:runfiles",
        "//util/bazel:workspace",
        "@pypi//pyyaml",
    ],
)

py_binary(
    name = "generate_bin",
    data = [
        "//agentplane/egress/api/v1alpha1:generated_crds",
        "//agentplane/policy/api/v1alpha1:generated_crds",
        "//agentplane/sandboxes/api:generated_crds",
    ],
    main_module = "agentplane.crds.generate",
    deps = [":generate"],
)

py_test(
    name = "test_generate",
    srcs = ["test_generate.py"],
    data = [
        ":crds",
        "//agentplane/egress/api/v1alpha1:generated_crds",
        "//agentplane/policy/api/v1alpha1:generated_crds",
        "//agentplane/sandboxes/api:generated_crds",
    ],
    deps = [
        ":generate",
        "//:conftest",
        "//util/bazel:runfiles",
        "//util/testing:undeclared_outputs",
        "@pypi//jsonschema",
        "@pypi//pytest_bazel",
        "@pypi//pyyaml",
        "@pypi//referencing",
    ],
)

py_test(
    name = "test_sandbox_admission",
    srcs = ["test_sandbox_admission.py"],
    data = [":crds"],
    deps = [
        "//:conftest",
        "//agentplane/testing:kubernetes_apiserver",
        "@pypi//kubernetes_asyncio",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_policyset_admission",
    srcs = ["test_policyset_admission.py"],
    data = [":crds"],
    deps = [
        "//:conftest",
        "//agentplane/testing:kubernetes_apiserver",
        "@pypi//kubernetes_asyncio",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

# All the CRDs share the agentplane.allegedly.works group; cdk8s import only ingests
# one CRD per invocation, so each kind gets its own target and module_name (distinct
# names so importing several together, as the actions/egress constructs will, doesn't
# collide on one shared top-level Python package).

cdk8s_import(
    name = "egresscredential",
    crd = "manifests/crd-egresscredentials.yaml",
    module_name = "agentplane_egresscredential_crds",
    module_path = "works/allegedly/agentplane",
    visibility = ["//visibility:public"],
)

cdk8s_import(
    name = "policyset",
    crd = "manifests/crd-policysets.yaml",
    module_name = "agentplane_policyset_crds",
    module_path = "works/allegedly/agentplane",
    visibility = ["//visibility:public"],
)

cdk8s_import(
    name = "policybinding",
    crd = "manifests/crd-policybindings.yaml",
    module_name = "agentplane_policybinding_crds",
    module_path = "works/allegedly/agentplane",
    visibility = ["//visibility:public"],
)
