load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "connections",
    srcs = [
        "authorizations.go",
        "enrollments.go",
        "service.go",
        "store.go",
        "watch.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/mcp_edge/connections",
    visibility = ["//agentplane:__subpackages__"],
    deps = [
        "//agentplane/action_service:action_service_go_proto",
        "//agentplane/grpc/streaming",
        "//agentplane/identity/auth/auth",
        "//agentplane/mcp_edge/api/connection:connection_service_go_proto",
        "//agentplane/postgres",
        "//agentplane/postgres/wakeups",
        "//agentplane/proto:identity_go_proto",
        "@com_github_google_uuid//:uuid",
        "@com_github_lib_pq//:pq",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//types/known/emptypb",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

go_test(
