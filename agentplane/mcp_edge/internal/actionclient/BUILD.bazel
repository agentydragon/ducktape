load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//agentplane/mcp_edge:__subpackages__"])

go_library(
    name = "actionclient",
    srcs = [
        "action_metadata.go",
        "core_client.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/mcp_edge/internal/actionclient",
    deps = [
        "//agentplane/action_service/api/contracts:linkage_service_go_proto",
        "//agentplane/identity/auth",
        "//agentplane/identity/auth/grpc",
        "//agentplane/mcp_edge/internal/connections",
        "//agentplane/net/peertls",
        "//agentplane/proto:delegation_go_proto",
        "//agentplane/proto:identity_go_proto",
        "@com_github_modelcontextprotocol_go_sdk//auth",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
