load("@rules_oci//oci:defs.bzl", "oci_image")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//agentplane/mcp_edge:__subpackages__"])

py_library(
    name = "oauth_settings",
    srcs = ["oauth_settings.py"],
    visibility = ["//agentplane/system_tests/deployment:__pkg__"],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "settings",
    srcs = ["settings.py"],
    visibility = ["//cluster/cdk8s:deployment_consumers"],
    deps = [
        ":oauth_settings",
        "//agentplane/identity/operator:settings",
        "//agentplane/net/peertls:config",
        "@pypi//pydantic",
    ],
)

py_test(
    name = "test_settings",
    srcs = ["test_settings.py"],
    deps = [
        ":settings",
        "//:conftest",
        "@pypi//pydantic",
        "@pypi//pytest",
    ],
)

test_suite(
    name = "runtime_test",
    tests = [
        "//agentplane/mcp_edge/cmd:cmd_test",
        "//agentplane/mcp_edge/internal/actionclient:actionclient_test",
    ],
)

pkg_tar(
    name = "service_binary_layer",
    srcs = ["//agentplane/mcp_edge/cmd:mcp-edge"],
    package_dir = "/usr/local/bin",
)

oci_image(
    name = "service_image",
    base = "@distroless_static_debian13_linux_amd64",
    entrypoint = ["/usr/local/bin/mcp-edge"],
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [":service_binary_layer"],
    user = "1000:1000",
    visibility = ["//visibility:public"],
    workdir = "/",
)
