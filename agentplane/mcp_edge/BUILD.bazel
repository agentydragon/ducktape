load("@aspect_rules_ts//ts:proto.bzl", "ts_proto_library")
load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("@io_bazel_rules_go//proto:def.bzl", "go_proto_library")
load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_oci//oci:defs.bzl", "oci_image")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//devinfra/python:defs.bzl", "py_library")
load("//devinfra/python:grpc.bzl", "py_grpc_service_library")
load("//devinfra/python:proto.bzl", "py_proto_library_with_mypy_stubs")

package(default_visibility = ["//agentplane:__subpackages__"])

py_library(
    name = "oauth_settings",
    srcs = ["oauth_settings.py"],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "settings",
    srcs = ["settings.py"],
    visibility = [
        "//agentplane/system_tests/k3s:__pkg__",
        "//cluster/cdk8s:__subpackages__",
    ],
    deps = [
        ":oauth_settings",
        "//agentplane/action_service:operator_oidc_settings",
        "//util:yaml_file_settings",
        "@pypi//pydantic",
        "@pypi//pydantic_settings",
    ],
)

proto_library(
    name = "connection_service_proto",
    srcs = ["connection_service.proto"],
    deps = [
        "//agentplane/action_service:action_service_proto",
        "//agentplane/proto:sandboxes_proto",
        "@googleapis//google/api:annotations_proto",
        "@protobuf//:empty_proto",
        "@protobuf//:timestamp_proto",
    ],
)

py_proto_library_with_mypy_stubs(
    name = "connection_service_pb2",
    deps = [":connection_service_proto"],
)

py_grpc_service_library(
    name = "connection_service_pb2_grpc",
    async_only = True,
    proto = ":connection_service_proto",
    py_proto = ":connection_service_pb2",
)

ts_proto_library(
    name = "connection_service_pb",
    copy_files = False,
    node_modules = "//:node_modules",
    proto = ":connection_service_proto",
    deps = [
        "//agentplane/action_service:action_service_pb",
        "//agentplane/proto:sandboxes_pb",
        "//google/api:annotations_pb",
    ],
)

go_proto_library(
    name = "connection_service_go_proto",
    compilers = [
        "@io_bazel_rules_go//proto:go_proto",
        "@io_bazel_rules_go//proto:go_grpc_v2",
        "//devinfra/go:grpc_gateway",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/mcp_edge/connection_servicepb",
    proto = ":connection_service_proto",
    deps = [
        "//agentplane/action_service:action_service_go_proto",
        "//agentplane/proto:sandboxes_go_proto",
        "@org_golang_google_genproto_googleapis_api//annotations",
    ],
)

go_library(
    name = "main_lib",
    srcs = [
        "callers.go",
        "config.go",
        "core_client.go",
        "main.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/mcp_edge",
    visibility = ["//agentplane:__subpackages__"],
    deps = [
        ":connection_service_go_proto",
        "//agentplane/action_service:action_service_go_proto",
        "//agentplane/action_service/api",
        "//agentplane/grpc/facade",
        "//agentplane/mcp_edge/authserver",
        "//agentplane/mcp_edge/connections",
        "//agentplane/mcp_edge/mcpserver",
        "//agentplane/observability",
        "//agentplane/policy/reader",
        "//agentplane/postgres/go:postgres",
        "//agentplane/postgres/go/probes",
        "//agentplane/postgres/go/wakeups",
        "//agentplane/settings/go:config",
        "//agentplane/watchhealth",
        "//agentplane/workload_auth/go/auth",
        "@com_github_go_viper_mapstructure_v2//:mapstructure",
        "@com_github_lib_pq//:pq",
        "@com_github_modelcontextprotocol_go_sdk//auth",
        "@com_github_prometheus_client_golang//prometheus/promhttp",
        "@com_github_spf13_viper//:viper",
        "@in_gopkg_yaml_v3//:yaml_v3",
        "@io_k8s_api//authentication/v1:authentication",
        "@io_k8s_api//core/v1:core",
        "@io_k8s_apimachinery//pkg/api/errors",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_apimachinery//pkg/types",
        "@io_k8s_apimachinery//pkg/util/sets",
        "@io_k8s_client_go//informers/core/v1:core",
        "@io_k8s_client_go//kubernetes",
        "@io_k8s_client_go//rest",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//credentials/insecure",
        "@org_golang_google_grpc//health/grpc_health_v1",
        "@org_golang_google_grpc//metadata",
        "@org_golang_google_grpc//status",
    ],
)

go_test(
    name = "runtime_test",
    srcs = [
        "config_test.go",
        "core_client_test.go",
    ],
    embed = [":main_lib"],
    deps = [
        "//agentplane/action_service:action_service_go_proto",
        "//agentplane/watchhealth",
        "//agentplane/workload_auth/go/auth",
        "@com_github_modelcontextprotocol_go_sdk//auth",
        "@io_k8s_api//authentication/v1:authentication",
        "@io_k8s_api//core/v1:core",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_apimachinery//pkg/runtime",
        "@io_k8s_apimachinery//pkg/types",
        "@io_k8s_apimachinery//pkg/util/sets",
        "@io_k8s_client_go//kubernetes/fake",
        "@io_k8s_client_go//testing",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//credentials/insecure",
        "@org_golang_google_grpc//metadata",
        "@org_golang_google_grpc//status",
        "@org_golang_google_grpc//test/bufconn",
    ],
)

go_binary(
    name = "mcp-edge",
    embed = [":main_lib"],
    pure = "on",
)

pkg_tar(
    name = "service_binary_layer",
    srcs = [":mcp-edge"],
    package_dir = "/usr/local/bin",
)

oci_image(
    name = "service_image",
    base = "@distroless_static_debian13_linux_amd64",
    entrypoint = ["/usr/local/bin/mcp-edge"],
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [":service_binary_layer"],
    user = "1000:1000",
    visibility = ["//visibility:public"],
    workdir = "/",
)
