load("@aspect_rules_ts//ts:proto.bzl", "ts_proto_library")
load("@io_bazel_rules_go//proto:def.bzl", "go_proto_library")
load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("//devinfra/python:proto.bzl", "py_proto_library_with_mypy_stubs")

package(default_visibility = ["//agentplane:__subpackages__"])

proto_library(
    name = "connection_service_proto",
    srcs = ["connection_service.proto"],
    deps = [
        "//agentplane/action_service:action_service_proto",
        "//agentplane/proto:identity_proto",
        "@googleapis//google/api:annotations_proto",
        "@protobuf//:empty_proto",
        "@protobuf//:timestamp_proto",
    ],
)

py_proto_library_with_mypy_stubs(
    name = "connection_service_pb2",
    deps = [":connection_service_proto"],
)

ts_proto_library(
    name = "connection_service_pb",
    copy_files = False,
    node_modules = "//:node_modules",
    proto = ":connection_service_proto",
    deps = [
        "//agentplane/action_service:action_service_pb",
        "//agentplane/proto:identity_pb",
        "//google/api:annotations_pb",
    ],
)

go_proto_library(
    name = "connection_service_go_proto",
    compilers = [
        "@io_bazel_rules_go//proto:go_proto",
        "@io_bazel_rules_go//proto:go_grpc_v2",
        "//devinfra/go:grpc_gateway",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/mcp_edge/api/connection/connection_servicepb",
    proto = ":connection_service_proto",
    deps = [
        "//agentplane/action_service:action_service_go_proto",
        "//agentplane/proto:identity_go_proto",
        "@org_golang_google_genproto_googleapis_api//annotations",
    ],
)
