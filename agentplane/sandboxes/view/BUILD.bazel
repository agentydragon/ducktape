load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//agentplane:__subpackages__"])

go_library(
    name = "view",
    srcs = ["view.go"],
    importpath = "github.com/agentydragon/ducktape/agentplane/sandboxes/view",
    deps = [
        "//agentplane/proto:sandboxes_go_proto",
        "//agentplane/sandboxes/api",
        "//agentplane/sandboxes/environments:environment_service_go_proto",
        "@io_k8s_api//core/v1:core",
        "@io_k8s_apimachinery//pkg/api/meta",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@org_golang_google_protobuf//types/known/durationpb",
        "@org_golang_google_protobuf//types/known/structpb",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

go_test(
    name = "view_test",
    srcs = ["view_test.go"],
    embed = [":view"],
    deps = [
        "//agentplane/proto:sandboxes_go_proto",
        "//agentplane/sandboxes/api",
        "//agentplane/sandboxes/environments:environment_service_go_proto",
        "@io_k8s_api//core/v1:core",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_apimachinery//pkg/types",
    ],
)
