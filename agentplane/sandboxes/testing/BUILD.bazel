load("//devinfra/python:defs.bzl", "py_library")

package(
    default_testonly = True,
    default_visibility = ["//agentplane:__subpackages__"],
)

py_library(
    name = "kubernetes",
    testonly = True,
    srcs = ["kubernetes.py"],
    deps = [
        "//agentplane:crd_group",
        "//agentplane:sandbox_resource",
        "//agentplane:subjects",
        "//agentplane/proto:identity_pb2",
        "//agentplane/sandboxes:launch",
        "//agentplane/testing:kubernetes",
        "//agentplane/testing:kubernetes_apiserver",
        "//agentplane/testing:tls",
        "@pypi//kubernetes_asyncio",
        "@pypi//protobuf",
    ],
)

py_library(
    name = "sandbox_namespace",
    srcs = ["sandbox_namespace.py"],
    deps = [
        "//agentplane:crd_group",
        "//agentplane:policy_sets",
        "//agentplane:sandbox_resource",
        "//agentplane:subjects",
        "//agentplane/egress:resources",
        "//agentplane/testing:kubernetes",
        "//agentplane/testing:kubernetes_apiserver",
        "@pypi//kubernetes_asyncio",
    ],
)
