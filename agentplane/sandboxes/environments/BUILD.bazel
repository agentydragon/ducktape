load("@aspect_rules_ts//ts:proto.bzl", "ts_proto_library")
load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")
load("@io_bazel_rules_go//proto:def.bzl", "go_proto_library")
load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("//devinfra/python:proto.bzl", "py_proto_library_with_mypy_stubs")

package(default_visibility = ["//agentplane:__subpackages__"])

proto_library(
    name = "environment_service_proto",
    srcs = ["environment_service.proto"],
    deps = [
        "//agentplane/proto:environment_lifecycle_proto",
        "//agentplane/proto:sandboxes_proto",
        "@googleapis//google/api:annotations_proto",
        "@protobuf//:empty_proto",
        "@protobuf//:timestamp_proto",
    ],
)

ts_proto_library(
    name = "environment_service_pb",
    copy_files = False,
    node_modules = "//:node_modules",
    proto = ":environment_service_proto",
    deps = [
        "//agentplane/proto:environment_lifecycle_pb",
        "//agentplane/proto:sandboxes_pb",
        "//google/api:annotations_pb",
    ],
)

py_proto_library_with_mypy_stubs(
    name = "environment_service_pb2",
    deps = [
        ":environment_service_proto",
        "@googleapis//google/rpc:status_proto",
    ],
)

go_proto_library(
    name = "environment_service_go_proto",
    compilers = [
        "@io_bazel_rules_go//proto:go_proto",
        "@io_bazel_rules_go//proto:go_grpc_v2",
        "//devinfra/go:grpc_gateway",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/sandboxes/environments/environmentpb",
    proto = ":environment_service_proto",
    deps = [
        "//agentplane/proto:environment_lifecycle_go_proto",
        "//agentplane/proto:sandboxes_go_proto",
        "@org_golang_google_genproto_googleapis_api//annotations",
        "@org_golang_google_protobuf//types/known/emptypb",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

go_library(
    name = "environments",
    srcs = [
        "collection.go",
        "service.go",
        "watch.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/sandboxes/environments",
    deps = [
        ":environment_service_go_proto",
        "//agentplane/grpc/streaming",
        "//agentplane/proto:delegation_go_proto",
        "//agentplane/proto:environment_lifecycle_go_proto",
        "//agentplane/proto:sandboxes_go_proto",
        "//agentplane/sandboxes/api",
        "//agentplane/sandboxes/lifecycle",
        "//agentplane/sandboxes/runtimeconfig",
        "//agentplane/sandboxes/sandboxreader",
        "//agentplane/sandboxes/view",
        "//agentplane/workload_auth/auth",
        "@io_k8s_api//core/v1:core",
        "@io_k8s_apimachinery//pkg/api/errors",
        "@io_k8s_apimachinery//pkg/api/meta",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_apimachinery//pkg/fields",
        "@io_k8s_apimachinery//pkg/types",
        "@io_k8s_apimachinery//pkg/watch",
        "@io_k8s_sigs_controller_runtime//pkg/client",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/emptypb",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

go_test(
    name = "environments_test",
    srcs = [
        "service_test.go",
        "watch_test.go",
    ],
    embed = [":environments"],
    deps = [
        ":environment_service_go_proto",
        "//agentplane/proto:environment_lifecycle_go_proto",
        "//agentplane/sandboxes/api",
        "//agentplane/sandboxes/lifecycle",
        "//agentplane/sandboxes/runtimeconfig",
        "//agentplane/testing/grpcmethods",
        "//agentplane/testing/kubeapiserver",
        "//agentplane/workload_auth/auth",
        "@io_k8s_api//authentication/v1:authentication",
        "@io_k8s_api//core/v1:core",
        "@io_k8s_apimachinery//pkg/api/errors",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_apimachinery//pkg/runtime",
        "@io_k8s_apimachinery//pkg/types",
        "@io_k8s_apimachinery//pkg/watch",
        "@io_k8s_sigs_controller_runtime//pkg/client",
        "@io_k8s_sigs_controller_runtime//pkg/client/fake",
        "@io_k8s_sigs_controller_runtime//pkg/client/interceptor",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//metadata",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//proto",
    ],
)
