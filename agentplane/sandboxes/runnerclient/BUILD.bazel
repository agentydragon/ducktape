load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//devinfra/go:defs.bzl", "go_test")

go_library(
    name = "runnerclient",
    srcs = ["client.go"],
    importpath = "github.com/agentydragon/ducktape/agentplane/sandboxes/runnerclient",
    visibility = ["//agentplane:__subpackages__"],
    deps = [
        "//agentplane/grpc/bearer",
        "//agentplane/runner:runner_service_go_proto",
        "//agentplane/sandboxes/api",
        "@org_golang_google_grpc//metadata",
    ],
)

go_test(
    name = "runnerclient_test",
    srcs = ["client_test.go"],
    embed = [":runnerclient"],
    deps = [
        "//agentplane/proto:runner_go_proto",
        "//agentplane/runner:runner_service_go_proto",
        "//agentplane/sandboxes/api",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//metadata",
    ],
)
