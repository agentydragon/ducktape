load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("@io_bazel_rules_go//proto:def.bzl", "go_proto_library")
load("@protobuf//bazel:proto_library.bzl", "proto_library")

package(default_visibility = ["//agentplane:__subpackages__"])

proto_library(
    name = "environment_discovery_proto",
    srcs = ["environment_discovery.proto"],
    deps = [
        "@googleapis//google/api:annotations_proto",
        "@protobuf//:timestamp_proto",
    ],
)

go_proto_library(
    name = "environment_discovery_go_proto",
    compilers = [
        "@io_bazel_rules_go//proto:go_proto",
        "@io_bazel_rules_go//proto:go_grpc_v2",
        "//devinfra/go:grpc_gateway",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/sandboxes/discovery/discoverypb",
    proto = ":environment_discovery_proto",
    deps = [
        "@org_golang_google_genproto_googleapis_api//annotations",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

go_library(
    name = "discovery",
    srcs = ["service.go"],
    importpath = "github.com/agentydragon/ducktape/agentplane/sandboxes/discovery",
    deps = [
        ":environment_discovery_go_proto",
        "//agentplane/sandboxes/api",
        "//agentplane/sandboxes/runtimeconfig",
        "//agentplane/sandboxes/sandboxreader",
        "//agentplane/workload_auth/auth",
        "@io_k8s_apimachinery//pkg/api/meta",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_apimachinery//pkg/types",
        "@io_k8s_sigs_controller_runtime//pkg/client",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)
