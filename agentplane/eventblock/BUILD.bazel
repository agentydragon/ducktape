load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")
load("//devinfra/python:defs.bzl", "py_library")

go_library(
    name = "eventblock",
    srcs = ["block.go"],
    importpath = "github.com/agentydragon/ducktape/agentplane/eventblock",
    visibility = ["//agentplane:__subpackages__"],
    deps = ["@com_github_klauspost_compress//zstd"],
)

go_test(
    name = "eventblock_test",
    srcs = ["block_test.go"],
    embed = [":eventblock"],
)

py_library(
    name = "settings",
    srcs = ["settings.py"],
    visibility = [
        "//agentplane:__subpackages__",
        "//cluster/cdk8s/agentplane:__pkg__",
    ],
    deps = ["@pypi//pydantic"],
)
