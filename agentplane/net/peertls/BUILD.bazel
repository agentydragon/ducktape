load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")
load("//devinfra/python:defs.bzl", "py_binary", "py_library")

package(default_visibility = ["//agentplane:__subpackages__"])

go_library(
    name = "peertls",
    srcs = [
        "client_tls.go",
        "credentials.go",
        "expiry_credentials.go",
        "http_expiry.go",
        "http_server_expiry.go",
        "open.go",
        "security.go",
        "service_uris_generated.go",  # keep
        "workload_source.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/net/peertls",
    deps = [
        "//agentplane/identity/credentials/workloadid",
        "@com_github_spiffe_go_spiffe_v2//bundle/x509bundle",
        "@com_github_spiffe_go_spiffe_v2//spiffeid",
        "@com_github_spiffe_go_spiffe_v2//spiffetls/tlsconfig",
        "@com_github_spiffe_go_spiffe_v2//svid/x509svid",
        "@com_github_spiffe_go_spiffe_v2//workloadapi",
        "@org_golang_google_grpc//credentials",
        "@org_golang_google_grpc//credentials/insecure",
        "@org_golang_google_grpc//peer",
    ],
)

go_test(
    name = "peertls_test",
    srcs = [
        "client_tls_test.go",
        "credentials_test.go",
        "http_expiry_test.go",
        "http_server_expiry_test.go",
        "security_test.go",
        "workload_test.go",
    ],
    embed = [":peertls"],
    race = "on",
    deps = [
        "//agentplane/identity/credentials/workloadid",
        "//agentplane/net/peertls/testing",
        "//agentplane/testing/eventually",
        "@com_github_spiffe_go_spiffe_v2//proto/spiffe/workload",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//credentials",
        "@org_golang_google_grpc//health",
        "@org_golang_google_grpc//health/grpc_health_v1",
        "@org_golang_google_grpc//metadata",
        "@org_golang_google_grpc//peer",
        "@org_golang_google_grpc//status",
    ],
)

py_library(
    name = "config",
    srcs = ["config.py"],
    visibility = [
        "//agentplane:__subpackages__",
        "//cluster/cdk8s/agentplane:__pkg__",
    ],
    deps = [
        ":service_uris",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "service_uris",
    srcs = ["service_uris.py"],
)

py_library(
    name = "generate_service_uris",
    srcs = ["generate_service_uris.py"],
    deps = [":service_uris"],
)

py_binary(
    name = "generate_service_uris_bin",
    main_module = "agentplane.net.peertls.generate_service_uris",
    deps = [":generate_service_uris"],
)

genrule(
    name = "go_service_uris",
    outs = ["service_uris_generated.go"],
    cmd = "$(execpath :generate_service_uris_bin) > $@",
    tools = [":generate_service_uris_bin"],
)
