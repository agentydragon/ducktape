    visibility = ["//agentplane:__subpackages__"],
    deps = [
        "//agentplane/grpc/streaming",
        "//agentplane/identity/auth/auth",
        "//agentplane/identity/credentials/api/v1alpha1",
        "//agentplane/policy/api/v1alpha1",
        "//agentplane/policy/api/v1alpha1:policy_types_go_proto",
        "//agentplane/policy/v1:policy_service_go_proto",
        "//agentplane/proto:identity_go_proto",
        "//agentplane/proto:kubernetes_go_proto",
        "//agentplane/sandboxes/api",
        "//agentplane/sandboxes/sandboxreader",
        "@io_k8s_apimachinery//pkg/api/errors",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_apimachinery//pkg/types",
        "@io_k8s_apimachinery//pkg/util/sets",
        "@io_k8s_apimachinery//pkg/util/validation",
        "@io_k8s_apimachinery//pkg/watch",
        "@io_k8s_sigs_controller_runtime//pkg/client",
        "@org_golang_google_genproto_googleapis_rpc//errdetails",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/emptypb",
    ],
)

go_test(
