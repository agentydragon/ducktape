load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//devinfra/python:defs.bzl", "py_library")

go_library(
    name = "policy_controller",
    srcs = [
        "controller.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/policy_controller",
    visibility = [
        "//agentplane/policy_controller:__subpackages__",
        # The Sandbox Controller writes each Sandbox's PolicyBinding.
        "//agentplane/sandbox_controller:__subpackages__",
    ],
    deps = [
        "//agentplane/policy/api/v1alpha1",
        "//agentplane/policy/client:applyconfiguration_api",
        "//agentplane/policy/client/apply",
        "@io_k8s_api//core/v1:core",
        "@io_k8s_api//rbac/v1:rbac",
        "@io_k8s_apimachinery//pkg/api/errors",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_apimachinery//pkg/apis/meta/v1/unstructured",
        "@io_k8s_apimachinery//pkg/runtime",
        "@io_k8s_apimachinery//pkg/types",
        "@io_k8s_client_go//applyconfigurations/rbac/v1:rbac",
        "@io_k8s_sigs_controller_runtime//:controller-runtime",
        "@io_k8s_sigs_controller_runtime//pkg/client",
        "@io_k8s_sigs_controller_runtime//pkg/handler",
        "@io_k8s_sigs_controller_runtime//pkg/reconcile",
    ],
)

go_test(
    name = "policy_controller_test",
    srcs = [
        "controller_envtest_test.go",
        "controller_test.go",
    ],
    embed = [":policy_controller"],
    deps = [
        "//agentplane/policy/api/v1alpha1",
        "//agentplane/testing/kubeapiserver",
        "@io_k8s_api//core/v1:core",
        "@io_k8s_api//rbac/v1:rbac",
        "@io_k8s_apimachinery//pkg/api/errors",
        "@io_k8s_apimachinery//pkg/api/meta",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_apimachinery//pkg/labels",
        "@io_k8s_apimachinery//pkg/runtime",
        "@io_k8s_apimachinery//pkg/runtime/schema",
        "@io_k8s_client_go//kubernetes/scheme",
        "@io_k8s_sigs_controller_runtime//:controller-runtime",
        "@io_k8s_sigs_controller_runtime//pkg/cache",
        "@io_k8s_sigs_controller_runtime//pkg/client",
        "@io_k8s_sigs_controller_runtime//pkg/client/fake",
        "@io_k8s_sigs_controller_runtime//pkg/metrics/server",
        "@io_k8s_sigs_controller_runtime//pkg/reconcile",
        "@io_k8s_sigs_controller_runtime//pkg/webhook",
    ],
)

pkg_tar(
    name = "binary_layer",
    srcs = ["//agentplane/policy_controller/cmd:policy-controller"],
    package_dir = "/usr/local/bin",
)

# Talks only to the API server, through the in-cluster ServiceAccount CA, so it needs no system
# CA bundle.
oci_image(
    name = "image",
    base = "@distroless_static_debian13_linux_amd64",
    entrypoint = ["/usr/local/bin/policy-controller"],
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [":binary_layer"],
    user = "1000:1000",
    visibility = ["//visibility:public"],
    workdir = "/",
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["agentplane-policy-controller:latest"],
)

py_library(
    name = "settings",
    srcs = ["settings.py"],
    visibility = ["//cluster/cdk8s/agentplane:__pkg__"],
    deps = [
        "@pypi//pydantic",
        "@pypi//pydantic_settings",
    ],
)
