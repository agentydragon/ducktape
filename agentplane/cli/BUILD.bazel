load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "cli",
    srcs = [
        "actions.go",
        "app.go",
        "client.go",
        "egress.go",
        "errors.go",
        "gateway.go",
        "main.go",
        "notifications.go",
        "output.go",
        "paging.go",
        "text.go",
        "wait.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/cli",
    visibility = ["//visibility:private"],
    deps = [
        "//agentplane/action_service:action_service_go_proto",
        "//agentplane/notification_service:notifications_go_proto",
        "@com_github_google_uuid//:uuid",
        "@com_github_sethvargo_go_retry//:go-retry",
        "@com_github_spf13_cobra//:cobra",
        "@org_golang_google_genproto_googleapis_rpc//code",
        "@org_golang_google_genproto_googleapis_rpc//errdetails",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//credentials",
        "@org_golang_google_grpc//credentials/insecure",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/structpb",
    ],
)

go_binary(
    name = "agentplane",
    embed = [":cli"],
    pure = "on",
    visibility = ["//visibility:public"],
)

copy_file(
    name = "cli_release",
    src = ":agentplane",
    out = "agentplane-cli",
    is_executable = True,
)

go_test(
    name = "cli_test",
    size = "small",
    srcs = [
        "actions_test.go",
        "egress_test.go",
        "errors_test.go",
        "helpers_test.go",
        "notifications_test.go",
        "submit_test.go",
        "wait_test.go",
    ],
    embed = [":cli"],
    deps = [
        "//agentplane/action_service:action_service_go_proto",
        "//agentplane/grpc/facade",
        "//agentplane/notification_service:notifications_go_proto",
        "@org_golang_google_genproto_googleapis_rpc//errdetails",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//metadata",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/durationpb",
        "@org_golang_google_protobuf//types/known/structpb",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)
