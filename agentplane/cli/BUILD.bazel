load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "cli",
    srcs = [
        "app.go",
        "egress.go",
        "egress_text.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/cli",
    visibility = ["//agentplane/cli:__subpackages__"],
    deps = [
        "//agentplane/cli/internal/actions",
        "//agentplane/cli/internal/environments",
        "//agentplane/cli/internal/history",
        "//agentplane/cli/internal/invocation",
        "//agentplane/cli/internal/notifications",
        "//agentplane/cli/internal/session_dispatcher",
