    size = "small",
    srcs = [
        "actions_guide_test.go",
        "actions_test.go",
        "egress_test.go",
        "environments_test.go",
        "errors_test.go",
        "helpers_test.go",
        "history_test.go",
        "notifications_test.go",
        "session_dispatcher_test.go",
        "submit_test.go",
        "wait_test.go",
    ],
    embed = [":cli"],
    deps = [
        "//agentplane/action_service/api/contracts:action_service_go_proto",
        "//agentplane/cli/internal/invocation",
        "//agentplane/egress/api/rules:egress_rules_go_proto",
        "//agentplane/environments/v1:environment_service_go_proto",
        "//agentplane/history_service/api/history:history_service_go_proto",
        "//agentplane/notification_service/api/notifications:notifications_go_proto",
        "//agentplane/proto:environment_lifecycle_go_proto",
        "//agentplane/proto:session_go_proto",
        "//agentplane/session_dispatcher/dispatcher/api/session:session_dispatcher_go_proto",
        "//agentplane/testing/grpcserver",
        "@org_golang_google_genproto_googleapis_rpc//code",
        "@org_golang_google_genproto_googleapis_rpc//errdetails",
        "@org_golang_google_genproto_googleapis_rpc//status",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//metadata",
        "@org_golang_google_grpc//status",
