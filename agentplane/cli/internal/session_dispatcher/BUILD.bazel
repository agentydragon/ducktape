load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "session_dispatcher",
    srcs = [
        "doc.go",
        "session_dispatcher.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/cli/internal/session_dispatcher",
    visibility = ["//agentplane/cli:__subpackages__"],
    deps = [
        "//agentplane/cli/internal/invocation",
        "//agentplane/proto:session_go_proto",
        "//agentplane/proto/sessionplacement",
        "//agentplane/session_dispatcher/dispatcher/api/session:session_dispatcher_go_proto",
        "//agentplane/session_dispatcher/dispatcher/api/session/dispatchstate",
        "@com_github_google_uuid//:uuid",
        "@com_github_spf13_cobra//:cobra",
        "@org_golang_google_protobuf//encoding/protojson",
    ],
)

go_test(
    name = "session_dispatcher_test",
    size = "small",
    srcs = [
        "text_test.go",
    ],
    embed = [":session_dispatcher"],
    deps = [
        "//agentplane/proto:session_go_proto",
        "//agentplane/session_dispatcher/dispatcher/api/session:session_dispatcher_go_proto",
    ],
