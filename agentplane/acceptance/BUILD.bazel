# The probe runs real model turns against a deployment; the other cases run scripted on k3s.
# `eternal` for the suite's own bounds, not a warm run's ~120 s: each Sandbox may wait
# SANDBOX_READY_SECONDS for its Pod and each turn TURN_SECONDS, so a cold run is most of an hour.
acceptance_test(
    name = "test_egress",
    timeout = "eternal",
    srcs = ["test_egress.py"],
    k3s = "scripted",
    deps = [
        ":agent",
        ":conftest",
        ":runtime_grant",
        ":scripted_upstream",
        "//:conftest",  # keep: macro rule — gazelle does not manage the conftest chain here
        "//agentplane:crd_group",
        "//agentplane:sandbox_resource",
        "//agentplane/app:sandbox_models",
        "//agentplane/app/testing:client",
        "//agentplane/egress:decisions",
        "//agentplane/proto:runner_pb2",
        "//agentplane/testing:scripted_model",
        "@pypi//protobuf",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//tenacity",
    ],
)

