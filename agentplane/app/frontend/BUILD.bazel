# gazelle:exclude test_visual_actions.py
# gazelle:exclude test_visual_notifications.py
# gazelle:exclude test_visual_disclosures.py
# gazelle:exclude test_visual_history.py
# gazelle:exclude test_visual_identities.py
# gazelle:exclude test_visual_environment_identity.py
# gazelle:exclude test_visual_history_layout.py
# gazelle:exclude test_visual_policies.py
# gazelle:exclude test_visual_dock.py
# gazelle:exclude test_visual_navigation.py
# gazelle:exclude test_visual_scenes.py
# gazelle:exclude test_visual_operation_presentation.py
load("@aspect_rules_esbuild//esbuild:defs.bzl", "esbuild")
load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config")
load("//devinfra/js:openapi_js_library.bzl", "openapi_js_library")
load("//devinfra/js:spa_bundle.bzl", "spa_bundle")
load("//devinfra/js:ts_library.bzl", "ts_library")
load("//devinfra/js:typed_eslint.bzl", "typed_eslint_test")
load("//devinfra/js:vitest.bzl", "check_vitest_specs", "vitest_config")
load(":visual_tests.bzl", "agentplane_visual_test")
load(":vitest.bzl", "agentplane_vitest_test")

package(default_visibility = ["//agentplane/app:__subpackages__"])

TSCONFIG = ":tsconfig"

filegroup(
    name = "typed_lint_srcs",
    testonly = True,
    srcs = glob(
        [
            "*.ts",
            "*.tsx",
            "**/*.ts",
            "**/*.tsx",
        ],
        allow_empty = True,
    ) + [
        "//agentplane/app/frontend/actions:typed_lint_srcs",
        "//agentplane/app/frontend/actions/mcp:typed_lint_srcs",
        "//agentplane/app/frontend/actions/push:typed_lint_srcs",
        "//agentplane/app/frontend/actions/push/service_worker:typed_lint_srcs",
        "//agentplane/app/frontend/actions/rendering:typed_lint_srcs",
        "//agentplane/app/frontend/actions/testing:typed_lint_srcs",
        "//agentplane/app/frontend/app_config:typed_lint_srcs",
        "//agentplane/app/frontend/connections:typed_lint_srcs",
        "//agentplane/app/frontend/connections/testing:typed_lint_srcs",
        "//agentplane/app/frontend/egress:typed_lint_srcs",
        "//agentplane/app/frontend/identities:typed_lint_srcs",
        "//agentplane/app/frontend/notifications:typed_lint_srcs",
        "//agentplane/app/frontend/observability:typed_lint_srcs",
        "//agentplane/app/frontend/policy:typed_lint_srcs",
        "//agentplane/app/frontend/sandboxes:typed_lint_srcs",
        "//agentplane/app/frontend/sessions:typed_lint_srcs",
        "//agentplane/app/frontend/sessions/testing:typed_lint_srcs",
        "//agentplane/app/frontend/shell:typed_lint_srcs",
        "//agentplane/app/frontend/system:typed_lint_srcs",
        "//agentplane/app/frontend/testing:typed_lint_srcs",
        "//agentplane/app/frontend/transport:typed_lint_srcs",
        "//agentplane/app/frontend/ui:typed_lint_srcs",
    ],
)

filegroup(
    name = "typed_lint_program_data",
    srcs = [
        ":schema",
        "//:node_modules/@bufbuild/protobuf",
        "//:node_modules/@electric-sql/client",
        "//:node_modules/@mantine/core",
        "//:node_modules/@mantine/hooks",
        "//:node_modules/@opentelemetry/api",
        "//:node_modules/@opentelemetry/context-zone",
        "//:node_modules/@opentelemetry/core",
        "//:node_modules/@opentelemetry/exporter-trace-otlp-proto",
        "//:node_modules/@opentelemetry/instrumentation",
        "//:node_modules/@opentelemetry/instrumentation-fetch",
        "//:node_modules/@opentelemetry/resources",
        "//:node_modules/@opentelemetry/sdk-trace-web",
        "//:node_modules/@tabler/icons-react",
        "//:node_modules/@types/node",
        "//:node_modules/date-fns",
        "//:node_modules/happy-dom",
        "//:node_modules/openapi-fetch",
        "//:node_modules/react-router",
        "//:node_modules/yaml",
        "//:node_modules/zod",
        "//agentplane/action_service/api/contracts:action_service_pb",
        "//agentplane/action_service/api/contracts:operator_action_service_pb",
        "//agentplane/action_service/api/web_push:web_push_service_pb",
        "//agentplane/app:app_service_pb",
        "//agentplane/environments/v1:environment_service_pb",
        "//agentplane/harness_host:harness_host_pb",
        "//agentplane/history_service/api/history:history_service_pb",
        "//agentplane/mcp_edge/api/connection:connection_service_pb",
        "//agentplane/policy/api/v1alpha1:policy_types_pb",
        "//agentplane/policy/v1:policy_service_pb",
        "//agentplane/proto:command_pb",
        "//agentplane/proto:event_log_pb",
        "//agentplane/proto:event_pb",
        "//agentplane/proto:kubernetes_pb",
        "//agentplane/proto:session_pb",
    ],
)

typed_eslint_test(
    name = "eslint_typed_test",
    srcs = ":typed_lint_srcs",
    config = "eslint.typed.config.js",
    extra_data = [
        "//agentplane/app/frontend/shell:app",
        ":typed_lint_program_data",
        "//agentplane/app/frontend/actions/push/service_worker:typed_lint_tsconfigs",
        "//util/frontend:typed_lint_program_data",
    ],
    source_data = [
        "//agentplane/app/frontend/ui:brand_icon_data.ts",
        "//util/frontend:typed_lint_srcs",
    ],
    tsconfig = "tsconfig.json",
)

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
)

# Generated Zod modules infer their exported types from the generated schemas; declaration emit
# needs whole-program inference rather than isolatedDeclarations' authored-type annotations.
ts_config(
    name = "tsconfig_generated",
    src = "tsconfig.generated.json",
    deps = [":tsconfig"],
)

# TypeScript types from the app's OpenAPI document: the inventory's models and routes. The bridge's
# proto-JSON bodies are plain objects there; the runner's shared protocol types them.
openapi_js_library(
    name = "schema",
    schema = "//agentplane/app:openapi_schema",
)

ts_library(
    name = "settings",
    srcs = ["settings/dialog.tsx"],
    tsconfig = TSCONFIG,
    deps = [
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//agentplane/app/frontend/actions/mcp:mcp_servers",
        "//agentplane/app/frontend/actions/push",
        "//agentplane/app/frontend/connections:management",
    ],
)

ts_library(
    name = "main_lib",
    srcs = ["main.tsx"],
    tsconfig = TSCONFIG,
    deps = [
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/@types/react-dom",
        "//:node_modules/react",
        "//:node_modules/react-dom",
        "//agentplane/app/frontend/observability:tracing",
        "//agentplane/app/frontend/shell:app",
        "//agentplane/app/frontend/shell:theme",
        "//agentplane/app/frontend/transport:operator_login",
    ],
)

# The served directory: index.html beside main.js and main.css, mounted by the app.
spa_bundle(
    name = "bundle",
    entry_point = "main.js",
    jsx = "automatic",
    public = glob(["public/**/*"]),
    deps = [":main_lib"],
)

vitest_config(
    name = "vitest_config",
    # Specs that need a DOM select a suite-specific environment.
    data = [
        "//:node_modules/happy-dom",
        "//util/frontend:test_setup",
    ],
    environment = "node",
    setup_files = ["//util/frontend:test_setup.js"],
)

# Python visual tests mount the app against canned inventory and runner events.
# Python calls fixture builders and mounts explicitly; JSON files contain recorded event rows only.
js_library(
    name = "visual_rollouts",
    testonly = True,
    srcs = [
        "harness/realistic_rollout.json",
        "harness/reported_rollout.json",
    ],
)

ts_library(
    name = "visual_harness_lib",
    testonly = True,
    srcs = [
        "harness/action_presentations_visual.tsx",
        "harness/disclosure_visual.tsx",
        "harness/harness.tsx",
        "harness/operation_presentation_visual.tsx",
    ],
    tsconfig = TSCONFIG,
    deps = [
        ":harness_network",
        ":schema",
        ":visual_rollouts",
        "//:node_modules/@bufbuild/protobuf",
        "//:node_modules/@mantine/core",
        "//:node_modules/@tanstack/react-query",
        "//:node_modules/@types/react",
        "//:node_modules/@types/react-dom",
        "//:node_modules/react",
        "//:node_modules/react-dom",
        "//:node_modules/react-router",
        "//agentplane/action_service/api/contracts:action_service_pb",
        "//agentplane/action_service/api/contracts:operator_action_service_pb",
        "//agentplane/app:app_service_pb",
        "//agentplane/app/frontend/actions:action_client",
        "//agentplane/app/frontend/actions:history",
        "//agentplane/app/frontend/actions:requests",
        "//agentplane/app/frontend/actions:sidebar",
        "//agentplane/app/frontend/actions/rendering:index",
        "//agentplane/app/frontend/actions/testing:proto_fixtures",
        "//agentplane/app/frontend/connections/testing:fixture",
        "//agentplane/app/frontend/egress:decision_fixture",
        "//agentplane/app/frontend/sandboxes:client",
        "//agentplane/app/frontend/sandboxes:live",
        "//agentplane/app/frontend/sessions:client",
        "//agentplane/app/frontend/sessions:live",
        "//agentplane/app/frontend/sessions:local_commands",
        "//agentplane/app/frontend/sessions/testing:electric_entity",
        "//agentplane/app/frontend/sessions/testing:model_catalog",
        "//agentplane/app/frontend/shell:app",
        "//agentplane/app/frontend/shell:theme",
        "//agentplane/app/frontend/testing:runtime_diagnostics",
        "//agentplane/app/frontend/testing:sandbox",
        "//agentplane/app/frontend/transport:client",
        "//agentplane/app/frontend/transport:live",
        "//agentplane/app/frontend/transport:query",
        "//agentplane/app/frontend/transport:stream_status",
        "//agentplane/app/frontend/ui:shell_command_view",
        "//agentplane/app/frontend/ui:text_block",
        "//agentplane/egress/api/admin:egress_admin_pb",
        "//agentplane/environments/v1:environment_service_pb",
        "//agentplane/history_service/api/history:history_service_pb",
        "//agentplane/mcp_edge/api/connection:connection_service_pb",
        "//agentplane/notification_service/api/notifications:notifications_pb",
        "//agentplane/policy/api/v1alpha1:policy_types_pb",
        "//agentplane/policy/v1:policy_service_pb",
        "//agentplane/proto:command_pb",
        "//agentplane/proto:environment_lifecycle_pb",
        "//agentplane/proto:event_log_pb",
        "//agentplane/proto:event_pb",
        "//agentplane/proto:identity_pb",
        "//agentplane/proto:kubernetes_pb",
        "//agentplane/proto:session_pb",
        "//util/frontend:clamped_block",
        "//util/frontend:disclosure",
        "//util/frontend/transcript:history_sizes",
    ],
)

# A classic script (iife) so harness/index.html loads it from file:// without module CORS.
esbuild(
    name = "visual_bundle",
    testonly = True,
    config = {"jsx": "automatic"},
    entry_point = "harness/harness.js",
    format = "iife",
    minify = False,
    output = "harness/bundle.js",
    output_css = "harness/bundle.css",
    platform = "browser",
    sourcemap = "linked",
    target = ["es2022"],
    deps = [":visual_harness_lib"],
)

# Single-file views so $(rootpath) resolves to one path each.
filegroup(
    name = "visual_bundle_js",
    testonly = True,
    srcs = ["harness/bundle.js"],
)

filegroup(
    name = "visual_bundle_css",
    testonly = True,
    srcs = ["harness/bundle.css"],
)

agentplane_visual_test(
    name = "visual_scenes",
    src = "test_visual_scenes.py",
    shard_count = 2,
    title = "Agentplane: mounted views",
)

agentplane_visual_test(
    name = "visual_disclosures",
    src = "test_visual_disclosures.py",
    title = "Agentplane: disclosures",
)

agentplane_visual_test(
    name = "visual_notifications",
    src = "test_visual_notifications.py",
    title = "Agentplane: notification diagnostics",
)

agentplane_visual_test(
    name = "visual_history",
    src = "test_visual_history.py",
    shard_count = 4,
    title = "Agentplane: history",
)

agentplane_visual_test(
    name = "visual_history_layout",
    src = "test_visual_history_layout.py",
    shard_count = 2,
    test_deps = ["//agentplane/app/frontend/testing:history_interactions"],
    title = "Agentplane: history layout",
)

agentplane_visual_test(
    name = "visual_identities",
    src = "test_visual_identities.py",
    title = "Agentplane: identities",
)

agentplane_visual_test(
    name = "visual_dock",
    src = "test_visual_dock.py",
    title = "Agentplane: dockable workspace",
)

agentplane_visual_test(
    name = "visual_environment_identity",
    src = "test_visual_environment_identity.py",
    title = "Agentplane: environment identity",
)

agentplane_visual_test(
    name = "visual_navigation",
    src = "test_visual_navigation.py",
    title = "Agentplane: navigation",
)

agentplane_visual_test(
    name = "visual_policies",
    src = "test_visual_policies.py",
    shard_count = 4,
    title = "Agentplane: policies",
)

agentplane_visual_test(
    name = "visual_operation_presentation",
    src = "test_visual_operation_presentation.py",
    title = "Agentplane: shared Action presentation",
)

ts_library(
    name = "harness_network",
    srcs = ["harness/network.ts"],
    tsconfig = TSCONFIG,
)

agentplane_vitest_test(
    name = "harness_network_test",
    srcs = ["harness/network.test.ts"],
    deps = [
        ":harness_network",
        "//:node_modules/vitest",
    ],
)

check_vitest_specs()

agentplane_visual_test(
    name = "visual_actions",
    src = "test_visual_actions.py",
    shard_count = 16,
    title = "Agentplane: action presentations",
)
