filegroup(
    name = "visual_bundle_js",
    testonly = True,
    srcs = ["visual/bundle.js"],
)

filegroup(
    name = "visual_bundle_css",
    testonly = True,
    srcs = ["visual/bundle.css"],
)

# Every scenario in visual/scenarios.ts, swept on one browser per shard -- `shard_count` buys the
# parallelism per-scenario targets used to give, without BUILD repeating the scenario list. Run one
# with `--test_filter=<scenario>`; see AGENTS.md.
#
# medium: a shard renders 4-5 scenarios on one Chromium, measured at 10-16s per shard
# (invocation 4493681a-c750-49ba-af99-d756df6e956e) -- against 30-40s for a single scenario when
# each one paid its own browser launch and input staging.
visual_test(
    name = "visual",
    size = "medium",
    assets = [
        "visual/index.html",
        ":visual_bundle_css",
    ],
    entry_point = "visual/runner.mjs",
    harness = ":visual_bundle_js",
    scenarios = ":visual_scenarios",
    shard_count = 6,
)

js_test(
    name = "sw_test",
    size = "small",
    data = [":service_worker"],
    entry_point = "sw_test.mjs",
    env = {"SW_SOURCE": "$(rootpath :service_worker)"},
)

