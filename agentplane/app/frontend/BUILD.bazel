        "//:node_modules/@opentelemetry/instrumentation-fetch",
        "//:node_modules/@opentelemetry/resources",
        "//:node_modules/@opentelemetry/sdk-trace-web",
        "//:node_modules/@tabler/icons-react",
        "//:node_modules/@tanstack/react-virtual",
        "//:node_modules/@types/node",
        "//:node_modules/date-fns",
        "//:node_modules/happy-dom",
        "//:node_modules/openapi-fetch",
        "//:node_modules/react-router",
        "//:node_modules/yaml",
        "//:node_modules/zod",
        "//agentplane/action_service:action_service_pb",
        "//agentplane/action_service:operator_action_service_pb",
        "//agentplane/action_service:web_push_service_pb",
        "//agentplane/mcp_edge:connection_service_pb",
