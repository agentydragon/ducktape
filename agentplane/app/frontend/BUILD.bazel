TSCONFIG = ":tsconfig"

filegroup(
    name = "typed_lint_srcs",
    srcs = glob(
        [
            "*.ts",
            "*.tsx",
            "**/*.ts",
            "**/*.tsx",
        ],
        allow_empty = True,
    ) + [
        "//agentplane/app/frontend/actions:typed_lint_srcs",
        "//agentplane/app/frontend/actions/rendering:typed_lint_srcs",
        "//agentplane/app/frontend/connections:typed_lint_srcs",
        "//agentplane/app/frontend/sandboxes:typed_lint_srcs",
        "//agentplane/app/frontend/service_worker:typed_lint_srcs",
        "//agentplane/app/frontend/threads:typed_lint_srcs",
    ],
)

filegroup(
    name = "typed_lint_program_data",
    srcs = [
        ":schema",
        "//:node_modules/@bufbuild/protobuf",
        "//:node_modules/@electric-sql/client",
        "//:node_modules/@mantine/core",
        "//:node_modules/@mantine/hooks",
        "//:node_modules/@opentelemetry/api",
        "//:node_modules/@opentelemetry/context-zone",
        "//:node_modules/@opentelemetry/core",
        "//:node_modules/@opentelemetry/exporter-trace-otlp-proto",
