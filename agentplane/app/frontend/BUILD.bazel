TSCONFIG = ":tsconfig"

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
)

# Generated Zod modules infer their exported types from the generated schemas; declaration emit
# needs whole-program inference rather than isolatedDeclarations' authored-type annotations.
ts_config(
    name = "tsconfig_generated",
    src = "tsconfig.generated.json",
    deps = [":tsconfig"],
)

# TypeScript types from the app's OpenAPI document: the inventory's models and routes. The bridge's
# proto-JSON bodies are plain objects there; the runner's shared protocol types them.
js_openapi_schema(
    name = "schema",
    generator = "//agentplane/app:export_schema_bin",
)

# Generate the SSH argument/result validators from the schema FastMCP builds from the server's
# registered tool signature and return type.
js_openapi_zod(
    name = "ssh_action_schemas_generated",
    out = "actions/schemas/ssh/exec.zod.ts",
    generator = "//x/ssh_mcp_server:export_frontend_schema_bin",
    tsconfig = ":tsconfig_generated",
)

ts_library(
    name = "ssh_action_schemas",
    srcs = ["actions/schemas/ssh/exec.ts"],
    tsconfig = TSCONFIG,
    deps = [":ssh_action_schemas_generated"],
)

