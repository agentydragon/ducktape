typed_eslint_test(
    name = "eslint_typed_test",
    srcs = ":typed_lint_srcs",
    config = "eslint.typed.config.js",
    extra_data = [
        ":app",
        ":typed_lint_program_data",
        "//agentplane/app/frontend/service_worker:typed_lint_tsconfigs",
        "//util/frontend:typed_lint_program_data",
    ],
    source_data = ["//util/frontend:typed_lint_srcs"],
    tsconfig = "tsconfig.json",
)

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
)

# Generated Zod modules infer their exported types from the generated schemas; declaration emit
# needs whole-program inference rather than isolatedDeclarations' authored-type annotations.
ts_config(
    name = "tsconfig_generated",
    src = "tsconfig.generated.json",
    deps = [":tsconfig"],
)

# TypeScript types from the app's OpenAPI document: the inventory's models and routes. The bridge's
# proto-JSON bodies are plain objects there; the runner's shared protocol types them.
js_openapi_schema(
    name = "schema",
    generator = "//agentplane/app:export_schema_bin",
)

# Runtime validators for the app-owned SSE snapshots and health frames. Keep the generated module
# on the generated tsconfig: hey-api infers schema output types instead of annotating them.
js_openapi_zod(
    name = "live_schemas_generated",
    out = "api/live_schema.zod.ts",
    config = "openapi-ts.config.mjs",
    generator = "//agentplane/app:export_schema_bin",
    tsconfig = ":tsconfig_generated",
)

