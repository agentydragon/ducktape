load("//devinfra/js:ts_library.bzl", "ts_library")
load("//devinfra/python:defs.bzl", "py_library")

package(
    default_testonly = True,
    default_visibility = ["//agentplane/app:__subpackages__"],
)

py_library(
    name = "visual_assertions",
    srcs = ["visual_assertions.py"],
    deps = [
        "//util/testing:page_capture",
        "//util/testing:undeclared_outputs",
        "//util/testing:visual_capture",
        "@pypi//playwright",
    ],
)

py_library(
    name = "visual_fixtures",
    srcs = ["visual_fixtures.py"],
    deps = [
        ":app",
        "//util/testing:viewports",
        "//util/testing:visual_capture",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",
    ],
)

TSCONFIG = "//agentplane/app/frontend:tsconfig"

ts_library(
    name = "model_catalog",
    srcs = ["model_catalog.ts"],
    tsconfig = TSCONFIG,
    deps = [
        "//agentplane/app/frontend:client",
        "//agentplane/app/frontend:model_catalog",
        "//agentplane/app/frontend:schema",
    ],
)

ts_library(
    name = "langfuse_search",
    srcs = ["langfuse_search.ts"],
    tsconfig = TSCONFIG,
    deps = [
        "//agentplane/app/frontend:client",
        "//agentplane/app/frontend:langfuse_search",
        "//agentplane/app/frontend:schema",
    ],
)

ts_library(
    name = "watch",
    srcs = ["watch.ts"],
    tsconfig = TSCONFIG,
    deps = ["//:node_modules/vitest"],
)

py_library(
    name = "app",
    srcs = ["app.py"],
    deps = ["@pypi//playwright"],
)

filegroup(
    name = "typed_lint_srcs",
    srcs = [
        "langfuse_search.ts",
        "model_catalog.ts",
        "watch.ts",
    ],
    visibility = ["//agentplane/app/frontend:__pkg__"],
)
