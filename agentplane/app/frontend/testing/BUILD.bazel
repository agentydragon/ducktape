load("//devinfra/js:ts_library.bzl", "ts_library")
load("//devinfra/python:defs.bzl", "py_library")

package(
    default_testonly = True,
    default_visibility = ["//agentplane/app:__subpackages__"],
)

py_library(
    name = "visual_assertions",
    srcs = ["visual_assertions.py"],
    deps = [
        "//util/testing/frontend_visual:capture",
        "//util/testing/frontend_visual:page_capture",
        "@pypi//playwright",
    ],
)

py_library(
    name = "visual_fixtures",
    srcs = ["visual_fixtures.py"],
    deps = [
        ":app",
        "//util/testing/frontend_visual:capture",
        "//util/testing/frontend_visual:viewports",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",
    ],
)

TSCONFIG = "//agentplane/app/frontend:tsconfig"

ts_library(
    name = "model_catalog",
    srcs = ["model_catalog.ts"],
    tsconfig = TSCONFIG,
    deps = [
        "//:node_modules/@bufbuild/protobuf",
        "//agentplane/app:app_service_pb",
        "//agentplane/proto:session_pb",
    ],
)

ts_library(
    name = "langfuse_search",
    srcs = ["langfuse_search.ts"],
    tsconfig = TSCONFIG,
    deps = [
        "//:node_modules/@bufbuild/protobuf",
        "//agentplane/app:app_service_pb",
    ],
)

ts_library(
    name = "watch",
    srcs = ["watch.ts"],
    tsconfig = TSCONFIG,
    deps = ["//:node_modules/vitest"],
)

ts_library(
    name = "sandbox",
    srcs = ["sandbox.ts"],
    tsconfig = TSCONFIG,
    deps = [
        "//:node_modules/@bufbuild/protobuf",
        "//agentplane/environments/v1:environment_service_pb",
    ],
)

ts_library(
    name = "runner_status",
    srcs = ["runner_status.ts"],
    tsconfig = TSCONFIG,
    deps = [
        "//:node_modules/@bufbuild/protobuf",
        "//agentplane/proto:session_pb",
    ],
)

py_library(
    name = "app",
    srcs = ["app.py"],
    deps = ["@pypi//playwright"],
)

filegroup(
    name = "typed_lint_srcs",
    srcs = [
        "langfuse_search.ts",
        "model_catalog.ts",
        "runner_status.ts",
        "sandbox.ts",
        "watch.ts",
    ],
    visibility = ["//agentplane/app/frontend:__pkg__"],
)

py_library(
    name = "history_interactions",
    srcs = ["history_interactions.py"],
    deps = [
        "//agentplane/app/testing:thread_view_marks",
        "@pypi//playwright",
    ],
)
