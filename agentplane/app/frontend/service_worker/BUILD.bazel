load("@aspect_rules_esbuild//esbuild:defs.bzl", "esbuild")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config")
load("//devinfra/js:ts_library.bzl", "ts_library")
load("//devinfra/js:vitest.bzl", "check_vitest_specs", "vitest_test")

package(default_visibility = ["//agentplane/app:__subpackages__"])

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    deps = ["//agentplane/app/frontend:tsconfig"],
)

ts_config(
    name = "tsconfig_test",
    src = "tsconfig.test.json",
    deps = ["//agentplane/app/frontend:tsconfig"],
)

ts_library(
    name = "service_worker_lib",
    srcs = ["sw.ts"],
    isolated_typecheck = True,
    tsconfig = ":tsconfig",
    deps = ["//agentplane/app/frontend:actions_types"],
)

# The worker URL stays /sw.js; keep the generated bundle separate from ts_library's sw.js output.
esbuild(
    name = "service_worker_bundle",
    entry_point = "sw.ts",
    format = "iife",
    output = "bundled/sw.js",
    platform = "browser",
    target = ["es2022"],
    deps = [":service_worker_lib"],
)

# The server and test consume only the JavaScript output; esbuild also emits a linked source map.
filegroup(
    name = "service_worker_js",
    srcs = ["bundled/sw.js"],
)

vitest_test(
    name = "sw_test",
    srcs = ["sw.test.ts"],
    config = "//agentplane/app/frontend:vitest_config",
    data = [":service_worker_js"],
    tsconfig = ":tsconfig_test",
    deps = [
        "//:node_modules/@types/node",
        "//:node_modules/vitest",
        "//agentplane/app/frontend:actions_types",
    ],
)

check_vitest_specs()
