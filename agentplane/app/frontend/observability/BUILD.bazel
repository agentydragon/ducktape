    name = "langfuse_search_test",
    srcs = ["langfuse_search.test.ts"],
    deps = [
        "//:node_modules/vitest",
        "//agentplane/app:app_service_pb",
        "//agentplane/app/frontend/observability:langfuse_search",
        "//agentplane/app/frontend/observability:langfuse_search_fixture",
    ],
)

ts_library(
    name = "langfuse_search_fixture",
    testonly = True,
    srcs = ["langfuse_search_fixture.ts"],
    tsconfig = "//agentplane/app/frontend:tsconfig",
    deps = [
        "//:node_modules/@bufbuild/protobuf",
        "//agentplane/app:app_service_pb",
    ],
)

check_vitest_specs()
