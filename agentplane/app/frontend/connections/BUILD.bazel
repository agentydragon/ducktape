load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@npm_ducktape//:vitest/package_json.bzl", vitest_bin = "bin")

package(default_visibility = ["//agentplane/app:__subpackages__"])

filegroup(
    name = "typed_lint_srcs",
    srcs = glob(
        [
            "*.ts",
            "*.tsx",
            "**/*.ts",
            "**/*.tsx",
        ],
        allow_empty = True,
    ),
    visibility = ["//agentplane/app/frontend:__pkg__"],
)

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    deps = ["//agentplane/app/frontend:tsconfig"],
)

ts_config(
    name = "tsconfig_test",
    testonly = True,
    src = "tsconfig.test.json",
    deps = [":tsconfig"],
)

js_library(
    name = "management_css",
    srcs = ["management.css"],
)

# Feature-level trial of direct rules_ts targets; other packages retain ts_library.
ts_project(
    name = "connections",
    srcs = glob(
        ["*.ts", "*.tsx"],
        exclude = ["*.test.tsx", "fixture.ts", "test_support.ts"],
    ),
    declaration = True,
    resolve_json_module = True,
    source_map = True,
    transpiler = "tsc",
    tsconfig = ":tsconfig",
    deps = [
        "//:node_modules/@bufbuild/protobuf",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//agentplane/action_service:action_service_pb",
        "//agentplane/app/frontend/actions:policy",
        "//agentplane/app/frontend/bindings:table",
        "//agentplane/app/frontend:client",
        "//agentplane/app/frontend/actions:action_client",
        "//agentplane/app/frontend:inline_name",
        "//agentplane/app/frontend:stream_reader",
        "//agentplane/app/frontend:schema",
        "//agentplane/app/frontend:time_ago",
        "//agentplane/app/frontend:watch_stream",
        "//agentplane/mcp_edge:connection_service_pb",
        "//agentplane/proto:sandboxes_pb",
        "//util/frontend:help_tooltip",
        ":management_css",
    ],
)

TEST_SRCS = glob(["*.test.tsx"])

ts_project(
    name = "testing",
    testonly = True,
    srcs = TEST_SRCS,
    declaration = True,
    resolve_json_module = True,
    source_map = True,
    transpiler = "tsc",
    tsconfig = ":tsconfig_test",
    deps = [
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/@types/react-dom",
        "//:node_modules/react",
        "//:node_modules/react-dom",
        "//:node_modules/react-router",
        "//:node_modules/vitest",
        "//agentplane/app/frontend/actions/testing:harness",
        ":connections",
        "//agentplane/app/frontend/connections/testing:fixture",
        "//agentplane/app/frontend/connections/testing:test_support",
    ],
)

[
    vitest_bin.vitest_test(
        name = spec.removesuffix(".test.tsx") + "_test",
        args = [
            "run",
            "--config",
            "vitest_config.mjs",
            "connections/" + spec.removesuffix(".tsx") + ".js",
        ],
        chdir = "agentplane/app/frontend",
        data = [
            ":testing",
            "//agentplane/app/frontend:vitest_config",
        ],
    )
    for spec in TEST_SRCS
]
