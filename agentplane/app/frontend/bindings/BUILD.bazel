load("//agentplane/app/frontend:vitest.bzl", "agentplane_vitest_test")
load("//devinfra/js:ts_library.bzl", "ts_library")
load("//devinfra/js:vitest.bzl", "check_vitest_specs")

package(default_visibility = ["//agentplane/app:__subpackages__"])

filegroup(
    name = "typed_lint_srcs",
    srcs = glob(
        [
            "*.ts",
            "*.tsx",
        ],
        allow_empty = True,
    ),
    visibility = ["//agentplane/app/frontend:__pkg__"],
)

TSCONFIG = "//agentplane/app/frontend:tsconfig"

ts_library(
    name = "credential_watch",
    srcs = ["credential_watch.ts"],
    tsconfig = TSCONFIG,
    deps = [
        "//:node_modules/@bufbuild/protobuf",
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//agentplane/app/frontend:watch_stream",
        "//agentplane/egress/api/admin:egress_admin_pb",
        "//agentplane/egress/api/rules:egress_rules_pb",
    ],
)

agentplane_vitest_test(
    name = "credential_watch_test",
    srcs = ["credential_watch.test.tsx"],
    deps = [
        ":credential_watch",
        "//:node_modules/@types/react",
        "//:node_modules/@types/react-dom",
        "//:node_modules/react",
        "//:node_modules/react-dom",
        "//:node_modules/vitest",
        "//agentplane/app/frontend:watch_stream",
    ],
)

check_vitest_specs()
