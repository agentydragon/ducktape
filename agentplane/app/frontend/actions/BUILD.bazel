load("@aspect_rules_js//js:defs.bzl", "js_library")
load("//agentplane/app/frontend:vitest.bzl", "agentplane_vitest_test")
load("//devinfra/js:openapi.bzl", "js_openapi_zod")
load("//devinfra/js:ts_library.bzl", "ts_library")

package(default_visibility = ["//agentplane/app:__subpackages__"])

TSCONFIG = "//agentplane/app/frontend:tsconfig"

# Generate the SSH argument/result validators from the schema FastMCP builds from the server's
# registered tool signature and return type.
js_openapi_zod(
    name = "ssh_action_schemas_generated",
    out = "schemas/ssh/exec.zod.ts",
    generator = "//x/ssh_mcp_server:export_frontend_schema_bin",
    tsconfig = "//agentplane/app/frontend:tsconfig_generated",
)

ts_library(
    name = "ssh_action_schemas",
    srcs = ["schemas/ssh/exec.ts"],
    tsconfig = TSCONFIG,
    deps = [":ssh_action_schemas_generated"],
)

ts_library(
    name = "types",
    srcs = ["types.ts"],
    tsconfig = TSCONFIG,
    deps = ["//agentplane/app/frontend:schema"],
)

ts_library(
    name = "action_client",
    srcs = ["client.ts"],
    tsconfig = TSCONFIG,
    deps = [
        ":types",
        "//agentplane/app/frontend:client",
        "//agentplane/app/frontend:schema",
    ],
)

ts_library(
    name = "call",
    srcs = ["call.tsx"],
    tsconfig = TSCONFIG,
    deps = [
        ":action_client",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//agentplane/app/frontend:client",
        "//agentplane/app/frontend:disclosure",
        "//agentplane/app/frontend:json_view",
        "//agentplane/app/frontend:raw_switch",
        "//agentplane/app/frontend/actions/rendering:index",
    ],
)

ts_library(
    name = "requests",
    srcs = [
        "requests.tsx",
        # Ambient module declaration for the per-icon Tabler imports used by the decision buttons.
        "tabler_icons.d.ts",
    ],
    tsconfig = TSCONFIG,
    deps = [
        ":action_client",
        ":call",
        "//:node_modules/@mantine/core",
        "//:node_modules/@tabler/icons-react",
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//agentplane/app/frontend:client",
        "//agentplane/app/frontend:live_stream",
        "//agentplane/app/frontend:stream_status",
    ],
)

ts_library(
    name = "sidebar",
    srcs = [
        "css.d.ts",
        "sidebar.tsx",
        "tabler_icons.d.ts",
    ],
    tsconfig = TSCONFIG,
    deps = [
        ":requests",
        ":sidebar_css",
        "//:node_modules/@mantine/core",
        "//:node_modules/@tabler/icons-react",
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//:node_modules/react-router",
        "//agentplane/app/frontend:client",
        "//agentplane/app/frontend:json_view",
        "//agentplane/app/frontend:stream_status",
        "//agentplane/app/frontend/actions/rendering:index",
    ],
)

