load("//agentplane/app/frontend:vitest.bzl", "agentplane_vitest_test")
load("//devinfra/js:ts_library.bzl", "ts_library")
load("//devinfra/js:vitest.bzl", "check_vitest_specs")

package(default_visibility = ["//agentplane/app:__subpackages__"])

filegroup(
    name = "typed_lint_srcs",
    srcs = glob(
        [
            "*.ts",
            "*.tsx",
        ],
        allow_empty = True,
    ),
    visibility = ["//agentplane/app/frontend:__pkg__"],
)

ts_library(
    name = "preview_preference",
    srcs = ["preview_preference.ts"],
    tsconfig = "//agentplane/app/frontend:tsconfig",
)

ts_library(
    name = "push",
    srcs = ["settings.tsx"],
    tsconfig = "//agentplane/app/frontend:tsconfig",
    deps = [
        ":preview_preference",
        "//:node_modules/@bufbuild/protobuf",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//agentplane/action_service/api/web_push:web_push_service_pb",
        "//agentplane/app/frontend/transport:client",
        "//agentplane/app/frontend/transport:stream_reader",
        "//agentplane/app/frontend/transport:watch_stream",
    ],
)

agentplane_vitest_test(
    name = "push_test",
    srcs = ["settings.test.tsx"],
    deps = [
        ":push",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/@types/react-dom",
        "//:node_modules/react",
        "//:node_modules/react-dom",
        "//:node_modules/vitest",
        "//agentplane/app/frontend/actions/testing:harness",
        "//agentplane/app/frontend/testing:watch",
    ],
)

check_vitest_specs()
