load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//agentplane/app:__subpackages__"])

py_library(
    name = "models",
    srcs = ["models.py"],
    deps = [
        "//agentplane/app:operator_sessions",
        "//agentplane/app:presets",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "updates",
    srcs = ["updates.py"],
    deps = [
        "//agentplane/app:changes",
        "@pypi//asyncpg",
        "@pypi//sqlalchemy",
    ],
)

py_test(
    name = "test_updates",
    size = "medium",
    srcs = ["test_updates.py"],
    deps = [
        ":ingestion",
        ":updates",
        "//:conftest",
        "//agentplane/app:conftest",
        "//agentplane/app/agent_runtime/events:event_log",
        "//agentplane/app/agent_runtime/events:ingestion_lease",
        "//agentplane/app/agent_runtime/thread:store",
        "//agentplane/protocol:event_pb2",
        "@pypi//protobuf",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "ingestion",
    srcs = ["ingestion.py"],
    deps = [
        ":updates",
        "//agentplane/app:inventory",
        "//agentplane/app:runners",
        "//agentplane/app:thread_fold",
        "//agentplane/app/agent_runtime/events:event_log",
        "//agentplane/app/agent_runtime/events:ingestion_lease",
        "//agentplane/app/thread:recording",
        "//agentplane/protocol:event_log_pb2",
        "//agentplane/runner:client",
        "//agentplane/runner:protocol_pb2",
        "@pypi//grpcio",
        "@pypi//protobuf",
        "@pypi//sqlalchemy",
    ],
)

py_test(
    name = "test_ingestion",
    size = "medium",
    srcs = ["test_ingestion.py"],
    deps = [
        ":ingestion",
        ":models",
        ":updates",
        "//:conftest",
        "//agentplane/app:conftest",
        "//agentplane/app/agent_runtime/events:event_log",
        "//agentplane/app/agent_runtime/events:ingestion_lease",
        "//agentplane/app/agent_runtime/thread:store",
        "//agentplane/protocol:command_pb2",
        "//agentplane/protocol:event_log_pb2",
        "//agentplane/protocol:event_pb2",
        "//agentplane/runner:client",
        "//agentplane/runner:protocol_pb2",
        "@pypi//protobuf",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)

py_test(
    name = "test_indexing",
    # Three history sizes up to 40,000 events folded into 20,000 materialized entities: minutes of
    # bounded work, measured at ~217s for the four cases together.
    size = "large",
    srcs = ["test_indexing.py"],
    deps = [
        ":ingestion",
        ":models",
        "//:conftest",
        "//agentplane/app:conftest",
        "//agentplane/app/agent_runtime/events:event_log",
        "//agentplane/app/agent_runtime/events:ingestion_lease",
        "//agentplane/app/agent_runtime/thread:store",
        "//agentplane/app/thread:content",
        "//agentplane/protocol:command_pb2",
        "//agentplane/protocol:event_log_pb2",
        "//agentplane/protocol:event_pb2",
        "//util/testing:undeclared_outputs",
        "@pypi//protobuf",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)
