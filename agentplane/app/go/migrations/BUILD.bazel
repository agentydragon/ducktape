load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "migrations",
    srcs = ["migrations.go"],
    embedsrcs = glob(["app/*.sql"]),
    importpath = "github.com/agentydragon/ducktape/agentplane/app/go/migrations",
    visibility = ["//agentplane/app:__subpackages__"],
    deps = [
        "@com_github_pressly_goose_v3//:goose",
        "@com_github_pressly_goose_v3//lock",
    ],
)

go_test(
    name = "migrations_test",
    size = "medium",
    srcs = ["migrations_test.go"],
    embed = [":migrations"],
    tags = ["requires_docker"],
    deps = [
        "//agentplane/testing/postgres",
        "@com_github_lib_pq//:pq",
    ],
)
