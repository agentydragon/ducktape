load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//agentplane/app:__subpackages__"])

go_library(
    name = "historywatch",
    srcs = ["historywatch.go"],
    importpath = "github.com/agentydragon/ducktape/agentplane/app/go/historywatch",
    deps = [
        "//agentplane/history_service:history_service_go_proto",
        "//agentplane/observability",
        "@com_github_google_uuid//:uuid",
        "@io_opentelemetry_go_otel//attribute",
    ],
)

go_test(
    name = "historywatch_test",
    srcs = ["historywatch_test.go"],
    embed = [":historywatch"],
    deps = [
        "//agentplane/history_service:history_service_go_proto",
        "@com_github_google_uuid//:uuid",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//types/known/emptypb",
    ],
)
