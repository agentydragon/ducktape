load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")
load("//devinfra/go:defs.bzl", "go_test")

go_library(
    name = "cmd_lib",
    srcs = ["main.go"],
    importpath = "github.com/agentydragon/ducktape/agentplane/app/go/migrate",
    visibility = ["//visibility:private"],
    deps = [
        "//agentplane/app/go/migrations",
        "//agentplane/postgres/go/migrate",
    ],
)

go_binary(
    name = "app-migrate",
    embed = [":cmd_lib"],
    pure = "on",
    visibility = ["//agentplane/app:__pkg__"],
)

go_test(
    name = "migrate_test",
    srcs = ["main_test.go"],
    embed = [":cmd_lib"],
)
