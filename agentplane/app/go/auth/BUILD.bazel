load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//devinfra/go:defs.bzl", "go_test")

package(default_visibility = ["//agentplane/app:__subpackages__"])

go_library(
    name = "auth",
    srcs = [
        "auth.go",
        "config.go",
        "cookie.go",
        "store.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/app/go/auth",
    deps = [
        "//agentplane/workload_auth/go/auth",
        "@com_github_coreos_go_oidc_v3//oidc",
        "@com_github_gorilla_securecookie//:securecookie",
        "@io_k8s_api//authentication/v1:authentication",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@org_golang_x_oauth2//:oauth2",
    ],
)

go_test(
    name = "unit_test",
    srcs = ["auth_test.go"],
    embed = [":auth"],
    deps = [
        "@io_k8s_api//authentication/v1:authentication",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
    ],
)

go_test(
    name = "session_integration_test",
    srcs = [
        "oidc_integration_test.go",
        "session_integration_test.go",
        "session_integration_testmain_test.go",
    ],
    embed = [":auth"],
    tags = ["requires_docker"],
    deps = [
        "//agentplane/app/go/migrations",
        "//agentplane/postgres/go/wakeups",
        "//agentplane/testing/postgres",
        "@com_github_go_jose_go_jose_v4//:go-jose",
        "@com_github_go_jose_go_jose_v4//jwt",
        "@com_github_lib_pq//:pq",
    ],
)
