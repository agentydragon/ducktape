load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//agentplane/app:__subpackages__"])

go_library(
    name = "historydata",
    srcs = ["historydata.go"],
    importpath = "github.com/agentydragon/ducktape/agentplane/app/go/historydata",
    deps = [
        "//agentplane/history_service:history_service_go_proto",
        "//agentplane/history_service/settledcursors",
        "//agentplane/proto:command_go_proto",
        "//agentplane/proto:event_log_go_proto",
        "//agentplane/proto:runner_go_proto",
        "@com_github_google_uuid//:uuid",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

go_test(
    name = "historydata_test",
    srcs = ["historydata_test.go"],
    embed = [":historydata"],
    deps = [
        "//agentplane/history_service:history_service_go_proto",
        "//agentplane/proto:command_go_proto",
        "//agentplane/proto:event_go_proto",
        "//agentplane/proto:event_log_go_proto",
        "@com_github_google_uuid//:uuid",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
    ],
)
