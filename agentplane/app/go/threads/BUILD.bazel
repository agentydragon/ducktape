load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//agentplane/app:__subpackages__"])

go_library(
    name = "threads",
    srcs = ["store.go"],
    importpath = "github.com/agentydragon/ducktape/agentplane/app/go/threads",
    deps = ["@com_github_google_uuid//:uuid"],
)

go_test(
    name = "store_integration_test",
    size = "medium",
    srcs = ["store_integration_test.go"],
    embed = [":threads"],
    tags = ["requires_docker"],
    deps = [
        "//agentplane/app/go/migrations",
        "//agentplane/postgres/go/wakeups",
        "//agentplane/testing/postgres",
        "@com_github_google_uuid//:uuid",
    ],
)
