load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//devinfra/go:defs.bzl", "go_test")

package(default_visibility = ["//agentplane/app:__subpackages__"])

go_library(
    name = "federation",
    srcs = [
        "federation.go",
        "verify.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/app/go/federation",
    deps = [
        "//agentplane/app/go/auth",
        "@com_github_coreos_go_oidc_v3//oidc",
        "@com_github_go_jose_go_jose_v4//:go-jose",
        "@com_github_go_jose_go_jose_v4//jwt",
    ],
)

go_test(
    name = "unit_test",
    srcs = ["federation_test.go"],
    embed = [":federation"],
    deps = [
        "//agentplane/app/go/auth",
        "@com_github_go_jose_go_jose_v4//:go-jose",
        "@com_github_go_jose_go_jose_v4//jwt",
    ],
)
