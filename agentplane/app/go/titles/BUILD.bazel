load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//agentplane/app:__subpackages__"])

go_library(
    name = "titles",
    srcs = [
        "generator.go",
        "titles.go",
        "worker.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/app/go/titles",
    deps = [
        "//agentplane/app/go/historywatch",
        "//agentplane/app/go/threads",
        "//agentplane/history_service:history_service_go_proto",
        "//agentplane/proto:event_log_go_proto",
        "@com_github_google_uuid//:uuid",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
    ],
)

go_test(
    name = "titles_test",
    srcs = [
        "titles_test.go",
        "worker_test.go",
    ],
    embed = [":titles"],
    deps = [
        "//agentplane/app/go/historywatch",
        "//agentplane/app/go/threads",
        "//agentplane/history_service:history_service_go_proto",
        "//agentplane/proto:event_go_proto",
        "//agentplane/proto:event_log_go_proto",
        "@com_github_google_uuid//:uuid",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//types/known/emptypb",
    ],
)
