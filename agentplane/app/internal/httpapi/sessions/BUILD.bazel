load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//agentplane/app:__subpackages__"])

go_library(
    name = "sessions",
    srcs = ["handler.go"],
    importpath = "github.com/agentydragon/ducktape/agentplane/app/internal/httpapi/sessions",
    deps = [
        "//agentplane/app:app_service_go_proto",
        "//agentplane/app/internal/bridge",
        "//agentplane/app/internal/sandboxes",
        "//agentplane/app/internal/settings",
        "//agentplane/environments/v1:environment_service_go_proto",
        "//agentplane/observability",
        "//agentplane/proto:identity_go_proto",
        "//agentplane/proto:session_go_proto",
        "//agentplane/runner_gateway/dispatcher/api/session:session_dispatcher_go_proto",
        "//agentplane/sandboxes/api",
        "@com_github_google_uuid//:uuid",
        "@io_k8s_apimachinery//pkg/api/errors",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//types/known/structpb",
    ],
)

go_test(
    name = "handler_test",
    srcs = ["handler_test.go"],
    embed = [":sessions"],
    deps = [
        "//agentplane/app/internal/bridge",
        "//agentplane/app/internal/sandboxes",
        "//agentplane/app/internal/settings",
        "//agentplane/environments/v1:environment_service_go_proto",
        "//agentplane/proto:identity_go_proto",
        "//agentplane/proto:session_go_proto",
        "@io_k8s_apimachinery//pkg/api/errors",
        "@io_k8s_apimachinery//pkg/runtime/schema",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//proto",
    ],
)
