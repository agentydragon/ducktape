load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//agentplane/app:__subpackages__"])

go_library(
    name = "sessionclient",
    srcs = [
        "errors.go",
        "session_client.go",
        "session_dispatcher.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/app/internal/sessionclient",
    deps = [
        "//agentplane/grpc/bearer",
        "//agentplane/net/peertls",
        "//agentplane/observability",
        "//agentplane/proto:session_go_proto",
        "//agentplane/proto/sessionplacement",
        "//agentplane/session_dispatcher/dispatcher/api/session:session_dispatcher_go_proto",
        "@com_github_google_uuid//:uuid",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//reflect/protoreflect",
    ],
)

go_test(
    name = "unit_test",
    srcs = [
        "session_client_test.go",
    ],
    embed = [":sessionclient"],
    deps = [
        "//agentplane/net/peertls",
        "//agentplane/net/peertls/testing",
        "//agentplane/proto:session_go_proto",
        "//agentplane/session_dispatcher/dispatcher/api/session:session_dispatcher_go_proto",
        "//agentplane/testing/grpcserver",
        "@com_github_google_uuid//:uuid",
        "@org_golang_google_genproto_googleapis_rpc//errdetails",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//metadata",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//proto",
    ],
)
