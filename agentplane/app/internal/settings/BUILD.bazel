load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//agentplane/app:__subpackages__"])

go_library(
    name = "settings",
    srcs = [
        "config.go",
        "frontend_config.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/app/internal/settings",
    deps = [
        "//agentplane/app/internal/auth",
        "//agentplane/net/peertls",
        "//agentplane/sandboxes/runtimeconfig",
        "@com_github_go_viper_mapstructure_v2//:mapstructure",
        "@in_gopkg_yaml_v3//:yaml_v3",
    ],
)

go_test(
    name = "settings_test",
    srcs = ["config_test.go"],
    embed = [":settings"],
    deps = [
        "//agentplane/net/peertls",
        "//agentplane/sandboxes/runtimeconfig",
    ],
)
