load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//agentplane/app:__subpackages__"])

py_library(
    name = "content",
    srcs = ["content.py"],
    deps = [
        "//agentplane/app/threads:models",
        "//agentplane/app/threads/events:debug",
        "//agentplane/app/threads/events:event_log",
        "//agentplane/history_service:client",
        "//agentplane/history_service:protocol_pb2",
        "//agentplane/proto:command_pb2",
        "//agentplane/proto:event_log_pb2",
        "//agentplane/sandbox_service:protocol_pb2",
        "//agentplane/thread_fold:models",
        "//agentplane/thread_fold:views",
        "@pypi//grpcio",
        "@pypi//protobuf",
        "@pypi//sqlalchemy",
    ],
)

py_test(
    name = "test_recording",
    size = "medium",
    srcs = ["test_recording.py"],
    deps = [
        "//:conftest",
        "//agentplane/app:conftest",
        "//agentplane/app/testing:history",
        "//agentplane/app/testing:projection_lease",
        "//agentplane/app/testing:thread_test_support",
        "//agentplane/app/threads:store",
        "//agentplane/proto:command_pb2",
        "//agentplane/proto:event_pb2",
        "//agentplane/proto:runner_pb2",
        "//agentplane/runner:codex",
        "//agentplane/runner:config",
        "//agentplane/runner:observation",
        "//agentplane/runner:session",
        "//agentplane/runner:store",
        "//agentplane/thread_fold:fold",
        "//agentplane/thread_fold:models",
        "//agentplane/thread_fold:views",
        "@pypi//protobuf",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)

py_test(
    name = "test_content",
    size = "medium",
    srcs = ["test_content.py"],
    deps = [
        ":content",
        "//:conftest",
        "//agentplane/app:conftest",
        "//agentplane/app/testing:history",
        "//agentplane/app/testing:projection_lease",
        "//agentplane/app/testing:thread_test_support",
        "//agentplane/app/threads/events:event_log",
        "//agentplane/proto:command_pb2",
