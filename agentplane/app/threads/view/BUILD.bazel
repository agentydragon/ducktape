load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//agentplane/app:__subpackages__"])

py_library(
    name = "fold",
    srcs = ["fold.py"],
    visibility = [
        "//agentplane/acceptance:__pkg__",
        "//agentplane/app:__subpackages__",
    ],
    deps = [
        "//agentplane/protocol:command_pb2",
        "//agentplane/protocol:event_log_pb2",
        "//agentplane/protocol:event_pb2",
        "@pypi//protobuf",  # keep: mypy follows generated protobuf interfaces
        "@pypi//types_protobuf",  # keep: mypy follows generated protobuf interfaces
    ],
)

py_library(
    name = "recording",
    srcs = ["recording.py"],
    deps = [
        ":fold",
        ":payloads",
        ":rows",
        ":views",
        "//agentplane/app/threads:models",
        "//agentplane/app/threads/events:event_log",
        "//agentplane/protocol:event_log_pb2",
        "@pypi//protobuf",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "rows",
    srcs = ["rows.py"],
    deps = [
        ":fold",
        ":views",
        "@pypi//protobuf",
    ],
)

py_library(
    name = "payloads",
    srcs = ["payloads.py"],
    deps = [
        ":fold",
        "//agentplane/app/threads:models",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "content",
    srcs = ["content.py"],
    deps = [
        ":fold",
        ":views",
        "//agentplane/app/threads:models",
        "//agentplane/app/threads/events:debug",
        "//agentplane/app/threads/events:event_log",
        "//agentplane/history_service:client",
        "//agentplane/protocol:command_pb2",
        "//agentplane/protocol:event_log_pb2",
        "//agentplane/sandbox_service:protocol_pb2",
        "@pypi//protobuf",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "views",
    srcs = ["views.py"],
    visibility = [
        "//agentplane/acceptance:__pkg__",
        "//agentplane/app:__subpackages__",
    ],
    deps = [
        ":fold",
        "//agentplane/runner:harness",
        "@pypi//pydantic",
    ],
)

py_test(
    name = "test_fold",
    srcs = ["test_fold.py"],
    # Pure synchronous tests with local fixtures; avoid loading the app's database/harness
    # fixture chain, whose imports consumed most of this target's 60-second CI budget.
    args = ["--noconftest"],
    deps = [
        ":fold",
        "//:conftest",
        "//agentplane/app:conftest",
        "//agentplane/protocol:command_pb2",
        "//agentplane/protocol:event_log_pb2",
        "//agentplane/protocol:event_pb2",
        "@pypi//more_itertools",
        "@pypi//protobuf",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_recording",
    size = "medium",
    srcs = ["test_recording.py"],
    deps = [
        ":fold",
        ":views",
        "//:conftest",
        "//agentplane/app:conftest",
        "//agentplane/app/testing:history",
        "//agentplane/app/testing:projection_lease",
        "//agentplane/app/testing:thread_test_support",
        "//agentplane/app/threads:models",
        "//agentplane/app/threads:store",
        "//agentplane/protocol:command_pb2",
        "//agentplane/protocol:event_pb2",
        "//agentplane/runner:codex",
        "//agentplane/runner:config",
        "//agentplane/runner:observation",
        "//agentplane/runner:protocol_pb2",
        "//agentplane/runner:session",
        "//agentplane/runner:store",
        "@pypi//protobuf",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)

py_test(
    name = "test_content",
    size = "medium",
    srcs = ["test_content.py"],
    deps = [
        ":content",
        "//:conftest",
        "//agentplane/app:conftest",
        "//agentplane/app/testing:history",
        "//agentplane/app/testing:projection_lease",
        "//agentplane/app/testing:thread_test_support",
        "//agentplane/app/threads/events:event_log",
        "//agentplane/protocol:command_pb2",
        "//agentplane/protocol:event_pb2",
        "@pypi//protobuf",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
