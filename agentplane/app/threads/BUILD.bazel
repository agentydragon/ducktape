load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//agentplane/app:__subpackages__"])

py_library(
    name = "models",
    srcs = ["models.py"],
    deps = [
        "//agentplane/app:database",
        "//agentplane/runner:harness",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "thread_view",
    srcs = ["thread_view.py"],
    deps = [
        "//agentplane/runner:harness",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "ingestion",
    srcs = ["ingestion.py"],
    deps = [
        ":sessions",
        "//agentplane/app/threads/events:event_log",
        "//agentplane/sandbox_service:models",
        "//agentplane/thread_fold:projection_lease",
        "//agentplane/thread_fold:projector",
        "//agentplane/thread_fold:recording",
        "@pypi//grpcio",
        "@pypi//sqlalchemy",
    ],
)

py_test(
    name = "test_ingestion",
    size = "medium",
    srcs = ["test_ingestion.py"],
    deps = [
        ":ingestion",
        "//:conftest",
        "//agentplane/app:conftest",
        "//agentplane/app/testing:projection_lease",
        "//agentplane/app/testing:retained_history",
        "//agentplane/thread_fold:models",
        "//agentplane/thread_fold:projection_lease",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)

py_test(
    name = "test_indexing",
    # Three history sizes up to 40,000 events folded into 20,000 materialized entities: minutes of
    # bounded work, measured at ~200s for the three cases together.
    size = "large",
    srcs = ["test_indexing.py"],
    deps = [
        ":store",
        "//:conftest",
        "//agentplane/app:conftest",
        "//agentplane/app/testing:history",
        "//agentplane/app/testing:projection_lease",
        "//agentplane/app/testing:thread_test_support",
        "//agentplane/app/threads/view:content",
        "//agentplane/protocol:command_pb2",
        "//agentplane/protocol:event_log_pb2",
        "//agentplane/protocol:event_pb2",
        "//agentplane/thread_fold:models",
        "//util/testing:undeclared_outputs",
        "@pypi//protobuf",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "store",
    srcs = ["store.py"],
    deps = [
        ":models",
        ":thread_view",
        "//agentplane/app:database_updates",
        "//agentplane/app/threads/events:event_log",
        "//agentplane/protocol:event_pb2",
        "//agentplane/runner:protocol_pb2",
        "//agentplane/thread_fold:models",
        "@pypi//protobuf",
        "@pypi//sqlalchemy",
    ],
)

py_test(
    name = "test_store",
    size = "medium",
    srcs = ["test_store.py"],
    deps = [
        ":store",
        "//:conftest",
        "//agentplane/app:conftest",
        "//agentplane/app/testing:retained_history",
        "//agentplane/protocol:event_pb2",
        "//agentplane/runner:protocol_pb2",
        "//agentplane/thread_fold:models",
        "@pypi//protobuf",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "sessions",
    srcs = ["sessions.py"],
    deps = [
        "//agentplane/app:changes",
        "//agentplane/app:live",
        "//agentplane/app:sandbox_models",
        "//agentplane/sandbox_service:client",
        "//agentplane/sandbox_service:models",
        "//agentplane/sandbox_service:protocol_pb2",
        "@pypi//protobuf",
        "@pypi//types_protobuf",  # keep: mypy follows generated protobuf interfaces
    ],
)

py_library(
    name = "bridge",
    srcs = ["bridge.py"],
    deps = [
        ":ingestion",
        ":sessions",
        "//agentplane/app/threads/events:event_log",
        "//agentplane/app/threads/view:content",
        "//agentplane/protocol:command_pb2",
        "//agentplane/protocol:event_log_pb2",
        "//agentplane/runner:errors",
        "//agentplane/runner:protocol_pb2",
        "@pypi//fastapi",
        "@pypi//grpcio",
        "@pypi//protobuf",
        "@pypi//pydantic",
    ],
)

py_test(
    name = "test_history_projector",
    size = "medium",
    srcs = ["test_history_projector.py"],
    requires_docker = True,
    deps = [
        ":ingestion",
        ":sessions",
        ":store",
        "//:conftest",
        "//agentplane/app:conftest",
        "//agentplane/app:database_updates",
        "//agentplane/app/testing:history",
        "//agentplane/app/testing:projection_lease",
        "//agentplane/app/testing:retained_history",
        "//agentplane/app/testing:thread_test_support",
        "//agentplane/app/threads/events:event_log",
        "//agentplane/protocol:event_pb2",
        "//agentplane/runner:protocol_pb2",
        "//agentplane/sandbox_service:client",
        "//agentplane/sandbox_service:protocol_pb2",
        "//agentplane/thread_fold:models",
        "//agentplane/thread_fold:projection_lease",
        "//agentplane/thread_fold:projector",
        "//agentplane/thread_fold:recording",
        "//agentplane/thread_fold:views",
        "@pypi//protobuf",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)

