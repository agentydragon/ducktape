load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//agentplane/app:__subpackages__"])

py_library(
    name = "models",
    srcs = ["models.py"],
    deps = [
        "//agentplane/app:database",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "thread_view",
    srcs = ["thread_view.py"],
    deps = [
        "//agentplane/runner:harness",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "store",
    srcs = ["store.py"],
    deps = [
        ":models",
        ":summaries",
        ":thread_view",
        "//agentplane/app:database_updates",
        "//agentplane/app/threads/events:event_log",
        "//agentplane/postgres:wakeups",
        "//agentplane/proto:event_pb2",
        "//agentplane/proto:runner_pb2",
        "//agentplane/runner:harness",
        "@pypi//protobuf",
        "@pypi//pydantic",
        "@pypi//sqlalchemy",
    ],
)

py_test(
    name = "test_store",
    size = "medium",
    srcs = ["test_store.py"],
    deps = [
        ":store",
        "//:conftest",
        "//agentplane/app:conftest",
        "//agentplane/app/testing:history",
        "//agentplane/app/testing:thread_test_support",
        "//agentplane/app/threads/events:event_log",
        "//agentplane/history_service/testing:history",
        "//agentplane/proto:event_pb2",
        "//agentplane/proto:runner_pb2",
        "//agentplane/runner:harness",
        "@pypi//protobuf",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "summaries",
    srcs = ["summaries.py"],
    deps = [
        "//agentplane/grpc:calls",
        "//agentplane/history_service:client",
        "//agentplane/history_service:history_service_pb2",
        "//agentplane/proto:runner_pb2",
        "@pypi//grpcio",
        "@pypi//protobuf",
    ],
)

py_library(
    name = "runner_directory",
    srcs = ["runner_directory.py"],
    deps = [
        "//agentplane/app:live",
        "//agentplane/app:sandbox_models",
        "//agentplane/proto:sandboxes_pb2",
        "//agentplane/runner_gateway:client",
        "//agentplane/sandboxes:errors",
        "@pypi//protobuf",
        "@pypi//types_protobuf",  # keep: mypy follows generated protobuf interfaces
    ],
)

py_library(
    name = "bridge",
    srcs = ["bridge.py"],
    deps = [
        ":dispatcher_client",
        ":runner_directory",
        ":summaries",
        "//agentplane/app:sandbox_models",
        "//agentplane/app/threads/events:event_log",
        "//agentplane/app/threads/view:content",
        "//agentplane/proto:runner_pb2",
        "//agentplane/runner_gateway/dispatcher:session_dispatcher_pb2",
        "@pypi//fastapi",
        "@pypi//grpcio",
        "@pypi//opentelemetry_api",
        "@pypi//protobuf",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "dispatcher_client",
    srcs = ["dispatcher_client.py"],
    deps = [
        "//agentplane/app:grpc_stream",
        "//agentplane/grpc:calls",
        "//agentplane/runner_gateway/dispatcher:session_dispatcher_pb2_grpc",
        "@pypi//grpcio",
        "@pypi//protobuf",
    ],
)

py_test(
    name = "test_dispatcher_client",
    srcs = ["test_dispatcher_client.py"],
    deps = [
        ":dispatcher_client",
        "//:conftest",
        "//agentplane/app:conftest",
        "//agentplane/grpc:calls",
        "//agentplane/grpc:serving",
        "//agentplane/runner_gateway/dispatcher:session_dispatcher_pb2",
        "//agentplane/runner_gateway/dispatcher:session_dispatcher_pb2_grpc",
        "@pypi//grpcio",
        "@pypi//protobuf",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "history_watch",
    srcs = ["history_watch.py"],
    deps = [
        "//agentplane/app/threads/events:event_log",
        "//agentplane/history_service:client",
        "@pypi//opentelemetry_api",
        "@pypi//sqlalchemy",
    ],
)

py_test(
    name = "test_history_watch",
    size = "medium",
    srcs = ["test_history_watch.py"],
    requires_docker = True,
    deps = [
        ":history_watch",
        ":summaries",
        "//:conftest",
        "//agentplane:changes",
        "//agentplane/app:conftest",
        "//agentplane/app/threads/events:event_log",
        "//agentplane/history_service:client",
        "//agentplane/history_service/testing:go_service",
        "//agentplane/history_service/testing:history",
        "//agentplane/testing:kubernetes_apiserver",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
        "@pypi//tenacity",
    ],
)
