load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//agentplane/app:__subpackages__"])

py_library(
    name = "models",
    srcs = ["models.py"],
    deps = [
        "//agentplane/app:database",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "thread_view",
    srcs = ["thread_view.py"],
    deps = [
        "//agentplane/runner:harness",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "ingestion",
    srcs = ["ingestion.py"],
    deps = [
        ":sessions",
        "//agentplane/app/threads/events:event_log",
        "//agentplane/sandbox_service:models",
        "@pypi//grpcio",
        "@pypi//sqlalchemy",
    ],
)

py_test(
    name = "test_indexing",
    # Full archives up to 40,000 events and pure-fold-derived prefixes up to 20,000 item rows.
    size = "large",
    srcs = ["test_indexing.py"],
    deps = [
        ":store",
        "//:conftest",
        "//agentplane/app:conftest",
        "//agentplane/app/testing:history",
        "//agentplane/app/testing:thread_test_support",
        "//agentplane/app/threads/view:content",
        "//agentplane/history_service/fold:models",
        "//agentplane/history_service/testing:history",
        "//agentplane/proto:command_pb2",
        "//agentplane/proto:event_log_pb2",
        "//agentplane/proto:event_pb2",
        "//util/testing:undeclared_outputs",
        "@pypi//protobuf",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "store",
    srcs = ["store.py"],
    deps = [
        ":models",
        ":summaries",
        ":thread_view",
        "//agentplane/app:database_updates",
        "//agentplane/app/threads/events:event_log",
        "//agentplane/proto:event_pb2",
        "//agentplane/proto:runner_gateway_pb2",
        "//agentplane/proto:runner_pb2",
        "//agentplane/runner:harness",
        "//agentplane/sandbox_service:client",
        "@pypi//protobuf",
        "@pypi//pydantic",
        "@pypi//sqlalchemy",
    ],
)

py_test(
    name = "test_store",
    size = "medium",
    srcs = ["test_store.py"],
    deps = [
        ":store",
        "//:conftest",
        "//agentplane/app:conftest",
        "//agentplane/app/testing:history",
        "//agentplane/app/testing:thread_test_support",
        "//agentplane/history_service/testing:history",
        "//agentplane/proto:event_pb2",
        "//agentplane/proto:runner_pb2",
        "//agentplane/runner:harness",
        "@pypi//protobuf",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "summaries",
    srcs = ["summaries.py"],
    deps = [
        ":models",
        "//agentplane/app:database_updates",
        "//agentplane/history_service:client",
        "//agentplane/history_service:protocol_pb2",
        "//agentplane/proto:runner_pb2",
        "@pypi//grpcio",
        "@pypi//protobuf",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "sessions",
    srcs = ["sessions.py"],
    deps = [
        "//agentplane/app:changes",
        "//agentplane/app:live",
        "//agentplane/app:sandbox_models",
        "//agentplane/app/threads/events:event_log",
        "//agentplane/proto:sandbox_service_pb2",
        "//agentplane/sandbox_service:client",
        "//agentplane/sandbox_service:models",
        "@pypi//protobuf",
        "@pypi//types_protobuf",  # keep: mypy follows generated protobuf interfaces
    ],
)

py_library(
    name = "bridge",
    srcs = ["bridge.py"],
    deps = [
        ":ingestion",
        ":sessions",
        ":summaries",
        "//agentplane/app/threads/events:event_log",
        "//agentplane/app/threads/view:content",
        "//agentplane/proto:command_pb2",
        "//agentplane/proto:event_log_pb2",
        "//agentplane/proto:runner_pb2",
        "//agentplane/proto:sandbox_service_pb2",
        "//agentplane/runner:errors",
        "//agentplane/runner:harness",
        "@pypi//fastapi",
        "@pypi//grpcio",
        "@pypi//protobuf",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "history_watch",
    srcs = ["history_watch.py"],
    deps = ["//agentplane/history_service:client"],
)

py_test(
    name = "test_history_watch",
    size = "medium",
    srcs = ["test_history_watch.py"],
    requires_docker = True,
    deps = [
        ":history_watch",
        "//:conftest",
        "//agentplane/app:changes",
        "//agentplane/app:conftest",
        "//agentplane/history_service/testing:backend",
        "@pypi//pytest_bazel",
    ],
)
