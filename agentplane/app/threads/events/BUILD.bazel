load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//agentplane/app:__subpackages__"])

py_library(
    name = "event_log",
    srcs = ["event_log.py"],
    deps = [
        ":debug",
        "//agentplane/app:database_updates",
        "//agentplane/app/threads:models",
        "//agentplane/protocol:event_log_pb2",
        "//agentplane/runner:harness",
        "//agentplane/runner:protocol_pb2",
        "//agentplane/sandbox_service:client",
        "//agentplane/sandbox_service:protocol_pb2",
        "@pypi//protobuf",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "projection_lease",
    srcs = ["projection_lease.py"],
    deps = [
        "//agentplane/app/threads:models",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "stream",
    srcs = ["stream.py"],
    deps = [
        ":event_log",
        "//agentplane/app:changes",
        "@pypi//protobuf",
    ],
)

py_library(
    name = "debug",
    srcs = ["debug.py"],
    deps = ["@pypi//pydantic"],
)

py_test(
    name = "test_event_log",
    size = "medium",
    srcs = ["test_event_log.py"],
    deps = [
        ":event_log",
        "//:conftest",
        "//agentplane/app:conftest",
        "//agentplane/app/testing:retained_history",
        "//agentplane/app/testing:thread_test_support",
        "//agentplane/app/threads:models",
        "//agentplane/protocol:event_pb2",
        "//agentplane/sandbox_service:client",
        "//agentplane/sandbox_service:protocol_pb2",
        "@pypi//protobuf",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)

py_test(
    name = "test_stream",
    size = "medium",
    srcs = ["test_stream.py"],
    requires_docker = True,
    deps = [
        ":event_log",
        ":stream",
        "//:conftest",
        "//agentplane/app:changes",
        "//agentplane/app:conftest",
        "//agentplane/protocol:event_log_pb2",
        "//agentplane/runner:protocol_pb2",
        "@pypi//protobuf",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
