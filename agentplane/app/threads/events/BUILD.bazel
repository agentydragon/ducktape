load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//agentplane/app:__subpackages__"])

py_library(
    name = "event_log",
    srcs = ["event_log.py"],
    deps = [
        ":debug",
        "//agentplane:grpc_calls",
        "//agentplane/app:database_updates",
        "//agentplane/app/threads:models",
        "//agentplane/app/threads:summaries",
        "//agentplane/history_service:client",
        "//agentplane/history_service:settled_cursors",
        "//agentplane/postgres:wakeups",
        "//agentplane/proto:event_log_pb2",
        "//agentplane/proto:history_service_pb2",
        "@pypi//grpcio",
        "@pypi//protobuf",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "stream",
    srcs = ["stream.py"],
    deps = [
        ":event_log",
        "//agentplane:changes",
        "//agentplane:sse",
        "//agentplane/app/threads:summaries",
        "@pypi//protobuf",
    ],
)

py_library(
    name = "debug",
    srcs = ["debug.py"],
    deps = ["@pypi//pydantic"],
)

py_test(
    name = "test_event_log",
    size = "medium",
    srcs = ["test_event_log.py"],
    deps = [
        ":event_log",
        "//:conftest",
        "//agentplane:grpc_calls",
        "//agentplane/app:conftest",
        "//agentplane/app/testing:retained_history",
        "//agentplane/app/testing:thread_test_support",
        "//agentplane/app/threads:models",
        "//agentplane/app/threads:summaries",
        "//agentplane/history_service:client",
        "//agentplane/proto:event_pb2",
        "//agentplane/proto:history_service_pb2",
        "@pypi//grpcio",
        "@pypi//protobuf",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)

py_test(
    name = "test_stream",
    size = "medium",
    srcs = ["test_stream.py"],
    requires_docker = True,
    deps = [
        ":event_log",
        ":stream",
        "//:conftest",
        "//agentplane:changes",
        "//agentplane/app:conftest",
        "//agentplane/app/threads:summaries",
        "//agentplane/proto:event_log_pb2",
        "//agentplane/proto:runner_pb2",
        "@pypi//protobuf",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
