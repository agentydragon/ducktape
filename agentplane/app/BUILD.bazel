# The app image: the API, the bridge, and the bundled SPA it serves, on debian slim as user 1000.
# Published as agentplane-app (devinfra/ci/image_targets.json) and run by the Deployment in
# cluster/k8s/agentplane-staging.
aspect_py_binary(
    name = "app_image_bin",
    main = "main.py",
    deps = [":main"],
)

py_image_layer(
    name = "app_layers",
    binary = ":app_image_bin",
    group = "1000",
    owner = "1000",
)

oci_image(
    name = "image",
    base = "@debian_trixie_slim_linux_amd64",
    entrypoint = py_image_entrypoint("app_image_bin"),
    env = py_image_env(
        binary_name = "app_image_bin",
        extra_env = {"SSL_CERT_FILE": "/etc/ssl/certs/ca-certificates.crt"},
    ),
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [
        ":app_layers",
        "//third_party/debian_slim:cacerts",
    ],
    user = "1000:1000",
)

py_library(
    name = "database_migrate",
    srcs = ["database_migrate.py"],
    data = ["//agentplane/app/migrations:files"],
    deps = [
        "//agentplane/app/thread:models",
        "//util:db_migrations",
        "@pypi//pydantic_settings",
    ],
)

py_binary(
    name = "migrate",
    main_module = "agentplane.app.database_migrate",
    deps = [":database_migrate"],
)

# The migration runner, published as agentplane-app-migrate (devinfra/ci/image_targets.json) and run
# as the `migrate` init container ahead of the app.
aspect_py_binary(
    name = "migration_image_bin",
    main = "database_migrate.py",
    deps = [":database_migrate"],
)

py_image_layer(
    name = "migration_layers",
    binary = ":migration_image_bin",
    group = "1000",
    owner = "1000",
)

oci_image(
    name = "migration_image",
    base = "@debian_trixie_slim_linux_amd64",
    entrypoint = py_image_entrypoint("migration_image_bin"),
    env = py_image_env(binary_name = "migration_image_bin"),
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [":migration_layers"],
    user = "1000:1000",
)

