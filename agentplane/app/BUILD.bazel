# The production API is the Go service. The retained Python contract suite is not packaged into the
# serving image.
pkg_tar(
    name = "app_binary_layer",
    srcs = ["//agentplane/app/go:agentplane-app"],
    mode = "0755",
    package_dir = "/usr/local/bin",
)

oci_image(
    name = "image",
    base = "@distroless_static_debian13_linux_amd64",
    entrypoint = ["/usr/local/bin/agentplane-app"],
    env = {"SSL_CERT_FILE": "/etc/ssl/certs/ca-certificates.crt"},
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [
        ":app_binary_layer",
        "//third_party/debian_slim:cacerts",
    ],
    user = "1000:1000",
    visibility = ["//agentplane/system_tests/k3s:__pkg__"],
    workdir = "/",
)

# The Go migrator adopts the existing Alembic head without changing application rows.
pkg_tar(
    name = "migration_binary_layer",
    srcs = ["//agentplane/app/go/migrate:app-migrate"],
    mode = "0755",
    package_dir = "/usr/local/bin",
)

oci_image(
    name = "migration_image",
    base = "@distroless_static_debian13_linux_amd64",
    entrypoint = ["/usr/local/bin/app-migrate"],
    env = {"SSL_CERT_FILE": "/etc/ssl/certs/ca-certificates.crt"},
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [
        ":migration_binary_layer",
        "//third_party/debian_slim:cacerts",
    ],
    user = "1000:1000",
    visibility = ["//agentplane/system_tests/k3s:__pkg__"],
    workdir = "/",
)

