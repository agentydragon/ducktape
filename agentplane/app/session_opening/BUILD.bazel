load("@aspect_rules_ts//ts:proto.bzl", "ts_proto_library")
load("@io_bazel_rules_go//proto:def.bzl", "go_proto_library")
load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("//devinfra/python:proto.bzl", "py_proto_library_with_mypy_stubs")

package(default_visibility = ["//agentplane:__subpackages__"])

proto_library(
    name = "session_opening_proto",
    srcs = ["session_opening.proto"],
    deps = [
        "//agentplane/runner_gateway/dispatcher:session_dispatcher_proto",
        "@googleapis//google/api:annotations_proto",
        "@protobuf//:struct_proto",
    ],
)

ts_proto_library(
    name = "session_opening_pb",
    copy_files = False,
    node_modules = "//:node_modules",
    proto = ":session_opening_proto",
    deps = [
        "//agentplane/runner_gateway/dispatcher:session_dispatcher_pb",
        "//google/api:annotations_pb",
    ],
)

go_proto_library(
    name = "session_opening_go_proto",
    compilers = [
        "@io_bazel_rules_go//proto:go_proto",
        "@io_bazel_rules_go//proto:go_grpc_v2",
        "//devinfra/go:grpc_gateway",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/app/session_opening/sessionopeningpb",
    proto = ":session_opening_proto",
    deps = [
        "//agentplane/runner_gateway/dispatcher:session_dispatcher_go_proto",
        "@org_golang_google_genproto_googleapis_api//annotations",
    ],
)

py_proto_library_with_mypy_stubs(
    name = "session_opening_pb2",
    deps = [":session_opening_proto"],
)
