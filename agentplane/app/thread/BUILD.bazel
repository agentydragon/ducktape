load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//agentplane/app:__subpackages__"])

py_library(
    name = "payloads",
    srcs = ["payloads.py"],
    deps = [
        "//agentplane/app:thread_fold",
        "//agentplane/app/agent_runtime:models",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "recording",
    srcs = ["recording.py"],
    deps = [
        ":payloads",
        ":rows",
        ":views",
        "//agentplane/app:thread_fold",
        "//agentplane/app/agent_runtime:models",
        "//agentplane/app/agent_runtime/events:event_log",
        "//agentplane/protocol:event_log_pb2",
        "@pypi//protobuf",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "rows",
    srcs = ["rows.py"],
    deps = [
        ":views",
        "//agentplane/app:thread_fold",
        "@pypi//protobuf",
    ],
)

py_library(
    name = "views",
    srcs = ["views.py"],
    deps = [
        "//agentplane/app:presets",
        "//agentplane/app:thread_fold",
        "@pypi//pydantic",
    ],
)

py_test(
    name = "test_recording",
    size = "medium",
    srcs = ["test_recording.py"],
    deps = [
        ":recording",
        ":views",
        "//:conftest",
        "//agentplane/app:conftest",
        "//agentplane/app/agent_runtime:ingestion",
        "//agentplane/app/agent_runtime:models",
        "//agentplane/app/agent_runtime/events:event_log",
        "//agentplane/app/agent_runtime/events:ingestion_lease",
        "//agentplane/app/agent_runtime/thread:store",
        "//agentplane/protocol:command_pb2",
        "//agentplane/protocol:event_pb2",
        "//agentplane/runner:protocol_pb2",
        "@pypi//protobuf",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "content",
    srcs = ["content.py"],
    deps = [
        ":views",
        "//agentplane/app:thread_fold",
        "//agentplane/app/agent_runtime:models",
        "//agentplane/app/agent_runtime/events:debug",
        "//agentplane/app/agent_runtime/events:event_log",
        "//agentplane/protocol:command_pb2",
        "//agentplane/protocol:event_log_pb2",
        "@pypi//protobuf",
        "@pypi//sqlalchemy",
    ],
)

py_test(
    name = "test_content",
    size = "medium",
    srcs = ["test_content.py"],
    deps = [
        ":content",
        "//:conftest",
        "//agentplane/app:conftest",
        "//agentplane/app/agent_runtime:ingestion",
        "//agentplane/app/agent_runtime/events:event_log",
        "//agentplane/app/agent_runtime/events:ingestion_lease",
        "//agentplane/protocol:command_pb2",
        "//agentplane/protocol:event_pb2",
        "@pypi//protobuf",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
