# gazelle:resolve py agentplane.env.firecracker.management_pb2 //agentplane/env/firecracker:management_pb2
load("@aspect_rules_py//py:defs.bzl", "py_image_layer", aspect_py_binary = "py_binary")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//devinfra/oci:defs.bzl", "oci_layout_rloc")
load("//devinfra/oci:py_image.bzl", "py_image_entrypoint", "py_image_env")
load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

py_library(
    name = "config",
    srcs = ["config.py"],
    visibility = [
        "//agentplane:__subpackages__",
        "//cluster/cdk8s/agentplane:__pkg__",
    ],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "credentials",
    srcs = ["credentials.py"],
)

py_library(
    name = "firecracker_api",
    srcs = ["firecracker_api.py"],
)

py_library(
    name = "network",
    srcs = ["network.py"],
)

py_library(
    name = "storage",
    srcs = ["storage.py"],
    deps = [
        ":config",
        ":credentials",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "guest_management",
    srcs = ["guest_management.py"],
    deps = [
        ":credentials",
        "//agentplane/env/firecracker:management_pb2",
        "@pypi//protobuf",  # keep: mypy follows generated protobuf interfaces
        "@pypi//types_protobuf",  # keep: mypy follows generated protobuf interfaces
    ],
)

py_library(
    name = "supervisor",
    srcs = ["supervisor.py"],
    deps = [
        ":config",
        ":firecracker_api",
        ":guest_management",
        ":network",
        ":storage",
    ],
)

py_binary(
    name = "supervisor_bin",
    main_module = "agentplane.firecracker.supervisor",
    deps = [":supervisor"],
)

aspect_py_binary(
    name = "launcher_image_bin",
    main = "supervisor.py",
    deps = [":supervisor"],
)

py_image_layer(
    name = "layers",
    binary = ":launcher_image_bin",
)

pkg_tar(
    name = "firecracker_layer",
    srcs = ["@firecracker_agentplane_release//:release-v1.17.0-x86_64/firecracker-v1.17.0-x86_64"],
    mode = "0755",
    package_dir = "/usr/local/bin",
    remap_paths = {"release-v1.17.0-x86_64/firecracker-v1.17.0-x86_64": "firecracker"},
)

pkg_tar(
    name = "runtime_tool_links",
    symlinks = {
        "/usr/local/bin/firecracker": "firecracker-v1.17.0-x86_64",
        "/usr/sbin/ip6tables": "ip6tables-nft",
        "/usr/sbin/iptables": "iptables-nft",
    },
)

pkg_tar(
    name = "guest_client_layer",
    srcs = ["//agentplane/env/firecracker/cmd/guest_client:agentplane-firecracker-guest-client"],
    mode = "0755",
    package_dir = "/usr/local/bin",
)

oci_image(
    name = "image",
    base = "@debian_trixie_slim_linux_amd64",
    entrypoint = py_image_entrypoint("launcher_image_bin"),
    env = py_image_env(
        binary_name = "launcher_image_bin",
        extra_env = {
            "PATH": "/agentplane/firecracker/launcher_image_bin.runfiles/.launcher_image_bin.venv/bin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
            "RUNFILES_DIR": "/agentplane/firecracker/launcher_image_bin.runfiles",
            "RUNFILES_MANIFEST_FILE": "",
        },
    ),
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [
        "@trixie_agentplane_firecracker//:flat",
        ":layers",
        ":firecracker_layer",
        ":runtime_tool_links",
        ":guest_client_layer",
    ],
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["agentplane-firecracker-launcher:proof"],
)

filegroup(
    name = "load_tarball",
    srcs = [":load"],
    output_group = "tarball",
    visibility = ["//visibility:public"],
)

oci_layout_rloc(
    name = "test_image_layout",
    testonly = True,
    image = ":image",
)

py_test(
    name = "test_image",
    size = "medium",
    srcs = ["test_image.py"],
    data = [":test_image_layout"],
    requires_docker = True,
    deps = [
        "//:conftest",
        "//util:oci",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_credentials",
    srcs = ["test_credentials.py"],
    deps = [
        ":credentials",
        "//:conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_network",
    srcs = ["test_network.py"],
    deps = [
        ":network",
        "//:conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_storage",
    srcs = ["test_storage.py"],
    deps = [
        ":config",
        ":storage",
        "//:conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_supervisor",
    srcs = ["test_supervisor.py"],
    deps = [
        ":config",
        ":network",
        ":storage",
        ":supervisor",
        "//:conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
