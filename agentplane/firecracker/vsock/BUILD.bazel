load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = [
    "//agentplane/env/firecracker:__pkg__",
    "//agentplane/firecracker:__pkg__",
])

go_library(
    name = "vsock",
    srcs = [
        "dial.go",
        "reverse.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/firecracker/vsock",
)

go_test(
    name = "vsock_test",
    srcs = [
        "dial_test.go",
        "reverse_test.go",
    ],
    embed = [":vsock"],
    deps = [
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//credentials/insecure",
        "@org_golang_google_grpc//health",
        "@org_golang_google_grpc//health/grpc_health_v1",
    ],
)
