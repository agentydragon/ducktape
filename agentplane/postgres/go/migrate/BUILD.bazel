load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//agentplane:__subpackages__"])

go_library(
    name = "migrate",
    srcs = ["migrate.go"],
    importpath = "github.com/agentydragon/ducktape/agentplane/postgres/go/migrate",
    deps = [
        "@com_github_lib_pq//:pq",
        "@com_github_sethvargo_go_retry//:go-retry",
    ],
)

go_test(
    name = "migrate_test",
    size = "medium",
    srcs = ["migrate_test.go"],
    embed = [":migrate"],
    tags = ["requires_docker"],
    deps = ["//agentplane/testing/postgres"],
)
