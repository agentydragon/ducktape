load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//devinfra/go:defs.bzl", "go_test")

package(default_visibility = ["//agentplane:__subpackages__"])

go_library(
    name = "lease",
    srcs = ["lease.go"],
    importpath = "github.com/agentydragon/ducktape/agentplane/postgres/go/lease",
    deps = [
        "@com_github_google_uuid//:uuid",
        "@com_github_lib_pq//:pq",
    ],
)

go_test(
    name = "integration_test",
    size = "medium",
    srcs = [
        "integration_testmain_test.go",
        "lease_test.go",
    ],
    embed = [":lease"],
    tags = ["requires_docker"],
    deps = [
        "//agentplane/testing/postgres",
        "@com_github_google_uuid//:uuid",
        "@com_github_lib_pq//:pq",
    ],
)
