load("@io_bazel_rules_go//go:def.bzl", "go_binary")

package(
    default_testonly = True,
    default_visibility = ["//agentplane:__subpackages__"],
)

go_binary(
    name = "adapter_bin",
    srcs = ["main.go"],
    deps = [
        "//agentplane/proto:execution_go_proto",
        "//agentplane/runner:runner_exec_go_proto",
        "//agentplane/runner/execution",
        "@org_golang_google_grpc//:grpc",
    ],
)
