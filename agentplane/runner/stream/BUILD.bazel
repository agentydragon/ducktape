load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//agentplane/runner:__subpackages__"])

go_library(
    name = "stream",
    srcs = ["retry.go"],
    importpath = "github.com/agentydragon/ducktape/agentplane/runner/stream",
    deps = [
        "@com_github_sethvargo_go_retry//:go-retry",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_uber_go_zap//:zap",
    ],
)

go_test(
    name = "stream_test",
    srcs = ["retry_test.go"],
    embed = [":stream"],
    race = "on",
    deps = [
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
    ],
)
