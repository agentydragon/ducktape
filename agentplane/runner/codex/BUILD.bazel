load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//devinfra/go:defs.bzl", "go_test")

go_library(
    name = "codex",
    srcs = [
        "adapter.go",
        "history.go",
        "router.go",
        "server.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/runner/codex",
    visibility = [
        "//agentplane/runner:__pkg__",
        "//agentplane/runner:__subpackages__",
    ],
    deps = [
        "//agentplane/proto:event_go_proto",
        "//agentplane/runner/codex/protocol",
        "//agentplane/runner/harness",
        "//agentplane/runner/jsonrpc",
        "@com_github_google_uuid//:uuid",
    ],
)

go_test(
    name = "codex_test",
    srcs = [
        "adapter_test.go",
        "history_test.go",
        "router_test.go",
    ],
    embed = [":codex"],
    deps = [
        "//agentplane/proto:event_go_proto",
        "//agentplane/runner/codex/protocol",
        "//agentplane/runner/harness",
    ],
)
