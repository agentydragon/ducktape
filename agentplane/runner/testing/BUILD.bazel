load("//devinfra/python:defs.bzl", "py_library")

package(
    default_testonly = True,
    default_visibility = ["//agentplane:__subpackages__"],
)

py_library(
    name = "claude_model",
    srcs = ["claude_model.py"],
    deps = [
        ":scripted_model",
        "//agentplane/harness_tests:model_endpoint",
        "//agentplane/harness_tests/claude:anthropic_sse",
        "//agentplane/harness_tests/claude:harness",
        "//agentplane/harness_tests/claude:messages",
        "//agentplane/harness_tests/claude:requests",
    ],
)

py_library(
    name = "codex_model",
    srcs = ["codex_model.py"],
    deps = [
        ":scripted_model",
        "//agentplane/harness_tests:model_endpoint",
        "//agentplane/harness_tests/codex:harness",
        "//agentplane/harness_tests/codex:requests",
        "//agentplane/harness_tests/codex:responses",
        "//agentplane/harness_tests/codex:responses_sse",
    ],
)

py_library(
    name = "events",
    srcs = ["events.py"],
    deps = [
        "//agentplane/protocol:event_log_pb2",
        "//agentplane/protocol:event_pb2",
        "@pypi//protobuf",
    ],
)

py_library(
    name = "launches",
    srcs = ["launches.py"],
    deps = [
        "//agentplane/harness_tests/claude:harness",
        "//agentplane/harness_tests/codex:harness",
        "//agentplane/runner:config",
        "//agentplane/runner:protocol_pb2",
        "//util/bazel:runfiles",
        "@pypi//protobuf",
    ],
)

py_library(
    name = "scripted_model",
    srcs = ["scripted_model.py"],
    deps = ["//agentplane/harness_tests:model_endpoint"],
)

py_library(
    name = "storage_image",
    srcs = ["storage_image.py"],
)
