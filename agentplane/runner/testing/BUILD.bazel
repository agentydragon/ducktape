load("//devinfra/python:defs.bzl", "py_library")

package(
    default_testonly = True,
    default_visibility = ["//agentplane:__subpackages__"],
)

py_library(
    name = "claude_transcript",
    srcs = ["claude_transcript.py"],
)

py_library(
    name = "config",
    srcs = ["config.py"],
    deps = ["//agentplane/sandboxes:launch"],
)

py_library(
    name = "events",
    srcs = ["events.py"],
    deps = [
        "//agentplane/proto:event_log_pb2",
        "//agentplane/proto:event_pb2",
        "@pypi//protobuf",
    ],
)

py_library(
    name = "failure_journal",
    srcs = ["failure_journal.py"],
    deps = [
        ":process",
        "//util/testing:undeclared_outputs",
        "@pypi//protobuf",
        "@pypi//pytest",
    ],
)

py_library(
    name = "fixtures",
    srcs = ["fixtures.py"],
    deps = [
        ":config",
        ":driver",
        ":failure_journal",
        ":gateway",
        ":launches",
        ":process",
        "//agentplane/history_service/testing:go_service",
        "//agentplane/native/claude/testing:messages",
        "//agentplane/native/codex/testing:responses",
        "//agentplane/proto:runner_pb2",
        "//agentplane/runner:configuration",
        "//agentplane/testing:claude_model",
        "//agentplane/testing:codex_model",
        "//agentplane/testing:scripted_model",
        "@pypi//protobuf",
        "@pypi//pytest",
    ],
)

py_library(
    name = "launches",
    srcs = ["launches.py"],
    data = [
        "@agentplane_codex_cli_linux_x64//:files",  # keep: native executable selected by the test launch
        "@claude_code_cli_linux_x64//:claude",  # keep: native executable selected by the test launch
    ],
    deps = [
        ":config",
        "//agentplane/native/claude/testing:model",
        "//agentplane/native/codex/testing:model",
        "//agentplane/proto:runner_pb2",
        "//agentplane/runner:configuration",
        "//agentplane/sandboxes:launch",
        "//util/bazel:runfiles",
        "@pypi//protobuf",
    ],
)

py_library(
    name = "driver",
    srcs = ["driver.py"],
    deps = [
        ":config",
        ":gateway",
        ":process",
        "//agentplane/grpc:calls",
        "//agentplane/history_service:client",
        "//agentplane/history_service:history_service_pb2",
        "//agentplane/history_service:settled_cursors",
        "//agentplane/history_service/testing:go_service",
        "//agentplane/proto:event_log_pb2",
        "//agentplane/proto:runner_pb2",
        "//agentplane/runner:configuration",
        "//agentplane/runner:runner_service_pb2",
        "//agentplane/runner:runner_service_pb2_grpc",
        "//agentplane/runner_gateway:runner_control_pb2",
        "@pypi//grpcio",
        "@pypi//protobuf",
        "@pypi//pytest",
    ],
)

py_library(
    name = "gateway",
    srcs = ["gateway.py"],
    deps = [
        "//agentplane/grpc:tunnel",
        "//agentplane/proto:grpc_tunnel_pb2",
        "//agentplane/runner:configuration",
        "//agentplane/runner:runner_service_pb2_grpc",
        "//agentplane/runner_gateway:runner_control_pb2",
        "//agentplane/runner_gateway:runner_control_pb2_grpc",
        "//agentplane/testing:tls",
        "@pypi//grpcio",
        "@pypi//protobuf",
    ],
)

py_library(
    name = "process_fixtures",
    srcs = ["process_fixtures.py"],
    deps = [
        ":gateway",
        ":launches",
        "//agentplane/history_service/testing:go_service",
        "//agentplane/native/claude/testing:messages",
        "//agentplane/native/codex/testing:responses",
        "//agentplane/proto:runner_pb2",
        "//agentplane/runner:configuration",
        "@pypi//protobuf",
        "@pypi//pytest",
    ],
)

py_library(
    name = "process",
    srcs = ["process.py"],
    data = ["//agentplane/runner/cmd:agentplane-runner"],  # keep: the production subprocess
    deps = [
        ":config",
        ":gateway",
        ":launches",
        ":process_fixtures",
        "//agentplane/history_service:client",
        "//agentplane/proto:event_log_pb2",
        "//agentplane/proto:runner_pb2",
        "//agentplane/runner:configuration",
        "//agentplane/runner:runner_service_pb2_grpc",
        "//util/testing:undeclared_outputs",
        "@pypi//grpcio",  # keep: mypy follows the generated Runner control stub
        "@pypi//protobuf",  # keep: mypy follows generated protobuf interfaces
    ],
)

py_library(
    name = "codex_exec_server_container",
    srcs = ["codex_exec_server_container.py"],
    data = [
        "//agentplane/runner/cmd:agentplane-runner",  # keep: production executor-mode executable
        "@agentplane_codex_cli_linux_x64//:files",  # keep: pinned exec-server executable
    ],
    deps = [
        ":launches",
        "//third_party/containers:debian_slim",
        "//util:oci",
        "//util/bazel:runfiles",
        "//util/testing:container_logs",
        "@pypi//pytest",
    ],
)
