# The runner release (devinfra/ci/artifact_targets.json), which the Nix-built runner image installs
# beside nixpkgs' Claude Code and Codex. The harness supervisor rides inside the wheel next to the
# module that starts it, so the wheel is Linux x86_64 only.
py_package(
    name = "runner_pkg",
    packages = ["agentplane"],
    deps = [
        ":guest_config",
        ":main",
    ],
)

py_wheel(
    name = "runner_wheel",
    distribution = "agentplane_runner",
    entry_points = {
        "console_scripts": [
            "agentplane-runner = agentplane.runner.main:app",
            "agentplane-runner-vm = agentplane.runner.guest_config:main",
        ],
    },
    platform = "linux_x86_64",
    python_requires = ">=3.14",
    requires = [
        "aiosqlite",
        "grpcio",
        "httpx",
        # The generated *_pb2 modules refuse an older runtime than the protoc that wrote them.
        "protobuf>=7.36,<8",
        "pydantic>=2.0",
        "sqlalchemy[asyncio]>=2.0",
        "tenacity",
        "typer",
    ],
    version = "0.1.0",
    deps = [":runner_pkg"],
)

