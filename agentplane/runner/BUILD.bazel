# The runner image: the runner, both pinned native harnesses, and the tools they reach for, on
# debian slim as user 1000. Published as agentplane-runner (devinfra/ci/image_targets.json) and run
# by the agentplane-runner SandboxTemplate (cluster/k8s/agentplane-staging).
aspect_py_binary(
    name = "runner_image_bin",
    main = "main.py",
    deps = [":main"],
)

py_image_layer(
    name = "runner_layers",
    binary = ":runner_image_bin",
    group = "1000",
    owner = "1000",
)

pkg_files(
    name = "claude_files",
    srcs = ["@claude_code_cli_linux_x64//:claude"],
    attributes = pkg_attributes(
        gid = 1000,
        group = "runner",
        mode = "0555",
        uid = 1000,
        user = "runner",
    ),
    prefix = "/usr/local/bin",
)

# The native Codex executable locates its bundled rg/zsh/bwrap resources relative to itself, so the
# whole distribution tree is kept.
pkg_files(
    name = "codex_files",
    srcs = ["@agentplane_codex_cli_linux_x64//:files"],
    attributes = pkg_attributes(
        gid = 1000,
        group = "runner",
        mode = "0555",
        uid = 1000,
        user = "runner",
    ),
    prefix = "/opt/codex",
    strip_prefix = strip_prefix.from_root(""),
)

pkg_mkdirs(
    name = "home_dir",
    attributes = pkg_attributes(
        gid = 1000,
        group = "runner",
        mode = "0755",
        uid = 1000,
        user = "runner",
    ),
    dirs = ["/home/runner"],
)

pkg_tar(
    name = "harness_layer",
    srcs = [
        ":claude_files",
        ":codex_files",
        ":home_dir",
    ],
)

RUNNER_ENTRYPOINT = py_image_entrypoint("runner_image_bin")

RUNNER_ENV = py_image_env(
    binary_name = "runner_image_bin",
    extra_env = {
        "HOME": "/home/runner",
        "SSL_CERT_FILE": "/etc/ssl/certs/ca-certificates.crt",
    },
)

RUNNER_USER = "1000:1000"

oci_image(
    name = "image",
    base = "@debian_trixie_slim_linux_amd64",
    entrypoint = RUNNER_ENTRYPOINT,
    env = RUNNER_ENV,
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [
        ":runner_layers",
        ":harness_layer",
        "//third_party/debian_slim:cacerts",
        "@trixie_agentplane_runner//:flat",
    ],
    user = RUNNER_USER,
)

# The runner release (devinfra/ci/artifact_targets.json): what this image adds to its base, as
# one tarball, and the image config that runs it. The Nix-built runner image lays both over the
# sandbox image's tools.
pkg_tar(
    name = "runner_release",
    extension = "tar.gz",
    deps = [
        ":harness_layer",
        ":runner_layers",
    ],
)

write_file(
    name = "runner_image_config",
    out = "runner_image_config.json",
    content = [json.encode({
        "Entrypoint": RUNNER_ENTRYPOINT,
        "Env": ["%s=%s" % item for item in RUNNER_ENV.items()],
        "User": RUNNER_USER,
    })],
)

oci_layout_rloc(
    name = "image_rloc",
    testonly = True,
    image = ":image",
)

