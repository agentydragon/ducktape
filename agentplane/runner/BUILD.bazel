package(default_visibility = ["//visibility:public"])

alias(
    name = "main_bin",
    actual = "//agentplane/runner/go/cmd:agentplane-runner",
)

# The runner and `agentplane` CLI, in one image that a Pod mounts as an image volume (`bin/`) and a
# runner VM attaches as a KubeVirt containerDisk (`disk/runner.img`, an erofs of the same `bin/`).
# The guest executes `agentplane-runner-vm`.
pkg_tar(
    name = "disk_bin",
    srcs = [
        "//agentplane/cli:agentplane",
        "//agentplane/runner/go/cmd:agentplane-runner",
    ],
    mode = "0755",
    package_dir = "/bin",
    symlinks = {"agentplane-runner-vm": "agentplane-runner"},
)

erofs_image(
    name = "disk_erofs",
    out = "runner.img",
    tar = ":disk_bin",
    volume_label = "agentplane",
)

# KubeVirt's qemu reads the containerDisk as uid 107.
pkg_tar(
    name = "disk_img",
    srcs = [":disk_erofs"],
    mode = "0644",
    owner = "107.107",
    package_dir = "/disk",
)

oci_image(
    name = "disk_image",
    architecture = "amd64",
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    os = "linux",
    tars = [
        ":disk_bin",
        ":disk_img",
    ],
    user = "107:107",
)

