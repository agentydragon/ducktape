load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("//agentplane/runner/testing:exec_properties.bzl", "NATIVE_RUNNER_EXEC_PROPERTIES")
load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

alias(
    name = "main_bin",
    actual = "//agentplane/runner/go/cmd:agentplane-runner",
)

copy_file(
    name = "runner_release",
    src = "//agentplane/runner/go/cmd:agentplane-runner",
    out = "agentplane-runner",
    is_executable = True,
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    deps = [
        "//agentplane/runner/testing:failure_journal",
        "//agentplane/runner/testing:fixtures",
        "//agentplane/runner/testing:process_fixtures",
    ],
)

py_test(
    name = "test_attach",
    size = "large",
    srcs = ["test_attach.py"],
    data = [
        "@agentplane_codex_cli_linux_x64//:files",  # keep: the pinned native harnesses the runner drives
        "@claude_code_cli_linux_x64//:claude",  # keep: the pinned native harnesses the runner drives
    ],
    exec_properties = NATIVE_RUNNER_EXEC_PROPERTIES,
    target_compatible_with = [
        # keep: the pinned native harnesses are Linux/x86_64 only.
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    deps = [
        ":conftest",
        "//:conftest",
        "//agentplane/proto:event_pb2",
        "//agentplane/proto:runner_pb2",
        "//agentplane/runner/testing:driver",
        "//agentplane/runner/testing:events",
        "//agentplane/runner/testing:process",
        "//agentplane/runner/testing:scripted_model",
        "@pypi//grpcio",
        "@pypi//protobuf",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_native_resources",
    size = "medium",
    srcs = ["test_native_resources.py"],
    data = [
        "@agentplane_codex_cli_linux_x64//:files",  # keep: actual pinned native harness process
        "@claude_code_cli_linux_x64//:claude",  # keep: actual pinned native harness process
    ],
    exec_properties = NATIVE_RUNNER_EXEC_PROPERTIES,
    shard_count = 2,
    target_compatible_with = [
        "@platforms//cpu:x86_64",  # keep: pinned harness binaries
        "@platforms//os:linux",  # keep: kernel process accounting
    ],
    deps = [
        ":conftest",
        "//:conftest",
        "//agentplane/proto:event_pb2",
        "//agentplane/proto:runner_pb2",
        "//agentplane/runner/testing:config",
        "//agentplane/runner/testing:driver",
        "//agentplane/runner/testing:events",
        "//agentplane/runner/testing:gateway",
        "//agentplane/runner/testing:scripted_model",
        "//util/testing:undeclared_outputs",
        "@pypi//protobuf",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

