load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "codexappserver",
    srcs = [
        "controller.go",
        "host.go",
        "operation.go",
        "resources.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/runner/codexappserver",
    visibility = [
        "//agentplane/runner:__pkg__",
        "//agentplane/runner/configuration:__pkg__",
        "//agentplane/runner/session:__pkg__",
    ],
    deps = [
        "//agentplane/observability",
        "//agentplane/proto:runner_go_proto",
        "//agentplane/runner/codex",
        "//agentplane/runner/codexexecserver",
        "//agentplane/runner/cosi",
        "//agentplane/runner/harness",
        "//agentplane/runner/lifecycle",
        "//agentplane/runner/operation",
        "//agentplane/runner/supervision",
        "@com_github_cosi_project_runtime//pkg/controller",
        "@com_github_cosi_project_runtime//pkg/resource",
        "@com_github_cosi_project_runtime//pkg/resource/meta/spec",
        "@com_github_cosi_project_runtime//pkg/resource/typed",
        "@com_github_cosi_project_runtime//pkg/safe",
        "@com_github_cosi_project_runtime//pkg/state",
        "@com_github_siderolabs_gen//optional",
        "@io_opentelemetry_go_otel//attribute",
        "@io_opentelemetry_go_otel_trace//:trace",
        "@org_uber_go_zap//:zap",
    ],
)

go_test(
    name = "codexappserver_test",
    srcs = ["host_test.go"],
    embed = [":codexappserver"],
    race = "on",
    deps = [
        "//agentplane/runner/harness",
        "//agentplane/runner/lifecycle",
