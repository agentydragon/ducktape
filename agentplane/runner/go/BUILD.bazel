load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "runner",
    srcs = glob(
        ["*.go"],
        exclude = ["*_test.go"],
    ),
    importpath = "github.com/agentydragon/ducktape/agentplane/runner/go",
    deps = [
        "//agentplane/proto:command_go_proto",
        "//agentplane/proto:event_go_proto",
        "//agentplane/proto:event_log_go_proto",
        "//agentplane/proto:runner_go_proto",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/timestamppb",
        "@org_modernc_sqlite//:sqlite",
    ],
)

go_test(
    name = "runner_test",
    srcs = glob(["*_test.go"]),
    embed = [":runner"],
    deps = [
        "//agentplane/proto:command_go_proto",
        "//agentplane/proto:event_go_proto",
        "//agentplane/proto:event_log_go_proto",
        "//agentplane/proto:runner_go_proto",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
    ],
)
