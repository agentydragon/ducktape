load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//devinfra/go:defs.bzl", "go_test")

package(default_visibility = ["//agentplane/runner/executor:__subpackages__"])

go_library(
    name = "executor",
    srcs = ["main.go"],
    importpath = "github.com/agentydragon/ducktape/agentplane/runner/executor",
    visibility = [
        "//agentplane/runner:__pkg__",
        "//agentplane/runner/cmd:__pkg__",
    ],
    deps = [
        "//agentplane/runner/executor/control",
        "//agentplane/runner/supervision",
        "@com_github_google_uuid//:uuid",
        "@org_golang_x_sync//errgroup",
    ],
)

go_test(
    name = "executor_test",
    srcs = [
        "health_test.go",
        "main_test.go",
    ],
    embed = [":executor"],
    deps = [
        "//agentplane/runner/executor/control",
        "//agentplane/runner/supervision",
    ],
)
