load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//agentplane/runner/executor:__subpackages__"])

go_library(
    name = "executor",
    srcs = ["main.go"],
    importpath = "github.com/agentydragon/ducktape/agentplane/runner/executor",
    deps = [
        "//agentplane/runner/executor/control",
        "@com_github_google_uuid//:uuid",
        "@org_golang_x_sync//errgroup",
        "@org_golang_x_sys//unix",
    ],
)

go_test(
    name = "executor_test",
    srcs = [
        "health_test.go",
        "main_test.go",
    ],
    embed = [":executor"],
    deps = ["//agentplane/runner/executor/control"],
)
