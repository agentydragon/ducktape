load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//devinfra/go:defs.bzl", "go_test")

go_library(
    name = "claude",
    srcs = [
        "adapter.go",
        "history.go",
        "protocol.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/runner/claude",
    visibility = [
        "//agentplane/runner:__pkg__",
        "//agentplane/runner:__subpackages__",
    ],
    deps = [
        "//agentplane/proto:event_go_proto",
        "//agentplane/runner/harness",
        "@com_github_anthropics_anthropic_sdk_go//:anthropic-sdk-go",
        "@com_github_google_uuid//:uuid",
        "@com_github_schlunsen_claude_agent_sdk_go//types",
    ],
)

go_test(
    name = "claude_test",
    srcs = ["protocol_test.go"],
    embed = [":claude"],
    deps = ["@com_github_anthropics_anthropic_sdk_go//:anthropic-sdk-go"],
)
