load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")
load("//devinfra/python:defs.bzl", "RYUK_TAG")
load("//third_party/containers:images.bzl", "POSTGRES_18_TAG")

go_library(
    name = "postgres",
    testonly = True,
    srcs = [
        "electric.go",
        "postgres.go",
    ],
    data = [
        "//devinfra/oci:oci_load_bin",
        "@postgres_18_linux_amd64",
        "@ryuk_linux_amd64",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/testing/postgres",
    visibility = ["//agentplane:__subpackages__"],
    x_defs = {
        "github.com/agentydragon/ducktape/agentplane/testing/postgres.loaderRlocation": "$(rlocationpath //devinfra/oci:oci_load_bin)",
        "github.com/agentydragon/ducktape/agentplane/testing/postgres.postgresImage": POSTGRES_18_TAG,
        "github.com/agentydragon/ducktape/agentplane/testing/postgres.postgresRlocation": "$(rlocationpath @postgres_18_linux_amd64)",
        "github.com/agentydragon/ducktape/agentplane/testing/postgres.ryukImage": RYUK_TAG,
        "github.com/agentydragon/ducktape/agentplane/testing/postgres.ryukRlocation": "$(rlocationpath @ryuk_linux_amd64)",
    },
    deps = [
        "@com_github_lib_pq//:pq",
        "@com_github_testcontainers_testcontainers_go//:testcontainers-go",
        "@com_github_testcontainers_testcontainers_go//wait",
        "@io_bazel_rules_go//go/runfiles",
    ],
)

go_test(
    name = "postgres_test",
    srcs = ["postgres_test.go"],
    embed = [":postgres"],
)
