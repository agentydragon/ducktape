load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "postgres",
    testonly = True,
    srcs = [
        "electric.go",
        "postgres.go",
    ],
    data = [
        "//devinfra/oci:oci_load_bin",
        "//third_party/containers:postgres_18_rloc",
        "//third_party/containers:ryuk_rloc",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/testing/postgres",
    visibility = ["//agentplane:__subpackages__"],
    x_defs = {
        "github.com/agentydragon/ducktape/agentplane/testing/postgres.loaderRlocation": "$(rlocationpath //devinfra/oci:oci_load_bin)",
        "github.com/agentydragon/ducktape/agentplane/testing/postgres.postgresRlocation": "$(rlocationpath //third_party/containers:postgres_18_rloc)",
        "github.com/agentydragon/ducktape/agentplane/testing/postgres.ryukRlocation": "$(rlocationpath //third_party/containers:ryuk_rloc)",
    },
    deps = [
        "@com_github_lib_pq//:pq",
        "@com_github_testcontainers_testcontainers_go//:testcontainers-go",
        "@com_github_testcontainers_testcontainers_go//wait",
        "@io_bazel_rules_go//go/runfiles",
    ],
)

go_test(
    name = "postgres_test",
    srcs = ["postgres_test.go"],
    embed = [":postgres"],
)
