load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")

package(default_testonly = True)

go_library(
    name = "server_lib",
    srcs = ["main.go"],
    importpath = "github.com/agentydragon/ducktape/agentplane/testing/envtest",
    visibility = ["//visibility:private"],
    deps = [
        "@io_k8s_sigs_controller_runtime//pkg/envtest",
    ],
)

go_binary(
    name = "server",
    embed = [":server_lib"],
    visibility = ["//agentplane/testing:__pkg__"],
)
