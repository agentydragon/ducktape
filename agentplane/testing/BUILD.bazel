load("//devinfra/python:defs.bzl", "py_library")

package(
    default_testonly = True,
    default_visibility = [
        "//agentplane/action_service:__pkg__",
        "//agentplane/app:__pkg__",
        "//agentplane/app/testing:__pkg__",
        "//agentplane/app/threads:__pkg__",
        "//agentplane/crds:__pkg__",
        "//agentplane/egress:__pkg__",
        "//agentplane/egress/testing:__pkg__",
        "//agentplane/history_service/testing:__pkg__",
        "//agentplane/llm_ingress:__pkg__",
        "//agentplane/runner:__subpackages__",
        "//agentplane/runner_gateway:__subpackages__",
        "//agentplane/sandboxes:__subpackages__",
        "//agentplane/system_tests:__pkg__",
        "//agentplane/system_tests/k3s:__pkg__",
        "//agentplane/x/runner_layering:__pkg__",
        "//cluster/cdk8s/agentplane:__pkg__",
    ],
)

py_library(
    name = "electric_role",
    srcs = ["electric_role.py"],
    deps = [
        "@pypi//psycopg",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "kubernetes_apiserver",
    srcs = ["kubernetes_apiserver.py"],
    data = [
        "//agentplane/crds",  # keep: envtest installs these at startup
        "//agentplane/testing/envtest:server",  # keep: fixture subprocess
        "@envtest_kubernetes_linux_amd64//:assets",  # keep: pinned control-plane executables
    ],
    deps = [
        "//agentplane:subjects",
        "//util/bazel:runfiles",
        "//util/testing:undeclared_outputs",
        "@pypi//kubernetes_asyncio",
    ],
)

py_library(
    name = "go_process",
    srcs = ["go_process.py"],
    deps = [
        "@pypi//grpcio",
        "@pypi//grpcio_health_checking",
        "@pypi//protobuf",
        "@pypi//tenacity",
    ],
)

py_library(
    name = "claude_model",
    srcs = ["claude_model.py"],
    deps = [
        ":scripted_model",
        "//agentplane/native/claude:blocks",
        "//agentplane/native/claude/testing:anthropic_sse",
        "//agentplane/native/claude/testing:messages",
        "//agentplane/native/claude/testing:model",
        "//agentplane/native/claude/testing:requests",
        "//agentplane/native/testing:model_endpoint",
    ],
)

py_library(
    name = "codex_model",
    srcs = ["codex_model.py"],
    deps = [
        ":scripted_model",
        "//agentplane/native/codex/testing:model",
        "//agentplane/native/codex/testing:requests",
        "//agentplane/native/codex/testing:responses",
        "//agentplane/native/codex/testing:responses_sse",
        "//agentplane/native/testing:model_endpoint",
    ],
)

py_library(
    name = "scripted_model",
    srcs = ["scripted_model.py"],
    deps = ["//agentplane/native/testing:model_endpoint"],
)

py_library(
    name = "tls",
    srcs = ["tls.py"],
    deps = ["@pypi//cryptography"],
)

py_library(
    name = "kubernetes_apiserver_fixtures",
    srcs = ["kubernetes_apiserver_fixtures.py"],
    deps = [
        ":kubernetes_apiserver",
        "@pypi//pytest",
    ],
)
