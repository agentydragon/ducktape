load("//devinfra/python:defs.bzl", "py_library")

package(
    default_testonly = True,
    default_visibility = [
        "//agentplane/action_service:__pkg__",
        "//agentplane/app:__pkg__",
        "//agentplane/crds:__pkg__",
        "//agentplane/egress:__pkg__",
        "//agentplane/history_service:__pkg__",
        "//agentplane/history_service/migrations:__pkg__",
        "//agentplane/history_service/testing:__pkg__",
        "//agentplane/llm_ingress:__pkg__",
        "//agentplane/notification_service:__pkg__",
        "//agentplane/runner_gateway:__subpackages__",
        "//agentplane/sandboxes:__subpackages__",
    ],
)

py_library(
    name = "fake_apiserver",
    srcs = ["fake_apiserver.py"],
    deps = [
        "//agentplane:crd_group",
        "//agentplane:policy_sets",
        "//agentplane:sandbox_resource",
        "//agentplane/egress:resources",
        "//agentplane/workload_auth:principal",
        "@pypi//aiohttp",
        "@pypi//more_itertools",
    ],
)

py_library(
    name = "electric_role",
    srcs = ["electric_role.py"],
    deps = [
        "@pypi//psycopg",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "agent_docs",
    srcs = ["agent_docs.py"],
    deps = ["@pypi//httpx"],
)

py_library(
    name = "kubernetes_apiserver",
    srcs = ["kubernetes_apiserver.py"],
    data = [
        "//agentplane/crds",  # keep: envtest installs these at startup
        "//agentplane/testing/envtest:server",  # keep: fixture subprocess
        "@envtest_kubernetes_linux_amd64//:assets",  # keep: pinned control-plane executables
    ],
    deps = [
        "//util/bazel:runfiles",
        "//util/testing:undeclared_outputs",
        "@pypi//kubernetes_asyncio",
    ],
)
