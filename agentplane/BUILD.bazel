package(default_visibility = ["//agentplane:__subpackages__"])

py_library(
    name = "grpc_options",
    srcs = ["grpc_options.py"],
    visibility = [
        "//agentplane:__subpackages__",
        "//cluster/cdk8s/agentplane:__pkg__",
    ],
)

py_library(
    name = "kubernetes_watch",
    srcs = ["kubernetes_watch.py"],
)

py_library(
    name = "subjects",
    srcs = ["subjects.py"],
    visibility = [
        "//agentplane:__subpackages__",
        "//cluster/cdk8s/agentplane:__pkg__",
    ],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "crd_group",
    srcs = ["crd_group.py"],
    # Also the cluster validation that reads the checked-in manifests by apiVersion.
    visibility = [
        "//agentplane:__subpackages__",
        "//cluster/validation:__pkg__",
    ],
)

py_library(
    name = "grpc_process",
    srcs = ["grpc_process.py"],
    deps = ["@pypi//kubernetes_asyncio"],
)

py_library(
    name = "grpc_serving",
    srcs = ["grpc_serving.py"],
    deps = [
        "@pypi//grpcio",
        "@pypi//grpcio_health_checking",
        "@pypi//protobuf",
    ],
)
