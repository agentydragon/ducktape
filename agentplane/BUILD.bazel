package(default_visibility = ["//agentplane:__subpackages__"])

py_library(
    name = "changes",
    srcs = ["changes.py"],
)

py_library(
    name = "grpc_options",
    srcs = ["grpc_options.py"],
    visibility = [
        "//agentplane:__subpackages__",
        "//cluster/cdk8s/agentplane:__pkg__",
    ],
)

py_library(
    name = "grpc_calls",
    srcs = ["grpc_calls.py"],
    deps = [
        ":grpc_options",
        "//agentplane/runner:errors",
        "@pypi//grpcio",
        "@pypi//protobuf",
    ],
)

py_library(
    name = "kubernetes_watch",
    srcs = ["kubernetes_watch.py"],
)

py_library(
    name = "subjects",
    srcs = ["subjects.py"],
    visibility = [
        "//agentplane:__subpackages__",
        "//cluster/cdk8s/agentplane:__pkg__",
    ],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "crd_group",
    srcs = ["crd_group.py"],
    # Also the generators that write RBAC rules, labels and annotations under it, and the cluster
    # validation that reads the checked-in manifests by apiVersion.
    visibility = [
        "//agentplane:__subpackages__",
        "//cluster/cdk8s:__subpackages__",
        "//cluster/validation:__pkg__",
    ],
)

py_library(
    name = "grpc_serving",
    srcs = ["grpc_serving.py"],
    deps = [
        "@pypi//grpcio",
        "@pypi//grpcio_health_checking",
        "@pypi//protobuf",
    ],
)

py_library(
    name = "service_process",
    srcs = ["service_process.py"],
    deps = ["@pypi//kubernetes_asyncio"],
)

py_test(
    name = "test_service_process",
    srcs = ["test_service_process.py"],
    deps = [
        ":service_process",
        "//:conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
