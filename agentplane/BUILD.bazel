package(default_visibility = ["//agentplane:__subpackages__"])

py_library(
    name = "changes",
    srcs = ["changes.py"],
)

py_library(
    name = "sse",
    srcs = ["sse.py"],
    deps = ["@pypi//fastapi"],
)

py_library(
    name = "grpc_options",
    srcs = ["grpc_options.py"],
    visibility = [
        "//agentplane:__subpackages__",
        "//cluster/cdk8s/agentplane:__pkg__",
    ],
)

py_library(
    name = "grpc_calls",
    srcs = ["grpc_calls.py"],
    deps = [
        ":grpc_options",
        "@pypi//grpcio",
        "@pypi//protobuf",
    ],
)

py_library(
    name = "kubernetes_watch",
    srcs = ["kubernetes_watch.py"],
)

py_library(
    name = "subjects",
    srcs = ["subjects.py"],
    visibility = [
        "//agentplane:__subpackages__",
        "//cluster/cdk8s/agentplane:__pkg__",
    ],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "crd_group",
    srcs = ["crd_group.py"],
    # Also the generators that write RBAC rules, labels and annotations under it, and the cluster
    # validation that reads the checked-in manifests by apiVersion.
    visibility = [
        "//agentplane:__subpackages__",
        "//cluster/cdk8s:__subpackages__",
        "//cluster/validation:__pkg__",
    ],
)

py_library(
    name = "grpc_serving",
    srcs = ["grpc_serving.py"],
    deps = [
        "@pypi//grpcio",
        "@pypi//grpcio_health_checking",
        "@pypi//protobuf",
    ],
)

py_library(
    name = "grpc_tunnel",
    srcs = ["grpc_tunnel.py"],
    deps = [
        ":grpc_serving",
        "//agentplane/proto:grpc_tunnel_pb2",
        "@pypi//grpcio",
        "@pypi//protobuf",
    ],
)

py_library(
    name = "service_process",
    srcs = ["service_process.py"],
    deps = [
        ":log_levels",
        "@pypi//kubernetes_asyncio",
    ],
)

py_library(
    name = "policy_sets",
    srcs = ["policy_sets.py"],
    deps = [
        ":crd_group",
        ":subjects",
        "//util:kubernetes",
        "@pypi//kubernetes_asyncio",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "sandbox_resource",
    srcs = ["sandbox_resource.py"],
    deps = [
        ":crd_group",
        ":policy_sets",
        "//util:kubernetes",
        "@pypi//kubernetes_asyncio",
        "@pypi//pydantic",
    ],
)

py_test(
    name = "test_policy_sets",
    srcs = ["test_policy_sets.py"],
    deps = [
        ":policy_sets",
        ":subjects",
        "//:conftest",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "grpc_servicer",
    srcs = ["grpc_servicer.py"],
    deps = [
        ":subjects",
        "//agentplane/workload_auth:grpc_caller",
        "//agentplane/workload_auth:principal",
        "@pypi//grpcio",
        "@pypi//kubernetes_asyncio",
    ],
)

py_library(
    name = "background_task",
    srcs = ["background_task.py"],
)

py_test(
    name = "test_background_task",
    srcs = ["test_background_task.py"],
    deps = [
        ":background_task",
        "//:conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "log_levels",
    srcs = ["log_levels.py"],
    deps = ["@pypi//pydantic"],
)

py_test(
    name = "test_service_process",
    srcs = ["test_service_process.py"],
    deps = [
        ":log_levels",
        ":service_process",
        "//:conftest",
        "@pypi//pydantic",
        "@pypi//pydantic_settings",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
