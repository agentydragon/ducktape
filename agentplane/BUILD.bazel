py_library(
    name = "tracing",
    srcs = ["tracing.py"],
    deps = [
        "@pypi//opentelemetry_api",
        "@pypi//opentelemetry_exporter_otlp_proto_grpc",
        "@pypi//opentelemetry_exporter_otlp_proto_http",
