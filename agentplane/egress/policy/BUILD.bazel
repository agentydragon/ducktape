load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//devinfra/go:defs.bzl", "go_test")

go_library(
    name = "policy",
    srcs = [
        "effective.go",
        "evaluate.go",
        "index.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/egress/policy",
    visibility = ["//agentplane/egress:__subpackages__"],
    deps = [
        "//agentplane/egress/decision",
        "//agentplane/egress/presentation",
        "//agentplane/egress/resources",
        "//agentplane/policy/api/v1alpha1",
        "//agentplane/policy/reader",
        "//agentplane/watchhealth",
    ],
)

go_test(
    name = "policy_test",
    srcs = [
        "effective_test.go",
        "evaluate_test.go",
    ],
    embed = [":policy"],
    deps = [
        "//agentplane/egress/decision",
        "//agentplane/egress/presentation",
        "//agentplane/egress/resources",
        "//agentplane/policy/api/v1alpha1",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
    ],
)
