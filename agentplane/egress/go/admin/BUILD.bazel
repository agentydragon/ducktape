load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "admin",
    srcs = ["admin.go"],
    importpath = "github.com/agentydragon/ducktape/agentplane/egress/go/admin",
    visibility = ["//agentplane/egress:__subpackages__"],
    deps = [
        "//agentplane/egress/go/decision",
        "//agentplane/egress/go/history",
    ],
)

go_test(
    name = "admin_test",
    srcs = ["admin_test.go"],
    embed = [":admin"],
    deps = [
        "//agentplane/egress/go/decision",
        "//agentplane/egress/go/history",
        "@com_github_google_uuid//:uuid",
    ],
)
