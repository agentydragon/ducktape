load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "proxy",
    srcs = [
        "gate.go",
        "lifecycle.go",
        "proxy.go",
        "tunnel.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/egress/go/proxy",
    visibility = ["//agentplane/egress:__subpackages__"],
    deps = [
        "//agentplane/egress/go/decision",
        "//agentplane/egress/go/identity",
        "//agentplane/egress/go/policy",
        "//agentplane/egress/go/presentation",
        "//agentplane/egress/go/upstream",
        "//agentplane/policy/api",
        "//agentplane/runner_gateway/go/auth",
        "@com_github_google_uuid//:uuid",
        "@org_golang_x_sync//errgroup",
    ],
)

go_test(
    name = "proxy_test",
    srcs = [
        "gate_test.go",
        "proxy_test.go",
    ],
    embed = [":proxy"],
    deps = [
        "//agentplane/egress/go/decision",
        "//agentplane/egress/go/identity",
        "//agentplane/egress/go/policy",
        "//agentplane/egress/go/resources",
        "//agentplane/egress/go/upstream",
        "//agentplane/policy/api",
        "//agentplane/runner_gateway/go/auth",
        "@io_k8s_api//authentication/v1:authentication",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@org_golang_x_net//http2",
    ],
)
