load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "cmd_lib",
    srcs = ["main.go"],
    importpath = "github.com/agentydragon/ducktape/agentplane/egress/history_migrations/cmd",
    visibility = ["//visibility:private"],
    deps = [
        "//agentplane/egress/history_migrations",
        "@com_github_lib_pq//:pq",
    ],
)

go_binary(
    name = "egress-history-migrate",
    embed = [":cmd_lib"],
    pure = "on",
    visibility = ["//agentplane/egress:__subpackages__"],
)
