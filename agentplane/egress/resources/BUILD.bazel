load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "resources",
    srcs = ["resources.go"],
    importpath = "github.com/agentydragon/ducktape/agentplane/egress/resources",
    visibility = [
        "//agentplane/egress:__subpackages__",
        # Managed accounts' credential descriptions name the placeholder.
        "//agentplane/policy_controller:__pkg__",
    ],
    deps = [
        "//agentplane/egress/api/v1alpha1",
        "//agentplane/policy/api/v1alpha1",
        "@io_k8s_api//core/v1:core",
        "@io_k8s_apimachinery//pkg/util/validation",
    ],
)

go_test(
    name = "resources_test",
    srcs = ["resources_test.go"],
    embed = [":resources"],
    deps = [
        "//agentplane/egress/api/v1alpha1",
        "//agentplane/policy/api/v1alpha1",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
    ],
)
