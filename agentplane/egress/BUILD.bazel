load("@aspect_rules_ts//ts:proto.bzl", "ts_proto_library")
load("@io_bazel_rules_go//proto:def.bzl", "go_proto_library")
load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_oci//oci:defs.bzl", "oci_image")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//devinfra/python:defs.bzl", "py_library", "py_test")
load("//devinfra/python:grpc.bzl", "py_grpc_service_library")
load("//devinfra/python:proto.bzl", "py_proto_library_with_mypy_stubs")

package(default_visibility = ["//agentplane:__subpackages__"])

py_library(
    name = "kubernetes_audience",
    srcs = ["kubernetes_audience.py"],
    visibility = [
        "//agentplane:__subpackages__",
        "//cluster/cdk8s/agentplane:__pkg__",
    ],
)

py_library(
    name = "resources",
    srcs = ["resources.py"],
    visibility = [
        "//agentplane:__subpackages__",
        "//cluster/cdk8s:__pkg__",
        "//cluster/cdk8s/agentplane:__pkg__",
        "//cluster/cdk8s/public_coder:__pkg__",
        "//cluster/validation:__pkg__",
    ],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    deps = [
        "//util/testing:postgres",
        "//util/testing:postgres_fixtures",
        "@pypi//pytest",
    ],
)

py_test(
    name = "test_proxy",
    size = "medium",
    srcs = ["test_proxy.py"],
    data = [
        "//agentplane/egress/cmd:egress-proxy",
        "//agentplane/egress/sidecar:egress-sidecar",
    ],
    requires_docker = True,
    # Unsharded, devel's 20 cases already took 5m of medium's 300s (bbapi target history, 2026-11-09).
    shard_count = 2,
    deps = [
        ":conftest",
        ":platform_routes",
        ":resources",
        ":settings",
        ":sidecar_config",
        "//:conftest",
        "//agentplane:crd_group",
        "//agentplane:policy_sets",
        "//agentplane:subjects",
        "//agentplane/egress:egress_rules_pb2",
        "//agentplane/egress:egress_rules_pb2_grpc",
        "//agentplane/egress/testing:go_replica",
        "//agentplane/egress/testing:sidecar_process",
        "//agentplane/testing:kubernetes",
        "//agentplane/testing:kubernetes_apiserver",
        "//agentplane/testing:tls",
        "//agentplane/workload_auth:audience",
        "//agentplane/workload_auth:listener",
        "//util:net",
        "@pypi//aiohttp",
        "@pypi//cryptography",
        "@pypi//grpcio",
        "@pypi//kubernetes_asyncio",
        "@pypi//more_itertools",
        "@pypi//protobuf",  # keep: mypy follows generated protobuf interfaces
        "@pypi//psycopg",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//pyyaml",
        "@pypi//sqlalchemy",
        "@pypi//tenacity",
        "@pypi//types_grpcio",  # keep: mypy follows generated gRPC interfaces
        "@pypi//types_protobuf",  # keep: mypy follows generated protobuf interfaces
    ],
)

pkg_tar(
    name = "sidecar_go_binary_layer",
    srcs = ["//agentplane/egress/sidecar:egress-sidecar"],
    mode = "0755",
    package_dir = "/usr/local/bin",
)

oci_image(
    name = "sidecar_image",
    base = "@distroless_static_debian13_linux_amd64",
    entrypoint = ["/usr/local/bin/egress-sidecar"],
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [":sidecar_go_binary_layer"],
    user = "1000:1000",
    workdir = "/",
)

py_library(
    name = "sidecar_config",
    srcs = ["sidecar_config.py"],
    visibility = [
        "//agentplane:__subpackages__",
        "//cluster/cdk8s:__pkg__",
        "//cluster/cdk8s/agentplane:__pkg__",
        "//cluster/cdk8s/haku_ci:__pkg__",
        "//cluster/cdk8s/public_coder:__pkg__",
    ],
    deps = [
        ":platform_routes",
        "@pypi//pydantic",
    ],
)

py_test(
    name = "test_sidecar_config",
    srcs = ["test_sidecar_config.py"],
    deps = [
        ":conftest",
        ":platform_routes",
        ":sidecar_config",
        "//:conftest",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_sidecar",
    size = "medium",
    srcs = ["test_sidecar.py"],
    data = ["//agentplane/egress/sidecar:egress-sidecar"],
    deps = [
        ":conftest",
        ":sidecar_config",
        "//:conftest",
        "//agentplane/egress/testing:sidecar_process",
        "//util:net",
        "@pypi//aiohttp",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "settings",
    srcs = ["settings.py"],
    visibility = [
        "//agentplane:__subpackages__",
        "//cluster/cdk8s/agentplane:__pkg__",
    ],
    deps = [
        "//agentplane:log_levels",
        "//agentplane/workload_auth:listener",
        "@pypi//pydantic",
        "@pypi//pydantic_settings",
    ],
)

py_library(
    name = "platform_routes",
    srcs = ["platform_routes.py"],
    visibility = [
        "//agentplane:__subpackages__",
        "//cluster/cdk8s/agentplane:__pkg__",
        "//cluster/cdk8s/public_coder:__pkg__",
    ],
    deps = ["@pypi//pydantic"],
)

py_test(
    name = "test_platform_routes",
    srcs = ["test_platform_routes.py"],
    data = ["//agentplane/egress/sidecar:egress-sidecar"],
    deps = [
        ":conftest",
        ":platform_routes",
        ":sidecar_config",
        "//:conftest",
        "//agentplane/egress/testing:sidecar_process",
        "@pypi//grpcio",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

proto_library(
    name = "egress_admin_proto",
    srcs = ["egress_admin.proto"],
    deps = [
        ":egress_rules_proto",
        "//agentplane/proto:identity_proto",
        "@googleapis//google/api:annotations_proto",
        "@protobuf//:empty_proto",
        "@protobuf//:timestamp_proto",
    ],
)

py_proto_library_with_mypy_stubs(
    name = "egress_admin_pb2",
    deps = [
        ":egress_admin_proto",
        "@googleapis//google/api:annotations_proto",
    ],
)

py_grpc_service_library(
    name = "egress_admin_pb2_grpc",
    proto = ":egress_admin_proto",
    py_proto = ":egress_admin_pb2",
)

proto_library(
    name = "egress_rules_proto",
    srcs = ["egress_rules.proto"],
    deps = [
        "//agentplane/proto:identity_proto",
    ],
)

py_proto_library_with_mypy_stubs(
    name = "egress_rules_pb2",
    deps = [":egress_rules_proto"],
)

py_grpc_service_library(
    name = "egress_rules_pb2_grpc",
    async_only = True,
    proto = ":egress_rules_proto",
    py_proto = ":egress_rules_pb2",
)

go_proto_library(
    name = "egress_admin_go_proto",
    compilers = [
        "@io_bazel_rules_go//proto:go_proto",
        "@io_bazel_rules_go//proto:go_grpc_v2",
        "//devinfra/go:grpc_gateway",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/egress/egress_adminpb",
    proto = ":egress_admin_proto",
    deps = [
        ":egress_rules_go_proto",
        "//agentplane/proto:identity_go_proto",
        "@org_golang_google_genproto_googleapis_api//annotations",
        "@org_golang_google_protobuf//types/known/emptypb",
    ],
)

go_proto_library(
    name = "egress_rules_go_proto",
    compilers = [
        "@io_bazel_rules_go//proto:go_proto",
        "@io_bazel_rules_go//proto:go_grpc_v2",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/egress/egress_rulespb",
    proto = ":egress_rules_proto",
    deps = [
        "//agentplane/proto:identity_go_proto",
    ],
)

ts_proto_library(
    name = "egress_rules_pb",
    copy_files = False,
    node_modules = "//:node_modules",
    proto = ":egress_rules_proto",
    visibility = ["//agentplane:__subpackages__"],
    deps = [
        "//agentplane/proto:identity_pb",
    ],
)

ts_proto_library(
    name = "egress_admin_pb",
    copy_files = False,
    node_modules = "//:node_modules",
    proto = ":egress_admin_proto",
    visibility = ["//agentplane:__subpackages__"],
    deps = [
        ":egress_rules_pb",
        "//agentplane/proto:identity_pb",
        "//google/api:annotations_pb",
    ],
)
