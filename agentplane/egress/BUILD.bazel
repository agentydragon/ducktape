load("@rules_oci//oci:defs.bzl", "oci_image")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//agentplane:__subpackages__"])

py_library(
    name = "decisions",
    srcs = ["decisions.py"],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "decisions_client",
    srcs = ["decisions_client.py"],
    deps = [
        ":decisions",
        "//agentplane:subjects",
        "//agentplane/grpc:calls",
        "//agentplane/proto:egress_admin_pb2",
        "//agentplane/proto:egress_admin_pb2_grpc",
        "@pypi//grpcio",
        "@pypi//protobuf",
    ],
)

py_library(
    name = "resources",
    srcs = ["resources.py"],
    visibility = [
        "//agentplane:__subpackages__",
        "//cluster/cdk8s:__pkg__",
        "//cluster/cdk8s/agentplane:__pkg__",
        "//cluster/cdk8s/public_coder:__pkg__",
        "//cluster/validation:__pkg__",
    ],
    deps = [
        "@pypi//kubernetes_asyncio",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    deps = [
        ":resources",
        "//agentplane:policy_sets",
        "//agentplane:subjects",
        "//agentplane/testing:fake_apiserver",
        "//util/testing:postgres",
        "//util/testing:postgres_fixtures",
        "@pypi//pytest",
    ],
)

py_test(
    name = "test_proxy",
    size = "medium",
    srcs = ["test_proxy.py"],
    data = [
        "//agentplane/egress/cmd:egress-proxy",
        "//agentplane/egress/history_migrations/cmd:egress-history-migrate",
        "//agentplane/egress/sidecar:egress-sidecar",
    ],
    requires_docker = True,
    deps = [
        ":conftest",
        ":resources",
        ":settings",
        "//:conftest",
        "//agentplane:crd_group",
        "//agentplane:policy_sets",
        "//agentplane:subjects",
        "//agentplane/egress/testing:go_replica",
        "//agentplane/egress/testing:sidecar_process",
        "//agentplane/egress/testing:tls",
        "//agentplane/testing:fake_apiserver",
        "//agentplane/testing:kubernetes_apiserver",
        "//util:kubernetes",
        "@pypi//aiohttp",
        "@pypi//grpcio",
        "@pypi//kubernetes_asyncio",
        "@pypi//more_itertools",
        "@pypi//psycopg",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
        "@pypi//tenacity",
    ],
)

pkg_tar(
    name = "sidecar_go_binary_layer",
    srcs = ["//agentplane/egress/sidecar:egress-sidecar"],
    mode = "0755",
    package_dir = "/usr/local/bin",
)

oci_image(
    name = "sidecar_image",
    base = "@distroless_static_debian13_linux_amd64",
    entrypoint = ["/usr/local/bin/egress-sidecar"],
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [":sidecar_go_binary_layer"],
    user = "1000:1000",
    workdir = "/",
)

py_library(
    name = "sidecar_config",
    srcs = ["sidecar_config.py"],
    visibility = [
        "//agentplane:__subpackages__",
        "//cluster/cdk8s:__pkg__",
        "//cluster/cdk8s/agentplane:__pkg__",
        "//cluster/cdk8s/public_coder:__pkg__",
    ],
    deps = [
        ":platform_routes",
        "//util:yaml_file_settings",
        "@pypi//pydantic",
    ],
)

py_test(
    name = "test_sidecar",
    size = "medium",
    srcs = ["test_sidecar.py"],
    data = ["//agentplane/egress/sidecar:egress-sidecar"],
    deps = [
        ":conftest",
        ":sidecar_config",
        "//:conftest",
        "//agentplane/egress/testing:sidecar_process",
        "@pypi//aiohttp",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "settings",
    srcs = ["settings.py"],
    visibility = [
        "//agentplane:__subpackages__",
        "//cluster/cdk8s/agentplane:__pkg__",
    ],
    deps = [
        "//agentplane:log_levels",
        "//util:yaml_file_settings",
        "@pypi//pydantic",
        "@pypi//pydantic_settings",
    ],
)

py_library(
    name = "platform_routes",
    srcs = ["platform_routes.py"],
    visibility = [
        "//agentplane:__subpackages__",
        "//cluster/cdk8s/agentplane:__pkg__",
    ],
    deps = ["@pypi//pydantic"],
)

py_test(
    name = "test_platform_routes",
    srcs = ["test_platform_routes.py"],
    data = ["//agentplane/egress/sidecar:egress-sidecar"],
    deps = [
        ":conftest",
        "//:conftest",
        "//agentplane/egress/testing:sidecar_process",
        "@pypi//grpcio",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
