load("//devinfra/python:defs.bzl", "py_library")

package(
    default_testonly = True,
    default_visibility = ["//agentplane/egress:__pkg__"],
)

py_library(
    name = "tls",
    srcs = ["tls.py"],
    deps = ["@pypi//cryptography"],
)

py_library(
    name = "sidecar_process",
    srcs = ["sidecar_process.py"],
    deps = [
        "//agentplane/egress:sidecar_config",
        "//util:settings_contract",
        "//util/bazel:runfiles",
        "@pypi//aiohttp",
        "@pypi//pyyaml",
    ],
)

py_library(
    name = "go_replica",
    srcs = ["go_replica.py"],
    deps = [
        "//agentplane/egress:settings",
        "//util/bazel:runfiles",
        "@pypi//grpcio",
        "@pypi//grpcio_health_checking",
        "@pypi//protobuf",
        "@pypi//sqlalchemy",
        "@pypi//tenacity",
    ],
)
