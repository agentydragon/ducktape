load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("@rules_oci//oci:defs.bzl", "oci_image")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

go_library(
    name = "cmd",
    srcs = [
        "admin_grpc.go",
        "agent_api.go",
        "config.go",
        "main.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/egress/cmd",
    visibility = ["//agentplane/egress:__subpackages__"],
    deps = [
        "//agentplane/egress:egress_admin_go_proto",
        "//agentplane/egress:egress_rules_go_proto",
        "//agentplane/egress/admin",
        "//agentplane/egress/docs",
        "//agentplane/egress/history",
        "//agentplane/egress/identity",
        "//agentplane/egress/informer",
        "//agentplane/egress/policy",
        "//agentplane/egress/proxy",
        "//agentplane/egress/rules",
        "//agentplane/egress/upstream",
        "//agentplane/grpc/facade",
        "//agentplane/grpc/graceful",
        "//agentplane/observability",
        "//agentplane/workload_auth/go/auth",
        "//util/netlistener",
        "@com_github_go_viper_mapstructure_v2//:mapstructure",
        "@com_github_spf13_viper//:viper",
        "@io_k8s_client_go//kubernetes/typed/authentication/v1:authentication",
        "@io_k8s_client_go//rest",
        "@io_k8s_client_go//tools/clientcmd",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//health/grpc_health_v1",
        "@org_golang_x_sync//errgroup",
    ],
)

go_binary(
    name = "egress-proxy",
    embed = [":cmd"],
    pure = "on",
    visibility = ["//agentplane/egress:__subpackages__"],
)

go_test(
    name = "listener_test",
    srcs = [
        "admin_grpc_test.go",
        "agent_api_test.go",
    ],
    embed = [":cmd"],
    deps = [
        "//agentplane/egress:egress_admin_go_proto",
        "//agentplane/egress:egress_rules_go_proto",
        "//agentplane/egress/admin",
        "//agentplane/egress/decision",
        "//agentplane/egress/history",
        "//agentplane/egress/identity",
        "//agentplane/egress/policy",
        "//agentplane/testing/kubeapiserver",
        "//agentplane/watchhealth",
        "//agentplane/workload_auth/go/auth",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//credentials/insecure",
        "@org_golang_google_grpc//health/grpc_health_v1",
        "@org_golang_google_grpc//metadata",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//encoding/protojson",
    ],
)

go_test(
    name = "config_test",
    srcs = ["config_test.go"],
    embed = [":cmd"],
    deps = ["//agentplane/workload_auth/go/auth"],
)

pkg_tar(
    name = "binary_layer",
    srcs = [":egress-proxy"],
    mode = "0755",
    package_dir = "/usr/local/bin",
)

# The system CA bundle is the upstream trust when `upstream_ca_file` is unset.
oci_image(
    name = "image",
    base = "@distroless_static_debian13_linux_amd64",
    entrypoint = ["/usr/local/bin/egress-proxy"],
    env = {"SSL_CERT_FILE": "/etc/ssl/certs/ca-certificates.crt"},
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [
        ":binary_layer",
        "//third_party/debian_slim:cacerts",
    ],
    user = "1000:1000",
    visibility = ["//agentplane/system_tests/k3s:__pkg__"],
    workdir = "/",
)
