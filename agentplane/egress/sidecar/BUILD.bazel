load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "runtime",
    srcs = [
        "codec.go",
        "config.go",
        "main.go",
        "platform_routes.go",
        "relay.go",
        "tls_route.go",
        "workload_routes.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/egress/sidecar",
    visibility = ["//agentplane/egress:__pkg__"],
    deps = [
        "//agentplane/egress/identity",
        "//agentplane/environment_runtime_transport",
        "//agentplane/identity/auth/listener",
        "//agentplane/net/httpconnect",
        "//agentplane/net/listener",
        "//agentplane/observability",
        "@com_github_spiffe_go_spiffe_v2//spiffeid",
        "@in_gopkg_yaml_v3//:yaml_v3",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//credentials",
        "@org_golang_google_grpc//credentials/insecure",
        "@org_golang_google_grpc//keepalive",
        "@org_golang_google_grpc//metadata",
        "@org_golang_google_grpc//status",
    ],
)

go_binary(
    name = "egress-sidecar",
    embed = [":runtime"],
    pure = "on",
    visibility = ["//agentplane/egress:__pkg__"],
)

go_test(
    name = "sidecar_test",
    srcs = [
        "config_test.go",
        "platform_routes_test.go",
        "relay_test.go",
        "workload_routes_test.go",
    ],
    embed = [":runtime"],
    deps = [
        "//agentplane/environment_runtime_transport",
        "//agentplane/environment_runtime_transport/testing",
        "//agentplane/identity/auth/listener",
        "//agentplane/net/httpconnect",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//credentials",
        "@org_golang_google_grpc//credentials/insecure",
        "@org_golang_google_grpc//health/grpc_health_v1",
        "@org_golang_google_grpc//keepalive",
        "@org_golang_google_grpc//metadata",
        "@org_golang_google_grpc//peer",
        "@org_golang_google_grpc//status",
    ],
)
