load("@io_bazel_rules_go//proto:def.bzl", "go_proto_library")
load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("//devinfra/python:proto.bzl", "py_proto_library_with_mypy_stubs")

# gazelle:resolve proto buf/validate/validate.proto @protovalidate//proto/protovalidate/buf/validate:validate_proto

package(default_visibility = ["//agentplane/egress/sidecar:__pkg__"])

proto_library(
    name = "config_proto",
    srcs = ["config.proto"],
    deps = ["@protovalidate//proto/protovalidate/buf/validate:validate_proto"],
)

go_proto_library(
    name = "configpb",
    importpath = "github.com/agentydragon/ducktape/agentplane/egress/sidecar/configpb",
    proto = ":config_proto",
    deps = ["@build_buf_gen_go_bufbuild_protovalidate_protocolbuffers_go//buf/validate"],
)

py_proto_library_with_mypy_stubs(
    name = "config_pb2",
    # Native protoc emits invalid types for the imported validation annotations.
    mypy_protobuf = True,
    visibility = [
        "//agentplane/egress:__subpackages__",
        "//cluster/cdk8s:__subpackages__",
    ],
    deps = [":config_proto"],
)
