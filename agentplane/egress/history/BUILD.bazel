load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "history",
    srcs = [
        "changes.go",
        "log.go",
        "store.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/egress/history",
    visibility = ["//agentplane/egress:__subpackages__"],
    deps = [
        "//agentplane/egress/decision",
        "//agentplane/postgres/go:postgres",
        "@com_github_lib_pq//:pq",
        "@com_github_sethvargo_go_retry//:go-retry",
    ],
)

go_test(
    name = "history_test",
    srcs = [
        "changes_test.go",
        "helpers_test.go",
        "log_test.go",
    ],
    embed = [":history"],
    deps = [
        "//agentplane/egress/decision",
        "@com_github_google_uuid//:uuid",
        "@com_github_sethvargo_go_retry//:go-retry",
    ],
)

go_test(
    name = "store_integration_test",
    size = "medium",
    srcs = [
        "helpers_test.go",
        "store_integration_test.go",
        "store_integration_testmain_test.go",
    ],
    embed = [":history"],
    tags = ["requires_docker"],
    deps = [
        "//agentplane/egress/decision",
        "//agentplane/egress/history_migrations",
        "//agentplane/testing/postgres",
        "@com_github_google_uuid//:uuid",
        "@com_github_sethvargo_go_retry//:go-retry",
    ],
)
