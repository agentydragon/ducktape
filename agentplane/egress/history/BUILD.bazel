load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")
load("//devinfra/python:defs.bzl", "py_test")

go_library(
    name = "history",
    srcs = [
        "changes.go",
        "log.go",
        "store.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/egress/history",
    visibility = ["//agentplane/egress:__subpackages__"],
    deps = [
        "//agentplane/egress/decision",
        "@com_github_lib_pq//:pq",
        "@com_github_sethvargo_go_retry//:go-retry",
    ],
)

go_test(
    name = "history_test",
    srcs = [
        "changes_test.go",
        "helpers_test.go",
        "log_test.go",
    ],
    embed = [":history"],
    deps = [
        "//agentplane/egress/decision",
        "@com_github_google_uuid//:uuid",
        "@com_github_sethvargo_go_retry//:go-retry",
    ],
)

# Executed by the Python wrapper below so the repo's real PostgreSQL fixture
# provides a migrated database. Running this Go test alone intentionally fails.
go_test(
    name = "store_integration_test",
    srcs = [
        "helpers_test.go",
        "store_integration_test.go",
    ],
    embed = [":history"],
    tags = ["manual"],
    deps = [
        "//agentplane/egress/decision",
        "@com_github_google_uuid//:uuid",
        "@com_github_sethvargo_go_retry//:go-retry",
    ],
)

py_test(
    name = "test_store_integration",
    size = "medium",
    srcs = ["test_store_integration.py"],
    data = [
        ":store_integration_test",
        "//agentplane/egress/history_migrations/cmd:egress-history-migrate",
    ],
    requires_docker = True,
    deps = [
        "//:conftest",
        "//agentplane/egress:conftest",
        "//agentplane/egress:database_migrate",
        "//util/bazel:runfiles",
        "//util/testing:postgres",
        "@pypi//psycopg",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)
