load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "cmd_lib",
    srcs = ["main.go"],
    importpath = "github.com/agentydragon/ducktape/agentplane/egress/x/goproxy/cmd",
    visibility = ["//visibility:private"],
    deps = [
        "//agentplane/egress/x/goproxy",
        "//agentplane/workload_auth/go/auth",
        "@io_k8s_client_go//kubernetes/typed/authentication/v1:authentication",
        "@io_k8s_client_go//tools/clientcmd",
    ],
)

go_binary(
    name = "goproxy_lab",
    embed = [":cmd_lib"],
    visibility = ["//agentplane/egress:__subpackages__"],
)
