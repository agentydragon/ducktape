load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "goproxy",
    srcs = ["proxy.go"],
    importpath = "github.com/agentydragon/ducktape/agentplane/egress/x/goproxy",
    visibility = ["//agentplane/egress:__subpackages__"],
    deps = [
        "//agentplane/policy/api",
        "//agentplane/runner_gateway/go/auth",
        "@com_github_elazarl_goproxy//:goproxy",
        "@org_golang_google_grpc//metadata",
        "@org_golang_x_net//http2",
    ],
)

go_test(
    name = "transport_test",
    size = "medium",
    srcs = [
        "policy_envtest_test.go",
        "proxy_test.go",
    ],
    data = [
        "//agentplane/crds",
        "@envtest_kubernetes_linux_amd64//:assets",
    ],
    embed = [":goproxy"],
    deps = [
        "//agentplane/policy/api",
        "//agentplane/runner_gateway/go/auth",
        "@io_bazel_rules_go//go/runfiles",
        "@io_k8s_api//authentication/v1:authentication",
        "@io_k8s_api//core/v1:core",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_apimachinery//pkg/runtime",
        "@io_k8s_apimachinery//pkg/watch",
        "@io_k8s_sigs_controller_runtime//pkg/client",
        "@io_k8s_sigs_controller_runtime//pkg/envtest",
        "@org_golang_x_net//http2",
    ],
)
