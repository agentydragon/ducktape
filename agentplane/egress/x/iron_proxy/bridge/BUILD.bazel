load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//devinfra/go:defs.bzl", "go_test")

go_library(
    name = "bridge",
    srcs = ["bridge.go"],
    importpath = "github.com/agentydragon/ducktape/agentplane/egress/x/iron_proxy/bridge",
    visibility = ["//agentplane:__subpackages__"],
    deps = [
        "//agentplane/egress/decision",
        "//agentplane/egress/identity",
        "//agentplane/egress/policy",
        "//agentplane/egress/x/iron_proxy/bridge/proto:transform_go_proto",
        "//agentplane/policy/api/v1alpha1",
        "//agentplane/workload_auth/go/auth",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_protobuf//types/known/structpb",
    ],
)

go_test(
    name = "bridge_test",
    srcs = [
        "bridge_test.go",
        "streaming_test.go",
    ],
    data = [
        "@ducktape_iron_proxy//:binary",
        "@ducktape_iron_proxy//:patched_binary",
    ],  # keep: subprocess interoperability with both pinned proxy CLIs
    embed = [":bridge"],
    deps = [
        "//agentplane/egress/decision",
        "//agentplane/egress/identity",
        "//agentplane/egress/policy",
        "//agentplane/egress/resources",
        "//agentplane/egress/x/iron_proxy/bridge/proto:transform_go_proto",
        "//agentplane/policy/api/v1alpha1",
        "//agentplane/workload_auth/go/auth",
        "@io_bazel_rules_go//go/runfiles",
        "@io_k8s_api//authentication/v1:authentication",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//credentials",
        "@org_golang_google_grpc//credentials/insecure",
        "@org_golang_google_grpc//interop/grpc_testing",
        "@org_golang_google_grpc//metadata",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//types/known/structpb",
    ],
)
