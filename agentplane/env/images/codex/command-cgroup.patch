+// The root owner grants one destination, never a path or writable hierarchy.
+// Writing zero moves this process atomically, avoiding numeric-PID reuse races.
+// The descriptor is closed before the target can run or inspect inherited FDs.
+pub(super) fn enter_cgroup(socket: &std::ffi::OsStr, kind: u8) -> io::Result<()> {
+    use std::os::fd::AsRawFd;
+    use std::os::unix::net::UnixStream;
+    if unsafe { libc::prctl(libc::PR_SET_DUMPABLE, 0) } == -1 {
+        return Err(io::Error::last_os_error());
+    }
+    let mut owner = UnixStream::connect(socket)?;
+    owner.set_read_timeout(Some(std::time::Duration::from_secs(30)))?;
+    owner.set_write_timeout(Some(std::time::Duration::from_secs(30)))?;
+    owner.write_all(&[kind])?;
+    let mut byte = [0u8];
+    let mut data = libc::iovec {
+        iov_base: byte.as_mut_ptr().cast(),
+        iov_len: 1,
+    };
+    // cmsghdr alignment is required even on architectures tolerating unaligned ints.
+    let mut ancillary = [0usize; 8];
+    let mut message: libc::msghdr = unsafe { std::mem::zeroed() };
+    message.msg_iov = &mut data;
+    message.msg_iovlen = 1;
+    message.msg_control = ancillary.as_mut_ptr().cast();
+    message.msg_controllen = std::mem::size_of_val(&ancillary);
+    if unsafe { libc::recvmsg(owner.as_raw_fd(), &mut message, libc::MSG_CMSG_CLOEXEC) } != 1 {
+        return Err(io::Error::last_os_error());
+    }
+    let header = unsafe { libc::CMSG_FIRSTHDR(&message) };
+    if header.is_null()
+        || message.msg_flags & libc::MSG_CTRUNC != 0
+        || unsafe { (*header).cmsg_level != libc::SOL_SOCKET
+            || (*header).cmsg_type != libc::SCM_RIGHTS
+            || (*header).cmsg_len != libc::CMSG_LEN(std::mem::size_of::<i32>() as u32) as usize }
+    {
+        return Err(io::Error::from_raw_os_error(libc::EPROTO));
+    }
+    let fd = unsafe { std::ptr::read_unaligned(libc::CMSG_DATA(header).cast::<i32>()) };
+    let mut destination = unsafe { File::from_raw_fd(fd) };
+    destination.write_all(b"0")?;
+    drop(destination);
+    owner.write_all(b"M")?;
+    owner.read_exact(&mut byte)?;
+    if byte != [b'A'] {
+        return Err(io::Error::from_raw_os_error(libc::EPERM));
+    }
+    Ok(())
