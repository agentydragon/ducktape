{
  "disks": {
    "runtime": {
      "volume_name": "runner",
      "serial": "agentplane-runner",
      "mount": "/run/agentplane/environment",
      "filesystem": "erofs"
    },
    "config": {
      "volume_name": "config",
      "serial": "agentplane-config",
      "mount": "/run/agentplane/config",
      "filesystem": "iso9660"
    },
    "launch": {
      "volume_name": "agentplane-launch",
      "serial": "agentplane-launch",
      "mount": "/run/agentplane/sandbox",
      "filesystem": "iso9660"
    },
    "egress_trust": {
      "volume_name": "trust",
      "serial": "agentplane-trust",
      "mount": "/run/agentplane/trust",
      "filesystem": "iso9660"
    },
    "workspace": {
      "volume_name": "workspace",
      "serial": "workspace",
      "device": "/dev/disk/by-id/virtio-workspace",
      "mount": "/state/workspaces",
      "filesystem": "ext4"
    }
  },
  "state": {
    "volume_name": "state",
    "mount": "/state",
    "filesystem": "virtiofs"
  },
  "files": {
    "runtime_config": "environment-runtime.json",
    "runtime_environment": "environment-runtime.env",
    "launch": "launch.json"
  },
  "environment_runtime_tls": {
    "volume_name": "agentplane-environment-runtime-tls",
    "private_mount": "/run/agentplane/environment-runtime-private/environment-runtime-tls",
    "runtime_path": "/run/agentplane/environment-runtime-tls",
    "filesystem": "virtiofs"
  },
  "environment_runtime_trust": {
    "volume_name": "agentplane-environment-runtime-trust",
    "mount": "/run/agentplane/environment-runtime-trust",
    "key": "ca-certificates.crt",
    "filesystem": "virtiofs"
  },
  "environment_runtime_workload_trust": {
    "volume_name": "agentplane-environment-runtime-workload-trust",
    "mount": "/run/agentplane/environment-runtime-workload-trust",
    "key": "ca-certificates.crt",
    "filesystem": "virtiofs"
  }
}
