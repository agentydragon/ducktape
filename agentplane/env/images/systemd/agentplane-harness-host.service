[Unit]
Description=Agentplane Harness Host
# Runtime owns shutdown ordering so it can drain lifecycle work before stopping Host.
DefaultDependencies=no
Wants=network.target
After=network.target dbus.service

[Service]
Type=exec
Slice=agentplane.slice
RuntimeDirectory=agentplane-harness-host-lifetime
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=no
EnvironmentFile=/run/agentplane/config/environment-runtime.env
Environment=ANTHROPIC_AUTH_TOKEN=agentplane-credential-agentplane-workload
Environment=OPENAI_API_KEY=agentplane-credential-agentplane-workload
ExecStart=/run/agentplane/environment/bin/agentplane-harness-host --config /run/agentplane/config/environment-runtime.json --launch-file /run/agentplane/sandbox/launch.json --runtime-socket /state/runtime/lifecycle.sock --listen-socket /state/harness-host/control.sock --execution-socket /state/execution/execution.sock --supervision systemd
UMask=0007
Restart=no
TimeoutStopSec=120s
OOMPolicy=continue
KillMode=control-group
SendSIGKILL=yes
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_FOWNER
NoNewPrivileges=yes
LockPersonality=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectSystem=strict
ReadWritePaths=/state /state/workspaces /tmp
