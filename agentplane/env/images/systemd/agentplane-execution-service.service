[Unit]
Description=Agentplane Execution service
# Runtime owns shutdown ordering so it can drain Host before fencing Execution.
DefaultDependencies=no
Wants=network.target
After=network.target dbus.service

[Service]
Type=exec
Slice=agentplane.slice
RuntimeDirectory=agentplane-execution-lifetime
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=no
ExecStart=/run/agentplane/environment/bin/agentplane-execution-service --config /run/agentplane/execution-service/config.json
UMask=0007
Restart=no
TimeoutStopSec=120s
OOMPolicy=continue
KillMode=control-group
SendSIGKILL=yes
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_FOWNER
NoNewPrivileges=yes
LockPersonality=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectSystem=strict
ReadWritePaths=/state /state/workspaces /tmp
