load("//devinfra/python:defs.bzl", "py_library", "py_test")

py_library(
    name = "config",
    srcs = ["config.py"],
    visibility = [
        "//agentplane:__subpackages__",
        "//cluster/cdk8s:__subpackages__",
    ],
    deps = [
        "//agentplane/environment_runtime_transport:config",
        "@pypi//pydantic",
    ],
)

py_test(
    name = "test_config",
    srcs = ["test_config.py"],
    deps = [
        ":config",
        "//:conftest",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
