load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//agentplane/env:__subpackages__"])

go_library(
    name = "configuration",
    srcs = [
        "configuration.go",
        "guest.go",
        "resolved.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/env/configuration",
    deps = [
        "//agentplane/env/runtime/codexappserver",
        "//agentplane/env/runtime/execution/codexexecserver",
        "//agentplane/env/runtime/harness",
        "//agentplane/env/runtime/session",
        "//agentplane/env/runtime/supervision",
        "//agentplane/environment_runtime_transport",
        "//agentplane/session_instructions",
        "@org_uber_go_zap//:zap",
    ],
)

go_test(
    name = "configuration_test",
    srcs = [
        "configuration_test.go",
        "environment_test.go",
        "guest_test.go",
    ],
    data = ["//agentplane/env/runtime/cmd:agentplane-environment-runtime"],
    embed = [":configuration"],
    race = "on",
    x_defs = {"github.com/agentydragon/ducktape/agentplane/env/configuration.environmentRuntimeRlocation": "$(rlocationpath //agentplane/env/runtime/cmd:agentplane-environment-runtime)"},
    deps = [
        "//agentplane/env/runtime/codexappserver",
        "//agentplane/env/runtime/execution/codexexecserver",
        "@io_bazel_rules_go//go/runfiles",
    ],
)
