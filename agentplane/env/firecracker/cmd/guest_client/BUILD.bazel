load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "guest_client",
    srcs = ["main.go"],
    importpath = "github.com/agentydragon/ducktape/agentplane/env/firecracker/cmd/guest_client",
    deps = [
        "//agentplane/env/firecracker:management_go_proto",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//credentials/insecure",
        "@org_golang_google_protobuf//proto",
    ],
)

go_binary(
    name = "agentplane-firecracker-guest-client",
    embed = [":guest_client"],
    pure = "on",
)

go_test(
    name = "guest_client_test",
    srcs = ["main_test.go"],
    embed = [":guest_client"],
)
