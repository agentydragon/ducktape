load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//agentplane/env/runtime/supervision:__pkg__"])

go_library(
    name = "systemd",
    srcs = [
        "backend.go",
        "cgroup_diagnostics.go",
        "observation.go",
        "start_handle.go",
        "unit_reference.go",
        "units.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/env/runtime/supervision/internal/systemd",
    deps = [
        "@com_github_coreos_go_systemd_v22//dbus",
        "@com_github_godbus_dbus_v5//:dbus",
        "@com_github_google_uuid//:uuid",
        "@org_uber_go_zap//:zap",
    ],
)

go_test(
    name = "systemd_test",
    srcs = glob(["*_test.go"]),
    embed = [":systemd"],
    race = "on",
)
