load("@io_bazel_rules_go//go:def.bzl", "go_binary")

package(
    default_testonly = True,
    default_visibility = ["//agentplane:__subpackages__"],
)

go_binary(
    name = "typedproxy_bin",
    srcs = ["main.go"],
    deps = [
        "//agentplane/env/runtime/execution:executor_go_proto",
        "//agentplane/env/runtime/execution/native",
        "//agentplane/env/runtime/execution/typedbackend",
        "//agentplane/env/runtime/execution/typedproxy",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//credentials/insecure",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//proto",
    ],
)
