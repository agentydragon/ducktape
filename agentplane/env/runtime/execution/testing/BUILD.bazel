    name = "test_service",
    srcs = ["test_service.py"],
    data = [
        "//agentplane/env/runtime/execution/cmd:agentplane-execution-service",  # keep: real standalone PID-1 service
        "@agentplane_codex_cli_linux_x64//:files",  # keep: real execution backend
