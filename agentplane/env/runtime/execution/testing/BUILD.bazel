    requires_docker = True,
    deps = [
        "//:conftest",
        "//agentplane/env/runtime/execution:executor_pb2",
        "//agentplane/env/runtime/execution:executor_pb2_grpc",
        "//agentplane/proto:sandboxes_pb2",
