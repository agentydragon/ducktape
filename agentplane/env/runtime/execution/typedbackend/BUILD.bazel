load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//agentplane:__subpackages__"])

go_library(
    name = "typedbackend",
    srcs = ["server.go"],
    importpath = "github.com/agentydragon/ducktape/agentplane/env/runtime/execution/typedbackend",
    deps = [
        "//agentplane/env/runtime/execution:executor_go_proto",
        "//agentplane/env/runtime/execution/native",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
    ],
)

go_test(
    name = "typedbackend_test",
    srcs = ["server_test.go"],
    embed = [":typedbackend"],
    deps = [
        "//agentplane/env/runtime/execution:executor_go_proto",
        "//agentplane/env/runtime/execution/native",
    ],
)
