load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//agentplane/env:__subpackages__"])

go_library(
    name = "service",
    srcs = [
        "config.go",
        "service.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/env/runtime/execution/service",
    deps = [
        "//agentplane/env/runtime/execution:executor_go_proto",
        "//agentplane/env/runtime/execution/adapter",
        "//agentplane/env/runtime/execution/backend",
        "//agentplane/env/runtime/execution/typedproxy",
        "//agentplane/env/runtime/supervision",
        "@com_github_sethvargo_go_retry//:go-retry",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//credentials/insecure",
        "@org_golang_google_grpc//health/grpc_health_v1",
        "@org_golang_google_grpc//status",
    ],
)

go_test(
    name = "service_test",
    srcs = [
        "launch_cancellation_test.go",
        "service_test.go",
    ],
    embed = [":service"],
    race = "on",
    deps = [
        "//agentplane/env/runtime/execution:executor_go_proto",
        "//agentplane/env/runtime/execution/backend",
        "//agentplane/env/runtime/execution/codexshim",
        "//agentplane/env/runtime/execution/native",
        "//agentplane/env/runtime/supervision",
        "//agentplane/proto:identity_go_proto",
        "@com_github_coder_websocket//:websocket",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//health",
        "@org_golang_google_grpc//health/grpc_health_v1",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//proto",
        "@org_golang_x_net//http2",
        "@org_golang_x_net//http2/h2c",
    ],
)
