load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = [
    "//agentplane/env:__subpackages__",
])

go_library(
    name = "codexexecserver",
    srcs = ["server.go"],
    importpath = "github.com/agentydragon/ducktape/agentplane/env/runtime/execution/codexexecserver",
    deps = [
        "//agentplane/env/runtime/execution/companion/control",
        "//agentplane/env/runtime/supervision",
        "@com_github_coder_websocket//:websocket",
        "@com_github_sethvargo_go_retry//:go-retry",
        "@org_uber_go_zap//:zap",
    ],
)

go_test(
    name = "codexexecserver_test",
    srcs = ["server_test.go"],
    embed = [":codexexecserver"],
    race = "on",
    deps = [
        "//agentplane/env/runtime/execution/companion/control",
        "//agentplane/env/runtime/supervision",
        "@com_github_coder_websocket//:websocket",
    ],
)
