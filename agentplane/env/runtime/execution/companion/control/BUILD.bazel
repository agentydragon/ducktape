load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("@io_bazel_rules_go//proto:def.bzl", "go_proto_library")
load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("//devinfra/python:grpc.bzl", "py_grpc_service_library")
load("//devinfra/python:proto.bzl", "py_proto_library_with_mypy_stubs")

package(default_visibility = [
    "//agentplane/env/e2e:__pkg__",
    "//agentplane/env/runtime/execution/codexexecserver:__pkg__",
    "//agentplane/env/runtime/execution/companion:__pkg__",
    "//agentplane/env/runtime/execution/testing:__pkg__",
])

proto_library(
    name = "control_proto",
    srcs = ["control.proto"],
)

go_proto_library(
    name = "control_go_proto",
    compilers = [
        "@io_bazel_rules_go//proto:go_proto",
        "@io_bazel_rules_go//proto:go_grpc_v2",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/env/runtime/execution/companion/control/controlpb",
    proto = ":control_proto",
)

py_proto_library_with_mypy_stubs(
    name = "control_pb2",
    deps = [":control_proto"],
)

py_grpc_service_library(
    name = "control_pb2_grpc",
    async_only = False,
    proto = ":control_proto",
    py_proto = ":control_pb2",
)

go_library(
    name = "control",
    srcs = ["control.go"],
    importpath = "github.com/agentydragon/ducktape/agentplane/env/runtime/execution/companion/control",
    deps = [
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//credentials/insecure",
    ],
)
