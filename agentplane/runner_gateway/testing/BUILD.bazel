load("//devinfra/python:defs.bzl", "py_library")

package(
    default_testonly = True,
    default_visibility = ["//agentplane:__subpackages__"],
)

py_library(
    name = "gateway_process",
    srcs = ["gateway_process.py"],
    data = [
        "//agentplane/runner_gateway:runner-gateway",
        "//agentplane/runner_gateway/migrations/cmd:runner-gateway-queue-migrate",
    ],
    deps = [
        "//agentplane:subjects",
        "//agentplane/grpc:calls",
        "//agentplane/proto:sandboxes_pb2",
        "//agentplane/runner:configuration",
        "//agentplane/runner_gateway:client",
        "//agentplane/runner_gateway:settings",
        "//agentplane/testing:tls",
        "//util:net",
        "//util:settings_contract",
        "//util/bazel:runfiles",
        "//util/testing:undeclared_outputs",
        "@pypi//grpcio",
        "@pypi//grpcio_health_checking",
        "@pypi//httpx",
        "@pypi//protobuf",
        "@pypi//pyyaml",
        "@pypi//sqlalchemy",
        "@pypi//types_protobuf",  # keep: mypy follows generated protobuf interfaces
    ],
)

py_library(
    name = "runner_server",
    srcs = ["runner_server.py"],
    deps = [
        "//agentplane/proto:runner_state_pb2",
        "//agentplane/runner:configuration",
        "//agentplane/runner:runner_service_pb2",
        "@pypi//cryptography",
        "@pypi//grpcio",
        "@pypi//protobuf",
        "@pypi//types_protobuf",  # keep: mypy follows generated protobuf interfaces
    ],
)
