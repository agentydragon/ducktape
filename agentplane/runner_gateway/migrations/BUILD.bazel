load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("@rules_oci//oci:defs.bzl", "oci_image")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//devinfra/python:defs.bzl", "py_library", "py_test")

pkg_tar(
    name = "go_binary_layer",
    srcs = ["//agentplane/runner_gateway/migrations/cmd:runner-gateway-queue-migrate"],
    package_dir = "/usr/local/bin",
)

oci_image(
    name = "image",
    base = "@debian_trixie_slim_linux_amd64",
    entrypoint = ["/usr/local/bin/runner-gateway-queue-migrate"],
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [":go_binary_layer"],
    user = "1000:1000",
    visibility = ["//visibility:public"],
)

go_library(
    name = "migrations",
    srcs = ["migrations.go"],
    embedsrcs = glob(["dispatcher/*.sql"]),
    importpath = "github.com/agentydragon/ducktape/agentplane/runner_gateway/migrations",
    visibility = ["//agentplane/runner_gateway:__subpackages__"],
    deps = [
        "@com_github_pressly_goose_v3//:goose",
        "@com_github_pressly_goose_v3//lock",
    ],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    deps = ["//util/testing:postgres_fixtures"],
)

py_test(
    name = "test_migrations",
    size = "medium",
    srcs = ["test_migrations.py"],
    data = ["//agentplane/runner_gateway/migrations/cmd:runner-gateway-queue-migrate"],
    requires_docker = True,
    deps = [
        ":conftest",
        "//:conftest",
        "//agentplane/runner_gateway:conftest",
        "//agentplane/session_dispatcher:database_migrate",
        "//util/bazel:runfiles",
        "//util/testing:postgres",
        "@pypi//psycopg",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)
