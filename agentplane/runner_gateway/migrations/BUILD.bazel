load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//devinfra/python:defs.bzl", "py_library", "py_test")

go_library(
    name = "migrations",
    srcs = ["migrations.go"],
    embedsrcs = glob(["dispatcher/*.sql"]),
    importpath = "github.com/agentydragon/ducktape/agentplane/runner_gateway/migrations",
    visibility = ["//agentplane/runner_gateway:__subpackages__"],
    deps = [
        "@com_github_pressly_goose_v3//:goose",
        "@com_github_pressly_goose_v3//lock",
    ],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    deps = ["//util/testing:postgres_fixtures"],
)

py_test(
    name = "test_migrations",
    size = "medium",
    srcs = ["test_migrations.py"],
    data = ["//agentplane/runner_gateway:runner-gateway"],
    requires_docker = True,
    deps = [
        ":conftest",
        "//:conftest",
        "//agentplane/runner_gateway:conftest",
        "//util/bazel:runfiles",
        "//util/testing:postgres",
        "@pypi//psycopg",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)
