load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")
load("//devinfra/python:defs.bzl", "py_library", "py_test")

go_library(
    name = "migrations",
    srcs = [
        "migrations.go",
        "placement.go",
    ],
    embedsrcs = glob(["dispatcher/*.sql"]),
    importpath = "github.com/agentydragon/ducktape/agentplane/runner_gateway/migrations",
    visibility = ["//agentplane/runner_gateway:__subpackages__"],
    deps = [
        "//agentplane/proto:session_go_proto",
        "@com_github_pressly_goose_v3//:goose",
        "@com_github_pressly_goose_v3//lock",
        "@org_golang_google_protobuf//encoding/protowire",
        "@org_golang_google_protobuf//proto",
    ],
)

go_test(
    name = "upgrade_integration_test",
    srcs = [
        "integration_testmain_test.go",
        "upgrade_integration_test.go",
    ],
    embed = [":migrations"],
    tags = ["requires_docker"],
    deps = [
        "//agentplane/proto:session_go_proto",
        "//agentplane/testing/postgres",
        "@com_github_lib_pq//:pq",
        "@org_golang_google_protobuf//proto",
    ],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    deps = ["//util/testing:postgres_fixtures"],
)

py_test(
    name = "test_migrations",
    size = "medium",
    srcs = ["test_migrations.py"],
    data = ["//agentplane/runner_gateway:runner-gateway"],
    requires_docker = True,
    deps = [
        ":conftest",
        "//:conftest",
        "//agentplane/runner_gateway:conftest",
        "//devinfra/bazel:runfiles",
        "//util:db_url",
        "//util/testing:postgres",
        "@pypi//psycopg",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)
