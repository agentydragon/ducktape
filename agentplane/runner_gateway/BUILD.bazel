    name = "protocol_pb2",
    deps = [":protocol_proto"],
)

py_grpc_service_library(
    name = "protocol_pb2_grpc",
    proto = ":protocol_proto",
    py_proto = ":protocol_pb2",
)

py_binary(
    name = "server",
    main_module = "agentplane.runner_gateway.main",
    deps = [":main"],
)

aspect_py_binary(
    name = "server_image_bin",
    main = "main.py",
    deps = [":main"],
)

py_image_layer(
    name = "server_layers",
    binary = ":server_image_bin",
    group = "1000",
    owner = "1000",
)

oci_image(
    name = "image",
    base = "@debian_trixie_slim_linux_amd64",
    entrypoint = py_image_entrypoint("server_image_bin"),
    # Kubernetes TLS verification uses the system trust store.
    env = py_image_env(
        binary_name = "server_image_bin",
        extra_env = {"SSL_CERT_FILE": "/etc/ssl/certs/ca-certificates.crt"},
    ),
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [
        ":server_layers",
        "//third_party/debian_slim:cacerts",
    ],
    user = "1000:1000",
    visibility = ["//visibility:public"],
)

