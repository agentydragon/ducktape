load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("@rules_oci//oci:defs.bzl", "oci_image")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load(
    "//agentplane/runner/testing:exec_properties.bzl",
    "NATIVE_RUNNER_DOCKER_ENV",
    "NATIVE_RUNNER_DOCKER_EXEC_PROPERTIES",
)
load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//agentplane:__subpackages__"])

pkg_tar(
    name = "binary_layer",
    srcs = [":runner-gateway"],
    package_dir = "/usr/local/bin",
)

oci_image(
    name = "image",
    base = "@distroless_static_debian13_linux_amd64",
    entrypoint = ["/usr/local/bin/runner-gateway"],
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [":binary_layer"],
    user = "1000:1000",
    visibility = ["//visibility:public"],
    workdir = "/",
)

py_library(
    name = "api",
    srcs = ["api.py"],
    visibility = [
        "//agentplane:__subpackages__",
        "//cluster/cdk8s/agentplane:__pkg__",
    ],
)

py_library(
    name = "client",
    srcs = ["client.py"],
    deps = [
        ":api",
        "//agentplane/grpc:calls",
        "//agentplane/proto:runner_pb2",
        "//agentplane/proto:sandboxes_pb2",
        "//agentplane/runner:runner_service_pb2",
        "//agentplane/runner:runner_service_pb2_grpc",
        "@pypi//grpcio",
        "@pypi//protobuf",
    ],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    deps = [
        ":client",
        "//agentplane/app/testing:runner_gateway",
        "//agentplane/history_service/testing:fixtures",
        "//agentplane/runner/testing:failure_journal",
        "//agentplane/runner/testing:fixtures",
        "//agentplane/runner/testing:process",
        "//agentplane/testing:kubernetes_apiserver_fixtures",
        "//util/testing:postgres_fixtures",
        "@pypi//pytest",
    ],
)

py_test(
    name = "test_client",
    size = "medium",
    srcs = ["test_client.py"],
    data = [
        "@agentplane_codex_cli_linux_x64//:files",  # keep: runner config selects the pinned native harness
        "@claude_code_cli_linux_x64//:claude",  # keep: runner config selects the pinned native harness
    ],
    env = NATIVE_RUNNER_DOCKER_ENV,
    exec_properties = NATIVE_RUNNER_DOCKER_EXEC_PROPERTIES,
    requires_docker = True,
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    deps = [
        ":client",
        ":conftest",
        "//:conftest",
        "//agentplane/grpc:calls",
        "//agentplane/proto:sandboxes_pb2",
        "//agentplane/runner/testing:process",
        "//agentplane/sandboxes/testing:kubernetes",
        "@pypi//protobuf",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_grpc_native",
    size = "large",
    srcs = ["test_grpc_native.py"],
    data = [
        "@agentplane_codex_cli_linux_x64//:files",  # keep: both pinned native harnesses
        "@claude_code_cli_linux_x64//:claude",  # keep: both pinned native harnesses
    ],
    env = NATIVE_RUNNER_DOCKER_ENV,
    exec_properties = NATIVE_RUNNER_DOCKER_EXEC_PROPERTIES,
    requires_docker = True,
    target_compatible_with = [
        # keep: pinned native harness platforms
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    deps = [
        ":client",
        ":conftest",
        "//:conftest",
        "//agentplane/grpc:calls",
        "//agentplane/history_service/testing:go_service",
        "//agentplane/proto:command_pb2",
        "//agentplane/proto:event_log_pb2",
        "//agentplane/proto:runner_pb2",
        "//agentplane/proto:sandboxes_pb2",
        "//agentplane/runner:runner_service_pb2",
        "//agentplane/runner/testing:config",
        "//agentplane/runner/testing:events",
        "//agentplane/runner/testing:launches",
        "//agentplane/runner/testing:process",
        "//agentplane/runner_gateway/testing:gateway_process",
        "//agentplane/sandboxes/testing:kubernetes",
        "//agentplane/testing:scripted_model",
        "@pypi//grpcio",
        "@pypi//more_itertools",
        "@pypi//protobuf",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//tenacity",
    ],
)

go_library(
    name = "main_lib",
    srcs = [
        "config.go",
        "main.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/runner_gateway",
    visibility = ["//agentplane/runner_gateway:__subpackages__"],
    deps = [
        "//agentplane/grpc/facade",
        "//agentplane/observability",
        "//agentplane/postgres/go:postgres",
        "//agentplane/runner_gateway/dispatcher",
        "//agentplane/runner_gateway/dispatcher:session_dispatcher_go_proto",
        "//agentplane/runner_gateway/gateway",
        "//agentplane/runner_transport",
        "//agentplane/sandboxes/api",
        "//agentplane/workload_auth/go/auth",
        "//util/netlistener",
        "@com_github_go_logr_logr//:logr",
        "@com_github_go_viper_mapstructure_v2//:mapstructure",
        "@com_github_lib_pq//:pq",
        "@com_github_spf13_viper//:viper",
        "@io_k8s_api//core/v1:core",
        "@io_k8s_apimachinery//pkg/runtime",
        "@io_k8s_client_go//kubernetes",
        "@io_k8s_client_go//kubernetes/scheme",
        "@io_k8s_client_go//rest",
        "@io_k8s_client_go//tools/clientcmd",
        "@io_k8s_sigs_controller_runtime//pkg/cache",
        "@io_k8s_sigs_controller_runtime//pkg/client",
        "@io_k8s_sigs_controller_runtime//pkg/log",
        "@io_kubevirt_api//core/v1:core",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//health",
        "@org_golang_google_grpc//health/grpc_health_v1",
        "@org_golang_google_grpc//keepalive",
    ],
)

go_binary(
    name = "runner-gateway",
    embed = [":main_lib"],
    pure = "on",
    visibility = ["//agentplane/runner_gateway:__subpackages__"],
)

go_test(
    name = "config_test",
    srcs = [
        "config_test.go",
        "listener_test.go",
    ],
    embed = [":main_lib"],
    deps = ["//agentplane/workload_auth/go/auth"],
)

py_library(
    name = "settings",
    srcs = ["settings.py"],
    visibility = [
        "//agentplane:__subpackages__",
        "//cluster/cdk8s/agentplane:__pkg__",
    ],
    deps = [
        "//agentplane/runner_transport:configuration",
        "//util:yaml_file_settings",
        "@pypi//pydantic",
        "@pypi//pydantic_settings",
    ],
)

py_test(
    name = "test_settings",
    srcs = ["test_settings.py"],
    deps = [
        ":conftest",
        ":settings",
        "//:conftest",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
