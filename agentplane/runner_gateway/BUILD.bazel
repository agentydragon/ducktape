load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("@rules_oci//oci:defs.bzl", "oci_image")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//agentplane/runner/testing:exec_properties.bzl", "NATIVE_RUNNER_EXEC_PROPERTIES")
load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//agentplane:__subpackages__"])

pkg_tar(
    name = "binary_layer",
    srcs = [":runner-gateway"],
    package_dir = "/usr/local/bin",
)

oci_image(
    name = "image",
    base = "@distroless_static_debian13_linux_amd64",
    entrypoint = ["/usr/local/bin/runner-gateway"],
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [":binary_layer"],
    user = "1000:1000",
    visibility = ["//visibility:public"],
    workdir = "/",
)

py_library(
    name = "api",
    srcs = ["api.py"],
    visibility = [
        "//agentplane:__subpackages__",
        "//cluster/cdk8s/agentplane:__pkg__",
    ],
)

py_library(
    name = "client",
    srcs = ["client.py"],
    deps = [
        ":api",
        "//agentplane/grpc:calls",
        "//agentplane/proto:runner_control_pb2",
        "//agentplane/proto:runner_control_pb2_grpc",
        "//agentplane/proto:runner_pb2",
        "//agentplane/proto:sandboxes_pb2",
        "@pypi//grpcio",
        "@pypi//protobuf",
    ],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    deps = [
        "//agentplane/runner/testing:failure_journal",
        "//agentplane/runner/testing:fixtures",
        "@pypi//pytest",
    ],
)

py_test(
    name = "test_client",
    srcs = ["test_client.py"],
    deps = [
        ":conftest",
        "//:conftest",
        "//agentplane/proto:sandboxes_pb2",
        "//agentplane/runner_gateway/testing:runner_peer",
        "@pypi//protobuf",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_grpc_native",
    size = "large",
    srcs = ["test_grpc_native.py"],
    data = [
        "@agentplane_codex_cli_linux_x64//:files",  # keep: both pinned native harnesses
        "@claude_code_cli_linux_x64//:claude",  # keep: both pinned native harnesses
    ],
    exec_properties = NATIVE_RUNNER_EXEC_PROPERTIES,
    target_compatible_with = [
        # keep: pinned native harness platforms
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    deps = [
        ":client",
        ":conftest",
        "//:conftest",
        "//agentplane/grpc:calls",
        "//agentplane/proto:command_pb2",
        "//agentplane/proto:event_log_pb2",
        "//agentplane/proto:runner_control_pb2",
        "//agentplane/proto:runner_pb2",
        "//agentplane/proto:sandboxes_pb2",
        "//agentplane/runner/testing:config",
        "//agentplane/runner/testing:events",
        "//agentplane/runner/testing:launches",
        "//agentplane/runner/testing:process",
        "//agentplane/runner/testing:scripted_model",
        "//agentplane/runner_gateway/testing:runner_peer",
        "@pypi//grpcio",
        "@pypi//more_itertools",
        "@pypi//protobuf",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//tenacity",
    ],
)

go_library(
    name = "main_lib",
    srcs = [
        "config.go",
        "main.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/runner_gateway",
    visibility = ["//agentplane/runner_gateway:__subpackages__"],
    deps = [
        "//agentplane/grpc/facade",
        "//agentplane/proto:session_dispatcher_go_proto",
        "//agentplane/runner_gateway/dispatcher",
        "//agentplane/runner_gateway/gateway",
        "//agentplane/sandboxes/api",
        "//agentplane/workload_auth/go/auth",
        "@com_github_go_logr_logr//:logr",
        "@com_github_lib_pq//:pq",
        "@io_k8s_apimachinery//pkg/runtime",
        "@io_k8s_client_go//kubernetes",
        "@io_k8s_client_go//rest",
        "@io_k8s_client_go//tools/clientcmd",
        "@io_k8s_sigs_controller_runtime//pkg/cache",
        "@io_k8s_sigs_controller_runtime//pkg/client",
        "@io_k8s_sigs_controller_runtime//pkg/log",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//health",
        "@org_golang_google_grpc//health/grpc_health_v1",
    ],
)

go_binary(
    name = "runner-gateway",
    embed = [":main_lib"],
    pure = "on",
    visibility = ["//agentplane/runner_gateway:__subpackages__"],
)

go_test(
    name = "config_test",
    srcs = ["config_test.go"],
    embed = [":main_lib"],
)
