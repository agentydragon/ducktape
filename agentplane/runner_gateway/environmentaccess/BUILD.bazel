load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "environmentaccess",
    srcs = ["policy.go"],
    importpath = "github.com/agentydragon/ducktape/agentplane/runner_gateway/environmentaccess",
    visibility = ["//agentplane:__subpackages__"],
    deps = [
        "//agentplane/policy/api/v1alpha1",
        "//agentplane/policy/reader",
        "//agentplane/sandboxes/api",
    ],
)

go_test(
    name = "environmentaccess_test",
    srcs = ["policy_test.go"],
    embed = [":environmentaccess"],
    deps = [
        "//agentplane/policy/api/v1alpha1",
        "//agentplane/policy/reader",
        "//agentplane/sandboxes/api",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_apimachinery//pkg/types",
    ],
)
