load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "listener",
    srcs = ["config.go"],
    importpath = "github.com/agentydragon/ducktape/agentplane/identity/auth/listener",
    visibility = ["//agentplane:__subpackages__"],
    deps = [
        "//agentplane/environment_runtime_transport",
        "@com_github_go_viper_mapstructure_v2//:mapstructure",
        "@org_golang_google_grpc//credentials",
