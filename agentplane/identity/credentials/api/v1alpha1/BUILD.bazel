load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//agentplane/crds:api_codegen.bzl", "agentplane_api_codegen")

go_library(
    name = "v1alpha1",
    srcs = [
        "doc.go",
        "scheme.go",
        "types.go",
        ":deepcopy",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/identity/credentials/api/v1alpha1",
    visibility = ["//agentplane:__subpackages__"],
    deps = [
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_apimachinery//pkg/runtime",
        "@io_k8s_apimachinery//pkg/runtime/schema",
        "@io_k8s_apimachinery//pkg/types",
        "@io_k8s_sigs_controller_runtime//pkg/scheme",
    ],
)

go_library(
    name = "deepcopy_inputs",
    srcs = [
        "doc.go",
        "types.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/identity/credentials/api/v1alpha1",
    visibility = ["//visibility:private"],
    deps = [
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_apimachinery//pkg/types",
    ],
)

agentplane_api_codegen(
    src = ":deepcopy_inputs",
    importpath = "github.com/agentydragon/ducktape/agentplane/identity/credentials/api/v1alpha1",
)
