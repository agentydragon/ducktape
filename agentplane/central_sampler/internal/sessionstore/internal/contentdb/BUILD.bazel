load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//agentplane/central_sampler:__subpackages__"])

go_library(
    name = "contentdb",
    srcs = ["store.go"],
    importpath = "github.com/agentydragon/ducktape/agentplane/central_sampler/internal/sessionstore/internal/contentdb",
    deps = [
        "//agentplane/central_sampler/internal/content",
        "//agentplane/central_sampler/internal/providerrequest",
        "//agentplane/central_sampler/protocol",
        "@com_github_lib_pq//:pq",
    ],
)

go_test(
    name = "contentdb_test",
    size = "medium",
    srcs = [
        "integration_test.go",
        "integration_testmain_test.go",
    ],
    embed = [":contentdb"],
    race = "on",
    tags = ["requires_docker"],
    deps = [
        "//agentplane/central_sampler/internal/content",
        "//agentplane/central_sampler/internal/providerrequest",
        "//agentplane/central_sampler/migrations",
        "//agentplane/central_sampler/protocol",
        "//agentplane/central_sampler/providers/responses",
        "//agentplane/testing/postgres",
        "@com_github_lib_pq//:pq",
    ],
)
