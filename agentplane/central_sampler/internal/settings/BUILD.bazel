load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:private"])

go_library(
    name = "settings",
    srcs = [
        "model.go",
        "settings.go",
        "validation.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/central_sampler/internal/settings",
    visibility = [
        "//agentplane/central_sampler:__pkg__",
        "//agentplane/central_sampler:__subpackages__",
    ],
    deps = [
        "//agentplane/central_sampler/protocol",
        "//agentplane/central_sampler/providers/anthropic",
        "//agentplane/central_sampler/providers/responses",
        "//agentplane/identity/auth",
        "//agentplane/net/peertls",
    ],
)

go_test(
    name = "settings_test",
    srcs = [
        "settings_fixture_test.go",
        "settings_test.go",
    ],
    embed = [":settings"],
    deps = [
        "//agentplane/central_sampler/protocol",
        "//agentplane/central_sampler/providers/anthropic",
        "//agentplane/central_sampler/providers/responses",
        "//agentplane/net/peertls",
    ],
)
