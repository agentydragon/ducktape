load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "ownershiprewrite",
    srcs = ["rewrite.go"],
    importpath = "github.com/agentydragon/ducktape/agentplane/central_sampler/internal/ownershiprewrite",
    visibility = ["//agentplane/central_sampler:__subpackages__"],
    deps = [
        "//agentplane/net/peertls",
        "@com_github_lib_pq//:pq",
    ],
)

go_test(
    name = "ownershiprewrite_test",
