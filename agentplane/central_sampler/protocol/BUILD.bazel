load("@io_bazel_rules_go//go:def.bzl", "go_library")

package(default_visibility = ["//agentplane/central_sampler:__subpackages__"])

go_library(
    name = "protocol",
    srcs = [
        "content.go",
        "context.go",
        "errors.go",
        "evidence.go",
        "instructions.go",
        "json.go",
        "status.go",
        "tool_definitions.go",
        "tool_invocation.go",
        "tool_surface.go",
    ],
    embedsrcs = ["base_instructions.txt"],
    importpath = "github.com/agentydragon/ducktape/agentplane/central_sampler/protocol",
    visibility = [
        "//agentplane/central_sampler:__subpackages__",
        "//agentplane/history_service/ingress:__pkg__",  # real ingress exporter integration test
    ],
    deps = [
        "//agentplane/proto:event_go_proto",
    ],
)
