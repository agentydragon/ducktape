load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = [
    "//agentplane/central_sampler:__pkg__",
    "//agentplane/history_service/ingress:__pkg__",
])

go_library(
    name = "anthropic",
    srcs = [
        "anthropic.go",
        "compaction.go",
        "config.go",
        "context.go",
        "observations.go",
        "stored.go",
        "wire.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/central_sampler/anthropic",
    visibility = [
        "//agentplane/central_sampler:__pkg__",
        "//agentplane/central_sampler/settings:__pkg__",
        "//agentplane/history_service/ingress:__pkg__",
    ],
    deps = [
        "//agentplane/central_sampler/internal/storage",
        "//agentplane/central_sampler/protocol",
        "//agentplane/proto:event_go_proto",
    ],
)

go_test(
    name = "anthropic_test",
    size = "small",
    srcs = [
        "anthropic_test.go",
        "stored_test.go",
    ],
    embed = [":anthropic"],
    race = "on",
    deps = [
        "//agentplane/central_sampler/internal/storage",
        "//agentplane/central_sampler/protocol",
        "//agentplane/proto:event_go_proto",
    ],
)
