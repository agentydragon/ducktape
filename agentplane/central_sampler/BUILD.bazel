# Live provider (LiteLLM) agent run; manual. See the module docstring for the command.
live_openai_py_test(
    name = "test_live_provider",
    # A real model samples several times per turn over the network; bounded by the test's turn timeout.
    size = "large",
    srcs = ["test_live_provider.py"],
    data = ["@agentplane_codex_cli_linux_x64//:files"],
    requires_docker = True,
    tags = ["manual"],
    deps = [
        ":conftest",
        ":settings",
        ":testing",
        ":testing_store",
        "//:conftest",  # keep: macro rule — gazelle does not manage the conftest chain here
        "//agentplane/central_sampler/api:sampler_pb2",
        "//agentplane/central_sampler/api:sampler_pb2_grpc",
        "//agentplane/env/runtime/control:environment_runtime_pb2",
        "//agentplane/proto:event_pb2",
        "//agentplane/proto:session_pb2",
        "//agentplane/testing:codex_fixtures",
        "//devinfra/testing:undeclared_outputs",
        "//util/testing:sqlalchemy_engines",
        "@pypi//grpcio",  # keep: mypy follows generated gRPC interfaces
        "@pypi//protobuf",  # keep: mypy follows generated protobuf interfaces
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//types_grpcio",  # keep: mypy follows generated gRPC interfaces
        "@pypi//types_protobuf",  # keep: mypy follows generated protobuf interfaces
    ],
)

