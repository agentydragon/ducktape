load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "historyexport",
    srcs = ["exporter.go"],
    importpath = "github.com/agentydragon/ducktape/agentplane/central_sampler/historyexport",
    deps = [
        "//agentplane/central_sampler/api:sampler_go_proto",
        "//agentplane/environment_runtime_transport",
        "//agentplane/grpc/bearer",
        "//agentplane/history_service/api/ingress:session_ingress_go_proto",
        "//agentplane/identity/auth/grpc",
        "//agentplane/postgres/wakeups",
        "//agentplane/proto:delegation_go_proto",
        "//agentplane/proto:event_log_go_proto",
        "@io_k8s_client_go//util/workqueue",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_x_sync//errgroup",
    ],
)

go_test(
    name = "historyexport_test",
    srcs = ["exporter_test.go"],
    embed = [":historyexport"],
    race = "on",
    deps = [
        "//agentplane/central_sampler/api:sampler_go_proto",
        "//agentplane/history_service/api/ingress:session_ingress_go_proto",
        "//agentplane/proto:event_log_go_proto",
        "//agentplane/proto:session_go_proto",
        "@io_k8s_client_go//util/workqueue",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
    ],
)
