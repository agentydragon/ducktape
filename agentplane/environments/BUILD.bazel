load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//devinfra/python:defs.bzl", "py_library", "py_test")

pkg_tar(
    name = "binary_layer",
    srcs = ["//agentplane/environments/cmd:sandbox-controller"],
    package_dir = "/usr/local/bin",
)

# Talks only to the API server, through the in-cluster ServiceAccount CA, so it needs no system
# CA bundle.
oci_image(
    name = "image",
    base = "@distroless_static_debian13_linux_amd64",
    entrypoint = ["/usr/local/bin/sandbox-controller"],
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [":binary_layer"],
    user = "1000:1000",
    visibility = ["//visibility:public"],
    workdir = "/",
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["agentplane-environments:latest"],
)

py_library(
    name = "settings",
    srcs = ["settings.py"],
    visibility = ["//cluster/cdk8s/agentplane:__pkg__"],
    deps = [
        "//agentplane/identity/auth:delegation",
        "//agentplane/identity/auth:listener",
        "//agentplane/net/peertls:config",
        "//agentplane/sandboxes/runtimeconfig:model_catalog",
        "@pypi//pydantic",
    ],
)

py_test(
    name = "test_settings",
    srcs = ["test_settings.py"],
    deps = [
        ":settings",
        "//:conftest",
        "//agentplane/net/peertls:config",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
