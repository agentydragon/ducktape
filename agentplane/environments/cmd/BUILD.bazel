load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "cmd_lib",
    srcs = [
        "config.go",
        "main.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/environments/cmd",
    visibility = ["//visibility:private"],
    deps = [
        "//agentplane/configfile",
        "//agentplane/environments/internal/controller",
        "//agentplane/environments/internal/runtimecontrol",
        "//agentplane/environments/internal/serving",
        "//agentplane/identity/credentials/api/v1alpha1",
        "//agentplane/identity/credentials/requester",
        "//agentplane/net/peertls",
        "//agentplane/observability",
        "//agentplane/policy/api/v1alpha1",
        "//agentplane/policy/identitycache",
        "//agentplane/policy/reader",
        "//agentplane/sandboxes/api",
        "@com_github_go_logr_logr//:logr",
        "@io_k8s_apimachinery//pkg/api/errors",
        "@io_k8s_apimachinery//pkg/runtime",
        "@io_k8s_client_go//discovery",
        "@io_k8s_client_go//kubernetes",
        "@io_k8s_client_go//kubernetes/scheme",
        "@io_k8s_client_go//rest",
        "@io_k8s_sigs_controller_runtime//:controller-runtime",
        "@io_k8s_sigs_controller_runtime//pkg/cache",
        "@io_k8s_sigs_controller_runtime//pkg/healthz",
        "@io_k8s_sigs_controller_runtime//pkg/metrics/server",
        "@io_kubevirt_api//core/v1:core",
    ],
)

go_binary(
    name = "sandbox-controller",
    embed = [":cmd_lib"],
    pure = "on",
    visibility = ["//agentplane/environments:__pkg__"],
)

go_test(
    name = "config_test",
    srcs = [
        "catalog_test.go",
        "config_test.go",
        "delegation_test.go",
    ],
    embed = [":cmd_lib"],
    deps = [
        "//agentplane/environments/internal/resume",
        "//agentplane/environments/internal/service",
        "//agentplane/environments/lifecycle",
        "//agentplane/environments/v1:environment_service_go_proto",
        "//agentplane/identity/auth",
        "//agentplane/net/peertls",
        "//agentplane/proto:session_go_proto",
        "//agentplane/sandboxes/api",
        "//agentplane/testing/configtest",
        "//agentplane/testing/grpcmethods",
        "//agentplane/testing/testscheme",
        "@io_k8s_api//core/v1:core",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_apimachinery//pkg/types",
        "@io_k8s_apimachinery//pkg/util/sets",
        "@io_k8s_sigs_controller_runtime//pkg/client/fake",
        "@org_golang_google_grpc//:grpc",
    ],
)
