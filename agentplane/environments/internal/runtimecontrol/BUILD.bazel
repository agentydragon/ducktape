load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "runtimecontrol",
    srcs = [
        "observer.go",
        "quiescer.go",
        "suspender.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/environments/internal/runtimecontrol",
    visibility = ["//agentplane/environments/cmd:__pkg__"],
    deps = [
        "//agentplane/env/runtime/control:environment_runtime_go_proto",
        "//agentplane/environments/internal/controller",
        "//agentplane/grpc/streaming",
        "//agentplane/identity/credentials/workloadid",
        "//agentplane/net/peertls",
        "//agentplane/observability",
        "//agentplane/proto:session_go_proto",
        "//agentplane/sandboxes/api",
        "//agentplane/sandboxes/environmentruntimeclient",
        "@com_github_sethvargo_go_retry//:go-retry",
        "@io_k8s_api//core/v1:core",
        "@io_opentelemetry_go_otel//attribute",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

go_test(
    name = "runtimecontrol_test",
    srcs = [
        "observer_test.go",
        "quiescer_test.go",
    ],
    embed = [":runtimecontrol"],
    deps = [
        "//agentplane/env/runtime/control:environment_runtime_go_proto",
        "//agentplane/identity/credentials/workloadid",
        "//agentplane/net/peertls",
        "//agentplane/net/peertls/testing",
        "//agentplane/proto:environment_runtime_state_go_proto",
        "//agentplane/proto:session_go_proto",
        "//agentplane/sandboxes/api",
        "//agentplane/testing/grpcserver",
        "@io_k8s_api//core/v1:core",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//metadata",
        "@org_golang_google_grpc//status",
    ],
)
