load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//devinfra/go:defs.bzl", "go_test")

package(default_visibility = ["//agentplane/history_service:__subpackages__"])

go_library(
    name = "reads",
    srcs = [
        "events.go",
        "evidence.go",
        "reader.go",
        "summaries.go",
        "threads.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/history_service/reads",
    deps = [
        "//agentplane/history_service:history_service_go_proto",
        "//agentplane/history_service/storage",
        "//agentplane/history_service/threadfold",
        "//agentplane/proto:event_go_proto",
        "//agentplane/proto:runner_go_proto",
        "@com_github_google_uuid//:uuid",
        "@com_github_lib_pq//:pq",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

go_test(
    name = "integration_test",
    size = "medium",
    srcs = [
        "evidence_test.go",
        "fixture_test.go",
        "integration_testmain_test.go",
        "summaries_test.go",
        "threads_test.go",
    ],
    embed = [":reads"],
    tags = ["requires_docker"],
    deps = [
        "//agentplane/history_service:history_service_go_proto",
        "//agentplane/history_service/migrations",
        "//agentplane/history_service/projection",
        "//agentplane/history_service/storage",
        "//agentplane/history_service/testing/spans",
        "//agentplane/proto:event_go_proto",
        "//agentplane/proto:event_log_go_proto",
        "//agentplane/proto:runner_go_proto",
        "//agentplane/testing/postgres",
        "@com_github_google_uuid//:uuid",
        "@com_github_lib_pq//:pq",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)
