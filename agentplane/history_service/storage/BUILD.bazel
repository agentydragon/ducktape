load("@aspect_rules_py//py:defs.bzl", aspect_py_binary = "py_binary")
load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")
load("@rules_oci//oci:defs.bzl", "oci_image")
load("//devinfra/oci:py_image.bzl", "py_image_entrypoint", "py_image_env", "shared_py_image_layers")
load("//devinfra/python:defs.bzl", "py_library", "py_test")

# History storage is a History Service internal. App tests must use the History
# Service client/protobuf boundary, not widen this visibility.
package(default_visibility = [
    "//agentplane/history_service:__subpackages__",
    "//agentplane/runner_gateway:__subpackages__",
])

py_library(
    name = "db",
    srcs = ["db.py"],
    deps = ["@pypi//sqlalchemy"],
)

py_library(
    name = "store",
    srcs = ["store.py"],
    deps = [
        ":db",
        ":settlement",
        "//agentplane/history_service:channels",
        "//agentplane/postgres:wakeups",
        "//agentplane/proto:event_log_pb2",
        "//agentplane/proto:history_service_pb2",
        "//agentplane/proto:runner_pb2",
        "@pypi//protobuf",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "database_migrate",
    srcs = ["database_migrate.py"],
    data = ["//agentplane/history_service/storage/migrations:files"],
    deps = [
        ":db",
        "//agentplane/history_service/fold:models",
        "//util:db_migrations",
    ],
)

py_test(
    name = "test_store",
    size = "medium",
    srcs = ["test_store.py"],
    requires_docker = True,
    deps = [
        ":store",
        "//:conftest",
        "//agentplane/history_service:channels",
        "//agentplane/history_service:conftest",
        "//agentplane/history_service/testing:delta_spans",
        "//agentplane/history_service/testing:sessions",
        "//agentplane/proto:event_log_pb2",
        "//agentplane/proto:event_pb2",
        "//agentplane/proto:history_service_pb2",
        "//agentplane/proto:runner_pb2",
        "@pypi//protobuf",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)

# This image runs as a History Service migration init container.
py_library(
    name = "migrate",
    srcs = ["migrate.py"],
    deps = [
        ":database_migrate",
        "@pypi//pydantic_settings",
    ],
)

aspect_py_binary(
    name = "migration_image_bin",
    main = "migrate.py",
    deps = [":migrate"],
)

migration_layers_oci_tars = shared_py_image_layers(
    name = "migration_layers",
    binary = ":migration_image_bin",
    group = "1000",
    owner = "1000",
)

oci_image(
    name = "migration_image",
    base = "@debian_trixie_slim_linux_amd64",
    entrypoint = py_image_entrypoint("migration_image_bin"),
    env = py_image_env(binary_name = "migration_image_bin"),
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = migration_layers_oci_tars,
    user = "1000:1000",
    visibility = ["//visibility:public"],
)

py_library(
    name = "settlement",
    srcs = ["settlement.py"],
    deps = [
        "//agentplane/native:delta_templates",
        "//agentplane/proto:event_log_pb2",
        "//agentplane/proto:event_pb2",
        "//agentplane/proto:history_service_pb2",
        "@pypi//protobuf",
    ],
)

py_test(
    name = "test_settlement",
    srcs = ["test_settlement.py"],
    deps = [
        ":settlement",
        "//:conftest",
        "//agentplane/history_service:conftest",
        "//agentplane/history_service/testing:delta_spans",
        "//agentplane/native:delta_templates",
        "//agentplane/proto:event_log_pb2",
        "//agentplane/proto:event_pb2",
        "//agentplane/proto:history_service_pb2",
        "@pypi//protobuf",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_database_migrate",
    size = "medium",
    srcs = ["test_database_migrate.py"],
    requires_docker = True,
    deps = [
        ":database_migrate",
        "//:conftest",
        "//agentplane/history_service:conftest",
        "//agentplane/proto:history_service_pb2",
        "//agentplane/proto:runner_pb2",
        "@pypi//protobuf",
        "@pypi//psycopg",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)

go_library(
    name = "storage",
    srcs = ["store.go"],
    importpath = "github.com/agentydragon/ducktape/agentplane/history_service/storage",
    deps = [
        "//agentplane/proto:event_log_go_proto",
        "//agentplane/proto:history_service_go_proto",
        "//agentplane/proto:runner_go_proto",
        "@com_github_google_uuid//:uuid",
        "@org_golang_google_protobuf//proto",
    ],
)

go_test(
    name = "store_integration_test",
    size = "medium",
    srcs = [
        "store_integration_test.go",
        "store_integration_testmain_test.go",
    ],
    embed = [":storage"],
    tags = ["requires_docker"],
    deps = [
        "//agentplane/history_service/migrations",
        "//agentplane/proto:event_go_proto",
        "//agentplane/proto:event_log_go_proto",
        "//agentplane/proto:history_service_go_proto",
        "//agentplane/proto:runner_go_proto",
        "//agentplane/testing/postgres",
        "@com_github_google_uuid//:uuid",
        "@com_github_lib_pq//:pq",
        "@org_golang_google_protobuf//proto",
    ],
)
