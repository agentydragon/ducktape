load("@aspect_rules_py//py:defs.bzl", "py_image_layer", aspect_py_binary = "py_binary")
load("@rules_oci//oci:defs.bzl", "oci_image")
load("//devinfra/python:defs.bzl", "py_library", "py_test")
load("//props:oci.bzl", "py_image_entrypoint", "py_image_env")

# History storage is a History Service internal. App tests must use the History
# Service client/protobuf boundary, not widen this visibility.
package(default_visibility = [
    "//agentplane/history_service:__subpackages__",
    "//agentplane/runner_gateway:__subpackages__",
    "//agentplane/sandbox_service:__subpackages__",
])

py_library(
    name = "db",
    srcs = ["db.py"],
    deps = ["@pypi//sqlalchemy"],
)

py_library(
    name = "store",
    srcs = ["store.py"],
    deps = [
        ":db",
        ":history_changes",
        ":settlement",
        "//agentplane/history_service:protocol_pb2",
        "//agentplane/proto:event_log_pb2",
        "//agentplane/proto:runner_pb2",
        "@pypi//protobuf",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "database_migrate",
    srcs = ["database_migrate.py"],
    data = ["//agentplane/history_service/storage/migrations:files"],
    deps = [
        ":db",
        "//agentplane/history_service/fold:models",
        "//util:db_migrations",
    ],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    deps = [
        ":database_migrate",
        "//agentplane/testing:electric_role",
        "//util/testing:postgres",
        "//util/testing:postgres_fixtures",
        "@pypi//asyncpg",
        "@pypi//psycopg",
        "@pypi//pytest",
    ],
)

py_test(
    name = "test_store",
    srcs = ["test_store.py"],
    deps = [
        ":conftest",
        ":db",
        ":history_changes",
        ":store",
        "//:conftest",
        "//agentplane/history_service:protocol_pb2",
        "//agentplane/history_service/testing:delta_spans",
        "//agentplane/proto:event_log_pb2",
        "//agentplane/proto:event_pb2",
        "//agentplane/proto:runner_pb2",
        "@pypi//protobuf",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)

# This image runs as a History Service migration init container.
py_library(
    name = "migrate",
    srcs = ["migrate.py"],
    deps = [
        ":database_migrate",
        "@pypi//pydantic_settings",
    ],
)

aspect_py_binary(
    name = "migration_image_bin",
    main = "migrate.py",
    deps = [":migrate"],
)

py_image_layer(
    name = "migration_layers",
    binary = ":migration_image_bin",
    group = "1000",
    owner = "1000",
)

oci_image(
    name = "migration_image",
    base = "@debian_trixie_slim_linux_amd64",
    entrypoint = py_image_entrypoint("migration_image_bin"),
    env = py_image_env(binary_name = "migration_image_bin"),
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [":migration_layers"],
    user = "1000:1000",
    visibility = ["//visibility:public"],
)

py_library(
    name = "settlement",
    srcs = ["settlement.py"],
    deps = [
        "//agentplane/history_service:protocol_pb2",
        "//agentplane/native:delta_templates",
        "//agentplane/proto:event_log_pb2",
        "//agentplane/proto:event_pb2",
        "@pypi//protobuf",
    ],
)

py_test(
    name = "test_settlement",
    srcs = ["test_settlement.py"],
    deps = [
        ":conftest",
        ":settlement",
        "//:conftest",
        "//agentplane/history_service:protocol_pb2",
        "//agentplane/history_service/testing:delta_spans",
        "//agentplane/native:delta_templates",
        "//agentplane/proto:event_log_pb2",
        "//agentplane/proto:event_pb2",
        "@pypi//protobuf",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "history_changes",
    srcs = ["history_changes.py"],
    visibility = [
        "//agentplane/history_service:__subpackages__",
        "//agentplane/notification_service:__pkg__",
        "//agentplane/sandbox_service:__subpackages__",
    ],
    deps = [
        "//agentplane/postgres:listener",
        "@pypi//sqlalchemy",
    ],
)
