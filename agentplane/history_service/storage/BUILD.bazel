load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

# History storage is a History Service internal. App tests must use the History
# Service client/protobuf boundary, not widen this visibility.
package(default_visibility = [
    "//agentplane/history_service:__subpackages__",
    "//agentplane/runner_gateway:__subpackages__",
])

go_library(
    name = "storage",
    srcs = [
        "delta_templates.go",
        "follow.go",
        "settlement.go",
        "store.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/history_service/storage",
    deps = [
        "//agentplane/history_service:history_service_go_proto",
        "//agentplane/postgres/go:postgres",
        "//agentplane/proto:event_go_proto",
        "//agentplane/proto:event_log_go_proto",
        "//agentplane/proto:runner_go_proto",
        "@com_github_google_uuid//:uuid",
        "@com_github_lib_pq//:pq",
        "@org_golang_google_protobuf//proto",
    ],
)

go_test(
    name = "settlement_test",
    srcs = [
        "delta_templates_test.go",
        "follow_test.go",
        "settlement_helpers_test.go",
        "settlement_test.go",
    ],
    embed = [":storage"],
    deps = [
        "//agentplane/history_service:history_service_go_proto",
        "//agentplane/history_service/testing/spans",
        "//agentplane/proto:event_go_proto",
        "//agentplane/proto:event_log_go_proto",
    ],
)

go_test(
    name = "store_integration_test",
    size = "medium",
    srcs = [
        "follow_integration_test.go",
        "settlement_helpers_test.go",
        "store_integration_test.go",
        "store_integration_testmain_test.go",
    ],
    embed = [":storage"],
    tags = ["requires_docker"],
    deps = [
        "//agentplane/history_service:history_service_go_proto",
        "//agentplane/history_service/migrations",
        "//agentplane/history_service/testing/spans",
        "//agentplane/proto:event_go_proto",
        "//agentplane/proto:event_log_go_proto",
        "//agentplane/proto:runner_go_proto",
        "//agentplane/testing/postgres",
        "@com_github_google_uuid//:uuid",
        "@com_github_lib_pq//:pq",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/emptypb",
    ],
)
