load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//devinfra/go:defs.bzl", "go_test")

package(default_visibility = [
    "//agentplane/app/go:__subpackages__",
    "//agentplane/history_service:__subpackages__",
])

go_library(
    name = "settledcursors",
    srcs = ["settledcursors.go"],
    importpath = "github.com/agentydragon/ducktape/agentplane/history_service/settledcursors",
    deps = ["//agentplane/history_service:history_service_go_proto"],
)

go_test(
    name = "settledcursors_test",
    srcs = ["settledcursors_test.go"],
    embed = [":settledcursors"],
    deps = ["//agentplane/history_service:history_service_go_proto"],
)
