load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//agentplane/history_service:__subpackages__"])

go_library(
    name = "backfill",
    srcs = ["settlement.go"],
    importpath = "github.com/agentydragon/ducktape/agentplane/history_service/backfill",
    deps = [
        "//agentplane/history_service/api/history:history_service_go_proto",
        "//agentplane/history_service/internal/storage",
        "//agentplane/history_service/projection",
        "//agentplane/postgres",
        "@com_github_google_uuid//:uuid",
    ],
)

go_test(
    name = "integration_test",
    size = "medium",
    srcs = ["settlement_integration_test.go"],
    embed = [":backfill"],
    tags = ["requires_docker"],
    deps = [
        "//agentplane/history_service/api/history:history_service_go_proto",
        "//agentplane/history_service/internal/storage",
        "//agentplane/history_service/projection",
        "//agentplane/history_service/testing:integration_migrations",
        "//agentplane/history_service/testing/spans",
        "//agentplane/postgres",
        "//agentplane/postgres/lease",
        "//agentplane/proto:event_go_proto",
        "//agentplane/proto:event_log_go_proto",
        "//agentplane/testing/postgres",
        "@com_github_google_uuid//:uuid",
        "@org_golang_google_protobuf//proto",
    ],
)
