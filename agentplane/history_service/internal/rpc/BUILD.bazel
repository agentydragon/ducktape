load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//agentplane/history_service:__subpackages__"])

go_library(
    name = "rpc",
    srcs = [
        "follow.go",
        "service.go",
        "summary_fields.go",
        "watch.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/history_service/internal/rpc",
    deps = [
        "//agentplane/grpc/streaming",
        "//agentplane/history_service/api/history:history_service_go_proto",
        "//agentplane/history_service/internal/projection",
        "//agentplane/history_service/internal/reads",
        "//agentplane/history_service/internal/storage",
        "//agentplane/identity/auth",
        "//agentplane/postgres/wakeups",
        "@com_github_google_uuid//:uuid",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//reflect/protoreflect",
        "@org_golang_google_protobuf//types/known/emptypb",
        "@org_golang_google_protobuf//types/known/fieldmaskpb",
    ],
)

go_test(
    name = "summary_fields_test",
    srcs = ["summary_fields_test.go"],
    embed = [":rpc"],
    deps = [
        "//agentplane/history_service/api/history:history_service_go_proto",
        "//agentplane/proto:session_go_proto",
