load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//agentplane/history_service:__subpackages__"])

go_library(
    name = "projection",
    srcs = [
        "lease.go",
        "lifecycle.go",
        "payloads.go",
        "projector.go",
        "recording.go",
        "runner.go",
        "summary.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/history_service/projection",
    deps = [
        "//agentplane/history_service:history_service_go_proto",
        "//agentplane/history_service/settledcursors",
        "//agentplane/history_service/storage",
        "//agentplane/history_service/threadfold",
        "//agentplane/postgres/go:postgres",
        "//agentplane/postgres/go/lease",
        "//agentplane/proto:event_go_proto",
        "//agentplane/proto:event_log_go_proto",
        "//agentplane/proto:runner_go_proto",
        "@com_github_google_uuid//:uuid",
        "@com_github_lib_pq//:pq",
        "@org_golang_google_grpc//health",
        "@org_golang_google_grpc//health/grpc_health_v1",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
        "@org_golang_x_sync//errgroup",
    ],
)

go_test(
    name = "integration_test",
    size = "medium",
    srcs = [
        "integration_testmain_test.go",
        "large_history_integration_test.go",
        "lease_integration_test.go",
        "projector_integration_test.go",
        "recording_integration_test.go",
        "runner_integration_test.go",
    ],
    embed = [":projection"],
    tags = ["requires_docker"],
    deps = [
        "//agentplane/history_service:history_service_go_proto",
        "//agentplane/history_service/migrations",
        "//agentplane/history_service/reads",
        "//agentplane/history_service/storage",
        "//agentplane/history_service/testing/spans",
        "//agentplane/history_service/threadfold",
        "//agentplane/postgres/go/lease",
        "//agentplane/proto:command_go_proto",
        "//agentplane/proto:event_go_proto",
        "//agentplane/proto:event_log_go_proto",
        "//agentplane/proto:runner_go_proto",
        "//agentplane/testing/postgres",
        "@com_github_google_uuid//:uuid",
        "@com_github_lib_pq//:pq",
        "@org_golang_google_grpc//health",
        "@org_golang_google_grpc//health/grpc_health_v1",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/timestamppb",
        "@org_golang_x_sync//errgroup",
    ],
)

go_test(
    name = "lifecycle_test",
    srcs = ["lifecycle_test.go"],
    embed = [":projection"],
    deps = [
        "//agentplane/proto:event_go_proto",
        "//agentplane/proto:event_log_go_proto",
        "//agentplane/proto:runner_go_proto",
    ],
)
