load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//agentplane/history_service:__subpackages__"])

py_library(
    name = "models",
    srcs = ["models.py"],
    # The browser syncs these tables through the app's Electric proxy, so app tests read and seed
    # their rows.
    visibility = [
        "//agentplane/app:__subpackages__",
        "//agentplane/history_service:__subpackages__",
    ],
    deps = ["@pypi//sqlalchemy"],
)

py_library(
    name = "views",
    srcs = ["views.py"],
    visibility = ["//agentplane:__subpackages__"],
    deps = [
        "@pypi//pydantic",
    ],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    deps = [
        "//agentplane/history_service/testing:fixtures",
        "//agentplane/history_service/testing:go_service",
        "//agentplane/history_service/testing:history",
        "//agentplane/testing:kubernetes_apiserver_fixtures",
        "//util/testing:postgres_fixtures",
        "@pypi//pytest",
    ],
)

py_test(
    name = "test_recording",
    size = "medium",
    srcs = ["test_recording.py"],
    requires_docker = True,
    deps = [
        ":conftest",
        ":models",
        ":views",
        "//:conftest",
        "//agentplane/history_service/testing:history",
        "//agentplane/proto:command_pb2",
        "//agentplane/proto:event_log_pb2",
        "//agentplane/proto:event_pb2",
        "//agentplane/proto:session_pb2",
        "@pypi//protobuf",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)
