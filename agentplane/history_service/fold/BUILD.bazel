load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//agentplane/history_service:__subpackages__"])

py_library(
    name = "models",
    srcs = ["models.py"],
    # The browser syncs these tables through the app's Electric proxy, so app tests read and seed
    # their rows; the app's own migration tests recreate the copies its retired projection held.
    visibility = [
        "//agentplane/app:__subpackages__",
        "//agentplane/history_service:__subpackages__",
    ],
    deps = ["@pypi//sqlalchemy"],
)

py_library(
    name = "fold",
    srcs = ["fold.py"],
    deps = [
        ":views",
        "//agentplane/history_service:settled_cursors",
        "//agentplane/proto:command_pb2",
        "//agentplane/proto:event_log_pb2",
        "//agentplane/proto:event_pb2",
        "@pypi//protobuf",  # keep: mypy follows generated protobuf interfaces
        "@pypi//types_protobuf",  # keep: mypy follows generated protobuf interfaces
    ],
)

py_library(
    name = "lifecycle",
    srcs = ["lifecycle.py"],
    deps = [
        ":models",
        ":recording",
        "//agentplane/proto:event_log_pb2",
        "//agentplane/proto:history_service_pb2",
        "//agentplane/proto:runner_pb2",
        "@pypi//protobuf",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "model_activity",
    srcs = ["model_activity.py"],
    deps = [
        ":models",
        "//agentplane/proto:event_log_pb2",
        "//agentplane/proto:event_pb2",
        "@pypi//protobuf",
        "@pypi//sqlalchemy",
        "@pypi//types_protobuf",  # keep: mypy follows generated protobuf interfaces
    ],
)

py_library(
    name = "payloads",
    srcs = ["payloads.py"],
    deps = [
        ":fold",
        ":models",
        ":views",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "projection_lease",
    srcs = ["projection_lease.py"],
    deps = [
        ":models",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "projector",
    srcs = ["projector.py"],
    deps = [
        ":idle",
        ":lifecycle",
        ":model_activity",
        ":models",
        ":projection_lease",
        ":recording",
        "//agentplane/history_service:channels",
        "//agentplane/history_service:settled_cursors",
        "//agentplane/history_service/storage:store",
        "//agentplane/postgres:wakeups",
        "@pypi//protobuf",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "recording",
    srcs = ["recording.py"],
    deps = [
        ":fold",
        ":models",
        ":payloads",
        ":rows",
        ":views",
        "//agentplane/history_service:settled_cursors",
        "//agentplane/proto:event_log_pb2",
        "//agentplane/proto:history_service_pb2",
        "@pypi//protobuf",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "rows",
    srcs = ["rows.py"],
    deps = [
        ":fold",
        ":views",
        "@pypi//protobuf",
    ],
)

py_library(
    name = "views",
    srcs = ["views.py"],
    visibility = ["//agentplane:__subpackages__"],
    deps = [
        "@pypi//pydantic",
    ],
)

py_test(
    name = "test_fold",
    srcs = ["test_fold.py"],
    # Pure synchronous tests with local fixtures; no conftest fixture is needed.
    args = ["--noconftest"],
    deps = [
        ":fold",
        ":views",
        "//:conftest",
        "//agentplane/history_service:conftest",
        "//agentplane/proto:command_pb2",
        "//agentplane/proto:event_log_pb2",
        "//agentplane/proto:event_pb2",
        "@pypi//more_itertools",
        "@pypi//protobuf",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "idle",
    srcs = ["idle.py"],
    deps = [
        "//agentplane/proto:event_pb2",
        "@pypi//protobuf",
        "@pypi//types_protobuf",  # keep: mypy follows generated protobuf interfaces
    ],
)
