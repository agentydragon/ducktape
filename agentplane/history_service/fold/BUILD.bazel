load("//devinfra/python:defs.bzl", "py_binary", "py_library")

package(default_visibility = ["//agentplane/history_service:__subpackages__"])

py_library(
    name = "models",
    srcs = ["models.py"],
    # The browser syncs these tables through the app's Electric proxy, so app tests read and seed
    # their rows; the app's own migration tests recreate the copies its retired projection held.
    visibility = [
        "//agentplane/app:__subpackages__",
        "//agentplane/history_service:__subpackages__",
    ],
    deps = ["@pypi//sqlalchemy"],
)

py_library(
    name = "views",
    srcs = ["views.py"],
    visibility = ["//agentplane:__subpackages__"],
    deps = [
        "@pypi//pydantic",
    ],
)

py_library(
    name = "export_thread_entity_schema",
    srcs = ["export_thread_entity_schema.py"],
    deps = [
        ":views",
        "@pypi//pydantic",
    ],
)

py_binary(
    name = "export_thread_entity_schema_bin",
    main_module = "agentplane.history_service.fold.export_thread_entity_schema",
    visibility = ["//agentplane/app:__subpackages__"],
    deps = [":export_thread_entity_schema"],
)
