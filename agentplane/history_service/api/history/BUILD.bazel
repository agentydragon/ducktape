load("@aspect_rules_ts//ts:proto.bzl", "ts_proto_library")
load("@io_bazel_rules_go//proto:def.bzl", "go_proto_library")
load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("//devinfra/python:grpc.bzl", "py_grpc_service_library")
load("//devinfra/python:proto.bzl", "py_proto_library_with_mypy_stubs")

package(default_visibility = ["//agentplane:__subpackages__"])

proto_library(
    name = "history_service_proto",
    srcs = ["history_service.proto"],
    deps = [
        "//agentplane/proto:command_proto",
        "//agentplane/proto:event_log_proto",
        "//agentplane/proto:event_proto",
        "//agentplane/proto:session_proto",
        "@googleapis//google/api:annotations_proto",
        "@protobuf//:empty_proto",
        "@protobuf//:timestamp_proto",
    ],
)

py_proto_library_with_mypy_stubs(
    name = "history_service_pb2",
    deps = [":history_service_proto"],
)

py_grpc_service_library(
    name = "history_service_pb2_grpc",
    proto = ":history_service_proto",
    py_proto = ":history_service_pb2",
)

go_proto_library(
    name = "history_service_go_proto",
    compilers = [
        "@io_bazel_rules_go//proto:go_proto",
        "@io_bazel_rules_go//proto:go_grpc_v2",
        "//devinfra/go:grpc_gateway",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/history_service/api/history/history_servicepb",
    proto = ":history_service_proto",
    deps = [
        "//agentplane/proto:command_go_proto",
        "//agentplane/proto:event_go_proto",
        "//agentplane/proto:event_log_go_proto",
        "//agentplane/proto:session_go_proto",
        "@org_golang_google_genproto_googleapis_api//annotations",
    ],
)

ts_proto_library(
    name = "history_service_pb",
    copy_files = False,
    node_modules = "//:node_modules",
    proto = ":history_service_proto",
    deps = [
        "//agentplane/proto:command_pb",
        "//agentplane/proto:event_log_pb",
        "//agentplane/proto:event_pb",
        "//agentplane/proto:session_pb",
        "//google/api:annotations_pb",
    ],
)
