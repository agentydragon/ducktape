load("@io_bazel_rules_go//proto:def.bzl", "go_proto_library")
load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("//devinfra/python:grpc.bzl", "py_grpc_service_library")
load("//devinfra/python:proto.bzl", "py_proto_library_with_mypy_stubs")

proto_library(
    name = "session_ingress_proto",
    srcs = ["session_ingress.proto"],
    visibility = ["//agentplane:__subpackages__"],
    deps = [
        "//agentplane/proto:event_log_proto",
        "//agentplane/proto:identity_proto",
        "//agentplane/proto:session_proto",
    ],
)

py_proto_library_with_mypy_stubs(
    name = "session_ingress_pb2",
    visibility = ["//agentplane:__subpackages__"],
    deps = [":session_ingress_proto"],
)

py_grpc_service_library(
    name = "session_ingress_pb2_grpc",
    proto = ":session_ingress_proto",
    py_proto = ":session_ingress_pb2",
    visibility = ["//agentplane:__subpackages__"],
)

go_proto_library(
    name = "session_ingress_go_proto",
    compilers = [
        "@io_bazel_rules_go//proto:go_proto",
        "@io_bazel_rules_go//proto:go_grpc_v2",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/history_service/api/ingress/session_ingresspb",
    proto = ":session_ingress_proto",
    visibility = ["//visibility:public"],
    deps = [
        "//agentplane/proto:event_log_go_proto",
        "//agentplane/proto:identity_go_proto",
        "//agentplane/proto:session_go_proto",
    ],
)
