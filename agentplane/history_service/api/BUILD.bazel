load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//agentplane/history_service:__subpackages__"])

go_library(
    name = "api",
    srcs = [
        "follow.go",
        "service.go",
        "watch.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/history_service/api",
    deps = [
        "//agentplane/grpc/streaming",
        "//agentplane/history_service:history_service_go_proto",
        "//agentplane/history_service/projection",
        "//agentplane/history_service/reads",
        "//agentplane/history_service/storage",
        "//agentplane/postgres/go/wakeups",
        "//agentplane/workload_auth/go/auth",
        "@com_github_google_uuid//:uuid",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//types/known/emptypb",
    ],
)

go_test(
    name = "integration_test",
    size = "medium",
    srcs = [
        "follow_test.go",
        "integration_testmain_test.go",
        "service_test.go",
        "watch_test.go",
    ],
    embed = [":api"],
    tags = ["requires_docker"],
    deps = [
        "//agentplane/history_service:history_service_go_proto",
        "//agentplane/history_service/migrations",
        "//agentplane/history_service/projection",
        "//agentplane/history_service/reads",
        "//agentplane/history_service/storage",
        "//agentplane/history_service/testing/spans",
        "//agentplane/postgres/go/wakeups",
        "//agentplane/proto:event_go_proto",
        "//agentplane/proto:event_log_go_proto",
        "//agentplane/testing/grpcmethods",
        "//agentplane/testing/kubeapiserver",
        "//agentplane/testing/postgres",
        "//agentplane/workload_auth/go/auth",
        "@com_github_google_uuid//:uuid",
        "@com_github_lib_pq//:pq",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//credentials/insecure",
        "@org_golang_google_grpc//metadata",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/emptypb",
    ],
)
