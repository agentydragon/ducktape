load("//devinfra/python:defs.bzl", "py_library")

package(
    default_testonly = True,
    default_visibility = ["//agentplane:__subpackages__"],
)

py_library(
    name = "backend",
    testonly = True,
    srcs = ["backend.py"],
    deps = [
        "//agentplane:grpc_serving",
        "//agentplane:subjects",
        "//agentplane/history_service:client",
        "//agentplane/history_service:evidence",
        "//agentplane/history_service:fold_shadow",
        "//agentplane/history_service:grpc_api",
        "//agentplane/history_service:ingress",
        "//agentplane/history_service:summaries",
        "//agentplane/history_service:summary_changes",
        "//agentplane/history_service:thread_reads",
        "//agentplane/history_service/storage:history_changes",
        "//agentplane/history_service/storage:store",
        "//agentplane/runner:control",
        "//agentplane/runner:ingress",
        "//agentplane/runner:service",
        "//agentplane/workload_auth:principal",
        "//util/testing:sqlalchemy_engines",
        "@pypi//asyncpg",
        "@pypi//grpcio",
        "@pypi//kubernetes_asyncio",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "delta_spans",
    srcs = ["delta_spans.py"],
    deps = [
        "//agentplane/proto:event_log_pb2",
        "//agentplane/proto:event_pb2",
        "@pypi//protobuf",
    ],
)

py_library(
    name = "fixtures",
    srcs = ["fixtures.py"],
    deps = [
        "//agentplane/history_service/storage:db",
        "//agentplane/runner_gateway/commands:db",
        "//agentplane/thread_fold:models",
        "//util/testing:postgres",
        "//util/testing:sqlalchemy_engines",
        "@pypi//pytest",
        "@pypi//sqlalchemy",
    ],
)
