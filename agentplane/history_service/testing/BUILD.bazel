        "//agentplane/history_service:fold_runner",
        "//agentplane/history_service:protocol_pb2",
        "//agentplane/history_service:summary_changes",
        "//agentplane/history_service/fold",
        "//agentplane/history_service/fold:models",
        "//agentplane/history_service/fold:recording",
        "//agentplane/history_service/fold:rows",
        "//agentplane/history_service/fold:views",
