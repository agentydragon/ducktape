load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//agentplane/history_service:__subpackages__"])

go_library(
    name = "ingress",
    srcs = [
        "ingress.go",
        "sandbox_uid.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/history_service/ingress",
    deps = [
        "//agentplane/history_service:history_service_go_proto",
        "//agentplane/history_service:runner_ingress_go_proto",
        "//agentplane/history_service/storage",
        "//agentplane/proto:event_log_go_proto",
        "//agentplane/proto:runner_go_proto",
        "//agentplane/proto:sandboxes_go_proto",
        "//agentplane/sandboxes/api",
        "//agentplane/workload_auth/go/auth",
        "@com_github_google_uuid//:uuid",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_client_go//kubernetes",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//proto",
    ],
)

go_test(
    name = "integration_test",
    size = "medium",
    srcs = [
        "bounds_test.go",
        "ingress_test.go",
        "integration_testmain_test.go",
        "sampler_export_test.go",
        "sandbox_uid_test.go",
    ],
    embed = [":ingress"],
    tags = ["requires_docker"],
    deps = [
        "//agentplane/history_service:runner_ingress_go_proto",
        "//agentplane/history_service/migrations",
        "//agentplane/history_service/storage",
        "//agentplane/proto:command_go_proto",
        "//agentplane/proto:event_go_proto",
        "//agentplane/proto:event_log_go_proto",
        "//agentplane/proto:runner_go_proto",
        "//agentplane/proto:sandboxes_go_proto",
        "//agentplane/testing/kubeapiserver",
        "//agentplane/testing/postgres",
        "//agentplane/workload_auth/go/auth",
        "//agentplane/x/central_sampler",
        "//agentplane/x/central_sampler:sampler_go_proto",
        "//agentplane/x/central_sampler/protocol",
        "@com_github_google_uuid//:uuid",
        "@com_github_lib_pq//:pq",
        "@io_k8s_api//core/v1:core",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_client_go//kubernetes/fake",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//credentials/insecure",
        "@org_golang_google_grpc//metadata",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//proto",
    ],
)
