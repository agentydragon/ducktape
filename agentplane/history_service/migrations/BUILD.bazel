load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "migrations",
    srcs = ["migrations.go"],
    embedsrcs = glob(["history/*.sql"]),
    importpath = "github.com/agentydragon/ducktape/agentplane/history_service/migrations",
    visibility = ["//agentplane/history_service:__subpackages__"],
    deps = [
        "//agentplane/postgres/migrate",
    ],
)

go_test(
    name = "migrations_test",
    size = "medium",
    srcs = glob(["*_test.go"]),
    embed = [":migrations"],
    tags = ["requires_docker"],
    deps = [
        "//agentplane/history_service/internal/storage",
        "//agentplane/proto:event_go_proto",
        "//agentplane/proto:event_log_go_proto",
        "//agentplane/testing/postgres",
        "@com_github_google_uuid//:uuid",
        "@org_golang_google_protobuf//proto",
    ],
)
