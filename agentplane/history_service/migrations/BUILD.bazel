load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("@rules_oci//oci:defs.bzl", "oci_image")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//devinfra/python:defs.bzl", "py_test")

pkg_tar(
    name = "binary_layer",
    srcs = ["//agentplane/history_service/migrations/cmd:history-migrate"],
    package_dir = "/usr/local/bin",
)

oci_image(
    name = "image",
    base = "@distroless_static_debian13_linux_amd64",
    entrypoint = ["/usr/local/bin/history-migrate"],
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [":binary_layer"],
    user = "1000:1000",
    visibility = ["//visibility:public"],
    workdir = "/",
)

go_library(
    name = "migrations",
    srcs = ["migrations.go"],
    embedsrcs = glob(["history/*.sql"]),
    importpath = "github.com/agentydragon/ducktape/agentplane/history_service/migrations",
    visibility = ["//agentplane/history_service:__subpackages__"],
    deps = [
        "@com_github_pressly_goose_v3//:goose",
        "@com_github_pressly_goose_v3//lock",
    ],
)

py_test(
    name = "test_migrations",
    size = "medium",
    srcs = ["test_migrations.py"],
    data = ["//agentplane/history_service/migrations/cmd:history-migrate"],
    requires_docker = True,
    deps = [
        "//:conftest",
        "//agentplane/history_service:conftest",
        "//agentplane/history_service/storage:database_migrate",
        "//agentplane/testing:electric_role",
        "//util/bazel:runfiles",
        "//util/testing:postgres",
        "//util/testing:postgres_schema",
        "@pypi//psycopg",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)
