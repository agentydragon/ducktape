load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//devinfra/python:defs.bzl", "py_test")

go_library(
    name = "migrations",
    srcs = ["migrations.go"],
    embedsrcs = glob(["history/*.sql"]),
    importpath = "github.com/agentydragon/ducktape/agentplane/history_service/migrations",
    visibility = ["//agentplane/history_service:__subpackages__"],
    deps = [
        "@com_github_pressly_goose_v3//:goose",
        "@com_github_pressly_goose_v3//lock",
    ],
)

py_test(
    name = "test_migrations",
    size = "medium",
    srcs = ["test_migrations.py"],
    data = ["//agentplane/history_service/migrations/cmd:history-migrate"],
    requires_docker = True,
    deps = [
        "//:conftest",
        "//agentplane/history_service:conftest",
        "//agentplane/history_service/storage:database_migrate",
        "//agentplane/testing:electric_role",
        "//util/bazel:runfiles",
        "//util/testing:postgres",
        "@pypi//psycopg",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)
