load("@rules_oci//oci:defs.bzl", "oci_image")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//agentplane/history_service:__subpackages__"])

py_library(
    name = "channels",
    srcs = ["channels.py"],
    visibility = [
        "//agentplane/app:__pkg__",
        "//agentplane/history_service:__subpackages__",
    ],
)

py_library(
    name = "client",
    srcs = ["client.py"],
    visibility = [
        "//agentplane/app:__subpackages__",
        "//agentplane/env/e2e/testing:__pkg__",
        "//agentplane/history_service:__subpackages__",
        "//agentplane/system_tests:__subpackages__",
        "//agentplane/x/direct_vm_boot:__pkg__",
        "//agentplane/x/native_contracts:__pkg__",
    ],
    deps = [
        "//agentplane/grpc:calls",
        "//agentplane/history_service/api/history:history_service_pb2",
        "//agentplane/history_service/api/history:history_service_pb2_grpc",
        "@pypi//grpcio",
        "@pypi//protobuf",
    ],
)

py_library(
    name = "settings",
    srcs = ["settings.py"],
    visibility = [
        "//agentplane/history_service:__subpackages__",
        "//agentplane/system_tests:__subpackages__",
        "//cluster/cdk8s/agentplane:__pkg__",
    ],
    deps = [
        "//agentplane:subjects",
        "//agentplane/identity/auth:listener",
        "//agentplane/net/peertls:config",
        "@pypi//pydantic",
    ],
)

py_test(
    name = "test_settings",
    srcs = ["test_settings.py"],
    deps = [
        ":settings",
        "//:conftest",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

pkg_tar(
    name = "service_binary_layer",
    srcs = ["//agentplane/history_service/cmd:history-service"],
    package_dir = "/usr/local/bin",
)

oci_image(
    name = "service_image",
    base = "@distroless_static_debian13_linux_amd64",
    entrypoint = ["/usr/local/bin/history-service"],
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [
        ":service_binary_layer",
        "//agentplane/grpc/healthprobe:binary_layer",
    ],
    user = "1000:1000",
    visibility = ["//visibility:public"],
    workdir = "/",
)
