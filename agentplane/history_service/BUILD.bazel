load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("@rules_oci//oci:defs.bzl", "oci_image")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//agentplane/history_service:__subpackages__"])

py_library(
    name = "channels",
    srcs = ["channels.py"],
    visibility = [
        "//agentplane/app:__pkg__",
        "//agentplane/history_service:__subpackages__",
    ],
)

py_library(
    name = "client",
    srcs = ["client.py"],
    visibility = [
        "//agentplane/app:__subpackages__",
        "//agentplane/env/e2e/testing:__pkg__",
        "//agentplane/history_service:__subpackages__",
        "//agentplane/system_tests:__subpackages__",
    ],
    deps = [
        "//agentplane/grpc:calls",
        "//agentplane/history_service/api/history:history_service_pb2",
        "//agentplane/history_service/api/history:history_service_pb2_grpc",
        "@pypi//grpcio",
        "@pypi//protobuf",
    ],
)

py_library(
    name = "settings",
    srcs = ["settings.py"],
    visibility = [
        "//agentplane/history_service:__subpackages__",
        "//agentplane/system_tests:__subpackages__",
        "//cluster/cdk8s/agentplane:__pkg__",
    ],
    deps = [
        "//agentplane:subjects",
        "//agentplane/identity/auth:listener",
        "@pypi//pydantic",
    ],
)

py_test(
    name = "test_settings",
    srcs = ["test_settings.py"],
    deps = [
        ":settings",
        "//:conftest",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

go_library(
    name = "main_lib",
    srcs = [
        "compact_history.go",
        "config.go",
        "main.go",
        "settle_history.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/history_service",
    deps = [
        "//agentplane/environment_runtime_transport",
        "//agentplane/grpc/graceful",
        "//agentplane/history_service/api/history:history_service_go_proto",
        "//agentplane/history_service/api/ingress:session_ingress_go_proto",
        "//agentplane/history_service/backfill",
        "//agentplane/history_service/ingress",
        "//agentplane/history_service/internal/projection",
        "//agentplane/history_service/internal/reads",
        "//agentplane/history_service/internal/rpc",
        "//agentplane/history_service/internal/storage",
        "//agentplane/history_service/migrations",
        "//agentplane/identity/auth/auth",
        "//agentplane/identity/auth/listener",
        "//agentplane/identity/credentials/resolver",
        "//agentplane/kubeclient",
        "//agentplane/net/listener",
        "//agentplane/observability",
        "//agentplane/policy/api/v1alpha1",
        "//agentplane/postgres",
        "//agentplane/postgres/migrate",
        "//agentplane/postgres/wakeups",
        "@com_github_go_viper_mapstructure_v2//:mapstructure",
        "@com_github_google_uuid//:uuid",
        "@com_github_lib_pq//:pq",
        "@in_gopkg_yaml_v3//:yaml_v3",
        "@io_k8s_apimachinery//pkg/api/errors",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_apimachinery//pkg/runtime",
        "@io_k8s_apimachinery//pkg/util/sets",
        "@io_k8s_client_go//kubernetes",
        "@io_k8s_client_go//rest",
        "@io_k8s_sigs_controller_runtime//pkg/client",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//credentials",
        "@org_golang_google_grpc//health",
        "@org_golang_google_grpc//health/grpc_health_v1",
        "@org_golang_google_grpc//keepalive",
    ],
)

go_binary(
    name = "history-service",
    embed = [":main_lib"],
    pure = "on",
)

pkg_tar(
    name = "service_binary_layer",
    srcs = [":history-service"],
    package_dir = "/usr/local/bin",
)

oci_image(
    name = "service_image",
    base = "@distroless_static_debian13_linux_amd64",
    entrypoint = ["/usr/local/bin/history-service"],
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [
        ":service_binary_layer",
        "//agentplane/grpc/healthprobe:binary_layer",
    ],
    user = "1000:1000",
    visibility = ["//visibility:public"],
    workdir = "/",
)

go_test(
    name = "config_test",
    srcs = [
        "config_test.go",
        "settle_history_test.go",
    ],
    embed = [":main_lib"],
    deps = [
        "//agentplane/identity/auth/auth",
        "//agentplane/identity/auth/listener",
        "//agentplane/testing/configtest",
    ],
)

go_test(
    name = "integration_test",
    size = "medium",
    srcs = [
        "integration_testmain_test.go",
        "main_test.go",
        "svid_test.go",
    ],
    embed = [":main_lib"],
    tags = ["requires_docker"],
    deps = [
        "//agentplane/environment_runtime_transport",
        "//agentplane/environment_runtime_transport/testing",
        "//agentplane/history_service/api/history:history_service_go_proto",
        "//agentplane/history_service/api/ingress:session_ingress_go_proto",
        "//agentplane/history_service/internal/projection",
        "//agentplane/history_service/testing:integration_migrations",
        "//agentplane/history_service/testing/spans",
        "//agentplane/identity/auth/auth",
        "//agentplane/identity/auth/listener",
        "//agentplane/identity/auth/testing",
        "//agentplane/policy/api/v1alpha1",
        "//agentplane/proto:event_go_proto",
        "//agentplane/proto:event_log_go_proto",
        "//agentplane/proto:identity_go_proto",
        "//agentplane/proto:session_go_proto",
        "//agentplane/sandboxes/api",
        "//agentplane/testing/kubeapiserver",
        "//agentplane/testing/postgres",
        "@com_github_google_uuid//:uuid",
        "@com_github_lib_pq//:pq",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_client_go//tools/clientcmd",
        "@io_k8s_client_go//tools/clientcmd/api",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//credentials/insecure",
        "@org_golang_google_grpc//health/grpc_health_v1",
        "@org_golang_google_grpc//metadata",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//proto",
    ],
)
