load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")
load("@io_bazel_rules_go//proto:def.bzl", "go_proto_library")
load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_oci//oci:defs.bzl", "oci_image")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//devinfra/go:defs.bzl", "go_test")
load("//devinfra/python:defs.bzl", "py_library", "py_test")
load("//devinfra/python:grpc.bzl", "py_grpc_service_library")
load("//devinfra/python:proto.bzl", "py_proto_library_with_mypy_stubs")

package(default_visibility = ["//agentplane/history_service:__subpackages__"])

py_library(
    name = "channels",
    srcs = ["channels.py"],
    visibility = [
        "//agentplane/app:__pkg__",
        "//agentplane/history_service:__subpackages__",
    ],
)

py_library(
    name = "client",
    srcs = ["client.py"],
    visibility = [
        "//agentplane/app:__subpackages__",
        "//agentplane/history_service:__subpackages__",
        "//agentplane/runner/testing:__pkg__",
        "//agentplane/system_tests:__subpackages__",
    ],
    deps = [
        "//agentplane/grpc:calls",
        "//agentplane/grpc:options",
        "//agentplane/history_service:history_service_pb2",
        "//agentplane/history_service:history_service_pb2_grpc",
        "@pypi//grpcio",
        "@pypi//protobuf",
    ],
)

py_library(
    name = "settings",
    srcs = ["settings.py"],
    visibility = [
        "//agentplane/history_service:__subpackages__",
        "//agentplane/system_tests:__subpackages__",
        "//cluster/cdk8s/agentplane:__pkg__",
    ],
    deps = [
        "//agentplane:log_levels",
        "//agentplane:subjects",
        "//util:yaml_file_settings",
        "@pypi//pydantic",
        "@pypi//pydantic_settings",
    ],
)

py_library(
    name = "settled_cursors",
    srcs = ["settled_cursors.py"],
    visibility = ["//agentplane:__subpackages__"],
    deps = [
        "//agentplane/history_service:history_service_pb2",
        "@pypi//protobuf",
    ],
)

py_test(
    name = "test_settled_cursors",
    srcs = ["test_settled_cursors.py"],
    deps = [
        ":settled_cursors",
        "//:conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

go_library(
    name = "main_lib",
    srcs = [
        "config.go",
        "main.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/history_service",
    deps = [
        ":history_service_go_proto",
        ":runner_ingress_go_proto",
        "//agentplane/grpc/graceful",
        "//agentplane/history_service/api",
        "//agentplane/history_service/ingress",
        "//agentplane/history_service/projection",
        "//agentplane/history_service/reads",
        "//agentplane/history_service/storage",
        "//agentplane/observability",
        "//agentplane/postgres/go:postgres",
        "//agentplane/postgres/go/wakeups",
        "//agentplane/workload_auth/go/auth",
        "//util/netlistener",
        "@com_github_go_viper_mapstructure_v2//:mapstructure",
        "@com_github_lib_pq//:pq",
        "@com_github_spf13_viper//:viper",
        "@io_k8s_client_go//kubernetes",
        "@io_k8s_client_go//rest",
        "@io_k8s_client_go//tools/clientcmd",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//health",
        "@org_golang_google_grpc//health/grpc_health_v1",
        "@org_golang_google_grpc//keepalive",
    ],
)

go_binary(
    name = "history-service",
    embed = [":main_lib"],
    pure = "on",
)

pkg_tar(
    name = "service_binary_layer",
    srcs = [":history-service"],
    package_dir = "/usr/local/bin",
)

oci_image(
    name = "service_image",
    base = "@distroless_static_debian13_linux_amd64",
    entrypoint = ["/usr/local/bin/history-service"],
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [":service_binary_layer"],
    user = "1000:1000",
    visibility = ["//visibility:public"],
    workdir = "/",
)

go_test(
    name = "config_test",
    srcs = ["config_test.go"],
    embed = [":main_lib"],
    deps = ["//agentplane/workload_auth/go/auth"],
)

go_test(
    name = "integration_test",
    size = "medium",
    srcs = [
        "integration_testmain_test.go",
        "main_test.go",
    ],
    embed = [":main_lib"],
    tags = ["requires_docker"],
    deps = [
        ":history_service_go_proto",
        ":runner_ingress_go_proto",
        "//agentplane/history_service/migrations",
        "//agentplane/history_service/projection",
        "//agentplane/history_service/testing/spans",
        "//agentplane/proto:event_go_proto",
        "//agentplane/proto:event_log_go_proto",
        "//agentplane/proto:runner_go_proto",
        "//agentplane/sandboxes/api",
        "//agentplane/testing/kubeapiserver",
        "//agentplane/testing/postgres",
        "//agentplane/workload_auth/go/auth",
        "@com_github_google_uuid//:uuid",
        "@com_github_lib_pq//:pq",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//credentials/insecure",
        "@org_golang_google_grpc//health/grpc_health_v1",
        "@org_golang_google_grpc//metadata",
        "@org_golang_google_grpc//status",
    ],
)

proto_library(
    name = "runner_ingress_proto",
    srcs = ["runner_ingress.proto"],
    visibility = ["//agentplane:__subpackages__"],
    deps = [
        "//agentplane/proto:event_log_proto",
        "//agentplane/proto:runner_proto",
        "//agentplane/proto:sandboxes_proto",
    ],
)

py_proto_library_with_mypy_stubs(
    name = "runner_ingress_pb2",
    visibility = ["//agentplane:__subpackages__"],
    deps = [":runner_ingress_proto"],
)

py_grpc_service_library(
    name = "runner_ingress_pb2_grpc",
    proto = ":runner_ingress_proto",
    py_proto = ":runner_ingress_pb2",
    visibility = ["//agentplane:__subpackages__"],
)

proto_library(
    name = "history_service_proto",
    srcs = ["history_service.proto"],
    visibility = ["//agentplane:__subpackages__"],
    deps = [
        "//agentplane/proto:event_log_proto",
        "//agentplane/proto:event_proto",
        "//agentplane/proto:runner_proto",
        "@protobuf//:empty_proto",
        "@protobuf//:timestamp_proto",
    ],
)

py_proto_library_with_mypy_stubs(
    name = "history_service_pb2",
    visibility = ["//agentplane:__subpackages__"],
    deps = [":history_service_proto"],
)

py_grpc_service_library(
    name = "history_service_pb2_grpc",
    proto = ":history_service_proto",
    py_proto = ":history_service_pb2",
    visibility = ["//agentplane:__subpackages__"],
)

go_proto_library(
    name = "runner_ingress_go_proto",
    compilers = [
        "@io_bazel_rules_go//proto:go_proto",
        "@io_bazel_rules_go//proto:go_grpc_v2",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/history_service/runner_ingresspb",
    proto = ":runner_ingress_proto",
    visibility = ["//visibility:public"],
    deps = [
        "//agentplane/proto:event_log_go_proto",
        "//agentplane/proto:runner_go_proto",
        "//agentplane/proto:sandboxes_go_proto",
    ],
)

go_proto_library(
    name = "history_service_go_proto",
    compilers = [
        "@io_bazel_rules_go//proto:go_proto",
        "@io_bazel_rules_go//proto:go_grpc_v2",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/history_service/history_servicepb",
    proto = ":history_service_proto",
    visibility = ["//agentplane:__subpackages__"],
    deps = [
        "//agentplane/proto:event_go_proto",
        "//agentplane/proto:event_log_go_proto",
        "//agentplane/proto:runner_go_proto",
    ],
)
