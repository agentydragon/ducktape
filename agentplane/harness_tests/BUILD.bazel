load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(
    default_testonly = True,
    default_visibility = ["//agentplane:__subpackages__"],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    deps = [
        "//util/testing:undeclared_outputs",
        "@pypi//pytest",
    ],
)

py_library(
    name = "model_endpoint",
    srcs = ["model_endpoint.py"],
    deps = ["@pypi//aiohttp"],
)

py_test(
    name = "test_model_endpoint",
    srcs = ["test_model_endpoint.py"],
    deps = [
        ":conftest",
        ":model_endpoint",
        "//:conftest",
        "//agentplane/harness_tests/claude:messages",
        "@pypi//aiohttp",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

test_suite(
    name = "harness_tests",
    tests = [
        ":test_model_endpoint",
        "//agentplane/harness_tests/claude:test_active_turn",
        "//agentplane/harness_tests/claude:test_connection_loss",
        "//agentplane/harness_tests/claude:test_tools",
        "//agentplane/harness_tests/claude:test_turns",
        "//agentplane/harness_tests/codex:test_active_turn",
        "//agentplane/harness_tests/codex:test_connection_loss",
        "//agentplane/harness_tests/codex:test_tools",
        "//agentplane/harness_tests/codex:test_turns",
    ],
)
