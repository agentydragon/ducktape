load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(
    default_testonly = True,
    default_visibility = ["//agentplane:__subpackages__"],
)

py_library(
    name = "anthropic_sse",
    srcs = ["anthropic_sse.py"],
    deps = ["//agentplane/harness_tests:model_endpoint"],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    deps = [
        ":harness",
        ":messages",
        "//util/bazel:runfiles",
        "@pypi//pytest",
    ],
)

py_library(
    name = "messages",
    srcs = ["messages.py"],
    deps = [
        ":requests",
        "//agentplane/harness_tests:model_endpoint",
    ],
)

py_library(
    name = "frames",
    srcs = ["frames.py"],
    deps = [
        "//agentplane/native/claude:blocks",
        "//agentplane/native/claude:wire",
    ],
)

py_library(
    name = "harness",
    srcs = ["harness.py"],
    deps = [
        ":messages",
        "//agentplane/native/claude:async_run",
        "//agentplane/native/claude:driver",
        "//agentplane/native/claude:mcp",
        "//agentplane/native/claude:scenarios",
        "//agentplane/native/claude:wire",
    ],
)

py_library(
    name = "requests",
    srcs = ["requests.py"],
    deps = [
        "//agentplane/native/claude:blocks",
        "@pypi//pydantic",
    ],
)

py_test(
    name = "test_active_turn",
    size = "medium",
    srcs = ["test_active_turn.py"],
    data = ["@claude_code_cli_linux_x64//:claude"],  # keep: the pinned native harness the test drives
    target_compatible_with = [
        # keep: the pinned native harnesses are Linux/x86_64 only.
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    deps = [
        ":anthropic_sse",
        ":conftest",
        ":frames",
        ":harness",
        ":messages",
        "//:conftest",
        "//agentplane/harness_tests:conftest",
        "//agentplane/native/claude:wire",
        "@pypi//pytest_bazel",
    ],
)

