load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//agentplane:__subpackages__"])

go_library(
    name = "server_lib",
    srcs = [
        "codex_catalog.go",
        "config.go",
        "model_config.go",
        "runtime.go",
        "server.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/llm_ingress/internal/server",
    visibility = ["//agentplane/llm_ingress/cmd:__pkg__"],
    deps = [
        "//agentplane/configfile",
        "//agentplane/grpc/graceful",
        "//agentplane/identity/auth",
        "//agentplane/identity/auth/listener",
        "//agentplane/identity/credentials/resolver",
        "//agentplane/kubeclient",
        "//agentplane/llm_ingress/v1:model_config_go_proto",
        "//agentplane/net/peertls",
        "//agentplane/observability",
        "@io_k8s_client_go//rest",
        "@io_opentelemetry_go_otel//baggage",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//health",
        "@org_golang_google_grpc//health/grpc_health_v1",
        "@org_golang_google_grpc//status",
    ],
)

go_test(
    name = "ingress_test",
    srcs = [
        "codex_catalog_test.go",
        "config_test.go",
        "delegated_attribution_test.go",
        "ingress_test.go",
        "model_config_test.go",
        "model_config_workload_test.go",
        "workload_ingress_test.go",
    ],
    data = ["//agentplane/llm_ingress/cmd:server"],
    embed = [":server_lib"],
    visibility = ["//agentplane/llm_ingress:__pkg__"],
    x_defs = {
        "github.com/agentydragon/ducktape/agentplane/llm_ingress/internal/server.ingressServerRlocation": "$(rlocationpath //agentplane/llm_ingress/cmd:server)",
    },
    deps = [
        "//agentplane/identity/auth",
        "//agentplane/identity/auth/listener",
        "//agentplane/identity/auth/testing",
        "//agentplane/identity/credentials/resolver",
        "//agentplane/llm_ingress/v1:model_config_go_proto",
        "//agentplane/net/peertls/testing",
        "//agentplane/proto:delegation_go_proto",
        "//agentplane/proto:identity_go_proto",
        "//agentplane/testing/configtest",
        "//agentplane/testing/kubeapiserver",
        "@com_github_google_uuid//:uuid",
        "@io_bazel_rules_go//go/runfiles",
        "@io_k8s_api//authentication/v1:authentication",
        "@io_k8s_api//core/v1:core",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_client_go//rest",
        "@io_opentelemetry_go_otel//baggage",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//credentials",
        "@org_golang_google_grpc//credentials/insecure",
        "@org_golang_google_grpc//health/grpc_health_v1",
        "@org_golang_google_grpc//metadata",
        "@org_golang_google_grpc//status",
    ],
)
