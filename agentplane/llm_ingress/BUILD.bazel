load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("@rules_oci//oci:defs.bzl", "oci_image")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//devinfra/python:defs.bzl", "py_test")

package(default_visibility = ["//agentplane:__subpackages__"])

pkg_tar(
    name = "binary_layer",
    srcs = [":server"],
    mode = "0755",
    package_dir = "/usr/local/bin",
)

oci_image(
    name = "image",
    base = "@distroless_static_debian13_linux_amd64",
    entrypoint = ["/usr/local/bin/server"],
    env = {"SSL_CERT_FILE": "/etc/ssl/certs/ca-certificates.crt"},
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [
        ":binary_layer",
        "//third_party/debian_slim:cacerts",
    ],
    user = "1000:1000",
    workdir = "/",
)

go_library(
    name = "server_lib",
    srcs = [
        "codex_catalog.go",
        "config.go",
        "main.go",
        "server.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/llm_ingress",
    deps = [
        "//agentplane/llm_ingress/configpb",
        "//agentplane/observability",
        "//agentplane/workload_auth/go/auth",
        "@build_buf_go_protovalidate//:protovalidate",
        "@build_buf_go_protoyaml//:protoyaml",
        "@in_yaml_go_yaml_v3//:yaml",
        "@io_k8s_client_go//kubernetes/typed/authentication/v1:authentication",
        "@io_k8s_client_go//rest",
        "@io_k8s_client_go//tools/clientcmd",
        "@io_opentelemetry_go_otel//baggage",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//reflect/protoreflect",
    ],
)

go_binary(
    name = "server",
    embed = [":server_lib"],
    pure = "on",
)

go_test(
    name = "ingress_test",
    srcs = [
        "codex_catalog_test.go",
        "config_test.go",
        "ingress_test.go",
    ],
    data = [":server"],
    embed = [":server_lib"],
    deps = [
        "//agentplane/llm_ingress/configpb",
        "//agentplane/testing/kubeapiserver",
        "//agentplane/workload_auth/go/auth",
        "@io_bazel_rules_go//go/runfiles",
        "@io_k8s_api//core/v1:core",
        "@io_k8s_client_go//rest",
        "@io_opentelemetry_go_otel//baggage",
    ],
)

py_test(
    name = "test_config",
    srcs = ["test_config.py"],
    deps = [
        "//:conftest",
        "//agentplane/llm_ingress/configpb:config_pb2",
        "//util:protobuf_config",
        "@pypi//protobuf",
        "@pypi//protovalidate",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
