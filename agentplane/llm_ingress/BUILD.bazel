load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("@rules_oci//oci:defs.bzl", "oci_image")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//devinfra/python:defs.bzl", "py_library")

package(default_visibility = ["//agentplane:__subpackages__"])

py_library(
    name = "models",
    srcs = ["models.py"],
    visibility = [
        "//agentplane:__subpackages__",
        "//cluster/cdk8s:__pkg__",
        "//cluster/cdk8s/agentplane:__pkg__",
    ],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "settings",
    srcs = ["settings.py"],
    visibility = [
        "//agentplane:__subpackages__",
        "//cluster/cdk8s/agentplane:__pkg__",
    ],
    deps = [
        ":models",
        "//agentplane:log_levels",
        "//agentplane/environment_runtime_transport:config",
        "//util:urls",
        "//util:yaml_file_settings",
        "@pypi//pydantic",
        "@pypi//pydantic_settings",
    ],
)

pkg_tar(
    name = "binary_layer",
    srcs = [":server"],
    mode = "0755",
    package_dir = "/usr/local/bin",
)

oci_image(
    name = "image",
    base = "@distroless_static_debian13_linux_amd64",
    entrypoint = ["/usr/local/bin/server"],
    env = {"SSL_CERT_FILE": "/etc/ssl/certs/ca-certificates.crt"},
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [
        ":binary_layer",
        "//third_party/debian_slim:cacerts",
    ],
    user = "1000:1000",
    workdir = "/",
)

go_library(
    name = "server_lib",
    srcs = [
        "codex_catalog.go",
        "config.go",
        "main.go",
        "model_config.go",
        "server.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/llm_ingress",
    deps = [
        "//agentplane/environment_runtime_transport",
        "//agentplane/grpc/graceful",
        "//agentplane/llm_ingress/v1:model_config_go_proto",
        "//agentplane/observability",
        "//agentplane/workload_auth/auth",
        "@com_github_google_uuid//:uuid",
        "@com_github_spf13_viper//:viper",
        "@io_k8s_client_go//kubernetes/typed/authentication/v1:authentication",
        "@io_k8s_client_go//rest",
        "@io_k8s_client_go//tools/clientcmd",
        "@io_opentelemetry_go_otel//baggage",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//health",
        "@org_golang_google_grpc//health/grpc_health_v1",
        "@org_golang_google_grpc//status",
    ],
)

go_binary(
    name = "server",
    embed = [":server_lib"],
    pure = "on",
)

go_test(
    name = "ingress_test",
    srcs = [
        "codex_catalog_test.go",
        "config_test.go",
        "ingress_test.go",
        "model_config_test.go",
        "workload_ingress_test.go",
    ],
    data = [":server"],
    embed = [":server_lib"],
    x_defs = {"github.com/agentydragon/ducktape/agentplane/llm_ingress.ingressServerRlocation": "$(rlocationpath :server)"},
    deps = [
        "//agentplane/environment_runtime_transport/testing",
        "//agentplane/llm_ingress/v1:model_config_go_proto",
        "//agentplane/testing/configtest",
        "//agentplane/testing/kubeapiserver",
        "//agentplane/workload_auth/auth",
        "//agentplane/workload_auth/testing",
        "@io_bazel_rules_go//go/runfiles",
        "@io_k8s_api//authentication/v1:authentication",
        "@io_k8s_api//core/v1:core",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_client_go//rest",
        "@io_opentelemetry_go_otel//baggage",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//credentials/insecure",
        "@org_golang_google_grpc//metadata",
        "@org_golang_google_grpc//status",
    ],
)
