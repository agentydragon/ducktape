load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("@rules_oci//oci:defs.bzl", "oci_image")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//agentplane:__subpackages__"])

py_library(
    name = "models",
    srcs = ["models.py"],
    visibility = [
        "//agentplane:__subpackages__",
        "//cluster/cdk8s:__pkg__",
        "//cluster/cdk8s/agentplane:__pkg__",
    ],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "settings",
    srcs = ["settings.py"],
    visibility = [
        "//agentplane:__subpackages__",
        "//cluster/cdk8s/agentplane:__pkg__",
    ],
    deps = [
        ":models",
        "//agentplane:log_levels",
        "//util:urls",
        "//util:yaml_file_settings",
        "@pypi//pydantic",
        "@pypi//pydantic_settings",
    ],
)

py_test(
    name = "test_ingress",
    size = "medium",
    srcs = ["test_ingress.py"],
    data = [":server"],
    deps = [
        ":models",
        "//:conftest",
        "//agentplane:sandbox_resource",
        "//agentplane/testing:fake_apiserver",
        "//util:net",
        "//util/bazel:runfiles",
        "//util/testing:undeclared_outputs",
        "@pypi//aiohttp",
        "@pypi//httpx",
        "@pypi//more_itertools",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//pyyaml",
    ],
)

pkg_tar(
    name = "binary_layer",
    srcs = [":server"],
    mode = "0755",
    package_dir = "/usr/local/bin",
)

oci_image(
    name = "image",
    base = "@distroless_static_debian13_linux_amd64",
    entrypoint = ["/usr/local/bin/server"],
    env = {"SSL_CERT_FILE": "/etc/ssl/certs/ca-certificates.crt"},
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [
        ":binary_layer",
        "//third_party/debian_slim:cacerts",
    ],
    user = "1000:1000",
    workdir = "/",
)

go_library(
    name = "server_lib",
    srcs = [
        "config.go",
        "main.go",
        "server.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/llm_ingress",
    deps = [
        "//agentplane/workload_auth/go/auth",
        "@in_gopkg_yaml_v3//:yaml_v3",
        "@io_k8s_client_go//kubernetes/typed/authentication/v1:authentication",
        "@io_k8s_client_go//rest",
        "@io_k8s_client_go//tools/clientcmd",
    ],
)

go_binary(
    name = "server",
    embed = [":server_lib"],
    pure = "on",
)

go_test(
    name = "config_test",
    srcs = ["config_test.go"],
    embed = [":server_lib"],
)
