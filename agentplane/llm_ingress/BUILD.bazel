load("@rules_oci//oci:defs.bzl", "oci_image")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//agentplane:__subpackages__"])

py_library(
    name = "models",
    srcs = ["models.py"],
    visibility = [
        "//agentplane:__subpackages__",
        "//cluster/cdk8s:__pkg__",
        "//cluster/cdk8s/agentplane:__pkg__",
    ],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "settings",
    srcs = ["settings.py"],
    visibility = [
        "//agentplane:__subpackages__",
        "//cluster/cdk8s/agentplane:__pkg__",
    ],
    deps = [
        ":models",
        "//agentplane:log_levels",
        "//agentplane/identity/auth:listener",
        "//agentplane/net/peertls:config",
        "//util:urls",
        "@pypi//pydantic",
    ],
)

pkg_tar(
    name = "binary_layer",
    srcs = [":server"],
    mode = "0755",
    package_dir = "/usr/local/bin",
)

oci_image(
    name = "image",
    base = "@distroless_static_debian13_linux_amd64",
    entrypoint = ["/usr/local/bin/server"],
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [
        ":binary_layer",
        "//agentplane/grpc/healthprobe:binary_layer",
    ],
    user = "1000:1000",
    workdir = "/",
)

alias(
    name = "server",
    actual = "//agentplane/llm_ingress/cmd:server",
)

test_suite(
    name = "ingress_test",
    tests = ["//agentplane/llm_ingress/internal/server:ingress_test"],
)

py_test(
    name = "test_models",
    srcs = ["test_models.py"],
    deps = [
        ":models",
        "//:conftest",
    ],
)
