load("@io_bazel_rules_go//proto:def.bzl", "go_proto_library")
load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("//devinfra/python:grpc.bzl", "py_grpc_service_library")
load("//devinfra/python:proto.bzl", "py_proto_library_with_mypy_stubs")

package(default_visibility = ["//agentplane:__subpackages__"])

proto_library(
    name = "model_config_proto",
    srcs = ["model_config.proto"],
)

py_proto_library_with_mypy_stubs(
    name = "model_config_pb2",
    deps = [":model_config_proto"],
)

py_grpc_service_library(
    name = "model_config_pb2_grpc",
    proto = ":model_config_proto",
    py_proto = ":model_config_pb2",
)

go_proto_library(
    name = "model_config_go_proto",
    compilers = [
        "@io_bazel_rules_go//proto:go_proto",
        "@io_bazel_rules_go//proto:go_grpc_v2",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/llm_ingress/v1",
    proto = ":model_config_proto",
)
