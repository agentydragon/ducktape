load("@aspect_rules_py//py:defs.bzl", aspect_py_binary = "py_binary")
load("@bazel_skylib//rules:native_binary.bzl", "native_test")
load("//devinfra/python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:private"])

aspect_py_binary(
    name = "external_proto_import_probe",
    main = "probe.py",
    deps = [":probe"],
)

native_test(
    name = "external_proto_import_test",
    src = ":external_proto_import_probe",
)

py_library(
    name = "probe",
    srcs = ["probe.py"],
    deps = [
        "//agentplane/runner_gateway/dispatcher:session_dispatcher_pb2",
        "@pypi//protobuf",
    ],
)
