load("@aspect_rules_py//py:defs.bzl", aspect_py_binary = "py_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//devinfra/python:defs.bzl", "py_library")

# gazelle:resolve py agentplane.proto.session_dispatcher_pb2 //agentplane/proto:session_dispatcher_pb2

