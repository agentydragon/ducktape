aspect_py_binary(
    name = "external_proto_import_probe",
    main = "probe.py",
    deps = [":probe"],
)

sh_test(
    name = "external_proto_import_test",
    srcs = ["run_external_proto_import_probe.sh"],
    args = ["$(rlocationpath :external_proto_import_probe)"],
    data = [":external_proto_import_probe"],
)

py_library(
    name = "probe",
    srcs = ["probe.py"],
    deps = [
        "//agentplane/proto:session_dispatcher_pb2",
        "@pypi//protobuf",
    ],
)
