load("@aspect_bazel_lib//lib:directory_path.bzl", "directory_path")
load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library", "js_test")
load("@io_bazel_rules_go//proto:def.bzl", "go_proto_library")
load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("//devinfra/python:proto.bzl", "py_proto_library_with_mypy_stubs")
load(":typescript_proto.bzl", "typescript_proto_compile")

package(default_visibility = ["//agentplane:__subpackages__"])

directory_path(
    name = "protoc_gen_es_entry",
    directory = "//:node_modules/@bufbuild/protoc-gen-es/dir",
    path = "bin/protoc-gen-es",
)

js_binary(
    name = "protoc_gen_es",
    data = ["//:node_modules/@bufbuild/protoc-gen-es"],
    entry_point = ":protoc_gen_es_entry",
)

# Generate browser-facing Agentplane protos from API roots. Imported schemas, including Google
# HTTP annotations, are discovered from each ProtoInfo closure.
typescript_proto_compile(
    name = "agentplane_proto_generated",
    protos = [
        ":event_log_proto",
        ":runner_proto",
        "//agentplane/action_service:operator_action_service_proto",
        "//agentplane/action_service:web_push_service_proto",
        "//agentplane/mcp_edge:connection_service_proto",
    ],
)

js_library(
    name = "agentplane_proto_js",
    srcs = [":agentplane_proto_generated"],
    deps = ["//:node_modules/@bufbuild/protobuf"],
)

js_test(
    name = "typescript_proto_runtime_test",
    data = [
        ":agentplane_proto_js",
        ":typescript_transitive_fixture_js",
    ],
    entry_point = "typescript_proto_runtime_test.mjs",
)

typescript_proto_compile(
    name = "typescript_transitive_fixture_generated",
    testonly = True,
    protos = ["//agentplane/proto/typescript_generation_test:root_proto"],
)

js_library(
    name = "typescript_transitive_fixture_js",
    testonly = True,
    srcs = [":typescript_transitive_fixture_generated"],
    deps = ["//:node_modules/@bufbuild/protobuf"],
)

proto_library(
    name = "grpc_tunnel_proto",
    srcs = ["grpc_tunnel.proto"],
    deps = ["@protobuf//:duration_proto"],
)

py_proto_library_with_mypy_stubs(
    name = "grpc_tunnel_pb2",
    deps = [":grpc_tunnel_proto"],
)

proto_library(
    name = "command_proto",
    srcs = ["command.proto"],
    visibility = ["//visibility:public"],
)

py_proto_library_with_mypy_stubs(
    name = "command_pb2",
    visibility = ["//visibility:public"],
    deps = [":command_proto"],
)

proto_library(
    name = "event_proto",
    srcs = ["event.proto"],
    visibility = ["//visibility:public"],
    deps = [
        ":command_proto",
        "@protobuf//:timestamp_proto",
    ],
)

py_proto_library_with_mypy_stubs(
    name = "event_pb2",
    visibility = ["//visibility:public"],
    deps = [":event_proto"],
)

proto_library(
    name = "event_log_proto",
    srcs = ["event_log.proto"],
    visibility = ["//visibility:public"],
    deps = [":event_proto"],
)

py_proto_library_with_mypy_stubs(
    name = "event_log_pb2",
    visibility = ["//visibility:public"],
    deps = [":event_log_proto"],
)

proto_library(
    name = "runner_proto",
    srcs = ["runner.proto"],
    visibility = ["//visibility:public"],
    deps = ["@protobuf//:timestamp_proto"],
)

py_proto_library_with_mypy_stubs(
    name = "runner_pb2",
    visibility = ["//visibility:public"],
    deps = [":runner_proto"],
)

proto_library(
    name = "sandboxes_proto",
    srcs = ["sandboxes.proto"],
    visibility = ["//agentplane:__subpackages__"],
    deps = [
        "@protobuf//:duration_proto",
        "@protobuf//:struct_proto",
        "@protobuf//:timestamp_proto",
    ],
)

py_proto_library_with_mypy_stubs(
    name = "sandboxes_pb2",
    deps = [":sandboxes_proto"],
)

# The Sandbox controller calls `Runner.Seal` through the Runner Gateway's proxy.
go_proto_library(
    name = "command_go_proto",
    importpath = "github.com/agentydragon/ducktape/agentplane/proto/command",
    proto = ":command_proto",
)

go_proto_library(
    name = "event_go_proto",
    importpath = "github.com/agentydragon/ducktape/agentplane/proto/event",
    proto = ":event_proto",
    deps = [":command_go_proto"],
)

go_proto_library(
    name = "event_log_go_proto",
    importpath = "github.com/agentydragon/ducktape/agentplane/proto/event_log",
    proto = ":event_log_proto",
    deps = [":event_go_proto"],
)

go_proto_library(
    name = "runner_go_proto",
    importpath = "github.com/agentydragon/ducktape/agentplane/proto/runner",
    proto = ":runner_proto",
)

go_proto_library(
    name = "grpc_tunnel_go_proto",
    importpath = "github.com/agentydragon/ducktape/agentplane/proto/grpc_tunnel",
    proto = ":grpc_tunnel_proto",
)

go_proto_library(
    name = "sandboxes_go_proto",
    importpath = "github.com/agentydragon/ducktape/agentplane/proto/sandboxes",
    proto = ":sandboxes_proto",
)
