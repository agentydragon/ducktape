load("@aspect_bazel_lib//lib:directory_path.bzl", "directory_path")
load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library", "js_test")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config")
load("@aspect_rules_ts//ts:proto.bzl", "ts_proto_library")
load("@io_bazel_rules_go//proto:def.bzl", "go_proto_library")
load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("//devinfra/js:ts_library.bzl", "ts_library")
load("//devinfra/python:proto.bzl", "py_proto_library_with_mypy_stubs")
load(":typescript_proto.bzl", "typescript_proto_compile")

package(default_visibility = ["//agentplane:__subpackages__"])

directory_path(
    name = "protoc_gen_es_entry",
    directory = "//:node_modules/@bufbuild/protoc-gen-es/dir",
    path = "bin/protoc-gen-es",
)

js_binary(
    name = "protoc_gen_es",
    data = ["//:node_modules/@bufbuild/protoc-gen-es"],
    entry_point = ":protoc_gen_es_entry",
)

# Generate this API's full imported schema closure so Google HTTP annotations and
# notification messages have one consistent Protobuf-ES module graph.
typescript_proto_compile(
    name = "notification_operator_proto_generated",
    options = ["json_types=true"],
    protos = ["//agentplane/notification_service:notifications_operator_proto"],
)

js_library(
    name = "notification_operator_proto_js",
    srcs = [":notification_operator_proto_generated"],
    deps = ["//:node_modules/@bufbuild/protobuf"],
)

js_test(
    name = "notification_operator_proto_runtime_test",
    data = [":notification_operator_proto_js"],
    entry_point = "notification_operator_proto_runtime_test.mjs",
)

ts_config(
    name = "notification_operator_proto_tsconfig",
    src = "notification_operator_proto_tsconfig.json",
)

ts_library(
    name = "notification_operator_proto_json_types_consumer",
    testonly = True,
    srcs = ["notification_operator_proto_json_types_consumer.ts"],
    tsconfig = ":notification_operator_proto_tsconfig",
    deps = [":notification_operator_proto_js"],
)

proto_library(
    name = "runner_state_proto",
    srcs = ["runner_state.proto"],
    deps = [
        ":sandboxes_proto",
        "@protobuf//:timestamp_proto",
    ],
)

py_proto_library_with_mypy_stubs(
    name = "runner_state_pb2",
    deps = [":runner_state_proto"],
)

proto_library(
    name = "command_proto",
    srcs = ["command.proto"],
    visibility = ["//visibility:public"],
)

py_proto_library_with_mypy_stubs(
    name = "command_pb2",
    visibility = ["//visibility:public"],
    deps = [":command_proto"],
)

ts_proto_library(
    name = "command_pb",
    copy_files = False,
    node_modules = "//:node_modules",
    proto = ":command_proto",
    visibility = ["//visibility:public"],
)

proto_library(
    name = "event_proto",
    srcs = ["event.proto"],
    visibility = ["//visibility:public"],
    deps = [
        ":command_proto",
        "@protobuf//:timestamp_proto",
    ],
)

py_proto_library_with_mypy_stubs(
    name = "event_pb2",
    visibility = ["//visibility:public"],
    deps = [":event_proto"],
)

ts_proto_library(
    name = "event_pb",
    copy_files = False,
    node_modules = "//:node_modules",
    proto = ":event_proto",
    visibility = ["//visibility:public"],
    deps = [":command_pb"],
)

proto_library(
    name = "event_log_proto",
    srcs = ["event_log.proto"],
    visibility = ["//visibility:public"],
    deps = [":event_proto"],
)

py_proto_library_with_mypy_stubs(
    name = "event_log_pb2",
    visibility = ["//visibility:public"],
    deps = [":event_log_proto"],
)

ts_proto_library(
    name = "event_log_pb",
    copy_files = False,
    node_modules = "//:node_modules",
    proto = ":event_log_proto",
    visibility = ["//visibility:public"],
    deps = [":event_pb"],
)

proto_library(
    name = "runner_proto",
    srcs = ["runner.proto"],
    visibility = ["//visibility:public"],
    deps = ["@protobuf//:timestamp_proto"],
)

py_proto_library_with_mypy_stubs(
    name = "runner_pb2",
    visibility = ["//visibility:public"],
    deps = [":runner_proto"],
)

ts_proto_library(
    name = "runner_pb",
    copy_files = False,
    node_modules = "//:node_modules",
    proto = ":runner_proto",
    visibility = ["//visibility:public"],
)

proto_library(
    name = "sandboxes_proto",
    srcs = ["sandboxes.proto"],
    deps = [
        "@protobuf//:duration_proto",
        "@protobuf//:struct_proto",
        "@protobuf//:timestamp_proto",
    ],
)

py_proto_library_with_mypy_stubs(
    name = "sandboxes_pb2",
    deps = [":sandboxes_proto"],
)

ts_proto_library(
    name = "sandboxes_pb",
    copy_files = False,
    node_modules = "//:node_modules",
    proto = ":sandboxes_proto",
    visibility = ["//visibility:public"],
    deps = [":runner_pb"],
)

# The Sandbox controller calls `Runner.Seal` through the Runner Gateway's proxy.
go_proto_library(
    name = "command_go_proto",
    importpath = "github.com/agentydragon/ducktape/agentplane/proto/command",
    proto = ":command_proto",
)

go_proto_library(
    name = "event_go_proto",
    importpath = "github.com/agentydragon/ducktape/agentplane/proto/event",
    proto = ":event_proto",
    deps = [":command_go_proto"],
)

go_proto_library(
    name = "event_log_go_proto",
    importpath = "github.com/agentydragon/ducktape/agentplane/proto/event_log",
    proto = ":event_log_proto",
    deps = [":event_go_proto"],
)

go_proto_library(
    name = "runner_go_proto",
    importpath = "github.com/agentydragon/ducktape/agentplane/proto/runner",
    proto = ":runner_proto",
)

go_proto_library(
    name = "runner_state_go_proto",
    importpath = "github.com/agentydragon/ducktape/agentplane/proto/runner_statepb",
    proto = ":runner_state_proto",
    deps = [":sandboxes_go_proto"],
)

go_proto_library(
    name = "sandboxes_go_proto",
    importpath = "github.com/agentydragon/ducktape/agentplane/proto/sandboxes",
    proto = ":sandboxes_proto",
)
