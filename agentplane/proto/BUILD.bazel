load("@aspect_rules_ts//ts:proto.bzl", "ts_proto_library")
load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("//devinfra/python:grpc.bzl", "py_grpc_service_library")
load("//devinfra/python:proto.bzl", "py_proto_library_with_mypy_stubs")

package(default_visibility = ["//agentplane:__subpackages__"])

proto_library(
    name = "runner_ingress_proto",
    srcs = ["runner_ingress.proto"],
    deps = [
        ":event_log_proto",
        ":runner_proto",
    ],
)

py_proto_library_with_mypy_stubs(
    name = "runner_ingress_pb2",
    deps = [":runner_ingress_proto"],
)

py_grpc_service_library(
    name = "runner_ingress_pb2_grpc",
    proto = ":runner_ingress_proto",
    py_proto = ":runner_ingress_pb2",
)

proto_library(
    name = "runner_channel_proto",
    srcs = ["runner_channel.proto"],
    deps = [
        ":command_proto",
        ":event_log_proto",
        ":runner_proto",
    ],
)

py_proto_library_with_mypy_stubs(
    name = "runner_channel_pb2",
    deps = [":runner_channel_proto"],
)

py_grpc_service_library(
    name = "runner_channel_pb2_grpc",
    proto = ":runner_channel_proto",
    py_proto = ":runner_channel_pb2",
)

proto_library(
    name = "command_proto",
    srcs = ["command.proto"],
    visibility = ["//visibility:public"],
)

py_proto_library_with_mypy_stubs(
    name = "command_pb2",
    visibility = ["//visibility:public"],
    deps = [":command_proto"],
)

ts_proto_library(
    name = "command_pb",
    copy_files = False,
    node_modules = "//:node_modules",
    proto = ":command_proto",
    visibility = ["//visibility:public"],
)

proto_library(
    name = "event_proto",
    srcs = ["event.proto"],
    visibility = ["//visibility:public"],
    deps = [
        ":command_proto",
        "@protobuf//:timestamp_proto",
    ],
)

py_proto_library_with_mypy_stubs(
    name = "event_pb2",
    visibility = ["//visibility:public"],
    deps = [":event_proto"],
)

ts_proto_library(
    name = "event_pb",
    copy_files = False,
    node_modules = "//:node_modules",
    proto = ":event_proto",
    visibility = ["//visibility:public"],
    deps = [":command_pb"],
)

proto_library(
    name = "event_log_proto",
    srcs = ["event_log.proto"],
    visibility = ["//visibility:public"],
    deps = [":event_proto"],
)

py_proto_library_with_mypy_stubs(
    name = "event_log_pb2",
    visibility = ["//visibility:public"],
    deps = [":event_log_proto"],
)

ts_proto_library(
    name = "event_log_pb",
    copy_files = False,
    node_modules = "//:node_modules",
    proto = ":event_log_proto",
    visibility = ["//visibility:public"],
    deps = [":event_pb"],
)

proto_library(
    name = "runner_proto",
    srcs = ["runner.proto"],
    visibility = ["//visibility:public"],
    deps = [
        ":command_proto",
        ":event_log_proto",
    ],
)

py_proto_library_with_mypy_stubs(
    name = "runner_pb2",
    visibility = ["//visibility:public"],
    deps = [":runner_proto"],
)

py_grpc_service_library(
    name = "runner_pb2_grpc",
    proto = ":runner_proto",
    py_proto = ":runner_pb2",
    visibility = [
        "//agentplane/runner:__subpackages__",
        "//agentplane/sandbox_service:__subpackages__",
    ],
)

ts_proto_library(
    name = "runner_pb",
    copy_files = False,
    node_modules = "//:node_modules",
    proto = ":runner_proto",
    visibility = ["//visibility:public"],
    deps = [
        ":command_pb",
        ":event_log_pb",
    ],
)
