load("@io_bazel_rules_go//go:def.bzl", "go_binary")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

package(default_visibility = ["//agentplane:__subpackages__"])

go_binary(
    name = "healthprobe",
    srcs = ["main.go"],
    importpath = "github.com/agentydragon/ducktape/agentplane/grpc/healthprobe",
    pure = "on",
    deps = [
        "//agentplane/environment_runtime_transport",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//health/grpc_health_v1",
    ],
)

pkg_tar(
    name = "binary_layer",
    srcs = [":healthprobe"],
    mode = "0755",
    package_dir = "/",
)
