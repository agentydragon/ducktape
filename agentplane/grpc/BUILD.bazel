load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//agentplane:__subpackages__"])

py_library(
    name = "options",
    srcs = ["options.py"],
    visibility = [
        "//agentplane:__subpackages__",
        "//cluster/cdk8s/agentplane:__pkg__",
    ],
)

py_library(
    name = "calls",
    srcs = ["calls.py"],
    deps = [
        ":options",
        "@pypi//grpcio",
        "@pypi//protobuf",
    ],
)

py_library(
    name = "serving",
    srcs = ["serving.py"],
    deps = [
        "@pypi//grpcio",
        "@pypi//grpcio_health_checking",
        "@pypi//protobuf",
    ],
)

py_test(
    name = "test_calls",
    srcs = ["test_calls.py"],
    deps = [
        ":calls",
        ":serving",
        "//:conftest",
        "//agentplane/testing:tls",
        "@pypi//grpcio",
        "@pypi//grpcio_health_checking",
        "@pypi//protobuf",  # keep: mypy follows generated protobuf interfaces
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//types_protobuf",  # keep: mypy follows generated protobuf interfaces
    ],
)
