load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")
load("//devinfra/python:defs.bzl", "py_library")

package(default_visibility = ["//agentplane/action_service:__subpackages__"])

py_library(
    name = "binding",
    srcs = ["binding.py"],
    visibility = [
        "//agentplane:__subpackages__",
        "//cluster/cdk8s/agentplane:__pkg__",
    ],
    deps = ["@pypi//pydantic"],
)

go_library(
    name = "session_delegation",
    srcs = ["executor.go"],
    importpath = "github.com/agentydragon/ducktape/agentplane/action_service/session_delegation",
    deps = [
        "//agentplane/action_service/session_delegation/contract:contract",
        "//agentplane/action_service/catalog",
        "//agentplane/action_service/store",
        "//agentplane/action_service/worker",
        "//agentplane/history_service:history_service_go_proto",
        "//agentplane/proto:delegation_go_proto",
        "//agentplane/proto:sandboxes_go_proto",
        "//agentplane/proto:session_go_proto",
        "//agentplane/runner_gateway/dispatcher:session_dispatcher_go_proto",
        "//agentplane/sandboxes/discovery:environment_discovery_go_proto",
        "//agentplane/session_client",
        "//agentplane/workload_auth/grpc",
        "@com_github_google_uuid//:uuid",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
    ],
)

go_test(
    name = "session_delegation_test",
    srcs = ["executor_test.go"],
    embed = [":session_delegation"],
    deps = [
        "//agentplane/action_service/catalog",
        "//agentplane/action_service/store",
        "//agentplane/action_service/worker",
        "//agentplane/history_service:history_service_go_proto",
        "//agentplane/proto:delegation_go_proto",
        "//agentplane/proto:event_log_go_proto",
        "//agentplane/proto:sandboxes_go_proto",
        "//agentplane/runner_gateway/dispatcher:session_dispatcher_go_proto",
        "//agentplane/sandboxes/discovery:environment_discovery_go_proto",
        "//agentplane/workload_auth/auth",
        "//agentplane/workload_auth/grpc",
        "@com_github_google_uuid//:uuid",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//metadata",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//proto",
    ],
)
