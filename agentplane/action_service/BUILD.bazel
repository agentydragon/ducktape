load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("@rules_oci//oci:defs.bzl", "oci_image")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//agentplane:__subpackages__"])

py_library(
    name = "models",
    srcs = ["models.py"],
)

py_library(
    name = "catalog",
    srcs = ["catalog.py"],
    visibility = [
        "//agentplane:__subpackages__",
        "//cluster/cdk8s:__subpackages__",
    ],
    deps = [
        "//agentplane/action_service/orchestration_v1:binding",
        "//agentplane/action_service/sandbox:binding",
        "//agentplane/action_service/session_delegation:binding",
        "@pypi//mcp",
        "@pypi//mcp_types",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    deps = ["//util/testing:postgres_fixtures"],
)

py_test(
    name = "test_catalog",
    srcs = ["test_catalog.py"],
    data = ["testdata/configured_action_groups.yaml"],
    deps = [
        ":catalog",
        ":conftest",
        "//:conftest",
        "//agentplane/action_service/session_delegation:binding",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//pyyaml",
        "@rules_python//python/runfiles",
    ],
)

py_library(
    name = "mcp_settings",
    srcs = ["mcp_settings.py"],
    visibility = [
        "//agentplane:__subpackages__",
        "//cluster/cdk8s:__subpackages__",
    ],
    deps = [
        ":catalog",
        "//util:urls",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "operator_oidc_settings",
    srcs = ["operator_oidc_settings.py"],
    visibility = [
        "//agentplane:__subpackages__",
        "//cluster/cdk8s:__subpackages__",
    ],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "push_settings",
    srcs = ["push_settings.py"],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "settings",
    srcs = ["settings.py"],
    visibility = [
        "//agentplane:__subpackages__",
        "//cluster/cdk8s:__subpackages__",
    ],
    deps = [
        ":catalog",
        ":mcp_settings",
        ":operator_oidc_settings",
        ":push_settings",
        "//agentplane:subjects",
        "//agentplane/action_service/orchestration_v1:binding",
        "//agentplane/action_service/session_delegation:binding",
        "//agentplane/environment_runtime_transport:config",
        "//agentplane/identity/auth:listener",
        "@pypi//pydantic",
    ],
)

py_test(
    name = "test_mcp_settings",
    srcs = ["test_mcp_settings.py"],
    deps = [
        ":conftest",
        ":mcp_settings",
        "//:conftest",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_settings",
    srcs = ["test_settings.py"],
    deps = [
        ":conftest",
        ":settings",
        "//:conftest",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

