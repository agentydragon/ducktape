load("@aspect_rules_ts//ts:proto.bzl", "ts_proto_library")
load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("@io_bazel_rules_go//proto:def.bzl", "go_proto_library")
load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_oci//oci:defs.bzl", "oci_image")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//devinfra/go:proto_openapi.bzl", "proto_openapi")
load("//devinfra/python:defs.bzl", "py_library", "py_test")
load("//devinfra/python:proto.bzl", "py_proto_library_with_mypy_stubs")

package(default_visibility = ["//agentplane:__subpackages__"])

py_library(
    name = "models",
    srcs = ["models.py"],
)

py_library(
    name = "catalog",
    srcs = ["catalog.py"],
    visibility = [
        "//agentplane:__subpackages__",
        "//cluster/cdk8s:__subpackages__",
    ],
    deps = [
        "//agentplane/action_service/orchestration_v1:binding",
        "//agentplane/action_service/sandbox:binding",
        "@pypi//mcp",
        "@pypi//mcp_types",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    deps = ["//util/testing:postgres_fixtures"],
)

py_test(
    name = "test_catalog",
    srcs = ["test_catalog.py"],
    data = ["testdata/configured_action_groups.yaml"],
    deps = [
        ":catalog",
        ":conftest",
        "//:conftest",
        "//util/bazel:runfiles",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//pyyaml",
    ],
)

py_library(
    name = "operator_oidc",
    srcs = ["operator_oidc.py"],
    deps = [
        ":operator_oidc_settings",
        "//util:oidc_principal",
    ],
)

py_library(
    name = "policy_view",
    srcs = ["policy_view.py"],
    deps = [
        ":models",
        "//agentplane:policy_sets",
        "//agentplane/action_service/policies:registry",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "mcp_settings",
    srcs = ["mcp_settings.py"],
    visibility = [
        "//agentplane:__subpackages__",
        "//cluster/cdk8s:__subpackages__",
    ],
    deps = [
        ":catalog",
        "//util:urls",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "operator_oidc_settings",
    srcs = ["operator_oidc_settings.py"],
    visibility = [
        "//agentplane:__subpackages__",
        "//cluster/cdk8s:__subpackages__",
    ],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "push_settings",
    srcs = ["push_settings.py"],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "settings",
    srcs = ["settings.py"],
    visibility = [
        "//agentplane:__subpackages__",
        "//cluster/cdk8s:__subpackages__",
    ],
    deps = [
        ":catalog",
        ":mcp_settings",
        ":operator_oidc_settings",
        ":push_settings",
        "//agentplane:log_levels",
        "//agentplane:subjects",
        "//agentplane/action_service/orchestration_v1:binding",
        "//util:yaml_file_settings",
        "@pypi//pydantic",
        "@pypi//pydantic_settings",
    ],
)

py_test(
    name = "test_mcp_settings",
    srcs = ["test_mcp_settings.py"],
    deps = [
        ":conftest",
        ":mcp_settings",
        "//:conftest",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

proto_library(
    name = "action_service_proto",
    srcs = ["action_service.proto"],
    deps = [
        "//agentplane/proto:sandboxes_proto",
        "@googleapis//google/api:annotations_proto",
        "@protobuf//:empty_proto",
        "@protobuf//:struct_proto",
        "@protobuf//:timestamp_proto",
    ],
)

py_proto_library_with_mypy_stubs(
    name = "action_service_pb2",
    deps = [":action_service_proto"],
)

go_proto_library(
    name = "action_service_go_proto",
    compilers = [
        "@io_bazel_rules_go//proto:go_proto",
        "@io_bazel_rules_go//proto:go_grpc_v2",
        "//devinfra/go:grpc_gateway",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/action_service/action_servicepb",
    proto = ":action_service_proto",
    deps = [
        "//agentplane/proto:sandboxes_go_proto",
        "@org_golang_google_genproto_googleapis_api//annotations",
    ],
)

ts_proto_library(
    name = "action_service_pb",
    copy_files = False,
    node_modules = "//:node_modules",
    proto = ":action_service_proto",
    deps = [
        "//agentplane/proto:sandboxes_pb",
        "//google/api:annotations_pb",
    ],
)

# The agent-facing reference. Operator-only RPCs are a second proto so that this document describes only what an
# agent may call.
proto_openapi(
    name = "action_service_openapi",
    proto = ":action_service_proto",
)

proto_library(
    name = "operator_action_service_proto",
    srcs = ["operator_action_service.proto"],
    deps = [
        ":action_service_proto",
        "@googleapis//google/api:annotations_proto",
        "@protobuf//:empty_proto",
        "@protobuf//:timestamp_proto",
    ],
)

py_proto_library_with_mypy_stubs(
    name = "operator_action_service_pb2",
    deps = [":operator_action_service_proto"],
)

go_proto_library(
    name = "operator_action_service_go_proto",
    compilers = [
        "@io_bazel_rules_go//proto:go_proto",
        "@io_bazel_rules_go//proto:go_grpc_v2",
        "//devinfra/go:grpc_gateway",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/action_service/operator_action_servicepb",
    proto = ":operator_action_service_proto",
    deps = [
        ":action_service_go_proto",
        "@org_golang_google_genproto_googleapis_api//annotations",
    ],
)

ts_proto_library(
    name = "operator_action_service_pb",
    copy_files = False,
    node_modules = "//:node_modules",
    proto = ":operator_action_service_proto",
    deps = [
        ":action_service_pb",
        "//google/api:annotations_pb",
    ],
)

proto_library(
    name = "web_push_service_proto",
    srcs = ["web_push_service.proto"],
    deps = [
        "@googleapis//google/api:annotations_proto",
        "@protobuf//:empty_proto",
        "@protobuf//:timestamp_proto",
    ],
)

go_proto_library(
    name = "web_push_service_go_proto",
    compilers = [
        "@io_bazel_rules_go//proto:go_proto",
        "@io_bazel_rules_go//proto:go_grpc_v2",
        "//devinfra/go:grpc_gateway",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/action_service/web_push_servicepb",
    proto = ":web_push_service_proto",
    deps = ["@org_golang_google_genproto_googleapis_api//annotations"],
)

go_library(
    name = "main_lib",
    srcs = [
        "config.go",
        "docs.go",
        "main.go",
    ],
    embedsrcs = glob(["docs/agents/**"]) + [":action_service_openapi"],
    importpath = "github.com/agentydragon/ducktape/agentplane/action_service",
    deps = [
        ":action_service_go_proto",
        ":operator_action_service_go_proto",
        ":web_push_service_go_proto",
        "//agentplane/action_service/api",
        "//agentplane/action_service/catalog",
        "//agentplane/action_service/informer",
        "//agentplane/action_service/linkage",
        "//agentplane/action_service/mcpexec",
        "//agentplane/action_service/orchestration_v1",
        "//agentplane/action_service/policies",
        "//agentplane/action_service/push",
        "//agentplane/action_service/sandbox",
        "//agentplane/action_service/store",
        "//agentplane/action_service/worker",
        "//agentplane/grpc/bearer",
        "//agentplane/grpc/facade",
        "//agentplane/history_service:history_service_go_proto",
        "//agentplane/observability",
        "//agentplane/policy/api/v1alpha1",
        "//agentplane/policy/reader",
        "//agentplane/postgres/go/probes",
        "//agentplane/postgres/go/wakeups",
        "//agentplane/runner_gateway/dispatcher:session_dispatcher_go_proto",
        "//agentplane/sandboxes/api",
        "//agentplane/workload_auth/go/auth",
        "@com_github_go_viper_mapstructure_v2//:mapstructure",
        "@com_github_lib_pq//:pq",
        "@com_github_prometheus_client_golang//prometheus/promhttp",
        "@com_github_spf13_viper//:viper",
        "@in_gopkg_yaml_v3//:yaml_v3",
        "@io_k8s_apimachinery//pkg/runtime",
        "@io_k8s_client_go//kubernetes",
        "@io_k8s_client_go//rest",
        "@io_k8s_sigs_controller_runtime//pkg/client",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//health/grpc_health_v1",
        "@org_golang_google_grpc//status",
    ],
)

go_binary(
    name = "actions",
    embed = [":main_lib"],
    pure = "on",
)

pkg_tar(
    name = "service_binary_layer",
    srcs = [":actions"],
    package_dir = "/usr/local/bin",
)

oci_image(
    name = "service_image",
    base = "@distroless_static_debian13_linux_amd64",
    entrypoint = ["/usr/local/bin/actions"],
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [":service_binary_layer"],
    user = "1000:1000",
    visibility = ["//visibility:public"],
    workdir = "/",
)

