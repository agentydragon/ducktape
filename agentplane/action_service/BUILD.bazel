py_image_layer(
    name = "server_layers",
    binary = ":server_image_bin",
    group = "1000",
    owner = "1000",
)

oci_image(
    name = "image",
    base = "@debian_trixie_slim_linux_amd64",
    entrypoint = py_image_entrypoint("server_image_bin"),
    # CA bundle (//third_party/debian_slim:cacerts): the OAuth/MCP-execution paths (oauth.py,
    # mcp_executor.py, mcp_linkage.py) resolve to httpx2 via FastMCP 4's OIDCProxy. httpx2
    # verifies TLS through truststore (OS-native trust store), not bundled certifi roots, so
    # it needs the same system CA bundle a C git/curl client would. See
    # docs/distroless_ca_certificates.md.
    env = py_image_env(
        binary_name = "server_image_bin",
        extra_env = {"SSL_CERT_FILE": "/etc/ssl/certs/ca-certificates.crt"},
    ),
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [
        ":server_layers",
        "//third_party/debian_slim:cacerts",
    ],
    user = "1000:1000",
    visibility = ["//visibility:public"],
)

aspect_py_binary(
    name = "migration_image_bin",
    main = "database_migrate.py",
    deps = [":database_migrate"],
)

py_image_layer(
    name = "migration_layers",
