    name = "main_lib",
    srcs = [
        "config.go",
        "main.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/action_service",
    deps = [
        "//agentplane/action_service/api",
        "//agentplane/action_service/api/contracts:action_service_go_proto",
        "//agentplane/action_service/api/contracts:linkage_service_go_proto",
        "//agentplane/action_service/api/contracts:operator_action_service_go_proto",
        "//agentplane/action_service/api/web_push:web_push_service_go_proto",
        "//agentplane/action_service/internal/admission/catalog",
        "//agentplane/action_service/internal/admission/informer",
        "//agentplane/action_service/internal/admission/policies",
        "//agentplane/action_service/internal/linkage",
        "//agentplane/action_service/internal/mcpexec",
        "//agentplane/action_service/internal/push",
        "//agentplane/action_service/internal/store",
        "//agentplane/action_service/internal/worker",
        "//agentplane/action_service/migrations",
        "//agentplane/action_service/orchestration_v1",
        "//agentplane/action_service/sandbox",
        "//agentplane/action_service/session_delegation",
        "//agentplane/environment_runtime_transport",
        "//agentplane/environments/v1:environment_service_go_proto",
        "//agentplane/grpc/bearer",
        "//agentplane/grpc/graceful",
        "//agentplane/history_service/api/history:history_service_go_proto",
        "//agentplane/identity/auth/auth",
        "//agentplane/identity/auth/grpc",
        "//agentplane/identity/auth/listener",
        "//agentplane/identity/credentials/api/v1alpha1",
        "//agentplane/identity/credentials/requester",
        "//agentplane/identity/credentials/resolver",
        "//agentplane/kubeclient",
        "//agentplane/observability",
        "//agentplane/policy/api/v1alpha1",
        "//agentplane/postgres",
        "//agentplane/postgres/migrate",
        "//agentplane/postgres/probes",
        "//agentplane/postgres/wakeups",
        "//agentplane/runner_gateway/dispatcher/api/session:session_dispatcher_go_proto",
        "//agentplane/sandboxes/api",
        "//agentplane/watchhealth",
        "@com_github_go_viper_mapstructure_v2//:mapstructure",
        "@com_github_lib_pq//:pq",
        "@com_github_spf13_viper//:viper",
        "@in_gopkg_yaml_v3//:yaml_v3",
        "@io_k8s_apimachinery//pkg/runtime",
        "@io_k8s_client_go//kubernetes",
        "@io_k8s_client_go//rest",
        "@io_k8s_sigs_controller_runtime//pkg/client",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//health/grpc_health_v1",
        "@org_golang_google_grpc//status",
    ],
)

go_binary(
    name = "actions",
    embed = [":main_lib"],
    pure = "on",
)

pkg_tar(
    name = "service_binary_layer",
    srcs = [":actions"],
    package_dir = "/usr/local/bin",
)

oci_image(
    name = "service_image",
    base = "@distroless_static_debian13_linux_amd64",
    entrypoint = ["/usr/local/bin/actions"],
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [
        ":service_binary_layer",
        "//agentplane/grpc/healthprobe:binary_layer",
    ],
    user = "1000:1000",
    visibility = ["//visibility:public"],
    workdir = "/",
)

