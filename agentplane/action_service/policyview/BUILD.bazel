load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")
load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//agentplane:__subpackages__"])

py_binary(
    name = "generate_golden_bin",
    main_module = "agentplane.action_service.policyview.generate_golden",
    deps = [":generate_golden"],
)

go_library(
    name = "policyview",
    srcs = ["view.go"],
    importpath = "github.com/agentydragon/ducktape/agentplane/action_service/policyview",
    deps = [
        "//agentplane/action_service:action_service_go_proto",
        "//agentplane/action_service/informer",
        "//agentplane/action_service/policies",
        "//agentplane/action_service/store",
        "//agentplane/policy/api/v1alpha1",
        "//agentplane/policy/reader",
        "//agentplane/proto:sandboxes_go_proto",
        "@io_k8s_apimachinery//pkg/api/meta",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_apimachinery//pkg/util/sets",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

go_test(
    name = "policyview_test",
    srcs = ["golden_test.go"],
    embed = [":policyview"],
    embedsrcs = ["golden.json"],
    deps = [
        "//agentplane/action_service:action_service_go_proto",
        "//agentplane/action_service/informer",
        "//agentplane/policy/api/v1alpha1",
        "//agentplane/policy/reader",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
    ],
)

py_library(
    name = "generate_golden",
    srcs = ["generate_golden.py"],
    deps = [
        "//agentplane:kubernetes_watch",
        "//agentplane:policy_sets",
        "//agentplane:subjects",
        "//agentplane/action_service:models",
        "//agentplane/action_service:policy_evaluation",
        "//agentplane/action_service:policy_informer",
        "//agentplane/action_service:policy_view",
        "//agentplane/action_service/policies:registry",
        "//agentplane/action_service/policies:resources",
        "@pypi//pydantic",
    ],
)

py_test(
    name = "test_golden",
    srcs = ["test_golden.py"],
    data = ["golden.json"],
    deps = [
        ":generate_golden",
        "//:conftest",
        "//agentplane/action_service:conftest",
        "//util/bazel:runfiles",
        "@pypi//pytest_bazel",
    ],
)
