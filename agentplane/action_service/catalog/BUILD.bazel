load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//agentplane/action_service:__subpackages__"])

go_library(
    name = "catalog",
    srcs = [
        "arguments.go",
        "catalog.go",
        "input.go",
        "integer.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/action_service/catalog",
    deps = [
        "//agentplane/action_service:action_service_go_proto",
        "@com_github_invopop_jsonschema//:jsonschema",
        "@com_github_santhosh_tekuri_jsonschema_v6//:jsonschema",
        "@in_gopkg_yaml_v3//:yaml_v3",
    ],
)

go_test(
    name = "catalog_test",
    srcs = [
        "catalog_test.go",
        "golden_test.go",
        "input_test.go",
        "integer_test.go",
    ],
    embed = [":catalog"],
    embedsrcs = ["golden.json"],
    deps = [
        "@com_github_santhosh_tekuri_jsonschema_v6//:jsonschema",
        "@in_gopkg_yaml_v3//:yaml_v3",
    ],
)

exports_files(
    ["golden.json"],
    visibility = [
        "//agentplane/action_service:__pkg__",
        "//agentplane/action_service/api:__pkg__",
    ],
)
