load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//agentplane/action_service:__subpackages__"])

go_library(
    name = "policies",
    srcs = [
        "argument_schema.go",
        "github.go",
        "home_assistant.go",
        "policy.go",
        "provider.go",
        "visibility.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/action_service/internal/admission/policies",
    deps = [
        "//agentplane/action_service/api/contracts:action_service_go_proto",
        "//agentplane/action_service/internal/admission/catalog",
        "//agentplane/action_service/internal/store",
        "//agentplane/observability",
        "//agentplane/policy/api/v1alpha1",
        "//agentplane/policy/reader",
        "@com_github_santhosh_tekuri_jsonschema_v6//:jsonschema",
        "@io_k8s_apimachinery//pkg/util/cache",
        "@io_k8s_apimachinery//pkg/util/sets",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//types/known/structpb",
        "@org_golang_x_sync//singleflight",
        "@org_golang_x_text//cases",
    ],
)

go_test(
    name = "policies_test",
    srcs = [
        "golden_test.go",
        "visibility_test.go",
    ],
    embed = [":policies"],
    embedsrcs = ["golden.json"],
    deps = [
        "//agentplane/action_service/internal/store",
        "//agentplane/policy/api/v1alpha1",
        "//agentplane/policy/reader",
        "@com_github_santhosh_tekuri_jsonschema_v6//:jsonschema",
        "@io_k8s_apimachinery//pkg/util/sets",
    ],
)
