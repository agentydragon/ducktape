load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//agentplane/action_service:__subpackages__"])

go_library(
    name = "grpcgate",
    srcs = [
        "attribution.go",
        "gate.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/action_service/internal/admission/grpcgate",
    deps = [
        "//agentplane/action_service/api/contracts:action_service_go_proto",
        "//agentplane/action_service/api/contracts:linkage_service_go_proto",
        "//agentplane/action_service/api/contracts:operator_action_service_go_proto",
        "//agentplane/action_service/api/web_push:web_push_service_go_proto",
        "//agentplane/action_service/internal/store",
        "//agentplane/identity/auth",
        "//agentplane/identity/operator",
        "//agentplane/net/peertls",
        "//agentplane/proto:delegation_go_proto",
        "@com_github_google_uuid//:uuid",
        "@io_k8s_apimachinery//pkg/util/sets",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//health/grpc_health_v1",
        "@org_golang_google_grpc//metadata",
        "@org_golang_google_grpc//status",
    ],
)

go_test(
    name = "unit_test",
    srcs = [
        "attribution_test.go",
        "boundary_test.go",
        "gate_policy_test.go",
    ],
    embed = [":grpcgate"],
    deps = [
        "//agentplane/action_service/api/contracts:action_service_go_proto",
        "//agentplane/action_service/api/contracts:linkage_service_go_proto",
        "//agentplane/action_service/api/contracts:operator_action_service_go_proto",
        "//agentplane/action_service/api/web_push:web_push_service_go_proto",
        "//agentplane/action_service/internal/store",
        "//agentplane/identity/auth",
        "//agentplane/identity/operator",
        "//agentplane/identity/operator/testissuer",
        "//agentplane/net/peertls",
        "//agentplane/proto:delegation_go_proto",
        "//agentplane/proto:identity_go_proto",
        "//agentplane/testing/grpcmethods",
        "//agentplane/testing/grpcserver",
        "@com_github_google_uuid//:uuid",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//credentials/insecure",
        "@org_golang_google_grpc//health/grpc_health_v1",
        "@org_golang_google_grpc//interop/grpc_testing",
        "@org_golang_google_grpc//metadata",
        "@org_golang_google_grpc//status",
    ],
)
