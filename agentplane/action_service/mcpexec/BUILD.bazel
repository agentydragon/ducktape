load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//agentplane/action_service:__subpackages__"])

go_library(
    name = "mcpexec",
    srcs = [
        "config.go",
        "executor.go",
        "linkage.go",
        "tools.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/action_service/mcpexec",
    deps = [
        "//agentplane/action_service:action_service_go_proto",
        "//agentplane/action_service/catalog",
        "//agentplane/action_service/linkage",
        "//agentplane/action_service/store",
        "//agentplane/action_service/worker",
        "//agentplane/observability",
        "@com_github_modelcontextprotocol_go_sdk//mcp",
        "@com_github_santhosh_tekuri_jsonschema_v6//:jsonschema",
        "@com_github_sethvargo_go_retry//:go-retry",
        "@org_golang_google_protobuf//types/known/timestamppb",
        "@org_golang_x_oauth2//:oauth2",
    ],
)

go_test(
    name = "mcpexec_test",
    srcs = [
        "golden_test.go",
        "tools_test.go",
    ],
    embed = [":mcpexec"],
    embedsrcs = ["golden.json"],
    deps = [
        "@com_github_modelcontextprotocol_go_sdk//mcp",
        "@com_github_santhosh_tekuri_jsonschema_v6//:jsonschema",
    ],
)

go_test(
    name = "integration_test",
    size = "medium",
    srcs = [
        "execution_integration_test.go",
        "integration_testmain_test.go",
        "supervision_integration_test.go",
        "upstream_test.go",
    ],
    embed = [":mcpexec"],
    tags = ["requires_docker"],
    deps = [
        "//agentplane/action_service:action_service_go_proto",
        "//agentplane/action_service/catalog",
        "//agentplane/action_service/linkage",
        "//agentplane/action_service/migrations",
        "//agentplane/action_service/store",
        "//agentplane/action_service/worker",
        "//agentplane/postgres/go/wakeups",
        "//agentplane/testing/postgres",
        "@com_github_google_uuid//:uuid",
        "@com_github_lib_pq//:pq",
        "@com_github_modelcontextprotocol_go_sdk//mcp",
        "@in_gopkg_yaml_v3//:yaml_v3",
    ],
)
