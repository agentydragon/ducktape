load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "actionresult",
    srcs = ["results.go"],
    importpath = "github.com/agentydragon/ducktape/agentplane/action_service/actionresult",
    visibility = ["//agentplane:__subpackages__"],
    deps = [
        "//agentplane/action_service/api/contracts:action_service_go_proto",
        "@com_github_google_uuid//:uuid",
        "@com_github_modelcontextprotocol_go_sdk//mcp",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//types/known/structpb",
    ],
)

go_test(
    name = "actionresult_test",
    srcs = ["results_test.go"],
    embed = [":actionresult"],
    deps = [
        "//agentplane/action_service/api/contracts:action_service_go_proto",
        "@com_github_modelcontextprotocol_go_sdk//mcp",
        "@org_golang_google_protobuf//types/known/structpb",
    ],
)
