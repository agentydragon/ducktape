load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")
load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//agentplane:__subpackages__"])

py_library(
    name = "binding",
    srcs = ["binding.py"],
    # The generator writes the binding staging offers.
    visibility = [
        "//agentplane:__subpackages__",
        "//cluster/cdk8s/agentplane:__pkg__",
    ],
    deps = [
        "//agentplane:crd_group",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "models",
    srcs = ["models.py"],
    deps = [
        "//util/exec:models",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "actions",
    srcs = ["actions.py"],
    # The group key and its Action names, so the staging policy that auto-approves them is written
    # from the roster that offers them rather than from a second copy.
    visibility = [
        "//agentplane:__subpackages__",
        "//cluster/cdk8s/agentplane:__pkg__",
    ],
    deps = [
        ":binding",
        ":models",
        "//agentplane/action_service:catalog",
        "@pypi//mcp",
        "@pypi//mcp_types",
        "@pypi//pydantic",
    ],
)

py_test(
    name = "test_actions",
    srcs = ["test_actions.py"],
    deps = [
        ":actions",
        ":binding",
        "//:conftest",
        "//agentplane/action_service:conftest",
        "@pypi//jsonschema",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//referencing",
    ],
)

go_library(
    name = "sandbox",
    srcs = [
        "actions.go",
        "exec.go",
        "executor.go",
        "inventory.go",
    ],
    embedsrcs = ["input_schemas.json"],
    importpath = "github.com/agentydragon/ducktape/agentplane/action_service/sandbox",
    visibility = ["//agentplane/action_service:__subpackages__"],
    deps = [
        "//agentplane/action_service/catalog",
        "//agentplane/action_service/store",
        "//agentplane/action_service/worker",
        "@com_github_santhosh_tekuri_jsonschema_v6//:jsonschema",
        "@io_k8s_api//core/v1:core",
        "@io_k8s_apimachinery//pkg/api/errors",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_apimachinery//pkg/labels",
        "@io_k8s_apimachinery//pkg/types",
        "@io_k8s_client_go//kubernetes",
        "@io_k8s_client_go//kubernetes/scheme",
        "@io_k8s_client_go//rest",
        "@io_k8s_client_go//tools/remotecommand",
        "@io_k8s_client_go//util/exec",
    ],
)

go_test(
    name = "sandbox_test",
    srcs = [
        "exec_test.go",
        "executor_test.go",
        "fixture_test.go",
        "golden_test.go",
        "inventory_test.go",
    ],
    embed = [":sandbox"],
    embedsrcs = ["golden.json"],
    deps = [
        "//agentplane/action_service/catalog",
        "//agentplane/action_service/store",
        "//agentplane/testing/kubeapiserver",
        "//agentplane/workload_auth/go/auth",
        "@com_github_google_uuid//:uuid",
        "@io_k8s_api//core/v1:core",
        "@io_k8s_apimachinery//pkg/api/errors",
        "@io_k8s_apimachinery//pkg/api/resource",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_apimachinery//pkg/types",
        "@io_k8s_client_go//util/exec",
    ],
)
