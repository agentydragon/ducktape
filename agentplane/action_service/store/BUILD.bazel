load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//agentplane/action_service:__subpackages__"])

go_library(
    name = "store",
    srcs = [
        "approvals.go",
        "cancel.go",
        "decisions.go",
        "executions.go",
        "models.go",
        "protobuf.go",
        "requests.go",
        "storage_values.go",
        "store.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/action_service/store",
    deps = [
        "//agentplane/action_service:action_service_go_proto",
        "//agentplane/postgres/go:postgres",
        "//agentplane/proto:sandboxes_go_proto",
        "@com_github_google_uuid//:uuid",
        "@com_github_lib_pq//:pq",
        "@org_golang_google_protobuf//proto",
    ],
)

go_test(
    name = "golden_test",
    srcs = [
        "golden_test.go",
        "golden_vectors_test.go",
        "storage_values_test.go",
    ],
    embed = [":store"],
    embedsrcs = ["golden.json"],
    deps = [
        "//agentplane/action_service:action_service_go_proto",
        "//agentplane/proto:sandboxes_go_proto",
        "@com_github_google_uuid//:uuid",
        "@org_golang_google_protobuf//proto",
    ],
)

go_test(
    name = "store_integration_test",
    size = "medium",
    srcs = [
        "cancel_integration_test.go",
        "claims_integration_test.go",
        "decisions_integration_test.go",
        "golden_vectors_test.go",
        "integration_testmain_test.go",
        "leases_integration_test.go",
        "python_rows_integration_test.go",
        "reads_integration_test.go",
        "submit_integration_test.go",
        "wakeups_integration_test.go",
    ],
    embed = [":store"],
    embedsrcs = ["golden.json"],
    tags = ["requires_docker"],
    deps = [
        "//agentplane/action_service:action_service_go_proto",
        "//agentplane/action_service/migrations",
        "//agentplane/postgres/go/wakeups",
        "//agentplane/testing/postgres",
        "@com_github_google_uuid//:uuid",
        "@com_github_lib_pq//:pq",
        "@org_golang_google_protobuf//proto",
    ],
)
