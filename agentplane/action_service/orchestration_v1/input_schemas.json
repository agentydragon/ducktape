        "type": "string"
      },
      "spec": {
        "additionalProperties": false,
        "description": "What the Session runs: its harness, model and working directory, fixed when it opens.",
        "properties": {
          "cwd": {
            "description": "The working directory; `{session_id}` in it becomes the Session's ID.",
            "minLength": 1,
            "type": "string"
          },
          "harness": {
            "enum": ["HARNESS_CLAUDE", "HARNESS_CODEX"],
            "type": "string"
          },
          "instructions": {
            "description": "Standing instructions, fixed for the Session's life.",
            "type": "string"
          },
          "model": {
            "minLength": 1,
            "type": "string"
          },
          "reasoning_effort": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": ["harness", "model", "cwd"],
        "type": "object"
      }
    },
    "required": ["sandbox", "session_id", "spec"],
    "title": "OpenSessionArgs",
    "type": "object"
  },
