  "LaunchArgs": {
    "additionalProperties": false,
    "properties": {
      "bootstrap": {
        "description": "Shell source its runner runs once, before its first Session.",
        "maxLength": 65536,
        "type": "string"
      },
      "idle_suspend_after_seconds": {
        "description": "How long its runner stays idle before it is suspended. Absent, it never is.",
        "maximum": 31536000,
        "minimum": 60,
        "type": "integer"
      },
      "inbox_tags": {
        "description": "Groups its Session inboxes take messages as.",
        "items": {
          "maxLength": 63,
          "minLength": 1,
          "type": "string"
        },
        "type": "array",
        "uniqueItems": true
      },
      "launcher_grants": {
        "description": "What you may then do to this Sandbox without asking again, bound to your own account and deleted with the Sandbox: `send_message` to its Session inboxes, and each named Action of this group on it.",
        "items": {
          "enum": [
            "send_message",
            "open_session",
            "submit_input",
            "interrupt_turn",
            "change_model",
            "change_reasoning_effort",
            "get_session",
            "list_sessions"
          ],
          "type": "string"
        },
        "type": "array",
        "uniqueItems": true
      },
      "name": {
        "description": "The new Sandbox's name, a DNS label no Sandbox in the namespace has.",
        "maxLength": 57,
        "minLength": 1,
        "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
        "type": "string"
      },
      "policy_sets": {
        "description": "PolicySets its own account is bound to, beside this deployment's defaults.",
        "items": {
          "minLength": 1,
          "type": "string"
        },
        "type": "array",
        "uniqueItems": true
      },
      "template": {
        "description": "The SandboxTemplate it runs from.",
        "minLength": 1,
        "type": "string"
      },
      "wake_on_send": {
        "description": "Whether an inbox message or a submitted input resumes it once it is suspended.",
        "type": "boolean"
      }
    },
    "required": ["name", "template"],
    "title": "LaunchArgs",
    "type": "object"
  },
