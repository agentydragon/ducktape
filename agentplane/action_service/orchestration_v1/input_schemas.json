{
  "ChangeModelArgs": {
    "additionalProperties": false,
    "properties": {
      "command_id": {
        "description": "A fresh UUID you mint for this command. Repeating a call with the same ID and fields does not send it twice; the same ID with other fields is refused.",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "model": {
        "minLength": 1,
        "type": "string"
      },
      "sandbox": {
        "additionalProperties": false,
        "description": "The Sandbox as launch_sandbox returned it: its name and the UID of that incarnation. A Sandbox deleted and launched again under the name is another one, and is refused.",
        "properties": {
          "name": {
            "maxLength": 57,
            "minLength": 1,
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
            "type": "string"
          },
          "uid": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "type": "string"
          }
        },
        "required": ["name", "uid"],
        "type": "object"
      },
      "session_id": {
        "description": "The Session's ID, as open_session was given it.",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      }
    },
    "required": ["sandbox", "session_id", "command_id", "model"],
    "title": "ChangeModelArgs",
    "type": "object"
  },
