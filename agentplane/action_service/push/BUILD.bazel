load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//agentplane/action_service:__subpackages__"])

go_library(
    name = "push",
    srcs = [
        "identity.go",
        "notifier.go",
        "subscriptions.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/action_service/push",
    deps = [
        "//agentplane/action_service:action_service_go_proto",
        "//agentplane/action_service/store",
        "//agentplane/observability",
        "//agentplane/postgres/go:postgres",
        "@com_github_google_uuid//:uuid",
        "@com_github_lib_pq//:pq",
        "@com_github_sherclockholmes_webpush_go//:webpush-go",
    ],
)

go_test(
    name = "unit_test",
    srcs = ["identity_test.go"],
    embed = [":push"],
)

go_test(
    name = "integration_test",
    size = "medium",
    srcs = [
        "browser_test.go",
        "identity_test.go",
        "integration_testmain_test.go",
        "notifier_integration_test.go",
    ],
    embed = [":push"],
    tags = ["requires_docker"],
    deps = [
        "//agentplane/action_service/migrations",
        "//agentplane/action_service/store",
        "//agentplane/postgres/go/wakeups",
        "//agentplane/testing/postgres",
        "@com_github_go_jose_go_jose_v4//:go-jose",
        "@com_github_go_jose_go_jose_v4//jwt",
        "@com_github_google_uuid//:uuid",
        "@com_github_lib_pq//:pq",
    ],
)
