load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//devinfra/go:defs.bzl", "go_test")

package(default_visibility = ["//agentplane/action_service:__subpackages__"])

go_library(
    name = "linkage",
    srcs = [
        "discovery.go",
        "flow.go",
        "http.go",
        "linkage.go",
        "refresh.go",
        "settings.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/action_service/linkage",
    deps = [
        "//agentplane/action_service:operator_action_service_go_proto",
        "//agentplane/action_service/catalog",
        "//agentplane/action_service/store",
        "//agentplane/observability",
        "//agentplane/postgres/go:postgres",
        "@com_github_google_uuid//:uuid",
        "@com_github_lib_pq//:pq",
        "@com_github_modelcontextprotocol_go_sdk//oauthex",
        "@com_github_prometheus_client_golang//prometheus",
        "@com_github_prometheus_client_golang//prometheus/promauto",
        "@com_github_sethvargo_go_retry//:go-retry",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//types/known/timestamppb",
        "@org_golang_x_oauth2//:oauth2",
    ],
)

go_test(
    name = "unit_test",
    srcs = ["settings_test.go"],
    embed = [":linkage"],
)

go_test(
    name = "integration_test",
    size = "medium",
    srcs = [
        "discovery_integration_test.go",
        "flow_integration_test.go",
        "integration_testmain_test.go",
        "refresh_integration_test.go",
    ],
    embed = [":linkage"],
    tags = ["requires_docker"],
    deps = [
        "//agentplane/action_service:operator_action_service_go_proto",
        "//agentplane/action_service/migrations",
        "//agentplane/action_service/store",
        "//agentplane/action_service/testing/oauthprovider",
        "//agentplane/postgres/go/wakeups",
        "//agentplane/testing/postgres",
        "//util/testing/nettest",
        "@com_github_lib_pq//:pq",
        "@io_k8s_apimachinery//pkg/util/wait",
        "@org_golang_google_protobuf//encoding/protojson",
    ],
)
