load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//agentplane/action_service:__subpackages__"])

go_library(
    name = "api",
    srcs = [
        "errors.go",
        "gate.go",
        "operator_oidc.go",
        "service.go",
        "views.go",
        "watch.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/action_service/api",
    deps = [
        "//agentplane/action_service:action_service_go_proto",
        "//agentplane/action_service/store",
        "//agentplane/postgres/go/wakeups",
        "//agentplane/proto:sandboxes_go_proto",
        "//agentplane/workload_auth/go/auth",
        "@com_github_coreos_go_oidc_v3//oidc",
        "@com_github_go_jose_go_jose_v4//:go-jose",
        "@com_github_go_jose_go_jose_v4//jwt",
        "@com_github_google_uuid//:uuid",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//metadata",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//types/known/emptypb",
        "@org_golang_google_protobuf//types/known/structpb",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

go_test(
    name = "unit_test",
    srcs = [
        "issuer_test.go",
        "operator_oidc_test.go",
    ],
    embed = [":api"],
    deps = [
        "//agentplane/action_service/store",
        "@com_github_go_jose_go_jose_v4//:go-jose",
        "@com_github_go_jose_go_jose_v4//jwt",
    ],
)

go_test(
    name = "integration_test",
    size = "medium",
    srcs = [
        "fixture_test.go",
        "gate_test.go",
        "integration_testmain_test.go",
        "issuer_test.go",
        "service_test.go",
        "watch_test.go",
    ],
    embed = [":api"],
    tags = ["requires_docker"],
    deps = [
        "//agentplane/action_service:action_service_go_proto",
        "//agentplane/action_service/migrations",
        "//agentplane/action_service/store",
        "//agentplane/grpc/facade",
        "//agentplane/postgres/go/wakeups",
        "//agentplane/proto:sandboxes_go_proto",
        "//agentplane/testing/kubeapiserver",
        "//agentplane/testing/postgres",
        "//agentplane/workload_auth/go/auth",
        "@com_github_go_jose_go_jose_v4//:go-jose",
        "@com_github_go_jose_go_jose_v4//jwt",
        "@com_github_google_uuid//:uuid",
        "@com_github_lib_pq//:pq",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_apimachinery//pkg/types",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//credentials/insecure",
        "@org_golang_google_grpc//metadata",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/structpb",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)
