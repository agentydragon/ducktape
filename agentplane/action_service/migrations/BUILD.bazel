load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "migrations",
    srcs = ["migrations.go"],
    embedsrcs = glob(["actions/*.sql"]),
    importpath = "github.com/agentydragon/ducktape/agentplane/action_service/migrations",
    visibility = [
        "//agentplane/action_service:__subpackages__",
        "//agentplane/mcp_edge:__subpackages__",
    ],
    deps = [
        "@com_github_pressly_goose_v3//:goose",
        "@com_github_pressly_goose_v3//lock",
    ],
)

go_test(
    name = "baseline_integration_test",
    size = "medium",
    srcs = ["baseline_integration_test.go"],
    embed = [":migrations"],
    tags = ["requires_docker"],
    deps = [
        "//agentplane/testing/postgres",
        "@com_github_lib_pq//:pq",
        "@com_github_pressly_goose_v3//:goose",
    ],
)
