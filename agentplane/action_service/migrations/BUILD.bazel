load("//devinfra/python:defs.bzl", "py_library")

# Alembic discovers revisions by reading these files at runtime, and gazelle does not manage this
# list or the `exports_files` it names. A migration left out of either is silently never applied.
filegroup(
    name = "files",
    srcs = [
        "env.py",
        "script.py.mako",
        "//agentplane/action_service/migrations/versions:0001_action_service.py",
        "//agentplane/action_service/migrations/versions:0002_decision_provider_reason.py",
        "//agentplane/action_service/migrations/versions:0003_executor_liveness.py",
        "//agentplane/action_service/migrations/versions:0004_drop_action_outbox.py",
        "//agentplane/action_service/migrations/versions:0005_structured_action.py",
        "//agentplane/action_service/migrations/versions:0006_decision_note.py",
        "//agentplane/action_service/migrations/versions:0007_cancellation_actor.py",
        "//agentplane/action_service/migrations/versions:0008_external_connections.py",
        "//agentplane/action_service/migrations/versions:0009_action_external_grant.py",
        "//agentplane/action_service/migrations/versions:0010_connection_enrollments.py",
        "//agentplane/action_service/migrations/versions:0011_enrollment_reconnect.py",
        "//agentplane/action_service/migrations/versions:0012_action_push_subscription.py",
        "//agentplane/action_service/migrations/versions:0013_mcp_server_linkage.py",
        "//agentplane/action_service/migrations/versions:0014_action_policies.py",
        "//agentplane/action_service/migrations/versions:0015_action_request_context.py",
        "//agentplane/action_service/migrations/versions:0016_structured_principals.py",
    ],
    visibility = ["//agentplane/action_service:__pkg__"],
)

py_library(
    name = "env",
    srcs = ["env.py"],
    deps = [
        "//agentplane/action_service:db",
        "@pypi//alembic",
    ],
)
