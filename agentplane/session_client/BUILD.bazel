load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//agentplane:__subpackages__"])

go_library(
    name = "session_client",
    srcs = ["observe_input.go"],
    importpath = "github.com/agentydragon/ducktape/agentplane/session_client",
    deps = [
        "//agentplane/history_service:history_service_go_proto",
        "//agentplane/proto:event_go_proto",
        "//agentplane/runner_gateway/dispatcher:session_dispatcher_go_proto",
        "@com_github_google_uuid//:uuid",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//encoding/protojson",
    ],
)

go_test(
    name = "session_client_test",
    srcs = ["observe_input_test.go"],
    embed = [":session_client"],
    race = "on",
    deps = [
        "//agentplane/history_service:history_service_go_proto",
        "//agentplane/proto:event_go_proto",
        "//agentplane/proto:event_log_go_proto",
        "//agentplane/runner_gateway/dispatcher:session_dispatcher_go_proto",
        "@com_github_google_uuid//:uuid",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//types/known/emptypb",
    ],
)
