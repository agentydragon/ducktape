load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//agentplane:__subpackages__"])

py_library(
    name = "driver",
    srcs = ["driver.py"],
    deps = [":wire"],
)

py_library(
    name = "scenarios",
    srcs = ["scenarios.py"],
)

py_library(
    name = "facade",
    srcs = ["facade.py"],
    deps = [
        ":driver",
        ":wire",
        "//agentplane/native:transport",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "wire",
    srcs = ["wire.py"],
    deps = [
        "//agentplane/native:omit_none",
        "//agentplane/native:tagged",
        "@pypi//pydantic",
    ],
)

py_test(
    name = "test_wire",
    srcs = ["test_wire.py"],
    deps = [
        ":conftest",
        ":driver",
        ":wire",
        "//:conftest",
        "//agentplane/native:conftest",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    deps = [
        "//agentplane/native/codex/testing:harness",
        "//agentplane/native/codex/testing:responses",
        "//util/bazel:runfiles",
        "@pypi//pytest",
    ],
)

