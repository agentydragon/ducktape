load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//agentplane:__subpackages__"])

py_library(
    name = "transport",
    srcs = ["transport.py"],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "tagged",
    srcs = ["tagged.py"],
)

py_library(
    name = "omit_none",
    srcs = ["omit_none.py"],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "delta_templates",
    srcs = ["delta_templates.py"],
)

py_test(
    name = "test_delta_templates",
    srcs = ["test_delta_templates.py"],
    deps = [
        ":conftest",
        ":delta_templates",
        "//:conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    deps = [
        "//util/testing:undeclared_outputs",
        "@pypi//pytest",
    ],
)

test_suite(
    name = "harness_tests",
    tests = [
        "//agentplane/native/claude:test_active_turn",
        "//agentplane/native/claude:test_connection_loss",
        "//agentplane/native/claude:test_tools",
        "//agentplane/native/claude:test_turns",
        "//agentplane/native/codex:test_active_turn",
        "//agentplane/native/codex:test_connection_loss",
        "//agentplane/native/codex:test_tools",
        "//agentplane/native/codex:test_turns",
        "//agentplane/native/testing:test_model_endpoint",
    ],
)
