load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//agentplane:__subpackages__"])

py_library(
    name = "transport",
    srcs = ["transport.py"],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "tagged",
    srcs = ["tagged.py"],
)

py_library(
    name = "omit_none",
    srcs = ["omit_none.py"],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "delta_templates",
    srcs = ["delta_templates.py"],
)

py_test(
    name = "test_delta_templates",
    srcs = ["test_delta_templates.py"],
    deps = [
        ":delta_templates",
        "//:conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
