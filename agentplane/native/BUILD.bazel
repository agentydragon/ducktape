load("//devinfra/python:defs.bzl", "py_library")

package(default_visibility = ["//agentplane:__subpackages__"])

py_library(
    name = "tagged",
    srcs = ["tagged.py"],
)

py_library(
    name = "omit_none",
    srcs = ["omit_none.py"],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    deps = [
        "//devinfra/testing:undeclared_outputs",
        "@pypi//pytest",
    ],
)
