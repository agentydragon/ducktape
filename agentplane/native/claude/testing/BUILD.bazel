load("//devinfra/python:defs.bzl", "py_library")

package(
    default_testonly = True,
    default_visibility = ["//agentplane:__subpackages__"],
)

py_library(
    name = "async_run",
    srcs = ["async_run.py"],
    deps = [
        "//agentplane/native/claude:blocks",
        "//agentplane/native/claude:facade",
        "//agentplane/native/claude:scenarios",
        "//agentplane/native/claude:wire",
        "//agentplane/native/testing:async_process",
    ],
)

py_library(
    name = "mcp",
    srcs = ["mcp.py"],
    deps = [
        "//agentplane/native/claude:driver",
        "//agentplane/native/claude:wire",
        "@pypi//fastmcp_slim",
        "@pypi//mcp",
        "@pypi//mcp_types",
    ],
)

py_library(
    name = "anthropic_sse",
    srcs = ["anthropic_sse.py"],
    deps = ["//agentplane/native/testing:model_endpoint"],
)

py_library(
    name = "frames",
    srcs = ["frames.py"],
    deps = [
        "//agentplane/native/claude:blocks",
        "//agentplane/native/claude:wire",
    ],
)

py_library(
    name = "harness",
    srcs = ["harness.py"],
    deps = [
        ":async_run",
        ":mcp",
        ":messages",
        ":model",
        "//agentplane/native/claude:driver",
        "//agentplane/native/claude:scenarios",
        "//agentplane/native/claude:wire",
    ],
)

py_library(
    name = "messages",
    srcs = ["messages.py"],
    deps = [
        ":requests",
        "//agentplane/native/testing:model_endpoint",
    ],
)

py_library(
    name = "model",
    srcs = ["model.py"],
)

py_library(
    name = "requests",
    srcs = ["requests.py"],
    deps = [
        "//agentplane/native/claude:blocks",
        "@pypi//pydantic",
    ],
)
