load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//agentplane:__subpackages__"])

py_library(
    name = "blocks",
    srcs = ["blocks.py"],
    deps = [
        "//agentplane/native:tagged",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "driver",
    srcs = ["driver.py"],
    deps = [":wire"],
)

py_library(
    name = "scenarios",
    srcs = ["scenarios.py"],
    deps = [
        ":driver",
        ":wire",
        "//agentplane/native:process",
    ],
)

py_library(
    name = "async_run",
    testonly = True,
    srcs = ["async_run.py"],
    deps = [
        ":blocks",
        ":facade",
        ":scenarios",
        ":wire",
        "//agentplane/native:async_process",
    ],
)

py_library(
    name = "facade",
    srcs = ["facade.py"],
    deps = [
        ":driver",
        ":wire",
        "//agentplane/native:transport",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "wire",
    srcs = ["wire.py"],
    deps = [
        ":blocks",
        "//agentplane/native:omit_none",
        "//agentplane/native:tagged",
        "@pypi//pydantic",
    ],
)

py_test(
    name = "test_wire",
    srcs = ["test_wire.py"],
    deps = [
        ":blocks",
        ":driver",
        ":wire",
        "//:conftest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "mcp",
    srcs = ["mcp.py"],
    deps = [
        ":driver",
        ":wire",
        "@pypi//fastmcp_slim",
        "@pypi//mcp",
        "@pypi//mcp_types",
    ],
)
