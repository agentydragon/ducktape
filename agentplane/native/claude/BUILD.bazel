load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//agentplane:__subpackages__"])

py_library(
    name = "blocks",
    srcs = ["blocks.py"],
    deps = [
        "//agentplane/native:tagged",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "driver",
    srcs = ["driver.py"],
    deps = [":wire"],
)

py_library(
    name = "scenarios",
    srcs = ["scenarios.py"],
    deps = [
        ":driver",
        ":wire",
    ],
)

py_library(
    name = "facade",
    srcs = ["facade.py"],
    deps = [
        ":driver",
        ":wire",
        "//agentplane/native:transport",
        "@pypi//pydantic",
    ],
)

