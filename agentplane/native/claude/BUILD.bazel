load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//agentplane:__subpackages__"])

py_library(
    name = "blocks",
    srcs = ["blocks.py"],
    deps = [
        "//agentplane/native:tagged",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "driver",
    srcs = ["driver.py"],
    deps = [":wire"],
)

py_library(
    name = "scenarios",
    srcs = ["scenarios.py"],
    deps = [
        ":driver",
        ":wire",
    ],
)

py_library(
    name = "facade",
    srcs = ["facade.py"],
    deps = [
        ":driver",
        ":wire",
        "//agentplane/native:transport",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "wire",
    srcs = ["wire.py"],
    deps = [
        ":blocks",
        "//agentplane/native:omit_none",
        "//agentplane/native:tagged",
        "@pypi//pydantic",
    ],
)

py_test(
    name = "test_wire",
    srcs = ["test_wire.py"],
    deps = [
        ":blocks",
        ":driver",
        ":wire",
        "//:conftest",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_facade",
    srcs = ["test_facade.py"],
    deps = [
        ":facade",
        ":wire",
        "//:conftest",
        "//agentplane/native/testing:async_process",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
