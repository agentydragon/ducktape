load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//agentplane:__subpackages__"])

py_library(
    name = "binding",
    srcs = ["binding.py"],
    # The generator writes the annotation each offered template describes itself in, and its test
    # reads the offered templates through the binding to check every one carries it.
    visibility = [
        "//agentplane:__subpackages__",
        "//cluster/cdk8s/agentplane:__pkg__",
    ],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "inventory",
    srcs = ["inventory.py"],
    deps = [
        ":binding",
        ":models",
        "//agentplane:subjects",
        "//mcp_infra/exec:kubernetes",
        "//util:agent_sandbox",
        "//util:kubernetes",
        "@pypi//kubernetes_asyncio",
    ],
)

py_library(
    name = "models",
    srcs = ["models.py"],
    deps = [
        "//mcp_infra/exec:models",
        "@pypi//pydantic",
    ],
)

py_test(
    name = "test_inventory",
    srcs = ["test_inventory.py"],
    deps = [
        ":binding",
        ":inventory",
        ":models",
        "//:conftest",
        "//agentplane:subjects",
        "//mcp_infra/exec:kubernetes",
        "//mcp_infra/exec:models",
        "//util:agent_sandbox",
        "@pypi//kubernetes_asyncio",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
