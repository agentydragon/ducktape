# Dex and the MCP servers `test_mcp` calls, imported only by targets that run them
# (`acceptance_test(mcp_fixtures = True)`): a subdirectory, so `stack.py`'s glob skips them.
[
    oci_layout_rloc(
        name = "mcp_fixtures/" + name + "_layout",
        testonly = True,
        image = image,
        visibility = ["//agentplane/acceptance:__pkg__"],
    )
    for name, image in {
        "dex": "@dex_linux_amd64",
        "mcp_everything": "@mcp_everything_linux_amd64",
        "oauth_fixture": "//agentplane/action_service/testing:oauth_mcp_server_image",
    }.items()
]

