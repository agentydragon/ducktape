# Dex and the MCP servers `test_mcp` calls, imported only by targets that run them
# (`system_test(mcp_fixtures = True)`): a subdirectory, so `stack.py`'s glob skips them.
[
    oci_layout_rloc(
        name = "mcp_fixtures/" + name + "_layout",
        testonly = True,
        image = image,
        visibility = ["//agentplane/system_tests:__pkg__"],
    )
    for name, image in {
        "dex": "@dex_linux_amd64",
        "mcp_everything": "@mcp_everything_linux_amd64",
        "oauth_fixture": "//agentplane/action_service/testing:oauth_mcp_server_image",
    }.items()
]

# KubeVirt's and Kyverno's images, imported by targets that run VM Sandboxes
# (`system_test(vm_sandboxes = ...)`): a subdirectory, so `stack.py`'s glob skips them.
[
    oci_layout_rloc(
        name = "vm_sandboxes/" + name + "_layout",
        testonly = True,
        image = image,
        visibility = ["//agentplane/system_tests:__pkg__"],
    )
    for name, image in K3S_VM_IMAGES.items()
]

