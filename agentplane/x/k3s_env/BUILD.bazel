# The fixture chart for each model backend, and for the local model with the MCP fixtures (Dex and the
# MCP servers of `acceptance_test(mcp_fixtures = True)` targets), rendered once per build so no test
# action starts Node or compiles the chart code. The values only the test action knows are
# placeholders it fills in.
genrule(
    name = "rendered",
    testonly = True,
    outs = [
        "rendered/local-model.json",
        "rendered/local-model-mcp-fixtures.json",
        "rendered/none.json",
        "rendered/none-vm.json",
        "rendered/public-litellm.json",
    ],
    cmd = "JSII_NODE=$(execpath @nodejs_linux_amd64//:bin/node) K3S_FIXTURE_DIR=$(RULEDIR)/rendered $(execpath :render_fixture_bin)",
    tools = [
        ":render_fixture_bin",
        "@nodejs_linux_amd64//:bin/node",
    ],
    visibility = ["//agentplane/acceptance:__pkg__"],
)

