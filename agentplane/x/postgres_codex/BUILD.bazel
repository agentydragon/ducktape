load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_binary(
    name = "main_bin",
    testonly = True,
    main_module = "agentplane.x.postgres_codex.main",
    deps = [":main"],
)

py_test(
    name = "test_sampler",
    srcs = ["test_sampler.py"],
    data = [
        ":main_bin",
        "@agentplane_codex_cli_linux_x64//:files",
    ],
    requires_docker = True,
    deps = [
        ":code_mode",
        ":conftest",
        ":executor",
        ":sampler",
        ":store",
        ":testing",
        "//:conftest",
        "//agentplane/native/codex:wire",
        "//agentplane/native/codex/testing:harness",
        "//agentplane/native/codex/testing:responses",
        "//agentplane/native/codex/testing:responses_sse",
        "//util/testing:sqlalchemy_engines",
        "//util/testing:undeclared_outputs",
        "@pypi//aiohttp",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "store",
    srcs = ["store.py"],
    deps = ["@pypi//sqlalchemy"],
)

py_library(
    name = "executor",
    srcs = ["executor.py"],
    deps = [
        ":store",
        "//agentplane/runner_gateway:executor_client",
        "@pypi//aiohttp",
    ],
)

py_library(
    name = "code_mode",
    srcs = ["code_mode.py"],
    deps = [
        ":executor",
        ":store",
    ],
)

py_library(
    name = "sampler",
    srcs = ["sampler.py"],
    deps = [
        ":code_mode",
        ":compaction",
        ":responses",
        ":store",
        "@pypi//aiohttp",
    ],
)

py_library(
    name = "main",
    testonly = True,
    srcs = ["main.py"],
    deps = [
        ":code_mode",
        ":compaction",
        ":control",
        ":executor",
        ":sampler",
        ":store",
        "//util/testing:sqlalchemy_engines",
        "@pypi//aiohttp",
        "@pypi//asyncpg",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "conftest",
