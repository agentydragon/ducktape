load("@bazel_skylib//rules:select_file.bzl", "select_file")
load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")
load("@rules_oci//oci:defs.bzl", "oci_image")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files", "strip_prefix")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "main_lib",
    srcs = ["main.go"],
    importpath = "github.com/agentydragon/ducktape/agentplane/x/central_sampler/cmd",
    visibility = ["//visibility:private"],
    deps = [
        "//agentplane/postgres/go:postgres",
        "//agentplane/postgres/go/wakeups",
        "//agentplane/workload_auth/go/auth",
        "//agentplane/x/central_sampler",
        "//agentplane/x/central_sampler:sampler_go_proto",
        "//util/netlistener",
        "@io_k8s_client_go//kubernetes",
        "@io_k8s_client_go//rest",
        "@io_k8s_client_go//tools/clientcmd",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//health",
        "@org_golang_google_grpc//health/grpc_health_v1",
        "@org_golang_x_sync//errgroup",
    ],
)

go_binary(
    name = "main_bin",
    embed = [":main_lib"],
    pure = "on",
)

pkg_files(
    name = "binary_file",
    srcs = [":main_bin"],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "/usr/local/bin",
    renames = {":main_bin": "central-sampler"},
    strip_prefix = strip_prefix.files_only(),
)

pkg_tar(
    name = "binary_layer",
    srcs = [":binary_file"],
)

select_file(
    name = "code_mode_host_bin",
    srcs = "@agentplane_codex_cli_linux_x64//:files",
    subpath = "bin/codex-code-mode-host",
)

pkg_files(
    name = "code_mode_host_file",
    srcs = [":code_mode_host_bin"],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "/usr/local/bin",
    strip_prefix = strip_prefix.files_only(),
)

pkg_tar(
    name = "code_mode_host_layer",
    srcs = [":code_mode_host_file"],
)

pkg_tar(
    name = "tmp_layer",
    empty_dirs = ["tmp"],
    mode = "1777",
)

oci_image(
    name = "service_image",
    base = "@distroless_static_debian13_linux_amd64",
    entrypoint = ["/usr/local/bin/central-sampler"],
    env = {"SSL_CERT_FILE": "/etc/ssl/certs/ca-certificates.crt"},
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [
        ":binary_layer",
        ":code_mode_host_layer",
        ":tmp_layer",
        "//third_party/debian_slim:cacerts",
    ],
    user = "1000:1000",
    visibility = ["//visibility:public"],
    workdir = "/",
)
