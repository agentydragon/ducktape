load("@io_bazel_rules_go//go:def.bzl", "go_binary")
load("@rules_oci//oci:defs.bzl", "oci_image")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load(
    "//agentplane/env/e2e/testing:exec_properties.bzl",
    "NATIVE_RUNNER_DOCKER_ENV",
    "NATIVE_RUNNER_DOCKER_EXEC_PROPERTIES",
)
load("//devinfra/oci:defs.bzl", "oci_layout_py")
load("//devinfra/python:defs.bzl", "py_library", "py_test")

# gazelle:resolve py agentplane.x.runner_layering.tools_rootfs //agentplane/x/runner_layering:tools_rootfs

package(default_visibility = ["//visibility:public"])

go_binary(
    name = "child_exec",
    srcs = ["child_exec.go"],
    importpath = "github.com/agentydragon/ducktape/agentplane/x/runner_layering/child_exec",
    race = "off",
)

# The workload image extends the Debian tool closure with one workload-owned executable. Keeping
# that executable in its own OCI layer lets the runner and pinned harness stay independent of it.
pkg_tar(
    name = "workload_tool_layer",
    srcs = ["workload-tool"],
    mode = "0755",
    package_dir = "/usr/local/bin",
)

oci_image(
    name = "workload_tools_image",
    architecture = "amd64",
    os = "linux",
    tars = [
        "@trixie_runner_tools//:flat",
        ":workload_tool_layer",
    ],
)

oci_layout_py(
    name = "tools_rootfs",
    image = ":workload_tools_image",
)

py_test(
    name = "test_sparse_root",
    size = "large",
    srcs = ["test_sparse_root.py"],
    data = [
        ":child_exec",  # keep: the sparse-root Codex process fence
        "//agentplane/env/runtime/cmd:agentplane-environment-runtime",  # keep: the environment Runtime as its own process
        "@agentplane_codex_cli_linux_x64//:files",  # keep: pinned Codex and bwrap
    ],
    env = NATIVE_RUNNER_DOCKER_ENV,
    exec_properties = NATIVE_RUNNER_DOCKER_EXEC_PROPERTIES,
    requires_docker = True,
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    deps = [
        ":conftest",
        "//:conftest",
        "//agentplane/env/e2e/testing:driver",
        "//agentplane/env/e2e/testing:events",
        "//agentplane/env/e2e/testing:launches",
        "//agentplane/env/e2e/testing:process_fixtures",
        "//agentplane/proto:event_pb2",
        "//agentplane/proto:session_pb2",
        "//agentplane/testing:scripted_model",
        "//agentplane/x/runner_layering:tools_rootfs",
        "@pypi//protobuf",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@rules_python//python/runfiles",
    ],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    deps = [
        "//agentplane/env/e2e/testing:driver",
        "//agentplane/env/e2e/testing:failure_journal",
        "//agentplane/env/e2e/testing:fixtures",
        "//agentplane/env/e2e/testing:gateway",
        "//agentplane/env/e2e/testing:process_fixtures",
        "//agentplane/history_service/testing:fixtures",
        "//agentplane/history_service/testing:go_service",
        "//agentplane/testing:kubernetes_apiserver_fixtures",
        "//agentplane/testing:sandbox_fixtures",
        "//util/testing:postgres_fixtures",
        "@pypi//pytest",
    ],
)
