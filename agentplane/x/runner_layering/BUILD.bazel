load("@io_bazel_rules_go//go:def.bzl", "go_binary")
load("@rules_oci//oci:defs.bzl", "oci_image")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//agentplane/runner/testing:exec_properties.bzl", "NATIVE_RUNNER_DOCKER_EXEC_PROPERTIES")
load("//devinfra/cpio:defs.bzl", "cpio_archive")
load("//devinfra/oci:defs.bzl", "oci_layout_rloc")
load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

go_binary(
    name = "boot_init",
    srcs = ["boot_init.go"],
    importpath = "github.com/agentydragon/ducktape/agentplane/x/runner_layering/boot_init",
)

go_binary(
    name = "child_exec",
    srcs = ["child_exec.go"],
    importpath = "github.com/agentydragon/ducktape/agentplane/x/runner_layering/child_exec",
)

pkg_files(
    name = "boot_init_file",
    srcs = [":boot_init"],
    attributes = pkg_attributes(
        gid = 0,
        mode = "0755",
        uid = 0,
    ),
    renames = {":boot_init": "init"},
)

cpio_archive(
    name = "base_initramfs",
    srcs = [":boot_init_file"],
    out = "base-initramfs.cpio",
)

# The workload image extends the Debian tool closure with one workload-owned executable. Keeping
# that executable in its own OCI layer lets the runner and pinned harness stay independent of it.
pkg_tar(
    name = "workload_tool_layer",
    srcs = ["workload-tool"],
    mode = "0755",
    package_dir = "/usr/local/bin",
)

oci_image(
    name = "workload_tools_image",
    architecture = "amd64",
    os = "linux",
    tars = [
        "@trixie_runner_tools//:flat",
        ":workload_tool_layer",
    ],
)

oci_layout_rloc(
    name = "tools_rootfs",
    image = ":workload_tools_image",
)

py_binary(
    name = "local_vm_probe",
    data = [
        ":base_initramfs",
        ":tools_rootfs",
        "//devinfra/firecracker:firecracker_layer",
        "@agentplane_codex_cli_linux_x64//:codex_binary",
        "@agentplane_codex_cli_linux_x64//:codex_bwrap",
        "@claude_code_cli_linux_x64//:claude",
        "@firecracker_vmlinux_6_1_128//file",
    ],
    main_module = "agentplane.x.runner_layering.local_vm",
    deps = [
        ":local_vm",
    ],
)

py_library(
    name = "local_vm",
    srcs = ["local_vm.py"],
    deps = [
        "//util/bazel:runfiles",
        "@pypi//httpx",
    ],
)

py_test(
    name = "test_sparse_root",
    size = "large",
    srcs = ["test_sparse_root.py"],
    data = [
        ":child_exec",  # keep: the sparse-root Codex process fence
        ":tools_rootfs",  # keep: independent tools image for sparse-root probe
        "//agentplane/runner:main_bin",  # keep: the runner as its own process
        "@agentplane_codex_cli_linux_x64//:files",  # keep: pinned Codex and bwrap
    ],
    exec_properties = NATIVE_RUNNER_DOCKER_EXEC_PROPERTIES,
    requires_docker = True,
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    deps = [
        ":conftest",
        "//:conftest",
        "//agentplane/proto:event_pb2",
        "//agentplane/proto:runner_pb2",
        "//agentplane/runner/testing:driver",
        "//agentplane/runner/testing:events",
        "//agentplane/runner/testing:launches",
        "//agentplane/runner/testing:process_fixtures",
        "//agentplane/testing:scripted_model",
        "//util/bazel:runfiles",
        "@pypi//protobuf",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    deps = [
        "//agentplane/history_service/testing:fixtures",
        "//agentplane/history_service/testing:go_service",
        "//agentplane/runner/testing:driver",
        "//agentplane/runner/testing:fixtures",
        "//agentplane/runner/testing:gateway",
        "//agentplane/runner/testing:process_fixtures",
        "//agentplane/testing:kubernetes_apiserver_fixtures",
        "//util/testing:postgres_fixtures",
        "@pypi//pytest",
    ],
)
