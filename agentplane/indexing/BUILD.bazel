load("@aspect_rules_py//py:defs.bzl", "py_image_layer", aspect_py_binary = "py_binary")
load("@rules_oci//oci:defs.bzl", "oci_image")
load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")
load("//props:oci.bzl", "py_image_entrypoint", "py_image_env")

package(default_visibility = ["//agentplane:__subpackages__"])

py_binary(
    name = "main_bin",
    main_module = "agentplane.indexing.main",
    deps = [":main"],
)

aspect_py_binary(
    name = "image_bin",
    main = "main.py",
    deps = [":main"],
)

py_image_layer(
    name = "layers",
    binary = ":image_bin",
    group = "1000",
    owner = "1000",
)

oci_image(
    name = "image",
    base = "@debian_trixie_slim_linux_amd64",
    entrypoint = py_image_entrypoint("image_bin"),
    env = py_image_env(
        binary_name = "image_bin",
        extra_env = {"SSL_CERT_FILE": "/etc/ssl/certs/ca-certificates.crt"},
    ),
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [
        ":layers",
        "//third_party/debian_slim:cacerts",
    ],
    user = "1000:1000",
)

py_library(
    name = "app",
    srcs = ["app.py"],
    deps = [
        ":embedder",
        ":maintenance",
        ":store",
        "@pypi//fastapi",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "main",
    srcs = ["main.py"],
    deps = [
        ":app",
        ":maintenance",
        ":openai_embedder",
        ":settings",
        ":source",
        ":store",
        "@pypi//asyncpg",
        "@pypi//openai",
        "@pypi//pathspec",
        "@pypi//pygit2",
        "@pypi//sqlalchemy",
        "@pypi//uvicorn",
    ],
)

py_library(
    name = "maintenance",
    srcs = ["maintenance.py"],
    deps = [
        ":embedder",
        ":source",
        ":store",
    ],
)

py_library(
    name = "source",
    srcs = ["source.py"],
    deps = [
        ":settings",
        "@pypi//pathspec",
        "@pypi//pygit2",
    ],
)

py_library(
    name = "store",
    srcs = ["store.py"],
    deps = [
        ":chunking",
        ":content",
        ":embedder",
        ":vector_type",
        "@pypi//sqlalchemy",
    ],
)

py_test(
    name = "test_source",
    srcs = ["test_source.py"],
    deps = [
        ":conftest",
        ":settings",
        ":source",
        "//:conftest",
        "@pypi//pathspec",
        "@pypi//pygit2",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    deps = [
        ":chunking",
        ":store",
        "//third_party/containers:pgvector_pg18",
        "//util:oci",
        "//util/testing:postgres",
        "//util/testing:postgres_fixtures",
        "//util/testing:sqlalchemy_engines",
        "@pypi//asyncpg",
        "@pypi//psycopg",
        "@pypi//pygit2",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",
        "@pypi//sqlalchemy",
    ],
)

py_test(
    name = "test_app",
    size = "medium",
    srcs = ["test_app.py"],
    requires_docker = True,
    deps = [
        ":app",
        ":conftest",
        ":maintenance",
        ":settings",
        ":source",
        ":store",
        "//:conftest",
        "@pypi//httpx",
        "@pypi//pathspec",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_store",
    size = "medium",
    srcs = ["test_store.py"],
    requires_docker = True,
    deps = [
        ":chunking",
        ":conftest",
        ":content",
        ":store",
        "//:conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "settings",
    srcs = ["settings.py"],
    visibility = [
        "//agentplane:__subpackages__",
        "//cluster/cdk8s/agentplane_index:__pkg__",
    ],
    deps = [
        ":chunking",
        "@pypi//pydantic",
        "@pypi//pydantic_settings",
    ],
)

py_library(
    name = "chunking",
    srcs = ["chunking.py"],
)

py_library(
    name = "content",
    srcs = ["content.py"],
)

py_library(
    name = "embedder",
    srcs = ["embedder.py"],
)

py_library(
    name = "openai_embedder",
    srcs = ["openai_embedder.py"],
    deps = ["@pypi//openai"],
)

py_test(
    name = "test_chunking",
    srcs = ["test_chunking.py"],
    deps = [
        ":chunking",
        ":conftest",
        "//:conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "vector_type",
    srcs = ["vector_type.py"],
    visibility = [
        "//agentplane:__subpackages__",
        "//haku/console:__pkg__",
    ],
    deps = ["@pypi//sqlalchemy"],
)
