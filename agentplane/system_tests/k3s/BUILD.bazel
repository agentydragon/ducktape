# The runner Pod's tools image. It keeps Debian's shell utilities for bootstrap and process-lifecycle
# fixtures, plus curl and git (the `trixie_e2e` package set) for scripted commands; the Nix-built
# production image supplies the full toolset. As in production, the runner is not in it: the Pod runs
# it from the volume of the production runner disk image.
oci_image(
    name = "runner_image",
    base = "@debian_trixie_slim_linux_amd64",
    tars = [
        "//third_party/debian_slim:cacerts",
        "@trixie_e2e//:flat",
        ":runner_cli_link",
    ],
    user = "1000:1000",
)

# **Deviation:** production appends the runner disk's bin to PATH (agentplane/runner/image.nix). Here
# `agentplane` is linked into /usr/bin instead, because Codex runs commands in a login shell and
# Debian's /etc/profile resets PATH.
pkg_tar(
    name = "runner_cli_link",
    package_dir = "/usr/bin",
    symlinks = {"agentplane": "/run/agentplane/runner/bin/agentplane"},
)

pkg_tar(
    name = "runner_claude_harness",
    srcs = ["@claude_code_cli_linux_x64//:claude"],
    mode = "0755",
    package_dir = "/opt/harnesses",
    strip_prefix = ".",
    visibility = ["//agentplane/system_tests/k3s/guest:__pkg__"],
)

# The base image's /bin is a symlink to usr/bin.
pkg_tar(
    name = "runner_claude_link",
    package_dir = "/usr/bin",
    symlinks = {"claude": "/opt/harnesses/external/+http_archive+claude_code_cli_linux_x64/claude"},
)

oci_image(
    name = "runner_claude_image",
    base = ":runner_image",
    tars = [
        ":runner_claude_harness",
        ":runner_claude_link",
    ],
)

pkg_tar(
    name = "runner_codex_harness",
    srcs = ["@agentplane_codex_cli_linux_x64//:files"],
    mode = "0755",
    package_dir = "/opt/harnesses",
    strip_prefix = ".",
    visibility = ["//agentplane/system_tests/k3s/guest:__pkg__"],
)

pkg_tar(
    name = "runner_codex_link",
    package_dir = "/usr/bin",
    symlinks = {"codex": "/opt/harnesses/external/+http_archive+agentplane_codex_cli_linux_x64/bin/codex"},
)

# Both harnesses, for scenarios that run a turn.
oci_image(
    name = "runner_harnesses_image",
    base = ":runner_claude_image",
    tars = [
        ":runner_codex_harness",
        ":runner_codex_link",
    ],
)

# Pod suites share the runner layout containing both harnesses.
oci_layout_rloc(
