# Each output has a separate action. Ordinary and VM renderers use the common chart; only the MCP
# output depends on its fixture servers and Dex additions. Runtime values stay placeholders.
genrule(
    name = "render_local_model",
    testonly = True,
    outs = ["rendered/local-model.json"],
    cmd = "JSII_NODE=$(execpath @nodejs_linux_amd64//:bin/node) K3S_FIXTURE_VARIANT=local-model K3S_FIXTURE_DIR=$(RULEDIR)/rendered $(execpath :render_fixture_bin)",
    tools = [
        ":render_fixture_bin",
        "@nodejs_linux_amd64//:bin/node",
    ],
    visibility = ["//agentplane/system_tests:__subpackages__"],
)

