package(default_testonly = True)

image_manifest(
    name = "test_image_manifest_data",
    fixture = {
        "testdata/manifest_layout_a.txt": "example/fixture-a:1",
        "testdata/manifest_layout_b.txt": "example/fixture-b:1",
    },
    pki = {"testdata/manifest_layout_a.txt": "example/fixture-a:1"},
)

py_test(
    name = "test_image_manifest",
    srcs = ["test_image_manifest.py"],
    data = [":test_image_manifest_data"],
    env = {"IMAGE_MANIFEST_RLOCATION": "$(rlocationpath :test_image_manifest_data)"},
    deps = [
        "//:conftest",
        "//agentplane/system_tests:conftest",
        "@pypi//pytest_bazel",
        "@rules_python//python/runfiles",
    ],
)

