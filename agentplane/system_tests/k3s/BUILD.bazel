py_test(
    name = "test_pinned_images",
    size = "enormous",
    srcs = ["test_pinned_images.py"],
    data = [
        "//agentplane/egress:sidecar_image",
        K3S_BINARY,
    ],
    env = {
        "K3S_BINARY_RLOCATION": "$(rlocationpath " + K3S_BINARY + ")",
        "K3S_TEST_IMAGE_RLOCATION": "$(rlocationpath //agentplane/egress:sidecar_image)",
    },
    exec_properties = K3S_EXEC_PROPERTIES | K3S_PERSISTENCE_PROPERTIES | {
        "test.runner-recycling-key": "k3s-pinned-image-probe-v1",
    },
    tags = K3S_TAGS + ["manual"],
    deps = [
        ":baseline",
        "//:conftest",
        "//agentplane/system_tests:conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@rules_python//python/runfiles",
    ],
)

