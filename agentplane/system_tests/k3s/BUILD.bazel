# **Deviation:** production appends the runner disk's bin to PATH (agentplane/env/images/image.nix). Here
# `agentplane` is linked into /usr/bin instead, because Codex runs commands in a login shell and
# Debian's /etc/profile resets PATH.
pkg_tar(
    name = "runner_cli_link",
    package_dir = "/usr/bin",
    symlinks = {"agentplane": "/run/agentplane/environment/bin/agentplane"},
)

pkg_files(
    name = "runner_claude_harness_files",
    srcs = ["@claude_code_cli_linux_x64//:claude"],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "/opt/harnesses",
    strip_prefix = strip_prefix.files_only(),
)

pkg_tar(
    name = "runner_claude_harness",
    srcs = [":runner_claude_harness_files"],
    visibility = ["//agentplane/system_tests/k3s/guest:__pkg__"],
)

# The base image's /bin is a symlink to usr/bin.
pkg_tar(
    name = "runner_claude_link",
    package_dir = "/usr/bin",
    symlinks = {"claude": "/opt/harnesses/claude"},
)

pkg_files(
    name = "runner_codex_harness_files",
    srcs = ["@agentplane_codex_cli_linux_x64//:files"],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "/opt/harnesses/codex",
    strip_prefix = strip_prefix.from_pkg(),
)

pkg_tar(
    name = "runner_codex_harness",
    srcs = [":runner_codex_harness_files"],
    visibility = ["//agentplane/system_tests/k3s/guest:__pkg__"],
)

pkg_tar(
    name = "runner_codex_link",
    package_dir = "/usr/bin",
    symlinks = {"codex": "/opt/harnesses/codex/bin/codex"},
)

# The runner Pod's environment-tools image. It keeps Debian's shell utilities for bootstrap and
# process-lifecycle fixtures, plus curl and git (the `trixie_e2e` package set) for scripted commands;
# the Nix-built production image supplies the full toolset. As in production, the runner is not in it:
# the Pod runs it from the volume of the production runner disk image.
# Both harnesses, for scenarios that run a turn.
oci_image(
    name = "environment_tools_harnesses_image",
    base = "@debian_trixie_slim_linux_amd64",
    tars = [
        "//third_party/debian_slim:cacerts",
        "@trixie_e2e//:flat",
        ":runner_cli_link",
        ":runner_claude_harness",
        ":runner_claude_link",
        ":runner_codex_harness",
        ":runner_codex_link",
    ],
    user = "1000:1000",
)

