load("@image_pins//:pins.bzl", "CERT_MANAGER_CAINJECTOR_REFERENCE", "CERT_MANAGER_CONTROLLER_REFERENCE", "CERT_MANAGER_WEBHOOK_REFERENCE", "TRUST_MANAGER_REFERENCE")
load("//devinfra/oci:defs.bzl", "oci_image_manifest")

package(default_testonly = True)

oci_image_manifest(
    name = "images",
    images = {
        "@cert_manager_controller_linux_amd64": CERT_MANAGER_CONTROLLER_REFERENCE,
        "@cert_manager_webhook_linux_amd64": CERT_MANAGER_WEBHOOK_REFERENCE,
        "@cert_manager_cainjector_linux_amd64": CERT_MANAGER_CAINJECTOR_REFERENCE,
        "@trust_manager_linux_amd64": TRUST_MANAGER_REFERENCE,
    },
    visibility = ["//agentplane/system_tests:__subpackages__"],
)

genrule(
    name = "trust_manager_install_yaml",
    srcs = [
        "trust-manager-values.yaml",
        "@trust_manager_chart_v0_25_0//:chart_files",
        "@trust_manager_chart_v0_25_0//:chart_yaml",
    ],
    outs = ["trust-manager.yaml"],
    cmd = """
chart_manifest="$(location @trust_manager_chart_v0_25_0//:chart_yaml)"
chart_dir="$${chart_manifest%/Chart.yaml}"
$(location @helm_3_20_2_linux_amd64//:helm) template trust-manager "$${chart_dir}" \\
  --namespace cert-manager \\
  --values $(location trust-manager-values.yaml) \\
  --include-crds > "$@"
""",
    tools = ["@helm_3_20_2_linux_amd64//:helm"],
    visibility = [
        "//agentplane/system_tests:__subpackages__",
        "//agentplane/system_tests/k3s:__pkg__",
    ],
)
