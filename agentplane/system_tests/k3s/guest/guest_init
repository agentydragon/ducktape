#!/usr/bin/busybox sh
# The test guest's init on its root disk. It gives the runner what agentplane/runner/vm.nix does, without
# systemd: the disks vm.nix mounts by serial, the workspace formatted on first use, masquerade networking,
# busybox's tools, both harnesses, Bash, Git and `findmnt` in the NixOS system profile the runner puts on PATH,
# and the cgroup systemd delegates to `agentplane-runner.service` with the runner in its `runner`
# subgroup. It restarts the runner when it exits, and drains it before powering off on ACPI shutdown.
# vm.nix's sandboxing of the runner unit (capability
# bounding set, read-only system) is absent.
set -eux
profile=/run/current-system/sw/bin
export PATH=$profile:/usr/sbin:/usr/bin
busybox mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /run
busybox mkdir -p $profile
busybox --install -s $profile
ln -s /opt/harnesses/external/+http_archive+claude_code_cli_linux_x64/claude $profile/claude
ln -s /opt/harnesses/external/+http_archive+agentplane_codex_cli_linux_x64/bin/codex $profile/codex
ln -s /usr/bin/bash /usr/bin/git /usr/bin/findmnt $profile/
mount -t tmpfs -o mode=1777,nosuid,nodev tmpfs /tmp
mount -t tmpfs -o mode=0700 tmpfs /root
mount -t cgroup2 cgroup2 /sys/fs/cgroup

# udev's by-id links: the mounts below and the runner's workspace I/O limit name disks by them.
mkdir -p /dev/disk/by-id
for block in /sys/block/vd*; do
	ln -s "../../${block##*/}" "/dev/disk/by-id/virtio-$(cat "$block/serial")"
done

runtime=/run/agentplane
for disk in config:config sandbox:launch trust:trust; do
	directory=${disk%:*}
	serial=${disk#*:}
	mkdir -p "$runtime/$directory"
	mount -t iso9660 -o ro,nosuid,nodev,noexec "/dev/disk/by-id/virtio-agentplane-$serial" "$runtime/$directory"
done
mkdir "$runtime/runner"
mount -t erofs -o ro,nosuid,nodev /dev/disk/by-id/virtio-agentplane-runner "$runtime/runner"

mount -t virtiofs -o noatime,nodev,nosuid state /state
workspace=/state/workspaces
device=/dev/disk/by-id/virtio-workspace
mkdir -p "$workspace"
dumpe2fs -h "$device" >/dev/null 2>&1 || mkfs.ext4 -q "$device"
mount -t ext4 -o noatime,nodev,nosuid "$device" "$workspace"
mkdir -p "$workspace/.home"
chown 107:107 "$workspace" "$workspace/.home"
chmod 2770 "$workspace"
chmod 0700 "$workspace/.home"
setfacl -m d:user:107:rwx,d:group:107:rwx "$workspace"

ip link set lo up
ip link set eth0 up
ip addr add 10.0.2.2/24 dev eth0
ip route add default via 10.0.2.1

controllers="+cpu +io +memory +pids"
service=/sys/fs/cgroup/system.slice/agentplane-runner.service
mkdir -p "$service/runner"
for group in /sys/fs/cgroup /sys/fs/cgroup/system.slice "$service"; do
	echo "$controllers" >"$group/cgroup.subtree_control"
done

shutdown_requested=0
runner_pid=
terminate() {
	# An already-exited child may have been reaped by ash before its explicit wait.
	if ! kill -TERM "$1" 2>/dev/null && kill -0 "$1" 2>/dev/null; then
		echo "could not terminate owned process $1" >&2
		exit 1
	fi
}
request_shutdown() {
	shutdown_requested=1
	trap '' USR2
	echo "AGENTPLANE_GUEST_SHUTDOWN_REQUESTED"
	# Also signal here: a request between the flag check and wait must not leave wait blocked.
	if [ -n "$runner_pid" ]; then
		terminate "$runner_pid"
	fi
}
# Ignore later requests so they cannot interrupt the final wait for the runner's actual exit.
trap request_shutdown USR2
grep -q 'Name="Power Button"' /proc/bus/input/devices
/usr/sbin/agentplane-cgroup-observer &
observer_pid=$!
acpid -d &
acpid_pid=$!

umask 0007
export ANTHROPIC_AUTH_TOKEN=agentplane-credential-agentplane-workload
export OPENAI_API_KEY=agentplane-credential-agentplane-workload
while [ "$shutdown_requested" -eq 0 ]; do
	# The inner shell enters the runner's cgroup, then becomes the runner.
	sh -c "echo \$\$ >$service/runner/cgroup.procs && exec $runtime/runner/bin/agentplane-runner --config $runtime/config/runner.json --launch-file $runtime/sandbox/launch.json" &
	runner_pid=$!
	status=0
	if [ "$shutdown_requested" -eq 0 ]; then
		wait "$runner_pid" || status=$?
	fi
	if [ "$shutdown_requested" -eq 1 ]; then
		# The first wait may have been interrupted by the trap. SIGTERM invokes Runner.Close();
		# only the second, uninterrupted wait establishes that journals and native processes closed.
		terminate "$runner_pid"
		wait "$runner_pid"
		break
	fi
	runner_pid=
	echo "agentplane-runner exited $status; restarting"
	sleep 2
done
echo "AGENTPLANE_GUEST_RUNNER_DRAINED"

# The observer and ACPI listener do not own writable storage. Reap them before unmounting it.
for pid in "$observer_pid" "$acpid_pid"; do
	terminate "$pid"
	status=0
	wait "$pid" || status=$?
	[ "$status" -eq 0 ] || [ "$status" -eq 143 ]
done
sync
umount "$workspace"
umount /state
echo "AGENTPLANE_GUEST_SHUTDOWN_COMPLETE"
# Ordinary poweroff only signals PID1; this shell has already performed its shutdown duties.
exec busybox poweroff -f
