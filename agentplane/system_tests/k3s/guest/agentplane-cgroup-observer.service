[Unit]
Description=Publish read-only cgroup evidence for VM tests
After=agentplane-guest-prepare.service
Requires=agentplane-guest-prepare.service
Before=agentplane-runner.service

[Service]
ExecStart=/usr/sbin/agentplane-cgroup-observer
Environment=PATH=/run/current-system/sw/bin:/usr/sbin:/usr/bin
Restart=on-failure
ProtectControlGroups=yes
StandardOutput=journal+console
StandardError=journal+console
