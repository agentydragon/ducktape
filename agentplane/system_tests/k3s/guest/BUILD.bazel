load("@rules_oci//oci:defs.bzl", "oci_image")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//devinfra/erofs:defs.bzl", "erofs_image")
load("//devinfra/oci:defs.bzl", "oci_layout_rloc")
load("//devinfra/python:defs.bzl", "py_binary", "py_library")

# The k3s fixture's VM guest: a Debian cloud kernel booted directly by KubeVirt with a busybox
# initramfs, and an erofs root disk holding both harnesses and the init that gives the runner what
# agentplane/runner/vm.nix does. The runner itself comes from the fixture's runner disk.

package(default_visibility = ["//agentplane/system_tests/k3s:__subpackages__"])

py_library(
    name = "boot_files",
    srcs = ["boot_files.py"],
    deps = ["//devinfra/cpio:cpio_tool"],
)

py_binary(
    name = "boot_files_bin",
    main_module = "agentplane.system_tests.k3s.guest.boot_files",
    deps = [":boot_files"],
)

genrule(
    name = "boot_files_gen",
    srcs = [
        "initramfs_init",
        "@trixie_vm_guest//busybox-static:data",
        "@vm_guest_kernel_deb//file",
    ],
    outs = [
        "vmlinuz",
        "initramfs.cpio",
    ],
    cmd = " ".join([
        "$(execpath :boot_files_bin)",
        "$(execpath @vm_guest_kernel_deb//file)",
        "$(execpath @trixie_vm_guest//busybox-static:data)",
        "$(execpath initramfs_init)",
        "$(execpath vmlinuz)",
        "$(execpath initramfs.cpio)",
    ]),
    tools = [":boot_files_bin"],
)

# KubeVirt's kernel boot container: qemu reads the kernel and initramfs as uid 107.
pkg_tar(
    name = "boot_tar",
    srcs = [
        "initramfs.cpio",
        "vmlinuz",
    ],
    mode = "0644",
    package_dir = "/boot",
)

oci_image(
    name = "boot_image",
    architecture = "amd64",
    os = "linux",
    tars = [":boot_tar"],
)

pkg_tar(
    name = "root_etc",
    srcs = [
        "acpid.conf",
        "group",
        "hosts",
        "passwd",
    ],
    mode = "0644",
    package_dir = "/etc",
)

pkg_files(
    name = "root_acpi_file",
    srcs = ["acpi_poweroff"],
    attributes = pkg_attributes(mode = "0755"),
    renames = {"acpi_poweroff": "poweroff"},
)

pkg_tar(
    name = "root_acpi",
    srcs = [":root_acpi_file"],
    package_dir = "/etc/acpi",
)

pkg_files(
    name = "root_init_file",
    srcs = [
        "cgroup_observer",
        "guest_init",
    ],
    attributes = pkg_attributes(mode = "0755"),
    renames = {
        "cgroup_observer": "agentplane-cgroup-observer",
        "guest_init": "agentplane-guest-init",
    },
)

pkg_tar(
    name = "root_init",
    srcs = [":root_init_file"],
    package_dir = "/usr/sbin",
)

# Debian's packages are /usr-merged; ELF interpreters and the init path name the top-level links. The
# runner runs bootstrap scripts with /bin/sh.
pkg_tar(
    name = "root_tar",
    empty_dirs = [
        "dev",
        "proc",
        "root",
        "run",
        "state",
        "sys",
        "tmp",
    ],
    symlinks = {
        "bin": "usr/bin",
        "lib": "usr/lib",
        "lib64": "usr/lib64",
        "sbin": "usr/sbin",
        "usr/bin/sh": "busybox",
    },
    deps = [
        ":root_acpi",
        ":root_etc",
        ":root_init",
        "//agentplane/system_tests/k3s:runner_claude_harness",
        "//agentplane/system_tests/k3s:runner_codex_harness",
        "//agentplane/system_tests/k3s:runner_key_tools",
        "@trixie_vm_guest//:flat",
    ],
)

erofs_image(
    name = "root_erofs",
    out = "root.img",
    tar = ":root_tar",
    volume_label = "guest",
)

# KubeVirt's qemu reads the containerDisk as uid 107.
pkg_tar(
    name = "root_disk",
    srcs = [":root_erofs"],
    mode = "0644",
    owner = "107.107",
    package_dir = "/disk",
)

oci_image(
    name = "root_image",
    architecture = "amd64",
    os = "linux",
    tars = [":root_disk"],
    user = "107:107",
)

# The stack names each image after its layout: `agentplane-vm-guest-{boot,root}`.
oci_layout_rloc(
    name = "vm_guest_boot_layout",
    testonly = True,
    image = ":boot_image",
    visibility = ["//agentplane/system_tests:__pkg__"],
)

oci_layout_rloc(
    name = "vm_guest_root_layout",
    testonly = True,
    image = ":root_image",
    visibility = ["//agentplane/system_tests:__pkg__"],
)
