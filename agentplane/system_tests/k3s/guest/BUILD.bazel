load("@rules_oci//oci:defs.bzl", "oci_image")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//devinfra/erofs:defs.bzl", "erofs_image")
load("//devinfra/oci:defs.bzl", "oci_layout_rloc")
load("//devinfra/python:defs.bzl", "py_binary", "py_library")

# The k3s fixture's VM guest: a Debian cloud kernel booted directly by KubeVirt with a busybox
# initramfs, and an erofs root disk holding systemd and both harnesses. Shared production systemd
# units supervise the runner from the fixture's runner disk.

package(
    default_testonly = True,
    default_visibility = ["//agentplane/system_tests/k3s:__subpackages__"],
)

py_library(
    name = "boot_files",
    srcs = ["boot_files.py"],
    deps = ["//devinfra/cpio:cpio_tool"],
)

py_binary(
    name = "boot_files_bin",
    main_module = "agentplane.system_tests.k3s.guest.boot_files",
    deps = [":boot_files"],
)

genrule(
    name = "boot_files_gen",
    srcs = [
        "initramfs_init",
        "@trixie_vm_guest//busybox-static:data",
        "@vm_guest_kernel_deb//file",
    ],
    outs = [
        "vmlinuz",
        "initramfs.cpio",
    ],
    cmd = " ".join([
        "$(execpath :boot_files_bin)",
        "$(execpath @vm_guest_kernel_deb//file)",
        "$(execpath @trixie_vm_guest//busybox-static:data)",
        "$(execpath initramfs_init)",
        "$(execpath vmlinuz)",
        "$(execpath initramfs.cpio)",
    ]),
    tools = [":boot_files_bin"],
)

# KubeVirt's kernel boot container: qemu reads the kernel and initramfs as uid 107.
pkg_tar(
    name = "boot_tar",
    srcs = [
        "initramfs.cpio",
        "vmlinuz",
    ],
    mode = "0644",
    package_dir = "/boot",
)

oci_image(
    name = "boot_image",
    architecture = "amd64",
    os = "linux",
    tars = [":boot_tar"],
)

py_binary(
    name = "hwdb_bin",
    main_module = "agentplane.system_tests.k3s.guest.hwdb",
    deps = [":hwdb"],
)

genrule(
    name = "hwdb_gen",
    srcs = ["@trixie_vm_guest//:flat"],
    outs = ["hwdb.bin"],
    cmd = "$(execpath :hwdb_bin) $(execpath @trixie_vm_guest//:flat) $@",
    tools = [":hwdb_bin"],
)

# A vendor database with no /etc overrides lets systemd skip its boot-time rebuild before udevd.
pkg_tar(
    name = "root_hwdb",
    srcs = ["hwdb.bin"],
    mode = "0644",
    package_dir = "/usr/lib/udev",
)

pkg_tar(
    name = "root_etc",
    srcs = [
        "acpid.conf",
        "fstab",
        "group",
        "hosts",
        "machine-id",
        "passwd",
    ],
    mode = "0644",
    package_dir = "/etc",
)

pkg_tar(
    name = "root_tmpfiles",
    srcs = ["agentplane-runner.conf"],
    mode = "0644",
    package_dir = "/etc/tmpfiles.d",
)

pkg_files(
    name = "root_acpi_file",
    srcs = ["acpi_poweroff"],
    attributes = pkg_attributes(mode = "0755"),
    renames = {"acpi_poweroff": "poweroff"},
)

pkg_tar(
    name = "root_acpi",
    srcs = [":root_acpi_file"],
    package_dir = "/etc/acpi",
)

pkg_files(
    name = "root_init_file",
    srcs = [
        "cgroup_observer",
        "guest_prepare",
        "runner_start",
        "shutdown_complete",
        "supervision_check",
        "workspace_prepare",
    ],
    attributes = pkg_attributes(mode = "0755"),
    renames = {
        "cgroup_observer": "agentplane-cgroup-observer",
        "guest_prepare": "agentplane-guest-prepare",
        "runner_start": "agentplane-runner-start",
        "shutdown_complete": "agentplane-shutdown-complete",
        "supervision_check": "agentplane-supervision-check",
        "workspace_prepare": "agentplane-workspace-prepare",
    },
)

pkg_tar(
    name = "root_init",
    srcs = [":root_init_file"],
    package_dir = "/usr/sbin",
)

pkg_files(
    name = "root_systemd_files",
    srcs = [
        "agentplane-acpi.service",
        "agentplane-cgroup-observer.service",
        "agentplane-guest-prepare.service",
        "agentplane-shutdown-proof.service",
        "agentplane-workspace.service",
        "runner-guest.conf",
    ],
    attributes = pkg_attributes(mode = "0644"),
    renames = {"runner-guest.conf": "agentplane-runner.service.d/guest.conf"},
)

pkg_tar(
    name = "root_systemd",
    srcs = [":root_systemd_files"],
    package_dir = "/etc/systemd/system",
    symlinks = {
        "default.target": "/usr/lib/systemd/system/multi-user.target",
        "getty.target": "/dev/null",
        "multi-user.target.wants/agentplane-acpi.service": "../agentplane-acpi.service",
        "multi-user.target.wants/agentplane-runner.service": "/usr/lib/systemd/system/agentplane-runner.service",
        "multi-user.target.wants/agentplane-shutdown-proof.service": "../agentplane-shutdown-proof.service",
        "systemd-firstboot.service": "/dev/null",
        "systemd-logind.service": "/dev/null",
    },
)

pkg_tar(
    name = "root_shared_systemd",
    srcs = [
        "//agentplane/runner/systemd:agentplane.slice",
        "//agentplane/runner/systemd:agentplane-executors.slice",
        "//agentplane/runner/systemd:agentplane-runner.service",
        "//agentplane/runner/systemd:agentplane-workloads.slice",
    ],
    mode = "0644",
    package_dir = "/usr/lib/systemd/system",
)

pkg_tar(
    name = "root_resource_limits",
    srcs = ["//agentplane/runner/systemd:apply-resource-limits"],
    mode = "0755",
    package_dir = "/usr/libexec/agentplane",
)

pkg_files(
    # Test data for the selected boot; ordinary guests never execute this binary.
    name = "root_supervision_fixture_file",
    srcs = ["//agentplane/runner/supervision:runner_systemd_fixture"],
    attributes = pkg_attributes(mode = "0755"),
    renames = {"//agentplane/runner/supervision:runner_systemd_fixture": "runner-systemd-fixture"},
)

pkg_tar(
    name = "root_supervision_fixture",
    srcs = [":root_supervision_fixture_file"],
    package_dir = "/usr/libexec/agentplane",
)

# Debian's packages are /usr-merged; ELF interpreters and the init path name the top-level links. The
# runner runs bootstrap scripts with /bin/sh.
pkg_tar(
    name = "root_tar",
    empty_dirs = [
        "dev",
        "proc",
        "root",
        "run",
        "state",
        "sys",
        "tmp",
        "var/lib",
    ],
    symlinks = {
        "bin": "usr/bin",
        "lib": "usr/lib",
        "lib64": "usr/lib64",
        "sbin": "usr/sbin",
        "usr/bin/sh": "busybox",
        "var/lock": "/run/lock",
        "var/run": "/run",
    },
    deps = [
        ":root_acpi",
        ":root_etc",
        ":root_hwdb",
        ":root_init",
        ":root_resource_limits",
        ":root_shared_systemd",
        ":root_supervision_fixture",
        ":root_systemd",
        ":root_tmpfiles",
        "//agentplane/system_tests/k3s:runner_claude_harness",
        "//agentplane/system_tests/k3s:runner_codex_harness",
        "@trixie_vm_guest//:flat",
    ],
)

erofs_image(
    name = "root_erofs",
    out = "root.img",
    compress_lz4 = True,
    tar = ":root_tar",
    volume_label = "guest",
)

# KubeVirt's qemu reads the containerDisk as uid 107.
pkg_tar(
    name = "root_disk",
    srcs = [":root_erofs"],
    mode = "0644",
    owner = "107.107",
    package_dir = "/disk",
)

oci_image(
    name = "root_image",
    architecture = "amd64",
    os = "linux",
    tars = [":root_disk"],
    user = "107:107",
)

# The stack names each image after its layout: `agentplane-vm-guest-{boot,root}`.
oci_layout_rloc(
    name = "vm_guest_boot_layout",
    testonly = True,
    image = ":boot_image",
    visibility = ["//agentplane/system_tests:__subpackages__"],
)

oci_layout_rloc(
    name = "vm_guest_root_layout",
    testonly = True,
    image = ":root_image",
    visibility = ["//agentplane/system_tests:__subpackages__"],
)

py_library(
    name = "hwdb",
    srcs = ["hwdb.py"],
)
