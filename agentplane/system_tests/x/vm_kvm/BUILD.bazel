# gazelle:ignore

load("//agentplane/system_tests/k3s:defs.bzl", "VM_IMAGES", "image_seed")
load("//agentplane/system_tests/vm:defs.bzl", "vm_test")

package(
    default_testonly = True,
    default_visibility = ["//agentplane:__subpackages__"],
)

vm_test(
    name = "test_vm_kvm",
    tags = ["manual"],
)

image_seed(
    name = "infrastructure_image_seed",
    images = VM_IMAGES,
    tags = ["manual"],
)

vm_test(
    name = "test_vm_cold",
    cold_k3s = True,
    tags = [
        "bench",
        "manual",
    ],
)

vm_test(
    name = "test_vm_cold_seed",
    cold_k3s = True,
    infrastructure_image_seed = ":infrastructure_image_seed",
    tags = [
        "bench",
        "manual",
    ],
)

vm_test(
    name = "test_vm_nixos_spike",
    pool = "kvm-vm-nixos-spike",
    tags = ["manual"],
)

vm_test(
    name = "test_retained_failure_cleanup",
    extra_deps = [
        "//agentplane:sandbox_resource",
        "//agentplane/system_tests/deployment:rendered_fixture",
        "//agentplane/system_tests/deployment:stack",
        "//agentplane/system_tests/driver:identity",
        "//agentplane/system_tests/k3s:baseline",
    ],
    recycle = True,
    suite = ":test_retained_failure_cleanup.py",
    tags = [
        "bench",
        "manual",
    ],
)
