[Unit]
Description=Prepare the Firecracker guest workspace for the harness user
RequiresMountsFor=/state/workspaces
Before=agentplane-environment-runtime.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/systemd-tmpfiles --create --prefix=/state/workspaces

[Install]
WantedBy=multi-user.target
