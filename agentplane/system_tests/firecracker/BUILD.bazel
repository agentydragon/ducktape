load("//devinfra/oci:defs.bzl", "oci_image_manifest")
load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_testonly = True)

filegroup(
    name = "boot_layout",
    srcs = ["@firecracker_boot_linux_amd64"],
    tags = ["manual"],
    visibility = ["//agentplane/system_tests:__subpackages__"],
)

oci_image_manifest(
    name = "images",
    images = {
        "//agentplane/firecracker:image": "git.allegedly.works/ducktape-ci/agentplane-firecracker-launcher:unset",
        ":boot_layout": "git.allegedly.works/ducktape-ci/agentplane-environment-firecracker:unset",
    },
    tags = ["manual"],
    visibility = ["//agentplane/system_tests:__subpackages__"],
)

py_library(
    name = "runtime",
    srcs = ["runtime.py"],
    deps = [
        "//agentplane/system_tests/driver:cluster",
        "//agentplane/system_tests/k3s:baseline",
        "//agentplane/system_tests/vm:guest_logs",
        "//agentplane/system_tests/vm:infrastructure",
        "//devinfra/testing:undeclared_outputs",
        "@pypi//kubernetes",
        "@pypi//tenacity",
    ],
)

py_library(
    name = "pytest_plugin",
    srcs = ["pytest_plugin.py"],
    visibility = ["//agentplane/system_tests:__subpackages__"],
    deps = [
        ":runtime",
        "//agentplane/system_tests/deployment:virtualization",
        "@pypi//pytest",
    ],
)

py_test(
    name = "test_runtime",
    srcs = ["test_runtime.py"],
    deps = [
        ":runtime",
        "//:conftest",
        "//agentplane/system_tests:conftest",
        "//agentplane/system_tests/k3s:baseline",
        "//agentplane/system_tests/vm:infrastructure",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
