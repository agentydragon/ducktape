load("//agentplane/system_tests/k3s:defs.bzl", "k3s_suite")
load("//devinfra/python:defs.bzl", "py_library")

# gazelle:map_kind py_test k3s_suite //agentplane/system_tests/k3s:defs.bzl

package(
    default_testonly = True,
    default_visibility = ["//agentplane:__subpackages__"],
)

# Bazel-built Debian guest and production launcher on the dedicated KVM worker.
k3s_suite(
    name = "test_firecracker",
    srcs = ["test_firecracker.py"],
    require_kvm = True,
    stack = "firecracker",
    deps = [
        "//:conftest",
        "//agentplane/app/testing:client",
        "//agentplane/runner_gateway/dispatcher:testing_client",
        "//agentplane/system_tests:conftest",
        "//agentplane/system_tests/driver:cluster",
        "//agentplane/system_tests/driver:sandbox",
        "//agentplane/system_tests/driver:scripted_upstream",
        "//agentplane/system_tests/scenarios:firecracker",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

# Each target starts exactly one stack. Per-test clients and Sandbox cleanup remain isolated.
k3s_suite(
    name = "test_pod",
    srcs = ["test_pod.py"],
    # Retained pool pairs and fresh cases can request 17,414 MiB and 8.24 CPUs together.
    exec_properties = {"EstimatedComputeUnits": "8"},
    stack = "pod",
    deps = [
        ":pod_cases",
        ":pod_runners",
        "//:conftest",
        "//agentplane/system_tests:conftest",
        "//agentplane/system_tests/driver:case_batch",
        "//agentplane/system_tests/driver:cluster",
        "//agentplane/system_tests/driver:dispatcher_transport",
        "//agentplane/system_tests/driver:scripted_upstream",
        "//util:net",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",
        "@pypi//pytest_bazel",
    ],
)

