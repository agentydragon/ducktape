load("//agentplane/system_tests:defs.bzl", "k3s_suite")
load("//devinfra/python:defs.bzl", "py_library")

# gazelle:map_kind py_test k3s_suite //agentplane/system_tests:defs.bzl

package(
    default_testonly = True,
    default_visibility = ["//agentplane:__subpackages__"],
)

# Each target starts exactly one stack. Per-test clients and Sandbox cleanup remain isolated.
k3s_suite(
    name = "test_pod",
    srcs = ["test_pod.py"],
    stack = "pod",
    deps = [
        ":conftest",
        "//:conftest",
        "//agentplane/app/testing:client",
        "//agentplane/system_tests:agent",
        "//agentplane/system_tests:cluster",
        "//agentplane/system_tests:conftest",
        "//agentplane/system_tests:executor",
        "//agentplane/system_tests:harness_pair",
        "//agentplane/system_tests:sandbox",
        "//agentplane/system_tests:scripted_upstream",
        "//agentplane/system_tests/scenarios:agent_messaging",
        "//agentplane/system_tests/scenarios:egress",
        "//agentplane/system_tests/scenarios:launch_presets",
        "//agentplane/system_tests/scenarios:runner_credentials",
        "//agentplane/system_tests/scenarios:session_instructions",
        "//agentplane/system_tests/scenarios:storage",
        "//agentplane/system_tests/scenarios:suspend_resume",
        "//agentplane/system_tests/scenarios:thread_stream",
        "@pypi//httpx",
        "@pypi//protobuf",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

# This suite scales the Dispatcher and deletes controller Pods; it needs its own stack.
k3s_suite(
    name = "test_dispatcher",
    srcs = ["test_dispatcher.py"],
    stack = "pod",
    deps = [
        ":conftest",
        "//:conftest",
        "//agentplane/system_tests:cluster",
        "//agentplane/system_tests:conftest",
        "//agentplane/system_tests/k3s:stack",
        "//agentplane/system_tests/scenarios:dispatcher",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

