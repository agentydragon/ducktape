# Give the larger worker a distinct precompile output path: exec properties also
# affect PyCompile, so one source cannot produce the same .pyc with two resource keys.
genrule(
    name = "vm_spike_large_src",
    srcs = ["test_vm.py"],
    outs = ["test_vm_spike_large.py"],
    cmd = "cp $(location test_vm.py) $@",
    tags = ["manual"],
)

k3s_suite(
    name = "test_vm_spike_large",
    srcs = ["test_vm_spike_large.py"],
    boot_evidence = True,
