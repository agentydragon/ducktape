# Batch the first three independent Actions cases in two slots; keep OAuth linkage serial.
k3s_suite(
    name = "test_actions",
    srcs = ["test_actions.py"],
    environment_tools = "harnesses",
    stack = "mcp",
    deps = [
        ":conftest",
        "//:conftest",
        "//agentplane/app/testing:client",
        "//agentplane/proto:session_pb2",
        "//agentplane/runner_gateway/dispatcher:testing_client",
        "//agentplane/system_tests:conftest",
        "//agentplane/system_tests/deployment:stack",
        "//agentplane/system_tests/driver:case_batch",
        "//agentplane/system_tests/driver:cluster",
        "//agentplane/system_tests/driver:dispatcher_transport",
        "//agentplane/system_tests/driver:harness_pair",
        "//agentplane/system_tests/driver:operator_login",
        "//agentplane/system_tests/driver:sandbox",
        "//agentplane/system_tests/driver:scenario",
        "//agentplane/system_tests/driver:scripted_upstream",
        "//agentplane/system_tests/driver:tracing",
        "//agentplane/system_tests/scenarios:mcp",
        "//util:net",
        "@pypi//httpx",
        "@pypi//protobuf",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",
        "@pypi//pytest_bazel",
    ],
)

