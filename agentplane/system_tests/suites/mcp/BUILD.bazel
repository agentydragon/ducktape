# Each OAuth harness owns its linkage; all five cases share two bounded slots.
py_test(
    name = "test_actions",
    size = "enormous",
    srcs = ["test_actions.py"],
    args = [
        "-o",
        "junit_duration_report=call",
        "--durations=0",
    ],
    data = [
        "//agentplane/crds",
        K3S_BINARY,
        ":mcp_image_manifest",
        "//agentplane/system_tests/k3s/pki:trust_manager_install_yaml",
        "//agentplane/system_tests/suites:mcp_manifests.json",
        "@cert_manager_v1_21_2_release//file",
    ],
    env = {
        "K3S_BINARY_RLOCATION": K3S_BINARY_RLOCATION,
        "CERT_MANAGER_INSTALL_RLOCATION": "$(rlocationpath @cert_manager_v1_21_2_release//file)",
