#!/usr/bin/busybox sh
set -eu

# The suite selects this on one existing VM boot. Keep private supervisor fault injection out
# of Runner's public protocol, and avoid an additional guest image or VM just to run it.
case " $(cat /proc/cmdline) " in
    *" agentplane.supervision-checks=1 "*) /usr/sbin/agentplane-supervision-check ;;
esac

# KubeVirt's virtiofs Secret mount cannot set a file mode. The production guest protects it with a
# root-only parent; prove the native-agent account (uid 107) cannot read the runner's private key.
test -r /run/agentplane/environment-runtime-tls/tls.key
if systemd-run --quiet --wait --collect --uid=107 --gid=107 \
	--unit="agentplane-runner-key-check-$$.service" \
	/bin/sh -c 'test -r "$1" && exit 42; exit 0' sh /run/agentplane/environment-runtime-tls/tls.key; then
	:
else
	result=$?
	if [ "$result" -eq 42 ]; then
		echo "native agent can read the runner TLS private key" >&2
	else
		echo "cannot verify runner TLS private key isolation (systemd-run exited $result)" >&2
	fi
	exit 1
fi

exec /run/agentplane/environment/bin/agentplane-environment-runtime --config /run/agentplane/config/environment-runtime.json --launch-file /run/agentplane/sandbox/launch.json
