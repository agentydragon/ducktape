[Unit]
Description=Record pending guest shutdown jobs and PID 1 kernel state
DefaultDependencies=no
IgnoreOnIsolate=yes

[Service]
Type=exec
RuntimeDirectory=agentplane-shutdown-watchdog
ExecStartPre=/usr/bin/busybox mkfifo /run/agentplane-shutdown-watchdog/request
ExecStart=/usr/sbin/agentplane-shutdown-watchdog
StandardOutput=tty
StandardError=tty
TTYPath=/dev/ttyS0

[Install]
WantedBy=sysinit.target
