load("@rules_oci//oci:defs.bzl", "oci_image")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//agentplane/system_tests/k3s:defs.bzl", "K3S_EXEC_PROPERTIES")
load("//devinfra/erofs:defs.bzl", "erofs_image")

package(
    default_testonly = True,
    default_visibility = ["//agentplane:__subpackages__"],
)

py_library(
    name = "configuration",
    srcs = ["configuration.py"],
    deps = ["//agentplane/env:config"],
)

py_library(
    name = "supervision",
    srcs = ["supervision.py"],
    deps = [
        ":configuration",
        "//agentplane/app/testing:client",
        "//agentplane/proto:session_pb2",
        "//agentplane/runner_gateway/dispatcher:testing_client",
        "//agentplane/system_tests/driver:agent",
        "//agentplane/system_tests/driver:session_setup",
        "@pypi//protobuf",
    ],
)

# Keep the VM-only supervision fixture off the Debian guest-root dependency path.
pkg_files(
    name = "supervision_fixture_file",
    srcs = ["//agentplane/env/runtime/supervision:environment_runtime_systemd_fixture"],
    attributes = pkg_attributes(mode = "0755"),
    renames = {"//agentplane/env/runtime/supervision:environment_runtime_systemd_fixture": "environment-runtime-systemd-fixture"},
)

pkg_tar(
    name = "supervision_fixture_bin",
    srcs = [":supervision_fixture_file"],
    package_dir = "/bin",
)

pkg_tar(
    name = "test_runner_disk_bin",
    deps = [
        ":supervision_fixture_bin",
        "//agentplane/env/images:disk_bin",
    ],
)

erofs_image(
    name = "test_runner_disk_erofs",
    out = "test-runner.img",
    tar = ":test_runner_disk_bin",
    volume_label = "agentplane",
)

pkg_tar(
    name = "test_runner_disk_img",
    srcs = [":test_runner_disk_erofs"],
    mode = "0644",
    owner = "107.107",
    package_dir = "/disk",
    remap_paths = {"test-runner.img": "runner.img"},
)

oci_image(
    name = "test_runner_disk_image",
    architecture = "amd64",
    os = "linux",
    tars = [
        ":test_runner_disk_bin",
        ":test_runner_disk_img",
    ],
    user = "107:107",
)

py_library(
    name = "block_storage",
    testonly = True,
    srcs = ["block_storage.py"],
    visibility = ["//agentplane/system_tests:__subpackages__"],
    deps = [
        "//agentplane/system_tests/driver:cluster",
        "@pypi//kubernetes_asyncio",
    ],
)

py_library(
    name = "sandboxes",
    srcs = ["sandboxes.py"],
    deps = [
        ":configuration",
        "@pypi//more_itertools",
