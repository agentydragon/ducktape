load("//devinfra/python:defs.bzl", "py_library")

package(
    default_testonly = True,
    default_visibility = ["//agentplane:__subpackages__"],
)

py_library(
    name = "gateway_process",
    srcs = ["gateway_process.py"],
    data = ["//agentplane/session_dispatcher/cmd:sessions"],
    deps = [
        "//agentplane/environments/testing:environment_service_process",
        "//agentplane/identity/auth:listener",
        "//agentplane/net/peertls:config",
        "//agentplane/policy_controller/testing:policy_controller_process",
        "//agentplane/session_dispatcher:client",
        "//agentplane/session_dispatcher:settings",
        "//agentplane/testing:go_process",
        "//agentplane/testing:tls",
        "//devinfra/testing:undeclared_outputs",
        "//util:db_url",
        "//util:net",
        "@pypi//grpcio",
        "@pypi//protobuf",
        "@pypi//pyyaml",
        "@pypi//types_protobuf",  # keep: mypy follows generated protobuf interfaces
        "@rules_python//python/runfiles",
    ],
)

py_library(
    name = "runner_server",
    srcs = ["runner_server.py"],
    deps = [
        "//agentplane/env/runtime/control:environment_runtime_pb2",
        "//agentplane/net/peertls:config",
        "//agentplane/proto:environment_runtime_state_pb2",
        "@pypi//cryptography",
        "@pypi//grpcio",
        "@pypi//protobuf",
        "@pypi//types_protobuf",  # keep: mypy follows generated protobuf interfaces
    ],
)
