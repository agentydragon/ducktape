load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//agentplane:__subpackages__"])

go_library(
    name = "wake",
    srcs = [
        "budget.go",
        "manager.go",
    ],
    importpath = "github.com/agentydragon/ducktape/agentplane/session_dispatcher/dispatcher/wake",
    deps = [
        "//agentplane/environments/lifecycle",
        "//agentplane/identity/auth",
        "//agentplane/proto:environment_lifecycle_go_proto",
        "@io_k8s_sigs_controller_runtime//pkg/client",
    ],
)

go_test(
    name = "manager_test",
    srcs = ["manager_test.go"],
    embed = [":wake"],
    deps = [
        "//agentplane/environments/lifecycle",
        "//agentplane/proto:identity_go_proto",
    ],
)
