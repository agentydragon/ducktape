load("@aspect_rules_py//py:defs.bzl", aspect_py_binary = "py_binary")
load("@rules_oci//oci:defs.bzl", "oci_image")
load("//devinfra/oci:py_image.bzl", "py_image_entrypoint", "py_image_env", "shared_py_image_layers")
load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//agentplane/session_dispatcher:__subpackages__"])

py_library(
    name = "database_migrate",
    srcs = ["database_migrate.py"],
    data = ["//agentplane/session_dispatcher/migrations:files"],
    visibility = [
        "//agentplane/notification_service:__pkg__",
        "//agentplane/runner_gateway/go/migrations:__pkg__",
        "//agentplane/session_dispatcher:__subpackages__",
    ],
    deps = [
        ":db",
        "//util:db_migrations",
        "@pypi//pydantic_settings",
    ],
)

py_library(
    name = "db",
    srcs = ["db.py"],
    deps = [
        ":models",
        "//agentplane/proto:command_pb2",
        "//agentplane/proto:event_log_pb2",
        "//agentplane/proto:runner_pb2",
        "//util:sqlalchemy_protobuf",
        "//util:sqlalchemy_types",
        "@pypi//protobuf",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "models",
    srcs = ["models.py"],
)

py_library(
    name = "settings",
    srcs = ["settings.py"],
    visibility = [
        "//agentplane/session_dispatcher:__subpackages__",
        "//cluster/cdk8s/agentplane:__pkg__",
    ],
    deps = [
        "//agentplane:log_levels",
        "//agentplane:subjects",
        "//util:yaml_file_settings",
        "@pypi//pydantic",
        "@pypi//pydantic_settings",
    ],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    deps = [
        ":database_migrate",
        "//util/testing:postgres_fixtures",
        "@pypi//psycopg",
    ],
)

py_test(
    name = "test_database_migrate",
    size = "medium",
    srcs = ["test_database_migrate.py"],
    requires_docker = True,
    deps = [
        ":conftest",
        ":database_migrate",
        "//:conftest",
        "@pypi//alembic",
        "@pypi//psycopg",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)

py_binary(
    name = "migrate",
    main_module = "agentplane.session_dispatcher.database_migrate",
    deps = [":database_migrate"],
)

aspect_py_binary(
    name = "migration_image_bin",
    main = "database_migrate.py",
    deps = [":database_migrate"],
)

migration_layers_oci_tars = shared_py_image_layers(
    name = "migration_layers",
    binary = ":migration_image_bin",
    group = "1000",
    owner = "1000",
)

oci_image(
    name = "migration_image",
    base = "@debian_trixie_slim_linux_amd64",
    entrypoint = py_image_entrypoint("migration_image_bin"),
    env = py_image_env(binary_name = "migration_image_bin"),
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = migration_layers_oci_tars,
    user = "1000:1000",
    visibility = ["//visibility:public"],
)
