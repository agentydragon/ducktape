py_binary(
    name = "server",
    main_module = "agentplane.session_dispatcher.main",
    deps = [":main"],
)

aspect_py_binary(
    name = "server_image_bin",
    main = "main.py",
    deps = [":main"],
)

py_image_layer(
    name = "server_layers",
    binary = ":server_image_bin",
    group = "1000",
    owner = "1000",
)

oci_image(
    name = "image",
    base = "@debian_trixie_slim_linux_amd64",
    entrypoint = py_image_entrypoint("server_image_bin"),
    env = py_image_env(binary_name = "server_image_bin"),
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [":server_layers"],
    user = "1000:1000",
    visibility = ["//visibility:public"],
)

py_binary(
    name = "migrate",
    main_module = "agentplane.session_dispatcher.database_migrate",
    deps = [":database_migrate"],
)

aspect_py_binary(
    name = "migration_image_bin",
    main = "database_migrate.py",
    deps = [":database_migrate"],
)

py_image_layer(
    name = "migration_layers",
    binary = ":migration_image_bin",
    group = "1000",
    owner = "1000",
)

oci_image(
    name = "migration_image",
    base = "@debian_trixie_slim_linux_amd64",
    entrypoint = py_image_entrypoint("migration_image_bin"),
    env = py_image_env(binary_name = "migration_image_bin"),
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [":migration_layers"],
    user = "1000:1000",
    visibility = ["//visibility:public"],
)

