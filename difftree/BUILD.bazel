# gazelle:python_library_naming_convention $package_name$_lib
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("//tools/lint:linters.bzl", "ruff_test")

py_library(
    name = "difftree_lib",
    srcs = [
        "__init__.py",
        "__main__.py",
        "config.py",
        "diff_tree.py",
        "parser.py",
        "progress_bar.py",
        "tree.py",
    ],
    imports = [".."],
    visibility = ["//visibility:public"],
    deps = [
        "@pypi//click",
        "@pypi//rich",
        "@pypi//unidiff",
    ],
)

py_binary(
    name = "difftree",
    srcs = ["__main__.py"],
    main = "__main__.py",
    visibility = ["//:__subpackages__"],
    deps = [
        "@pypi//click",
        "@pypi//rich",
    ],
)

py_test(
    name = "test_all",
    srcs = [
        "conftest.py",
        "test_cli.py",
        "test_config.py",
