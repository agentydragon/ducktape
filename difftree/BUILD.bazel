        "test_e2e.py",
        "test_parser.py",
        "test_progress_bar.py",
        "test_snapshots.py",
        "test_tree.py",
    ],
    data = ["__snapshots__/test_snapshots.ambr"],
    imports = [".."],
    main = "test_diff_tree.py",
    deps = [
        ":difftree_lib",
        "@pypi//click",
        "@pypi//pyhamcrest",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",  # keep
        "@pypi//pytest_bazel",
        "@pypi//rich",
        "@pypi//syrupy",
    ],
)

