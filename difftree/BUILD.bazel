load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

py_library(
    name = "progress_bar",
    srcs = ["progress_bar.py"],
    deps = ["@pypi//rich"],
)

py_library(
    name = "parser",
    srcs = ["parser.py"],
    deps = ["@pypi//unidiff"],
)

py_library(
    name = "config",
    srcs = ["config.py"],
    deps = [":progress_bar"],
)

py_library(
    name = "tree",
    srcs = ["tree.py"],
    deps = [
        ":config",
        ":parser",
    ],
)

py_library(
    name = "diff_tree",
    srcs = ["diff_tree.py"],
    deps = [
        ":config",
        ":progress_bar",
        ":tree",
        "@pypi//more_itertools",
        "@pypi//rich",
    ],
)

py_library(
    name = "cli",
    srcs = ["cli.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":config",
        ":diff_tree",
        ":parser",
        ":tree",
        "@pypi//click",
        "@pypi//rich",
    ],
)

py_binary(
    name = "difftree",
    main_module = "difftree.cli",
    deps = [":cli"],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    deps = [
        ":config",
        ":diff_tree",
        ":parser",
        ":progress_bar",
        ":tree",
        "@pypi//pytest",
        "@pypi//rich",
    ],
)

py_test(
    name = "test_cli",
    srcs = ["test_cli.py"],
    deps = [
        ":cli",
        ":conftest",
        "@pypi//click",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_config",
    srcs = ["test_config.py"],
    deps = [
        ":config",
        ":conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_diff_tree",
    srcs = ["test_diff_tree.py"],
    deps = [
        ":config",
        ":conftest",
        ":diff_tree",
        ":parser",
        ":progress_bar",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//rich",
    ],
)

py_test(
    name = "test_e2e",
    srcs = ["test_e2e.py"],
    deps = [
        ":config",
        ":conftest",
        ":parser",
        ":tree",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_parser",
    srcs = ["test_parser.py"],
    deps = [
        ":conftest",
        ":parser",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_progress_bar",
    srcs = ["test_progress_bar.py"],
    deps = [
        ":conftest",
        ":progress_bar",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_snapshots",
    srcs = ["test_snapshots.py"],
    data = ["__snapshots__/test_snapshots.ambr"],
    uses_syrupy = True,
    deps = [
        ":config",
        ":conftest",
        ":parser",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//syrupy",
    ],
)

py_test(
    name = "test_tree",
    srcs = ["test_tree.py"],
    deps = [
        ":config",
        ":conftest",
        ":parser",
        ":tree",
        "@pypi//pyhamcrest",
        "@pypi//pytest_bazel",
    ],
)
