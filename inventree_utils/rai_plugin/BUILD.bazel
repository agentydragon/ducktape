# gazelle:ignore
# InvenTree plugin - requires Django from InvenTree environment (not in @pypi)

load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_python//python:packaging.bzl", "py_wheel")
load("//devinfra/oci:defs.bzl", "oci_layout_py")
load("//devinfra/python:defs.bzl", "py_library", "py_test")

py_library(
    name = "plugin",
    srcs = ["plugin.py"],
    tags = ["manual"],
)

py_wheel(
    name = "rai_plugin_wheel",
    distribution = "inventree_rai_plugin",
    entry_points = {
        "inventree_plugins": ["rai_plugin = rai_plugin.plugin:RaiPlugin"],
    },
    # Strip inventree_utils/ so wheel contains rai_plugin/plugin.py etc.
    strip_path_prefixes = ["inventree_utils/"],
    tags = ["manual"],
    version = "1.0.0",
    deps = [
        ":plugin",
        "//inventree_utils/rai_plugin/templatetags:custom_tags",
    ],
)

# Put both the pure-Python package and its entry-point metadata on sys.path.
# The directory lives in the image outside InvenTree's data volume.
_PLUGIN_DIR = "/opt/inventree-rai-plugin"

genrule(
    name = "rai_plugin_layer",
    srcs = [":rai_plugin_wheel"],
    outs = ["rai_plugin_layer.tar"],
    cmd = """
        DEST=$$(mktemp -d)
        SITE="$$DEST%s"
        mkdir -p "$$SITE"
        python3 -c "
import zipfile, sys
with zipfile.ZipFile(sys.argv[1]) as zf:
    zf.extractall(sys.argv[2])
" $(location :rai_plugin_wheel) "$$SITE"
        tar -C "$$DEST" -cf "$@" .
        rm -rf "$$DEST"
    """ % _PLUGIN_DIR,
)

oci_image(
    name = "image",
    base = "@inventree_stable_linux_amd64",
    env = {"PYTHONPATH": _PLUGIN_DIR},
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [":rai_plugin_layer"],
    visibility = ["//visibility:public"],
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["inventree-custom:latest"],
    visibility = ["//visibility:public"],
)

oci_layout_py(
    name = "test_image_layout",
    testonly = True,
    image = ":image",
)

py_test(
    name = "test_image",
    size = "medium",
    srcs = ["test_image.py"],
    requires_docker = True,
    tags = ["manual"],
    deps = [
        ":test_image_layout",
        "//devinfra/oci",
        "@pypi//pytest_bazel",
    ],
)
