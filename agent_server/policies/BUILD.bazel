"""Policies package - policy types, presets, and standalone policy programs."""

load("@rules_python//python:defs.bzl", "py_binary", "py_library")

py_library(
    name = "policies",
    srcs = [
        "approve_all.py",
        "default_policy.py",
        "loader.py",
        "policy_types.py",
        "presets.py",
        "scaffold.py",
    ],
    imports = ["../.."],
    visibility = ["//agent_server:__subpackages__"],
    deps = [
        "//mcp_infra:prefix",  # for constants, naming
        "@pypi//pydantic",
    ],
)

py_library(
    name = "approve_all_lib",
    srcs = ["approve_all.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":policy_types",
        ":scaffold",
    ],
)

py_binary(
    name = "approve_all",
    srcs = ["approve_all.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":policy_types",
        ":scaffold",
    ],
)

py_binary(
    name = "default_policy",
    srcs = ["default_policy.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":policy_types",
        ":scaffold",
        "//mcp_infra:prefix",
    ],
)

py_library(
    name = "loader",
    srcs = ["loader.py"],
    visibility = ["//:__subpackages__"],
)

py_library(
    name = "policy_types",
    srcs = ["policy_types.py"],
    visibility = ["//:__subpackages__"],
    deps = ["@pypi//pydantic"],
)

py_binary(
    name = "presets",
    srcs = ["presets.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":approve_all_lib",
        ":scaffold",
    ],
)

py_library(
    name = "scaffold",
    srcs = ["scaffold.py"],
    visibility = ["//:__subpackages__"],
)
