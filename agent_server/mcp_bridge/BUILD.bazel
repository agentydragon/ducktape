"""MCP Bridge - two-compositor architecture for agent-MCP integration."""

load("@rules_python//python:defs.bzl", "py_library", "py_test")

py_library(
    name = "mcp_bridge",
    srcs = [
        "agents.py",
        "auth.py",
        "compositor_factory.py",
        "registry.py",
    ],
    imports = ["../.."],
    visibility = ["//agent_server:__subpackages__"],
    deps = [
        "//agent_server/persist",
        "//agent_server/runtime",
        "//mcp_infra",
        "//mcp_infra/compositor",
        "//mcp_infra/enhanced",
        "//openai_utils",
        "@pypi//aiodocker",
        "@pypi//fastapi",
        "@pypi//fastmcp",
        "@pypi//pydantic",
        "@pypi//pyyaml",
        "@pypi//types_pyyaml",
    ],
)

py_test(
    name = "test_agents_server",
    srcs = ["test_agents_server.py"],
    imports = ["../.."],
    deps = [
        ":mcp_bridge",
        "//agent_server:conftest",
        "//agent_server/persist",
        "//agent_server/testing",
        "@pypi//fastapi",
        "@pypi//fastmcp",
        "@pypi//pyhamcrest",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",
        "@pypi//pytest_bazel",
        "@pypi//starlette",
    ],
)

py_test(
    name = "test_integration",
    srcs = ["test_integration.py"],
    data = ["//mcp_infra/testing:python_slim_load"],
    imports = ["../.."],
    tags = ["requires_docker"],
    deps = [
        ":mcp_bridge",
        "//agent_server:conftest",
        "//agent_server/persist",
        "//agent_server/testing",
        "@pypi//docker",
        "@pypi//fastapi",
        "@pypi//fastmcp",
        "@pypi//pyhamcrest",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",
        "@pypi//pytest_bazel",
        "@pypi//starlette",
    ],
)
