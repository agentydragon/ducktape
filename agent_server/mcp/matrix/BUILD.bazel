"""MCP Matrix server - Matrix chat integration."""

load("@rules_python//python:defs.bzl", "py_library")

py_library(
    name = "matrix",
    srcs = [
        "control.py",
        "server.py",
    ],
    imports = ["../../.."],
    visibility = ["//agent_server:__subpackages__"],
    deps = [
        "//agent_server/server:types",
        "//mcp_infra/enhanced",
        "//openai_utils",
        "@pypi//fastmcp",
        "@pypi//mautrix",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "control",
    srcs = ["control.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//agent_server/server",
    ],
)

py_library(
    name = "server",
    srcs = ["server.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//agent_server/server",
        "//mcp_infra",
        "//openai_utils",
        "@pypi//aiohttp",
        "@pypi//fastmcp",
        "@pypi//mautrix",
        "@pypi//pydantic",
    ],
)
