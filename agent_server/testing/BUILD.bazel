        "//agent_server/mcp/chat",
        "//mcp_infra/stubs:server_stubs",
    ],
)

py_library(
    name = "fixtures",
    srcs = ["fixtures.py"],
    imports = ["../.."],
    visibility = ["//:__subpackages__"],
    deps = [
        "//agent_server/policies:policy_types",
        "//mcp_infra:naming",
        "//mcp_infra:prefix",
    ],
)

py_library(
    name = "helpers",
    srcs = ["helpers.py"],
    imports = ["../.."],
    visibility = ["//:__subpackages__"],
    deps = [
        "//net_util:net",
        "//openai_utils:model",
        "@pypi//uvicorn",
    ],
)

py_library(
    name = "typed_asserts",
    srcs = ["typed_asserts.py"],
    imports = ["../.."],
    visibility = ["//:__subpackages__"],
    deps = [
        "//agent_server/server:state",
        "@pypi//pyhamcrest",
    ],
