load("@aspect_rules_esbuild//esbuild:defs.bzl", "esbuild")
load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config")
load("@npm_ducktape//:defs.bzl", "npm_link_all_packages")
load("//devinfra/js:json_schema.bzl", "js_json_schema")
load("//devinfra/js:spa_bundle.bzl", "spa_bundle")
load("//devinfra/js:ts_library.bzl", "ts_library")
load("//devinfra/js:vitest.bzl", "check_vitest_specs", "vitest_config")
load("//util/testing/frontend_visual:py_visual_test.bzl", "py_visual_test")
load(":vitest.bzl", "airlock_vitest_test")

npm_link_all_packages(name = "node_modules")

TSCONFIG = ":tsconfig"

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
)

js_json_schema(
    name = "types",
    out = "types.d.ts",
    generator = "//airlock:export_schema_bin",
    visibility = ["//visibility:public"],
)

ts_library(
    name = "auth",
    srcs = ["auth.ts"],
    tsconfig = TSCONFIG,
)

ts_library(
    name = "api",
    srcs = ["api.ts"],
    tsconfig = TSCONFIG,
    deps = [
        ":auth",
        ":types",
    ],
)

ts_library(
    name = "OAuthProviders",
    srcs = ["OAuthProviders.tsx"],
    tsconfig = TSCONFIG,
    deps = [
        ":api",
        ":auth",
        ":types",
        "//:node_modules/@mantine/core",
        "//:node_modules/@mantine/hooks",
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//:node_modules/react-dom",
    ],
)

ts_library(
    name = "App",
    srcs = ["App.tsx"],
    tsconfig = TSCONFIG,
    deps = [
        ":OAuthProviders",
        ":api",
        ":auth",
        ":types",
        "//:node_modules/@mantine/core",
        "//:node_modules/@mantine/hooks",
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//:node_modules/react-dom",
    ],
)

ts_library(
    name = "main",
    srcs = [
        "css.d.ts",
        "main.tsx",
    ],
    tsconfig = TSCONFIG,
    deps = [
        ":App",
        "//:node_modules/@mantine/core",
        "//:node_modules/@mantine/hooks",
        "//:node_modules/@types/react",
        "//:node_modules/@types/react-dom",
        "//:node_modules/react",
        "//:node_modules/react-dom",
    ],
)

spa_bundle(
    name = "bundle",
    entry_point = "main.js",
    jsx = "automatic",
    visibility = ["//airlock:__pkg__"],
    deps = [":main"],
)

# The scenario table: read by the harness (it mounts the scene `?page=` names) and by the sweep.
js_library(
    name = "visual_scenarios",
    testonly = True,
    srcs = ["harness/scenarios.json"],
)

ts_library(
    name = "visual_harness_lib",
    testonly = True,
    srcs = [
        "css.d.ts",
        "harness/harness.tsx",
    ],
    tsconfig = TSCONFIG,
    deps = [
        ":App",
        ":types",
        ":visual_scenarios",
        "//:node_modules/@mantine/core",
        "//:node_modules/@mantine/hooks",
        "//:node_modules/@types/react",
        "//:node_modules/@types/react-dom",
        "//:node_modules/react",
        "//:node_modules/react-dom",
    ],
)

airlock_vitest_test(
    name = "api_test",
    srcs = ["api.test.ts"],
    isolated_typecheck = True,
    deps = [
        ":api",
        "//:node_modules/vitest",
    ],
)

vitest_config(
    name = "vitest_config",
    environment = "node",
)

esbuild(
    name = "visual_harness_bundle",
    testonly = True,
    config = {"jsx": "automatic"},
    entry_point = "harness/harness.js",
    format = "iife",
    minify = False,
    output = "harness/dist/harness.js",
    output_css = "harness/dist/harness.css",
    platform = "browser",
    sourcemap = "linked",
    target = ["es2022"],
    deps = [":visual_harness_lib"],
)

filegroup(
    name = "visual_harness_js",
    testonly = True,
    srcs = ["harness/dist/harness.js"],
)

filegroup(
    name = "visual_harness_css",
    testonly = True,
    srcs = ["harness/dist/harness.css"],
)

py_visual_test(
    name = "visual",
    size = "small",
    assets = [
        "harness/index.html",
        ":visual_harness_css",
    ],
    harness = ":visual_harness_js",
    scenarios = "harness/scenarios.json",
    title = "Airlock",
)

check_vitest_specs()
