load("@aspect_rules_esbuild//esbuild:defs.bzl", "esbuild")
load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config")
load("@npm_ducktape//:defs.bzl", "npm_link_all_packages")
load("@npm_ducktape//:vitest/package_json.bzl", vitest_bin = "bin")
load("//devinfra/js:json_schema.bzl", "js_json_schema")
load("//devinfra/js:spa_bundle.bzl", "spa_bundle")
load("//devinfra/js:ts_library.bzl", "ts_library")
load("//util/testing/frontend_visual:visual_test.bzl", "visual_test")

npm_link_all_packages(name = "node_modules")

TSCONFIG = ":tsconfig"

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
)

js_json_schema(
    name = "types",
    out = "types.d.ts",
    generator = "//airlock:export_schema_bin",
    visibility = ["//visibility:public"],
)

ts_library(
    name = "auth",
    srcs = ["auth.ts"],
    tsconfig = TSCONFIG,
    deps = [":node_modules/oidc-client-ts"],
)

ts_library(
    name = "api",
    srcs = ["api.ts"],
    tsconfig = TSCONFIG,
    deps = [
        ":auth",
        ":types",
    ],
)

ts_library(
    name = "OAuthProviders",
    srcs = ["OAuthProviders.tsx"],
    tsconfig = TSCONFIG,
    deps = [
        ":api",
        ":types",
        "//:node_modules/@mantine/core",
        "//:node_modules/@mantine/hooks",
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//:node_modules/react-dom",
    ],
)

ts_library(
    name = "App",
    srcs = ["App.tsx"],
    tsconfig = TSCONFIG,
    deps = [
        ":OAuthProviders",
        ":api",
        ":types",
        "//:node_modules/@mantine/core",
        "//:node_modules/@mantine/hooks",
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//:node_modules/react-dom",
    ],
)

ts_library(
    name = "main",
    srcs = [
        "css.d.ts",
        "main.tsx",
    ],
    tsconfig = TSCONFIG,
    deps = [
        ":App",
        ":auth",
        "//:node_modules/@mantine/core",
        "//:node_modules/@mantine/hooks",
        "//:node_modules/@types/react",
        "//:node_modules/@types/react-dom",
        "//:node_modules/react",
        "//:node_modules/react-dom",
    ],
)

spa_bundle(
    name = "bundle",
    entry_point = "main.js",
    jsx = "automatic",
    visibility = ["//airlock:__pkg__"],
    deps = [":main"],
)

js_library(
    name = "visual_scenarios",
    testonly = True,
    srcs = [
        "visual/scenarios.mjs",
    ],
)

ts_library(
    name = "visual_harness_lib",
    testonly = True,
    srcs = [
        "css.d.ts",
        "visual/harness.tsx",
        "visual/scenarios.d.mts",
    ],
    tsconfig = TSCONFIG,
    deps = [
        ":App",
        ":types",
        ":visual_scenarios",
        "//:node_modules/@mantine/core",
        "//:node_modules/@mantine/hooks",
        "//:node_modules/@types/react",
        "//:node_modules/@types/react-dom",
        "//:node_modules/react",
        "//:node_modules/react-dom",
    ],
)

ts_library(
    name = "api_test",
    testonly = True,
    srcs = ["api.test.ts"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [
        ":api",
        "//:node_modules/vitest",
    ],
)

ts_library(
    name = "auth_test",
    testonly = True,
    srcs = ["auth.test.ts"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [
        ":auth",
        "//:node_modules/vitest",
    ],
)

vitest_bin.vitest_test(
    name = "vitest_test",
    args = ["run"],
    chdir = package_name(),
    data = [
        "vitest.config.mjs",
        ":api_test",
        ":auth_test",
        "//:node_modules/happy-dom",
        "//:node_modules/vitest",
    ],
)

esbuild(
    name = "visual_harness_bundle",
    testonly = True,
    config = {"jsx": "automatic"},
    entry_point = "visual/harness.js",
    format = "iife",
    minify = False,
    output = "visual/dist/harness.js",
    output_css = "visual/dist/harness.css",
    platform = "browser",
    sourcemap = "linked",
    target = ["es2022"],
    deps = [":visual_harness_lib"],
)

filegroup(
    name = "visual_harness_js",
    testonly = True,
    srcs = ["visual/dist/harness.js"],
)

filegroup(
    name = "visual_harness_css",
    testonly = True,
    srcs = ["visual/dist/harness.css"],
)

visual_test(
    name = "visual",
    size = "small",
    assets = [
        "visual/index.html",
        ":visual_harness_css",
    ],
    entry_point = "visual/runner.mjs",
    harness = ":visual_harness_js",
    scenarios = ":visual_scenarios",
)
