load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library", "js_run_binary")
load("@npm_ducktape//:defs.bzl", "npm_link_all_packages")
load("//devinfra/js:json_schema.bzl", "js_json_schema")
load(":defs.bzl", "visual_test_matrix")

npm_link_all_packages(name = "node_modules")

# ── Per-file source libraries ──────────────────────────────────────────────────

js_library(
    name = "auth",
    srcs = ["auth.ts"],
    deps = [":node_modules"],
)

js_library(
    name = "mcp",
    srcs = ["mcp.ts"],
    deps = [
        ":auth",
        ":node_modules",
        ":types",
    ],
)

js_json_schema(
    name = "types",
    out = "types.d.ts",
    generator = "//airlock:export_schema_bin",
    visibility = ["//visibility:public"],
)

js_library(
    name = "ActionList",
    srcs = ["ActionList.svelte"],
    deps = [":types"],
)

js_library(
    name = "ActionDetail",
    srcs = ["ActionDetail.svelte"],
    deps = [
        ":mcp",
        ":types",
    ],
)

js_library(
    name = "App",
    srcs = ["App.svelte"],
    deps = [
        ":ActionDetail",
        ":ActionList",
        ":mcp",
        ":types",
    ],
)

js_library(
    name = "app",
    srcs = [
        "app.css",
        "main.ts",
    ],
    deps = [
        ":App",
        ":auth",
    ],
)

# ── Production bundle ──────────────────────────────────────────────────────────

_BUNDLE_CONFIG = [
    "esbuild.config.mjs",
    "index.html",
    "svelte.config.js",
    "tsconfig.json",
]

js_binary(
    name = "build_bundle",
    data = _BUNDLE_CONFIG + [
        ":app",
        ":node_modules",
    ],
    entry_point = "esbuild.config.mjs",
)

js_run_binary(
    name = "bundle",
    srcs = _BUNDLE_CONFIG + [":app"],
    outs = [
        "dist/index.html",
        "dist/main.css",
        "dist/main.css.map",
        "dist/main.js",
        "dist/main.js.map",
    ],
    args = ["dist"],
    chdir = package_name(),
    tool = ":build_bundle",
    visibility = ["//airlock:__pkg__"],
)

# ── Visual test harness ────────────────────────────────────────────────────────

js_library(
    name = "harness_lib",
    srcs = [
        "tests/harness/HarnessIndex.svelte",
        "tests/harness/harness.ts",
        "tests/harness/index.html",
    ],
    tags = ["no-lint"],
    deps = [":app"],
)

js_binary(
    name = "build_harness",
    data = [
        "tests/harness/esbuild.config.mjs",
        ":harness_lib",
        ":node_modules",
    ],
    entry_point = "tests/harness/esbuild.config.mjs",
)

js_run_binary(
    name = "harness_bundle",
    srcs = [
        "tests/harness/esbuild.config.mjs",
        ":harness_lib",
    ],
    outs = [
        "tests/harness/dist/harness.css",
        "tests/harness/dist/harness.js",
    ],
    args = ["tests/harness/dist"],
    chdir = package_name(),
    tool = ":build_harness",
)

filegroup(
    name = "harness_js",
    srcs = ["tests/harness/dist/harness.js"],
)

filegroup(
    name = "visual_test_assets",
    srcs = ["tests/harness/index.html"],
)

# ── Visual tests (page x viewport x theme matrix) ────────────────────────────

visual_test_matrix(
    pages = [
        "ListPage",
        "DetailPage",
    ],
)
