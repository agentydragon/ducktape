load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library", "js_run_binary")
load("@npm_ducktape//:defs.bzl", "npm_link_all_packages")
load("//devinfra/js:json_schema.bzl", "js_json_schema")
load("//devinfra/js:spa_bundle.bzl", "spa_bundle")
load(":defs.bzl", "visual_test_matrix")

npm_link_all_packages(name = "node_modules")

# ── Per-file source libraries ──────────────────────────────────────────────────

js_library(
    name = "auth",
    srcs = ["auth.ts"],
    deps = [":node_modules"],
)

js_library(
    name = "api",
    srcs = ["api.ts"],
    deps = [
        ":auth",
        ":types",
    ],
)

js_json_schema(
    name = "types",
    out = "types.d.ts",
    generator = "//airlock:export_schema_bin",
    visibility = ["//visibility:public"],
)

js_library(
    name = "ActionList",
    srcs = ["ActionList.svelte"],
    deps = [":types"],
)

js_library(
    name = "ActionDetail",
    srcs = ["ActionDetail.svelte"],
    deps = [
        ":api",
        ":types",
    ],
)

js_library(
    name = "BackendStatus",
    srcs = ["BackendStatus.svelte"],
    deps = [
        ":api",
        ":types",
    ],
)

js_library(
    name = "OAuthProviders",
    srcs = ["OAuthProviders.svelte"],
    deps = [
        ":api",
        ":auth",
        ":types",
    ],
)

js_library(
    name = "App",
    srcs = ["App.svelte"],
    deps = [
        ":ActionDetail",
        ":ActionList",
        ":BackendStatus",
        ":OAuthProviders",
        ":api",
        ":types",
    ],
)

js_library(
    name = "app",
    srcs = [
        "app.css",
        "main.ts",
    ],
    deps = [
        ":App",
        ":auth",
        ":node_modules/svelte",
    ],
)

# ── Production bundle ──────────────────────────────────────────────────────────

# Svelte + Tailwind plugins for the native esbuild() rule (see spa_bundle).
js_library(
    name = "esbuild_config",
    srcs = ["esbuild_config.mjs"],
    deps = [
        ":node_modules/esbuild-plugin-tailwindcss",
        ":node_modules/esbuild-svelte",
        ":node_modules/svelte",
        ":node_modules/tailwindcss",
    ],
)

spa_bundle(
    name = "bundle",
    config = ":esbuild_config",
    entry_point = "main.ts",
    visibility = ["//airlock:__pkg__"],
    deps = [":app"],
)

# ── Visual test harness ────────────────────────────────────────────────────────

js_library(
    name = "harness_lib",
    srcs = [
        "tests/harness/HarnessIndex.svelte",
        "tests/harness/harness.ts",
        "tests/harness/index.html",
    ],
    tags = ["no-lint"],
    deps = [":app"],
)

js_binary(
    name = "build_harness",
    data = [
        "tests/harness/esbuild.config.mjs",
        ":harness_lib",
        ":node_modules",
    ],
    entry_point = "tests/harness/esbuild.config.mjs",
)

js_run_binary(
    name = "harness_bundle",
    srcs = [
        "tests/harness/esbuild.config.mjs",
        ":harness_lib",
    ],
    outs = [
        "tests/harness/dist/harness.css",
        "tests/harness/dist/harness.js",
    ],
    args = ["tests/harness/dist"],
    chdir = package_name(),
    tool = ":build_harness",
)

filegroup(
    name = "harness_js",
    srcs = ["tests/harness/dist/harness.js"],
)

filegroup(
    name = "visual_test_assets",
    srcs = ["tests/harness/index.html"],
)

# ── Visual tests (page x viewport x theme matrix) ────────────────────────────

visual_test_matrix(
    pages = [
        "ListPage",
        "DetailPage",
        "BackendsPage",
        "OAuthPage",
    ],
)
