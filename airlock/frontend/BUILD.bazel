# gazelle:exclude test_visual.py
load("@aspect_rules_esbuild//esbuild:defs.bzl", "esbuild")
load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config")
load("@npm_ducktape//:defs.bzl", "npm_link_all_packages")
load("//devinfra/js:json_schema_typescript.bzl", "json_schema_typescript")
load("//devinfra/js:spa_bundle.bzl", "spa_bundle")
load("//devinfra/js:ts_library.bzl", "ts_library")
load("//devinfra/js:typed_eslint.bzl", "typed_eslint_test")
load("//devinfra/js:vitest.bzl", "check_vitest_specs", "vitest_config")
load("//util/testing/frontend_visual:py_visual_test.bzl", "py_visual_test")
load(":vitest.bzl", "airlock_vitest_test")

npm_link_all_packages(name = "node_modules")

TSCONFIG = ":tsconfig"

filegroup(
    name = "typed_lint_srcs",
    srcs = glob(
        [
            "*.ts",
            "*.tsx",
            "**/*.ts",
            "**/*.tsx",
        ],
        allow_empty = True,
    ),
)

filegroup(
    name = "typed_lint_program_data",
    srcs = [
        ":types",
        "//:node_modules/@mantine/core",
        "//:node_modules/@mantine/hooks",
        "//:node_modules/@types/react-dom",
    ],
)

typed_eslint_test(
    name = "eslint_typed_test",
    srcs = ":typed_lint_srcs",
    extra_data = [
        ":main",
        ":typed_lint_program_data",
    ],
    tsconfig = "tsconfig.json",
)

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
)

json_schema_typescript(
    name = "_types_typescript",
    out = "types.d.ts",
    schema = "//airlock:types_schema",
)

js_library(
    name = "types",
    srcs = [":_types_typescript"],
    visibility = ["//visibility:public"],
)

ts_library(
    name = "auth",
    srcs = ["auth.ts"],
    tsconfig = TSCONFIG,
)

ts_library(
    name = "api",
    srcs = ["api.ts"],
    tsconfig = TSCONFIG,
    deps = [
        ":auth",
        ":types",
    ],
)

ts_library(
    name = "OAuthProviders",
    srcs = ["OAuthProviders.tsx"],
    tsconfig = TSCONFIG,
    deps = [
        ":api",
        ":auth",
        ":types",
        "//:node_modules/@mantine/core",
        "//:node_modules/@mantine/hooks",
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//:node_modules/react-dom",
    ],
)

ts_library(
    name = "App",
    srcs = ["App.tsx"],
    tsconfig = TSCONFIG,
    deps = [
        ":OAuthProviders",
        ":api",
        ":auth",
        ":types",
        "//:node_modules/@mantine/core",
        "//:node_modules/@mantine/hooks",
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//:node_modules/react-dom",
    ],
)

ts_library(
    name = "main",
    srcs = [
        "main.tsx",
    ],
    tsconfig = TSCONFIG,
    deps = [
        ":App",
        "//:node_modules/@mantine/core",
        "//:node_modules/@mantine/hooks",
        "//:node_modules/@types/react",
        "//:node_modules/@types/react-dom",
        "//:node_modules/react",
        "//:node_modules/react-dom",
    ],
)

spa_bundle(
    name = "bundle",
    entry_point = "main.js",
    jsx = "automatic",
    visibility = ["//airlock:__pkg__"],
    deps = [":main"],
)

# The scenario table: read by the harness (it mounts the scene `?page=` names) and by the sweep.

ts_library(
    name = "visual_harness_lib",
    testonly = True,
    srcs = [
        "harness/harness.tsx",
    ],
    tsconfig = TSCONFIG,
    deps = [
        ":App",
        ":types",
        "//:node_modules/@mantine/core",
        "//:node_modules/@mantine/hooks",
        "//:node_modules/@types/react",
        "//:node_modules/@types/react-dom",
        "//:node_modules/react",
        "//:node_modules/react-dom",
    ],
)

airlock_vitest_test(
    name = "api_test",
    srcs = ["api.test.ts"],
    isolated_typecheck = True,
    deps = [
        ":api",
        "//:node_modules/vitest",
    ],
)

vitest_config(
    name = "vitest_config",
    environment = "node",
)

esbuild(
    name = "visual_harness_bundle",
    testonly = True,
    config = {"jsx": "automatic"},
    entry_point = "harness/harness.js",
    format = "iife",
    minify = False,
    output = "harness/dist/harness.js",
    output_css = "harness/dist/harness.css",
    platform = "browser",
    sourcemap = "linked",
    target = ["es2022"],
    deps = [":visual_harness_lib"],
)

filegroup(
    name = "visual_harness_js",
    testonly = True,
    srcs = ["harness/dist/harness.js"],
)

filegroup(
    name = "visual_harness_css",
    testonly = True,
    srcs = ["harness/dist/harness.css"],
)

py_visual_test(
    name = "visual",
    size = "small",
    assets = [
        "harness/index.html",
        ":visual_harness_css",
    ],
    harness = ":visual_harness_js",
    test_deps = [
        "//util/testing:viewports",
        "//util/testing:visual_capture",
        "@pypi//playwright",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",
        "@pypi//pytest_bazel",
    ],
    test_module = "airlock.frontend.test_visual",
    test_srcs = ["test_visual.py"],
    title = "Airlock",
)

check_vitest_specs()
