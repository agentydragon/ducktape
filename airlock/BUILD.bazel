load("@aspect_rules_py//py:defs.bzl", "py_image_layer", aspect_py_binary = "py_binary")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")
load("//props:oci.bzl", "py_image_entrypoint", "py_image_env")

py_library(
    name = "models",
    srcs = ["models.py"],
    visibility = ["//visibility:public"],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "export_schema",
    srcs = ["export_schema.py"],
    deps = [
        ":models",
        "@pypi//pydantic",
    ],
)

py_binary(
    name = "export_schema_bin",
    main_module = "airlock.export_schema",
    visibility = ["//airlock:__subpackages__"],
    deps = [":export_schema"],
)

py_library(
    name = "config",
    srcs = ["config.py"],
    visibility = ["//visibility:public"],
    deps = [
        "//airlock/oauth:provider",
        "@pypi//pydantic",
        "@pypi//pydantic_settings",
        "@pypi//pyyaml",
    ],
)

py_library(
    name = "deployment",
    srcs = ["deployment.py"],
    deps = [
        ":models",
        "//util:image_tag",
    ],
)

py_library(
    name = "app",
    srcs = ["app.py"],
    data = ["//airlock/frontend:bundle"],
    visibility = ["//visibility:public"],
    deps = [
        ":config",
        ":deployment",
        ":models",
        "//airlock/oauth:k8s_client",
        "//airlock/oauth:provider",
        "//airlock/oauth:refresh",
        "//airlock/oauth:routes",
        "@pypi//fastapi",
        "@pypi//fastmcp_slim",
        "@pypi//httpx",
        "@pypi//starlette",
        "@pypi//uvicorn",
    ],
)

py_binary(
    name = "server",
    main_module = "airlock.app",
    visibility = ["//visibility:public"],
    deps = [":app"],
)

aspect_py_binary(
    name = "server_bin",
    main = "app.py",
    deps = [":app"],
)

py_image_layer(
    name = "layers",
    binary = ":server_bin",
    group = "1000",
    owner = "1000",
)

oci_image(
    name = "image",
    base = "@debian_trixie_slim_linux_amd64",
    entrypoint = py_image_entrypoint("server_bin"),
    env = py_image_env(binary_name = "server_bin"),
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [":layers"],
    user = "1000:1000",
    visibility = ["//visibility:public"],
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["airlock:latest"],
    visibility = ["//visibility:public"],
)

py_test(
    name = "test_app_integration",
    srcs = ["test_app_integration.py"],
    deps = [
        ":app",
        ":config",
        "//:conftest",
        "//airlock/oauth:k8s_client",
        "//airlock/oauth:provider",
        "//util:net",
        "//util/testing:asgi",
        "@pypi//fastmcp_slim",
        "@pypi//httpx",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
