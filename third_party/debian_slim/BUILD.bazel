load("@rules_distroless//distroless:defs.bzl", "cacerts")
load("@rules_oci//oci:defs.bzl", "oci_load")

# Load debian-slim base image into local Docker daemon.
# bazel run //third_party/debian_slim:load for manual loading.
oci_load(
    name = "load",
    image = "@debian_slim_linux_amd64",
    repo_tags = ["debian-slim:test"],
    visibility = ["//visibility:public"],
)

# Single repo-level source of a generated /etc/ssl/certs/ca-certificates.crt bundle for
# distroless images. rules_distroless apt unpacks the ca-certificates deb but never runs
# update-ca-certificates, so its :flat layer ships only loose certs under
# /usr/share/ca-certificates and no bundle a system-trust client (C git/curl, libgit2)
# can read. The bundle is release-independent PEM, so this one target serves both
# bookworm- and trixie-based images. Add it to an oci_image's `tars` and set
# SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt.
# Usage guidance: STYLE.md § "System CA certificates in distroless images".
cacerts(
    name = "cacerts",
    package = "@ca_certificates_deb//:data.tar.xz",
    visibility = ["//visibility:public"],
)
