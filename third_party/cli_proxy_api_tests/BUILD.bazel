load("//devinfra/oci:defs.bzl", "oci_layout_py")
load("//devinfra/python:defs.bzl", "py_test")

oci_layout_py(
    name = "cli_proxy_api_image",
    image = "@ducktape_cli_proxy_api//:image",
)

py_test(
    name = "test_image",
    srcs = ["test_image.py"],
    data = [
        "@crane",
    ],
    requires_docker = True,
    deps = [
        "//:conftest",
        "//devinfra/oci",
        "//third_party/cli_proxy_api_tests:cli_proxy_api_image",
        "//util/testing:container_logs",
        "@pypi//httpx",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

test_suite(
    name = "tests",
    tests = [
        ":test_image",
        "@ducktape_cli_proxy_api//:tests",
    ],
)
