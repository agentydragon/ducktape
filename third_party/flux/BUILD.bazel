# Typed cdk8s Python constructs generated from Flux's upstream CRDs (fetched via
# MODULE.bazel's flux_*_crd http_files, never vendored). See cluster/docs/cdk8s.md.

# flux_kustomize/flux_helm/flux_source are generated at build time by cdk8s_import
# below, not pip packages -- gazelle can't resolve them from the requirements manifest.
# gazelle:resolve py flux_kustomize //third_party/flux:kustomization
# gazelle:resolve py flux_helm //third_party/flux:helmrelease
# gazelle:resolve py flux_source //third_party/flux:helmrepository

load("//devinfra/js:cdk8s_import.bzl", "cdk8s_import")
load("//devinfra/python:defs.bzl", "py_test")

cdk8s_import(
    name = "kustomization",
    crd = "@flux_kustomization_crd//file",
    module_name = "flux_kustomize",
    module_path = "io/fluxcd/toolkit/kustomize",
    visibility = ["//visibility:public"],
)

cdk8s_import(
    name = "helmrelease",
    crd = "@flux_helmrelease_crd//file",
    module_name = "flux_helm",
    module_path = "io/fluxcd/toolkit/helm",
    visibility = ["//visibility:public"],
)

cdk8s_import(
    name = "helmrepository",
    crd = "@flux_helmrepository_crd//file",
    module_name = "flux_source",
    module_path = "io/fluxcd/toolkit/source",
    visibility = ["//visibility:public"],
)

py_test(
    name = "test_kustomization_import",
    srcs = ["test_kustomization_import.py"],
    data = ["@nodejs_linux_amd64//:bin/node"],
    env = {"JSII_NODE": "$(rootpath @nodejs_linux_amd64//:bin/node)"},
    deps = [
        "//:conftest",
        "//third_party/flux:kustomization",
        "@pypi//cdk8s",
        "@pypi//pytest_bazel",
    ],
)
