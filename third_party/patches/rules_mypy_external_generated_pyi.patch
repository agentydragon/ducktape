+def _is_mypy_action_runfile(file, python_source_directories):
+    # Keep external plugin code, native modules, and package data. Retain a
+    # first-party directory only when PyInfo identifies it as a Python source.
+    if not file.owner or file.owner.workspace_root.startswith("external/"):
+        return True
+    if file.is_directory:
+        return python_source_directories == None or file in python_source_directories
+    return file.extension in ("py", "pyi") or file.basename == "py.typed"
