+def _is_mypy_action_runfile(file):
+    # External wheels may contain plugin code, native modules, and package data.
+    # First-party Python sources, stubs, and typed-package markers are sufficient
+    # for MYPYPATH; retain directory artifacts whose contents Bazel keeps opaque.
+    if not file.owner or file.owner.workspace_root.startswith("external/"):
+        return True
+    return file.is_directory or file.extension in ("py", "pyi") or file.basename == "py.typed"
