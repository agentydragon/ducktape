# Typed cdk8s Python constructs generated from prometheus-operator's upstream CRDs
# (fetched via MODULE.bazel's prometheus_operator_servicemonitor_crd http_file, never
# vendored). See cluster/docs/cdk8s.md.

# prometheus_operator_crds is generated at build time by cdk8s_import below, not a pip
# package -- gazelle can't resolve it from the requirements manifest.
# gazelle:resolve py prometheus_operator_crds //third_party/prometheus_operator:servicemonitor

load("//devinfra/js:cdk8s_import.bzl", "cdk8s_import")
load("//devinfra/python:defs.bzl", "py_test")

cdk8s_import(
    name = "servicemonitor",
    crd = "@prometheus_operator_servicemonitor_crd//file",
    module_name = "prometheus_operator_crds",
    module_path = "com/coreos/monitoring",
    visibility = ["//visibility:public"],
)

py_test(
    name = "test_servicemonitor_import",
    srcs = ["test_servicemonitor_import.py"],
    data = ["@nodejs_linux_amd64//:bin/node"],
    env = {"JSII_NODE": "$(rootpath @nodejs_linux_amd64//:bin/node)"},
    deps = [
        "//:conftest",
        "//third_party/prometheus_operator:servicemonitor",
        "@pypi//cdk8s",
        "@pypi//pytest_bazel",
    ],
)
