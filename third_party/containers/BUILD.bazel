    image = "@electric_1_8_1_linux_amd64",
    visibility = ["//visibility:public"],
)

oci_layout_py(
    name = "nginx_unprivileged",
    testonly = True,
    image = "@nginx_unprivileged_linux_amd64",
    visibility = ["//visibility:public"],
)

oci_layout_py(
