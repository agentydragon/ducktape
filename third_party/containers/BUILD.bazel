# Pre-built container images for Testcontainers-based tests.
#
# These images are bundled as Bazel deps so hermetic tests don't need Docker Hub
# access. Test fixtures load OCI layout dirs into the Docker daemon.
#
# Each image is one `py_library` carrying its `LAYOUT_RLOCATION` and the image itself,
# so a test names it once:
#
#     deps = ["//third_party/containers:postgres_18"]
#     from third_party.containers import postgres_18

load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files", "strip_prefix")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//devinfra/oci:defs.bzl", "oci_layout_py", "oci_layout_rloc")
load("//devinfra/python:defs.bzl", "RYUK_TAG", "py_library", "py_test")

py_test(
    name = "test_image_descriptor",
    srcs = ["test_image_descriptor.py"],
    deps = [
        "//:conftest",
        "//third_party/containers:debian_slim",
        "@pypi//pytest_bazel",
        "@rules_python//python/runfiles",
    ],
)

oci_layout_py(
    name = "grafana_visual",
    testonly = True,
    image = "@grafana_visual_linux_amd64",
    visibility = ["//visibility:public"],
)

oci_layout_py(
    name = "prometheus_visual",
    testonly = True,
    image = "@prometheus_visual_linux_amd64",
    visibility = ["//visibility:public"],
)

py_library(
    name = "fixtures",
    testonly = True,
    srcs = ["fixtures.py"],
    visibility = ["//visibility:public"],
    deps = [
        "//devinfra/oci",
        "//third_party/containers:debian_slim",
        "@pypi//pytest",
    ],
)

pkg_files(
    name = "postgres_entrypoint_files",
    testonly = True,
    srcs = ["@postgres_docker_entrypoint//file"],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "/usr/local/bin",
    strip_prefix = strip_prefix.files_only(),
)

pkg_files(
    name = "postgres_license_files",
    testonly = True,
    srcs = ["@postgres_docker_license//file"],
    prefix = "/usr/share/licenses/docker-postgres",
    strip_prefix = strip_prefix.files_only(),
)

pkg_tar(
    name = "postgres_test_startup",
    testonly = True,
    srcs = [
        ":postgres_entrypoint_files",
        ":postgres_license_files",
    ],
    empty_dirs = ["/docker-entrypoint-initdb.d"],
)

# CNPG runs as postgres (UID 26). Ephemeral test data lives in writable /tmp;
# initdb installs listen_addresses so command overrides (Electric) retain TCP access.
oci_image(
    name = "postgres_18_test_image",
    testonly = True,
    base = "@postgres_18_minimal_linux_amd64",
    cmd = ["postgres"],
    entrypoint = ["/usr/local/bin/docker-entrypoint.sh"],
    env = {
        "PGDATA": "/tmp/postgresql/data",
        "POSTGRES_INITDB_ARGS": "--encoding=UTF8 --set=listen_addresses=*",
    },
    tars = [":postgres_test_startup"],
)

oci_layout_py(
    name = "postgres_18",
    testonly = True,
    image = ":postgres_18_test_image",
    visibility = ["//visibility:public"],
)

# The Go fixture passes these language-neutral layout pointers to the shared
# Python loader. Python consumers use the generated descriptors directly.
oci_layout_rloc(
    name = "postgres_18_rloc",
    testonly = True,
    image = ":postgres_18_test_image",
    visibility = ["//agentplane:__subpackages__"],
)

oci_layout_rloc(
    name = "ryuk_rloc",
    testonly = True,
    image = "@ryuk_linux_amd64",
    visibility = ["//agentplane:__subpackages__"],
)

oci_layout_py(
    name = "pgvector_pg18",
    testonly = True,
    image = "@pgvector_pg18_linux_amd64",
    visibility = ["//visibility:public"],
)

oci_layout_py(
    name = "registry_3",
    testonly = True,
    image = "@registry_3_linux_amd64",
    visibility = ["//visibility:public"],
)

oci_layout_py(
    name = "ryuk",
    testonly = True,
    image = "@ryuk_linux_amd64",
    visibility = ["//visibility:public"],
)

# Go Testcontainers integration tests use the pinned images already carried in Bazel runfiles.
# The Go library's Ryuk version matches RYUK_TAG.
oci_load(
    name = "postgres_18_load",
    testonly = True,
    image = ":postgres_18_test_image",
    repo_tags = ["postgres:18"],
    visibility = ["//visibility:public"],
)

oci_load(
    name = "ryuk_014_load",
    testonly = True,
    image = "@ryuk_linux_amd64",
    repo_tags = [RYUK_TAG],
    visibility = ["//visibility:public"],
)

oci_layout_py(
    name = "python_3_14_slim",
    testonly = True,
    image = "@python_3_14_slim_linux_amd64",
    visibility = ["//visibility:public"],
)

oci_layout_py(
    name = "grocy",
    image = "@grocy_linux_amd64",
    visibility = ["//visibility:public"],
)

oci_layout_py(
    name = "debian_slim",
    image = "@debian_trixie_slim_linux_amd64",
    visibility = ["//visibility:public"],
)

# Electric's original digest is absent from mirror.gcr.io and its upstream Docker Hub
# repository is broken. The pin uses the published electricsql/electric-temp image.
oci_layout_py(
    name = "electric_1_8_1",
    testonly = True,
    image = "@electric_1_8_1_linux_amd64",
    visibility = ["//visibility:public"],
)

oci_layout_py(
    name = "nginx_unprivileged",
    testonly = True,
    image = "@nginx_unprivileged_linux_amd64",
    visibility = ["//visibility:public"],
)

oci_layout_py(
    name = "blackbox_exporter",
    testonly = True,
    image = "@blackbox_exporter_linux_amd64",
    visibility = ["//visibility:public"],
)
