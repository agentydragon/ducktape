# Pre-built container images for Testcontainers-based tests.
#
# These images are bundled as Bazel deps so hermetic tests don't need Docker Hub
# access. Test fixtures use crane to push OCI layout dirs into the Docker daemon.
#
# Each image is one `py_library` carrying both its `IMAGE` constant and the image itself,
# so a test names it once:
#
#     deps = ["//third_party/containers:postgres_18"]
#     from third_party.containers import postgres_18

load("//devinfra/oci:defs.bzl", "oci_image_py")
load("//devinfra/python:defs.bzl", "py_library")

py_library(
    name = "fixtures",
    testonly = True,
    srcs = ["fixtures.py"],
    visibility = ["//visibility:public"],
    deps = [
        "//third_party/containers:debian_slim",
        "//util:oci",
        "@pypi//pytest",
    ],
)

oci_image_py(
    name = "postgres_18",
    testonly = True,
    image = "@postgres_18_linux_amd64",
    tag = "postgres:18",
    visibility = ["//visibility:public"],
)

oci_image_py(
    name = "pgvector_pg18",
    testonly = True,
    image = "@pgvector_pg18_linux_amd64",
    tag = "pgvector/pgvector:pg18",
    visibility = ["//visibility:public"],
)

oci_image_py(
    name = "registry_3",
    testonly = True,
    image = "@registry_3_linux_amd64",
    tag = "registry:3",
    visibility = ["//visibility:public"],
)

oci_image_py(
    name = "ryuk",
    testonly = True,
    image = "@ryuk_linux_amd64",
    tag = "testcontainers/ryuk:0.14.0",
    visibility = ["//visibility:public"],
)

oci_image_py(
    name = "python_3_14_slim",
    testonly = True,
    image = "@python_3_14_slim_linux_amd64",
    tag = "python:3.14-slim",
    visibility = ["//visibility:public"],
)

oci_image_py(
    name = "grocy",
    image = "@grocy_linux_amd64",
    tag = "linuxserver/grocy:v4.6.0-ls318",
    visibility = ["//visibility:public"],
)

oci_image_py(
    name = "debian_slim",
    image = "@debian_trixie_slim_linux_amd64",
    tag = "debian-slim:test",
    visibility = ["//visibility:public"],
)

oci_image_py(
    name = "electric_1_8_1",
    testonly = True,
    image = "@electric_1_8_1_linux_amd64",
    tag = "electricsql/electric:1.8.1",
    visibility = ["//visibility:public"],
)
