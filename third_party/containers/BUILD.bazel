# Pre-built container images for Testcontainers-based tests.
#
# These images are bundled as Bazel deps so hermetic tests don't need Docker Hub
# access. Test fixtures use crane to push OCI layout dirs into the Docker daemon.
#
# Each image is one `py_library` carrying both its `IMAGE` constant and the image itself,
# so a test names it once:
#
#     deps = ["//third_party/containers:postgres_18"]
#     from third_party.containers import postgres_18

load("@rules_oci//oci:defs.bzl", "oci_load")
load("//devinfra/oci:defs.bzl", "oci_image_py")
load("//devinfra/python:defs.bzl", "RYUK_TAG", "py_library")

oci_image_py(
    name = "grafana_visual",
    testonly = True,
    image = "@grafana_visual_linux_amd64",
    tag = "grafana/grafana:12.4.1",
    visibility = ["//visibility:public"],
)

oci_image_py(
    name = "prometheus_visual",
    testonly = True,
    image = "@prometheus_visual_linux_amd64",
    tag = "prom/prometheus:v3.5.0",
    visibility = ["//visibility:public"],
)

py_library(
    name = "fixtures",
    testonly = True,
    srcs = ["fixtures.py"],
    visibility = ["//visibility:public"],
    deps = [
        "//third_party/containers:debian_slim",
        "//util:oci",
        "@pypi//pytest",
    ],
)

oci_image_py(
    name = "postgres_18",
    testonly = True,
    image = "@postgres_18_linux_amd64",
    tag = "postgres:18",
    visibility = ["//visibility:public"],
)

oci_image_py(
    name = "pgvector_pg18",
    testonly = True,
    image = "@pgvector_pg18_linux_amd64",
    tag = "pgvector/pgvector:pg18",
    visibility = ["//visibility:public"],
)

oci_image_py(
    name = "registry_3",
    testonly = True,
    image = "@registry_3_linux_amd64",
    tag = "registry:3",
    visibility = ["//visibility:public"],
)

oci_image_py(
    name = "ryuk",
    testonly = True,
    image = "@ryuk_linux_amd64",
    tag = RYUK_TAG,
    visibility = ["//visibility:public"],
)

# Go Testcontainers integration tests use the pinned images already carried in Bazel runfiles.
# The Go library's Ryuk version matches RYUK_TAG.
oci_load(
    name = "postgres_18_load",
    testonly = True,
    image = "@postgres_18_linux_amd64",
    repo_tags = ["postgres:18"],
    visibility = ["//visibility:public"],
)

oci_load(
    name = "ryuk_014_load",
    testonly = True,
    image = "@ryuk_linux_amd64",
    repo_tags = [RYUK_TAG],
    visibility = ["//visibility:public"],
)

oci_image_py(
    name = "python_3_14_slim",
    testonly = True,
    image = "@python_3_14_slim_linux_amd64",
    tag = "python:3.14-slim",
