# Pre-built container images for Testcontainers-based tests.
#
# These images are bundled as Bazel deps so hermetic tests don't need Docker Hub
# access. Test fixtures use crane to push OCI layout dirs into the Docker daemon.
#
# Usage in BUILD.bazel data deps:
#     data = ["//third_party/containers:postgres_18"]

load("@rules_python//python:defs.bzl", "py_library")
load("//devinfra/oci:defs.bzl", "oci_layout_rloc")

py_library(
    name = "rlocations",
    srcs = ["rlocations.py"],
    imports = ["../.."],
    visibility = ["//visibility:public"],
    deps = ["//util:oci"],
)

py_library(
    name = "fixtures",
    testonly = True,
    srcs = ["fixtures.py"],
    imports = ["../.."],
    visibility = ["//visibility:public"],
    deps = [
        ":rlocations",
        "//util:oci",
        "@pypi//pytest",
    ],
)

oci_layout_rloc(
    name = "postgres_18",
    testonly = True,
    image = "@postgres_18_linux_amd64",
    visibility = ["//visibility:public"],
)

oci_layout_rloc(
    name = "registry_2",
    testonly = True,
    image = "@registry_2_linux_amd64",
    visibility = ["//visibility:public"],
)

oci_layout_rloc(
    name = "ryuk",
    testonly = True,
    image = "@ryuk_linux_amd64",
    visibility = ["//visibility:public"],
)

oci_layout_rloc(
    name = "python_3_13_slim",
    testonly = True,
    image = "@python_3_13_slim_linux_amd64",
    visibility = ["//visibility:public"],
)

oci_layout_rloc(
    name = "mitmproxy",
    testonly = True,
    image = "@mitmproxy_linux_amd64",
    visibility = ["//visibility:public"],
)

oci_layout_rloc(
    name = "debian_slim",
    image = "@debian_slim_linux_amd64",
    visibility = ["//visibility:public"],
)
