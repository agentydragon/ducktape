# bzlmod overrides needed to build //third_party/buildbuddy_cli:bb (a
# ducktape-patched `bb` -- see bb_repo_url_commit_override.patch) under
# ducktape's own Bazel graph instead of buildbuddy's own (which we don't
# import). single_version_override/module_override/gazelle_override are all
# forbidden in non-root bzlmod modules, so none of this can live inside
# //third_party/buildbuddy_cli/MODULE.bazel itself -- this file is
# include()'d from the root MODULE.bazel instead (see the include() call
# there), keeping the declarations physically grouped with what they're for
# without polluting root MODULE.bazel with buildbuddy-specific detail.
#
# Also can't live *inside* //third_party/buildbuddy_cli/ itself: that
# directory is `.bazelignore`'d (it's simultaneously root's own subpackage
# and the separate @ducktape_buildbuddy_cli module's root -- see
# //.bazelignore), and include() resolves its label the same way normal
# package loading does, so an ignored directory's files aren't include()able
# either.
#
# Variable bindings (including use_extension() proxies) are NOT shared
# between an including file and its included files -- each file that wants
# to add go_deps tags needs its own use_extension() call. Bzlmod recognizes
# repeated use_extension() calls for the same (bzl_file, name) as the same
# underlying extension and merges all their tags into one evaluation, so
# this go_deps proxy's module_override/gazelle_override tags below combine
# with root MODULE.bazel's own go_deps tags (from_file, other module()
# entries, etc.) normally.
go_deps = use_extension("@bazel_gazelle//:extensions.bzl", "go_deps")

# BUILD/bzl files inside a repo fetched by a module extension (e.g. go_deps'
# com_github_buildbuddy_io_buildbuddy, see //third_party/buildbuddy_cli) can
# only resolve `@repo` labels visible to the *hosting extension's own module*
# (bazel_gazelle, since go_deps is @bazel_gazelle//:extensions.bzl%go_deps) --
# not labels from bazel_dep entries declared by root or any other module.
# That's how @io_bazel_rules_go and @com_google_protobuf already resolve
# inside buildbuddy's fetched BUILD files (gazelle depends on both under
# those exact repo_names) but @googleapis doesn't. Rather than patching every
# @googleapis reference out of buildbuddy's real REAPI/bytestream/longrunning
# protos (core, actively-used functionality), add the same bazel_dep gazelle
# itself doesn't declare, so it becomes visible the same way.
single_version_override(
    module_name = "gazelle",
    patch_strip = 1,
    patches = ["//third_party/buildbuddy_cli_overrides:bb_devshell_gazelle_add_googleapis_dep.patch"],
    version = "0.47.0",
)

# `bb remote`'s --repo_url patch proposal (devinfra/plans/bb_repo_url_commit_override.md)
# plus local-only fixups needed to build their `cli/cmd/bb` target under
# ducktape's own Bazel (rather than theirs): stripping JS/TS proto codegen
# (needs @com_github_buildbuddy_io_protoc_gen_protobufjs, unused by the Go
# CLI) and stripping their root BUILD file down to just the
# config_setting/platform/alias targets select()s in the cli/... dependency
# closure actually need (the full file pulls in rules_uv/pip/npm/nogo/gazelle
# tooling we don't have and don't need). Only the first patch is proposed
# upstream; the rest are devshell-build-only workarounds, not upstreamed.
# The rest of the buildbuddy-cli wiring (go.mod-based dependency resolution,
# the bb-linux-amd64 alias) lives in the isolated //third_party/buildbuddy_cli
# submodule -- module_override must be declared here in the root module,
# since bzlmod forbids it in non-root modules.
go_deps.module_override(
    patch_strip = 1,
    patches = [
        "//third_party/buildbuddy_cli_overrides:bb_repo_url_commit_override.patch",
        "//third_party/buildbuddy_cli_overrides:bb_devshell_strip_js_protogen.patch",
        # STILL needed even with build_file_generation = "on" below: gazelle
        # regeneration does not normalize cli/bazelisk/BUILD's existing
        # `go_default_library`-style label for its bazelisk dep to match our
        # freshly-fetched bazelisk repo's modern (directory-matching) naming
        # convention -- confirmed empirically, removing this patch
        # reproduces the exact "no such target ...core:go_default_library"
        # error it was originally written to fix.
        "//third_party/buildbuddy_cli_overrides:bb_devshell_fix_bazelisk_naming.patch",
        # cli/fix (the `bb fix` subcommand) embeds a full copy of gazelle's
        # main.go/update-repos.go plus buildifier internals, both pinned to a
        # different gazelle major version (bazel-contrib/bazel-gazelle v2) and
        # relying on visibility that only buildbuddy's own differently-shaped
        # gazelle/buildifier checkouts grant. cli/index (remote codesearch
        # indexing) transitively needs go-tree-sitter's cgo-only Node type,
        # which doesn't exist in the pure ("pure = on") cross-compiled
        # bb-linux-amd64 build. Chasing each cross-version/cgo mismatch
        # individually doesn't scale, and neither subcommand is related to
        # `bb remote` (this patch set's actual goal), so drop both
        # registrations instead of patching around their internals.
        "//third_party/buildbuddy_cli_overrides:bb_devshell_drop_fix_and_index_commands.patch",
        # zip.proto/eventlog.proto/storage.proto/distributed_cache.proto use
        # vtprotobuf's `(vtproto.mempool) = true` option (a marshal/pooling
        # perf annotation, not a message-shape change) via `import
        # "github.com/planetscale/vtprotobuf/vtproto/ext.proto"`. That path
        # is only resolvable through buildbuddy's own gazelle_override
        # (defined in their real MODULE.bazel, which we don't import), so
        # protoc can't find it here; drop the option/import instead.
        # search.proto's ExtendedXrefsReply/ExtendedDocumentationReply/
        # KytheRequest/KytheResponse messages use actual kythe.proto.* field
        # types -- drop those messages and the KytheProxy RPC that
        # references them from buildbuddy_service.proto/codesearch_service.proto.
        # All of buildbuddy_service_go_proto (needed by cli/remotebazel) pulls
        # in every proto in this file regardless of which CLI commands are
        # registered, so these can't be avoided by trimming cli/cli_command
        # alone. This is real .proto *content* (not BUILD-file organization),
        # so it stays necessary regardless of build_file_generation below.
        "//third_party/buildbuddy_cli_overrides:bb_devshell_strip_vtproto_and_kythe_messages.patch",
        # build_file_generation = "on" below makes go_repository auto-create
        # its own REPO.bazel + inject a gazelle_generated_package_info target
        # into the root BUILD file (see gazelle+/internal/go_repository.bzl),
        # which depends on @aspect_bazel_lib -- not visible from this
        # module-extension-fetched repo's context. Pre-supplying an empty
        # REPO.bazel opts out of that generation entirely (the mechanism's
        # own doc comment: "provides a way for users to opt out of
        # Gazelle-generated package_info").
        "//third_party/buildbuddy_cli_overrides:bb_devshell_opt_out_package_info.patch",
    ],
    path = "github.com/buildbuddy-io/buildbuddy",
)

# EXPERIMENT: force gazelle to generate fresh, minimal BUILD files for this
# repo from its .go/.proto source (matching how every other go_repository
# dependency in this repo is built) instead of using buildbuddy's own
# checked-in BUILD files (which encode buildbuddy's *entire* build graph --
# kythe, vtproto codegen, JS/TS proto codegen, release tooling -- none of it
# relevant to cli/cmd/bb). This is why build_file_generation defaults to
# "auto": since buildbuddy's repo root already has a BUILD file, "auto" was
# using their checked-in ones verbatim, which is what forced most of the
# now-removed strip_* patches above (root_build, cli_py,
# strip_version_platform_alias, strip_bazel_pkg_tar, strip_kythe,
# fix_client_model_go_label, fix_bazelisk_naming) to exist in the first
# place -- they were all patching hand-written BUILD content that gazelle
# regeneration should make moot.
go_deps.gazelle_override(
    build_file_generation = "on",
    path = "github.com/buildbuddy-io/buildbuddy",
)

# prometheus/client_model v0.6.2's io/prometheus/client/metrics.proto
# declares `option go_package = "github.com/prometheus/client_model/go;..."`
# -- i.e. the proto source (at io/prometheus/client/) and the checked-in
# generated code (at go/metrics.pb.go) both claim the same Go import path by
# design (the repo-root go/ package IS metrics.proto's compiled output,
# committed so consumers don't need to run protoc). Gazelle doesn't know
# that and additionally generates a go_proto_library from the .proto file
# itself, so the linker sees two targets for the same import path. Disable
# gazelle's proto generation for this repo so it just treats go/metrics.pb.go
# as plain Go source, matching how every real importer already expects to
# consume it. Declared here (not in //third_party/buildbuddy_cli) since
# gazelle_override, like module_override, is forbidden in non-root modules.
go_deps.gazelle_override(
    directives = ["gazelle:proto disable"],
    path = "github.com/prometheus/client_model",
)
