genrule(
    name = "restic",
    srcs = ["@restic_linux_amd64//file"],
    outs = ["restic_bin"],
    cmd = "$(execpath @bzip2//:bzip2) -dc $(location @restic_linux_amd64//file) > $@ && chmod +x $@",
    executable = True,
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    tools = ["@bzip2"],
    visibility = ["//nix/home/services:__pkg__"],
)
