# Typed cdk8s Python constructs generated from tofu-controller's upstream Terraform CRD
# (fetched via MODULE.bazel's tofu_controller_terraform_crd http_file, never vendored).
# See cluster/docs/cdk8s.md.

# tofu_controller is generated at build time by cdk8s_import below, not a pip package --
# gazelle can't resolve it from the requirements manifest.
# gazelle:resolve py tofu_controller //third_party/tofu_controller:terraform

load("//devinfra/js:cdk8s_import.bzl", "cdk8s_import")
load("//devinfra/python:defs.bzl", "py_test")

cdk8s_import(
    name = "terraform",
    crd = "@tofu_controller_terraform_crd//file",
    module_name = "tofu_controller",
    module_path = "io/fluxcd/contrib/infra",
    visibility = ["//visibility:public"],
)

py_test(
    name = "test_terraform_import",
    srcs = ["test_terraform_import.py"],
    data = ["@nodejs_linux_amd64//:bin/node"],
    env = {"JSII_NODE": "$(rootpath @nodejs_linux_amd64//:bin/node)"},
    deps = [
        "//:conftest",
        "//third_party/tofu_controller:terraform",
        "@pypi//cdk8s",
        "@pypi//pytest_bazel",
    ],
)
