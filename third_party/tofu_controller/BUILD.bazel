load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files", "strip_prefix")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

# The patched Terraform CRD; the cluster installs this instead of the Helm chart's copy. Copied
# into this package so a dependent reaches it at a runfiles path under this module's name.
genrule(
    name = "terraform_crd",
    srcs = ["@com_github_flux_iac_tofu_controller//config/crd/bases:infra.contrib.fluxcd.io_terraforms.yaml"],
    outs = ["infra.contrib.fluxcd.io_terraforms.yaml"],
    cmd = "cp $< $@",
    visibility = ["//visibility:public"],
)

pkg_files(
    name = "manager_files",
    srcs = ["@com_github_flux_iac_tofu_controller//cmd/manager"],
    attributes = pkg_attributes(mode = "0755"),
    renames = {"@com_github_flux_iac_tofu_controller//cmd/manager": "tofu-controller"},
    strip_prefix = strip_prefix.files_only(),
)

pkg_tar(
    name = "app_layer",
    srcs = [":manager_files"],
)

# distroless/cc, not static: rules_go's default pure="auto" links the binary dynamically
# (upstream's Dockerfile builds CGO_ENABLED=0 onto scratch), as third_party/osmmcp found.
oci_image(
    name = "image",
    base = "@tofu_controller_distroless_cc_linux_amd64",
    entrypoint = ["/tofu-controller"],
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [":app_layer"],
    visibility = ["//visibility:public"],
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["tofu-controller:local"],
)
