module(
    name = "ducktape_cli_proxy_api",
    version = "0.1.0",
)

bazel_dep(name = "gazelle", version = "0.54.0", repo_name = "bazel_gazelle")
bazel_dep(name = "rules_go", version = "0.63.0", repo_name = "io_bazel_rules_go")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "aspect_rules_js", version = "3.4.1")
bazel_dep(name = "rules_nodejs", version = "6.7.5")

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node", isolate = True)
node.toolchain(node_version = "24.13.0")
use_repo(node, "nodejs_linux_amd64")

pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
pnpm.pnpm(
    pnpm_version = "9.15.9",
    pnpm_version_integrity = "sha512-aARhQYk8ZvrQHAeSMRKOmvuJ74fiaR1p5NQO7iKJiClf1GghgbrlW1hBjDolO95lpQXsfF+UA+zlzDzTfc8lMQ==",
)
use_repo(pnpm, "pnpm")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm", isolate = True)
npm.npm_translate_lock(
    name = "npm_cli_proxy_webui",
    lifecycle_hooks = {"*": []},
    pnpm_lock = "//:pnpm-lock.yaml",
    # Upstream imports these transitive dependencies from its flat Bun install.
    public_hoist_packages = {
        "@codemirror/search": [""],
        "@codemirror/state": [""],
        "@codemirror/view": [""],
        "motion-dom": [""],
        "react-router": [""],
    },
    update_pnpm_lock = False,
    use_pnpm = "@pnpm//:package/bin/pnpm.cjs",
)
use_repo(npm, "npm_cli_proxy_webui")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# https://github.com/router-for-me/Cli-Proxy-API-Management-Center/pull/505
http_archive(
    name = "cli_proxy_webui",
    build_file = "//:webui.BUILD.bazel",
    sha256 = "bc2d4d9858a4a89ec80ce1b531b042b04e78d54c6e14b1deb09e027e10f4232a",
    strip_prefix = "Cli-Proxy-API-Management-Center-69b6303eb935050788772285f30268ed81d0a91c",
    urls = ["https://github.com/agentydragon/Cli-Proxy-API-Management-Center/archive/69b6303eb935050788772285f30268ed81d0a91c.tar.gz"],
)

# Run upstream's test suite with its declared Bun runtime.
http_archive(
    name = "cli_proxy_bun",
    build_file_content = 'exports_files(["bun"])',
    sha256 = "951ee2aee855f08595aeec6225226a298d3fea83a3dcd6465c09cbccdf7e848f",
    strip_prefix = "bun-linux-x64",
    urls = ["https://github.com/oven-sh/bun/releases/download/bun-v1.3.14/bun-linux-x64.zip"],
)

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "cli_proxy_distroless_cc",
    digest = "sha256:9b615fff20e1a4fad29c2b30562580b212c7dd5e2225236735cca0070ed11c78",
    image = "gcr.io/distroless/cc-debian13",
    platforms = ["linux/amd64"],
)
use_repo(oci, "cli_proxy_distroless_cc_linux_amd64")

go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.4")

go_deps = use_extension("@bazel_gazelle//:extensions.bzl", "go_deps", isolate = True)
go_deps.from_file(go_mod = "//:go.mod")
go_deps.module(
    path = "github.com/router-for-me/CLIProxyAPI/v8",
    version = "v8.0.0-20261019015532-0f5c54cd6a13",
)

# The v8 source imports stun/v3; our newer WebRTC dependencies also use stun/v4.
go_deps.module(
    path = "github.com/pion/stun/v3",
    sum = "h1:uRXMTlGLf89WgItGNyZ6aR5jMTX0NBbybXADpQCzn+E=",
    version = "v3.1.7",
)

# https://github.com/router-for-me/CLIProxyAPI/pull/6761
go_deps.archive_override(
    patch_strip = 1,
    patches = [
        "//patches:bundled-panel.patch",
        "//patches:bazel.patch",
        "//patches:upstream-timing.patch",
        "//patches:streaming-channel-race.patch",
    ],
    path = "github.com/router-for-me/CLIProxyAPI/v8",
    sha256 = "d6f1bcb5ee6ff76f72b4a5478747d13bbfc060fea95bc449084d24fc952b08e0",
    strip_prefix = "CLIProxyAPI-0f5c54cd6a1393447484eee02149bf7fab2e4784",
    urls = ["https://github.com/agentydragon/CLIProxyAPI/archive/0f5c54cd6a1393447484eee02149bf7fab2e4784.tar.gz"],
)
use_repo(go_deps, "com_github_router_for_me_cliproxyapi_v8")
