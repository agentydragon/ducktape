+
+func TestReadOnlyPanelNeverDownloads(t *testing.T) {
+	t.Setenv("MANAGEMENT_STATIC_READONLY", "true")
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		t.Error("read-only panel made an HTTP request")
+		w.WriteHeader(500)
+	}))
+	defer server.Close()
+	if _, skip := autoUpdateSkipReason(&config.Config{}); !skip {
+		t.Fatal("background updater enabled")
+	}
+	dir := t.TempDir()
+	if EnsureLatestManagementHTML(t.Context(), dir, "", server.URL) {
+		t.Fatal("missing bundled panel accepted")
+	}
+	path := filepath.Join(dir, managementAssetName)
+	if err := os.WriteFile(path, []byte("pinned panel"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if !EnsureLatestManagementHTML(t.Context(), dir, "", server.URL) {
+		t.Fatal("bundled panel rejected")
+	}
+	contents, err := os.ReadFile(path)
+	if err != nil || string(contents) != "pinned panel" {
+		t.Fatal("bundled panel changed")
+	}
+}
