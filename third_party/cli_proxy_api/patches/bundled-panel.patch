 // EnsureLatestManagementHTML checks the latest management.html asset and updates the local copy when needed.
 // It coalesces concurrent sync attempts and returns whether the asset exists after the sync attempt.
 func EnsureLatestManagementHTML(ctx context.Context, staticDir string, proxyURL string, panelRepository string) bool {
+	// Image builders can require the bundled panel even when runtime config enables
+	// updates. Never fetch a replacement, including when the bundle is missing.
+	if os.Getenv("MANAGEMENT_STATIC_READONLY") == "true" {
+		info, err := os.Stat(filepath.Join(staticDir, managementAssetName))
+		return err == nil && info.Mode().IsRegular()
+	}
 	if ctx == nil {
 		ctx = context.Background()
 	}
