+// upstreamTiming holds the access log's marks for a request's upstream calls. A retry restarts
+// the marks, so they describe the attempt that answered.
+type upstreamTiming struct {
+	mu         sync.Mutex
+	attempts   int
+	sent       time.Time
+	headers    time.Time
+	firstChunk time.Time
+}
+
+func upstreamTimingOf(c *gin.Context) *upstreamTiming {
+	if value, exists := c.Get(upstreamTimingKey); exists {
+		if timing, ok := value.(*upstreamTiming); ok {
+			return timing
+		}
+	}
+	timing := &upstreamTiming{}
+	c.Set(upstreamTimingKey, timing)
+	return timing
+}
+
+// MarkUpstreamSent records that an upstream attempt is about to be sent.
+func MarkUpstreamSent(c *gin.Context) {
+	if c == nil {
+		return
+	}
+	timing := upstreamTimingOf(c)
+	timing.mu.Lock()
+	defer timing.mu.Unlock()
+	timing.attempts++
+	timing.sent = time.Now()
+	timing.headers = time.Time{}
+	timing.firstChunk = time.Time{}
+}
+
+// MarkUpstreamHeaders records that the current upstream attempt's response headers arrived.
+func MarkUpstreamHeaders(c *gin.Context) {
+	if c == nil {
+		return
+	}
+	timing := upstreamTimingOf(c)
+	timing.mu.Lock()
+	defer timing.mu.Unlock()
+	if timing.headers.IsZero() {
+		timing.headers = time.Now()
+	}
+}
+
+// MarkUpstreamChunk records that a response body chunk arrived from the current upstream attempt.
+func MarkUpstreamChunk(c *gin.Context) {
+	if c == nil {
+		return
+	}
+	timing := upstreamTimingOf(c)
+	timing.mu.Lock()
+	defer timing.mu.Unlock()
+	if timing.firstChunk.IsZero() {
+		timing.firstChunk = time.Now()
+	}
+}
+
+// FirstByteReporter is a response writer that knows when it first wrote body bytes to the client.
+type FirstByteReporter interface {
+	FirstByteAt() time.Time
+}
+
+// upstreamTimingSuffix renders the marks as offsets from the request's arrival, or nothing for a
+// request that made no upstream call: " | upstream attempts=1 sent=41ms headers=962ms ...".
+func upstreamTimingSuffix(c *gin.Context, start time.Time) string {
+	value, exists := c.Get(upstreamTimingKey)
+	if !exists {
+		return ""
+	}
+	timing, ok := value.(*upstreamTiming)
+	if !ok {
+		return ""
+	}
+	timing.mu.Lock()
+	defer timing.mu.Unlock()
+	parts := []string{fmt.Sprintf("attempts=%d", timing.attempts)}
+	offset := func(name string, at time.Time) {
+		if !at.IsZero() {
+			parts = append(parts, fmt.Sprintf("%s=%v", name, at.Sub(start).Truncate(time.Millisecond)))
+		}
+	}
+	offset("sent", timing.sent)
+	offset("headers", timing.headers)
+	offset("first_chunk", timing.firstChunk)
+	if reporter, ok := c.Writer.(FirstByteReporter); ok {
+		offset("first_byte", reporter.FirstByteAt())
+	}
+	return " | upstream " + strings.Join(parts, " ")
+}
