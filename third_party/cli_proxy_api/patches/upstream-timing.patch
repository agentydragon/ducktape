 }
+
+func TestResponseWriterWrapperRecordsFirstByteWithLoggingDisabled(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	c, _ := gin.CreateTestContext(httptest.NewRecorder())
+	wrapper := NewResponseWriterWrapper(c.Writer, nil, &RequestInfo{})
+	wrapper.logOnErrorOnly = true
+
+	if !wrapper.FirstByteAt().IsZero() {
+		t.Fatalf("first byte recorded before anything was written")
+	}
+	before := time.Now()
+	if _, err := wrapper.WriteString("data: {}\n\n"); err != nil {
+		t.Fatalf("WriteString: %v", err)
+	}
+	first := wrapper.FirstByteAt()
+	if first.Before(before) {
+		t.Fatalf("first byte %v precedes the write at %v", first, before)
+	}
+	if _, err := wrapper.Write([]byte("data: {}\n\n")); err != nil {
+		t.Fatalf("Write: %v", err)
+	}
+	if !wrapper.FirstByteAt().Equal(first) {
+		t.Fatalf("a later write moved the first byte from %v to %v", first, wrapper.FirstByteAt())
+	}
+}
