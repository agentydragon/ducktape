+func (w *firstByteWriter) FirstByteAt() time.Time { return w.at }
+
+func accessLogLine(t *testing.T, handler gin.HandlerFunc) string {
+	t.Helper()
+	gin.SetMode(gin.TestMode)
+	logger := log.StandardLogger()
+	previousHooks := logger.ReplaceHooks(make(log.LevelHooks))
+	previousLevel := logger.GetLevel()
+	hook := logtest.NewLocal(logger)
+	logger.SetLevel(log.InfoLevel)
+	t.Cleanup(func() { logger.ReplaceHooks(previousHooks); logger.SetLevel(previousLevel) })
+
+	engine := gin.New()
+	engine.Use(GinLogrusLogger())
+	engine.POST("/v1/responses", handler)
+	engine.ServeHTTP(httptest.NewRecorder(), httptest.NewRequest(http.MethodPost, "/v1/responses", nil))
+	entries := hook.AllEntries()
+	if len(entries) != 1 {
+		t.Fatalf("got %d access log entries, want 1", len(entries))
+	}
+	return entries[0].Message
+}
+
+var offsetPattern = `[0-9.]+(ms|s)`
+
+func TestGinLogrusLoggerAppendsUpstreamTiming(t *testing.T) {
+	line := accessLogLine(t, func(c *gin.Context) {
+		MarkUpstreamSent(c)
+		MarkUpstreamHeaders(c)
+		MarkUpstreamChunk(c)
+		MarkUpstreamChunk(c)
+		c.Writer = &firstByteWriter{ResponseWriter: c.Writer, at: time.Now()}
+		c.Status(http.StatusOK)
+	})
+	pattern := regexp.MustCompile(` \| upstream attempts=1 sent=` + offsetPattern + ` headers=` + offsetPattern +
+		` first_chunk=` + offsetPattern + ` first_byte=` + offsetPattern + `$`)
+	if !pattern.MatchString(line) {
+		t.Fatalf("access log %q does not end with the upstream timing", line)
+	}
+}
+
+func TestGinLogrusLoggerRetryRestartsUpstreamTiming(t *testing.T) {
+	line := accessLogLine(t, func(c *gin.Context) {
+		MarkUpstreamSent(c)
+		MarkUpstreamHeaders(c)
+		MarkUpstreamChunk(c)
+		MarkUpstreamSent(c)
+		c.Status(http.StatusOK)
+	})
+	pattern := regexp.MustCompile(` \| upstream attempts=2 sent=` + offsetPattern + `$`)
+	if !pattern.MatchString(line) {
+		t.Fatalf("access log %q should carry only the second attempt's send", line)
+	}
+}
+
+func TestGinLogrusLoggerOmitsUpstreamTimingWithoutUpstreamCall(t *testing.T) {
+	line := accessLogLine(t, func(c *gin.Context) { c.Status(http.StatusOK) })
+	if strings.Contains(line, "upstream") {
+		t.Fatalf("access log %q carries upstream timing for a request that made no upstream call", line)
+	}
+}
