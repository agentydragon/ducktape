diff --git a/internal/api/handlers/management/oidc.go b/internal/api/handlers/management/oidc.go
new file mode 100644
index 0000000..1ffbf0f
--- /dev/null
+++ b/internal/api/handlers/management/oidc.go
@@ -0,0 +1,249 @@
+package management
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/base64"
+	"fmt"
+	"net/http"
+	"net/url"
+	"os"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/coreos/go-oidc/v3/oidc"
+	"github.com/gin-gonic/gin"
+	"golang.org/x/oauth2"
+)
+
+const (
+	sessionCookie  = "__Host-management-session"
+	flowCookie     = "__Host-management-login"
+	maxOIDCEntries = 1024
+)
+
+type oidcFlow struct {
+	state, nonce, verifier string
+	expires                time.Time
+}
+type oidcSession struct {
+	subject string
+	expires time.Time
+}
+
+// OIDC configuration is immutable for the lifetime of the process. Sessions and
+// login transactions are local to this instance; restart revokes all of them.
+type managementOIDC struct {
+	mu       sync.Mutex
+	issuer   string
+	clientID string
+	secret   string
+	redirect string
+	origin   string
+	subjects map[string]bool
+	flows    map[string]oidcFlow
+	sessions map[string]oidcSession
+	provider *oidc.Provider
+	oauth    oauth2.Config
+}
+
+func newManagementOIDC() (*managementOIDC, error) {
+	issuer := strings.TrimSpace(os.Getenv("MANAGEMENT_OIDC_ISSUER"))
+	if issuer == "" {
+		return nil, nil
+	}
+	o := &managementOIDC{issuer: issuer, clientID: os.Getenv("MANAGEMENT_OIDC_CLIENT_ID"), secret: os.Getenv("MANAGEMENT_OIDC_CLIENT_SECRET"), redirect: os.Getenv("MANAGEMENT_OIDC_REDIRECT_URL"), subjects: map[string]bool{}, flows: map[string]oidcFlow{}, sessions: map[string]oidcSession{}}
+	for _, sub := range strings.Split(os.Getenv("MANAGEMENT_OIDC_ALLOWED_SUBJECTS"), ",") {
+		if sub = strings.TrimSpace(sub); sub != "" {
+			o.subjects[sub] = true
+		}
+	}
+	for _, raw := range []string{o.issuer, o.redirect} {
+		u, err := url.Parse(raw)
+		if err != nil || u.Scheme != "https" || u.Host == "" || u.User != nil || u.RawQuery != "" || u.Fragment != "" {
+			return nil, fmt.Errorf("management OIDC requires HTTPS issuer and redirect URLs without credentials, query or fragment")
+		}
+	}
+	u, _ := url.Parse(o.redirect)
+	if u.Path != "/v0/management/callback" {
+		return nil, fmt.Errorf("management OIDC redirect path must be /v0/management/callback")
+	}
+	o.origin = "https://" + u.Host
+	if o.clientID == "" || len(o.subjects) == 0 {
+		return nil, fmt.Errorf("management OIDC requires client ID and a nonempty subject allowlist")
+	}
+	return o, nil
+}
+
+func (h *Handler) OIDCEnabled() bool { return h != nil && h.oidc != nil }
+
+func randomOIDCToken() string {
+	b := make([]byte, 32)
+	if _, err := rand.Read(b); err != nil {
+		panic(err)
+	}
+	return base64.RawURLEncoding.EncodeToString(b)
+}
+
+func setOIDCCookie(c *gin.Context, name, value string, age int) {
+	http.SetCookie(c.Writer, &http.Cookie{Name: name, Value: value, Path: "/", MaxAge: age, Secure: true, HttpOnly: true, SameSite: http.SameSiteLaxMode})
+}
+
+func (o *managementOIDC) pruneLocked() {
+	now := time.Now()
+	for k, v := range o.flows {
+		if !now.Before(v.expires) {
+			delete(o.flows, k)
+		}
+	}
+	for k, v := range o.sessions {
+		if !now.Before(v.expires) {
+			delete(o.sessions, k)
+		}
+	}
+}
+
+func (o *managementOIDC) session(c *gin.Context) (oidcSession, bool) {
+	key, err := c.Cookie(sessionCookie)
+	if err != nil {
+		return oidcSession{}, false
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	o.pruneLocked()
+	s, ok := o.sessions[key]
+	return s, ok
+}
+
+// A non-simple header protects even legacy management GET handlers that mutate
+// state. Origin is compared with configuration, never forwarded/request headers.
+func (o *managementOIDC) sameOrigin(c *gin.Context) bool {
+	origin := c.GetHeader("Origin")
+	return c.GetHeader("X-Management-CSRF") == "1" && (origin == "" || origin == o.origin) && c.GetHeader("Sec-Fetch-Site") != "cross-site"
+}
+
+func (h *Handler) ManagementSession(c *gin.Context) {
+	c.Header("Cache-Control", "no-store")
+	authenticated := false
+	if h.OIDCEnabled() {
+		_, authenticated = h.oidc.session(c)
+	}
+	c.JSON(http.StatusOK, gin.H{"oidcEnabled": h.OIDCEnabled(), "authenticated": authenticated})
+}
+
+func (o *managementOIDC) initialize(ctx context.Context) error {
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.provider != nil {
+		return nil
+	}
+	provider, err := oidc.NewProvider(ctx, o.issuer)
+	if err != nil {
+		return err
+	}
+	o.provider = provider
+	o.oauth = oauth2.Config{ClientID: o.clientID, ClientSecret: o.secret, RedirectURL: o.redirect, Endpoint: provider.Endpoint(), Scopes: []string{oidc.ScopeOpenID}}
+	return nil
+}
+
+func (h *Handler) ManagementLogin(c *gin.Context) {
+	c.Header("Cache-Control", "no-store")
+	if !h.OIDCEnabled() {
+		c.AbortWithStatus(http.StatusNotFound)
+		return
+	}
+	o := h.oidc
+	ctx, cancel := context.WithTimeout(c.Request.Context(), 15*time.Second)
+	defer cancel()
+	if err := o.initialize(ctx); err != nil {
+		c.AbortWithStatusJSON(http.StatusServiceUnavailable, gin.H{"error": "identity provider unavailable"})
+		return
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	o.pruneLocked()
+	if len(o.flows) >= maxOIDCEntries {
+		c.AbortWithStatus(http.StatusTooManyRequests)
+		return
+	}
+	binding := randomOIDCToken()
+	flow := oidcFlow{state: randomOIDCToken(), nonce: randomOIDCToken(), verifier: oauth2.GenerateVerifier(), expires: time.Now().Add(5 * time.Minute)}
+	o.flows[binding] = flow
+	setOIDCCookie(c, flowCookie, binding, 300)
+	c.Redirect(http.StatusFound, o.oauth.AuthCodeURL(flow.state, oidc.Nonce(flow.nonce), oauth2.S256ChallengeOption(flow.verifier)))
+}
+
+func (h *Handler) ManagementCallback(c *gin.Context) {
+	c.Header("Cache-Control", "no-store")
+	c.Header("Referrer-Policy", "no-referrer")
+	if !h.OIDCEnabled() {
+		c.AbortWithStatus(http.StatusNotFound)
+		return
+	}
+	o := h.oidc
+	binding, _ := c.Cookie(flowCookie)
+	setOIDCCookie(c, flowCookie, "", -1)
+	o.mu.Lock()
+	flow, ok := o.flows[binding]
+	delete(o.flows, binding)
+	o.mu.Unlock()
+	if !ok || !time.Now().Before(flow.expires) || c.Query("state") != flow.state || c.Query("code") == "" {
+		c.AbortWithStatusJSON(http.StatusBadRequest, gin.H{"error": "invalid login transaction"})
+		return
+	}
+	ctx, cancel := context.WithTimeout(c.Request.Context(), 15*time.Second)
+	defer cancel()
+	token, err := o.oauth.Exchange(ctx, c.Query("code"), oauth2.VerifierOption(flow.verifier))
+	if err != nil {
+		c.AbortWithStatusJSON(http.StatusUnauthorized, gin.H{"error": "login failed"})
+		return
+	}
+	raw, ok := token.Extra("id_token").(string)
+	if !ok {
+		c.AbortWithStatus(http.StatusUnauthorized)
+		return
+	}
+	id, err := o.provider.Verifier(&oidc.Config{ClientID: o.clientID}).Verify(ctx, raw)
+	if err != nil || id.Nonce != flow.nonce || !o.subjects[id.Subject] {
+		c.AbortWithStatus(http.StatusForbidden)
+		return
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	o.pruneLocked()
+	if len(o.sessions) >= maxOIDCEntries {
+		c.AbortWithStatus(http.StatusTooManyRequests)
+		return
+	}
+	if previous, err := c.Cookie(sessionCookie); err == nil {
+		delete(o.sessions, previous)
+	}
+	key := randomOIDCToken()
+	expires := time.Now().Add(time.Hour)
+	if id.Expiry.Before(expires) {
+		expires = id.Expiry
+	}
+	o.sessions[key] = oidcSession{subject: id.Subject, expires: expires}
+	setOIDCCookie(c, sessionCookie, key, int(time.Until(expires).Seconds()))
+	c.Redirect(http.StatusSeeOther, "/management.html")
+}
+
+func (h *Handler) ManagementLogout(c *gin.Context) {
+	c.Header("Cache-Control", "no-store")
+	if !h.OIDCEnabled() {
+		c.AbortWithStatus(http.StatusNotFound)
+		return
+	}
+	o := h.oidc
+	if !o.sameOrigin(c) {
+		c.AbortWithStatus(http.StatusForbidden)
+		return
+	}
+	key, _ := c.Cookie(sessionCookie)
+	o.mu.Lock()
+	delete(o.sessions, key)
+	o.mu.Unlock()
+	setOIDCCookie(c, sessionCookie, "", -1)
+	c.Status(http.StatusNoContent)
+}
diff --git a/internal/api/handlers/management/oidc_test.go b/internal/api/handlers/management/oidc_test.go
new file mode 100644
index 0000000..9638e9a
--- /dev/null
+++ b/internal/api/handlers/management/oidc_test.go
@@ -0,0 +1,262 @@
+package management
+
+import (
+	"context"
+	"crypto/rand"
+	"crypto/rsa"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/coreos/go-oidc/v3/oidc"
+	"github.com/gin-gonic/gin"
+	jose "github.com/go-jose/go-jose/v4"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	"golang.org/x/oauth2"
+)
+
+func testOIDC() *managementOIDC {
+	return &managementOIDC{issuer: "https://issuer.example", clientID: "management", redirect: "https://admin.example/v0/management/callback", origin: "https://admin.example", subjects: map[string]bool{"owner": true}, flows: map[string]oidcFlow{}, sessions: map[string]oidcSession{}}
+}
+
+func oidcRequest(handler gin.HandlerFunc, method, target string, cookies []*http.Cookie, headers map[string]string) *httptest.ResponseRecorder {
+	w := httptest.NewRecorder()
+	c, _ := gin.CreateTestContext(w)
+	c.Request = httptest.NewRequest(method, target, nil)
+	for _, cookie := range cookies {
+		c.Request.AddCookie(cookie)
+	}
+	for key, value := range headers {
+		c.Request.Header.Set(key, value)
+	}
+	handler(c)
+	c.Writer.WriteHeaderNow()
+	return w
+}
+
+func TestOIDCManagementBoundary(t *testing.T) {
+	o := testOIDC()
+	o.sessions["valid"] = oidcSession{subject: "owner", expires: time.Now().Add(time.Hour)}
+	h := &Handler{oidc: o, cfg: &config.Config{}, failedAttempts: map[string]*attemptInfo{}}
+	cookie := []*http.Cookie{{Name: sessionCookie, Value: "valid"}}
+	for _, tc := range []struct {
+		name, method string
+		cookies      []*http.Cookie
+		headers      map[string]string
+		status       int
+	}{
+		{"session read", "GET", cookie, map[string]string{"X-Management-CSRF": "1"}, 200},
+		{"session write", "POST", cookie, map[string]string{"X-Management-CSRF": "1", "Origin": o.origin}, 200},
+		{"legacy GET CSRF", "GET", cookie, nil, 403},
+		{"write CSRF", "POST", cookie, nil, 403},
+		{"foreign origin", "POST", cookie, map[string]string{"X-Management-CSRF": "1", "Origin": "https://evil.example"}, 403},
+		{"foreign fetch", "GET", cookie, map[string]string{"X-Management-CSRF": "1", "Sec-Fetch-Site": "cross-site"}, 403},
+		{"identity header spoof", "GET", nil, map[string]string{"X-authentik-uid": "owner", "X-Management-CSRF": "1"}, 401},
+		{"unknown cookie", "GET", []*http.Cookie{{Name: sessionCookie, Value: "fake"}}, map[string]string{"X-Management-CSRF": "1"}, 401},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			w := oidcRequest(h.Middleware(), tc.method, "https://admin.example/v0/management/config", tc.cookies, tc.headers)
+			if w.Code != tc.status {
+				t.Fatalf("got %d want %d: %s", w.Code, tc.status, w.Body)
+			}
+		})
+	}
+	// Explicit credentials retain key authentication and do not fall back to cookies.
+	h.envSecret = "key"
+	h.allowRemoteOverride = true
+	for _, tc := range []struct {
+		key    string
+		status int
+	}{{"key", 200}, {"wrong", 401}} {
+		w := oidcRequest(h.Middleware(), "POST", "https://admin.example/v0/management/config", cookie, map[string]string{"Authorization": "Bearer " + tc.key})
+		if w.Code != tc.status {
+			t.Fatalf("key auth got %d want %d", w.Code, tc.status)
+		}
+	}
+	o.sessions["valid"] = oidcSession{subject: "owner", expires: time.Now().Add(-time.Second)}
+	w := oidcRequest(h.ManagementSession, "GET", "/", cookie, nil)
+	if !strings.Contains(w.Body.String(), `"authenticated":false`) {
+		t.Fatal(w.Body)
+	}
+}
+
+func TestOIDCConfig(t *testing.T) {
+	t.Setenv("MANAGEMENT_OIDC_ISSUER", "https://issuer.example")
+	t.Setenv("MANAGEMENT_OIDC_CLIENT_ID", "management")
+	t.Setenv("MANAGEMENT_OIDC_REDIRECT_URL", "https://admin.example/v0/management/callback")
+	t.Setenv("MANAGEMENT_OIDC_ALLOWED_SUBJECTS", " owner, ")
+	if _, err := newManagementOIDC(); err != nil {
+		t.Fatal(err)
+	}
+	for _, tc := range []struct{ key, value string }{
+		{"MANAGEMENT_OIDC_ISSUER", "http://issuer.example"},
+		{"MANAGEMENT_OIDC_REDIRECT_URL", "https://admin.example/wrong"},
+		{"MANAGEMENT_OIDC_REDIRECT_URL", "https://user:pass@admin.example/v0/management/callback"},
+		{"MANAGEMENT_OIDC_ALLOWED_SUBJECTS", " , "},
+		{"MANAGEMENT_OIDC_CLIENT_ID", ""},
+	} {
+		t.Run(tc.key+tc.value, func(t *testing.T) {
+			t.Setenv(tc.key, tc.value)
+			if _, err := newManagementOIDC(); err == nil {
+				t.Fatal("accepted invalid config")
+			}
+		})
+	}
+}
