+func TestOIDCLoginCallback(t *testing.T) {
+	key, err := rsa.GenerateKey(rand.Reader, 2048)
+	if err != nil {
+		t.Fatal(err)
+	}
+	signer, err := jose.NewSigner(jose.SigningKey{Algorithm: jose.RS256, Key: key}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var issuer, rawToken, expectedVerifier string
+	tokenCalls := 0
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		switch r.URL.Path {
+		case "/.well-known/openid-configuration":
+			json.NewEncoder(w).Encode(map[string]any{"issuer": issuer, "authorization_endpoint": issuer + "/authorize", "token_endpoint": issuer + "/token", "jwks_uri": issuer + "/keys", "id_token_signing_alg_values_supported": []string{"RS256"}})
+		case "/keys":
+			json.NewEncoder(w).Encode(jose.JSONWebKeySet{Keys: []jose.JSONWebKey{{Key: &key.PublicKey, Algorithm: "RS256", Use: "sig"}}})
+		case "/token":
+			tokenCalls++
+			if err := r.ParseForm(); err != nil {
+				t.Error(err)
+			}
+			if r.Form.Get("code_verifier") != expectedVerifier {
+				t.Error("missing PKCE verifier")
+			}
+			json.NewEncoder(w).Encode(map[string]any{"access_token": "unused", "token_type": "Bearer", "id_token": rawToken})
+		default:
+			http.NotFound(w, r)
+		}
+	}))
+	defer server.Close()
+	issuer = server.URL
+	provider, err := oidc.NewProvider(context.Background(), issuer)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, tc := range []struct {
+		name, sub, nonce, audience, tokenIssuer, state string
+		expired                                        bool
+		status                                         int
+	}{
+		{"authorized", "owner", "nonce", "management", issuer, "state", false, 303},
+		{"tampered signature", "owner", "nonce", "management", issuer, "state", false, 403},
+		{"wrong subject", "other", "nonce", "management", issuer, "state", false, 403},
+		{"wrong nonce", "owner", "other", "management", issuer, "state", false, 403},
+		{"wrong audience", "owner", "nonce", "other", issuer, "state", false, 403},
+		{"wrong issuer", "owner", "nonce", "management", "https://evil.example", "state", false, 403},
+		{"expired token", "owner", "nonce", "management", issuer, "state", true, 403},
+		{"wrong state", "owner", "nonce", "management", issuer, "other", false, 400},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			o := testOIDC()
+			o.provider = provider
+			o.oauth = oauth2.Config{ClientID: o.clientID, Endpoint: provider.Endpoint(), RedirectURL: o.redirect}
+			expectedVerifier = oauth2.GenerateVerifier()
+			o.flows["binding"] = oidcFlow{state: "state", nonce: "nonce", verifier: expectedVerifier, expires: time.Now().Add(time.Minute)}
+			expiry := time.Now().Add(time.Hour)
+			if tc.expired {
+				expiry = time.Now().Add(-time.Hour)
+			}
+			payload, _ := json.Marshal(map[string]any{"iss": tc.tokenIssuer, "sub": tc.sub, "aud": tc.audience, "exp": expiry.Unix(), "iat": time.Now().Unix(), "nonce": tc.nonce})
+			signed, err := signer.Sign(payload)
+			if err != nil {
+				t.Fatal(err)
+			}
+			rawToken, err = signed.CompactSerialize()
+			if err != nil {
+				t.Fatal(err)
+			}
+			if tc.name == "tampered signature" {
+				rawToken += "x"
+			}
+			h := &Handler{oidc: o}
+			cookies := []*http.Cookie{{Name: flowCookie, Value: "binding"}}
+			before := tokenCalls
+			w := oidcRequest(h.ManagementCallback, "GET", "/v0/management/callback?state="+tc.state+"&code=code", cookies, nil)
+			if w.Code != tc.status {
+				t.Fatalf("got %d want %d: %s", w.Code, tc.status, w.Body)
+			}
+			if tc.state != "state" && tokenCalls != before {
+				t.Fatal("exchanged code before state verification")
+			}
+			replay := oidcRequest(h.ManagementCallback, "GET", "/v0/management/callback?state=state&code=code", cookies, nil)
+			if replay.Code != 400 {
+				t.Fatal("accepted replay")
+			}
+			if tc.status == 303 {
+				var session *http.Cookie
+				for _, cookie := range w.Result().Cookies() {
+					if cookie.Name == sessionCookie {
+						session = cookie
+					}
+				}
+				if session == nil || !session.Secure || !session.HttpOnly || session.SameSite != http.SameSiteLaxMode || session.Path != "/" || session.Domain != "" {
+					t.Fatal("unsafe session cookie")
+				}
+				blocked := oidcRequest(h.ManagementLogout, "POST", "/", []*http.Cookie{session}, nil)
+				if blocked.Code != 403 || len(o.sessions) != 1 {
+					t.Fatal("logout allowed CSRF")
+				}
+				out := oidcRequest(h.ManagementLogout, "POST", "/", []*http.Cookie{session}, map[string]string{"X-Management-CSRF": "1", "Origin": o.origin})
+				if out.Code != 204 || len(o.sessions) != 0 {
+					t.Fatal("logout did not revoke session")
+				}
+			} else if len(o.sessions) != 0 {
+				t.Fatal("unauthorized session created")
+			}
+		})
+	}
+	o := testOIDC()
+	o.provider = provider
+	o.oauth = oauth2.Config{ClientID: o.clientID, Endpoint: provider.Endpoint(), RedirectURL: o.redirect}
+	h := &Handler{oidc: o}
+	w := oidcRequest(h.ManagementLogin, "GET", "/", nil, nil)
+	redirect, err := url.Parse(w.Header().Get("Location"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if w.Code != 302 || redirect.Query().Get("code_challenge_method") != "S256" || redirect.Query().Get("nonce") == "" || redirect.Query().Get("state") == "" {
+		t.Fatal("missing PKCE/state/nonce")
+	}
+	for i := 0; i < maxOIDCEntries; i++ {
+		o.flows[randomOIDCToken()] = oidcFlow{expires: time.Now().Add(time.Minute)}
+	}
+	if oidcRequest(h.ManagementLogin, "GET", "/", nil, nil).Code != 429 {
+		t.Fatal("unbounded login transactions")
+	}
+}
+
+func TestOIDCCallbackBrowserBinding(t *testing.T) {
+	for _, tc := range []struct {
+		name, cookie string
+		expired      bool
+	}{
+		{"missing cookie", "", false}, {"tampered cookie", "other", false}, {"expired transaction", "binding", true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			o := testOIDC()
+			expiry := time.Now().Add(time.Minute)
+			if tc.expired {
+				expiry = time.Now().Add(-time.Minute)
+			}
+			o.flows["binding"] = oidcFlow{state: "state", expires: expiry}
+			h := &Handler{oidc: o}
+			w := oidcRequest(h.ManagementCallback, "GET", "/v0/management/callback?state=state&code=code", []*http.Cookie{{Name: flowCookie, Value: tc.cookie}}, nil)
+			if w.Code != 400 || len(o.sessions) != 0 {
+				t.Fatal("accepted unbound or expired callback")
+			}
+		})
+	}
+}
