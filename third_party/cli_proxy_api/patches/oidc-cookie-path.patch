+	"net/http/cookiejar"
@@ -103,0 +105,48 @@ func TestManagementOIDCAuthenticationBoundary(t *testing.T) {
+func TestManagementOIDCLegacyCookiesAreExpiredOnSessionCheck(t *testing.T) {
+	jar, err := cookiejar.New(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	modelURL, err := url.Parse("https://admin.example/v1/chat/completions")
+	if err != nil {
+		t.Fatal(err)
+	}
+	sessionURL, err := url.Parse("https://admin.example/v8/management/auth/session")
+	if err != nil {
+		t.Fatal(err)
+	}
+	legacyCookies := []*http.Cookie{
+		{Name: managementOIDCLegacySessionCookie, Value: "old-session", Path: managementOIDCLegacyCookiePath, Secure: true, HttpOnly: true},
+		{Name: managementOIDCLegacyFlowCookie, Value: "old-flow", Path: managementOIDCLegacyCookiePath, Secure: true, HttpOnly: true},
+	}
+	jar.SetCookies(modelURL, legacyCookies)
+	if got := jar.Cookies(modelURL); len(got) != len(legacyCookies) {
+		t.Fatalf("legacy cookies were not stored for the root-scoped model route: got %d", len(got))
+	}
+
+	h := &Handler{oidc: testManagementOIDC()}
+	response := managementOIDCRequest(h.ManagementOIDCSession, http.MethodGet, sessionURL.String(), jar.Cookies(sessionURL), nil)
+	if response.Code != http.StatusOK {
+		t.Fatalf("session check status=%d want=%d", response.Code, http.StatusOK)
+	}
+	deleted := make(map[string]bool)
+	for _, cookie := range response.Result().Cookies() {
+		if cookie.Name != managementOIDCLegacySessionCookie && cookie.Name != managementOIDCLegacyFlowCookie {
+			continue
+		}
+		if cookie.Path != managementOIDCLegacyCookiePath || cookie.MaxAge >= 0 || !cookie.Secure || !cookie.HttpOnly || cookie.Domain != "" {
+			t.Errorf("legacy cookie %q was not expired with its original root-scoped host-only attributes: %+v", cookie.Name, cookie)
+		}
+		deleted[cookie.Name] = true
+	}
+	for _, cookie := range legacyCookies {
+		if !deleted[cookie.Name] {
+			t.Errorf("session check did not expire legacy cookie %q", cookie.Name)
+		}
+	}
+	jar.SetCookies(sessionURL, response.Result().Cookies())
+	if got := jar.Cookies(modelURL); len(got) != 0 {
+		t.Fatalf("legacy cookies remained attached to the root-scoped model route after cleanup: %+v", got)
+	}
+}
+
