diff --git a/src/services/api/managementSession.ts b/src/services/api/managementSession.ts
new file mode 100644
index 0000000..44f06c7
--- /dev/null
+++ b/src/services/api/managementSession.ts
@@ -0,0 +1,33 @@
+// Browser sessions are deliberately same-origin. Custom API bases use management keys.
+export interface ManagementSession {
+  oidcEnabled: boolean;
+  authenticated: boolean;
+}
+
+export async function discoverManagementSession(): Promise<ManagementSession | null> {
+  try {
+    const response = await fetch('/v0/management/session', {
+      credentials: 'same-origin',
+      cache: 'no-store',
+      signal: AbortSignal.timeout(10000),
+    });
+    // Older backends do not implement session discovery.
+    if (!response.ok) return null;
+    const session = await response.json();
+    if (typeof session.oidcEnabled !== 'boolean' || typeof session.authenticated !== 'boolean') {
+      return null;
+    }
+    return session;
+  } catch {
+    return null;
+  }
+}
+
+export async function endManagementSession(): Promise<void> {
+  const response = await fetch('/v0/management/logout', {
+    method: 'POST',
+    credentials: 'same-origin',
+    headers: { 'X-Management-CSRF': '1' },
+  });
+  if (!response.ok) throw new Error('Could not sign out. Please try again.');
+}
