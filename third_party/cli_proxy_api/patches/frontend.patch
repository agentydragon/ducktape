diff --git a/tests/managementSession.test.ts b/tests/managementSession.test.ts
new file mode 100644
index 0000000..ac0f171
--- /dev/null
+++ b/tests/managementSession.test.ts
@@ -0,0 +1,58 @@
+import { afterEach, test } from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  discoverManagementSession,
+  endManagementSession,
+} from '../src/services/api/managementSession.ts';
+
+const originalFetch = globalThis.fetch;
+afterEach(() => {
+  globalThis.fetch = originalFetch;
+});
+
+test('discovers a same-origin browser session without a management key', async () => {
+  globalThis.fetch = async (url, init) => {
+    assert.equal(url, '/v0/management/session');
+    assert.equal(init?.credentials, 'same-origin');
+    assert.equal(init?.cache, 'no-store');
+    assert.equal(init?.headers, undefined);
+    return Response.json({ oidcEnabled: true, authenticated: true });
+  };
+  assert.deepEqual(await discoverManagementSession(), { oidcEnabled: true, authenticated: true });
+});
+
+test('discovers enabled OIDC before the user signs in', async () => {
+  globalThis.fetch = async () => Response.json({ oidcEnabled: true, authenticated: false });
+  assert.deepEqual(await discoverManagementSession(), { oidcEnabled: true, authenticated: false });
+});
+
+test('old backends and invalid discovery responses retain key login', async () => {
+  for (const response of [
+    new Response('', { status: 404 }),
+    Response.json({}),
+    Response.json({ oidcEnabled: 'true', authenticated: true }),
+  ]) {
+    globalThis.fetch = async () => response;
+    assert.equal(await discoverManagementSession(), null);
+  }
+  globalThis.fetch = async () => {
+    throw new TypeError('Network unavailable');
+  };
+  assert.equal(await discoverManagementSession(), null);
+});
+
+test('logout uses a same-origin POST with the CSRF header', async () => {
+  globalThis.fetch = async (url, init) => {
+    assert.equal(url, '/v0/management/logout');
+    assert.equal(init?.method, 'POST');
+    assert.equal(init?.credentials, 'same-origin');
+    assert.deepEqual(init?.headers, { 'X-Management-CSRF': '1' });
+    return new Response(null, { status: 204 });
+  };
+  await endManagementSession();
+});
+
+test('logout failures remain visible instead of pretending the session ended', async () => {
+  globalThis.fetch = async () => new Response('', { status: 503 });
+  await assert.rejects(endManagementSession(), /Could not sign out/);
+});
