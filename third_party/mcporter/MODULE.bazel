module(
    name = "ducktape_mcporter",
    version = "0.1.0",
)

bazel_dep(name = "aspect_rules_js", version = "2.9.2")
bazel_dep(name = "rules_nodejs", version = "6.7.3")
bazel_dep(name = "rules_pkg", version = "1.2.0")

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "22.11.0")

pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
pnpm.pnpm(
    pnpm_version = "9.15.9",
    pnpm_version_integrity = "sha512-aARhQYk8ZvrQHAeSMRKOmvuJ74fiaR1p5NQO7iKJiClf1GghgbrlW1hBjDolO95lpQXsfF+UA+zlzDzTfc8lMQ==",
)
use_repo(pnpm, "pnpm")

npm_mcporter = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm", isolate = True)
npm_mcporter.npm_translate_lock(
    name = "npm_mcporter",
    data = [
        "//:package.json",
        "//:pnpm-workspace.yaml",
    ],
    link_workspace = "ducktape_mcporter",
    npmrc = "//:.npmrc",
    pnpm_lock = "//:pnpm-lock.yaml",
    update_pnpm_lock = True,
    use_pnpm = "@pnpm//:package/bin/pnpm.cjs",
)
use_repo(npm_mcporter, "npm_mcporter")
