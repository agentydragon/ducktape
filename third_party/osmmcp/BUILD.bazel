"""Container image for osmmcp (github.com/NERVsystems/osmmcp).

An OpenStreetMap MCP server: geocoding via Nominatim, routing via OSRM, place
lookup via Overpass. Public, anonymous, read-only upstream APIs — no secret,
no per-operator identity. Speaks Streamable HTTP natively (no stdio-bridge
sidecar needed, unlike third_party/manifold_mcp_server).

Load for local testing:
  bazel run //third_party/osmmcp:load
  docker run --rm -p 7082:7082 osm-mcp:latest
"""

load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files", "strip_prefix")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

# osmmcp has no cgo usage, so rules_go's default pure="auto" already builds it
# fully static — it runs unmodified on the distroless/static base below, which
# ships no libc at all.
pkg_files(
    name = "osmmcp_bin_files",
    srcs = ["@com_github_nervsystems_osmmcp//cmd/osmmcp"],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "/usr/local/bin",
    renames = {"@com_github_nervsystems_osmmcp//cmd/osmmcp": "osmmcp"},
    strip_prefix = strip_prefix.files_only(),
)

pkg_tar(
    name = "osmmcp_layer",
    srcs = [":osmmcp_bin_files"],
)

oci_image(
    name = "image",
    base = "@distroless_static_debian12_linux_amd64",
    entrypoint = [
        "/usr/local/bin/osmmcp",
        "--enable-http",
        "--http-only",
        "--http-addr",
        ":7082",
        "--http-auth-type",
        "none",
        "--enable-monitoring=false",
        "--user-agent",
        "ducktape-haku-osmmcp/1.0 (contact: agentydragon@gmail.com)",
    ],
    exposed_ports = ["7082/tcp"],
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [":osmmcp_layer"],
    visibility = ["//visibility:public"],
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["osm-mcp:latest"],
)
