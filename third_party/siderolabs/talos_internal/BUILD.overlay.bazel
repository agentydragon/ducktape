# Build file overlay for @talos_internal http_archive.
#
# Defines go_library targets for Talos internal packages used by kubespand.
# Each target's importpath matches the original Talos internal path, so
# consumer code uses the same import paths as upstream Talos.
# Patches in patches/ are applied at archive fetch time (see MODULE.bazel).

load("@io_bazel_rules_go//go:def.bzl", "go_library")

_P = "internal/app/machined/pkg/"

# ─ Adapters ───────────────────────────────────────────────────────────────

go_library(
    name = "adapters_wireguard",
    srcs = [_P + "adapters/wireguard/wireguard.go"],
    importpath = "github.com/siderolabs/talos/" + _P + "adapters/wireguard",
    visibility = ["//visibility:public"],
)

go_library(
    name = "adapters_kubespan",
    srcs = [
        _P + "adapters/kubespan/identity.go",
        _P + "adapters/kubespan/peer_status.go",
    ],
    importpath = "github.com/siderolabs/talos/" + _P + "adapters/kubespan",
    visibility = ["//visibility:public"],
    deps = [
        ":adapters_wireguard",
        "@com_github_mdlayher_netx//eui64",
        "@com_github_siderolabs_gen//value",
        "@com_github_siderolabs_talos_pkg_machinery//resources/kubespan",
        "@com_github_siderolabs_talos_pkg_machinery//resources/network",
        "@com_zx2c4_golang_wireguard_wgctrl//wgtypes",
        "@org_go4_netipx//:netipx",
    ],
)

go_library(
    name = "adapters_network",
    srcs = [
        _P + "adapters/network/ipset.go",
        _P + "adapters/network/network.go",
        _P + "adapters/network/nftables_rule.go",
    ],
    importpath = "github.com/siderolabs/talos/" + _P + "adapters/network",
    visibility = ["//visibility:public"],
    deps = [
        "@com_github_google_nftables//:nftables",
        "@com_github_google_nftables//binaryutil",
        "@com_github_google_nftables//expr",
        "@com_github_siderolabs_gen//xslices",
        "@com_github_siderolabs_talos_pkg_machinery//nethelpers",
        "@com_github_siderolabs_talos_pkg_machinery//resources/network",
        "@org_go4_netipx//:netipx",
        "@org_golang_x_sys//unix",
    ],
)

# ─ Controllers — kubespan ─────────────────────────────────────────────────
# NOTE: kubespand extends this package with peer_spec_filters.go locally
# via //cluster/kubespand/peerspec (embeds this target + adds local file).

go_library(
    name = "controllers_kubespan",
    srcs = [
        _P + "controllers/kubespan/endpoint.go",
        _P + "controllers/kubespan/peer_spec.go",
        _P + "controllers/kubespan/routing_rules.go",
    ],
    importpath = "github.com/siderolabs/talos/" + _P + "controllers/kubespan",
    visibility = ["//visibility:public"],
    deps = [
        "@com_github_cosi_project_runtime//pkg/controller",
        "@com_github_cosi_project_runtime//pkg/resource",
        "@com_github_cosi_project_runtime//pkg/safe",
        "@com_github_cosi_project_runtime//pkg/state",
        "@com_github_hashicorp_go_multierror//:go-multierror",
        "@com_github_jsimonetti_rtnetlink_v2//:rtnetlink",
        "@com_github_siderolabs_gen//optional",
        "@com_github_siderolabs_gen//value",
        "@com_github_siderolabs_gen//xslices",
        "@com_github_siderolabs_go_pointer//:go-pointer",
        "@com_github_siderolabs_talos_pkg_machinery//constants",
        "@com_github_siderolabs_talos_pkg_machinery//resources/cluster",
        "@com_github_siderolabs_talos_pkg_machinery//resources/config",
        "@com_github_siderolabs_talos_pkg_machinery//resources/kubespan",
        "@org_go4_netipx//:netipx",
        "@org_golang_x_sys//unix",
        "@org_uber_go_zap//:zap",
    ],
)

# ─ Controllers — network ─────────────────────────────────────────────────

go_library(
    name = "controllers_network_watch",
    srcs = [
        _P + "controllers/network/watch/rtnetlink.go",
        _P + "controllers/network/watch/trigger.go",
        _P + "controllers/network/watch/watch.go",
    ],
    importpath = "github.com/siderolabs/talos/" + _P + "controllers/network/watch",
    visibility = ["//visibility:public"],
    deps = [
        "@com_github_jsimonetti_rtnetlink_v2//:rtnetlink",
        "@com_github_mdlayher_netlink//:netlink",
        "@org_golang_x_time//rate",
    ],
)

go_library(
    name = "controllers_network_addressutil",
    srcs = [_P + "controllers/network/internal/addressutil/broadcast.go"],
    importpath = "github.com/siderolabs/talos/" + _P + "controllers/network/internal/addressutil",
    visibility = ["//visibility:public"],
    deps = ["@org_go4_netipx//:netipx"],
)

go_library(
    name = "controllers_network",
    srcs = [
        _P + "controllers/network/address_spec.go",
        _P + "controllers/network/nftables_chain.go",
        _P + "controllers/network/route_spec.go",
    ],
    importpath = "github.com/siderolabs/talos/" + _P + "controllers/network",
    visibility = ["//visibility:public"],
    deps = [
        ":adapters_network",
        ":controllers_network_addressutil",
        ":controllers_network_watch",
        "@com_github_cosi_project_runtime//pkg/controller",
        "@com_github_cosi_project_runtime//pkg/resource",
        "@com_github_cosi_project_runtime//pkg/safe",
        "@com_github_google_nftables//:nftables",
        "@com_github_google_nftables//expr",
        "@com_github_hashicorp_go_multierror//:go-multierror",
        "@com_github_jsimonetti_rtnetlink_v2//:rtnetlink",
        "@com_github_mdlayher_arp//:arp",
        "@com_github_siderolabs_gen//value",
        "@com_github_siderolabs_go_pointer//:go-pointer",
        "@com_github_siderolabs_talos_pkg_machinery//constants",
        "@com_github_siderolabs_talos_pkg_machinery//nethelpers",
        "@com_github_siderolabs_talos_pkg_machinery//resources/network",
        "@org_golang_x_sys//unix",
        "@org_uber_go_zap//:zap",
    ],
)
