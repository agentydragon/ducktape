module(
    name = "ducktape_iron_proxy",
    version = "0.1.0",
)

bazel_dep(name = "gazelle", version = "0.54.0", repo_name = "bazel_gazelle")
bazel_dep(name = "rules_go", version = "0.63.0", repo_name = "io_bazel_rules_go")

go_deps = use_extension("@bazel_gazelle//:extensions.bzl", "go_deps", isolate = True)
go_deps.from_file(go_mod = "//:go.mod")
go_deps.module(
    path = "github.com/ironsh/iron-proxy",
    version = "v0.53.1-0.20261016193733-7c6a6e9261f0",
)
go_deps.archive_override(
    patch_strip = 1,
    patches = ["//:schema.patch"],
    path = "github.com/ironsh/iron-proxy",
    sha256 = "4db7516e515e40aec6a339574b5383639a2ab7c74f76eee93ef53f05b3e2c299",
    strip_prefix = "iron-proxy-7c6a6e9261f09aa4f4efdb0bc20bdbbfb306603d",
    urls = ["https://github.com/paradigmxyz/iron-proxy/archive/7c6a6e9261f09aa4f4efdb0bc20bdbbfb306603d.tar.gz"],
)

# This is a reuse experiment: expose internal packages through Bazel aliases without changing Go
# sources. Use the checked-in protobuf output rather than generating a second copy of gRPC.
go_deps.gazelle_override(
    build_file_generation = "on",
    directives = [
        "gazelle:proto disable",
        "gazelle:exclude proto",
        "gazelle:go_visibility //visibility:public",
    ],
    path = "github.com/ironsh/iron-proxy",
)
use_repo(go_deps, "com_github_ironsh_iron_proxy", "org_golang_x_net")

# A second isolated source graph runs the same scenarios with only the response-flush patch.
# Separate test binaries avoid linking two package definitions with the same Go import path.
patched_go_deps = use_extension("@bazel_gazelle//:extensions.bzl", "go_deps", isolate = True)
patched_go_deps.from_file(go_mod = "//:go.mod")
patched_go_deps.module(
    path = "github.com/ironsh/iron-proxy",
    version = "v0.53.1-0.20261016193733-7c6a6e9261f0",
)
patched_go_deps.archive_override(
    patch_strip = 1,
    patches = [
        "//:schema.patch",
        "//:streaming.patch",
    ],
    path = "github.com/ironsh/iron-proxy",
    sha256 = "4db7516e515e40aec6a339574b5383639a2ab7c74f76eee93ef53f05b3e2c299",
    strip_prefix = "iron-proxy-7c6a6e9261f09aa4f4efdb0bc20bdbbfb306603d",
    urls = ["https://github.com/paradigmxyz/iron-proxy/archive/7c6a6e9261f09aa4f4efdb0bc20bdbbfb306603d.tar.gz"],
)
patched_go_deps.gazelle_override(
    build_file_generation = "on",
    directives = [
        "gazelle:proto disable",
        "gazelle:go_visibility //visibility:public",
    ],
    path = "github.com/ironsh/iron-proxy",
)
use_repo(
    patched_go_deps,
    com_github_ironsh_iron_proxy_patched = "com_github_ironsh_iron_proxy",
    org_golang_x_net_patched = "org_golang_x_net",
)
