"""Bazel OCI image for ActivityWatch (aw-server-rust + aw-webui).

The Rust binary (aw-server) embeds the web UI at compile time via rust-embed's
interpolate-folder-path feature: build.rs reads AW_WEBUI_DIR and emits
cargo:rustc-env=AW_WEBUI_DIR=<path> so the proc macro can embed all files.

Load for local testing:
  bazel run @ducktape_activitywatch//:load
  docker run --rm -p 5600:5600 -v /tmp/aw-data:/data aw-server:latest
"""

load("@aspect_rules_js//js:defs.bzl", "js_test")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files", "strip_prefix")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

js_test(
    name = "vue_demi_vue2_test",
    data = [
        "@aw_webui//:node_modules/pinia",
        "@aw_webui//:node_modules/vue",
        "@aw_webui//:node_modules/vue-demi",
        "@aw_webui//:package.json",
    ],
    entry_point = "vue_demi_vue2_test.mjs",
    env = {"AW_WEBUI_PACKAGE_JSON": "$(rootpath @aw_webui//:package.json)"},
    no_copy_to_bin = ["@aw_webui//:package.json"],
)

sh_test(
    name = "webui_dist_test",
    srcs = ["webui_dist_test.sh"],
    args = ["$(rootpath @aw_webui//:dist)"],
    data = ["@aw_webui//:dist"],
)

test_suite(
    name = "tests",
    tests = [
        ":vue_demi_vue2_test",
        ":webui_dist_test",
        "@aw_server_rust//:aw_sync_tests",
    ],
)

# The aw-webui frontend bundle is built by @aw_webui//:dist using upstream's
# Vue CLI production path. It is wired into the Rust build via
# crate.annotation in MODULE.bazel so aw-server embeds all assets at compile
# time.  No additional targets are needed here for the JS side.

# --- OCI image ---------------------------------------------------------------

pkg_files(
    name = "activitywatch_bin_files",
    srcs = [
        "@aw_server_rust//:aw_server_bin",
    ],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "/usr/local/bin",
    renames = {
        "@aw_server_rust//:aw_server_bin": "aw-server",
    },
    strip_prefix = strip_prefix.files_only(),
)

pkg_tar(
    name = "activitywatch_layer",
    srcs = [":activitywatch_bin_files"],
)

oci_image(
    name = "image",
    # Use Debian 13 (Trixie, glibc 2.40) instead of Debian 12 (glibc 2.36).
    # The aw-server binary is compiled on rbe-ubuntu24-04 (glibc 2.39) and
    # fails at runtime with "GLIBC_2.39 not found" on Debian 12.
    # See the module-local MODULE.bazel distroless_cc_debian13 comment for details.
    base = "@distroless_cc_debian13_linux_amd64",
    entrypoint = [
        "/usr/local/bin/aw-server",
        "--host",
        "0.0.0.0",
        "--port",
        "5600",
        "--dbpath",
        "/data/db.sqlite3",
    ],
    exposed_ports = ["5600/tcp"],
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [":activitywatch_layer"],
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["aw-server:latest"],
)
