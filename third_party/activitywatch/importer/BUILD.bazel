"""Idempotent one-way importer of per-device ActivityWatch snapshots into a
central aw-server over its REST API.

The central store is written only through @aw_server_rust//:aw_client_rust (HTTP),
so the running aw-server stays the sole writer of its SQLite file; source snapshots
are read read-only via @aw_server_crates//:rusqlite. It shares nothing with
aw-sync's push/pull machinery.

Not reached by the root `bazel test //...` sweep -- this is a nested module
(.bazelignore'd at the root). Build/test it by module label:
  bbr test @ducktape_activitywatch//importer:aw_importer_test
"""

load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

rust_library(
    name = "aw_importer",
    srcs = [
        "lib.rs",
        "snapshot.rs",
    ],
    crate_root = "lib.rs",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "@aw_server_crates//:chrono",
        "@aw_server_crates//:reqwest",
        "@aw_server_crates//:rusqlite",
        "@aw_server_crates//:serde_json",
        "@aw_server_crates//:thiserror",
        "@aw_server_rust//:aw_client_rust",
        "@aw_server_rust//:aw_models",
    ],
)

rust_binary(
    name = "aw_importer_bin",
    srcs = ["main.rs"],
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        ":aw_importer",
        "@aw_server_crates//:clap",
        "@aw_server_crates//:tokio",
        "@aw_server_rust//:aw_client_rust",
    ],
)

rust_test(
    name = "aw_importer_test",
    size = "small",
    srcs = ["import_test.rs"],
    crate_root = "import_test.rs",
    data = ["@aw_server_rust//:aw_server_bin"],
    edition = "2024",
    # The test spins up the real aw-server binary and imports into it over HTTP.
    # rlocationpath resolves the binary from the test's runfiles; single-threaded
    # so the one-time XDG/HOME setup for the in-process AwClient can't race.
    env = {
        "AW_SERVER_BIN": "$(rlocationpath @aw_server_rust//:aw_server_bin)",
        "RUST_TEST_THREADS": "1",
    },
    deps = [
        ":aw_importer",
        "@aw_server_crates//:chrono",
        "@aw_server_crates//:rusqlite",
        "@aw_server_crates//:serde_json",
        "@aw_server_crates//:tokio",
        "@aw_server_rust//:aw_client_rust",
        "@aw_server_rust//:aw_datastore",
        "@aw_server_rust//:aw_models",
        "@rules_rust//rust/runfiles",
    ],
)
