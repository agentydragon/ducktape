"""Injected BUILD file for the @aw_webui http_archive.

Runs upstream's Vue CLI production build to produce :dist (a TreeArtifact).
The Rust binary embeds this at compile time through AW_WEBUI_DIR.

Build the bundle:
  bazel build @aw_webui//:dist
"""

load("@aspect_rules_js//js:defs.bzl", "js_run_binary")
load("@npm_aw_webui//:@vue/cli-service/package_json.bzl", vue_cli_service_bin = "bin")
load("@npm_aw_webui//:defs.bzl", "npm_link_all_packages")

exports_files(["package-lock.json"])

npm_link_all_packages(name = "node_modules")

vue_cli_service_bin.vue_cli_service_binary(
    name = "vue_cli_service",
    visibility = ["//visibility:public"],
)

# aw-webui's Makefile copies these files from its media submodule before build.
genrule(
    name = "logo_png",
    srcs = ["@aw_media//:logo/logo.png"],
    outs = ["static/logo.png"],
    cmd = "cp $< $@",
)

genrule(
    name = "logo_svg",
    srcs = ["@aw_media//:logo/logo.svg"],
    outs = ["static/logo.svg"],
    cmd = "cp $< $@",
)

# Reproduce aw-webui's `npm run build`, whose webpack-era output layout is the
# one aw-server-rust serves natively. chdir = "." normalizes to the external
# repository's directory in BAZEL_BINDIR, alongside node_modules and sources.
js_run_binary(
    name = "dist",
    srcs = [
        ".eslintignore",
        ".eslintrc.json",
        "babel.config.cjs",
        "index.html",
        "package.json",
        "tsconfig.json",
        "tsconfig.node.json",
        "vue.config.js",
        ":logo_png",
        ":logo_svg",
        ":node_modules",
    ] + glob(
        [
            "src/**",
            "static/**",
        ],
        allow_empty = False,
    ),
    args = [
        "build",
        "--dest",
        "dist",
    ],
    chdir = ".",
    env = {
        "NODE_ENV": "production",
        # The source is an archive, not a Git checkout. Inject the exact pinned
        # revision instead of letting vue.config.js shell out to Git.
        "COMMIT_HASH": "3cbe349",
    },
    out_dirs = ["dist"],
    tool = ":vue_cli_service",
    visibility = ["//visibility:public"],
)
