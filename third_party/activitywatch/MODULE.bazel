module(
    name = "ducktape_activitywatch",
    version = "0.1.0",
)

bazel_dep(name = "package_metadata", version = "0.0.6")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_pkg", version = "1.2.0")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "aspect_rules_js", version = "2.9.2")
bazel_dep(name = "rules_nodejs", version = "6.7.5")
bazel_dep(name = "rules_rust", version = "0.70.0")

# Node.js toolchain
node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "22.11.0")  # LTS 'Jod'

# Pin pnpm v9 to match pnpm-lock.yaml's lockfileVersion 9 format.
pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
pnpm.pnpm(
    pnpm_version = "9.15.9",
    pnpm_version_integrity = "sha512-aARhQYk8ZvrQHAeSMRKOmvuJ74fiaR1p5NQO7iKJiClf1GghgbrlW1hBjDolO95lpQXsfF+UA+zlzDzTfc8lMQ==",
)
use_repo(pnpm, "pnpm")

# aw-webui standalone npm universe.
#
# update_pnpm_lock is disabled because pnpm_lock and npm_package_lock are in
# different Bazel workspaces (// vs @aw_webui), and rules_js's seed_root check
# rejects that combination. To regenerate after bumping the aw_webui archive,
# run this from third_party/activitywatch:
#   bazel run @pnpm//:package/bin/pnpm.cjs -- import \
#        --lockfile-dir . \
#        $(bazel info output_base)/external/aw_webui+/package-lock.json
# Or copy upstream package-lock.json to a temp dir, run `pnpm import`, then copy
# the generated pnpm-lock.yaml back here.
npm_activitywatch = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm", isolate = True)
npm_activitywatch.npm_translate_lock(
    name = "npm_aw_webui",
    bins = {
        "@vue/cli-service": ["vue-cli-service=./bin/vue-cli-service.js"],
    },
    # link_workspace must point to @aw_webui so generated store-target labels
    # resolve in the http_archive where npm_link_all_packages() creates them.
    link_workspace = "aw_webui",
    npmrc = "//:.npmrc",
    # vue-demi's postinstall switches lib/index.mjs to the correct Vue version
    # variant, but lifecycle hooks are disabled in sandboxed builds. Patch the
    # default (Vue 3) stub to add the missing hasInjectionContext export that
    # pinia@2.1.7 imports.
    patches = {
        "vue-demi@0.14.10": ["//patches:vue-demi-has-injection-context.patch"],
    },
    pnpm_lock = "//:pnpm-lock.yaml",
    # aw-webui imports axios directly (via NewReleaseNotification.vue) but
    # axios is only a dependency of aw-client, not aw-webui itself.
    # pnpm strict mode hides phantom deps; hoist axios so webpack can resolve it.
    public_hoist_packages = {
        "axios": [""],
        # webpack loaders and source files rely on npm's flat tree for these
        # packages; select the versions exposed at the root of package-lock.json.
        "autoprefixer@10.4.27": [""],
        "d3-shape@3.2.0": [""],
        # vue.config.js imports yargs, but upstream relies on npm's flat tree
        # to expose this transitive package.
        "yargs@16.2.0": [""],
    },
    run_lifecycle_hooks = False,
    update_pnpm_lock = False,
    use_pnpm = "@pnpm//:package/bin/pnpm.cjs",
)
use_repo(npm_activitywatch, "npm_aw_webui")

# Rust toolchain
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = ["1.88.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# Separate from the main Ducktape crate universe to avoid Cargo.lock conflicts.
aw_crate = use_extension(
    "@rules_rust//crate_universe:extensions.bzl",
    "crate",
    isolate = True,
)
aw_crate.from_cargo(
    name = "aw_server_crates",
    cargo_lockfile = "@aw_server_rust//:Cargo.lock",
    lockfile = "//:Cargo.Bazel.lock",
    manifests = [
        "@aw_server_rust//:Cargo.toml",
        "@aw_server_rust//:aw-client-rust/Cargo.toml",
        "@aw_server_rust//:aw-datastore/Cargo.toml",
        "@aw_server_rust//:aw-models/Cargo.toml",
        "@aw_server_rust//:aw-query/Cargo.toml",
        "@aw_server_rust//:aw-server/Cargo.toml",
        "@aw_server_rust//:aw-sync/Cargo.toml",
        "@aw_server_rust//:aw-transform/Cargo.toml",
    ],
)

# build.rs reads AW_WEBUI_DIR and emits cargo:rustc-env=AW_WEBUI_DIR=<path>
# so rust-embed's interpolate-folder-path proc macro can embed all web assets.
aw_crate.annotation(
    build_script_data = ["@aw_webui//:dist"],
    build_script_env = {
        "AW_WEBUI_DIR": "$(execpath @aw_webui//:dist)",
    },
    compile_data = ["@aw_webui//:dist"],
    crate = "aw-server",
    repositories = ["aw_server_crates"],
)
use_repo(aw_crate, "aw_server_crates")

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")

# Distroless cc Debian 13 (Trixie): glibc 2.40.
# aw-server-rust is compiled by the RBE worker (rbe-ubuntu24-04, glibc 2.39) and
# therefore requires GLIBC_2.39 at runtime. Debian 12 distroless only has 2.36,
# so aw-server fails with "version 'GLIBC_2.39' not found". Debian 13 (glibc
# 2.40) satisfies GLIBC_2.39 requirements. If the RBE toolchain ever upgrades
# past glibc 2.40, bump this base image again.
# To update: docker manifest inspect gcr.io/distroless/cc-debian13:latest | \
#   python3 -c "import sys,json; [print(m['digest']) for m in json.load(sys.stdin)['manifests'] if m['platform']['architecture']=='amd64']"
oci.pull(
    name = "distroless_cc_debian13",
    digest = "sha256:e1cc90d06703f5dc30ae869fbfce78fce688f21a97efecd226375233a882e62f",
    image = "gcr.io/distroless/cc-debian13",
    platforms = ["linux/amd64"],
    tag = "latest",
)
use_repo(oci, "distroless_cc_debian13", "distroless_cc_debian13_linux_amd64")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# aw-webui's media directory is a nested submodule. Pull its exact pinned commit
# so the Bazel build performs the same logo-copy prebuild step as upstream.
http_archive(
    name = "aw_media",
    build_file = "//:aw-media.BUILD.bazel",
    sha256 = "68437b9877321dee09f9419445d99c8aefa6bceac8439ac11228cd9ccbaab437",
    strip_prefix = "media-a45151442aa33ed13d4fff8163bbb9b9e7636cee",
    urls = ["https://github.com/ActivityWatch/media/archive/a45151442aa33ed13d4fff8163bbb9b9e7636cee.tar.gz"],
)

# aw-webui: frontend for aw-server-rust, pinned to the submodule commit used by
# aw-server-rust @ c8533a0. BUILD file is overlaid.
_AW_WEBUI_COMMIT = "3cbe34999addfb199c4afb3725494e0db26c00f5"

http_archive(
    name = "aw_webui",
    build_file = "//:aw-webui.BUILD.bazel",
    patch_args = ["-p1"],
    patches = ["//patches:aw-webui-hermetic-proxy-build.patch"],
    sha256 = "98cf5b4edbfe2c82de359a0819953bad7694d2cc13e4a09eaabcdd6d08d85c54",
    strip_prefix = "aw-webui-" + _AW_WEBUI_COMMIT,
    urls = ["https://github.com/ActivityWatch/aw-webui/archive/" + _AW_WEBUI_COMMIT + ".tar.gz"],
)

# aw-server-rust: Rust backend that embeds aw-webui at compile time via rust-embed.
_AW_SERVER_RUST_COMMIT = "c8533a0019ea86312b9dffc8a0dd3ae8483abae2"

http_archive(
    name = "aw_server_rust",
    build_file = "//:aw-server-rust.BUILD.bazel",
    patch_args = ["-p1"],
    patches = [
        "//patches:aw-server-rust-rustls.patch",
    ],
    sha256 = "7ddbcdbfee7f58c290728a0357a06ca6cedf303a69e5fef8f18dfd5f394e3463",
    strip_prefix = "aw-server-rust-" + _AW_SERVER_RUST_COMMIT,
    urls = ["https://github.com/ActivityWatch/aw-server-rust/archive/" + _AW_SERVER_RUST_COMMIT + ".tar.gz"],
)
