"""Sidecar image for the Manifold Markets MCP server.

Runs the stdio-only bmorphism/manifold-mcp-server npm package wrapped as a
Streamable HTTP endpoint via supergateway, listening on localhost:8080/mcp.
The mcp-oauth-facade container in the same pod connects to it as an
HttpUpstream (no stdio across container boundaries).
"""

load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_run_binary")
load("@npm_manifold_mcp_server//:defs.bzl", "npm_link_all_packages")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

npm_link_all_packages(name = "node_modules")

js_binary(
    name = "bundle_bridge_bin",
    data = [":node_modules"],
    entry_point = "bundle_bridge.mjs",
    visibility = ["//visibility:private"],
)

js_run_binary(
    name = "bridge_bundle",
    srcs = ["bundle_bridge.mjs"],
    outs = [
        "bridge",
        "manifold-mcp-server.mjs",
        "supergateway.mjs",
    ],
    args = [
        "bridge",
        "manifold-mcp-server.mjs",
        "supergateway.mjs",
    ],
    chdir = ".",
    tool = ":bundle_bridge_bin",
)

pkg_tar(
    name = "bridge_layer",
    srcs = [":bridge_bundle"],
    mode = "0555",
    package_dir = "/app",
)

oci_image(
    name = "image",
    base = "@node_20_bookworm_slim_linux_amd64",
    entrypoint = ["/app/bridge"],
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [":bridge_layer"],
    visibility = ["//visibility:public"],
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["manifold-mcp-server:latest"],
)
