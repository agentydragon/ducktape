    "pool_then": "max by (node, storage_pool) (lvm_thin_pool_data_percent offset 7d)",
    "pool_range_max": "max by (node, storage_pool) (max_over_time(lvm_thin_pool_data_percent[7d]))",
    "pool_range_count": "max by (node, storage_pool) (count_over_time(lvm_thin_pool_data_percent[7d]))",
    "pvc_capacity": "max by (namespace,persistentvolumeclaim) (kubelet_volume_stats_capacity_bytes)",
    "pvc_used": "max by (namespace,persistentvolumeclaim) (kubelet_volume_stats_used_bytes)",
    "seaweed_deleted": "max by (pod) (SeaweedFS_volumeServer_total_disk_size{namespace=\"seaweedfs\",type=\"deleted_bytes\"})",
    "pool_committed": "disk_usage:pool_committed_bytes",
    "definitions": "disk_usage:volume_capacity_bytes{storage_pool=\"hdd\"}",
    "allocations": "disk_usage:volume_allocated_bytes{storage_pool=\"hdd\"}",
    "zot_manifest_gets": "sum(count_over_time({namespace=\"oci-cache\",container=\"zot\"} |= \"HTTP API\" | json | message=\"HTTP API\" | method=\"GET\" | path=~\"/v2/.*/manifests/.*\" | statusCode=\"200\" | __error__=\"\" [24h]))",
    "zot_blob_bytes": "sum(sum_over_time({namespace=\"oci-cache\",container=\"zot\"} |= \"HTTP API\" | json | message=\"HTTP API\" | method=\"GET\" | path=~\"/v2/.*/blobs/.*\" | statusCode=~\"200|206\" | unwrap bodySize | __error__=\"\" [24h]))",
    "zot_manifest_reads": "sum(increase(zot_repo_downloads_total{namespace=\"oci-cache\"}[24h]))",
    "zot_copies": "disk_usage:volume_allocated_bytes{namespace=\"oci-cache\",persistentvolumeclaim=\"zot-cache\"}"
  },
  "model": {
    "limits": "90% of each local thin pool's capacity less diskful LINSTOR volume-definition sizes. This is a final-state declaration model. It holds all other declarations fixed and retains GitLab, both ClickHouse replicas and SeaweedFS's application replication.",
    "clickhouse": "The replacement model removes one 500 GiB definition and adds 300 GiB at each of the two current hosts. GitOps decline or temporary dual definitions, catch-up traffic, volume placement, evacuation, compaction, and filesystem format overhead are outside the model.",
    "seaweed": "Individually derive the largest allowed Seaweed claim on each host after ClickHouse resize by taking the floor in GiB. Divide the observed filesystem bytes used by nominal candidate claim bytes; a formatted filesystem would have less usable space.",
    "change": "Seven-day physical growth is the change in LVM data percent multiplied by the current data LV size. Point-to-point; no time-to-exhaustion estimate.",
    "deletions": "SeaweedFS reports deleted bytes on its volume servers. The counter does not measure available space or bytes LVM would actually recover."
  }
