load("@aspect_rules_py//py:defs.bzl", "py_image_layer", aspect_py_binary = "py_binary")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")
load("//props:oci.bzl", "py_image_entrypoint", "py_image_env")

# ── Build-time spec fixup ────────────────────────────────────────────────────

py_library(
    name = "fix_openapi_spec",
    srcs = ["fix_openapi_spec.py"],
)

py_binary(
    name = "fix_openapi_spec_bin",
    main_module = "grocy_mcp.fix_openapi_spec",
    deps = [":fix_openapi_spec"],
)

genrule(
    name = "grocy_openapi_fixed",
    srcs = ["@grocy_openapi_spec//file"],
    outs = ["grocy.openapi.fixed.json"],
    cmd = "$(execpath :fix_openapi_spec_bin) $(SRCS) $@",
    tools = [":fix_openapi_spec_bin"],
)

# ── Libraries ────────────────────────────────────────────────────────────────

py_library(
    name = "grocy_types",
    srcs = ["grocy_types.py"],
    visibility = ["//visibility:public"],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "mcp_types",
    srcs = ["mcp_types.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":grocy_types",
        "//mcp_infra:persistence",
        "//mcp_infra/authentik_auth:config",
        "@pypi//pydantic",
        "@pypi//pydantic_settings",
        "@pypi//pyyaml",
    ],
)

py_library(
    name = "client",
    srcs = ["client.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":grocy_types",
        "@pypi//httpx",
    ],
)

py_library(
    name = "batch_tools",
    srcs = ["batch_tools.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":client",
        ":grocy_types",
        ":mcp_types",
        "//mcp_infra:request_scoped_openapi",
        "@pypi//fastmcp_slim",
        "@pypi//httpx",
        "@pypi//pydantic",
        "@pypi//tenacity",
    ],
)

py_library(
    name = "server",
    srcs = ["server.py"],
    data = [
        "server_instructions.md",
        ":grocy_openapi_fixed",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":batch_tools",
        ":client",
        ":mcp_types",
        ":tool_metadata",
        "//mcp_infra:persistence",
        "//mcp_infra:request_scoped_openapi",
        "//mcp_infra/authentik_auth:provider",
        "//mcp_infra/authentik_auth:token_exchange",
        "//util/bazel:runfiles",
        "@pypi//fastmcp_slim",
        "@pypi//prometheus_client",
        "@pypi//uvicorn",
    ],
)

py_binary(
    name = "server_cli",
    main_module = "grocy_mcp.server",
    deps = [":server"],
)

