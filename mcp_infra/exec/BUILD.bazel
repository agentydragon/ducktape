# Verify models and subprocess have no MCP/fastmcp dependencies
assert_no_deps(
    name = "test_models_no_mcp_deps",
    forbidden = [
        "@pypi//fastmcp",
        "@pypi//mcp",
    ],
    target = "//mcp_infra/exec:models",
)

assert_no_deps(
    name = "test_subprocess_no_mcp_deps",
    forbidden = [
        "@pypi//fastmcp",
        "@pypi//mcp",
    ],
    target = "//mcp_infra/exec:subprocess",
)
