load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")
load("//openai_utils/testing:testing.bzl", "live_openai_py_test")

# gazelle:exclude test_exec_roundtrip.py

# Image reading utility shared by Ember's direct exec and Docker exec
py_library(
    name = "read_image",
    srcs = ["read_image.py"],
    visibility = ["//visibility:public"],
    deps = [
        "@pypi//mcp",
        "@pypi//mcp_types",
    ],
)

# Docker container types (no MCP dependencies)
py_binary(
    name = "docker_launcher",
    main_module = "mcp_infra.exec.docker.launcher",
    visibility = ["//visibility:public"],
    deps = ["//mcp_infra/exec/docker:launcher"],
)

py_test(
    name = "test_docker",
    srcs = ["test_docker.py"],
    main = "test_docker.py",
    requires_docker = True,
    deps = [
        ":conftest",
        "//:conftest",
        "//mcp_infra:conftest",
        "//mcp_infra:constants",
        "//mcp_infra/exec/docker:server",
        "//mcp_infra/exec/docker:types",
        "@pypi//fastmcp_slim",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//mcp_infra/testing:docker_fixtures",
        "//mcp_infra/testing:fixtures",
        "//openai_utils/testing:fixtures",
        "//third_party/containers:fixtures",
        "@pypi//pytest",
    ],
)

py_test(
    name = "test_docker_unit",
    srcs = ["test_docker_unit.py"],
    requires_docker = True,
    deps = [
        ":conftest",
        "//:conftest",
        "//mcp_infra:conftest",
        "//mcp_infra/exec/docker:container_session",
        "//mcp_infra/exec/docker:server",
        "//mcp_infra/exec/docker:types",
        "//mcp_infra/testing:fixtures",
        "//util/exec:models",
        "@pypi//fastmcp_slim",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//tenacity",
    ],
)

py_test(
    name = "test_exec_input_schema",
