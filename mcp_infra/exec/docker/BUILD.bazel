load("//devinfra/deps:check.bzl", "assert_no_deps")
load("//devinfra/python:defs.bzl", "py_library")

py_library(
    name = "types",
    srcs = ["types.py"],
    visibility = ["//visibility:public"],
    deps = ["@pypi//pydantic"],
)

assert_no_deps(
    name = "types_no_fastmcp",
    forbidden = [
        "@pypi//fastmcp_slim",
        "@pypi//aiodocker",
        "@pypi//mcp",
    ],
    targets = ["//mcp_infra/exec/docker:types"],
)

