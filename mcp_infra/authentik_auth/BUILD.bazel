load("//devinfra/python:defs.bzl", "py_library", "py_test")

py_library(
    name = "auth",
    srcs = ["auth.py"],
    visibility = ["//visibility:public"],
    deps = [
        "@pypi//authlib",
        "@pypi//fastmcp_slim",
        "@pypi//httpx",
        "@pypi//mcp",
        "@pypi//prometheus_client",
        "@pypi//pydantic",
        "@pypi//starlette",
        "@pypi//tenacity",
        "@pypi//valkey_glide",
    ],
)

