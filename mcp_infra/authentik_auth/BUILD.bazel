    deps = [
        "@pypi//cryptography",
        "@pypi//httpx",
        "@pypi//pydantic",
        "@pypi//pyjwt",
    ],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    deps = [
        "@pypi//pytest",
        "@pypi//pytest_asyncio",
    ],
)

