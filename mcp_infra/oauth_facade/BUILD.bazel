load("//devinfra/python:defs.bzl", "py_library", "py_test")

py_library(
    name = "config",
    srcs = ["config.py"],
    visibility = ["//visibility:public"],
    deps = [
        "//mcp_infra:persistence",
        "//mcp_infra:tool_filter",
        "//mcp_infra/authentik_auth:config",
        "@pypi//pydantic",
        "@pypi//pydantic_settings",
        "@pypi//pyyaml",
    ],
)

py_library(
    name = "proxy",
    srcs = ["proxy.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":config",
        "@pypi//fastmcp_slim",
    ],
)

py_library(
    name = "upstream_probe",
    srcs = ["upstream_probe.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":config",
        ":proxy",
        "@pypi//fastmcp_slim",
        "@pypi//prometheus_client",
    ],
)

py_library(
    name = "server",
    srcs = ["server.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":config",
        ":proxy",
        ":upstream_probe",
        "//mcp_infra:persistence",
        "//mcp_infra:static_bearer",
        "//mcp_infra:tool_filter",
        "//mcp_infra/authentik_auth:provider",
        "@pypi//fastmcp_slim",
        "@pypi//prometheus_client",
        "@pypi//starlette",
        "@pypi//uvicorn",
    ],
)

py_test(
    name = "test_config",
    srcs = ["test_config.py"],
    deps = [
        ":config",
        "//mcp_infra:tool_filter",
        "//mcp_infra/authentik_auth:config",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_proxy",
    srcs = ["test_proxy.py"],
    deps = [
        ":config",
        ":proxy",
        "//airlock:conftest",
        "//mcp_infra:tool_filter",
        "//mcp_infra/authentik_auth:config",
        "@pypi//fastmcp_slim",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_server",
    srcs = ["test_server.py"],
    deps = [
        ":config",
        ":server",
        "//mcp_infra:static_bearer",
        "@pypi//httpx",
        "@pypi//pytest_bazel",
        "@pypi//starlette",
    ],
)

py_test(
    name = "test_upstream_probe",
    srcs = ["test_upstream_probe.py"],
    deps = [
        ":config",
        ":upstream_probe",
        "//airlock:conftest",
        "//mcp_infra/authentik_auth:config",
        "@pypi//fastmcp_slim",
        "@pypi//pytest_bazel",
    ],
)
