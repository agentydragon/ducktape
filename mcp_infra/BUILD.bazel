load("//devinfra/python:defs.bzl", "py_library", "py_test")

py_library(
    name = "persistence",
    srcs = ["persistence.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "@pypi//asyncpg",
        "@pypi//py_key_value_aio",
        "@pypi//pydantic",
        "@pypi//valkey_glide",
    ],
)

py_test(
    name = "test_types",
    srcs = ["test_types.py"],
    deps = [
        ":conftest",
