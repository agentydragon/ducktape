        "//:conftest",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_persistence",
    size = "medium",
    srcs = ["test_persistence.py"],
    data = [
        "//third_party/containers:postgres_18",
        "//third_party/containers:ryuk",
    ],
    requires_docker = True,
    deps = [
        ":persistence",
        # Root conftest enables pytest-asyncio auto mode (STRICT otherwise -> async tests skipped).
        "//:conftest",
        "//util/testing:postgres_fixtures",
        "@pypi//py_key_value_aio",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//testcontainers",
        ":conftest",
    ],
)

