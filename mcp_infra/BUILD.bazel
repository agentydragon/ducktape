load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("//tools/lint:linters.bzl", "ruff_test")

# Core mcp_infra types and utilities (no subpackages - consumers add those explicitly)
py_library(
    name = "mcp_infra",
    srcs = [
        "calltool.py",
        "client_helpers.py",
        "config_loader.py",
        "constants.py",
        "flat_tool.py",
        "mcp_types.py",
        "mount_types.py",
        "mounted.py",
        "naming.py",
        "prefix.py",
        "resource_utils.py",
        "snapshots.py",
        "tool_schemas.py",
        "urls.py",
    ],
    imports = [".."],
    visibility = ["//visibility:public"],
    deps = [
        "//mcp_utils",
        "@pypi//fastmcp",
        "@pypi//mcp",
        "@pypi//pydantic",
        "@pypi//typer",
    ],
)

# Shared test utilities (non-Docker)
py_library(
    name = "test_support",
    testonly = True,
    srcs = [
        "_markers.py",
        "conftest.py",
    ],
    imports = [".."],
    visibility = ["//mcp_infra:__subpackages__"],
    deps = [
        ":mcp_infra",
        "//agent_core_testing",
        "//mcp_infra/compositor",
        "//mcp_infra/enhanced",
        "//mcp_infra/exec:docker",
        "//mcp_infra/notifications",
        "//mcp_infra/resources",
        "//mcp_infra/stubs",
        "//mcp_infra/testing",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",  # keep
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_types",
