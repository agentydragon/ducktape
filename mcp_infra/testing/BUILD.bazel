load("@rules_oci//oci:defs.bzl", "oci_load")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

# Load python_slim base image into local Docker daemon for tests
# Tests that need this should add data = ["//mcp_infra/testing:python_slim_load"]
oci_load(
    name = "python_slim_load",
    image = "@python_slim_linux_amd64",
    repo_tags = ["python-slim:test"],
    visibility = ["//visibility:public"],
)

py_library(
    name = "testing",
    srcs = [
        "exec_stubs.py",
        "fixtures.py",
        "notifications.py",
        "simple_servers.py",
        "stdio_app.py",
        "stdio_notifier.py",
    ],
    imports = ["../.."],
    visibility = ["//visibility:public"],
    deps = [
        "//mcp_infra/compositor",
        "//mcp_infra/enhanced",
        "//mcp_infra/exec:bwrap",
        "//mcp_infra/exec:direct",
        "//mcp_infra/exec:docker",
        "//mcp_infra/exec:models",
        "//mcp_infra/exec:seatbelt",
        "//mcp_infra/exec:subprocess",
        "//mcp_infra/notifications",
        "//mcp_infra/resources",
        "//mcp_infra/stubs",
        "@pypi//fastmcp",
        "@pypi//mcp",
        "@pypi//pydantic",
        "@pypi//pytest",
    ],
)

# Docker fixtures that depend on python-slim OCI image
# Only include in tests that actually need Docker execution
py_library(
    name = "docker_fixtures",
    testonly = True,
    srcs = ["docker_fixtures.py"],
    imports = ["../.."],
    visibility = ["//visibility:public"],
    deps = [
        "//mcp_infra/exec:docker",
        "@pypi//pytest",
    ],
)

py_library(
    name = "exec_stubs",
    srcs = ["exec_stubs.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//mcp_infra",
        "//mcp_infra/exec:bwrap",
        "//mcp_infra/exec:models",
        "//mcp_infra/exec:seatbelt",
        "//mcp_infra/exec:subprocess",
    ],
)

py_library(
    name = "fixtures",
    srcs = ["fixtures.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//mcp_infra",
        "//mcp_infra/exec:docker",
        "@pypi//aiodocker",
        "@pypi//fastmcp",
        "@pypi//pytest",
    ],
)

py_library(
    name = "notifications",
    srcs = ["notifications.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//openai_utils",
        "@pypi//fastmcp",
        "@pypi//mcp",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "simple_servers",
    srcs = ["simple_servers.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//mcp_infra",
        "//openai_utils",
        "@pypi//pydantic",
    ],
)

py_binary(
    name = "stdio_app",
    srcs = ["stdio_app.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "@pypi//anyio",
    ],
)

py_binary(
    name = "stdio_notifier",
    srcs = ["stdio_notifier.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "@pypi//anyio",
    ],
)
