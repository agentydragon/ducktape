digraph desk_wiring {
    graph [fontname="Helvetica", nodesep=0.6, ranksep=1.0];
    node  [shape=Mrecord, fontname="Helvetica", fontsize=10];
    edge  [fontname="Helvetica", fontsize=9, penwidth=1.8, dir=none];

    monitor [label="{ AORUS FV43U — 43″ 4K@144 monitor | <spdif> optical S/PDIF out | <audio> 3.5 mm audio jack | <hdmi1> HDMI 2.1 · #1 | <hdmi2> HDMI 2.1 · #2 | <dp> DP 1.4 [wyrm2: card0-DP-1] | <usbc> USB-C in — video + hub + PD [hub: atlas 5-1.1] | <usbb> USB-B uplink [hub: atlas 3-2 when active] | <hi> USB-A upper [kbd: 5-1.1.1 / 3-2.1] | <lo> USB-A lower [cam: 5-1.1.5] }"];

    // KVM: header row, then two vertical columns side by side (peripheral / host)
    kvm [label="{ Sabrent SB-TB4K — TB4 KVM [atlas TB 0-1] | { { <pwr> power in | <ds_a> downstream TB4 A [→ 5-1.1] | <ds_b> downstream TB4 B | <ds_c> downstream TB4 C | <usba1> USB-A 1 | <usba2> USB-A 2 } | { <pc1> host PC1 (TB4) [atlas] | <pc2> host PC2 (TB4) [laptop] | <usba3> USB-A 3 | <usba4> USB-A 4 } } }"];

    atlas [label="{ atlas — Proxmox tower · 2× RTX 5090 | <tb_top> mobo TB4 · top [TB domain 0 / card1-DP-1] | <tb_mid> mobo TB4 · middle | <usba_rear> rear USB-A bus 3 port 2 }"];

    wyrm2 [label="{ wyrm2 VM — local seat0 | <dp_out> RTX 5090 01:00.0 DP-OUT [card0-DP-1] | <gpu1> RTX 5090 02:00.0 [card2, headless] }"];

    laptop [label="Laptop slot"];

    g_backright [shape=circle, style=dashed, label="back-right\ngrommet", fontsize=9, width=1.2, height=1.2];
    g_drawer    [shape=circle, style=dashed, label="drawer\ngrommet",    fontsize=9, width=1.2, height=1.2];

    cam [label="USB-A camera\natop monitor [5-1.1.5]"];
    kbd [label="TEX Shura keyboard\n[5-1.1.1 / 3-2.1]"];
    hub [label="Under-desk USB-A hub"];

    // xlabel keeps labels near edges without forcing the router to bend
    // cables around them.
    atlas:tb_top -> kvm:pc1 [xlabel="Sabrent tag '4'\nTB-class USB-C, short", color="#333333"];
    laptop -> g_drawer      [xlabel="USB 3.2 20 Gb/s 8K", color="#c62828"];
    g_drawer -> kvm:pc2     [color="#c62828"];
    kvm:ds_a -> g_backright [xlabel="Silkland\n40 Gb/s · 200 W", color="#1976d2"];
    g_backright -> monitor:usbc [color="#1976d2"];
    kvm:usba1 -> hub        [xlabel="direct\nUSB-A", color="#f57c00"];
    monitor:hi -> g_backright [xlabel="USB-A → USB-C", color="#388e3c"];
    g_backright -> kbd      [color="#388e3c"];
    monitor:lo -> cam       [xlabel="direct\nUSB-A", color="#7b1fa2"];

    // Gaming display path (Plan A rev 2 — wired 2026-07-05)
    wyrm2:dp_out -> monitor:dp [xlabel="Ivanky 8K DP m-m", color="#00695c"];
    monitor:usbb -> atlas:usba_rear [xlabel="USB A→B", color="#827717"];
    atlas:usba_rear -> wyrm2 [xlabel="QEMU port-path\npassthrough (3-2.1)", color="#827717", style=dashed];
}
