load("@aspect_rules_py//py:defs.bzl", "py_image_layer", aspect_py_binary = "py_binary")
load("@bazel_skylib//rules:native_binary.bzl", "native_test")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_python//python/uv:lock.bzl", "lock")
load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")
load("//props:oci.bzl", "py_image_entrypoint", "py_image_env")

# This package's third-party Python deps come from the package-local litellm
# lock (the lock() below), not the repo-wide @pypi hub.
# gazelle:resolve py litellm @pypi_tana_litellm_proxy//litellm
# gazelle:resolve py httpx @pypi_tana_litellm_proxy//httpx

exports_files([
    "requirements.in",
    "requirements.txt",
])

# Generate requirements.txt from requirements.in.
# Run: bazel run //tana/litellm_proxy:requirements.update
#
# This lock is intentionally separate from the repo-wide @pypi hub because
# LiteLLM's proxy extra pins versions that conflict with unrelated repo deps.
lock(
    name = "requirements",
    srcs = ["requirements.in"],
    out = "requirements.txt",
    exec_properties = {"dockerNetwork": "bridge"},
    python_version = "3.13",
)

native_test(
    name = "requirements_test",
    src = ":requirements.update",
    tags = [
        "no-cache",
        "requires-network",
    ],
)

LITELLM_PROXY_PIP = "@pypi_tana_litellm_proxy//"

LITELLM_PROXY_RUNTIME_DEPS = [
    LITELLM_PROXY_PIP + "aiohttp",
    LITELLM_PROXY_PIP + "apscheduler",
    LITELLM_PROXY_PIP + "azure_identity",
    LITELLM_PROXY_PIP + "azure_storage_blob",
    LITELLM_PROXY_PIP + "backoff",
    LITELLM_PROXY_PIP + "boto3",
    LITELLM_PROXY_PIP + "cryptography",
    LITELLM_PROXY_PIP + "fastapi",
    LITELLM_PROXY_PIP + "fastapi_sso",
    LITELLM_PROXY_PIP + "gunicorn",
    LITELLM_PROXY_PIP + "litellm_enterprise",
    LITELLM_PROXY_PIP + "litellm_proxy_extras",
    LITELLM_PROXY_PIP + "mcp",
    LITELLM_PROXY_PIP + "opentelemetry_api",
    LITELLM_PROXY_PIP + "opentelemetry_exporter_otlp_proto_http",
    LITELLM_PROXY_PIP + "opentelemetry_sdk",
    LITELLM_PROXY_PIP + "orjson",
    LITELLM_PROXY_PIP + "polars",
    LITELLM_PROXY_PIP + "prometheus_client",
    LITELLM_PROXY_PIP + "pydantic_settings",
    LITELLM_PROXY_PIP + "pyjwt",
    LITELLM_PROXY_PIP + "pynacl",
    LITELLM_PROXY_PIP + "pyroscope_io",
    LITELLM_PROXY_PIP + "python_multipart",
    LITELLM_PROXY_PIP + "pyyaml",
    LITELLM_PROXY_PIP + "rich",
    LITELLM_PROXY_PIP + "rq",
    LITELLM_PROXY_PIP + "soundfile",
    LITELLM_PROXY_PIP + "uvicorn",
    LITELLM_PROXY_PIP + "uvloop",
    LITELLM_PROXY_PIP + "websockets",
]

py_library(
    name = "provider",
    srcs = ["provider.py"],
    visibility = ["//visibility:public"],
    deps = [
        "@pypi_tana_litellm_proxy//httpx",
        "@pypi_tana_litellm_proxy//litellm",
    ],
)

py_library(
    name = "custom_handler",
    srcs = ["custom_handler.py"],
    visibility = ["//visibility:public"],
    deps = [":provider"],
)

py_library(
    name = "__init__",
    srcs = ["__init__.py"],
    visibility = ["//visibility:public"],
    deps = [":provider"],
)

py_library(
    name = "model_registry",
    srcs = ["model_registry.py"],
    visibility = ["//visibility:public"],
)

py_library(
    name = "demo",
    srcs = ["demo.py"],
    deps = [
        ":provider",
        "@pypi_tana_litellm_proxy//litellm",
    ],
)

py_binary(
    name = "demo_bin",
    main_module = "tana.litellm_proxy.demo",
    tags = ["manual"],
    deps = [":demo"],
)

py_library(
    name = "probe_models",
    srcs = ["probe_models.py"],
    deps = [
        ":model_registry",
        ":provider",
    ],
)

py_binary(
    name = "probe_models_bin",
    main_module = "tana.litellm_proxy.probe_models",
    tags = ["manual"],
    deps = [":probe_models"],
)

py_test(
    name = "test_provider",
    srcs = ["test_provider.py"],
    deps = [
        ":custom_handler",
        ":provider",
        "//:conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi_tana_litellm_proxy//httpx",
        "@pypi_tana_litellm_proxy//litellm",
    ],
)

py_test(
    name = "test_proxy_runtime",
    srcs = ["test_proxy_runtime.py"],
    data = [":server_bin"],
    deps = [
        ":provider",
        "//:conftest",
        "//util/bazel:runfiles",
        "@pypi//pytest_bazel",
        "@pypi_tana_litellm_proxy//litellm",
    ],
)

aspect_py_binary(
    name = "server_bin",
    srcs = ["@@rules_python++pip+pypi_tana_litellm_proxy_313_litellm//:rules_python_wheel_entry_point_litellm.py"],
    main = "@@rules_python++pip+pypi_tana_litellm_proxy_313_litellm//:rules_python_wheel_entry_point_litellm.py",
    deps = [
        ":__init__",
        ":custom_handler",
        ":provider",
        LITELLM_PROXY_PIP + "litellm",
    ] + LITELLM_PROXY_RUNTIME_DEPS,
)

py_image_layer(
    name = "layers",
    binary = ":server_bin",
    group = "1000",
    owner = "1000",
)

oci_image(
    name = "image",
    base = "@debian_trixie_slim_linux_amd64",
    entrypoint = py_image_entrypoint("server_bin"),
    env = py_image_env(binary_name = "server_bin"),
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [":layers"],
    user = "1000:1000",
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["tana-litellm-proxy:latest"],
)
