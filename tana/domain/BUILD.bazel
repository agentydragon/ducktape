load("//devinfra/python:defs.bzl", "py_library")

package(default_visibility = ["//tana:__subpackages__"])

py_library(
    name = "constants",
    srcs = ["constants.py"],
    deps = [":types"],
)

py_library(
    name = "nodes",
    srcs = ["nodes.py"],
    deps = [
        ":types",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "search",
    srcs = ["search.py"],
    deps = [
        ":types",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "types",
    srcs = ["types.py"],
)
