load("@rules_python//python:defs.bzl", "py_library")
load("//tools/testing:defs.bzl", "py_test")

py_library(
    name = "workspace",
    srcs = ["workspace.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//tana/domain:nodes",
        "//tana/domain:types",
        "//tana/graph",
        "//tana/graph:loader",
        "//tana/query/search:materializer",
    ],
)

py_test(
    name = "test_convert",
    srcs = ["test_convert.py"],
    data = glob(["testdata/**/*"]),
    deps = [
        "//tana/export:convert",
        "//tana/graph:loader",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
