load("@aspect_rules_py//py:defs.bzl", "py_image_layer", aspect_py_binary = "py_binary")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")
load("//props:oci.bzl", "py_image_entrypoint", "py_image_env")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "renderer",
    srcs = ["renderer.py"],
    deps = ["@pypi//jinja2"],
)

py_library(
    name = "config",
    srcs = ["config.py"],
    deps = [
        "@pypi//pydantic",
        "@pypi//pydantic_settings",
    ],
)

py_library(
    name = "git_state",
    srcs = ["git_state.py"],
    deps = [
        "@pypi//pygit2",
        "@pypi//pyyaml",
    ],
)

py_library(
    name = "templates_loader",
    srcs = ["templates_loader.py"],
    data = glob(["templates/**"]),
    deps = ["@pypi//jinja2"],
)

py_library(
    name = "app",
    srcs = ["app.py"],
    deps = [
        ":config",
        ":git_state",
        ":renderer",
        ":templates_loader",
        "@pypi//fastapi",
        "@pypi//python_multipart",  # keep: runtime dep for fastapi.Form (not imported)
        "@pypi//uvicorn",
    ],
)

py_binary(
    name = "server",
    main_module = "haku.arm.app",
    deps = [":app"],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    deps = [
        ":config",
        ":git_state",
        "@pypi//pygit2",
        "@pypi//pytest",
    ],
)

py_test(
    name = "test_renderer",
    srcs = ["test_renderer.py"],
    deps = [
        ":renderer",
        ":templates_loader",
        "//:conftest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_app",
    srcs = ["test_app.py"],
    deps = [
        ":app",
        ":conftest",
        "//:conftest",
        "@pypi//fastapi",
        "@pypi//httpx",
        "@pypi//pygit2",
        "@pypi//pytest_bazel",
    ],
)

# ── OCI image (the haku-arm service) ──────────────────────────────────────────
# Plain debian-slim base: the arm clones/pushes haku-state over cluster-internal
# plaintext HTTP, so (unlike finance/beancount_export) it needs no ca-certificates
# apt layer for pygit2.

aspect_py_binary(
    name = "server_bin",
    main = "app.py",
    deps = [":app"],
)

py_image_layer(
    name = "server_layers",
    binary = ":server_bin",
    group = "1000",
    owner = "1000",
)

oci_image(
    name = "server_image",
    base = "@debian_slim_linux_amd64",
    entrypoint = py_image_entrypoint("server_bin"),
    env = py_image_env(binary_name = "server_bin"),
    labels = {
        "org.opencontainers.image.source": "https://github.com/agentydragon/ducktape",
        "org.opencontainers.image.title": "haku-arm",
    },
    tars = [":server_layers"],
    user = "1000:1000",
    visibility = ["//visibility:public"],
)

oci_load(
    name = "server_load",
    image = ":server_image",
    repo_tags = ["haku-arm:latest"],
)
