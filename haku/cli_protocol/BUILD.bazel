load("//devinfra/python:defs.bzl", "py_library", "py_test")

py_library(
    name = "frame_identity",
    srcs = ["frame_identity.py"],
    visibility = ["//haku:__subpackages__"],
)

py_test(
    name = "test_frame_identity",
    srcs = ["test_frame_identity.py"],
    deps = [
        ":frame_identity",
        "//:conftest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "frames",
    srcs = ["frames.py"],
    visibility = ["//haku:__subpackages__"],
    deps = ["@pypi//pydantic"],
)

py_test(
    name = "test_frames",
    srcs = ["test_frames.py"],
    deps = [
        ":frames",
        "//:conftest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_compaction_capture",
    srcs = ["test_compaction_capture.py"],
    data = ["testdata/compaction_session.jsonl"],
    deps = [
        "//:conftest",
        "//util/bazel:runfiles",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
