load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "config",
    srcs = ["config.py"],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "models",
    srcs = ["models.py"],
    deps = [
        "//mcp_infra/exec:models",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "kubernetes_client",
    srcs = ["kubernetes_client.py"],
    deps = [
        ":config",
        ":models",
        "//mcp_infra/exec:kubernetes",
        "//mcp_infra/exec:models",
        "//util:agent_sandbox",
        "//util:kubernetes",
        "@pypi//fastmcp_slim",
        "@pypi//kubernetes_asyncio",
    ],
)

py_library(
    name = "tools",
    srcs = ["tools.py"],
    deps = [
        ":config",
        ":models",
        "@pypi//fastmcp_slim",
        "@pypi//mcp",
        "@pypi//mcp_types",
        "@pypi//pydantic",
    ],
)

py_test(
    name = "test_config",
    srcs = ["test_config.py"],
    deps = [
        ":config",
        "//:conftest",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_kubernetes_client",
    srcs = ["test_kubernetes_client.py"],
    deps = [
        ":config",
        ":kubernetes_client",
        "//:conftest",
        "//mcp_infra/exec:models",
        "//util:agent_sandbox",
        "@pypi//fastmcp_slim",
        "@pypi//kubernetes_asyncio",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_tools",
    srcs = ["test_tools.py"],
    deps = [
        ":config",
        ":models",
        ":tools",
        "//:conftest",
        "//mcp_infra/exec:models",
        "@pypi//fastmcp_slim",
        "@pypi//mcp",
        "@pypi//mcp_types",
        "@pypi//pytest_bazel",
    ],
)
