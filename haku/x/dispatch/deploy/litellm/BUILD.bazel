# gazelle:ignore

load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

py_library(
    name = "generate_workers_litellm",
    srcs = ["generate_workers_litellm.py"],
    visibility = [
        "//cluster/validation:__pkg__",
        "//haku/x/dispatch:__pkg__",
    ],
    deps = [
        "//cluster/cdk8s:model_rosters",
        "//devinfra:prettier",
        "//util/bazel:workspace",
        "@pypi//pyyaml",
    ],
)

py_binary(
    name = "generate_workers_litellm_bin",
    main_module = "haku.x.dispatch.deploy.litellm.generate_workers_litellm",
    deps = [":generate_workers_litellm"],
)

py_test(
    name = "test_generate_workers_litellm",
    srcs = ["test_generate_workers_litellm.py"],
    data = [
        "workers-litellm-config.yaml",
        "//tf/gitops/litellm-keys:main.tf",
    ],
    deps = [
        ":generate_workers_litellm",
        "//util/bazel:runfiles",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//pyyaml",
    ],
)

# Deployment manifests for cluster/validation's focused dispatch render test.
filegroup(
    name = "manifests",
    srcs = glob(
        ["**"],
        exclude = [
            "BUILD.bazel",
            "*.py",
        ],
    ),
    visibility = ["//cluster/validation:__pkg__"],
)
