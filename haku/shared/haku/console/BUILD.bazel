load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

exports_files(["test_tool_calls.py"])

# Haku Console's operator audit records and agent-facing MCP discovery/correlation metadata.
# Single source of truth for the console and haku-state's MCP adapter.
#
# imports=["../.."] puts the module root on the import path, so this file (at haku/console/ inside
# the module) is importable as `haku.console.tool_calls` — the same namespace it has in the main
# ducktape repo (namespace packages merge the two source roots; the repo builds with
# --incompatible_default_to_explicit_init_py). Pydantic is a PROVIDED dependency — every consumer
# already pulls its own @pypi//pydantic, so exactly one reaches runfiles; do NOT add
# @pypi//pydantic here (see this module's MODULE.bazel).
py_library(
    name = "tool_calls",
    srcs = ["tool_calls.py"],
    imports = ["../.."],
)
