load("@aspect_rules_py//py:defs.bzl", "py_image_layer", aspect_py_binary = "py_binary")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")
load("//props:oci.bzl", "py_image_entrypoint", "py_image_env")

py_library(
    name = "protocol",
    srcs = ["protocol.py"],
    visibility = ["//haku:__subpackages__"],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "backend",
    srcs = ["backend.py"],
    visibility = ["//haku:__subpackages__"],
    deps = [":protocol"],
)

py_library(
    name = "options",
    srcs = ["options.py"],
    visibility = ["//haku:__subpackages__"],
    deps = [
        ":backend",
        ":protocol",
    ],
)

py_library(
    name = "transport",
    srcs = ["transport.py"],
    visibility = ["//haku:__subpackages__"],
    deps = [
        ":protocol",
        "@pypi//anyio",
    ],
)

py_library(
    name = "runner",
    srcs = ["runner.py"],
    visibility = ["//haku:__subpackages__"],
    deps = [
        ":backend",
        ":options",
        ":protocol",
        "@pypi//anyio",
        "@pypi//tenacity",
        "@pypi//websockets",
    ],
)

py_binary(
    name = "runner_bin",
    srcs = ["runner.py"],
    main = "runner.py",
    visibility = ["//visibility:public"],
    deps = [
        ":backend",
        ":options",
        ":protocol",
        "@pypi//anyio",
        "@pypi//tenacity",
        "@pypi//websockets",
    ],
)

aspect_py_binary(
    name = "runner_image_bin",
    main = "runner.py",
    deps = [":runner"],
)

py_image_layer(
    name = "runner_layers",
    binary = ":runner_image_bin",
    group = "1000",
    owner = "1000",
)

py_binary(
    name = "extract_claude",
    srcs = ["extract_claude.py"],
)

# The wheel is kept for one thing only: it bundles a `claude` binary the runner image needs. No
# Python here imports the SDK.
#
# **This should move to npm.** Anthropic publishes the CLI as `@anthropic-ai/claude-code` with
# per-platform binaries (`@anthropic-ai/claude-code-linux-x64`), which is its actual distribution
# channel and which this repo already has a mechanism for (`@aspect_rules_js` + pnpm). Extracting
# it from a Python wheel means reaching into another package's `_bundled/` for a file it happens
# to ship, and it pins the CLI only as a side effect of the SDK version rather than directly.
# See <../../../plans/cli_protocol_ownership.md>.
genrule(
    name = "claude_executable",
    srcs = ["@pypi//claude_agent_sdk:whl"],
    outs = ["claude"],
    cmd = "$(location :extract_claude) $(location @pypi//claude_agent_sdk:whl) $@",
    executable = True,
    tools = [":extract_claude"],
)

pkg_files(
    name = "claude_files",
    srcs = [":claude_executable"],
    attributes = pkg_attributes(
        group = "1000",
        mode = "0755",
        user = "1000",
    ),
    prefix = "/usr/local/bin",
)

pkg_tar(
    name = "claude_layer",
    srcs = [":claude_files"],
)

# The same bootstrap the haku-sandbox exec target runs, so this box gets Haku's manual and
# git credential the same way rather than by a second, drifting copy.
pkg_files(
    name = "setup_files",
    srcs = ["//cluster/k8s:haku_sandbox_setup"],
    attributes = pkg_attributes(
        group = "1000",
        mode = "0755",
        user = "1000",
    ),
    prefix = "/usr/local/bin",
)

pkg_tar(
    name = "setup_layer",
    srcs = [":setup_files"],
)

oci_image(
    name = "runner_image",
    base = "@debian_trixie_slim_linux_amd64",
    entrypoint = py_image_entrypoint("runner_image_bin"),
    env = py_image_env(
        binary_name = "runner_image_bin",
        extra_env = {
            "HAKU_CLAUDE_PATH": "/usr/local/bin/claude",
            "HAKU_CLAUDE_SETUP": "/usr/local/bin/haku-sandbox-setup.sh",
            "HOME": "/home/runner",
            "CLAUDE_CONFIG_DIR": "/claude-config",
        },
    ),
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [
        ":runner_layers",
        ":claude_layer",
        ":setup_layer",
        # git, for checking haku-state out into the workspace before Claude starts.
        "@trixie_haku_claude_runner//:flat",
    ],
    user = "1000:1000",
    visibility = ["//visibility:public"],
)

oci_load(
    name = "runner_load",
    image = ":runner_image",
    repo_tags = ["haku-claude-runner:latest"],
)

