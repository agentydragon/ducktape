load("//devinfra/python:defs.bzl", "py_library", "py_test")

py_library(
    name = "addon",
    srcs = ["addon.py"],
    deps = [
        ":decide_client",
        ":decision",
        "@pypi//mitmproxy",
    ],
)

py_library(
    name = "decide_client",
    srcs = ["decide_client.py"],
    deps = [":decision"],
)

py_library(
    name = "decision",
    srcs = ["decision.py"],
    visibility = ["//haku/console:__pkg__"],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "localhost_decide_client",
    srcs = ["localhost_decide_client.py"],
    deps = [
        ":decide_client",
        ":decision",
        "@pypi//httpx",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "runner",
    srcs = ["runner.py"],
    deps = [
        ":addon",
        ":decide_client",
        "@pypi//mitmproxy",
    ],
)

py_library(
    name = "static_decide_client",
    testonly = True,
    srcs = ["static_decide_client.py"],
    deps = [
        ":decide_client",
        ":decision",
    ],
)

py_library(
    name = "proxy_test_harness",
    testonly = True,
    srcs = ["proxy_test_harness.py"],
    deps = [
        ":addon",
        ":decide_client",
        ":decision",
        ":localhost_decide_client",
        ":runner",
        "@pypi//aiohttp",
        "@pypi//more_itertools",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "tls_test_support",
    testonly = True,
    srcs = ["tls_test_support.py"],
    deps = ["@pypi//cryptography"],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    deps = [
        ":proxy_test_harness",
        "@pypi//pytest",
    ],
)

py_test(
    name = "test_decision",
    srcs = ["test_decision.py"],
    deps = [
        ":decision",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

# The integration suites below (this target and the test_egress_* targets) drive a real
# in-process mitmproxy — the embedded runner — toward a local upstream, so they need no
# Docker; they extend the fail-closed conformance harness in proxy_test_harness.py (#4914).
py_test(
    name = "test_egress_proxy",
    srcs = ["test_egress_proxy.py"],
    deps = [
        ":addon",
        ":conftest",
        ":decision",
        ":localhost_decide_client",
        ":proxy_test_harness",
        ":static_decide_client",
        "//:conftest",
        "@pypi//aiohttp",
        "@pypi//mitmproxy",
        "@pypi//more_itertools",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",  # runtime dep: conftest sets asyncio_mode="auto"
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_egress_credentials",
    size = "small",
    srcs = ["test_egress_credentials.py"],
    deps = [
        ":conftest",
        ":decision",
        ":proxy_test_harness",
        ":static_decide_client",
