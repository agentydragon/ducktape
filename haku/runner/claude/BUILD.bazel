load("//devinfra/python:defs.bzl", "py_library", "py_test")

py_library(
    name = "options",
    srcs = ["options.py"],
    visibility = ["//haku:__subpackages__"],
    deps = ["//haku/runner:protocol"],
)

py_library(
    name = "projection",
    srcs = ["projection.py"],
    visibility = ["//haku:__subpackages__"],
    deps = [
        "//haku/runner:neutral_operations",
        "//haku/runner:projection",
    ],
)

py_library(
    name = "harness",
    srcs = ["harness.py"],
    visibility = ["//haku:__subpackages__"],
    deps = [
        ":options",
        ":projection",
        "//haku/cli_protocol:frames",
        "//haku/runner:backend",
        "//haku/runner:protocol",
        "//haku/runner:session_api",
        "@pypi//anyio",
    ],
)

py_test(
    name = "test_options",
    srcs = ["test_options.py"],
    deps = [
        ":harness",
        ":options",
        "//:conftest",
        "//haku/runner:protocol",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_projection",
    srcs = ["test_projection.py"],
    data = ["testdata/diverse_session.jsonl"],
    deps = [
        ":projection",
        "//:conftest",
        "//haku/runner:neutral_operations",
        "//haku/runner:operation_journal",
        "//util/bazel:runfiles",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
