# The wheel is kept for one thing only: it bundles a `claude` binary the runner image needs. No
# Python here imports the SDK.
#
# **This should move to npm.** Anthropic publishes the CLI as `@anthropic-ai/claude-code` with
# per-platform binaries (`@anthropic-ai/claude-code-linux-x64`), which is its actual distribution
# channel and which this repo already has a mechanism for (`@aspect_rules_js` + pnpm). Extracting
# it from a Python wheel means reaching into another package's `_bundled/` for a file it happens
# to ship, and it pins the CLI only as a side effect of the SDK version rather than directly.
# See <../plans/cli_protocol_ownership.md>.
# The output is `claude_cli`, not `claude`: a bare `claude` output file would collide with the
# `claude/` harness subpackage's action outputs (Bazel forbids a file path that prefixes a
# package's outputs). The image still installs it as `/usr/local/bin/claude` via the rename below.
genrule(
    name = "claude_executable",
    srcs = ["@pypi//claude_agent_sdk:whl"],
    outs = ["claude_cli"],
    cmd = "$(location :extract_claude_bin) $(location @pypi//claude_agent_sdk:whl) $@",
    executable = True,
    tools = [":extract_claude_bin"],
)

pkg_files(
    name = "claude_files",
    srcs = [":claude_executable"],
    attributes = pkg_attributes(
        group = "1000",
        mode = "0755",
        user = "1000",
    ),
    prefix = "/usr/local/bin",
    renames = {":claude_executable": "claude"},
)

pkg_tar(
    name = "claude_layer",
    srcs = [":claude_files"],
)

# The same bootstrap the haku-sandbox exec target runs, so this box gets Haku's manual and
# git credential the same way rather than by a second, drifting copy.
pkg_files(
    name = "setup_files",
    srcs = ["//cluster/k8s:haku_sandbox_setup"],
    attributes = pkg_attributes(
        group = "1000",
        mode = "0755",
        user = "1000",
    ),
    prefix = "/usr/local/bin",
)

pkg_tar(
    name = "setup_layer",
    srcs = [":setup_files"],
)

pkg_files(
    name = "codex_files",
    srcs = ["@codex_cli_linux_x64//:files"],
    attributes = pkg_attributes(
        group = "1000",
        mode = "0555",
        user = "1000",
    ),
    prefix = "/opt/codex",
    strip_prefix = strip_prefix.from_root(""),
)

pkg_tar(
    name = "codex_layer",
    srcs = [":codex_files"],
)

pkg_files(
    name = "kubectl_files",
    srcs = ["@kubectl_linux_amd64//file:kubectl"],
    attributes = pkg_attributes(
        group = "1000",
        mode = "0755",
        user = "1000",
    ),
    prefix = "/usr/local/bin",
)

pkg_tar(
    name = "kubectl_layer",
    srcs = [":kubectl_files"],
)

oci_image(
    name = "runner_image",
    base = "@debian_trixie_slim_linux_amd64",
    entrypoint = py_image_entrypoint("runner_image_bin"),
    env = py_image_env(
        binary_name = "runner_image_bin",
        extra_env = {
            "HAKU_CLAUDE_PATH": "/usr/local/bin/claude",
            "HAKU_CODEX_PATH": "/opt/codex/bin/codex",
            # Compatibility for old Claude pods only. New launches select setup in the
            # HarnessLaunch environment; Codex explicitly ignores this fallback.
            "HAKU_RUNNER_SETUP": "/usr/local/bin/haku-sandbox-setup.sh",
            "HOME": "/home/runner",
            "CLAUDE_CONFIG_DIR": "/claude-config",
            "SSL_CERT_FILE": "/etc/ssl/certs/ca-certificates.crt",
        },
    ),
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [
        ":runner_layers",
        ":claude_layer",
        ":setup_layer",
        ":codex_layer",
        ":kubectl_layer",
        "//third_party/debian_slim:cacerts",
        # Apt packages: git for the haku-state checkout, bubblewrap for the Codex sandbox.
        "@trixie_haku_harness_runner//:flat",
    ],
    user = "1000:1000",
    visibility = ["//visibility:public"],
)

oci_load(
    name = "runner_load",
    image = ":runner_image",
    repo_tags = ["haku-harness-runner:latest"],
)

