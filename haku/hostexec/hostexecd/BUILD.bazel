load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Security-critical: the console-signed capability verifier (Rust side of the cross-language JWT
# contract). Keep in lockstep with haku/hostexec/capability.py (the signer + pinned vectors).
rust_library(
    name = "capability",
    srcs = ["capability.rs"],
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "@crates//:jsonwebtoken",
        "@crates//:serde",
        "@crates//:thiserror",
    ],
)

rust_test(
    name = "capability_test",
    size = "small",
    srcs = ["capability_test.rs"],
    edition = "2024",
    deps = [":capability"],
)

# Command execution: spawn argv (no shell), wall-clock timeout + kill, output caps with truncation
# reporting. Result shape mirrors mcp_infra.exec.models.BaseExecResult.
rust_library(
    name = "exec",
    srcs = ["exec.rs"],
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "@crates//:serde",
        "@crates//:tokio",
    ],
)

rust_test(
    name = "exec_test",
    size = "small",
    srcs = ["exec_test.rs"],
    edition = "2024",
    deps = [
        ":exec",
        "@crates//:serde_json",
        "@crates//:tokio",
    ],
)
