load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Security-critical: the Authentik access-token verifier — hostexecd's authorization check.
# RS256 via Authentik's JWKS (per-host audience + hostexec-<run_as>-<host> group); mirrors
# mcp_infra/authentik_auth.
rust_library(
    name = "authentik",
    srcs = ["authentik.rs"],
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "@crates//:jsonwebtoken",
        "@crates//:serde",
        "@crates//:thiserror",
    ],
)

rust_test(
    name = "authentik_test",
    size = "small",
    srcs = ["authentik_test.rs"],
    compile_data = glob(["testdata/*.pem"]),
    edition = "2024",
    deps = [
        ":authentik",
        "@crates//:jsonwebtoken",
        "@crates//:serde",
    ],
)

# Single-use replay store: reject a token hostexecd has already executed (the single-use rung).
rust_library(
    name = "replay",
    srcs = ["replay.rs"],
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "@crates//:sha2",
        "@crates//:thiserror",
    ],
)

rust_test(
    name = "replay_test",
    size = "small",
    srcs = ["replay_test.rs"],
    edition = "2024",
    deps = [":replay"],
)

# Resolve a POSIX username to uid/gid via getpwnam (the privilege-drop target).
rust_library(
    name = "users",
    srcs = ["users.rs"],
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = ["@crates//:libc"],
)

rust_test(
    name = "users_test",
    size = "small",
    srcs = ["users_test.rs"],
    edition = "2024",
    deps = [":users"],
)

# Command execution: spawn argv (no shell), wall-clock timeout + kill, output caps with truncation
# reporting, and privilege-drop to run_as. Result shape mirrors mcp_infra.exec.models.BaseExecResult.
rust_library(
    name = "exec",
    srcs = ["exec.rs"],
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        ":users",
        "@crates//:serde",
        "@crates//:tokio",
    ],
)

rust_test(
    name = "exec_test",
    size = "small",
    srcs = ["exec_test.rs"],
    edition = "2024",
    deps = [
        ":exec",
        ":users",
        "@crates//:libc",
        "@crates//:serde_json",
        "@crates//:tokio",
    ],
)
