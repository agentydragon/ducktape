load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

# Security-critical: the Authentik access-token verifier — hostexecd's authorization check.
# RS256 via Authentik's JWKS (per-host audience + hostexec-<run_as>-<host> group); mirrors
# mcp_infra/authentik_auth.
rust_library(
    name = "authentik",
    srcs = ["authentik.rs"],
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "@crates//:jsonwebtoken",
        "@crates//:serde",
        "@crates//:thiserror",
    ],
)

rust_test(
    name = "authentik_test",
    size = "small",
    srcs = ["authentik_test.rs"],
    compile_data = glob(["testdata/*.pem"]),
    edition = "2024",
    deps = [
        ":authentik",
        "@crates//:jsonwebtoken",
        "@crates//:serde",
    ],
)

# Single-use replay store: reject a token hostexecd has already executed (the single-use rung).
rust_library(
    name = "replay",
    srcs = ["replay.rs"],
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "@crates//:sha2",
        "@crates//:thiserror",
    ],
)

rust_test(
    name = "replay_test",
    size = "small",
    srcs = ["replay_test.rs"],
    edition = "2024",
    deps = [":replay"],
)

# Resolve a POSIX username to uid/gid via getpwnam (the privilege-drop target).
rust_library(
    name = "users",
    srcs = ["users.rs"],
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = ["@crates//:libc"],
)

rust_test(
    name = "users_test",
    size = "small",
    srcs = ["users_test.rs"],
    edition = "2024",
    deps = [":users"],
)

# Command execution: run cmd as `bash -c cmd`, wall-clock timeout + kill, output caps with
# truncation reporting, and privilege-drop to run_as. Result shape mirrors
# mcp_infra.exec.models.BaseExecResult.
rust_library(
    name = "exec",
    srcs = ["exec.rs"],
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        ":users",
        "@crates//:libc",
        "@crates//:serde",
        "@crates//:tokio",
    ],
)

rust_test(
    name = "exec_test",
    size = "small",
    srcs = ["exec_test.rs"],
    edition = "2024",
    deps = [
        ":exec",
        "@crates//:serde_json",
        "@crates//:tokio",
    ],
)

# Deserialize the durable claim envelope before interpreting its backend-specific payload so the
# daemon retains the lease identity needed to report incompatible work as failed.
rust_library(
    name = "claim",
    srcs = ["claim.rs"],
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "@crates//:serde",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "claim_test",
    size = "small",
    srcs = ["claim_test.rs"],
    edition = "2024",
    deps = [
        ":claim",
        "@crates//:serde_json",
    ],
)

# The authorization composition: verify the token, resolve run_as, then claim single-use. The whole
# security decision, so the axum handler carries no policy.
rust_library(
    name = "authorize",
    srcs = ["authorize.rs"],
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        ":authentik",
        ":replay",
        ":users",
        "@crates//:jsonwebtoken",
        "@crates//:thiserror",
    ],
)

rust_test(
    name = "authorize_test",
    size = "small",
    srcs = ["authorize_test.rs"],
    compile_data = glob(["testdata/*.pem"]),
    edition = "2024",
    deps = [
        ":authorize",
        ":replay",
        "@crates//:jsonwebtoken",
        "@crates//:serde",
    ],
)

# JWKS resolution: fetch Authentik's signing keys and hand back a DecodingKey for a token's kid.
rust_library(
    name = "jwks",
    srcs = ["jwks.rs"],
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "@crates//:jsonwebtoken",
        "@crates//:reqwest",
        "@crates//:thiserror",
    ],
)

rust_test(
    name = "jwks_test",
    size = "small",
    srcs = ["jwks_test.rs"],
    compile_data = glob([
        "testdata/*.pem",
        "testdata/*.json",
    ]),
    edition = "2024",
    deps = [
        ":authentik",
        ":jwks",
        "@crates//:jsonwebtoken",
        "@crates//:serde",
        "@crates//:serde_json",
    ],
)

# The daemon: phone home, lease approved work, verify the operator token, authorize, and exec.
rust_binary(
    name = "hostexecd",
    srcs = ["main.rs"],
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        ":authorize",
        ":claim",
        ":exec",
        ":jwks",
        ":replay",
        "@crates//:anyhow",
        "@crates//:clap",
        "@crates//:env_logger",
        "@crates//:jsonwebtoken",
        "@crates//:log",
        "@crates//:reqwest",
        "@crates//:serde",
        "@crates//:tokio",
        "@crates//:uuid",
    ],
)
