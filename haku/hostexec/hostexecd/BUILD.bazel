load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Security-critical: the Authentik access-token verifier — hostexecd's authorization check.
# RS256 via Authentik's JWKS (per-host audience + hostexec-<run_as>-<host> group); mirrors
# mcp_infra/authentik_auth.
rust_library(
    name = "authentik",
    srcs = ["authentik.rs"],
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "@crates//:jsonwebtoken",
        "@crates//:serde",
        "@crates//:thiserror",
    ],
)

rust_test(
    name = "authentik_test",
    size = "small",
    srcs = ["authentik_test.rs"],
    compile_data = glob(["testdata/*.pem"]),
    edition = "2024",
    deps = [
        ":authentik",
        "@crates//:jsonwebtoken",
        "@crates//:serde",
    ],
)

# Command execution: spawn argv (no shell), wall-clock timeout + kill, output caps with truncation
# reporting. Result shape mirrors mcp_infra.exec.models.BaseExecResult.
rust_library(
    name = "exec",
    srcs = ["exec.rs"],
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "@crates//:serde",
        "@crates//:tokio",
    ],
)

rust_test(
    name = "exec_test",
    size = "small",
    srcs = ["exec_test.rs"],
    edition = "2024",
    deps = [
        ":exec",
        "@crates//:serde_json",
        "@crates//:tokio",
    ],
)
