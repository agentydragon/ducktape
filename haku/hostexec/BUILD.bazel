load("//devinfra/python:defs.bzl", "py_library", "py_test")

# Console-signed exec capability (EdDSA JWT): the cross-language security primitive. The console
# mints here; `hostexecd` (Rust) verifies. Keep the JWT claim contract in lockstep with the Rust
# verifier (hostexec/hostexecd/capability.rs) and its pinned vectors.
py_library(
    name = "capability",
    srcs = ["capability.py"],
    visibility = ["//visibility:public"],
    deps = [
        "@pypi//cryptography",
        "@pypi//pydantic",
        "@pypi//pyjwt",
    ],
)

# The hostexec interface surface: the agent-facing tool input and the hostexecd HTTP body.
py_library(
    name = "wire",
    srcs = ["wire.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":capability",
        "//mcp_infra/exec:models",
        "@pypi//pydantic",
    ],
)

py_test(
    name = "test_capability",
    srcs = ["test_capability.py"],
    deps = [
        ":capability",
        "//:conftest",
        "@pypi//pyjwt",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
