load("//devinfra/python:defs.bzl", "py_library", "py_test")

py_library(
    name = "chunking",
    srcs = ["chunking.py"],
    visibility = ["//visibility:public"],
)

py_library(
    name = "content",
    srcs = ["content.py"],
    visibility = ["//visibility:public"],
)

