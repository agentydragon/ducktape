        ":chunking",
        ":content",
        "//haku/console:chat_models",
    ],
)

py_library(
    name = "chat_source",
    srcs = ["chat_source.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":chat_corpus",
        "//haku/console:chat_models",
        "//haku/console:database_schema",
