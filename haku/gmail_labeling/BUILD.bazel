load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

py_library(
    name = "namespace",
    srcs = ["namespace.py"],
    visibility = ["//:__subpackages__"],
    deps = ["@pypi//fastmcp"],
)

py_library(
    name = "models",
    srcs = ["models.py"],
    visibility = ["//:__subpackages__"],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "backend",
    srcs = ["backend.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//gmail_api:labels",
        "@pypi//google_api_python_client",
    ],
)

py_library(
    name = "client",
    srcs = ["client.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":backend",
        ":models",
        ":namespace",
        "//gmail_api:labels",
        "@pypi//fastmcp",
    ],
)

py_library(
    name = "config",
    srcs = ["config.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "@pypi//pydantic",
        "@pypi//pydantic_settings",
    ],
)

py_library(
    name = "server",
    srcs = ["server.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":backend",
        ":client",
        ":config",
        ":models",
        ":namespace",
        "//gmail_api:service",
        "@pypi//fastmcp",
        "@pypi//pydantic",
        "@pypi//starlette",
        "@pypi//uvicorn",
    ],
)

py_binary(
    name = "server_cli",
    main_module = "haku.gmail_labeling.server",
    visibility = ["//visibility:public"],
    deps = [":server"],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":client",
        ":namespace",
        "//gmail_api:labels",
        "@pypi//pytest",
    ],
)

py_test(
    name = "test_namespace",
    srcs = ["test_namespace.py"],
    deps = [
        ":namespace",
        "@pypi//fastmcp",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_client",
    srcs = ["test_client.py"],
    deps = [
        ":client",
        ":conftest",
        "//gmail_api:labels",
        "@pypi//fastmcp",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_server",
    srcs = ["test_server.py"],
    deps = [
        ":conftest",
        ":server",
        "//:conftest",
        "@pypi//fastmcp",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
