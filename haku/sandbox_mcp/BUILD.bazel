load("@aspect_rules_py//py:defs.bzl", "py_image_layer", aspect_py_binary = "py_binary")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("//devinfra/python:defs.bzl", "py_library", "py_test")
load("//props:oci.bzl", "py_image_entrypoint", "py_image_env")

py_library(
    name = "config",
    srcs = ["config.py"],
    visibility = ["//visibility:public"],
    deps = [
        "@pypi//pydantic",
        "@pypi//pydantic_settings",
        "@pypi//pyyaml",
    ],
)

py_library(
    name = "models",
    srcs = ["models.py"],
    visibility = ["//visibility:public"],
    deps = [
        "//mcp_infra/exec:models",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "kubernetes_client",
    srcs = ["kubernetes_client.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":config",
        ":models",
        "//mcp_infra/exec:models",
        "@pypi//aiohttp",
        "@pypi//fastmcp_slim",
        "@pypi//kubernetes_asyncio",
    ],
)

py_library(
    name = "server",
    srcs = ["server.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":config",
        ":kubernetes_client",
        ":models",
        "//mcp_infra:static_bearer",
        "@pypi//fastmcp_slim",
        "@pypi//mcp",
        "@pypi//pydantic",
        "@pypi//starlette",
        "@pypi//uvicorn",
    ],
)

py_test(
    name = "test_config",
    srcs = ["test_config.py"],
    deps = [
        ":config",
        "//:conftest",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_server",
    srcs = ["test_server.py"],
    deps = [
        ":config",
        ":models",
        ":server",
        "//:conftest",
        "//mcp_infra/exec:models",
        "@pypi//fastmcp_slim",
        "@pypi//mcp",
        "@pypi//pytest_asyncio",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_kubernetes_client",
    srcs = ["test_kubernetes_client.py"],
    deps = [
        ":config",
        ":kubernetes_client",
        ":models",
        "//:conftest",
        "//mcp_infra/exec:models",
        "@pypi//fastmcp_slim",
        "@pypi//kubernetes_asyncio",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",
        "@pypi//pytest_bazel",
    ],
)

aspect_py_binary(
    name = "server_bin",
    main = "server.py",
    deps = [":server"],
)

py_image_layer(
    name = "layers",
    binary = ":server_bin",
    group = "1000",
    owner = "1000",
)

oci_image(
    name = "image",
    base = "@debian_trixie_slim_linux_amd64",
    entrypoint = py_image_entrypoint("server_bin"),
    env = py_image_env(binary_name = "server_bin"),
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [":layers"],
    user = "1000:1000",
    visibility = ["//visibility:public"],
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["haku-sandbox-mcp:latest"],
)
