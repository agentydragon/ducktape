load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "execution",
    srcs = ["execution.py"],
    deps = [
        "//haku/console/grants:principal",
        "@pypi//fastmcp_slim",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "tool_call_service",
    srcs = ["tool_call_service.py"],
    deps = [
        ":execution",
        "//haku/console:mcp_config",
        "//haku/console:settings",
        "//haku/console:tool_call_actor",
        "//haku/console/auto_approval:registry",
        "//haku/console/grants:principal",
        "@ducktape_haku//haku/console:tool_calls",
    ],
)

py_library(
    name = "approval",
    srcs = ["approval.py"],
    deps = [
        ":execution",
        ":tool_call_service",
        "//haku/console:database_schema",
        "//haku/console:mcp_config",
        "//haku/console:tool_call_actor",
        "//haku/console/identity:agent",
        "//haku/console/identity:authorization",
        "//haku/console/identity:operator_auth",
        "//haku/console/identity:operator_identity",
        "@ducktape_haku//haku/console:tool_calls",
        "@pypi//fastapi",
        "@pypi//fastmcp_slim",
        "@pypi//mcp",
        "@pypi//mcp_types",
        "@pypi//pydantic",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "in_process_server_access",
    srcs = ["in_process_server_access.py"],
    deps = [
        ":execution",
        "//haku/console:mcp_config",
        "//haku/console:tool_call_actor",
        "//haku/console/grants:principal",
    ],
)

py_library(
    name = "in_process_servers",
    srcs = ["in_process_servers.py"],
    deps = [
        ":in_process_server_access",
        "//haku/console:mcp_config",
        "//haku/console/tools:grants",
    ],
)

py_library(
    name = "export_tool_schemas",
    srcs = ["export_tool_schemas.py"],
    deps = [
        ":in_process_servers",
        "//grocy_mcp:batch_tools",
        "//grocy_mcp:client",
        "//grocy_mcp:mcp_types",
        "//haku/console/tools:grants",
        "//haku/console/tools:kubernetes",
        "//haku/console/tools:routine",
        "//mcp_infra:request_scoped_openapi",
        "//x/google_mcp_server:gmail",
        "//x/google_mcp_server:google_calendar",
        "@pypi//fastmcp_slim",
    ],
)

# Prints the exact tools/list input schemas for the frontend's generated MCP
# argument validators and types.
py_binary(
    name = "export_tool_schemas_bin",
    main_module = "haku.console.mcp.export_tool_schemas",
    deps = [":export_tool_schemas"],
)

py_test(
    name = "test_tool_call_service",
    size = "medium",
    srcs = ["test_tool_call_service.py"],
    requires_docker = True,
    deps = [
        ":approval",
        ":execution",
        ":tool_call_service",
        "//:conftest",
        "//haku/console:conftest",
        "//haku/console:database_schema",
        "//haku/console:mcp_config",
        "//haku/console:tool_call_actor",
        "//haku/console/grants:principal",
        "//haku/console/identity:agent",
        "//haku/console/identity:operator_identity_store",
        "@ducktape_haku//haku/console:tool_calls",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)

py_test(
    name = "test_approval",
    size = "medium",
    srcs = ["test_approval.py"],
    requires_docker = True,
    deps = [
        ":approval",
        ":execution",
        ":tool_call_service",
        "//:conftest",
        "//haku/console:conftest",
        "//haku/console:database_schema",
        "//haku/console:mcp_config",
        "//haku/console:tool_call_actor",
        "//haku/console/identity:authorization",
        "@ducktape_haku//haku/console:tool_calls",
