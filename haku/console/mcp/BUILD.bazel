load("//devinfra/js:json_schema_js_library.bzl", "json_schema_js_library")
load("//devinfra/python:defs.bzl", "py_binary", "py_library")

py_library(
    name = "export_tool_schemas",
    srcs = ["export_tool_schemas.py"],
    deps = ["//haku/console/tools:routine"],
)

py_binary(
    name = "export_tool_schemas_bin",
    main_module = "haku.console.mcp.export_tool_schemas",
    deps = [":export_tool_schemas"],
)

genrule(
    name = "launch_routine_arguments_schema",
    outs = ["launch_routine_arguments.schema.json"],
    cmd = "$(location :export_tool_schemas_bin) $@",
    tools = [":export_tool_schemas_bin"],
)

json_schema_js_library(
    name = "launch_routine_arguments",
    schema = ":launch_routine_arguments.schema.json",
    visibility = [
        "//haku/console/frontend:__pkg__",
        "//haku/console/frontend/tool_rendering/haku_routine:__pkg__",
    ],
)
