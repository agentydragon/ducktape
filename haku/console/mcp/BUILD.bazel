load("//devinfra/js:json_schema_js_library.bzl", "json_schema_js_library")
load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "export_tool_schemas",
    srcs = ["export_tool_schemas.py"],
    deps = [
        "//grocy_mcp:batch_tools",
        "//grocy_mcp:client",
        "//grocy_mcp:mcp_types",
        "//haku/console/tools:routine",
        "//mcp_infra:request_scoped_openapi",
        "//x/google_mcp_server:gmail",
        "//x/google_mcp_server:google_calendar",
        "@pypi//fastmcp_slim",
    ],
)

# Prints the exact tools/list input schemas for the frontend's generated MCP
# argument validators and types.
py_binary(
    name = "export_tool_schemas_bin",
    main_module = "haku.console.mcp.export_tool_schemas",
    deps = [":export_tool_schemas"],
)

genrule(
    name = "tool_arguments_schema",
    outs = ["tool_arguments.schema.json"],
    cmd = "$(location :export_tool_schemas_bin) > $@",
    tools = [":export_tool_schemas_bin"],
    visibility = ["//haku/console/frontend:__pkg__"],
)

genrule(
    name = "tool_results_schema",
    outs = ["tool_results.schema.json"],
    cmd = "$(location :export_tool_schemas_bin) --results > $@",
    tools = [":export_tool_schemas_bin"],
    visibility = ["//haku/console/frontend:__pkg__"],
)

json_schema_js_library(
    name = "tool_arguments",
    schema = ":tool_arguments_schema",
    visibility = ["//haku/console/frontend:__pkg__"],
)

json_schema_js_library(
    name = "tool_results",
    schema = ":tool_results_schema",
    visibility = ["//haku/console/frontend:__pkg__"],
)

py_test(
    name = "test_export_tool_schemas",
    size = "medium",
    srcs = ["test_export_tool_schemas.py"],
    deps = [
        ":export_tool_schemas",
        "//:conftest",
        "//haku/console:conftest",
        "@pypi//jsonschema",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//referencing",
    ],
)
