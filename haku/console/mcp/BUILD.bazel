load("//devinfra/js:json_schema_js_library.bzl", "json_schema_js_library")
load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "export_tool_schemas",
    srcs = ["export_tool_schemas.py"],
    deps = [
        "//grocy_mcp:batch_tools",
        "//grocy_mcp:client",
        "//grocy_mcp:mcp_types",
        "//haku/console/tools:routine",
        "//mcp_infra:request_scoped_openapi",
        "//x/google_mcp_server:gmail",
        "//x/google_mcp_server:google_calendar",
        "@pypi//fastmcp_slim",
        "@pypi//mcp_types",
    ],
)

# Reflects each server once for both frontend catalogs. Keep each JSON output directly addressable
# by the producer-owned schema library that generates its declaration and import path.
py_binary(
    name = "export_tool_schemas_bin",
    main_module = "haku.console.mcp.export_tool_schemas",
    deps = [":export_tool_schemas"],
)

genrule(
    name = "tool_schema_catalogs",
    outs = [
        "tool_arguments.schema.json",
        "tool_results.schema.json",
    ],
    cmd = "$(location :export_tool_schemas_bin) --arguments-output $(@D)/tool_arguments.schema.json --results-output $(@D)/tool_results.schema.json",
    tools = [":export_tool_schemas_bin"],
    visibility = ["//haku/console/frontend:__pkg__"],
)

json_schema_js_library(
    name = "tool_arguments",
    schema = ":tool_arguments.schema.json",
    visibility = ["//haku/console/frontend:__pkg__"],
)

json_schema_js_library(
    name = "tool_results",
    schema = ":tool_results.schema.json",
    visibility = ["//haku/console/frontend:__pkg__"],
)

py_test(
    name = "test_export_tool_schemas",
    size = "medium",
    srcs = ["test_export_tool_schemas.py"],
    deps = [
        ":export_tool_schemas",
        "//:conftest",
        "//haku/console:conftest",
        "@pypi//jsonschema",
        "@pypi//mcp_types",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//referencing",
    ],
)
