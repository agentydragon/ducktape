# Cache policy for the static content nginx serves ITSELF (fingerprinted assets are immutable; the
# SPA shell is never stored). Backend responses are NOT listed here — the FastAPI app owns
# their Cache-Control (haku/console/app.py `_cache_control_for_path`) and the proxied locations below
# pass it through untouched.
# Cache fingerprinted successful assets forever, but never preserve a redirect or transient error.
map $status $haku_asset_cache_control {
  200     "public, max-age=31536000, immutable";
  206     "public, max-age=31536000, immutable";
  304     "public, max-age=31536000, immutable";
  default "no-store";
}

# WebSocket upgrade passthrough for the live tool-call event socket
# (/api/events/ws). `proxy_http_version 1.1` alone is not enough — nginx only
# forwards the Upgrade/Connection handshake headers when they're set explicitly,
# so without this the WS handshake is silently downgraded to a plain request and
# the socket fails (the console's approvals panel then only updates on reload).
# `close` for non-upgrade requests keeps ordinary keepalive to the FastAPI upstream.
map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen 8081;
  server_name _;

  root /usr/share/nginx/html/dist;
  index index.html;

  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  # This service's public HTTPRoute is pinned to the https-wildcard listener. The same-pod upstream
  # hop is plain HTTP, so `$scheme` would generate public downgrade redirects; do not trust a
  # client-supplied forwarding header either. Direct local development uses FastAPI, not this image.
  proxy_set_header X-Forwarded-Proto https;

  # Response headers are owned per-server: nginx sets CSP/Cache-Control/Referrer/Permissions ONLY on
  # the static content it serves itself (the two static locations below). The FastAPI app sets those
  # same headers on every response it returns (haku/console/app.py `_security_headers`), so the
  # proxied `location`s deliberately set no response headers and let the app's pass through — no
  # hide-and-reset, no policy written twice. (`geolocation`/`display-capture=(self)` scope the
  # geolocation + screenshot permissions to the shell origin so neither is ever delegated to the
  # framed haku-ui iframe — docs/containment.md.)

  location /assets/ {
    try_files $uri =404;
    add_header Content-Security-Policy
      "frame-src 'self' ${HAKU_CONSOLE_HAKU_UI_URL} ${HAKU_CONSOLE_AUTH_ORIGIN}; frame-ancestors 'none'"
      always;
    add_header Cache-Control $haku_asset_cache_control always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "geolocation=(self), display-capture=(self)" always;
  }

  # ── Backend surfaces proxied to the FastAPI app (127.0.0.1:8080) ──────────────────────────────
  # These locations mirror the app's top-level backend prefixes: the app.py routers (/api, /healthz),
  # the /mcp mount, the /auth (operator OIDC) router, and the OAuth discovery docs. INVARIANT: a new
  # top-level backend prefix needs a matching location here, or it falls through to the SPA shell
  # (`location /`) and returns index.html instead of reaching the app (this is what bit /mcp). They
  # set no response headers — the app owns its own (see the note above).

  location /api/ {
    proxy_pass http://127.0.0.1:8080;
    # Carry the WebSocket handshake through to FastAPI (/api/events/ws).
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    # WS connections are long-lived; don't let the proxy read timeout kill an idle
    # socket that's just waiting for the next tool-call event.
    proxy_read_timeout 3600s;
  }

  location = /healthz {
    proxy_pass http://127.0.0.1:8080;
  }

  # Agent-and-Operator MCP server (streamable HTTP / SSE), plus OIDCProxy OAuth routes FastMCP serves
  # under the /mcp mount. Disable proxy buffering so the event stream flushes, and allow a long read
  # timeout for idle streams and the OAuth dance.
  location /mcp {
    proxy_pass http://127.0.0.1:8080;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_read_timeout 3600s;
  }

  # Operator browser OIDC login (operator_auth router: /auth/login,/callback,/logout,/me).
  location /auth/ {
    proxy_pass http://127.0.0.1:8080;
  }

  # OAuth discovery documents the MCP OIDCProxy serves at the root (RFC 8414 / 9728 path-suffix
  # forms), which claude.ai fetches before connecting to /mcp.
  location ~ ^/\.well-known/oauth {
    proxy_pass http://127.0.0.1:8080;
  }

  location / {
    try_files $uri /index.html;
    etag off;
    if_modified_since off;
    add_header Content-Security-Policy
      "frame-src 'self' ${HAKU_CONSOLE_HAKU_UI_URL} ${HAKU_CONSOLE_AUTH_ORIGIN}; frame-ancestors 'none'"
      always;
    add_header Cache-Control "no-store" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "geolocation=(self), display-capture=(self)" always;
  }
}
