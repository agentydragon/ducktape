load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//haku/console:__subpackages__"])

py_library(
    name = "__init__",
    srcs = ["__init__.py"],
)

py_library(
    name = "models",
    srcs = ["models.py"],
)

py_library(
    name = "naming",
    srcs = ["naming.py"],
)

py_test(
    name = "test_naming",
    srcs = ["test_naming.py"],
    deps = [
        ":naming",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "enrollment",
    srcs = ["enrollment.py"],
    deps = [":models"],
)

py_library(
    name = "authorization",
    srcs = ["authorization.py"],
    deps = [
        ":enrollment",
        ":launch_authority",
        ":models",
        ":naming",
        "//haku/console:database_schema",
        "//haku/console:operator_identity",
        "//haku/console:operator_identity_store",
        "//haku/console:tool_call_actor",
        "//haku/console/mcp_auth:fastmcp_adapter",
        "//haku/console/session:launch_identity",
        "//mcp_infra/authentik_auth:oidc_principal",
        "@pypi//psycopg",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "launch_authority",
    srcs = ["launch_authority.py"],
    deps = [
        ":models",
        "//haku/console:database_schema",
        "//haku/console:operator_identity",
        "//haku/console/session:launch_identity",
        "@pypi//sqlalchemy",
    ],
)

py_test(
    name = "test_authorization",
    size = "medium",
    srcs = ["test_authorization.py"],
    data = [
        "//third_party/containers:pgvector_pg18",
        "//third_party/containers:ryuk",
    ],
    requires_docker = True,
    deps = [
        ":authorization",
        ":enrollment",
        ":launch_authority",
        "//:conftest",
        "//haku/console:conftest",
        "//haku/console:database_migrate",
        "//haku/console:database_schema",
        "//haku/console:operator_identity",
        "//haku/console:operator_identity_store",
        "//haku/console/mcp_auth:fastmcp_adapter",
        "//haku/console/x:runtime",
        "//mcp_infra/authentik_auth:oidc_principal",
        "//util/testing:postgres",
        "//util/testing:postgres_fixtures",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "enrollment_routes",
    srcs = ["enrollment_routes.py"],
    deps = [
        ":enrollment",
        ":models",
        ":naming",
        "//haku/console:config",
        "//haku/console:operator_agents",
        "//haku/console:operator_auth",
        "@pypi//fastapi",
        "@pypi//pydantic",
        "@pypi//starlette",
    ],
)

py_test(
    name = "test_enrollment_routes",
    srcs = ["test_enrollment_routes.py"],
    deps = [
        ":enrollment",
        ":enrollment_routes",
        "//haku/console:operator_auth",
        "@pypi//fastapi",
        "@pypi//httpx2",
        "@pypi//pytest_bazel",
        "@pypi//python_multipart",
    ],
)
