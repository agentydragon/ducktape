<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Connect an agent · Haku</title>
    <style nonce="{{ csp_nonce }}">
      :root {
        color-scheme: dark;
        font-family:
          Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }

      * {
        box-sizing: border-box;
      }

      body {
        min-height: 100vh;
        margin: 0;
        display: grid;
        place-items: center;
        padding: 24px;
        background: radial-gradient(circle at top, #28223f 0, #12101c 44%, #09080d 100%);
        color: #f7f3ff;
      }

      main {
        width: min(100%, 620px);
        padding: 32px;
        border: 1px solid #4b4265;
        border-radius: 20px;
        background: rgb(24 21 35 / 96%);
        box-shadow: 0 24px 80px rgb(0 0 0 / 53%);
      }

      .eyebrow {
        margin: 0 0 8px;
        color: #c4b5fd;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.09em;
        text-transform: uppercase;
      }

      h1 {
        margin: 0;
        font-size: clamp(28px, 7vw, 38px);
        line-height: 1.1;
      }

      h2 {
        margin: 0 0 8px;
        font-size: 18px;
      }

      .intro {
        margin: 14px 0 18px;
        color: #d4cde2;
        line-height: 1.55;
      }

      .delegation {
        margin: 0 0 24px;
        padding: 14px;
        border-left: 3px solid #a78bfa;
        border-radius: 8px;
        background: #221d31;
        color: #ddd6ed;
        line-height: 1.5;
      }

      .error {
        margin: 0 0 18px;
        padding: 12px;
        border: 1px solid #f87171;
        border-radius: 10px;
        background: rgb(127 29 29 / 33%);
        color: #fecaca;
      }

      .choice {
        margin-top: 14px;
        padding: 18px;
        border: 1px solid #4b4265;
        border-radius: 14px;
        background: #17131f;
      }

      label {
        display: block;
        margin: 14px 0 8px;
        font-weight: 650;
      }

      input[type="text"],
      select {
        width: 100%;
        padding: 12px 14px;
        border: 1px solid #6e638c;
        border-radius: 10px;
        background: #100e18;
        color: #fff;
        font: inherit;
        outline: none;
      }

      input[type="text"]:focus,
      select:focus {
        border-color: #a78bfa;
        box-shadow: 0 0 0 3px rgb(139 92 246 / 20%);
      }

      .hint,
      .unavailable {
        margin: 8px 0 16px;
        color: #aaa0bc;
        font-size: 13px;
        line-height: 1.45;
      }

      button {
        width: 100%;
        margin-top: 14px;
        padding: 12px 16px;
        border: 0;
        border-radius: 10px;
        font: inherit;
        font-weight: 700;
        cursor: pointer;
      }

      .allow {
        background: #8b5cf6;
        color: white;
      }

      .allow:hover {
        background: #7c3aed;
      }

      .deny {
        background: #353044;
        color: #eee9f7;
      }

      .deny:hover {
        background: #443d56;
      }

      .deny-form {
        margin-top: 10px;
      }

      details {
        margin-top: 24px;
        color: #aaa0bc;
        font-size: 13px;
      }

      summary {
        cursor: pointer;
        color: #c9c0d8;
      }

      dl {
        display: grid;
        grid-template-columns: max-content 1fr;
        gap: 8px 12px;
        overflow-wrap: anywhere;
      }

      dt {
        color: #8f849f;
      }

      dd {
        margin: 0;
        color: #d4cde2;
      }

      .scopes {
        margin: 0;
        padding: 0;
        list-style: none;
      }

      code {
        overflow-wrap: anywhere;
      }
    </style>
  </head>
  <body>
    <main>
      <p class="eyebrow">Haku Console</p>
      <h1>Connect an agent</h1>
      <p class="intro">
        <strong>{{ view.client_software }}</strong> wants to connect an MCP agent that can ask Haku to use tools as
        <strong>{{ view.operator_display_name }}</strong>.
      </p>
      <p class="delegation">
        This agent may act as you only when Haku's auto-approval policy permits a tool call or when you explicitly
        approve that specific call.
      </p>

      {% if view.error is not none %}
        <p class="error" role="alert">{{ view.error }}</p>
      {% endif %}

      <section class="choice" aria-labelledby="create-agent-heading">
        <h2 id="create-agent-heading">Create a new agent</h2>
        <p class="hint">Give this agent a unique name you will recognize in approvals and history.</p>
        <form method="post" action="{{ view.create_form_action }}">
          <input type="hidden" name="form_token" value="{{ view.form_token }}" />
          <label for="agent-name">Agent name</label>
          <input
            id="agent-name"
            name="agent_name"
            type="text"
            required
            maxlength="{{ agent_name_max_length }}"
            autocomplete="off"
            autofocus
            value="{{ view.suggested_agent_name }}"
            placeholder="e.g. Kitchen Claude"
          />
          <button class="allow" type="submit">Allow new agent</button>
        </form>
      </section>

      <section class="choice" aria-labelledby="reconnect-agent-heading">
        <h2 id="reconnect-agent-heading">Reconnect an existing agent</h2>
        {% if view.reconnect_agents %}
          <p class="hint">Replace that agent's current MCP connection without creating a second identity.</p>
          <form method="post" action="{{ view.reconnect_form_action }}">
            <input type="hidden" name="form_token" value="{{ view.form_token }}" />
            <label for="reconnect-agent">Existing agent</label>
            <select id="reconnect-agent" name="agent_id" required>
              {% for agent in view.reconnect_agents %}
                <option value="{{ agent.agent_id }}">{{ agent.display_name }}</option>
              {% endfor %}
            </select>
            <button class="allow" type="submit">Allow reconnection</button>
          </form>
        {% else %}
          <p class="unavailable">You do not have an existing agent available to reconnect.</p>
        {% endif %}
      </section>

      <form class="deny-form" method="post" action="{{ view.deny_form_action }}">
        <input type="hidden" name="form_token" value="{{ view.form_token }}" />
        <button class="deny" type="submit" formnovalidate>Deny request</button>
      </form>

      <details>
        <summary>Connection details</summary>
        <dl>
          <dt>Signed in as</dt>
          <dd>{{ view.operator_display_name }}</dd>
          <dt>Client software</dt>
          <dd>{{ view.client_software }}</dd>
          <dt>Redirect host</dt>
          <dd>{{ view.redirect_host }}</dd>
          <dt>Requested scopes</dt>
          <dd>
            {% if view.scopes %}
              <ul class="scopes">
                {% for scope in view.scopes %}
                  <li><code>{{ scope }}</code></li>
                {% endfor %}
              </ul>
            {% else %}
              None requested
            {% endif %}
          </dd>
        </dl>
      </details>
    </main>
  </body>
</html>
