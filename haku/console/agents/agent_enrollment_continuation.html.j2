<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content="1; url={{ authorization_url }}" />
    <title>Finishing connection · Haku</title>
    <style nonce="{{ csp_nonce }}">
      :root {
        color-scheme: dark;
        font-family:
          Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }

      body {
        min-height: 100vh;
        margin: 0;
        display: grid;
        place-items: center;
        padding: 24px;
        background: radial-gradient(circle at top, #28223f 0, #12101c 44%, #09080d 100%);
        color: #f7f3ff;
      }

      main {
        width: min(100%, 560px);
        padding: 32px;
        border: 1px solid #4b4265;
        border-radius: 20px;
        background: rgb(24 21 35 / 96%);
        box-shadow: 0 24px 80px rgb(0 0 0 / 53%);
      }

      h1 {
        margin: 0 0 14px;
        font-size: clamp(28px, 7vw, 38px);
        line-height: 1.1;
      }

      p {
        color: #d4cde2;
        line-height: 1.55;
      }

      a {
        display: inline-block;
        margin-top: 10px;
        padding: 12px 16px;
        border-radius: 10px;
        background: linear-gradient(135deg, #8b5cf6, #6d28d9);
        color: #fff;
        font-weight: 700;
        text-decoration: none;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>Agent approved</h1>
      <p>Haku is finishing the secure connection. This page will continue automatically.</p>
      <p>If nothing happens, <a class="continue" href="{{ authorization_url }}">continue authorization</a>.</p>
    </main>
  </body>
</html>
