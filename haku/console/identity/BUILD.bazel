load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "operator_identity",
    srcs = ["operator_identity.py"],
)

py_library(
    name = "operator_identity_store",
    srcs = ["operator_identity_store.py"],
    deps = [
        ":operator_identity",
        "//haku/console:database_schema",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "operator_login_flow",
    srcs = ["operator_login_flow.py"],
    deps = [
        "//haku/console:database_schema",
        "@pypi//authlib",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "operator_auth",
    srcs = ["operator_auth.py"],
    deps = [
        ":operator_identity",
        ":operator_identity_store",
        ":operator_login_flow",
        "//haku/console:config",
        "//haku/console:settings",
        "//haku/console:tool_call_actor",
        "//haku/console/oauth:callback_page",
        "@pypi//authlib",
        "@pypi//fastapi",
        # keep: authlib.integrations.starlette_client imports authlib's own httpx_client
        # integration (plain httpx, not httpx2 -- authlib itself is unaffected by the
        # fastmcp/mcp-sdk httpx2 migration), not surfaced by scanning this file's own imports.
        "@pypi//httpx",
        "@pypi//pydantic",
        "@pypi//starlette",
    ],
)

py_library(
    name = "agent",
    srcs = ["agent.py"],
)

py_library(
    name = "naming",
    srcs = ["naming.py"],
)

py_library(
    name = "enrollment",
    srcs = ["enrollment.py"],
    deps = [":agent"],
)

py_library(
    name = "operator_agents",
    srcs = ["operator_agents.py"],
    deps = [
        ":enrollment",
        "//haku/console:tool_call_actor",
        "@pypi//fastapi",
    ],
)

py_library(
    name = "authorization",
    srcs = ["authorization.py"],
    deps = [
        ":agent",
        ":enrollment",
        ":naming",
        ":oauth_grants",
        ":operator_identity",
        ":operator_identity_store",
        "//haku/console:database_schema",
        "//haku/console:tool_call_actor",
        "//mcp_infra:oidc_principal",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "agent_bearer_authority",
    srcs = ["agent_bearer_authority.py"],
    deps = [
        ":authorization",
        ":oauth_grants",
        "//haku/console:tool_call_actor",
    ],
)

py_library(
    name = "enrollment_routes",
    srcs = ["enrollment_routes.py"],
    deps = [
        ":agent",
        ":enrollment",
        ":naming",
        ":operator_agents",
        ":operator_auth",
        "//haku/console:settings",
        "@pypi//fastapi",
        "@pypi//pydantic",
        "@pypi//starlette",
    ],
)

py_test(
    name = "test_naming",
    srcs = ["test_naming.py"],
    deps = [
        ":naming",
        "//:conftest",
        "//haku/console:conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_enrollment_routes",
    srcs = ["test_enrollment_routes.py"],
    deps = [
        ":agent",
        ":enrollment",
        ":enrollment_routes",
        ":operator_auth",
        "//:conftest",
        "//haku/console:conftest",
        "@pypi//fastapi",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_authorization",
    size = "medium",
    srcs = ["test_authorization.py"],
    requires_docker = True,
    deps = [
        ":agent",
        ":authorization",
        ":enrollment",
        ":oauth_grants",
        ":operator_identity",
        ":operator_identity_store",
        "//:conftest",
        "//haku/console:conftest",
        "//haku/console:database_migrate",
        "//haku/console:database_schema",
        "//haku/console:tool_call_actor",
        "//haku/console/mcp:approval",
        "//mcp_infra:oidc_principal",
        "//util/testing:postgres",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)

py_test(
    name = "test_operator_identity",
    size = "medium",
    srcs = ["test_operator_identity.py"],
    requires_docker = True,
    deps = [
        ":operator_identity",
        ":operator_identity_store",
        "//:conftest",
        "//haku/console:config",
        "//haku/console:conftest",
        "//haku/console:database_schema",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)

py_test(
    name = "test_operator_auth",
    size = "medium",
    srcs = ["test_operator_auth.py"],
    requires_docker = True,
    deps = [
        ":operator_auth",
        ":operator_login_flow",
        "//:conftest",
        "//haku/console:app",
        "//haku/console:config",
        "//haku/console:conftest",
        "//haku/console:database_schema",
        "//util:net",
        "//util/testing:asgi",
        "//util/testing:mock_oidc",
        "@pypi//fastapi",
        "@pypi//httpx",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//pyyaml",
        "@pypi//sqlalchemy",
    ],
