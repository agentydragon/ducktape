load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "operator_identity",
    srcs = ["operator_identity.py"],
)

py_library(
    name = "operator_identity_store",
    srcs = ["operator_identity_store.py"],
    deps = [
        ":operator_identity",
        "//haku/console:database_schema",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "operator_login_flow",
    srcs = ["operator_login_flow.py"],
    deps = [
        "//haku/console:database_schema",
        "@pypi//authlib",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "operator_auth",
    srcs = ["operator_auth.py"],
    deps = [
        ":operator_identity",
        ":operator_identity_store",
        ":operator_login_flow",
        "//haku/console:config",
        "//haku/console:settings",
        "//haku/console/oauth:callback_page",
        "@pypi//authlib",
        "@pypi//fastapi",
        # keep: authlib.integrations.starlette_client imports authlib's own plain httpx client
        # integration, not surfaced by scanning this file's own imports.
        "@pypi//httpx",
        "@pypi//pydantic",
        "@pypi//starlette",
    ],
)

py_library(
    name = "agent",
    srcs = ["agent.py"],
)

py_library(
    name = "config",
    srcs = ["config.py"],
    deps = ["@pypi//pydantic"],
)

py_test(
    name = "test_config",
    srcs = ["test_config.py"],
    deps = [
        ":config",
        "//:conftest",
        "//haku/console:conftest",
        "//haku/console:settings",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "naming",
    srcs = ["naming.py"],
)

py_library(
    name = "enrollment",
    srcs = ["enrollment.py"],
    deps = [":agent"],
)

py_library(
    name = "operator_agents",
    srcs = ["operator_agents.py"],
    deps = [
        ":enrollment",
        "@pypi//fastapi",
    ],
)

py_library(
    name = "authorization",
    srcs = ["authorization.py"],
    deps = [
        ":agent",
        ":enrollment",
        ":naming",
        ":operator_identity",
        ":operator_identity_store",
        "//haku/console:database_schema",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "agent_routes",
    srcs = ["agent_routes.py"],
    deps = [
        ":agent",
        ":enrollment",
        ":operator_agents",
        ":operator_auth",
        "@pypi//fastapi",
        "@pypi//pydantic",
    ],
)

py_test(
    name = "test_naming",
    srcs = ["test_naming.py"],
    deps = [
        ":naming",
        "//:conftest",
        "//haku/console:conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_agent_routes",
    srcs = ["test_agent_routes.py"],
    deps = [
        ":agent",
        ":agent_routes",
        ":enrollment",
        ":operator_auth",
        "//:conftest",
        "//haku/console:conftest",
        "@pypi//fastapi",
        "@pypi//httpx",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_authorization",
    size = "medium",
    srcs = ["test_authorization.py"],
    requires_docker = True,
    deps = [
        ":agent",
        ":authorization",
        ":enrollment",
        ":operator_identity",
        ":operator_identity_store",
        "//:conftest",
        "//haku/console:conftest",
        "//haku/console:database_schema",
        "//util:db_url",
        "//util/testing:sqlalchemy_engines",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)

py_test(
    name = "test_operator_identity",
    size = "medium",
    srcs = ["test_operator_identity.py"],
    requires_docker = True,
    deps = [
        ":operator_identity",
        ":operator_identity_store",
        "//:conftest",
        "//haku/console:config",
        "//haku/console:conftest",
        "//haku/console:database_schema",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)

py_test(
    name = "test_operator_auth",
    size = "medium",
    srcs = ["test_operator_auth.py"],
    requires_docker = True,
    deps = [
        ":operator_auth",
        ":operator_login_flow",
        "//:conftest",
        "//haku/console:app",
        "//haku/console:config",
        "//haku/console:conftest",
        "//haku/console:database_schema",
        "//util/testing:asgi",
        "//util/testing:mock_oidc",
        "@pypi//fastapi",
        "@pypi//httpx",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)
