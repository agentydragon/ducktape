"""Codex app-server Console launch adapter -- the runner owns its protocol and projection (#4667)."""

load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//haku/console/x:__pkg__"])

py_library(
    name = "config",
    srcs = ["config.py"],
    visibility = [
        "//haku/console:__pkg__",
        "//haku/console/session:__pkg__",
        "//haku/console/x:__pkg__",
    ],
    deps = [
        "//haku/console:http_url",
        "//haku/console/harnesses:kind",
        "//haku/runner:backend",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "runtime",
    srcs = ["runtime.py"],
    deps = [
        ":config",
        "//haku/console/harnesses:kind",
        "//haku/console/x:runtime",
        "//haku/runner:protocol",
        "//haku/runner/codex:options",
    ],
)

py_test(
    name = "test_runtime",
    srcs = ["test_runtime.py"],
    deps = [
        ":config",
        ":runtime",
        "//:conftest",
        "//haku/console:conftest",
        "//haku/console/harnesses:kind",
        "//haku/console/x:conftest",
        "//haku/console/x:runtime",
        "//haku/runner/codex:options",
        "@pypi//pytest_bazel",
    ],
)
