"""Codex app-server runtime adapter, protocol evidence and capture tooling."""

load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//haku/console/x:__pkg__"])

py_library(
    name = "protocol",
    srcs = ["protocol.py"],
)

py_library(
    name = "frames",
    srcs = ["frames.py"],
)

py_library(
    name = "client",
    srcs = ["client.py"],
    deps = [
        ":frames",
        ":protocol",
        "//haku/console/x:runtime",
        "//haku/runtime/x/bridge:client",
        "//haku/runtime/x/bridge:protocol",
        "//haku/runtime/x/bridge:transport",
    ],
)

py_library(
    name = "projection",
    srcs = ["projection.py"],
    deps = [
        ":frames",
        ":protocol",
        "//haku/console:chat_models",
        "//haku/console/x:conversation_events",
    ],
)

py_library(
    name = "runtime",
    srcs = ["runtime.py"],
    deps = [
        ":client",
        ":frames",
        ":projection",
        "//haku/console:chat_models",
        "//haku/console/x:conversation_events",
        "//haku/console/x:runtime",
        "//haku/runtime/x/bridge:client",
        "//haku/runtime/x/bridge:codex_options",
        "//haku/runtime/x/bridge:protocol",
        "//haku/runtime/x/bridge:transport",
    ],
)

py_library(
    name = "capture",
    srcs = ["capture.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":client",
        ":frames",
        ":protocol",
        "//haku/runtime/x/bridge:client",
        "//haku/runtime/x/bridge:protocol",
    ],
)

py_binary(
    name = "capture_bin",
    srcs = ["capture_main.py"],
    main_module = "haku.console.x.codex_app_server.capture_main",
    visibility = ["//visibility:public"],
    deps = [":capture"],
)

py_test(
    name = "test_protocol",
    srcs = ["test_protocol.py"],
    deps = [
        ":protocol",
        "//:conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_client",
    srcs = ["test_client.py"],
    deps = [
        ":client",
        "//:conftest",
        "//haku/runtime/x/bridge:client",
        "//haku/runtime/x/bridge:protocol",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",  # keep: pytest plugin (auto async mode), not a direct import
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_bridge",
    size = "medium",
    srcs = ["test_bridge.py"],
    data = ["//haku/console/x/codex_app_server/testing:stub_codex_bin"],
    deps = [
        ":runtime",
        "//:conftest",
        "//haku/console/x:conversation_events",
        "//haku/console/x:runtime",
        "//haku/runtime/x/bridge:client",
        "//haku/runtime/x/bridge:codex_options",
        "//haku/runtime/x/bridge:protocol",
        "//haku/runtime/x/bridge:runner",
        "//util/bazel:runfiles",
        "@pypi//anyio",
        "@pypi//pytest_asyncio",  # keep: pytest plugin (auto async mode), not a direct import
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_runtime",
    srcs = ["test_runtime.py"],
    deps = [
        ":client",
        ":projection",
        ":runtime",
        "//:conftest",
        "//haku/console:chat_models",
        "//haku/console/x:conversation_events",
        "//haku/console/x:runtime",
        "//haku/runtime/x/bridge:codex_options",
        "//haku/runtime/x/bridge:protocol",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_capture",
    srcs = ["test_capture.py"],
    deps = [
        ":capture",
        "//:conftest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_projection",
    srcs = ["test_projection.py"],
    data = ["testdata/schema_derived_turn.synthetic.jsonl"],
    deps = [
        ":projection",
        ":protocol",
        "//:conftest",
        "//haku/console:chat_models",
        "//haku/console/x:conversation_events",
        "//util/bazel:runfiles",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_real_fixture",
    srcs = ["test_real_fixture.py"],
    data = [
        "testdata/real_provider_failure.sanitized.jsonl",
        "testdata/real_text_command.sanitized.jsonl",
    ],
    deps = [
        ":projection",
        ":protocol",
        ":runtime",
        "//:conftest",
        "//haku/console:chat_models",
        "//haku/console/x:conversation_events",
        "//haku/runtime/x/bridge:protocol",
        "//util/bazel:runfiles",
        "@pypi//pytest_bazel",
    ],
)
