load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "claude_chat",
    srcs = ["claude_chat.py"],
    deps = [
        ":chat_notifications",
        "//haku/console:config",
        "//haku/console:database_schema",
        "//haku/console:operator_auth",
        "//haku/runtime/x/agent_sdk_transport:options",
        "//haku/runtime/x/agent_sdk_transport:protocol",
        "//haku/runtime/x/agent_sdk_transport:transport",
        "@pypi//claude_agent_sdk",
        "@pypi//fastapi",
        "@pypi//kubernetes_asyncio",
        "@pypi//pydantic",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "chat_notifications",
    srcs = ["chat_notifications.py"],
    deps = [
        "@pypi//asyncpg",
        "@pypi//pydantic",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    deps = [
        ":chat_notifications",
        ":claude_chat",
        ":matrix_session",
        "//haku/console:config",
        "//haku/console:operator_identity_store",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//sqlalchemy",
    ],
)

py_test(
    name = "test_chat_notifications",
    size = "medium",  # provisions a Postgres database per test
    srcs = ["test_chat_notifications.py"],
    deps = [
        ":chat_notifications",
        ":conftest",
        "//:conftest",
        "//haku/console:conftest",
        "@pypi//pytest_asyncio",  # keep: pytest plugin (auto async mode), not a direct import
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)

py_test(
    name = "test_claude_chat",
    size = "medium",  # provisions a Postgres database per test
    srcs = ["test_claude_chat.py"],
    deps = [
        ":claude_chat",
        ":conftest",
        "//:conftest",
        "//haku/console:config",
        "//haku/console:conftest",
        "@pypi//claude_agent_sdk",
        "@pypi//kubernetes_asyncio",
        "@pypi//pydantic",
        "@pypi//pytest_asyncio",  # keep: pytest plugin (auto async mode), not a direct import
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "matrix_client",
    srcs = ["matrix_client.py"],
    deps = ["@pypi//matrix_nio"],
)

py_test(
    name = "test_matrix_client",
    srcs = ["test_matrix_client.py"],
    deps = [
        ":matrix_client",
        "//:conftest",
        "@pypi//matrix_nio",
        "@pypi//pytest_asyncio",  # keep: pytest plugin (auto async mode), not a direct import
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "matrix_session",
    srcs = ["matrix_session.py"],
    deps = [
        ":chat_notifications",
        ":claude_chat",
        ":matrix_client",
        "//haku/console:config",
        "//haku/console:database_schema",
        "//haku/console:operator_identity_store",
