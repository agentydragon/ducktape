"""Test implementations of the session runtime's outside-the-process collaborators."""

load("//devinfra/python:defs.bzl", "py_library")

package(
    default_testonly = True,
    default_visibility = ["//visibility:public"],
)

py_library(
    name = "recording_claims",
    srcs = ["recording_claims.py"],
    deps = ["//haku/console/x:sandbox_claims"],
)

py_library(
    name = "waiting",
    srcs = ["waiting.py"],
)

py_library(
    name = "wake_probes",
    srcs = ["wake_probes.py"],
    deps = [
        "//haku/console/x:pg_wake",
        "@pypi//asyncpg",
        "@pypi//pytest",
        "@pypi//sqlalchemy",
    ],
)
