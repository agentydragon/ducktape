"""Claude Code as one CLI harness: everything that knows its wire format."""

load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

# Only the runtime folds a harness's wire, so a channel that came to know Claude's frames fails to
# build rather than being caught in review.
package(default_visibility = [
    "//haku/console/conversation:__pkg__",
    "//haku/console/session:__pkg__",
    "//haku/console/x:__pkg__",
])

py_library(
    name = "frames",
    srcs = ["frames.py"],
    # A channel *test* driving a fake backend is the one thing on the far side of that rule that
    # has to know the wire: it asserts against the frames the stub produced.
    visibility = [
        "//haku/console/channels/matrix/testing:__pkg__",
        "//haku/console/conversation:__pkg__",
        "//haku/console/session:__pkg__",
        "//haku/console/x:__pkg__",
        "//haku/console/x/claude_code/testing:__pkg__",
    ],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "client",
    srcs = ["client.py"],
    deps = [
        "//haku/cli_protocol:frames",
        "//haku/runner:client",
        "//haku/runner:protocol",
        "//haku/runner:transport",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "projection",
    srcs = ["projection.py"],
    visibility = [
        "//haku/console/session:__pkg__",
        "//haku/console/x:__pkg__",
        "//haku/console/x/claude_code/testing:__pkg__",
    ],
    deps = [
        ":frames",
        "//haku/console:chat_models",
        "//haku/console/conversation:conversation_event",
        "//haku/console/x:conversation_events",
    ],
)

py_library(
    name = "runtime",
    srcs = ["runtime.py"],
    deps = [
        ":client",
        ":frames",
        ":projection",
        ":wake",
        "//haku/console/harnesses:kind",
        "//haku/console/x:conversation_events",
        "//haku/console/x:runtime",
        "//haku/runner:client",
        "//haku/runner:protocol",
        "//haku/runner:transport",
        "//haku/runner/claude:options",
    ],
)

py_library(
    name = "wake",
    srcs = ["wake.py"],
    deps = [
        "//haku/console/x:runtime",
        "//haku/runner:protocol",
    ],
)

py_test(
    name = "test_client",
    srcs = ["test_client.py"],
    deps = [
        ":client",
        "//:conftest",
        "//haku/console:conftest",
        "//haku/console/x:conftest",
        "//haku/runner:client",
        "//haku/runner:protocol",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",  # keep: pytest plugin (auto async mode), not a direct import
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "frame_export",
    srcs = ["frame_export.py"],
    deps = [
        ":redaction",
        "//haku/console:database_schema",
        "//haku/console/conversation:conversation_event",
        "//haku/console/conversation:reprojection",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "frame_export_main",
    srcs = ["frame_export_main.py"],
    deps = [
        ":frame_export",
        "@pypi//sqlalchemy",
        "@pypi//typer",
    ],
)

py_binary(
    name = "frame_export_bin",
    main_module = "haku.console.x.claude_code.frame_export_main",
    deps = [":frame_export_main"],
)

