"""Claude Code as one CLI harness: everything that knows its wire format."""

load("//devinfra/python:defs.bzl", "py_library", "py_test")

# Only the runtime folds a harness's wire, so a channel that came to know Claude's frames fails to
# build rather than being caught in review.
package(default_visibility = ["//haku/console/x:__pkg__"])

py_library(
    name = "frames",
    srcs = ["frames.py"],
    # A channel *test* driving a fake backend is the one thing on the far side of that rule that
    # has to know the wire: it asserts against the frames the stub produced.
    visibility = [
        "//haku/console/x:__pkg__",
        "//haku/console/x/channels/matrix/testing:__pkg__",
        "//haku/console/x/claude_code/testing:__pkg__",
    ],
)

py_library(
    name = "projection",
    srcs = ["projection.py"],
    visibility = [
        "//haku/console/x:__pkg__",
        "//haku/console/x/claude_code/testing:__pkg__",
    ],
    deps = [
        ":frames",
        "//haku/console:chat_models",
        "//haku/console/x:conversation_events",
    ],
)

py_library(
    name = "redaction",
    srcs = ["redaction.py"],
)

py_test(
    name = "test_redaction",
    srcs = ["test_redaction.py"],
    deps = [
        ":redaction",
        "//:conftest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_frames",
    srcs = ["test_frames.py"],
    deps = [
        ":frames",
        "//:conftest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_diverse_session",
    srcs = ["test_diverse_session.py"],
    data = ["testdata/diverse_session.jsonl"],
    deps = [
        ":projection",
        "//:conftest",
        "//haku/console:chat_models",
        "//haku/console/tools:conversations",
        "//haku/console/x:conversation_events",
        "//util/bazel:runfiles",
        "@pypi//more_itertools",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_agents_and_background",
    srcs = ["test_agents_and_background.py"],
    data = ["testdata/agents_and_background.jsonl"],
    deps = [
        ":projection",
        "//:conftest",
        "//haku/console:chat_models",
        "//haku/console/x:conversation_events",
        "//util/bazel:runfiles",
        "@pypi//more_itertools",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_projection",
    srcs = ["test_projection.py"],
    deps = [
        ":projection",
        "//:conftest",
        "//haku/console:chat_models",
        "//haku/console/x:conversation_events",
        "//haku/console/x/claude_code/testing:wire",
        "@pypi//pytest_bazel",
    ],
)
