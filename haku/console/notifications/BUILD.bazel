load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//haku/console:__subpackages__"])

py_library(
    name = "console_events",
    srcs = ["console_events.py"],
    deps = [
        "//haku/console/identity:operator_auth",
        "//haku/console/identity:operator_identity_store",
        "@pypi//asyncpg",
        "@pypi//fastapi",
        "@pypi//pydantic",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "push",
    srcs = ["push.py"],
    deps = [
        "//haku/console:config",
        "//haku/console:database_schema",
        "@ducktape_haku//haku/console:tool_calls",
        "@pypi//cryptography",
        "@pypi//httpx",
        "@pypi//py_vapid",
        "@pypi//pydantic",
        "@pypi//pywebpush",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "push_routes",
    srcs = ["push_routes.py"],
    deps = [
        ":push",
        "//haku/console/identity:operator_auth",
        "@pypi//fastapi",
        "@pypi//pydantic",
    ],
)

py_test(
    name = "test_console_events",
    size = "medium",
    srcs = ["test_console_events.py"],
    requires_docker = True,
    deps = [
        ":console_events",
        "//:conftest",
        "//haku/console:conftest",
        "//haku/console/identity:operator_identity_store",
        "@pypi//fastapi",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_push",
    size = "medium",
    srcs = ["test_push.py"],
    requires_docker = True,
    deps = [
        ":push",
        "//:conftest",
        "//haku/console:conftest",
        "@ducktape_haku//haku/console:tool_calls",
        "@pypi//cryptography",
        "@pypi//http_ece",
        "@pypi//httpx",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_push_routes",
    size = "medium",
    srcs = ["test_push_routes.py"],
    requires_docker = True,
    deps = [
        "//:conftest",
        "//haku/console:conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
