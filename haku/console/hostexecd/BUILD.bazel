load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//haku/console:__subpackages__"])

py_library(
    name = "models",
    srcs = ["models.py"],
)

py_library(
    name = "service",
    srcs = ["service.py"],
    deps = [
        ":models",
        "//haku/console:config",
        "//haku/console:database_schema",
        "@pypi//fastapi",
        "@pypi//pydantic",
        "@pypi//sqlalchemy",
    ],
)

py_test(
    name = "test_service",
    size = "medium",
    srcs = ["test_service.py"],
    requires_docker = True,
    deps = [
        ":models",
        ":service",
        "//:conftest",
        "//haku/console:config",
        "//haku/console:conftest",
        "@pypi//fastapi",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",
        "@pypi//pytest_bazel",
    ],
)
