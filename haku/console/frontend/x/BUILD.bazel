    name = "markdown",
    srcs = ["markdown.tsx"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [
        "//:node_modules/@types/dompurify",
        "//:node_modules/@types/react",
        "//:node_modules/dompurify",
        "//:node_modules/marked",
        "//:node_modules/react",
