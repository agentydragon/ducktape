load("//devinfra/js:ts_library.bzl", "ts_library")

package(default_visibility = ["//visibility:public"])

# The package tree's shared compiler options; a subpackage extends the parent's ts_config
# rather than declaring its own (STYLE.md § TypeScript).
TSCONFIG = "//haku/console/frontend:tsconfig"

ts_library(
    name = "chat_scroll",
    srcs = ["chat_scroll.ts"],
    tsconfig = TSCONFIG,
)

ts_library(
    name = "markdown",
    srcs = ["markdown.tsx"],
    tsconfig = TSCONFIG,
    deps = [
        "//:node_modules/@types/dompurify",
        "//:node_modules/@types/react",
        "//:node_modules/dompurify",
        "//:node_modules/marked",
        "//:node_modules/react",
    ],
)

ts_library(
    name = "claude_tool_use",
    srcs = ["claude_tool_use.tsx"],
    tsconfig = TSCONFIG,
    deps = [
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//haku/console/frontend:client",
        "//haku/console/frontend:code_block",
    ],
)

ts_library(
    name = "claude_chat_page",
    srcs = ["claude_chat_page.tsx"],
    tsconfig = TSCONFIG,
    deps = [
        ":chat_scroll",
        ":claude_tool_use",
        ":markdown",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//haku/console/frontend:client",
    ],
)

ts_library(
    name = "bootstrap_narration",
    srcs = ["bootstrap_narration.ts"],
    tsconfig = TSCONFIG,
    deps = ["//haku/console/frontend:client"],
)

ts_library(
    name = "conversation_timeline",
    srcs = ["conversation_timeline.ts"],
    tsconfig = TSCONFIG,
    deps = ["//haku/console/frontend:client"],
)

ts_library(
    name = "conversations_page",
    srcs = ["conversations_page.tsx"],
    tsconfig = TSCONFIG,
    deps = [
        ":bootstrap_narration",
        ":chat_scroll",
        ":claude_tool_use",
        ":conversation_timeline",
        ":markdown",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//haku/console/frontend:client",
        "//haku/console/frontend:routing",
    ],
)

ts_library(
    name = "chat_scroll_test",
    srcs = ["chat_scroll.test.ts"],
    tsconfig = TSCONFIG,
    deps = [
        ":chat_scroll",
        "//:node_modules/vitest",
    ],
)

ts_library(
    name = "bootstrap_narration_test",
    srcs = ["bootstrap_narration.test.ts"],
    tsconfig = TSCONFIG,
    deps = [
        ":bootstrap_narration",
        "//:node_modules/vitest",
        "//haku/console/frontend:client",
    ],
)

ts_library(
    name = "conversation_timeline_test",
    srcs = ["conversation_timeline.test.ts"],
    tsconfig = TSCONFIG,
    deps = [
        ":conversation_timeline",
        "//:node_modules/vitest",
        "//haku/console/frontend:client",
    ],
)

ts_library(
    name = "markdown_test",
    srcs = ["markdown.test.ts"],
    tsconfig = TSCONFIG,
    deps = [
        ":markdown",
        "//:node_modules/vitest",
    ],
)

# Tailwind scans these for utility classes; the parent package concatenates them with its own.
filegroup(
    name = "tailwind_content_srcs",
    srcs = [
        "claude_chat_page.tsx",
        "conversations_page.tsx",
    ],
)
