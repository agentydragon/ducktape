load("@aspect_rules_js//js:defs.bzl", "js_binary")
load("//devinfra/js:ts_library.bzl", "ts_library")
load("//devinfra/python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "typed_lint_srcs",
    srcs = glob(
        [
            "*.ts",
            "*.tsx",
            "**/*.ts",
            "**/*.tsx",
        ],
        allow_empty = True,
    ),
    visibility = ["//haku/console/frontend:__pkg__"],
)

TSCONFIG = "//haku/console/frontend:tsconfig"

js_binary(
    name = "emit_fixtures",
    entry_point = "emit_fixtures.mjs",
)

ts_library(
    name = "card",
    srcs = ["card.tsx"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//haku/console/frontend:tool_call_card",
        "//haku/console/frontend:tool_call_record",
        "//haku/console/frontend:tool_call_state",
        "//haku/console/frontend/tool_rendering:vocabulary",
    ],
)

ts_library(
    name = "mount",
    srcs = ["mount.tsx"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [
        ":card",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react-dom",
        "//:node_modules/react-dom",
        "//haku/console/frontend:theme",
        "//haku/console/frontend/tool_rendering:vocabulary",
    ],
)

py_library(
    name = "preview_visual",
    testonly = True,
    srcs = ["preview_visual.py"],
    deps = [
        "//testing/frontend_visual:capture",
        "//testing/frontend_visual:fixtures",
        "//testing/frontend_visual:viewports",
        "@pypi//playwright",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@rules_python//python/runfiles",
    ],
)
