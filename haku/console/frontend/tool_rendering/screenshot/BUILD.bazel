load("@aspect_rules_js//js:defs.bzl", "js_library")

package(default_visibility = ["//visibility:public"])

# Shared preview-screenshot harness. `mcp_mock.ts` owns only the JSON-RPC transport simulation;
# each server package owns its fixtures and tiny installer beside its widgets. `render` wraps the
# shared Puppeteer driver each server's `js_test` runs as its entry point.
js_library(
    name = "render",
    srcs = ["render.mjs"],
)

js_library(
    name = "mcp_mock",
    srcs = ["mcp_mock.ts"],
)

js_library(
    name = "card",
    srcs = ["card.tsx"],
    deps = [
        "//:node_modules/react",
        "//haku/console/frontend:approval_state",
        "//haku/console/frontend:client",
        "//haku/console/frontend:tool_call_card",
        "//haku/console/frontend/tool_rendering:variant",
    ],
)

js_library(
    name = "mount",
    srcs = ["mount.tsx"],
    deps = [
        ":card",
        "//:node_modules/@mantine/core",
        "//:node_modules/react-dom",
        "//haku/console/frontend:theme",
        "//haku/console/frontend/tool_rendering:variant",
    ],
)
