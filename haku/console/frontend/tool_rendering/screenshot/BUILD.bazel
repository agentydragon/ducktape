load("@aspect_rules_js//js:defs.bzl", "js_library")
load("//devinfra/js:ts_library.bzl", "ts_library")

package(default_visibility = ["//visibility:public"])

TSCONFIG = "//haku/console/frontend:tsconfig"

# Shared preview-screenshot harness. `mcp_mock.ts` owns only the JSON-RPC transport simulation;
# each server package owns its fixtures and tiny installer beside its widgets. `render` wraps the
# shared Puppeteer driver each server's `js_test` runs as its entry point.
js_library(
    name = "render",
    srcs = ["render.mjs"],
)

ts_library(
    name = "visual_network_ledger",
    srcs = ["visual_network_ledger.ts"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
)

ts_library(
    name = "mcp_mock",
    srcs = ["mcp_mock.ts"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [":visual_network_ledger"],
)

ts_library(
    name = "card",
    srcs = ["card.tsx"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//haku/console/frontend:approval_state",
        "//haku/console/frontend:client",
        "//haku/console/frontend:tool_call_card",
        "//haku/console/frontend/tool_rendering:variant",
    ],
)

ts_library(
    name = "mount",
    srcs = ["mount.tsx"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [
        ":card",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react-dom",
        "//:node_modules/react-dom",
        "//haku/console/frontend:theme",
        "//haku/console/frontend/tool_rendering:variant",
    ],
)
