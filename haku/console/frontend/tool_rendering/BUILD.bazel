load("@aspect_rules_js//js:defs.bzl", "js_library")

package(default_visibility = ["//visibility:public"])

# Shared leaves of the server-first tool-rendering tree plus the dispatch registry. Each
# `<server>/` subpackage owns one server's widgets — `requests.tsx` exports the server id + a
# { toolName -> {schema, render} } map for the call's arguments, `responses.tsx` the same for
# its result (request-only servers have no responses module). `tool_rendering` (index.tsx)
# dispatches to them via serverId registries, safeParsing once and handing each widget
# already-typed data.

# Compact/detailed rendering shared by every widget (the PreviewVariant type + helpers).
# Leaf: no widget deps, so index.tsx and each widget import it without a cycle.
js_library(
    name = "variant",
    srcs = ["vocabulary.tsx"],
    deps = [
        "//:node_modules/@mantine/core",
        "//:node_modules/react",
    ],
)

# A request-side registry entry (the tool's zod arguments schema + a renderer over its parsed
# value) plus the definePreview/renderPreview helpers. Leaf like :variant, so index.tsx and
# every widget import it without a cycle.
js_library(
    name = "entry",
    srcs = ["entry.tsx"],
    deps = [
        ":variant",
        "//:node_modules/react",
        "//:node_modules/zod",
    ],
)

# The result-side counterpart of :entry (the tool's zod result schema + renderer) plus the
# defineResultPreview/renderResultPreview helpers and the CallToolResult unwrap. Leaf too.
js_library(
    name = "result_entry",
    srcs = ["result_entry.tsx"],
    deps = [
        ":variant",
        "//:node_modules/react",
        "//:node_modules/zod",
    ],
)

js_library(
    name = "tool_rendering",
    srcs = ["index.tsx"],
    deps = [
        ":entry",
        ":result_entry",
        ":variant",
        "//:node_modules/react",
        "//:node_modules/zod",
        "//haku/console/frontend/tool_rendering/gmail:requests",
        "//haku/console/frontend/tool_rendering/gmail:responses",
        "//haku/console/frontend/tool_rendering/google_calendar:requests",
        "//haku/console/frontend/tool_rendering/google_calendar:responses",
        "//haku/console/frontend/tool_rendering/grocy:requests",
        "//haku/console/frontend/tool_rendering/grocy:responses",
        "//haku/console/frontend/tool_rendering/haku_routine:requests",
        "//haku/console/frontend/tool_rendering/kubectl:requests",
        "//haku/console/frontend/tool_rendering/tana:requests",
    ],
)

# Sources Tailwind must scan for class names. Aggregates the server subpackages' filegroups —
# a glob cannot cross package boundaries — so the frontend's tailwind_content_srcs keeps
# referencing this one label.
filegroup(
    name = "tailwind_srcs",
    srcs = glob(["*.tsx"]) + [
        "//haku/console/frontend/tool_rendering/gmail:tailwind_srcs",
        "//haku/console/frontend/tool_rendering/google_calendar:tailwind_srcs",
        "//haku/console/frontend/tool_rendering/grocy:tailwind_srcs",
        "//haku/console/frontend/tool_rendering/haku_routine:tailwind_srcs",
        "//haku/console/frontend/tool_rendering/kubectl:tailwind_srcs",
        "//haku/console/frontend/tool_rendering/tana:tailwind_srcs",
    ],
)

# One vitest spec per module (each test parallels the module it tests), wrapped as its own
# js_library so the dep graph stays per-file; the frontend's aggregate tsc_test + bridge_test
# consume them (a js_test can't take a source file from another package directly, only via a
# library).
js_library(
    name = "index_test",
    srcs = ["index.test.ts"],
    deps = [":tool_rendering"],
)

js_library(
    name = "result_entry_test",
    srcs = ["result_entry.test.ts"],
    deps = [":result_entry"],
)

js_library(
    name = "variant_test",
    srcs = ["vocabulary.test.ts"],
    deps = [":variant"],
)
