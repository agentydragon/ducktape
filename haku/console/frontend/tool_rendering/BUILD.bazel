load("//devinfra/js:ts_library.bzl", "ts_library")
load("//devinfra/js:vitest.bzl", "check_vitest_specs")
load("//haku/console/frontend:vitest.bzl", "haku_vitest_test")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "typed_lint_srcs",
    srcs = glob(
        [
            "*.ts",
            "*.tsx",
            "**/*.ts",
            "**/*.tsx",
        ],
        allow_empty = True,
    ),
    visibility = ["//haku/console/frontend:__pkg__"],
)

TSCONFIG = "//haku/console/frontend:tsconfig"

ts_library(
    name = "vocabulary",
    srcs = ["vocabulary.tsx"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
)

ts_library(
    name = "actions",
    srcs = ["actions.ts"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
)

haku_vitest_test(
    name = "actions_test",
    srcs = ["actions.test.ts"],
    isolated_typecheck = True,
    deps = [
        ":actions",
        "//:node_modules/vitest",
    ],
)

ts_library(
    name = "tool_rendering",
    srcs = ["index.tsx"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [
        ":vocabulary",
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//haku/console/frontend/tool_rendering/haku_routine:requests",
    ],
)

# Sources Tailwind must scan for class names. Aggregates the server subpackages' filegroups —
# a glob cannot cross package boundaries — so the frontend's tailwind_content_srcs keeps
# referencing this one label.
filegroup(
    name = "tailwind_srcs",
    srcs = glob(["*.tsx"]) + [
        "//haku/console/frontend/tool_rendering/haku_routine:tailwind_srcs",
    ],
)

# One vitest spec per module (each test parallels the module it tests), wrapped as its own
# js_library so the dep graph stays per-file; the frontend's aggregate tsc_test + bridge_test
# consume them (a js_test can't take a source file from another package directly, only via a
# library).
haku_vitest_test(
    name = "index_test",
    srcs = ["index.test.ts"],
    isolated_typecheck = True,
    deps = [
        ":tool_rendering",
        "//:node_modules/vitest",
    ],
)

haku_vitest_test(
    name = "variant_test",
    srcs = ["vocabulary.test.ts"],
    isolated_typecheck = True,
    deps = [
        ":vocabulary",
        "//:node_modules/vitest",
    ],
)

check_vitest_specs()
