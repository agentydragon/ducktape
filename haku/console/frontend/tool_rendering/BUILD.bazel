load("@aspect_rules_js//js:defs.bzl", "js_library")

package(default_visibility = ["//visibility:public"])

# Per-server tool-call rendering widgets, grouped server-first: each `<server>/` directory owns
# one server's widgets — `requests.tsx` exports the server id + a { toolName -> {schema, render} }
# map for the call's arguments, `responses.tsx` the same for its result (request-only servers have
# no responses module). `tool_rendering` (index.tsx) dispatches to them via serverId registries,
# safeParsing once and handing each widget already-typed data.

# Compact/detailed rendering shared by every widget (the PreviewVariant type + helpers).
# Leaf: no widget deps, so index.tsx and each widget import it without a cycle.
js_library(
    name = "variant",
    srcs = ["variant.tsx"],
    deps = [
        "//:node_modules/@mantine/core",
        "//:node_modules/react",
    ],
)

# A request-side registry entry (the tool's zod arguments schema + a renderer over its parsed
# value) plus the definePreview/renderPreview helpers. Leaf like :variant, so index.tsx and
# every widget import it without a cycle.
js_library(
    name = "entry",
    srcs = ["entry.tsx"],
    deps = [
        ":variant",
        "//:node_modules/react",
        "//:node_modules/zod",
    ],
)

# The result-side counterpart of :entry (the tool's zod result schema + renderer) plus the
# defineResultPreview/renderResultPreview helpers and the CallToolResult unwrap. Leaf too.
js_library(
    name = "result_entry",
    srcs = ["result_entry.tsx"],
    deps = [
        ":variant",
        "//:node_modules/react",
        "//:node_modules/zod",
    ],
)

js_library(
    name = "gmail_requests",
    srcs = ["gmail/requests.tsx"],
    deps = [
        ":entry",
        ":variant",
        "//:node_modules/@mantine/core",
        "//:node_modules/react",
        "//:node_modules/zod",
        "//haku/console/frontend:field",
        "//haku/console/frontend:gmail_client",
        "//haku/console/frontend:icons",
