load("//devinfra/js:ts_library.bzl", "ts_library")

package(default_visibility = ["//visibility:public"])

TSCONFIG = "//haku/console/frontend:tsconfig"

# Shared leaves of the server-first tool-rendering tree plus the dispatch registry. Each
# `<server>/` subpackage owns one server's widgets — `requests.tsx` exports the server id + a
# { toolName -> {schema, render} } map for the call's arguments, `responses.tsx` the same for
# its result (request-only servers have no responses module). `tool_rendering` (index.tsx)
# dispatches to them via serverId registries, safeParsing once and handing each widget
# already-typed data.

# Compact/detailed rendering shared by every widget (the PreviewVariant type + helpers).
# Leaf: no widget deps, so index.tsx and each widget import it without a cycle.
ts_library(
    name = "variant",
    srcs = ["vocabulary.tsx"],
    tsconfig = TSCONFIG,
    deps = [
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/react",
    ],
)

# A request-side registry entry (the tool's zod arguments schema + a renderer over its parsed
# value) plus the definePreview/renderPreview helpers. Leaf like :variant, so index.tsx and
# every widget import it without a cycle.
# Leaf: no imports at all, so both the React widget registry and the React-free action registry
# can key off the same server ids.
ts_library(
    name = "server_ids",
    srcs = ["server_ids.ts"],
    tsconfig = TSCONFIG,
)

# Deliberately React-free — the service worker bundles it to describe push notifications. Depends
# only on the generated schema catalog and the server ids.
ts_library(
    name = "action_entry",
    srcs = ["action_entry.ts"],
    tsconfig = TSCONFIG,
    deps = ["//:node_modules/zod"],
)

# Composes the per-server action maps, mirroring how :tool_rendering composes the per-server
# widget registries. React-free the whole way down — //haku/console/frontend:sw_lib bundles it.
ts_library(
    name = "actions",
    srcs = ["actions.ts"],
    tsconfig = TSCONFIG,
    deps = [
        ":action_entry",
        ":server_ids",
        "//haku/console/frontend/tool_rendering/gmail:actions",
        "//haku/console/frontend/tool_rendering/google_calendar:actions",
        "//haku/console/frontend/tool_rendering/grocy:actions",
        "//haku/console/frontend/tool_rendering/haku_routine:actions",
        "//haku/console/frontend/tool_rendering/hostexec:actions",
        "//haku/console/frontend/tool_rendering/kubectl:actions",
        "//haku/console/frontend/tool_rendering/kubernetes:actions",
        "//haku/console/frontend/tool_rendering/tana:actions",
    ],
)

ts_library(
    name = "actions_test",
    testonly = True,
    srcs = ["actions.test.ts"],
    tsconfig = TSCONFIG,
    deps = [
        ":actions",
        ":server_ids",
        "//:node_modules/vitest",
    ],
)

ts_library(
    name = "entry",
    srcs = ["entry.tsx"],
    tsconfig = TSCONFIG,
    deps = [
        ":variant",
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//:node_modules/zod",
        "//haku/console/frontend:mcp_result",
    ],
)

# The result-side counterpart of :entry (the tool's zod result schema + renderer) plus the
# defineResultPreview/renderResultPreview helpers and the CallToolResult unwrap. Leaf too.
ts_library(
    name = "result_entry",
    srcs = ["result_entry.tsx"],
    tsconfig = TSCONFIG,
    deps = [
        ":variant",
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//:node_modules/zod",
        "//haku/console/frontend:mcp_result",
    ],
)

# A combined pending/finished registry entry (one widget over both the tool's args and, once
# present, its result) plus the defineCallPreview/renderCallPreview/describeCallAction helpers.
# Depends on :entry (the ToolAction type) and :result_entry (the CallToolResult unwrap shared
# with the result-only path), so a pending call, an error result, and a schema mismatch all
# resolve the same way a result-only widget's does.
ts_library(
    name = "call_entry",
    srcs = ["call_entry.tsx"],
    tsconfig = TSCONFIG,
    deps = [
        ":entry",
        ":result_entry",
        ":variant",
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//:node_modules/zod",
    ],
)

ts_library(
    name = "tool_rendering",
    srcs = ["index.tsx"],
    tsconfig = TSCONFIG,
    deps = [
        ":call_entry",
        ":entry",
        ":result_entry",
        ":server_ids",
        ":variant",
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//:node_modules/zod",
        "//haku/console/frontend/tool_rendering/gmail:calls",
        "//haku/console/frontend/tool_rendering/gmail:requests",
        "//haku/console/frontend/tool_rendering/gmail:responses",
        "//haku/console/frontend/tool_rendering/google_calendar:calls",
        "//haku/console/frontend/tool_rendering/google_calendar:requests",
        "//haku/console/frontend/tool_rendering/google_calendar:responses",
        "//haku/console/frontend/tool_rendering/grocy:requests",
        "//haku/console/frontend/tool_rendering/grocy:responses",
        "//haku/console/frontend/tool_rendering/haku_routine:requests",
        "//haku/console/frontend/tool_rendering/hostexec:requests",
        "//haku/console/frontend/tool_rendering/hostexec:responses",
        "//haku/console/frontend/tool_rendering/kubectl:requests",
        "//haku/console/frontend/tool_rendering/kubernetes:requests",
        "//haku/console/frontend/tool_rendering/kubernetes:responses",
        "//haku/console/frontend/tool_rendering/tana:requests",
    ],
)

# Sources Tailwind must scan for class names. Aggregates the server subpackages' filegroups —
# a glob cannot cross package boundaries — so the frontend's tailwind_content_srcs keeps
# referencing this one label.
filegroup(
    name = "tailwind_srcs",
    srcs = glob(["*.tsx"]) + [
        "//haku/console/frontend/tool_rendering/gmail:tailwind_srcs",
        "//haku/console/frontend/tool_rendering/google_calendar:tailwind_srcs",
        "//haku/console/frontend/tool_rendering/grocy:tailwind_srcs",
        "//haku/console/frontend/tool_rendering/haku_routine:tailwind_srcs",
        "//haku/console/frontend/tool_rendering/hostexec:tailwind_srcs",
        "//haku/console/frontend/tool_rendering/kubectl:tailwind_srcs",
        "//haku/console/frontend/tool_rendering/kubernetes:tailwind_srcs",
        "//haku/console/frontend/tool_rendering/tana:tailwind_srcs",
    ],
)

# One vitest spec per module (each test parallels the module it tests), wrapped as its own
# js_library so the dep graph stays per-file; the frontend's aggregate tsc_test + bridge_test
# consume them (a js_test can't take a source file from another package directly, only via a
# library).
ts_library(
    name = "index_test",
    srcs = ["index.test.ts"],
    tsconfig = TSCONFIG,
    deps = [
        ":tool_rendering",
        "//:node_modules/vitest",
    ],
)

ts_library(
    name = "result_entry_test",
    srcs = ["result_entry.test.ts"],
    tsconfig = TSCONFIG,
    deps = [
        ":result_entry",
        "//:node_modules/vitest",
    ],
)

ts_library(
    name = "call_entry_test",
    srcs = ["call_entry.test.ts"],
    tsconfig = TSCONFIG,
    deps = [
        ":call_entry",
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//:node_modules/vitest",
        "//:node_modules/zod",
    ],
)

ts_library(
    name = "variant_test",
    srcs = ["vocabulary.test.ts"],
    tsconfig = TSCONFIG,
    deps = [
        ":variant",
        "//:node_modules/vitest",
    ],
)
