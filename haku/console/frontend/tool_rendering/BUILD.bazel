# Sources Tailwind must scan for class names; the parent's tailwind_content_srcs
# concatenates this into the one file the stylesheet's @source lists.
filegroup(
    name = "tailwind_srcs",
    srcs = glob([
        "*.tsx",
        "*/*.tsx",
    ]),
)

# One vitest spec per module (each test parallels the module it tests), wrapped as its own
# js_library so the dep graph stays per-file; the parent's aggregate tsc_test + bridge_test
# consume them (a js_test can't take a source file from another package directly, only via a
# library).
js_library(
    name = "gmail_requests_test",
    srcs = ["gmail/requests.test.ts"],
    deps = [
        ":entry",
        ":gmail_requests",
    ],
)

js_library(
    name = "gmail_responses_test",
    srcs = ["gmail/responses.test.ts"],
    deps = [
        ":gmail_responses",
        ":result_entry",
    ],
)

