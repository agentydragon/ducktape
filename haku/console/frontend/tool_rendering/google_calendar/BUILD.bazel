load("//devinfra/js:ts_library.bzl", "ts_library")
load("//haku/console/frontend/tool_rendering/screenshot:screenshot_test.bzl", "preview_screenshots")

package(default_visibility = ["//visibility:public"])

TSCONFIG = "//haku/console/frontend:tsconfig"

# The `google_calendar` server's tool-call rendering widgets (see ../BUILD.bazel for the
# tree's shape).

ts_library(
    name = "actions",
    srcs = ["actions.ts"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [
        "//haku/console/frontend:mcp_tool_schema",
        "//haku/console/frontend/tool_rendering:action_entry",
        "//haku/console/frontend/tool_rendering:server_ids",
    ],
)

ts_library(
    name = "requests",
    srcs = ["requests.tsx"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//:node_modules/rrule",
        "//:node_modules/zod",
        "//haku/console/frontend:calendar_client",
        "//haku/console/frontend:field",
        "//haku/console/frontend:icons",
        "//haku/console/frontend:link",
        "//haku/console/frontend:mcp_tool_schema",
        "//haku/console/frontend/tool_rendering:entry",
        "//haku/console/frontend/tool_rendering:server_ids",
        "//haku/console/frontend/tool_rendering:variant",
    ],
)

ts_library(
    name = "responses",
    srcs = ["responses.tsx"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [
        ":requests",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//:node_modules/zod",
        "//haku/console/frontend:field",
        "//haku/console/frontend:icons",
        "//haku/console/frontend:link",
        "//haku/console/frontend:mcp_tool_result_schema",
        "//haku/console/frontend/tool_rendering:result_entry",
        "//haku/console/frontend/tool_rendering:server_ids",
        "//haku/console/frontend/tool_rendering:variant",
    ],
)

# `create_event`'s combined pending/finished widget (see ../BUILD.bazel's :call_entry).
ts_library(
    name = "calls",
    srcs = ["calls.tsx"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [
        ":requests",
        ":responses",
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//haku/console/frontend/tool_rendering:call_entry",
    ],
)

# Sources Tailwind must scan; aggregated by the parent's tailwind_srcs.
filegroup(
    name = "tailwind_srcs",
    srcs = glob(["*.tsx"]),
)

ts_library(
    name = "requests_test",
    srcs = ["requests.test.ts"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [
        ":requests",
        "//:node_modules/vitest",
        "//haku/console/frontend/tool_rendering:actions",
        "//haku/console/frontend/tool_rendering:entry",
        "//haku/console/frontend/tool_rendering:server_ids",
    ],
)

ts_library(
    name = "responses_test",
    srcs = ["responses.test.ts"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [
        ":responses",
        "//:node_modules/vitest",
        "//haku/console/frontend/tool_rendering:result_entry",
    ],
)

ts_library(
    name = "calls_test",
    srcs = ["calls.test.ts"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [
        ":calls",
        "//:node_modules/vitest",
        "//haku/console/frontend/tool_rendering:actions",
        "//haku/console/frontend/tool_rendering:call_entry",
        "//haku/console/frontend/tool_rendering:server_ids",
    ],
)

ts_library(
    name = "preview_harness",
    srcs = ["preview_harness.tsx"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [
        ":preview_mock",
        "//haku/console/frontend/tool_rendering",
        "//haku/console/frontend/tool_rendering/screenshot:mount",
    ],
)

ts_library(
    name = "fixtures",
    srcs = ["fixtures.ts"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = ["//haku/console/frontend:mcp_tool_result_schema"],
)

ts_library(
    name = "preview_mock",
    srcs = ["preview_mock.ts"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [
        ":fixtures",
        "//haku/console/frontend/tool_rendering/screenshot:mcp_mock",
    ],
)

preview_screenshots(
    name = "previews",
    entry = "preview_harness.js",
    deps = [
        ":preview_harness",
    ],
)
