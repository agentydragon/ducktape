load("@aspect_rules_js//js:defs.bzl", "js_library")
load("//haku/console/frontend/tool_rendering/screenshot:screenshot_test.bzl", "preview_screenshots")

package(default_visibility = ["//visibility:public"])

# The `gmail` server's tool-call rendering widgets (see ../BUILD.bazel for the tree's shape).

js_library(
    name = "requests",
    srcs = ["requests.tsx"],
    deps = [
        "//:node_modules/@mantine/core",
        "//:node_modules/react",
        "//:node_modules/zod",
        "//haku/console/frontend:code_block",
        "//haku/console/frontend:field",
        "//haku/console/frontend:gmail_client",
        "//haku/console/frontend:icons",
        "//haku/console/frontend:mcp_tool_schema",
        "//haku/console/frontend/tool_rendering:entry",
        "//haku/console/frontend/tool_rendering:variant",
    ],
)

js_library(
    name = "responses",
    srcs = ["responses.tsx"],
    deps = [
        ":requests",
        "//:node_modules/@mantine/core",
        "//:node_modules/react",
        "//:node_modules/zod",
        "//haku/console/frontend:mcp_tool_result_schema",
        "//haku/console/frontend/tool_rendering:result_entry",
    ],
)

# Sources Tailwind must scan; aggregated by the parent's tailwind_srcs.
filegroup(
    name = "tailwind_srcs",
    srcs = glob(["*.tsx"]),
)

# Preview-screenshot fixtures for this server (rendered by the `:previews` target below). Each
# (serverId, toolName, args) `satisfies RegisteredToolPreviewFixture`, so a stale id/arg is a
# type error against the registry's real Zod schemas.
# The esbuild entry the `:previews` target bundles into an IIFE — this server's fixtures plus the
# mount call (mount imports the fetch mock first).
js_library(
    name = "preview_harness",
    srcs = ["preview_harness.tsx"],
    deps = [
        "//haku/console/frontend/tool_rendering",
        "//haku/console/frontend/tool_rendering/screenshot:mount",
    ],
)

js_library(
    name = "requests_test",
    srcs = ["requests.test.ts"],
    deps = [
        ":requests",
        "//haku/console/frontend/tool_rendering:entry",
    ],
)

js_library(
    name = "responses_test",
    srcs = ["responses.test.ts"],
    deps = [
        ":responses",
        "//haku/console/frontend/tool_rendering:result_entry",
    ],
)

# One preview screenshot `js_test` for this server: bundles preview_harness.tsx (this server's
# fixtures + the shared mount) and runs the shared render driver; :preview_harness's transitive
# deps (shared harness, gmail widgets, //:node_modules) are what esbuild bundles.
preview_screenshots(
    name = "previews",
    entry = "preview_harness.tsx",
    deps = [
        ":preview_harness",
        "//:node_modules",
    ],
)
