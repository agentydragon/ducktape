load("//devinfra/js:ts_library.bzl", "ts_library")
load("//haku/console/frontend/tool_rendering/screenshot:screenshot_test.bzl", "preview_screenshots")

package(default_visibility = ["//visibility:public"])

TSCONFIG = "//haku/console/frontend:tsconfig"

# The `gmail` server's tool-call rendering widgets (see ../BUILD.bazel for the tree's shape).

ts_library(
    name = "actions",
    srcs = ["actions.ts"],
    tsconfig = TSCONFIG,
    deps = [
        "//haku/console/frontend:mcp_tool_schema",
        "//haku/console/frontend/tool_rendering:action_entry",
        "//haku/console/frontend/tool_rendering:server_ids",
    ],
)

ts_library(
    name = "requests",
    srcs = ["requests.tsx"],
    tsconfig = TSCONFIG,
    deps = [
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//:node_modules/zod",
        "//haku/console/frontend:code_block",
        "//haku/console/frontend:field",
        "//haku/console/frontend:gmail_client",
        "//haku/console/frontend:icons",
        "//haku/console/frontend:link",
        "//haku/console/frontend:mcp_tool_schema",
        "//haku/console/frontend/tool_rendering:entry",
        "//haku/console/frontend/tool_rendering:server_ids",
        "//haku/console/frontend/tool_rendering:variant",
    ],
)

ts_library(
    name = "responses",
    srcs = ["responses.tsx"],
    tsconfig = TSCONFIG,
    deps = [
        ":requests",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//:node_modules/zod",
        "//haku/console/frontend:code_block",
        "//haku/console/frontend:field",
        "//haku/console/frontend:gmail_client",
        "//haku/console/frontend:icons",
        "//haku/console/frontend:link",
        "//haku/console/frontend:mcp_tool_result_schema",
        "//haku/console/frontend/tool_rendering:result_entry",
        "//haku/console/frontend/tool_rendering:server_ids",
        "//haku/console/frontend/tool_rendering:variant",
    ],
)

# `drafts_create`'s combined pending/finished widget (see ../BUILD.bazel's :call_entry).
ts_library(
    name = "calls",
    srcs = ["calls.tsx"],
    tsconfig = TSCONFIG,
    deps = [
        ":requests",
        ":responses",
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//haku/console/frontend/tool_rendering:call_entry",
    ],
)

# Sources Tailwind must scan; aggregated by the parent's tailwind_srcs.
filegroup(
    name = "tailwind_srcs",
    srcs = glob(["*.tsx"]),
)

# Preview-screenshot fixtures for this server (rendered by the `:previews` target below). Each
# (serverId, toolName, args) `satisfies RegisteredToolPreviewFixture`, so a stale id/arg is a
# type error against the registry's real Zod schemas.
# The esbuild entry the `:previews` target bundles into an IIFE — this server's fixtures plus the
# mount call (mount imports the fetch mock first).
ts_library(
    name = "preview_harness",
    srcs = ["preview_harness.tsx"],
    tsconfig = TSCONFIG,
    deps = [
        ":preview_mock",
        "//haku/console/frontend/tool_rendering",
        "//haku/console/frontend/tool_rendering/screenshot:mount",
    ],
)

ts_library(
    name = "fixtures",
    srcs = ["fixtures.ts"],
    tsconfig = TSCONFIG,
    deps = ["//haku/console/frontend:mcp_tool_result_schema"],
)

ts_library(
    name = "preview_mock",
    srcs = ["preview_mock.ts"],
    tsconfig = TSCONFIG,
    deps = [
        ":fixtures",
        "//haku/console/frontend/tool_rendering/screenshot:mcp_mock",
    ],
)

ts_library(
    name = "requests_test",
    srcs = ["requests.test.ts"],
    tsconfig = TSCONFIG,
    deps = [
        ":requests",
        "//:node_modules/vitest",
        "//haku/console/frontend/tool_rendering:actions",
        "//haku/console/frontend/tool_rendering:entry",
        "//haku/console/frontend/tool_rendering:server_ids",
    ],
)

ts_library(
    name = "responses_test",
    srcs = ["responses.test.ts"],
    tsconfig = TSCONFIG,
    deps = [
        ":responses",
        "//:node_modules/vitest",
        "//haku/console/frontend/tool_rendering:result_entry",
    ],
)

ts_library(
    name = "calls_test",
    srcs = ["calls.test.ts"],
    tsconfig = TSCONFIG,
    deps = [
        ":calls",
        "//:node_modules/vitest",
        "//haku/console/frontend/tool_rendering:actions",
        "//haku/console/frontend/tool_rendering:call_entry",
        "//haku/console/frontend/tool_rendering:server_ids",
    ],
)

# One preview screenshot `js_test` for this server: bundles preview_harness.tsx (this server's
# fixtures + the shared mount) and runs the shared render driver; :preview_harness's transitive
# deps (shared harness, gmail widgets, //:node_modules) are what esbuild bundles.
preview_screenshots(
    name = "previews",
    entry = "preview_harness.js",
    deps = [
        ":preview_harness",
        "//:node_modules",
    ],
)
