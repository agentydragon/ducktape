load("//devinfra/js:ts_library.bzl", "ts_library")
load("//devinfra/js:vitest.bzl", "check_vitest_specs")
load("//haku/console/frontend:vitest.bzl", "haku_vitest_test")
load("//haku/console/frontend/tool_rendering/screenshot:screenshot_test.bzl", "preview_screenshots")

package(default_visibility = ["//visibility:public"])

TSCONFIG = "//haku/console/frontend:tsconfig"

# The `gmail` server's tool-call rendering widgets (see ../BUILD.bazel for the tree's shape).

ts_library(
    name = "actions",
    srcs = ["actions.ts"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [
        "//haku/console/frontend:mcp_tool_schema",
        "//haku/console/frontend/tool_rendering:action_entry",
        "//haku/console/frontend/tool_rendering:server_ids",
    ],
)

ts_library(
    name = "requests",
    srcs = ["requests.tsx"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//:node_modules/zod",
        "//haku/console/frontend:code_block",
        "//haku/console/frontend:field",
        "//haku/console/frontend:gmail_client",
        "//haku/console/frontend:icons",
        "//haku/console/frontend:link",
        "//haku/console/frontend:mcp_tool_schema",
        "//haku/console/frontend/tool_rendering:entry",
        "//haku/console/frontend/tool_rendering:server_ids",
        "//haku/console/frontend/tool_rendering:variant",
    ],
)

ts_library(
    name = "responses",
    srcs = ["responses.tsx"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [
        ":requests",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//:node_modules/zod",
        "//haku/console/frontend:code_block",
        "//haku/console/frontend:field",
        "//haku/console/frontend:gmail_client",
        "//haku/console/frontend:icons",
        "//haku/console/frontend:link",
        "//haku/console/frontend:mcp_tool_result_schema",
        "//haku/console/frontend/tool_rendering:result_entry",
        "//haku/console/frontend/tool_rendering:server_ids",
        "//haku/console/frontend/tool_rendering:variant",
    ],
)

# `drafts_create`'s combined pending/finished widget (see ../BUILD.bazel's :call_entry).
ts_library(
    name = "calls",
    srcs = ["calls.tsx"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [
        ":requests",
        ":responses",
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//haku/console/frontend/tool_rendering:call_entry",
    ],
)

# Sources Tailwind must scan; aggregated by the parent's tailwind_srcs.
filegroup(
    name = "tailwind_srcs",
    srcs = glob(["*.tsx"]),
)

# Preview-screenshot fixtures for this server. Each (serverId, toolName, args) is a
# `RegisteredToolPreviewFixture`, so a stale id/arg is a type error against the registry's real Zod
# schemas. The `:previews` target mounts them and derives its scenarios from them.
ts_library(
    name = "preview_fixtures",
    srcs = ["preview_fixtures.ts"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = ["//haku/console/frontend/tool_rendering"],
)

# The esbuild entry the `:previews` target bundles into an IIFE: the fetch mock, then the mount of
# the fixtures.
ts_library(
    name = "preview_harness",
    srcs = ["preview_harness.tsx"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [
        ":preview_fixtures",
        ":preview_mock",
        "//haku/console/frontend/tool_rendering/screenshot:mount",
    ],
)

ts_library(
    name = "fixtures",
    srcs = ["fixtures.ts"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = ["//haku/console/frontend:mcp_tool_result_schema"],
)

ts_library(
    name = "preview_mock",
    srcs = ["preview_mock.ts"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [
        ":fixtures",
        "//haku/console/frontend/tool_rendering/screenshot:mcp_mock",
    ],
)

haku_vitest_test(
    name = "requests_test",
    srcs = ["requests.test.ts"],
    isolated_typecheck = True,
    deps = [
        ":requests",
        "//:node_modules/vitest",
        "//haku/console/frontend/tool_rendering:actions",
        "//haku/console/frontend/tool_rendering:entry",
        "//haku/console/frontend/tool_rendering:server_ids",
    ],
)

haku_vitest_test(
    name = "responses_test",
    srcs = ["responses.test.ts"],
    isolated_typecheck = True,
    deps = [
        ":responses",
        "//:node_modules/vitest",
        "//haku/console/frontend/tool_rendering:result_entry",
    ],
)

# One preview screenshot sweep for this server: bundles preview_harness.tsx (the fixtures + the
# shared mount) and renders one scenario per fixture x variant x color scheme, the table derived from
# preview_fixtures.js; :preview_harness's transitive deps (shared harness and gmail widgets) are what
# esbuild bundles.
preview_screenshots(
    name = "previews",
    entry = "preview_harness.js",
    fixtures = "preview_fixtures.js",
    deps = [":preview_harness"],
)

check_vitest_specs()
