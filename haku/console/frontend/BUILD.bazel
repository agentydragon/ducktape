load("@aspect_rules_esbuild//esbuild:defs.bzl", "esbuild")
load("@aspect_rules_js//js:defs.bzl", "js_library", "js_run_binary")
load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@npm_ducktape//:@tailwindcss/cli/package_json.bzl", tailwindcss_bin = "bin")
load("@npm_ducktape//:typescript/package_json.bzl", tsc_bin = "bin")
load("@npm_ducktape//:vitest/package_json.bzl", vitest_bin = "bin")
load("//devinfra/js:openapi.bzl", "js_openapi_schema")

package(default_visibility = ["//visibility:public"])

# TypeScript types generated from the backend's OpenAPI schema (reuses the Item
# Pydantic models as the wire contract). Not checked in; regenerated each build.
js_openapi_schema(
    name = "schema",
    generator = "//haku/console:export_schema_bin",
)

js_library(
    name = "constants",
    srcs = ["constants.ts"],
)

js_library(
    name = "markdown",
    srcs = ["markdown.ts"],
    deps = [
        "//:node_modules/dompurify",
        "//:node_modules/marked",
    ],
)

js_library(
    name = "client",
    srcs = ["client.ts"],
    deps = [
        ":schema",
        "//:node_modules/openapi-fetch",
    ],
)

js_library(
    name = "toast",
    srcs = ["toast.ts"],
    deps = [
        "//:node_modules/@mantine/notifications",
        "//:node_modules/react",
    ],
)

js_library(
    name = "feedback",
    srcs = ["feedback.tsx"],
    deps = [
        ":client",
        ":toast",
        "//:node_modules/@mantine/core",
        "//:node_modules/react",
    ],
)

js_library(
    name = "task",
    srcs = ["task.tsx"],
    deps = [
        ":client",
        ":constants",
        ":feedback",
        ":markdown",
        "//:node_modules/@mantine/core",
        "//:node_modules/react",
    ],
)

js_library(
    name = "launch",
    srcs = ["launch.tsx"],
    deps = [
        ":client",
        ":toast",
        "//:node_modules/@mantine/core",
        "//:node_modules/react",
    ],
)

js_library(
    name = "bridge",
    srcs = ["bridge.ts"],
)

js_library(
    name = "confirm_dialog",
    srcs = ["confirm_dialog.tsx"],
    deps = [
        "//:node_modules/@mantine/core",
        "//:node_modules/react",
    ],
)

js_library(
    name = "haku_ui",
    srcs = ["haku_ui.tsx"],
    deps = [
        ":bridge",
        ":confirm_dialog",
        ":toast",
        "//:node_modules/react",
    ],
)

js_library(
    name = "app",
    srcs = ["app.tsx"],
    deps = [
        ":client",
        ":constants",
        ":feedback",
        ":haku_ui",
        ":launch",
        ":task",
        ":toast",
        "//:node_modules/@mantine/core",
        "//:node_modules/react",
    ],
)

js_library(
    name = "main_lib",
    srcs = ["main.tsx"],
    deps = [
        ":app",
        "//:node_modules/@mantine/core",
        "//:node_modules/@mantine/notifications",
        "//:node_modules/react",
        "//:node_modules/react-dom",
    ],
)

esbuild(
    name = "main_bundle",
    config = {"jsx": "automatic"},
    entry_point = "main.tsx",
    format = "esm",
    output = "dist/main.js",
    platform = "browser",
    sourcemap = "linked",
    target = ["es2022"],
    deps = [":main_lib"],
)

copy_file(
    name = "bundle_index_html",
    src = "index.html",
    out = "dist/index.html",
)

# Tailwind v4 scans the `@source`-declared file for class names; concatenate every
# source whose utility classes the stylesheet must keep into the one file it lists.
filegroup(
    name = "tailwind_content_srcs",
    srcs = [
        "app.tsx",
        "client.ts",
        "confirm_dialog.tsx",
        "constants.ts",
        "feedback.tsx",
        "haku_ui.tsx",
        "index.html",
        "launch.tsx",
        "main.tsx",
        "markdown.ts",
        "task.tsx",
        "toast.ts",
    ],
)

genrule(
    name = "tailwind_content_index",
    srcs = [":tailwind_content_srcs"],
    outs = ["tailwind_content.txt"],
    cmd = "cat $(SRCS) > $@",
)

tailwindcss_bin.tailwindcss_binary(
    name = "tailwind_cli",
    data = [
        "//:node_modules/@mantine/core",
        # `@import "@mantine/notifications/styles.css"` in styles.src.css.
        "//:node_modules/@mantine/notifications",
        "//:node_modules/@tailwindcss/cli",
        # `@import "tailwindcss"` in styles.src.css resolves to this package.
        "//:node_modules/tailwindcss",
    ],
)

js_run_binary(
    name = "styles_css",
    srcs = [
        "styles.src.css",
        ":tailwind_content_index",
    ],
    outs = ["dist/styles.css"],
    args = [
        "--input",
        "styles.src.css",
        "--output",
        "dist/styles.css",
        "--minify",
    ],
    chdir = package_name(),
    tool = ":tailwind_cli",
)

# Everything the backend serves as the SPA docroot (index.html + main.js + styles.css).
filegroup(
    name = "bundle",
    srcs = [
        ":bundle_index_html",
        ":main_bundle",
        ":styles_css",
    ],
)

# Full TypeScript type-check (the correctness gate esbuild bundling skips).
tsc_bin.tsc_test(
    name = "tsc_test",
    args = [
        "--noEmit",
        "-p",
        "tsconfig.json",
    ],
    chdir = package_name(),
    data = [
        "bridge.test.ts",
        "markdown.test.ts",
        "tsconfig.json",
        ":main_lib",
        ":schema",
        "//:node_modules",
    ],
    tags = ["lint"],
)

vitest_bin.vitest_test(
    name = "markdown_test",
    args = ["run"],
    chdir = package_name(),
    data = [
        "markdown.test.ts",
        "vitest.config.ts",
        ":markdown",
        "//:node_modules",
    ],
)

vitest_bin.vitest_test(
    name = "bridge_test",
    args = ["run"],
    chdir = package_name(),
    data = [
        "bridge.test.ts",
        "vitest.config.ts",
        ":bridge",
        "//:node_modules",
    ],
)
