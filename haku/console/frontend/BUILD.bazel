load("@aspect_rules_js//js:defs.bzl", "js_library", "js_run_binary")
load("@npm_ducktape//:@tailwindcss/cli/package_json.bzl", tailwindcss_bin = "bin")
load("@npm_ducktape//:typescript/package_json.bzl", tsc_bin = "bin")
load("@npm_ducktape//:vitest/package_json.bzl", vitest_bin = "bin")
load("//devinfra/js:openapi.bzl", "js_openapi_schema")
load("//devinfra/js:spa_bundle.bzl", "spa_bundle")

package(default_visibility = ["//visibility:public"])

# TypeScript types generated from the backend's OpenAPI schema (reuses the API
# Pydantic models as the wire contract). Not checked in; regenerated each build.
js_openapi_schema(
    name = "schema",
    generator = "//haku/console:export_schema_bin",
)

js_library(
    name = "client",
    srcs = ["client.ts"],
    deps = [
        ":schema",
        "//:node_modules/openapi-fetch",
    ],
)

js_library(
    name = "theme",
    srcs = ["theme.ts"],
    deps = ["//:node_modules/@mantine/core"],
)

js_library(
    name = "toast",
    srcs = ["toast.ts"],
    deps = [
        ":theme",
        "//:node_modules/@mantine/notifications",
        "//:node_modules/react",
    ],
)

js_library(
    name = "bridge",
    srcs = ["bridge.ts"],
)

js_library(
    name = "confirm_dialog",
    srcs = ["confirm_dialog.tsx"],
    deps = [
        ":theme",
        "//:node_modules/@mantine/core",
        "//:node_modules/react",
    ],
)

js_library(
    name = "haku_ui_embed",
    srcs = ["haku_ui_embed.tsx"],
    deps = [
        ":bridge",
        ":client",
        ":confirm_dialog",
        ":toast",
        "//:node_modules/@mantine/core",
        "//:node_modules/react",
    ],
)

js_library(
    name = "app",
    srcs = ["app.tsx"],
    deps = [
        ":client",
        ":haku_ui_embed",
        "//:node_modules/@mantine/core",
        "//:node_modules/react",
    ],
)

js_library(
    name = "main_lib",
    srcs = ["main.tsx"],
    deps = [
        ":app",
        ":theme",
        "//:node_modules/@mantine/core",
        "//:node_modules/@mantine/notifications",
        "//:node_modules/react",
        "//:node_modules/react-dom",
    ],
)

# Tailwind v4 scans the `@source`-declared file for class names; concatenate every
# source whose utility classes the stylesheet must keep into the one file it lists.
filegroup(
    name = "tailwind_content_srcs",
    srcs = [
        "app.tsx",
        "client.ts",
        "confirm_dialog.tsx",
        "haku_ui_embed.tsx",
        "index.html",
        "main.tsx",
        "theme.ts",
        "toast.ts",
    ],
)

genrule(
    name = "tailwind_content_index",
    srcs = [":tailwind_content_srcs"],
    outs = ["tailwind_content.txt"],
    cmd = "cat $(SRCS) > $@",
)

tailwindcss_bin.tailwindcss_binary(
    name = "tailwind_cli",
    data = [
        "//:node_modules/@mantine/core",
        # `@import "@mantine/notifications/styles.css"` in styles.src.css.
        "//:node_modules/@mantine/notifications",
        "//:node_modules/@tailwindcss/cli",
        # `@import "tailwindcss"` in styles.src.css resolves to this package.
        "//:node_modules/tailwindcss",
    ],
)

js_run_binary(
    name = "styles_css",
    srcs = [
        "styles.src.css",
        ":tailwind_content_index",
    ],
    outs = ["generated/styles.css"],
    args = [
        "--input",
        "styles.src.css",
        "--output",
        "generated/styles.css",
        "--minify",
    ],
    chdir = package_name(),
    tool = ":tailwind_cli",
)

# Everything the static frontend image serves as the SPA docroot.
spa_bundle(
    name = "bundle",
    entry_point = "main.tsx",
    fingerprint = True,
    fingerprinted_assets = {
        ":styles_css": "__STYLES_CSS__",
        "//haku/console:logo.svg": "__LOGO_SVG__",
    },
    jsx = "automatic",
    deps = [":main_lib"],
)

# Full TypeScript type-check (the correctness gate esbuild bundling skips).
tsc_bin.tsc_test(
    name = "tsc_test",
    args = [
        "--noEmit",
        "-p",
        "tsconfig.json",
    ],
    chdir = package_name(),
    data = [
        "bridge.test.ts",
        "haku_ui_embed.test.ts",
        "tsconfig.json",
        ":main_lib",
        ":schema",
        "//:node_modules",
    ],
    tags = ["lint"],
)

vitest_bin.vitest_test(
    name = "bridge_test",
    args = ["run"],
    chdir = package_name(),
    data = [
        "bridge.test.ts",
        "haku_ui_embed.test.ts",
        "vitest.config.ts",
        ":bridge",
        ":haku_ui_embed",
        "//:node_modules",
    ],
)
