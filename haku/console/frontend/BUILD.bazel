        ":field",
        ":google_client",
        ":schema_zod",
        "//:node_modules/@mantine/core",
        "//:node_modules/date-fns",
        "//:node_modules/react",
        "//:node_modules/zod",
    ],
)

js_library(
    name = "kubectl_tool_previews",
    srcs = ["tool_previews/kubectl.tsx"],
    deps = [
        ":field",
        "//:node_modules/@mantine/core",
        "//:node_modules/react",
        "//:node_modules/zod",
    ],
