load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library", "js_run_binary", "js_test")
load("@npm_ducktape//:@tailwindcss/cli/package_json.bzl", tailwindcss_bin = "bin")
load("@npm_ducktape//:typescript/package_json.bzl", tsc_bin = "bin")
load("@npm_ducktape//:vitest/package_json.bzl", vitest_bin = "bin")
load("//devinfra/js:openapi.bzl", "js_openapi_schema", "js_openapi_zod")
load("//devinfra/js:spa_bundle.bzl", "spa_bundle")

package(default_visibility = ["//visibility:public"])

# TypeScript types generated from the backend's OpenAPI schema (reuses the API
# Pydantic models as the wire contract). Not checked in; regenerated each build.
js_openapi_schema(
    name = "schema",
    generator = "//haku/console:export_schema_bin",
)

# Runtime Zod validators for the same backend models, generated from the same OpenAPI
# JSON as :schema above. Used where a widget parses tool-call arguments it doesn't fully
# trust (google_tool_previews.tsx) — a single source of truth for both the TS type and
# the runtime shape check, instead of a hand-written `typeof`-narrowing guard that can
# drift from the Pydantic model.
js_openapi_zod(
    name = "schema_zod",
    out = "api/schema.zod.ts",
    generator = "//haku/console:export_schema_bin",
)

js_library(
    name = "client",
    srcs = ["client.ts"],
    deps = [
        ":schema",
        "//:node_modules/openapi-fetch",
    ],
)

js_library(
    name = "google_client",
    srcs = ["google_client.ts"],
    deps = [
        ":client",
        ":schema",
    ],
)

js_library(
    name = "grocy_client",
    srcs = ["grocy_client.ts"],
    deps = [
        ":client",
        ":schema",
    ],
)

js_library(
    name = "approval_state",
    srcs = ["approval_state.ts"],
    deps = [
        ":client",
        "//:node_modules/@haku/console-bridge",
    ],
)

js_library(
    name = "theme",
    srcs = ["theme.ts"],
    deps = ["//:node_modules/@mantine/core"],
)

js_library(
    name = "toast",
    srcs = ["toast.ts"],
    deps = [
        ":theme",
        "//:node_modules/@mantine/notifications",
        "//:node_modules/react",
