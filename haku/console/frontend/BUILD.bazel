)

js_library(
    name = "geolocation",
    srcs = ["geolocation.ts"],
    deps = ["//:node_modules/@haku/console-bridge"],
)

js_library(
    name = "confirm_dialog",
    srcs = ["confirm_dialog.tsx"],
    deps = [
        ":bridge",
        ":theme",
        "//:node_modules/@mantine/core",
        "//:node_modules/react",
    ],
)

js_library(
    name = "field",
