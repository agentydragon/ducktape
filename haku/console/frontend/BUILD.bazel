# TypeScript types generated from the backend's OpenAPI schema (reuses the API
# Pydantic models as the wire contract). Not checked in; regenerated each build.
openapi_typescript(
    name = "_schema_types",
    out = "api/schema.d.ts",
    schema = "//haku/console:openapi_schema",
)

js_library(
    name = "schema",
    srcs = [":_schema_types"],
    tags = ["no-lint"],
)

# The exact input schemas advertised by the in-process MCP servers. Keep both the generated
# TypeScript declarations and their source JSON: :mcp_tool_schema turns each catalog entry into
# a runtime Zod validator derived from FastMCP's advertised structural contract.
json_schema_typescript(
    name = "_mcp_tool_arguments_types",
    out = "api/mcp_tool_arguments.d.ts",
    schema = "//haku/console/mcp:tool_arguments_schema",
)

copy_file(
    name = "_mcp_tool_arguments_json",
    src = "//haku/console/mcp:tool_arguments_schema",
    out = "api/mcp_tool_arguments.schema.json",
)

js_library(
    name = "mcp_tool_arguments",
    srcs = [
        ":_mcp_tool_arguments_json",
        ":_mcp_tool_arguments_types",
    ],
    tags = ["no-lint"],
)

# The exact output (result) schemas advertised by the in-process MCP servers, emitted by the
# same exporter with `--results`. :mcp_tool_result_schema mirrors :mcp_tool_schema for results,
# so per-tool result widgets validate against FastMCP's advertised output contract rather than
# restating it. grocy-sf contributes its reflected batch and read tools; its OpenAPI tool widgets
# stay hand-authored.
json_schema_typescript(
    name = "_mcp_tool_results_types",
    out = "api/mcp_tool_results.d.ts",
    schema = "//haku/console/mcp:tool_results_schema",
)

copy_file(
    name = "_mcp_tool_results_json",
    src = "//haku/console/mcp:tool_results_schema",
    out = "api/mcp_tool_results.schema.json",
)

js_library(
    name = "mcp_tool_results",
    srcs = [
        ":_mcp_tool_results_json",
        ":_mcp_tool_results_types",
    ],
    tags = ["no-lint"],
)

ts_library(
    name = "mcp_tool_schema",
