# Tailwind v4 scans the `@source`-declared file for class names; production keeps only the
# sources used by the shipped shell.
filegroup(
    name = "tailwind_content_srcs",
    srcs = [
        "app.tsx",
        "approval_state.ts",
        "client.ts",
        "confirm_dialog.tsx",
        "field.tsx",
        "haku_ui_embed.tsx",
        "icons.tsx",
        "index.html",
        "main.tsx",
        "open_external.ts",
        "routing.ts",
        "settings_panel.tsx",
        "shell_chrome.tsx",
        "theme.ts",
        "toast.ts",
        "variant_control.tsx",
    ],
)

filegroup(
    name = "renderer_tailwind_content_srcs",
    srcs = [
        "calendar_client.ts",
        "gmail_client.ts",
        "grocy_client.ts",
        "tana_client.ts",
        "tool_arguments_field.tsx",
        "tool_call_card.tsx",
        "tool_call_meta.tsx",
        "tool_result_field.tsx",
        "//haku/console/frontend/tool_rendering:tailwind_srcs",
    ],
)

genrule(
    name = "tailwind_content_index",
    srcs = [":tailwind_content_srcs"],
    outs = ["tailwind_content.txt"],
    cmd = "cat $(SRCS) > $@",
)

genrule(
    name = "renderer_tailwind_content_index",
    srcs = [":renderer_tailwind_content_srcs"],
    outs = ["renderer_tailwind_content.txt"],
    cmd = "cat $(SRCS) > $@",
)

tailwindcss_bin.tailwindcss_binary(
    name = "tailwind_cli",
    data = [
        "//:node_modules/@mantine/core",
        # `@import "@mantine/notifications/styles.css"` in styles.src.css.
        "//:node_modules/@mantine/notifications",
        "//:node_modules/@tailwindcss/cli",
        # `@import "tailwindcss"` in styles.src.css resolves to this package.
        "//:node_modules/tailwindcss",
    ],
)

js_run_binary(
    name = "styles_css",
    srcs = [
        "styles.src.css",
        ":tailwind_content_index",
    ],
    outs = ["generated/styles.css"],
    args = [
        "--input",
        "styles.src.css",
        "--output",
        "generated/styles.css",
        "--minify",
    ],
    chdir = package_name(),
    tool = ":tailwind_cli",
)

js_run_binary(
    name = "preview_styles_css",
    srcs = [
        "preview_styles.src.css",
        "styles.src.css",
        "tool_call_card.src.css",
        ":renderer_tailwind_content_index",
        ":tailwind_content_index",
    ],
    outs = ["generated/preview_styles.css"],
    args = [
        "--input",
        "preview_styles.src.css",
        "--output",
        "generated/preview_styles.css",
        "--minify",
    ],
    chdir = package_name(),
    tool = ":tailwind_cli",
)

# Everything the static frontend image serves as the SPA docroot.
spa_bundle(
    name = "bundle",
    entry_point = "main.js",
    fingerprint = True,
    fingerprinted_assets = {
        ":styles_css": "__STYLES_CSS__",
        "//haku/console:logo.svg": "__LOGO_SVG__",
    },
    jsx = "automatic",
    url_prefix = "/_console/",
    deps = [":main_lib"],
)

# ── Visual screenshots ─────────────────────────────────────────────────────────
#
# `bbr test //haku/console/frontend:screenshots` renders each console visual surface
# (harness/harness.tsx) to a PNG in the test's undeclared outputs, for eyeballing (see
# AGENTS.md). Browser rendering runs on the RBE worker's display stack, so it is a test, not a
# `bb run` binary. It is a generator, not a pixel-diff gate: it passes as long as every scene renders.
# Python tests in test_visual.py own interactions, readiness and capture.

ts_library(
    name = "screenshot_harness_lib",
    srcs = [
        "harness/harness.tsx",
        "harness/mock_api.ts",
        "harness/sample_data.ts",
    ],
    isolated_typecheck = True,
    tags = ["no-lint"],
    tsconfig = TSCONFIG,
    deps = [
        ":client",
        ":haku_ui_embed",
        ":routing",
        ":schema",
        ":shell_chrome",
        ":theme",
        "//:node_modules/@mantine/core",
        "//:node_modules/@mantine/notifications",
        "//:node_modules/@types/react",
        "//:node_modules/@types/react-dom",
        "//:node_modules/react",
        "//:node_modules/react-dom",
    ],
)

js_binary(
    name = "build_screenshot_harness",
    data = [
        "harness/esbuild.config.mjs",
        ":screenshot_harness_lib",
        "//:node_modules/esbuild",
    ],
    entry_point = "harness/esbuild.config.mjs",
)

js_run_binary(
    name = "screenshot_harness_bundle",
    srcs = [
        "harness/esbuild.config.mjs",
        ":screenshot_harness_lib",
    ],
    outs = ["harness/dist/harness.js"],
    args = ["harness/dist"],
    chdir = package_name(),
    tool = ":build_screenshot_harness",
)

# Single-file target so $(rootpath) resolves to one path.
filegroup(
    name = "screenshot_harness_js",
    srcs = ["harness/dist/harness.js"],
)

py_visual_test(
    name = "screenshots",
    # medium: each of the 4 shards measures 35s alone and up to 63s with nine runs at once; `small` is 60s.
    size = "medium",
    harness = ":screenshot_harness_js",
    inline_page = True,
    # The shell reads `localStorage`, frames another origin and parses its own location, and the mock
    # fetch parses relative `/api/…` URLs it never sends: it needs the origin of a real page.
    page_url = "https://haku-console.test/",
    # The shell frames Haku's UI, an origin that does not exist here: the fence answers it with a striped
    # test document, so layout overlap with the frame is visible in the image.
    served_documents = {"https://haku-ui.test/": "harness/mock_haku_ui.html"},
    shard_count = 4,
    stylesheets = [":styles_css"],
    test_deps = [
        "//util/testing:page_capture",
        "//util/testing:viewports",
        "//util/testing:visual_capture",
        "@pypi//playwright",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",
        "@pypi//pytest_bazel",
    ],
    test_module = "haku.console.frontend.test_visual",
    test_srcs = ["test_visual.py"],
    title = "Haku Console",
)

# ── Unit tests ─────────────────────────────────────────────────────────────────
