package(default_visibility = ["//visibility:public"])

# TypeScript types generated from the backend's OpenAPI schema (reuses the API
# Pydantic models as the wire contract). Not checked in; regenerated each build.
js_openapi_schema(
    name = "schema",
    generator = "//haku/console:export_schema_bin",
)

# The exact input schemas advertised by the in-process MCP servers. Keep both the generated
# TypeScript declarations and their source JSON: :mcp_tool_schema turns each catalog entry into
# a runtime Zod validator derived from FastMCP's advertised structural contract.
js_json_schema(
    name = "mcp_tool_arguments",
    out = "api/mcp_tool_arguments.d.ts",
    generator = "//haku/console:export_mcp_tool_schemas_bin",
    schema_out = "api/mcp_tool_arguments.schema.json",
)

js_library(
    name = "mcp_tool_schema",
    srcs = ["mcp_tool_schema.ts"],
    deps = [
        ":mcp_tool_arguments",
        "//:node_modules/zod",
    ],
)

