    name = "tailwind_content_srcs",
    srcs = [
        "agent_enrollment_panel.tsx",
        "app.tsx",
        "approval_state.ts",
        "calendar_client.ts",
        "client.ts",
        "confirm_dialog.tsx",
        "field.tsx",
        "gmail_client.ts",
        "grocy_client.ts",
        "haku_ui_embed.tsx",
        "icons.tsx",
        "index.html",
        "main.tsx",
        "oauth_result_announcement.ts",
        "oauth_result_page.tsx",
        "open_external.ts",
        "pending_tool_call_actions.tsx",
        "push_subscription.ts",
        "routing.ts",
        "settings_panel.tsx",
        "shell_chrome.tsx",
        "tana_client.ts",
        "theme.ts",
        "toast.ts",
        "tool_action_line.tsx",
        "tool_arguments_field.tsx",
        "tool_call_card.tsx",
        "tool_call_decision.ts",
        "tool_call_meta.tsx",
        "tool_calls_page.tsx",
        "tool_result_field.tsx",
        "variant_control.tsx",
        "//haku/console/frontend/tool_rendering:tailwind_srcs",
        "//haku/console/frontend/x:tailwind_content_srcs",
    ],
)

genrule(
    name = "tailwind_content_index",
    srcs = [":tailwind_content_srcs"],
    outs = ["tailwind_content.txt"],
    cmd = "cat $(SRCS) > $@",
)

tailwindcss_bin.tailwindcss_binary(
    name = "tailwind_cli",
    data = [
        "//:node_modules/@mantine/core",
        # `@import "@mantine/notifications/styles.css"` in styles.src.css.
        "//:node_modules/@mantine/notifications",
        "//:node_modules/@tailwindcss/cli",
        # `@import "tailwindcss"` in styles.src.css resolves to this package.
        "//:node_modules/tailwindcss",
    ],
)

js_run_binary(
    name = "styles_css",
    srcs = [
        "styles.src.css",
        ":tailwind_content_index",
    ],
    outs = ["generated/styles.css"],
    args = [
        "--input",
        "styles.src.css",
        "--output",
        "generated/styles.css",
        "--minify",
    ],
    chdir = package_name(),
    tool = ":tailwind_cli",
)

# Everything the static frontend image serves as the SPA docroot.
spa_bundle(
    name = "bundle",
    entry_point = "main.js",
    fingerprint = True,
    fingerprinted_assets = {
        ":styles_css": "__STYLES_CSS__",
        "//haku/console:logo.svg": "__LOGO_SVG__",
    },
    jsx = "automatic",
    url_prefix = "/_console/",
    deps = [":main_lib"],
)

# ── Visual screenshots ─────────────────────────────────────────────────────────
#
# `bbr test //haku/console/frontend:screenshots` renders each console visual surface
# (screenshots/harness.tsx) to a PNG in the test's undeclared outputs, for eyeballing (see
# AGENTS.md). Browser rendering runs on the RBE worker's display stack — a local Bazel
# can't fetch repos in web sessions — so it is a js_test, not a `bb run` binary. It is a
# generator, not a pixel-diff gate: it passes as long as every scene renders.

ts_library(
    name = "screenshot_harness_lib",
    srcs = [
        "screenshots/harness.tsx",
        "screenshots/mock_api.ts",
        "screenshots/sample_data.ts",
    ],
    tags = ["no-lint"],
    tsconfig = TSCONFIG,
    deps = [
        ":approval_state",
        ":client",
        ":haku_ui_embed",
        ":oauth_result_page",
        ":routing",
        ":settings_panel",
        ":shell_chrome",
        ":theme",
        ":toast",
        ":tool_calls_page",
        "//:node_modules/@mantine/core",
        "//:node_modules/@mantine/notifications",
        "//:node_modules/@types/react",
        "//:node_modules/@types/react-dom",
        "//:node_modules/react",
        "//:node_modules/react-dom",
        "//haku/console/frontend/tool_rendering",
        "//haku/console/frontend/tool_rendering/google_calendar:fixtures",
        "//haku/console/frontend/tool_rendering/grocy:fixtures",
        "//haku/console/frontend/tool_rendering/screenshot:mcp_mock",
    ],
)

js_binary(
    name = "build_screenshot_harness",
    data = [
        "screenshots/esbuild.config.mjs",
        ":screenshot_harness_lib",
        "//:node_modules",
    ],
    entry_point = "screenshots/esbuild.config.mjs",
)

js_run_binary(
    name = "screenshot_harness_bundle",
    srcs = [
        "screenshots/esbuild.config.mjs",
        ":screenshot_harness_lib",
    ],
    outs = ["screenshots/dist/harness.js"],
    args = ["screenshots/dist"],
    chdir = package_name(),
    tool = ":build_screenshot_harness",
)

# Single-file target so $(rootpath) resolves to one path.
filegroup(
    name = "screenshot_harness_js",
