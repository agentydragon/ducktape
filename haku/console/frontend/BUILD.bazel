# vitest loads this config itself, so it must stay a `.ts` file in the runfiles rather than be
# compiled to one. `no_emit` type-checks it anyway, through the generated
# :vitest_config_typecheck_test.
ts_project(
    name = "vitest_config",
    srcs = ["vitest.config.ts"],
    extends = ":tsconfig",
    no_emit = True,
    resolve_json_module = True,
    tsconfig = {
        "exclude": [],
        "include": [],
    },
    deps = ["//:node_modules/vitest"],
)

vitest_bin.vitest_test(
    name = "vitest_test",
    args = ["run"],
    chdir = package_name(),
    data = [
        "vitest.config.ts",
        ":approval_state_test",
