# The service worker is bundled on its own, not as part of :bundle, because its URL must be
# stable across deploys (a fingerprinted name would read as a different worker every build) and
# it must be served from the docroot root so its default scope covers the whole origin. The
# bundle is written to a subdirectory only so it does not collide with :sw_lib's compiled
# `sw.js`, which it bundles; the image flattens it back to /sw.js — see
# //haku/console:service_worker_files.
esbuild(
    name = "service_worker",
    entry_point = "sw.js",
    format = "esm",
    minify = True,
    output = "bundled/sw.js",
    platform = "browser",
    sourcemap = "linked",
    target = ["es2022"],
    deps = [":sw_lib"],
)

