py_test(
    name = "test_gmail",
    # Imports, not tests: the 14 cases here drive mocks and take about a second all told
    # (`--durations` puts every one at ~0.03s). The rest of the wall time is interpreter start
    # plus this package's import graph — still ~8s of it, four fifths under `fastmcp`, once the
    # parent conftest is out of the runfiles (it was ~13s with). The 60s `small` default left no
    # room for that once CI was loaded: it timed out twice in three runs while passing at 29s here.
    size = "medium",
    srcs = ["test_gmail.py"],
    deps = [
        ":gmail",
        ":gmail_client",
        "//:conftest",
        "//gmail_api:filters",
        "//gmail_api:labels",
        "//gmail_api:messages",
        "@pypi//fastmcp_slim",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        # Not statically imported -- pytest-asyncio auto mode (set in root conftest.py) needs the
        # plugin importable at runtime for its entry-point autoload; Gazelle can't see that and
        # will try to drop this dep on regen.
        "@pypi//pytest_asyncio",
    ],
)

