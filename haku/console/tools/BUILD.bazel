load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//haku/console:__subpackages__"])

# Deliberately no `//haku/console:conftest` on the tests below (`test_kubernetes` excepted —
# it runs against the parent conftest's real database). The rest are leaf MCP servers and
# their clients: each builds its own `FastMCP` over a mock and uses none of the parent
# conftest's fixtures. Shipping that file into the runfiles is not free even so — pytest imports
# every ancestor-directory conftest at collection, and `haku/console/conftest.py` imports
# `create_app`, i.e. the whole console composition root (kubernetes_asyncio, nio, sqlalchemy,
# the FastMCP stack), which roughly doubled these targets' wall time for fixtures nobody asked
# for. The fixtures themselves are lazy; a module-level import is not.
#
# A test here that later does want a shared fixture just adds the dep back — the failure without
# it is a loud `fixture 'x' not found`, and the parent conftest defines no autouse fixtures or
# hooks, so its absence changes nothing else.

