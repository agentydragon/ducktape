load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//haku/console:__subpackages__"])

py_library(
    name = "gmail_client",
    srcs = ["gmail_client.py"],
    deps = [
        "//gmail_api:filters",
        "//gmail_api:labels",
        "//gmail_api:messages",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "google_calendar_client",
    srcs = ["google_calendar_client.py"],
    deps = [
        "@pypi//pydantic",
        "@pypi//python_dateutil",
    ],
)

py_library(
    name = "google_service",
    srcs = ["google_service.py"],
    visibility = ["//haku/console:__subpackages__"],
    deps = [
        "@pypi//google_api_python_client",
        "@pypi//google_auth",
    ],
)

py_library(
    name = "gmail",
    srcs = ["gmail.py"],
    visibility = ["//haku/console:__subpackages__"],
    deps = [
        ":gmail_client",
        ":google_discovery",
        ":google_service",
        "//gmail_api:filters",
        "//gmail_api:labels",
        "//gmail_api:messages",
        "@pypi//fastmcp_slim",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "google_calendar",
    srcs = ["google_calendar.py"],
    visibility = ["//haku/console:__subpackages__"],
    deps = [
        ":google_calendar_client",
        ":google_service",
        "@pypi//fastmcp_slim",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "routine",
    srcs = ["routine.py"],
    visibility = ["//haku/console:__subpackages__"],
    deps = [
        "//haku/console:config",
        "@pypi//fastmcp_slim",
        "@pypi//httpx",
        "@pypi//pydantic",
    ],
)

py_test(
    name = "test_gmail",
    srcs = ["test_gmail.py"],
    deps = [
        ":gmail",
        ":gmail_client",
        "//:conftest",
        "//gmail_api:filters",
        "//gmail_api:labels",
        "//gmail_api:messages",
        "//haku/console:conftest",
        "@pypi//fastmcp_slim",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        # Not statically imported -- pytest-asyncio auto mode (set in root conftest.py) needs the
        # plugin importable at runtime for its entry-point autoload; Gazelle can't see that and
        # will try to drop this dep on regen.
        "@pypi//pytest_asyncio",
    ],
)

py_test(
    name = "test_gmail_client",
    srcs = ["test_gmail_client.py"],
    deps = [
        ":gmail_client",
        "//:conftest",
        "//gmail_api:filters",
        "//gmail_api:labels",
        "//gmail_api:messages",
        "//haku/console:conftest",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_google_calendar",
    srcs = ["test_google_calendar.py"],
    deps = [
        ":google_calendar",
        ":google_calendar_client",
        "//:conftest",
        "//haku/console:conftest",
        "@pypi//fastmcp_slim",
        "@pypi//pytest_bazel",
        # See test_gmail: pytest-asyncio must be a runtime dep for auto-mode plugin autoload;
        # Gazelle drops it on regen since nothing imports it.
        "@pypi//pytest_asyncio",
    ],
)

py_test(
    name = "test_google_calendar_client",
    srcs = ["test_google_calendar_client.py"],
    deps = [
        ":google_calendar_client",
        "//:conftest",
        "//haku/console:conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_routine",
    srcs = ["test_routine.py"],
    deps = [
        ":routine",
        "//:conftest",
        "//haku/console:conftest",
        "@pypi//fastmcp_slim",
        "@pypi//pytest_bazel",
        # See test_gmail: pytest-asyncio must be a runtime dep for auto-mode plugin autoload;
        # Gazelle drops it on regen since nothing imports it.
        "@pypi//pytest_asyncio",
    ],
)

py_test(
    name = "test_routine_client",
    srcs = ["test_routine_client.py"],
    deps = [
        ":routine",
        "//:conftest",
        "//haku/console:config",
        "//haku/console:conftest",
        "@pypi//httpx",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//respx",
        # See test_gmail: pytest-asyncio must be a runtime dep for auto-mode plugin autoload;
        # Gazelle drops it on regen since nothing imports it.
        "@pypi//pytest_asyncio",
    ],
)

py_library(
    name = "google_discovery",
    srcs = ["google_discovery.py"],
    visibility = ["//haku/console:__subpackages__"],
    deps = [
        "@pypi//fastmcp_slim",
        "@pypi//google_api_python_client",  # keep: discovery docs loaded via importlib.resources (no import stmt)
        "@pypi//pydantic",
    ],
)
