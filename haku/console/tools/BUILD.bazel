    name = "test_grocy",
    srcs = ["test_grocy.py"],
    deps = [
        ":grocy",
        "//:conftest",
        "//haku/console:conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        # Not statically imported -- pytest-asyncio auto mode (set in root conftest.py)
