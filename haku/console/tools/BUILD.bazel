load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//haku/console:__subpackages__"])

py_library(
    name = "google_calendar",
    srcs = ["google_calendar.py"],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "google_gmail",
    srcs = ["google_gmail.py"],
    deps = [
        "//gmail_api:labels",
        "//haku/gmail_labeling:backend",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "google",
    srcs = ["google.py"],
    visibility = ["//haku/console:__subpackages__"],
    deps = [
        ":google_calendar",
        ":google_gmail",
        "//gmail_api:service",
        "@pypi//fastapi",
        "@pypi//fastmcp",
        "@pypi//google_api_python_client",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "grocy",
    srcs = ["grocy.py"],
    visibility = ["//haku/console:__subpackages__"],
    deps = [
        "//haku/console:deps",
        "//haku/console:mcp_approval",
        "@pypi//fastapi",
        "@pypi//pydantic",
    ],
)

py_test(
    name = "test_google_calendar",
    srcs = ["test_google_calendar.py"],
    deps = [
        ":google_calendar",
        "//:conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_google_gmail",
    srcs = ["test_google_gmail.py"],
    deps = [
        ":google_gmail",
        "//:conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_google",
    srcs = ["test_google.py"],
    deps = [
        ":google",
        ":google_calendar",
        ":google_gmail",
        "//:conftest",
        "//haku/console:conftest",
        "@pypi//fastmcp",
        "@pypi//pytest_bazel",
        # Not statically imported -- pytest-asyncio auto mode (set in root conftest.py)
        # needs the plugin importable at runtime for its entry-point autoload; Gazelle
        # can't see that and will try to drop this dep on regen.
        "@pypi//pytest_asyncio",
    ],
)
