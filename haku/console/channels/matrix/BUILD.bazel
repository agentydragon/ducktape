# ── OCI image (the haku-matrix-adapter worker) ────────────────────────────────
# The Matrix channel adapter, deployed separately from the console API so a homeserver
# outage, a matrix-nio upgrade, or an adapter bug never rolls or disrupts the Console
# perimeter — and so the console pod carries no Matrix credential. Same base and CA
# bundle as its siblings: the homeserver URL is config, so an https:// homeserver must
# not require an image change.

aspect_py_binary(
    name = "adapter_bin",
    main = "worker.py",
    deps = [":worker"],
)

py_image_layer(
    name = "adapter_layers",
    binary = ":adapter_bin",
    group = "1000",
    owner = "1000",
)

oci_image(
    name = "adapter_image",
    base = "@debian_trixie_slim_linux_amd64",
    entrypoint = py_image_entrypoint("adapter_bin"),
    env = py_image_env(binary_name = "adapter_bin"),
    labels = {
        "org.opencontainers.image.source": "https://github.com/agentydragon/ducktape",
        "org.opencontainers.image.title": "haku-matrix-adapter",
    },
    tars = [
        ":adapter_layers",
        "//third_party/debian_slim:cacerts",
    ],
    user = "1000:1000",
    visibility = ["//visibility:public"],
)

oci_load(
    name = "adapter_load",
    image = ":adapter_image",
    repo_tags = ["haku-matrix-adapter:latest"],
)
