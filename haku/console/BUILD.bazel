# ── OCI image (the haku-console service) ──────────────────────────────────────
# CA bundle (//third_party/debian_slim:cacerts): system trust store on the bare
# slim base for the capability tier's outbound HTTPS call to the Anthropic fire URL
# (api.anthropic.com).

aspect_py_binary(
    name = "server_bin",
    main = "app.py",
    deps = [":app"],
)

py_image_layer(
    name = "server_layers",
    binary = ":server_bin",
    group = "1000",
    owner = "1000",
)

pkg_files(
    name = "web_files",
    srcs = ["//haku/console/frontend:bundle"],
    # The bundle output keeps its `dist/` directory; nginx roots at this child path.
    prefix = "/usr/share/nginx/html",
    strip_prefix = strip_prefix.files_only(),
)

# The service worker sits at the docroot root, beside index.html rather than under
# /_console/assets/: its scope must cover the whole origin, and its URL must stay stable across
# deploys (a fingerprinted name would register as a new worker every build). `location /` already
# serves it `no-store`, which is what a worker script wants — see frontend/push_subscription.ts.
pkg_files(
    name = "service_worker_files",
    srcs = ["//haku/console/frontend:service_worker"],
    prefix = "/usr/share/nginx/html/dist",
    strip_prefix = strip_prefix.files_only(),
)

pkg_files(
    name = "nginx_conf_files",
    srcs = ["default.conf.template"],
    prefix = "/etc/nginx/templates",
    strip_prefix = strip_prefix.files_only(),
)

pkg_tar(
    name = "static_tar",
    srcs = [
        ":nginx_conf_files",
        ":service_worker_files",
        ":web_files",
    ],
)

oci_image(
    name = "server_image",
    base = "@debian_trixie_slim_linux_amd64",
    entrypoint = py_image_entrypoint("server_bin"),
    env = py_image_env(binary_name = "server_bin"),
    labels = {
        "org.opencontainers.image.source": "https://github.com/agentydragon/ducktape",
        "org.opencontainers.image.title": "haku-console",
    },
    tars = [
        ":server_layers",
        "//third_party/debian_slim:cacerts",
    ],
    user = "1000:1000",
    visibility = ["//visibility:public"],
)

oci_load(
    name = "server_load",
    image = ":server_image",
    repo_tags = ["haku-console:latest"],
)

# ── OCI image (the haku-indexer worker) ───────────────────────────────────────
# The recall-index maintenance worker, deployed separately from the console API so
# index churn and failures never roll or disrupt the Console perimeter. Same base and
# CA bundle: libgit2 verifies the public ducktape HTTPS remote against the system store.

aspect_py_binary(
    name = "indexer_bin",
    main = "indexer.py",
    deps = [":indexer"],
)

py_image_layer(
    name = "indexer_layers",
    binary = ":indexer_bin",
    group = "1000",
    owner = "1000",
)

oci_image(
    name = "indexer_image",
    base = "@debian_trixie_slim_linux_amd64",
    entrypoint = py_image_entrypoint("indexer_bin"),
    env = py_image_env(binary_name = "indexer_bin"),
    labels = {
        "org.opencontainers.image.source": "https://github.com/agentydragon/ducktape",
        "org.opencontainers.image.title": "haku-indexer",
    },
    tars = [
        ":indexer_layers",
        "//third_party/debian_slim:cacerts",
    ],
    user = "1000:1000",
    visibility = ["//visibility:public"],
)

oci_load(
    name = "indexer_load",
    image = ":indexer_image",
    repo_tags = ["haku-indexer:latest"],
)

