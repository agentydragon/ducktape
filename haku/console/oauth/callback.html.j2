<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>{{ title }}</title>
    <style nonce="{{ csp_nonce }}">
      body {
        color-scheme: light dark;
        font:
          16px system-ui,
          sans-serif;
        margin: 3rem auto;
        max-width: 36rem;
        line-height: 1.4;
      }
      code {
        overflow-wrap: anywhere;
      }
      a {
        color: LinkText;
      }
    </style>
  </head>
  <body>
    <h1>{{ title }}</h1>
    <p><code>{{ message }}</code></p>
    {% if action_url and action_label %}<p><a href="{{ action_url }}">{{ action_label }}</a></p>{% endif %}
  </body>
</html>
