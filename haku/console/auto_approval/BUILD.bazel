load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//haku/console:__subpackages__"])

py_library(
    name = "__init__",
    srcs = ["__init__.py"],
)

py_library(
    name = "decision",
    srcs = ["decision.py"],
)

py_library(
    name = "kubernetes",
    srcs = ["kubernetes.py"],
    deps = [
        ":decision",
        "//haku/console:tool_call_actor",
        "//haku/console/grants:principal",
        "//haku/console/grants/kubernetes:authorization_service",
        "//haku/console/grants/kubernetes:kubectl_passthrough_policy",
    ],
)

py_library(
    name = "registry",
    srcs = ["registry.py"],
    visibility = [
        "//cluster/validation:__pkg__",
        "//haku/console:__subpackages__",
    ],
    deps = [
        ":decision",
        ":kubernetes",
        "//haku/console:mcp_config",
        "//haku/console:tool_call_actor",
        "//haku/console/grants/kubernetes:authorization_service",
        "@pypi//fastmcp_slim",
        "@pypi//jsonschema",
        "@pypi//referencing",
    ],
)

py_test(
    name = "test_registry",
    srcs = ["test_registry.py"],
    deps = [
        ":registry",
        "//:conftest",
        "//haku/console:conftest",
        "//haku/console:mcp_config",
        "//haku/console:tool_call_actor",
        "//x/google_mcp_server:gmail",
        "//x/google_mcp_server:google_calendar",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
