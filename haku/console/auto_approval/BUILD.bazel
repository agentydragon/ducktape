load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//haku/console:__subpackages__"])

py_library(
    name = "__init__",
    srcs = ["__init__.py"],
)

py_library(
    name = "decision",
    srcs = ["decision.py"],
)

py_library(
    name = "github",
    srcs = ["github.py"],
    deps = [
        ":decision",
        "@pypi//httpx",
    ],
)

py_test(
    name = "test_github",
    srcs = ["test_github.py"],
    deps = [
        ":github",
        "//:conftest",
        "//haku/console:conftest",
        "@pypi//httpx",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "gmail",
    srcs = ["gmail.py"],
    deps = [
        ":decision",
        "//haku/console/tools:gmail_client",
    ],
)

py_library(
    name = "home_assistant",
    srcs = ["home_assistant.py"],
    deps = [":decision"],
)

py_test(
    name = "test_home_assistant",
    srcs = ["test_home_assistant.py"],
    deps = [
        ":decision",
        ":home_assistant",
        "//:conftest",
        "//haku/console:conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "kubernetes",
    srcs = ["kubernetes.py"],
    deps = [
        ":decision",
        "//haku/console:tool_call_actor",
        "//haku/console/grants:principal",
        "//haku/console/grants/kubernetes:authorization_service",
        "//haku/console/grants/kubernetes:kubectl_passthrough_policy",
    ],
)

py_library(
    name = "registry",
    srcs = ["registry.py"],
    deps = [
        ":decision",
        ":github",
        ":gmail",
        ":home_assistant",
        ":kubernetes",
        "//haku/console:mcp_config",
        "//haku/console:tool_call_actor",
        "//haku/console/grants/kubernetes:authorization_service",
        "//haku/console/tools:gmail_client",
        "@pypi//fastmcp_slim",
        "@pypi//jsonschema",
        "@pypi//referencing",
    ],
)

py_test(
    name = "test_registry",
    srcs = ["test_registry.py"],
    deps = [
        ":github",
        ":registry",
        "//:conftest",
        "//gmail_api:labels",
        "//haku/console:conftest",
        "//haku/console:mcp_config",
        "//haku/console:tool_call_actor",
        "//haku/console/tools:gmail",
        "//haku/console/tools:google_calendar",
        "@pypi//httpx",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
