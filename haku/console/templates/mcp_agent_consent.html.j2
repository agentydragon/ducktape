<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; base-uri 'none'">
  <title>Name this agent · Haku</title>
  <style>
    :root { color-scheme: light dark; font-family: Inter, ui-sans-serif, system-ui, sans-serif; }
    * { box-sizing: border-box; }
    body { min-height: 100vh; margin: 0; display: grid; place-items: center; padding: 24px;
      background: radial-gradient(circle at top, #28223f 0, #12101c 44%, #09080d 100%); color: #f7f3ff; }
    main { width: min(100%, 520px); padding: 32px; border: 1px solid #4b4265; border-radius: 20px;
      background: rgba(24, 21, 35, .96); box-shadow: 0 24px 80px #0008; }
    .eyebrow { margin: 0 0 8px; color: #c4b5fd; font-size: 13px; font-weight: 700;
      letter-spacing: .09em; text-transform: uppercase; }
    h1 { margin: 0; font-size: clamp(28px, 7vw, 38px); line-height: 1.1; }
    .intro { margin: 14px 0 26px; color: #d4cde2; line-height: 1.55; }
    .error { margin: 0 0 18px; padding: 12px; border: 1px solid #f87171; border-radius: 10px;
      background: #7f1d1d55; color: #fecaca; }
    label { display: block; margin-bottom: 8px; font-weight: 650; }
    input[type=text] { width: 100%; padding: 14px 15px; border: 1px solid #6e638c; border-radius: 10px;
      background: #100e18; color: #fff; font: inherit; outline: none; }
    input[type=text]:focus { border-color: #a78bfa; box-shadow: 0 0 0 3px #8b5cf633; }
    .hint { margin: 8px 0 24px; color: #aaa0bc; font-size: 13px; }
    .buttons { display: flex; gap: 10px; }
    button { flex: 1; padding: 12px 16px; border: 0; border-radius: 10px; font: inherit; font-weight: 700; cursor: pointer; }
    .allow { background: #8b5cf6; color: white; } .allow:hover { background: #7c3aed; }
    .deny { background: #353044; color: #eee9f7; } .deny:hover { background: #443d56; }
    details { margin-top: 24px; color: #aaa0bc; font-size: 13px; }
    summary { cursor: pointer; color: #c9c0d8; }
    dl { display: grid; grid-template-columns: max-content 1fr; gap: 8px 12px; overflow-wrap: anywhere; }
    dt { color: #8f849f; } dd { margin: 0; color: #d4cde2; }
  </style>
</head>
<body>
  <main>
    <p class="eyebrow">Haku Console</p>
    <h1>Name this agent</h1>
    <p class="intro"><strong>{{ client_name or "the connecting client" }}</strong> wants permission to use Haku's MCP tools as you.
      Give this connection a name you will recognize in approvals and history.</p>
    {% if error %}<p class="error" role="alert">{{ error }}</p>{% endif %}
    <form method="post" action="">
      <input type="hidden" name="txn_id" value="{{ txn_id }}">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <label for="agent-name">Agent name</label>
      <input id="agent-name" name="agent_name" type="text" required maxlength="{{ max_agent_display_name_length }}"
        autocomplete="off" autofocus value="{{ agent_name }}" placeholder="e.g. Claude.ai on my laptop">
      <p class="hint">You can use the same client on multiple devices; name this particular connection.</p>
      <div class="buttons">
        <button class="deny" type="submit" name="action" value="deny" formnovalidate>Deny</button>
        <button class="allow" type="submit" name="action" value="approve">Allow agent</button>
      </div>
    </form>
    <details>
      <summary>Connection details</summary>
      <dl>
        <dt>Client ID</dt><dd>{{ client_id }}</dd>
        <dt>Callback</dt><dd>{{ redirect_uri }}</dd>
        <dt>Scopes</dt><dd>{{ scopes | join(", ") if scopes else "None" }}</dd>
      </dl>
    </details>
  </main>
</body>
</html>
