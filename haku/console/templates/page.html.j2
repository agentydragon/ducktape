<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Haku — dashboard</title>
<style>
{{ css | safe }}
</style>
</head>
<body>
  <h1>Haku</h1>
  <p class="sub">Your value-ranked backlog · <a href="{{ intake_new }}">+ Add intake note</a></p>

  <h2>Up next</h2>
  {{ up_next_html | safe }}
  {{ backlog_html | safe }}

  <section class="feedback">
    <h2>Note to Haku</h2>
    <form method="post" action="/feedback">
      <textarea name="text" rows="3" placeholder="Anything for Haku to fold into its next run…" required></textarea>
      <button type="submit">Send to Haku</button>
    </form>
  </section>

  <footer class="page">
    {{ open_count }} open · {{ counts }}<br>
    Last scan: {{ scan_time }}
  </footer>
</body>
</html>
