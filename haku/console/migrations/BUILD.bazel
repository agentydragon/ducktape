load("//devinfra/python:defs.bzl", "py_test")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "files",
    srcs = [
        "env.py",
        "script.py.mako",
    ] + glob(["versions/**"]),
    visibility = ["//haku/console:__pkg__"],
)

py_test(
    name = "test_recall_index_schema",
    size = "medium",
    srcs = ["test_recall_index_schema.py"],
    requires_docker = True,
    deps = [
        "//:conftest",
        "//haku/console:conftest",
        "//haku/console:database_migrate",
        "//haku/recall_index:schema",
        "@pypi//alembic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)

py_test(
    name = "test_drop_mcp_operator_oauth",
    size = "medium",
    srcs = ["test_drop_mcp_operator_oauth.py"],
    requires_docker = True,
    deps = [
        "//:conftest",
        "//haku/console:conftest",
        "//haku/console:database_migrate",
        "//haku/console:database_schema",
        "//haku/console/oauth:provider_connection_registry",
        "//haku/console/oauth:token_state",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)
