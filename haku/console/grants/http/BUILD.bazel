load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//haku/console:__subpackages__"])

py_library(
    name = "models",
    srcs = ["models.py"],
    deps = [
        "//haku/console/grants:envelope",
        "@pypi//idna",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "repository",
    srcs = ["repository.py"],
    deps = [
        ":models",
        "//haku/console:database_schema",
        "//haku/console/grants:envelope",
        "//haku/console/grants:principal",
        "//haku/console/grants:provenance",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "service",
    srcs = ["service.py"],
    deps = [
        ":models",
        "//haku/console/grants:envelope",
        "//haku/console/grants:principal",
    ],
)

py_test(
    name = "test_service",
    srcs = ["test_service.py"],
    deps = [
        ":models",
        ":service",
        "//:conftest",
        "//haku/console:conftest",
        "//haku/console/grants:envelope",
        "//haku/console/grants:principal",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",  # keep: pytest plugin (auto async mode), not a direct import
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_repository",
    size = "medium",
    srcs = ["test_repository.py"],
    data = [
        "//third_party/containers:pgvector_pg18",
        "//third_party/containers:ryuk",
    ],
    requires_docker = True,
    deps = [
        ":models",
        ":repository",
        "//:conftest",
        "//haku/console:conftest",
        "//haku/console:database_schema",
        "//haku/console/grants:envelope",
        "//haku/console/grants:principal",
        "@pypi//fastapi",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)

py_test(
    name = "test_models",
    srcs = ["test_models.py"],
    deps = [
        ":models",
        "//:conftest",
        "//haku/console:conftest",
        "//haku/console/grants:envelope",
        "//haku/console/grants:principal",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
