load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//haku/console:__subpackages__"])

py_library(
    name = "principal",
    srcs = ["principal.py"],
    deps = [
        "//haku/console:tool_call_actor",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "envelope",
    srcs = ["envelope.py"],
    deps = [
        ":principal",
        "//util:sqlalchemy_types",
        "@pypi//pydantic",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "provenance",
    srcs = ["provenance.py"],
    deps = [
        ":envelope",
        ":principal",
        "//haku/console:database_schema",
        "//haku/console/identity:agent",
        "//haku/console/session:status",
        "@ducktape_haku//haku/console:tool_calls",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "catalog",
    srcs = ["catalog.py"],
    deps = [
        ":envelope",
        ":principal",
        "//haku/console:config",
        "//haku/console/grants/http:decide_config",
        "//haku/console/grants/http:models",
        "//haku/console/grants/http:service",
        "//haku/console/grants/kubernetes:authorization",
        "//haku/console/grants/kubernetes:models",
        "//haku/console/grants/kubernetes:service",
        "//haku/grants:authorization",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "routes",
    srcs = ["routes.py"],
    deps = [
        ":catalog",
        ":envelope",
        "//haku/console/identity:operator_agents",
        "//haku/console/identity:operator_auth",
        "@pypi//fastapi",
        "@pypi//pydantic",
    ],
)

py_test(
    name = "test_principal",
    srcs = ["test_principal.py"],
    deps = [
        ":principal",
        "//:conftest",
        "//haku/console:conftest",
        "//haku/console:tool_call_actor",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
