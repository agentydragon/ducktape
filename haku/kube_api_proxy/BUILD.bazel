load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

go_library(
    name = "kube_api_proxy",
    srcs = [
        "incluster.go",
        "proxy.go",
        "requestinfo.go",
        "scope.go",
    ],
    importpath = "github.com/agentydragon/ducktape/haku/kube_api_proxy",
    visibility = ["//visibility:public"],
    deps = [
        "@io_k8s_apimachinery//pkg/runtime",
        "@io_k8s_apimachinery//pkg/util/sets",
        "@io_k8s_apiserver//pkg/endpoints/request",
    ],
)

go_test(
    name = "kube_api_proxy_test",
    srcs = [
        "incluster_test.go",
        "proxy_test.go",
        "requestinfo_test.go",
        "scope_test.go",
    ],
    embed = [":kube_api_proxy"],
)

pkg_tar(
    name = "binary_layer",
    srcs = ["//haku/kube_api_proxy/cmd:haku-kube-api-proxy"],
    package_dir = "/usr/local/bin",
)

oci_image(
    name = "image",
    base = "@debian_trixie_slim_linux_amd64",
    entrypoint = ["/usr/local/bin/haku-kube-api-proxy"],
    env = {"SSL_CERT_FILE": "/etc/ssl/certs/ca-certificates.crt"},
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    # The rules_distroless Debian base contains loose CA files but no generated system bundle.
    # Go's HTTPS client therefore cannot authenticate Console without the shared cacerts layer.
    tars = [
        "//third_party/debian_slim:cacerts",
        ":binary_layer",
    ],
    user = "1000:1000",
    visibility = ["//visibility:public"],
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["haku-kube-api-proxy:latest"],
)
