module(
    name = "ducktape_haku",
    version = "0.1.0",
)

# Haku's shared browser/TS libraries, packaged as a standalone Bazel module so both the
# ducktape monorepo and the separate haku-state repo consume them from one source of truth.
# Consumed in-repo via the root MODULE.bazel local_path_override; consumed by haku-state via
# git_override + strip_prefix ("haku/js") against the Forgejo ducktape mirror.
#
# Packages:
#   - bridge_protocol (@haku/console-bridge): the console↔iframe postMessage bridge — shared
#     wire types (protocol.ts) + client helpers (client.ts).
#
# Zero npm deps: js_library + npm_package only copy files (nothing runs node), so
# aspect_rules_js alone suffices — no node toolchain, no pnpm/npm lock.
bazel_dep(name = "aspect_rules_js", version = "2.9.2")
