load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

# Gazelle manages llm_html/ subpackage

filegroup(
    name = "content_files",
    srcs = [
        "base.html.j2",
        "coding.md",
        "index.md",
        "stats.html.j2",
        "style.css",
        "tana.md",
        "verify.html.j2",
    ],
    visibility = ["//llm/html:__subpackages__"],
)

# --- OCI Image ---

pkg_tar(
    name = "content_tar",
    srcs = [":content_files"],
    package_dir = "/app/content",
)

pkg_tar(
    name = "server_tar",
    srcs = ["//llm/html/llm_html:server"],
    include_runfiles = True,
    package_dir = "/app",
    strip_prefix = ".",
)

oci_image(
    name = "image",
    base = "@distroless_cc_linux_amd64",
    entrypoint = ["/app/server"],
    env = {
        "CONTENT_DIR": "/app/content",
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONUNBUFFERED": "1",
    },
    exposed_ports = ["9000/tcp"],
    tars = [
        ":content_tar",
        ":server_tar",
    ],
    workdir = "/app",
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["llm-html:latest"],
)
