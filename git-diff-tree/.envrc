source_up

export UV_PROJECT_ENVIRONMENT="$PWD/.devenv/state/venv"
export VIRTUAL_ENV="$UV_PROJECT_ENVIRONMENT"
PATH_add "$VIRTUAL_ENV/bin"
PATH_add "$PWD/scripts"

# Keep devenv state inside repo so Codex sandbox can write to it
export DEVENV_DOTFILE="$PWD/.devenv"
export DEVENV_STATE="$DEVENV_DOTFILE/state"
export DEVENV_RUNTIME="$DEVENV_DOTFILE/runtime"

eval "$(devenv direnvrc)"
use devenv
