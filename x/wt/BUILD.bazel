load("//devinfra/python:defs.bzl", "py_binary", "py_library")

py_library(
    name = "cli",
    srcs = ["cli.py"],
    visibility = ["//visibility:public"],
    deps = [
        "//util:logging",
        "//util:typer",
        "//x/wt/client:cd_utils",
        "//x/wt/client:handlers",
        "//x/wt/client:view_formatter",
        "//x/wt/client:wt_client",
        "//x/wt/shared:configuration",
        "//x/wt/shared:constants",
        "@pypi//click",
        "@pypi//colorama",
        "@pypi//typer",
    ],
)

py_binary(
    name = "wt_cli",
    main_module = "x.wt.cli",
    visibility = ["//visibility:public"],
    deps = [
        ":cli",
        # The client spawns the daemon as `python -m x.wt.server.wt_server` in this binary's own venv.
        "//x/wt/server:wt_server",
    ],
)
