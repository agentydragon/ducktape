load("//devinfra/python:defs.bzl", "py_library")

package(default_visibility = ["//x/wt:__subpackages__"])

py_library(
    name = "config_file",
    srcs = ["config_file.py"],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "configuration",
    srcs = ["configuration.py"],
    deps = [
        ":config_file",
        ":env",
        "@pypi//click",
        "@pypi//pydantic",
        "@pypi//pyyaml",
    ],
)

py_library(
    name = "constants",
    srcs = ["constants.py"],
)

py_library(
    name = "env",
    srcs = ["env.py"],
)

py_library(
    name = "error_handling",
    srcs = ["error_handling.py"],
    deps = [
        ":constants",
        ":github_models",
    ],
)

py_library(
    name = "fixtures",
    srcs = ["fixtures.py"],
    deps = [
        ":configuration",
        ":github_models",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "git_utils",
    srcs = ["git_utils.py"],
)

py_library(
    name = "github_models",
    srcs = ["github_models.py"],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "protocol",
    srcs = ["protocol.py"],
    deps = [
        ":github_models",
        "@pypi//pydantic",
    ],
)
