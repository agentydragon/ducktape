load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

py_library(
    name = "models",
    srcs = ["models.py"],
    visibility = ["//visibility:public"],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "database",
    srcs = ["database.py"],
    visibility = ["//visibility:public"],
    deps = ["@pypi//sqlalchemy"],
)

py_library(
    name = "restic",
    srcs = ["restic.py"],
    visibility = ["//visibility:public"],
)

py_library(
    name = "queries",
    srcs = ["queries.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":database",
        ":models",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "ingest",
    srcs = ["ingest.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":database",
        ":models",
        ":restic",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "archive",
    deps = [
        ":database",
        ":ingest",
        ":models",
        ":queries",
        ":restic",
    ],
    visibility = ["//visibility:public"],
)

py_binary(
    name = "ingest_cli",
    data = ["//third_party/restic:restic"],
    main_module = "x.ai_session_archive.cli",
    visibility = ["//visibility:public"],
    deps = [":archive"],
)

py_test(
    name = "test_ingest",
    srcs = ["test_ingest.py"],
    data = ["//third_party/restic:restic"],
    requires_docker = True,
    deps = [
        ":archive",
        "//util/testing:postgres",
        "//util/testing:postgres_fixtures",
        "@pypi//psycopg",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
        "@pypi//testcontainers",
    ],
)
