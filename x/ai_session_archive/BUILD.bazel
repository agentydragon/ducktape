load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

py_library(
    name = "models",
    srcs = ["models.py"],
    visibility = ["//visibility:public"],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "database",
    srcs = ["database.py"],
    visibility = ["//visibility:public"],
    deps = [
        "@pypi//psycopg",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "restic",
    srcs = ["restic.py"],
    visibility = ["//visibility:public"],
)

py_library(
    name = "queries",
    srcs = ["queries.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":database",
        ":models",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "ingest",
    srcs = ["ingest.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":database",
        ":models",
        ":restic",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "cli",
    srcs = ["cli.py"],
    deps = [
        ":database",
        ":ingest",
        ":models",
        ":restic",
    ],
)

py_binary(
    name = "ingest_cli",
    data = ["//third_party/restic"],
    main_module = "x.ai_session_archive.cli",
    visibility = ["//visibility:public"],
    deps = [":cli"],
)

py_test(
    name = "test_ingest",
    srcs = ["test_ingest.py"],
    args = ["-k=real_restic_import_retains_every_changed_and_deleted_version"],
    data = ["//third_party/restic"],
    requires_docker = True,
    deps = [
        ":database",
        ":ingest",
        ":models",
        ":queries",
        ":restic",
        "//:conftest",
        "//util/testing:postgres",
        "//util/testing:postgres_fixtures",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)

py_test(
    name = "test_ingest_unit",
    srcs = ["test_ingest.py"],
    args = ["-k=unit_"],
    data = ["//third_party/restic"],
    main = "test_ingest.py",
    deps = [
        ":database",
        ":ingest",
        ":models",
        ":queries",
        ":restic",
        "//:conftest",
        "//util/testing:postgres",
        "//util/testing:postgres_fixtures",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)


