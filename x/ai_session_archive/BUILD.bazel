load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

py_library(
    name = "models",
    srcs = ["models.py"],
    visibility = ["//visibility:public"],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "database",
    srcs = ["database.py"],
    visibility = ["//visibility:public"],
    deps = [
        "@pypi//psycopg",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "restic",
    srcs = ["restic.py"],
    visibility = ["//visibility:public"],
)

py_library(
    name = "queries",
    srcs = ["queries.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":database",
        ":models",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "ingest",
    srcs = ["ingest.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":database",
        ":models",
        ":restic",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "cli",
    srcs = ["cli.py"],
    deps = [
        ":database",
        ":ingest",
        ":models",
        ":restic",
    ],
)

py_binary(
    name = "ingest_cli",
    data = ["//third_party/restic"],
    main_module = "x.ai_session_archive.cli",
    visibility = ["//visibility:public"],
    deps = [":cli"],
)

py_library(
    name = "testing",
    testonly = True,
    srcs = ["testing.py"],
    deps = [
        ":database",
        ":restic",
        "//util/testing:postgres",
        "@pypi//pytest",
        "@pypi//sqlalchemy",
    ],
)

py_test(
    name = "test_ingest",
    srcs = ["test_ingest.py"],
    deps = [
        ":ingest",
        ":models",
        ":restic",
        "//:conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)

