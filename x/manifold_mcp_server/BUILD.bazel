"""Sidecar image for the Manifold Markets MCP server.

Runs the stdio-only bmorphism/manifold-mcp-server npm package wrapped as a
Streamable HTTP endpoint via supergateway, listening on localhost:8080/mcp.
The mcp-oauth-facade container in the same pod connects to it as an
HttpUpstream (no stdio across container boundaries).
"""

load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_image_layer")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")

# Target platform for the OCI image — js_image_layer materializes the right
# native binaries from node_modules for this platform.
platform(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

js_binary(
    name = "bridge",
    data = [
        "//:node_modules/manifold-mcp-server",
        "//:node_modules/supergateway",
    ],
    entry_point = "bridge.mjs",
    visibility = ["//visibility:private"],
)

js_image_layer(
    name = "bridge_layers",
    binary = ":bridge",
    platform = ":linux_amd64",
    root = "/app",
)

oci_image(
    name = "image",
    base = "@node_20_bookworm_slim_linux_amd64",
    entrypoint = ["/app/x/manifold_mcp_server/bridge"],
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [":bridge_layers"],
    visibility = ["//visibility:public"],
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["manifold-mcp-server:latest"],
)
