# gazelle:ignore
load("//devinfra/python:defs.bzl", "py_binary", "py_library")

# Experimental LLM RL scripts - not a proper package, just standalone scripts
py_library(
    name = "cotrl",
    srcs = [
        "analyze_trajectories.py",
        "llm_rl_experiment.py",
        "llm_rl_quick_test.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@pypi//pydantic",
    ],
)

py_binary(
    name = "llm_rl_experiment",
    srcs = ["llm_rl_experiment.py"],
    deps = [
        ":cotrl",
        "@pypi//aiofiles",
    ],
)

py_binary(
    name = "analyze_trajectories",
    srcs = ["analyze_trajectories.py"],
    deps = [":cotrl"],
)
