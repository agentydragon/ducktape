load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

py_library(
    name = "offline_bootstrap",
    srcs = ["offline_bootstrap.py"],
)

py_binary(
    name = "offline_exec",
    srcs = ["offline_exec.py"],
    data = ["offline_bootstrap.py"],
    deps = ["@rules_python//python/runfiles"],
)

py_library(
    name = "frozen_inputs",
    srcs = ["frozen_inputs.py"],
)

py_binary(
    name = "run_ollama_cohort",
    srcs = ["run_ollama_cohort.py"],
    deps = [":frozen_inputs"],
)

py_binary(
    name = "run_openai_compat_cohort",
    srcs = ["run_openai_compat_cohort.py"],
    deps = [":frozen_inputs"],
)

py_binary(
    name = "sample_ollama_memory",
    srcs = ["sample_ollama_memory.py"],
)

py_binary(
    name = "probe_openai_tool_calls",
    srcs = ["probe_openai_tool_calls.py"],
)

py_binary(
    name = "verify_generated_coding_task",
    srcs = ["verify_generated_coding_task.py"],
)

py_binary(
    name = "summarize_humaneval_plus",
    srcs = ["summarize_humaneval_plus.py"],
)

py_test(
    name = "test_frozen_inputs",
    srcs = ["test_frozen_inputs.py"],
    deps = [
        ":frozen_inputs",
        "//:conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

# These utilities use the separately pinned EvalPlus 0.3.1 runtime rather than
# adding its large and conflicting dependency graph to the repository-wide
# Bazel Python lock. Their source is shared here; the frozen input and lockfile
# remain with each experiment's records.
exports_files(
    [
        "prepare_evalplus.py",
        "score_humaneval_plus_cohort.py",
    ],
)
