load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

py_library(
    name = "compaction",
    srcs = ["compaction.py"],
    deps = [
        "//agent_core:events",
        "//agent_core:handler",
        "//agent_core:loop_control",
    ],
)

py_library(
    name = "cli",
    srcs = ["cli.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":compaction",
        ":config_loader",
        "//agent_core:agent",
        "//agent_core:handler",
        "//agent_core:loop_control",
        "//agent_core:mcp_provider",
        "//agent_core:transcript_handler",
        "//mcp_infra/compositor",
        "//mcp_infra/display:rich_display",
        "//openai_utils:client_factory",
        "//openai_utils:model",
        "//util:logging",
        "//util:typer",
        "@pypi//fastmcp_slim",
        "@pypi//rich",
        "@pypi//typer",
    ],
)

py_test(
    name = "test_compaction",
    srcs = ["test_compaction.py"],
    deps = [
        ":compaction",
        "//:conftest",
        "//agent_core:events",
        "//agent_core:loop_control",
        "@pypi//pytest_bazel",
    ],
)

py_binary(
    name = "adgn_agent",
    main_module = "x.agent_cli.cli",
    visibility = ["//visibility:public"],
    deps = [":cli"],
)

py_library(
    name = "config_loader",
    srcs = ["config_loader.py"],
    deps = ["@pypi//fastmcp_slim"],
)
