load("//devinfra/oci:defs.bzl", "oci_layout_rloc")
load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")
load("//devinfra/python:grpc.bzl", "py_grpc_library")
load("//props:oci.bzl", "py_image_entrypoint", "py_image_env")

package(default_visibility = ["//visibility:public"])

# The frontend generates its TypeScript from the same file (//x/agentplane/app/frontend:protocol_pb).
exports_files(["protocol.proto"])

# gazelle:resolve py x.agentplane.runner.protocol_pb2 //x/agentplane/runner:protocol_pb2
# gazelle:resolve py x.agentplane.runner.protocol_pb2_grpc //x/agentplane/runner:protocol_pb2_grpc

py_grpc_library(
    name = "protocol",
    proto = "protocol.proto",
)

py_binary(
    name = "main_bin",
    main_module = "x.agentplane.runner.main",
    deps = [":main"],
)

py_library(
