load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")
load("//devinfra/python:grpc.bzl", "py_grpc_library")

package(default_visibility = ["//visibility:public"])

# gazelle:resolve py x.agentplane.runner.protocol_pb2 //x/agentplane/runner:protocol_pb2
# gazelle:resolve py x.agentplane.runner.protocol_pb2_grpc //x/agentplane/runner:protocol_pb2_grpc

py_grpc_library(
    name = "protocol",
    proto = "protocol.proto",
)

py_binary(
    name = "main_bin",
    main_module = "x.agentplane.runner.main",
    deps = [":main"],
)

py_library(
    name = "adapter",
    srcs = ["adapter.py"],
)

py_library(
    name = "claude",
    srcs = ["claude.py"],
    deps = [
        ":adapter",
        ":config",
        ":session",
        "//x/agentplane/native/claude:blocks",
        "//x/agentplane/native/claude:driver",
        "//x/agentplane/native/claude:scenarios",
        "//x/agentplane/native/claude:wire",
        "//x/agentplane/runner:protocol_pb2",
        "@pypi//protobuf",
    ],
)

py_library(
    name = "client",
    srcs = ["client.py"],
    deps = [
        "//x/agentplane/runner:protocol_pb2",
        "//x/agentplane/runner:protocol_pb2_grpc",
        "@pypi//grpcio",
        "@pypi//protobuf",
    ],
)

py_library(
    name = "codex",
    srcs = ["codex.py"],
    deps = [
        ":adapter",
        ":config",
        ":session",
        "//x/agentplane/native/codex:driver",
        "//x/agentplane/native/codex:scenarios",
        "//x/agentplane/native/codex:wire",
        "//x/agentplane/runner:protocol_pb2",
        "@pypi//protobuf",
    ],
)

py_library(
    name = "config",
    srcs = ["config.py"],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    deps = [
        ":client",
        ":config",
        ":service",
        "//x/agentplane/harness_tests:scripted_upstream",
        "//x/agentplane/native:process",
        "//x/agentplane/runner:protocol_pb2",
        "//x/agentplane/runner/testing:claude_model",
        "//x/agentplane/runner/testing:codex_model",
        "//x/agentplane/runner/testing:launches",
        "//x/agentplane/runner/testing:scripted_model",
        "@pypi//grpcio",
        "@pypi//protobuf",
        "@pypi//pytest",
    ],
)

py_library(
    name = "event_log",
    srcs = ["event_log.py"],
    deps = [
        "//x/agentplane/runner:protocol_pb2",
        "@pypi//protobuf",
    ],
)

py_library(
    name = "harness_process",
    srcs = ["harness_process.py"],
)

py_library(
    name = "main",
    srcs = ["main.py"],
    deps = [
        ":config",
        ":service",
        "@pypi//typer",
    ],
)

py_library(
    name = "service",
    srcs = ["service.py"],
    deps = [
        ":adapter",
        ":claude",
        ":codex",
        ":config",
        ":session",
        ":store",
        "//x/agentplane/runner:protocol_pb2",
        "//x/agentplane/runner:protocol_pb2_grpc",
        "@pypi//grpcio",
        "@pypi//protobuf",
    ],
)

py_library(
    name = "session",
    srcs = ["session.py"],
    deps = [
        ":adapter",
        ":config",
        ":event_log",
        ":harness_process",
        ":store",
        "//x/agentplane/runner:protocol_pb2",
        "@pypi//protobuf",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "store",
    srcs = ["store.py"],
    deps = [
        "//x/agentplane/runner:protocol_pb2",
        "@pypi//protobuf",
        "@pypi//pydantic",
    ],
)

py_test(
    name = "test_attach",
    size = "large",
    srcs = ["test_attach.py"],
    data = [
        "@agentplane_codex_cli_linux_x64//:files",  # keep: the pinned native harnesses the runner drives
        "@claude_code_cli_linux_x64//:claude",  # keep: the pinned native harnesses the runner drives
    ],
    target_compatible_with = [
        # keep: the pinned native harnesses are Linux/x86_64 only.
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    deps = [
        ":client",
        ":conftest",
        "//:conftest",
        "//x/agentplane/runner:protocol_pb2",
        "//x/agentplane/runner/testing:events",
        "//x/agentplane/runner/testing:scripted_model",
        "@pypi//protobuf",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_restart",
    size = "large",
    srcs = ["test_restart.py"],
    data = [
        ":main_bin",  # keep: the runner as its own process, so a crash takes its harnesses with it
        "@agentplane_codex_cli_linux_x64//:files",  # keep: the pinned native harnesses the runner drives
        "@claude_code_cli_linux_x64//:claude",  # keep: the pinned native harnesses the runner drives
    ],
    target_compatible_with = [
        # keep: the pinned native harnesses are Linux/x86_64 only.
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    deps = [
        ":client",
        ":conftest",
        "//:conftest",
        "//x/agentplane/harness_tests:scripted_upstream",
        "//x/agentplane/runner:protocol_pb2",
        "//x/agentplane/runner/testing:events",
        "//x/agentplane/runner/testing:launches",
        "//x/agentplane/runner/testing:scripted_model",
        "@pypi//protobuf",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_turns",
    size = "large",
    srcs = ["test_turns.py"],
    data = [
        "@agentplane_codex_cli_linux_x64//:files",  # keep: the pinned native harnesses the runner drives
        "@claude_code_cli_linux_x64//:claude",  # keep: the pinned native harnesses the runner drives
    ],
    target_compatible_with = [
        # keep: the pinned native harnesses are Linux/x86_64 only.
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    deps = [
        ":client",
        ":conftest",
        "//:conftest",
        "//x/agentplane/runner:protocol_pb2",
        "//x/agentplane/runner/testing:events",
        "//x/agentplane/runner/testing:scripted_model",
        "@pypi//protobuf",
        "@pypi//pytest_bazel",
    ],
)
