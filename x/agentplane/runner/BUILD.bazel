load("@rules_python//python/entry_points:py_console_script_binary.bzl", "py_console_script_binary")
load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

# gazelle:resolve py x.agentplane.runner.protocol_pb2 //x/agentplane/runner:protocol_pb2
# gazelle:resolve py x.agentplane.runner.protocol_pb2_grpc //x/agentplane/runner:protocol_pb2_grpc

# grpcio-tools bundles protoc and the gRPC Python plugin, matched to the protobuf runtime in the
# lockfile; mypy-protobuf generates the .pyi for messages and for the servicer and stub.
py_binary(
    name = "protoc",
    main_module = "grpc_tools.protoc",
    tags = [
        "no-lint",
        "no-mypy",
    ],
    deps = ["@pypi//grpcio_tools"],
)

# The entry-point scripts rules_python generates are not ours to lint.
py_console_script_binary(
    name = "protoc_gen_mypy",
    pkg = "@pypi//mypy_protobuf",
    script = "protoc-gen-mypy",
    tags = [
        "no-lint",
        "no-mypy",
    ],
)

py_console_script_binary(
    name = "protoc_gen_mypy_grpc",
    pkg = "@pypi//mypy_protobuf",
    script = "protoc-gen-mypy_grpc",
    tags = [
        "no-lint",
        "no-mypy",
    ],
)

genrule(
    name = "protocol_codegen",
    srcs = ["protocol.proto"],
    outs = [
        "protocol_pb2.py",
        "protocol_pb2.pyi",
        "protocol_pb2_grpc.py",
        "protocol_pb2_grpc.pyi",
    ],
    cmd = " ".join([
        "$(execpath :protoc)",
        "-I.",
        "--plugin=protoc-gen-mypy=$(execpath :protoc_gen_mypy)",
        "--plugin=protoc-gen-mypy_grpc=$(execpath :protoc_gen_mypy_grpc)",
        "--python_out=$(BINDIR)",
        "--mypy_out=$(BINDIR)",
        "--grpc_python_out=$(BINDIR)",
        "--mypy_grpc_out=$(BINDIR)",
        "$(execpath protocol.proto)",
    ]),
    tools = [
        ":protoc",
        ":protoc_gen_mypy",
        ":protoc_gen_mypy_grpc",
    ],
)

# keep: generated by :protocol_codegen, so gazelle sees no source for it
py_library(
    name = "protocol_pb2",
    srcs = ["protocol_pb2.py"],
    pyi_srcs = ["protocol_pb2.pyi"],
    tags = [
        "no-lint",
        "no-mypy",
    ],
    deps = ["@pypi//protobuf"],
)

# keep: generated by :protocol_codegen, so gazelle sees no source for it
py_library(
    name = "protocol_pb2_grpc",
    srcs = ["protocol_pb2_grpc.py"],
    pyi_srcs = ["protocol_pb2_grpc.pyi"],
    tags = [
        "no-lint",
        "no-mypy",
    ],
    deps = [
        "//x/agentplane/runner:protocol_pb2",
        "@pypi//grpcio",
    ],
)

