load("@aspect_rules_py//py:defs.bzl", "py_image_layer", aspect_py_binary = "py_binary")
load("@rules_oci//oci:defs.bzl", "oci_image")
load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")
load("//props:oci.bzl", "py_image_entrypoint", "py_image_env")

package(default_visibility = ["//x/agentplane:__subpackages__"])

# gazelle:resolve py x.agentplane.runner.protocol_pb2 //x/agentplane/runner:protocol_pb2
# gazelle:resolve py x.agentplane.runner.protocol_pb2_grpc //x/agentplane/runner:protocol_pb2_grpc

py_binary(
    name = "main_bin",
    main_module = "x.agentplane.app.main",
    deps = [":main"],
)

py_binary(
    name = "export_schema_bin",
    main_module = "x.agentplane.app.export_schema",
    deps = [":export_schema"],
)

py_library(
    name = "api",
    srcs = ["api.py"],
    deps = [
        ":bridge",
        ":inventory",
        "//x/agentplane/runner:client",
        "@pypi//fastapi",
    ],
)

py_library(
    name = "inventory",
    srcs = ["inventory.py"],
    deps = [
        "//util:kubernetes",
        "@pypi//kubernetes_asyncio",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "main",
    srcs = ["main.py"],
    data = ["//x/agentplane/app/frontend:bundle"],  # keep: the SPA the server mounts
    deps = [
        ":api",
        ":bridge",
        ":inventory",
        "//util:kubernetes",
        "//util/bazel:runfiles",
        "@pypi//fastapi",
        "@pypi//kubernetes_asyncio",
        "@pypi//typer",
        "@pypi//uvicorn",
    ],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    deps = [
        ":bridge",
        ":inventory",
        "//x/agentplane/app/testing:kubernetes",
        "//x/agentplane/runner:conftest",
        "@pypi//pytest",
    ],
)

py_test(
    name = "test_api",
    srcs = ["test_api.py"],
    deps = [
        ":api",
        ":bridge",
        ":conftest",
        ":inventory",
        "//:conftest",
        "//x/agentplane/app/testing:kubernetes",
        "@pypi//fastapi",
        "@pypi//httpx",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_inventory",
    srcs = ["test_inventory.py"],
    deps = [
        ":conftest",
        ":inventory",
        "//:conftest",
        "//x/agentplane/app/testing:kubernetes",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "bridge",
    srcs = ["bridge.py"],
    deps = [
        ":inventory",
        "//x/agentplane/runner:client",
        "//x/agentplane/runner:protocol_pb2",
        "@pypi//fastapi",
        "@pypi//protobuf",
        "@pypi//pydantic",
    ],
)

py_test(
    name = "test_bridge",
    size = "large",
    srcs = ["test_bridge.py"],
    data = [
        "@agentplane_codex_cli_linux_x64//:files",  # keep: the pinned native harnesses the runner drives
        "@claude_code_cli_linux_x64//:claude",  # keep: the pinned native harnesses the runner drives
    ],
    target_compatible_with = [
        # keep: the pinned native harnesses are Linux/x86_64 only.
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    deps = [
        ":api",
        ":bridge",
        ":conftest",
        ":inventory",
        "//:conftest",
        "//x/agentplane/runner:conftest",
        "//x/agentplane/runner:protocol_pb2",
        "//x/agentplane/runner/testing:scripted_model",
        "@pypi//httpx",
        "@pypi//protobuf",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//tenacity",
        "@pypi//uvicorn",
    ],
)

py_library(
    name = "export_schema",
    srcs = ["export_schema.py"],
    deps = [
        ":api",
        ":bridge",
        ":inventory",
        ":proto_schema",
        "//x/agentplane/runner:protocol_pb2",
        "@pypi//protobuf",
    ],
)

py_library(
    name = "proto_schema",
    srcs = ["proto_schema.py"],
    deps = ["@pypi//protobuf"],
)

py_test(
    name = "test_proto_schema",
    srcs = ["test_proto_schema.py"],
    deps = [
        ":conftest",
        ":export_schema",
        ":proto_schema",
        "//:conftest",
        "//x/agentplane/runner:protocol_pb2",
        "@pypi//jsonschema",
        "@pypi//protobuf",
        "@pypi//pytest_bazel",
        "@pypi//referencing",
    ],
)

# The app image: the API, the bridge, and the bundled SPA it serves, on debian slim as user 1000.
# Published as agentplane-app (devinfra/ci/image_targets.json) and run by the Deployment in
# cluster/k8s/agentplane-staging.
aspect_py_binary(
    name = "app_image_bin",
    main = "main.py",
    deps = [":main"],
)

py_image_layer(
    name = "app_layers",
    binary = ":app_image_bin",
    group = "1000",
    owner = "1000",
)

oci_image(
    name = "image",
    base = "@debian_trixie_slim_linux_amd64",
    entrypoint = py_image_entrypoint("app_image_bin"),
    env = py_image_env(
        binary_name = "app_image_bin",
        extra_env = {"SSL_CERT_FILE": "/etc/ssl/certs/ca-certificates.crt"},
    ),
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [
        ":app_layers",
        "//third_party/debian_slim:cacerts",
    ],
    user = "1000:1000",
)
