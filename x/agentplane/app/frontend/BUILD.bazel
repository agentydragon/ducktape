load("@aspect_rules_ts//ts:defs.bzl", "ts_config")
load("@npm_ducktape//:vitest/package_json.bzl", vitest_bin = "bin")
load("//devinfra/js:openapi.bzl", "js_openapi_schema")
load("//devinfra/js:spa_bundle.bzl", "spa_bundle")
load("//devinfra/js:ts_library.bzl", "ts_library")

package(default_visibility = ["//x/agentplane:__subpackages__"])

TSCONFIG = ":tsconfig"

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
)

# TypeScript types from the app's OpenAPI document, which carries the inventory's models and the
# runner protocol's messages (published from protocol.proto by //x/agentplane/app:export_schema).
js_openapi_schema(
    name = "schema",
    generator = "//x/agentplane/app:export_schema_bin",
)

ts_library(
    name = "client",
    srcs = ["client.ts"],
    tsconfig = TSCONFIG,
    deps = [
        ":schema",
        "//:node_modules/openapi-fetch",
    ],
)

ts_library(
    name = "events",
    srcs = ["events.ts"],
    tsconfig = TSCONFIG,
    deps = [":client"],
)

ts_library(
    name = "events_test",
    srcs = ["events.test.ts"],
    tsconfig = TSCONFIG,
    deps = [
        ":client",
        ":events",
        "//:node_modules/vitest",
    ],
)

ts_library(
    name = "sandboxes",
    srcs = ["sandboxes.tsx"],
    tsconfig = TSCONFIG,
    deps = [
        ":client",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/react",
    ],
)

ts_library(
    name = "sandbox_page",
    srcs = ["sandbox_page.tsx"],
    tsconfig = TSCONFIG,
    deps = [
        ":client",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/react",
    ],
)

ts_library(
    name = "session",
    srcs = ["session.tsx"],
    tsconfig = TSCONFIG,
    deps = [
        ":client",
        ":events",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/react",
    ],
)

ts_library(
    name = "app",
    srcs = ["app.tsx"],
    tsconfig = TSCONFIG,
    deps = [
        ":sandbox_page",
        ":sandboxes",
        ":session",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//:node_modules/react-router",
    ],
)

ts_library(
    name = "main_lib",
    srcs = ["main.tsx"],
    tsconfig = TSCONFIG,
    deps = [
        ":app",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/@types/react-dom",
        "//:node_modules/react",
        "//:node_modules/react-dom",
    ],
)

# The served directory: index.html beside main.js and main.css, mounted by the app.
spa_bundle(
    name = "bundle",
    entry_point = "main.js",
    jsx = "automatic",
    deps = [":main_lib"],
)

vitest_bin.vitest_test(
    name = "vitest_test",
    args = ["run"],
    chdir = package_name(),
    data = [
        "vitest.config.ts",
        ":events_test",
        "//:node_modules/vitest",
    ],
)
