load("@aspect_rules_esbuild//esbuild:defs.bzl", "esbuild")
load("@aspect_rules_js//js:defs.bzl", "js_library", "js_test")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config")
load("@npm_ducktape//:vitest/package_json.bzl", vitest_bin = "bin")
load("//devinfra/js:openapi.bzl", "js_openapi_schema")
load("//devinfra/js:proto.bzl", "ts_proto_library")
load("//devinfra/js:spa_bundle.bzl", "spa_bundle")
load("//devinfra/js:ts_library.bzl", "ts_library")

package(default_visibility = ["//x/agentplane:__subpackages__"])

TSCONFIG = ":tsconfig"

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
)

# The runner protocol's messages, generated from protocol.proto itself: what the bridge's routes
# carry as proto-JSON, and what the session view folds.
ts_proto_library(
    name = "protocol_pb",
    proto = "//x/agentplane/runner:protocol.proto",
    tsconfig = TSCONFIG,
)

# TypeScript types from the app's OpenAPI document: the inventory's models and routes. The bridge's
# proto-JSON bodies are plain objects there; protocol_pb types them.
js_openapi_schema(
    name = "schema",
    generator = "//x/agentplane/app:export_schema_bin",
)

ts_library(
    name = "client",
    srcs = ["client.ts"],
    tsconfig = TSCONFIG,
    deps = [
        ":operator_login",
        ":protocol_pb",
        ":schema",
        "//:node_modules/@bufbuild/protobuf",
        "//:node_modules/openapi-fetch",
    ],
)

ts_library(
    name = "operator_login",
    srcs = ["operator_login.ts"],
    tsconfig = TSCONFIG,
)

ts_library(
    name = "live",
    srcs = ["live.tsx"],
    tsconfig = TSCONFIG,
    deps = [
        ":client",
        ":schema",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/react",
    ],
)

ts_library(
    name = "events",
    srcs = ["events.ts"],
    tsconfig = TSCONFIG,
    deps = [":protocol_pb"],
)

ts_library(
    name = "events_test",
    srcs = ["events.test.ts"],
    tsconfig = TSCONFIG,
    deps = [
        ":events",
        ":protocol_pb",
        "//:node_modules/@bufbuild/protobuf",
        "//:node_modules/vitest",
    ],
)

# The lifecycle controls both sandbox views share: suspend/resume, and delete with its confirmation.
ts_library(
    name = "lifecycle",
    srcs = [
        "lifecycle.tsx",
        # The ambient declaration for the @tabler/icons-react subpaths lifecycle.tsx imports; see
        # the note in the file itself.
        "tabler_icons.d.ts",
    ],
    tsconfig = TSCONFIG,
    deps = [
        ":client",
        "//:node_modules/@mantine/core",
        "//:node_modules/@tabler/icons-react",
        "//:node_modules/@types/react",
        "//:node_modules/react",
    ],
)

ts_library(
    name = "sandboxes",
    srcs = [
        "sandboxes.tsx",
        # Ambient module declarations for the @tabler/icons-react per-icon subpaths this file
        # imports. A declaration file is type-only, so it joins this target's program without
        # being emitted.
        "tabler_icons.d.ts",
    ],
    tsconfig = TSCONFIG,
    deps = [
        ":client",
        ":lifecycle",
        ":live",
        "//:node_modules/@mantine/core",
        "//:node_modules/@tabler/icons-react",
        "//:node_modules/@types/react",
        "//:node_modules/react",
    ],
)

ts_library(
    name = "egress",
    srcs = ["egress.tsx"],
    tsconfig = TSCONFIG,
    deps = [
        ":client",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//:node_modules/react-router",
    ],
)

ts_library(
    name = "sandbox_page",
    srcs = ["sandbox_page.tsx"],
    tsconfig = TSCONFIG,
    deps = [
        ":client",
        ":egress",
        ":lifecycle",
        ":live",
        ":protocol_pb",
        "//:node_modules/@bufbuild/protobuf",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//:node_modules/react-router",
    ],
)

ts_library(
    name = "markdown",
    srcs = ["markdown.tsx"],
    tsconfig = TSCONFIG,
    deps = [
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/dompurify",
        "//:node_modules/@types/react",
        "//:node_modules/dompurify",
        "//:node_modules/marked",
        "//:node_modules/react",
    ],
)

# frame.tsx imports this for the bundler; esbuild resolves it beside the emitted frame.js and folds
# it into the SPA's stylesheet, so it travels as a dep of the library that imports it.
js_library(
    name = "frame_css",
    srcs = ["frame.css"],
)

ts_library(
    name = "frame",
    srcs = [
        "frame.tsx",
        # `declare module "*.css"` for the stylesheet import above.
        "css.d.ts",
    ],
    tsconfig = TSCONFIG,
    deps = [
        ":frame_css",
        ":protocol_pb",
        "//:node_modules/@bufbuild/protobuf",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/dompurify",
        "//:node_modules/@types/react",
        "//:node_modules/dompurify",
        "//:node_modules/highlight.js",
        "//:node_modules/react",
    ],
)

# session.tsx imports this for the bundler, the way frame.tsx does its own stylesheet.
js_library(
    name = "session_css",
    srcs = ["session.css"],
)

ts_library(
    name = "session",
    srcs = [
        "session.tsx",
        # `declare module "*.css"` for the stylesheet import above.
        "css.d.ts",
        # The ambient declaration for the @tabler/icons-react subpaths session.tsx imports; see the
        # note in the file itself.
        "tabler_icons.d.ts",
    ],
    tsconfig = TSCONFIG,
    deps = [
        ":client",
        ":events",
        ":frame",
        ":markdown",
        ":protocol_pb",
        ":session_css",
        "//:node_modules/@bufbuild/protobuf",
        "//:node_modules/@mantine/core",
        "//:node_modules/@tabler/icons-react",
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//:node_modules/react-router",
    ],
)

ts_library(
    name = "app",
    srcs = ["app.tsx"],
    tsconfig = TSCONFIG,
    deps = [
        ":sandbox_page",
        ":sandboxes",
        ":session",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//:node_modules/react-router",
    ],
)

ts_library(
    name = "main_lib",
    srcs = ["main.tsx"],
    tsconfig = TSCONFIG,
    deps = [
        ":app",
        ":operator_login",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/@types/react-dom",
        "//:node_modules/react",
        "//:node_modules/react-dom",
    ],
)

# The served directory: index.html beside main.js and main.css, mounted by the app.
spa_bundle(
    name = "bundle",
    entry_point = "main.js",
    jsx = "automatic",
    deps = [":main_lib"],
)

vitest_bin.vitest_test(
    name = "vitest_test",
    args = ["run"],
    chdir = package_name(),
    data = [
        "vitest.config.ts",
        ":events_test",
        "//:node_modules/vitest",
    ],
)

# Visual render-health tests: the app mounted by visual/harness.tsx on canned inventory and runner
# events (fetch and EventSource stubbed, nothing on the network), one scenario per js_test, the
# PNG published for PR visual review on the shared //util/testing/frontend_visual machinery.
ts_library(
    name = "visual_harness_lib",
    srcs = [
        "visual/harness.tsx",
        "visual/network.ts",
    ],
    tsconfig = TSCONFIG,
    deps = [
        ":app",
        ":client",
        ":live",
        ":protocol_pb",
        "//:node_modules/@bufbuild/protobuf",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/@types/react-dom",
        "//:node_modules/react",
        "//:node_modules/react-dom",
    ],
)

# A classic script (iife) so visual/index.html loads it from file:// without module CORS.
esbuild(
    name = "visual_bundle",
    config = {"jsx": "automatic"},
    entry_point = "visual/harness.js",
    format = "iife",
    minify = False,
    output = "visual/bundle.js",
    output_css = "visual/bundle.css",
    platform = "browser",
    sourcemap = "linked",
    target = ["es2022"],
    deps = [":visual_harness_lib"],
)

# Single-file views so $(rootpath) resolves to one path each.
filegroup(
    name = "visual_bundle_js",
    srcs = ["visual/bundle.js"],
)

filegroup(
    name = "visual_bundle_css",
    srcs = ["visual/bundle.css"],
)

VISUAL_DATA = [
    "visual/index.html",
    ":visual_bundle_css",
    ":visual_bundle_js",
    "//util/testing/frontend_visual:fonts",
    "//util/testing/frontend_visual:fonts_conf",
    "//util/testing/frontend_visual:visual_test_lib",
    "@playwright_browsers//:chromium-headless-shell",
]

# medium: a scenario launches Chromium and mounts the unbundled app; alone on a worker it takes
# 30-40s, and under RBE contention a small test's 60s ran out in the harness's own five-second
# mount wait.
[
    js_test(
        name = "visual_%s" % scenario,
        size = "medium",
        data = VISUAL_DATA,
        entry_point = "visual/visual_test_%s.mjs" % scenario,
        env = {
            "HARNESS_PATH": "$(rootpath :visual_bundle_js)",
            "CHROMIUM_HEADLESS_SHELL": "$(rootpath @playwright_browsers//:chromium-headless-shell)",
            "FONTCONFIG_FILE": "$(rootpath //util/testing/frontend_visual:fonts_conf)",
            "FREETYPE_PROPERTIES": "cff:no-stem-darkening=1",
        },
        no_copy_to_bin = VISUAL_DATA,
    )
    for scenario in [
        "sandboxes",
        "sandboxes_stale",
        "sandbox",
        "sandbox_egress",
        "session",
        "session_raw",
        "session_reasoning",
        "sandboxes_phone",
        "sandbox_phone",
        "sandbox_egress_phone",
        "session_phone",
        "session_raw_phone",
        "session_reasoning_phone",
    ]
]
