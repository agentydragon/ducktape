load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_binary(
    name = "live_capture",
    main_module = "x.agentplane.capture.main",
    deps = [":main"],
)

py_library(
    name = "framing",
    srcs = ["framing.py"],
)

py_library(
    name = "llm_recording_proxy",
    srcs = ["llm_recording_proxy.py"],
    deps = [":records"],
)

py_library(
    name = "main",
    srcs = ["main.py"],
    deps = [
        ":codex_hook",
        ":llm_recording_proxy",
        ":records",
        "//x/agentplane/native:process",
        "//x/agentplane/native/claude:scenarios",
        "//x/agentplane/native/codex:scenarios",
    ],
)

py_library(
    name = "records",
    srcs = ["records.py"],
    deps = ["@pypi//pydantic"],
)

py_test(
    name = "test_framing",
    srcs = ["test_framing.py"],
    deps = [
        ":framing",
        "//:conftest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_llm_recording_proxy",
    srcs = ["test_llm_recording_proxy.py"],
    deps = [
        ":llm_recording_proxy",
        "//:conftest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "codex_hook",
    srcs = ["codex_hook.py"],
)
