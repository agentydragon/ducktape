load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//x/agentplane:__subpackages__"])

py_library(
    name = "blocks",
    srcs = ["blocks.py"],
    deps = [
        "//x/agentplane/native:tagged",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "driver",
    srcs = ["driver.py"],
    deps = [":wire"],
)

py_library(
    name = "scenarios",
    srcs = ["scenarios.py"],
    deps = [
        ":driver",
        ":wire",
        "//x/agentplane/native:process",
    ],
)

py_library(
    name = "wire",
    srcs = ["wire.py"],
    deps = [
        ":blocks",
        "//x/agentplane/native:omit_none",
        "//x/agentplane/native:tagged",
        "@pypi//pydantic",
    ],
)

py_test(
    name = "test_wire",
    srcs = ["test_wire.py"],
    deps = [
        ":blocks",
        ":driver",
        ":wire",
        "//:conftest",
        "@pypi//pytest_bazel",
    ],
)
