load("//devinfra/python:defs.bzl", "py_library")

package(default_visibility = ["//x/agentplane:__subpackages__"])

py_library(
    name = "binding",
    srcs = ["binding.py"],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "inventory",
    srcs = ["inventory.py"],
    deps = [
        ":binding",
        ":models",
        "//mcp_infra/exec:kubernetes",
        "//util:kubernetes",
        "//x/agentplane:subjects",
        "@pypi//kubernetes_asyncio",
    ],
)

py_library(
    name = "models",
    srcs = ["models.py"],
    deps = [
        "//mcp_infra/exec:models",
        "@pypi//pydantic",
    ],
)
