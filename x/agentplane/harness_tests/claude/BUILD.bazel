load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//x/agentplane:__subpackages__"])

py_library(
    name = "anthropic_sse",
    testonly = True,
    srcs = ["anthropic_sse.py"],
    deps = ["//x/agentplane/harness_tests:scripted_upstream"],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    deps = [
        ":harness",
        "//util/bazel:runfiles",
        "@pypi//pytest",
    ],
)

py_library(
    name = "frames",
    testonly = True,
    srcs = ["frames.py"],
    deps = [
        "//x/agentplane/native/claude:blocks",
        "//x/agentplane/native/claude:wire",
    ],
)

py_library(
    name = "harness",
    testonly = True,
    srcs = ["harness.py"],
    deps = [
        "//x/agentplane/harness_tests:scripted_upstream",
        "//x/agentplane/native:process",
        "//x/agentplane/native/claude:driver",
        "//x/agentplane/native/claude:scenarios",
        "//x/agentplane/native/claude:wire",
    ],
)

py_library(
    name = "requests",
    testonly = True,
    srcs = ["requests.py"],
    deps = [
        "//x/agentplane/harness_tests:scripted_upstream",
        "//x/agentplane/native/claude:blocks",
        "@pypi//pydantic",
    ],
)

py_test(
    name = "test_active_turn",
    size = "medium",
    srcs = ["test_active_turn.py"],
    data = ["@claude_code_cli_linux_x64//:claude"],  # keep: the pinned native harness the test drives
    target_compatible_with = [
        # keep: the pinned native harnesses are Linux/x86_64 only.
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    deps = [
        ":anthropic_sse",
        ":conftest",
        ":frames",
        ":harness",
        ":requests",
        "//:conftest",
        "//x/agentplane/harness_tests:conftest",
        "//x/agentplane/harness_tests:scripted_upstream",
        "//x/agentplane/native/claude:scenarios",
        "@pypi//pytest_bazel",
    ],
)

