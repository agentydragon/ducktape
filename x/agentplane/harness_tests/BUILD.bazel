load("//devinfra/python:defs.bzl", "py_library")

package(
    default_testonly = True,
    default_visibility = ["//x/agentplane:__subpackages__"],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    deps = [
        "//util/testing:undeclared_outputs",
        "@pypi//pytest",
    ],
)

py_library(
    name = "model_endpoint",
    srcs = ["model_endpoint.py"],
    deps = [
        "@pypi//aiohttp",
        "@pypi//pydantic",
    ],
)

test_suite(
    name = "harness_tests",
    tests = [
        "//x/agentplane/harness_tests/claude:test_active_turn",
        "//x/agentplane/harness_tests/claude:test_connection_loss",
        "//x/agentplane/harness_tests/claude:test_tools",
        "//x/agentplane/harness_tests/claude:test_turns",
        "//x/agentplane/harness_tests/codex:test_active_turn",
        "//x/agentplane/harness_tests/codex:test_connection_loss",
        "//x/agentplane/harness_tests/codex:test_tools",
        "//x/agentplane/harness_tests/codex:test_turns",
    ],
)
