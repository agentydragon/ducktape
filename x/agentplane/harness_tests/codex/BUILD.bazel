load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(
    default_testonly = True,
    default_visibility = ["//x/agentplane:__subpackages__"],
)

py_library(
    name = "responses_sse",
    srcs = ["responses_sse.py"],
    deps = ["//x/agentplane/harness_tests:model_endpoint"],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    deps = [
        ":harness",
        ":responses",
        "//util/bazel:runfiles",
        "@pypi//pytest",
    ],
)

py_library(
    name = "responses",
    srcs = ["responses.py"],
    deps = [
        ":requests",
        "//x/agentplane/harness_tests:model_endpoint",
    ],
)

py_library(
    name = "frames",
    srcs = ["frames.py"],
    deps = ["//x/agentplane/native/codex:wire"],
)

py_library(
    name = "harness",
    srcs = ["harness.py"],
    deps = [
        ":responses",
        "//x/agentplane/native/codex:async_run",
        "//x/agentplane/native/codex:dynamic_tools",
        "//x/agentplane/native/codex:scenarios",
    ],
)

py_library(
    name = "requests",
    srcs = ["requests.py"],
    deps = [
        "@pypi//pydantic",
    ],
)

py_test(
    name = "test_active_turn",
    size = "medium",
    srcs = ["test_active_turn.py"],
    data = ["@agentplane_codex_cli_linux_x64//:files"],  # keep: the pinned native harness the test drives
    target_compatible_with = [
        # keep: the pinned native harnesses are Linux/x86_64 only.
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    deps = [
        ":conftest",
        ":frames",
        ":harness",
        ":responses",
        ":responses_sse",
        "//:conftest",
        "//x/agentplane/harness_tests:conftest",
        "//x/agentplane/native/codex:wire",
        "@pypi//pytest_bazel",
    ],
)

