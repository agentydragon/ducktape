py_library(
    name = "main",
    srcs = ["main.py"],
    deps = [
        ":api",
        ":auth",
        ":catalog",
        ":db",
        ":fixture_policy",
        ":operator_oidc",
        ":runtime",
        ":service",
        "//x/agentplane/sandbox_auth:http",
