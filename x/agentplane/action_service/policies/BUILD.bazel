load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//x/agentplane:__subpackages__"])

py_library(
    name = "argument_schema",
    srcs = ["argument_schema.py"],
    deps = [
        ":kind",
        "//x/agentplane/action_service:catalog",
        "//x/agentplane/action_service:models",
        "@pypi//jsonschema",
        "@pypi//pydantic",
        "@pypi//referencing",
    ],
)

py_library(
    name = "exact_actions",
    srcs = ["exact_actions.py"],
    deps = [
        ":kind",
        "//x/agentplane/action_service:catalog",
        "//x/agentplane/action_service:models",
    ],
)

py_library(
    name = "kind",
    srcs = ["kind.py"],
    deps = [
        "//x/agentplane/action_service:catalog",
        "//x/agentplane/action_service:models",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "registry",
    srcs = ["registry.py"],
    deps = [
        ":argument_schema",
        ":exact_actions",
        ":github_public_repository",
        ":github_repository",
        ":kind",
        "//github_policy:visibility",
        "//x/agentplane/action_service:catalog",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "resources",
    srcs = ["resources.py"],
    visibility = [
        "//cluster/validation:__pkg__",
        "//x/agentplane:__subpackages__",
    ],
    deps = [
        ":kind",
        ":registry",
        "//x/agentplane/action_service:models",
        "@pypi//pydantic",
    ],
)

