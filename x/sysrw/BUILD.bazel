# This tree deliberately uses the slim dist; the manifest maps `typer` to the fat one.
# gazelle:resolve py typer @pypi//typer_slim
"""System rewriter package."""

load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

# Subdirectories (anthropic/, templates/, tools/) have their own BUILD files

py_test(
    name = "test_templates_conformance",
    srcs = ["test_templates_conformance.py"],
    deps = [
        ":conftest",
        "//:conftest",
        "//x/sysrw/templates:loader",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_loader_min",
    srcs = ["test_loader_min.py"],
    data = glob(["testdata/*.jsonl"]),
    deps = [
        ":conftest",
        ":run_eval",
        ":schemas",
        "//:conftest",
        "@pypi//pyhamcrest",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",  # keep
        "@pypi//pytest_bazel",
    ],
)

