load("@aspect_rules_py//py:defs.bzl", "py_image_layer", aspect_py_binary = "py_binary")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")
load("//props:oci.bzl", "py_image_entrypoint", "py_image_env")

# ── Build-time spec fixup ────────────────────────────────────────────────────

py_library(
    name = "fix_openapi_spec_lib",
    srcs = ["fix_openapi_spec.py"],
)

py_binary(
    name = "fix_openapi_spec",
    main_module = "x.grocy_mcp.fix_openapi_spec",
    deps = [":fix_openapi_spec_lib"],
)

genrule(
    name = "grocy_openapi_fixed",
    srcs = ["@grocy_openapi_spec//file"],
    outs = ["grocy.openapi.fixed.json"],
    cmd = "$(execpath :fix_openapi_spec) $(SRCS) $@",
    tools = [":fix_openapi_spec"],
)

# ── Libraries ────────────────────────────────────────────────────────────────

py_library(
    name = "grocy_types",
    srcs = ["grocy_types.py"],
    visibility = ["//visibility:public"],
)

py_library(
    name = "mcp_types",
    srcs = ["mcp_types.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":grocy_types",
        "//mcp_infra/authentik_auth:auth",
        "@pypi//pydantic",
        "@pypi//pydantic_settings",
    ],
)

py_library(
    name = "resolver",
    srcs = ["resolver.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":grocy_types",
        "@pypi//httpx",
    ],
)

py_library(
    name = "batch_tools",
    srcs = ["batch_tools.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":grocy_types",
        ":mcp_types",
        ":resolver",
        "@pypi//fastmcp",
        "@pypi//httpx",
        "@pypi//pydantic",
        "@pypi//tenacity",
    ],
)

py_library(
    name = "server",
    srcs = ["server.py"],
    data = [
        "server_instructions.md",
        ":grocy_openapi_fixed",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":batch_tools",
        ":mcp_types",
        ":tool_metadata",
        "//mcp_infra/authentik_auth:auth",
        "//mcp_infra/authentik_auth:store",
        "//util/bazel:runfiles",
        "@pypi//fastmcp",
        "@pypi//httpx",
        "@pypi//pydantic",
        "@pypi//uvicorn",
    ],
)

py_binary(
    name = "server_cli",
    main_module = "x.grocy_mcp.server",
    deps = [":server"],
)

