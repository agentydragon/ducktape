load("@aspect_rules_py//py:defs.bzl", "py_image_layer", aspect_py_binary = "py_binary")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")
load("//props:oci.bzl", "py_image_entrypoint", "py_image_env")

# ── Build-time spec fixup ────────────────────────────────────────────────────

py_library(
    name = "fix_openapi_spec_lib",
    srcs = ["fix_openapi_spec.py"],
)

py_binary(
    name = "fix_openapi_spec",
    main_module = "x.grocy_mcp.fix_openapi_spec",
    deps = [":fix_openapi_spec_lib"],
)

genrule(
    name = "grocy_openapi_fixed",
    srcs = ["@grocy_openapi_spec//file"],
    outs = ["grocy.openapi.fixed.json"],
    cmd = "$(execpath :fix_openapi_spec) $(SRCS) $@",
    tools = [":fix_openapi_spec"],
)

# ── Libraries ────────────────────────────────────────────────────────────────

py_library(
    name = "config",
    srcs = ["config.py"],
    visibility = ["//visibility:public"],
    deps = [
        "@pypi//pydantic",
        "@pypi//pydantic_settings",
    ],
)

py_library(
    name = "auth",
    srcs = ["auth.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":config",
        "@pypi//fastmcp",
        "@pypi//httpx",
    ],
)

py_library(
    name = "tool_metadata",
    srcs = ["tool_metadata.py"],
    visibility = ["//visibility:public"],
)

py_library(
    name = "batch_tools",
    srcs = ["batch_tools.py"],
    visibility = ["//visibility:public"],
    deps = [
        "@pypi//fastmcp",
        "@pypi//httpx",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "server",
    srcs = ["server.py"],
    data = [":grocy_openapi_fixed"],
    visibility = ["//visibility:public"],
    deps = [
        ":auth",
        ":batch_tools",
        ":config",
        ":tool_metadata",
        "//util/bazel:runfiles",
        "@pypi//fastmcp",
        "@pypi//httpx",
        "@pypi//uvicorn",
    ],
)

py_binary(
    name = "server_cli",
    main_module = "x.grocy_mcp.server",
    deps = [":server"],
)

# ── Tests ────────────────────────────────────────────────────────────────────

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    deps = [
        "@pypi//pytest",
        "@pypi//pytest_asyncio",
    ],
)

py_test(
    name = "test_config",
    srcs = ["test_config.py"],
    deps = [
        ":config",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_server",
    srcs = ["test_server.py"],
    deps = [
        ":config",
        ":server",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_fix_openapi_spec",
    srcs = ["test_fix_openapi_spec.py"],
    deps = [
        ":fix_openapi_spec_lib",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_dump_tool",
    srcs = ["test_dump_tool.py"],
    deps = [
        ":config",
        ":conftest",
        ":server",
        "//util/testing:undeclared_outputs",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_e2e",
    size = "medium",
    srcs = ["test_e2e.py"],
    data = [
        "//third_party/containers:grocy",
    ],
    requires_docker = True,
    deps = [
        ":config",
        ":conftest",
        ":server",
        ":tool_metadata",
        "//third_party/containers:rlocations",
        "//util:oci",
        "//util/testing:container_logs",
        "@pypi//fastmcp",
        "@pypi//httpx",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",
        "@pypi//pytest_bazel",
        "@pypi//testcontainers",
    ],
)

# ── OCI image ────────────────────────────────────────────────────────────────

aspect_py_binary(
    name = "server_bin",
    main = "server.py",
    deps = [":server"],
)

py_image_layer(
    name = "server_layers",
    binary = ":server_bin",
    group = "1000",
    owner = "1000",
)

oci_image(
    name = "server_image",
    base = "@debian_slim_linux_amd64",
    entrypoint = py_image_entrypoint("server_bin"),
    env = py_image_env(binary_name = "server_bin"),
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [":server_layers"],
    user = "1000:1000",
    visibility = ["//visibility:public"],
)

oci_load(
    name = "server_load",
    image = ":server_image",
    repo_tags = ["grocy-mcp:latest"],
)
