"""Python detectors package — entry points and shared infrastructure."""

load("//devinfra/python:defs.bzl", "py_binary", "py_library")

py_library(
    name = "main",
    srcs = ["main.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":registry",
        "//x/py_detectors/rules:broad_except_order",
        "//x/py_detectors/rules:dynamic_attr_probe",
        "//x/py_detectors/rules:flatten_nested_guards",
        "//x/py_detectors/rules:import_aliasing",
        "//x/py_detectors/rules:imports_inside_def",
        "//x/py_detectors/rules:magic_tuple_indices",
        "//x/py_detectors/rules:optional_string_simplify",
        "//x/py_detectors/rules:pathlike_str_casts",
        "//x/py_detectors/rules:pydantic_v1_shims",
        "//x/py_detectors/rules:swallow_errors",
        "//x/py_detectors/rules:trivial_alias",
        "//x/py_detectors/rules:trivial_passthrough",
        "//x/py_detectors/rules:walrus_suggest",
    ],
)

py_library(
    name = "models",
    srcs = ["models.py"],
    visibility = ["//:__subpackages__"],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "registry",
    srcs = ["registry.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":models",
        ":utils",
    ],
)

py_library(
    name = "import_graph",
    srcs = ["import_graph.py"],
    visibility = ["//:__subpackages__"],
)

py_library(
    name = "utils",
    srcs = ["utils.py"],
    visibility = ["//:__subpackages__"],
)

py_binary(
    name = "py_detectors_cli",
    main_module = "x.py_detectors.main",
    visibility = ["//:__subpackages__"],
    deps = [":main"],
)
