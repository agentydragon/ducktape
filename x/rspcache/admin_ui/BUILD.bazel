load("@aspect_rules_js//js:defs.bzl", "js_library")
load("//devinfra/js:spa_bundle.bzl", "spa_bundle")

# React + Mantine deps live in the root package.json (this workspace member has
# none of its own), so libraries reference `//:node_modules/*`.

js_library(
    name = "app",
    srcs = ["src/App.tsx"],
    deps = [
        "//:node_modules/@mantine/core",
        "//:node_modules/@tabler/icons-react",
        "//:node_modules/@uiw/react-json-view",
        "//:node_modules/react",
    ],
)

js_library(
    name = "main",
    srcs = [
        "src/index.css",
        "src/main.tsx",
    ],
    deps = [
        ":app",
        "//:node_modules/@mantine/core",
        "//:node_modules/react",
        "//:node_modules/react-dom",
    ],
)

spa_bundle(
    name = "bundle",
    entry_point = "src/main.tsx",
    jsx = "automatic",
    visibility = ["//x/rspcache:__pkg__"],
    deps = [":main"],
)
