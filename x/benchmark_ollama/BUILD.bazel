load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

py_library(
    name = "benchmark_ollama",
    srcs = ["benchmark_ollama.py"],
    deps = [
        "//devinfra/bazel:workspace",
        "@pypi//openai",
    ],
)

py_binary(
    name = "benchmark_ollama_bin",
    main_module = "x.benchmark_ollama.benchmark_ollama",
    tags = [
        "bench",
        "manual",
    ],
    deps = [":benchmark_ollama"],
)

sh_test(
    name = "test_cli",
    srcs = ["test_cli.sh"],
    args = ["$(rlocationpath :benchmark_ollama_bin)"],
    data = [":benchmark_ollama_bin"],
    use_bash_launcher = True,
)

py_test(
    name = "test_benchmark_ollama",
    srcs = ["test_benchmark_ollama.py"],
    deps = [
        ":benchmark_ollama",
        "//:conftest",
        "@pypi//openai",
        "@pypi//pytest",
    ],
)
