load("//devinfra/python:defs.bzl", "py_library")

package(default_visibility = ["//x/inop:__subpackages__"])

py_library(
    name = "truncation_utils",
    testonly = True,
    srcs = ["truncation_utils.py"],
    deps = [
        "//x/inop:config",
        "//x/inop/engine:models",
        "@pypi//tiktoken",
    ],
)

py_library(
    name = "pe_controller",
    testonly = True,
    srcs = ["pe_controller.py"],
    deps = [
        "//agent_core:handler",
        "//agent_core:loop_control",
    ],
)

py_library(
    name = "prompt_engineer",
    testonly = True,
    srcs = ["prompt_engineer.py"],
    deps = [
        "//x/inop/engine:models",
        "//x/inop/io:logging_utils",
    ],
)

py_library(
    name = "summarizer",
    testonly = True,
    srcs = ["summarizer.py"],
    deps = [
        ":prompt_engineer",
        ":truncation_utils",
        "//openai_utils:model",
        "//openai_utils:model_metadata",
        "//openai_utils:text_extraction",
        "//x/inop/engine:models",
        "//x/inop/io:logging_utils",
    ],
)
