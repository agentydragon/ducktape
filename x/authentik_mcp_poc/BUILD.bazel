load("@aspect_rules_py//py:defs.bzl", "py_image_layer", aspect_py_binary = "py_binary")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")
load("//props:oci.bzl", "py_image_entrypoint", "py_image_env")

py_library(
    name = "config",
    srcs = ["config.py"],
    visibility = ["//visibility:public"],
    deps = [
        "@pypi//pydantic",
        "@pypi//pydantic_settings",
    ],
)

py_library(
    name = "backend",
    srcs = ["backend.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":config",
        "@pypi//fastapi",
        "@pypi//uvicorn",
    ],
)

py_library(
    name = "server",
    srcs = ["server.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":config",
        "@pypi//fastmcp",
        "@pypi//httpx",
        "@pypi//uvicorn",
    ],
)

py_binary(
    name = "server_cli",
    main_module = "x.authentik_mcp_poc.server",
    deps = [":server"],
)

py_binary(
    name = "backend_cli",
    main_module = "x.authentik_mcp_poc.backend",
    deps = [":backend"],
)

# ── Tests ─────────────────────────────────────────────────────────────────────

py_test(
    name = "test_backend",
    srcs = ["test_backend.py"],
    deps = [
        ":backend",
        "@pypi//fastapi",
        "@pypi//httpx",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_config",
    srcs = ["test_config.py"],
    deps = [
        ":config",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

# ── OCI images ────────────────────────────────────────────────────────────────
# Two separate images: one for the MCP server, one for the whoami backend.

aspect_py_binary(
    name = "server_bin",
    main = "server.py",
    deps = [":server"],
)

py_image_layer(
    name = "server_layers",
    binary = ":server_bin",
    group = "1000",
    owner = "1000",
)

oci_image(
    name = "server_image",
    base = "@debian_slim_linux_amd64",
    entrypoint = py_image_entrypoint("server_bin"),
    env = py_image_env(binary_name = "server_bin"),
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tags = ["ghcr_push"],
    tars = [":server_layers"],
    user = "1000:1000",
    visibility = ["//visibility:public"],
)

oci_load(
    name = "server_load",
    image = ":server_image",
    repo_tags = ["authentik-mcp-poc-server:latest"],
)

aspect_py_binary(
    name = "backend_bin",
    main = "backend.py",
    deps = [":backend"],
)

py_image_layer(
    name = "backend_layers",
    binary = ":backend_bin",
    group = "1000",
    owner = "1000",
)

oci_image(
    name = "backend_image",
    base = "@debian_slim_linux_amd64",
    entrypoint = py_image_entrypoint("backend_bin"),
    env = py_image_env(binary_name = "backend_bin"),
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tags = ["ghcr_push"],
    tars = [":backend_layers"],
    user = "1000:1000",
    visibility = ["//visibility:public"],
)

oci_load(
    name = "backend_load",
    image = ":backend_image",
    repo_tags = ["authentik-mcp-poc-backend:latest"],
)
