"""Agent server package - root modules, binaries, and OCI image."""

load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("//devinfra/oci:defs.bzl", "oci_layout_rloc")
load("//props:oci.bzl", "py_image_entrypoint", "py_image_env")

exports_files(["conftest.py"])

# Shared test fixtures for agent_server tests (requires Docker)
# Subdirectory tests can depend on this to get access to conftest fixtures
py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    imports = ["../.."],
    visibility = ["//x/agent_server:__subpackages__"],
    deps = [
        ":approvals",
        "//agent_core/testing:fixtures",
        "//agent_core/testing:responses",
        "//agent_core/testing/mcp:fixtures",
        "//agent_core/testing/mcp:responses",
        "//mcp_infra:mcp_types",
        "//mcp_infra:naming",
        "//mcp_infra:prefix",
        "//mcp_infra/compositor",
        "//mcp_infra/testing:fixtures",
        "//openai_utils/testing:fixtures",
        "//third_party/containers:fixtures",
        "//util:oci",
        "//x/agent_server/mcp/approval_policy:engine",
        "//x/agent_server/persist:sqlite",
        "//x/agent_server/persist:types",
        "//x/agent_server/policies:approve_all",
        "//x/agent_server/policies:loader",
        "//x/agent_server/policies:policy_types",
        "//x/agent_server/policy_eval:container",
        "//x/agent_server/runtime:container",
        "@pypi//docker",
        "@pypi//fastmcp",
        "@pypi//pytest",
    ],
)

# Root-level modules that don't belong in subdirectories
# Split to break circular dependency: persist needs agent_types, presets needs persist

py_library(
    name = "agent_types",
    srcs = ["agent_types.py"],
    imports = ["../.."],
    visibility = ["//x/agent_server:__subpackages__"],
    deps = ["@pypi//pydantic"],
)

# --- Binaries ---
# Each binary depends only on what it actually uses

py_binary(
    name = "adgn_agent_serve",
    srcs = ["cli.py"],
    main = "cli.py",
    visibility = ["//:__subpackages__"],
    deps = [
        "//mcp_infra:config_loader",
        "//util:logging",
        "//util:net",
        "//util:typer",
        "//x/agent_server/mcp_bridge:auth",
        "//x/agent_server/server:app",
        "@pypi//more_itertools",
        "@pypi//typer_slim",
        "@pypi//uvicorn",
    ],
)

py_binary(
    name = "agent_server_matrix_bot",
    main_module = "x.agent_server.matrix_bot",
    deps = [":matrix_bot"],
)

py_library(
    name = "web_api_constants",
    srcs = ["web_api_constants.py"],
    imports = ["../.."],
    visibility = ["//x/agent_server:__subpackages__"],
    deps = [
        "//mcp_infra/compositor:resources_server",
        "//mcp_infra/exec:docker",
        "//x/agent_server/mcp/approval_policy:engine",
    ],
)

py_library(
    name = "generate_frontend_code",
    srcs = ["generate_frontend_code.py"],
    imports = ["../.."],
    visibility = ["//x/agent_server:__subpackages__"],
    deps = [
        ":approvals",
        "//agent_core:events",
        "//x/agent_server/mcp_bridge:agents",
        "//x/agent_server/persist:types",
        "//x/agent_server/server:protocol",
        "@pypi//pydantic",
    ],
)

py_binary(
    name = "generate_frontend_code_bin",
    imports = ["../.."],
    main_module = "x.agent_server.generate_frontend_code",
    visibility = ["//x/agent_server/web:__pkg__"],
    deps = [":generate_frontend_code"],
)

# E2E tests moved to agent_server/e2e/BUILD.bazel

# --- OCI Runtime Image ---

oci_image(
    name = "image",
    base = "@debian_slim_linux_amd64",
    entrypoint = py_image_entrypoint(
        "shim_bin",
        binary_package = "x/agent_server/policy_eval",
    ),
    env = py_image_env(
        "shim_bin",
        binary_package = "x/agent_server/policy_eval",
    ),
    tars = ["//x/agent_server/policy_eval:layers"],
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["adgn-runtime:latest"],
    visibility = ["//x/agent_server:__subpackages__"],
)

oci_layout_rloc(
    name = "image_info",
    image = ":image",
    visibility = ["//x/agent_server:__subpackages__"],
)

py_library(
    name = "approvals",
    srcs = ["approvals.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//x/agent_server/policies:default_policy",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "logging_config",
    srcs = ["logging_config.py"],
    visibility = ["//:__subpackages__"],
    deps = ["//agent_core:logging_utils"],
)

py_library(
    name = "matrix_bot",
    srcs = ["matrix_bot.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":logging_config",
        "//agent_core:agent",
        "//agent_core:loop_control",
        "//agent_core:mcp_provider",
        "//mcp_infra:config_loader",
        "//mcp_infra:mounted",
        "//mcp_infra:prefix",
        "//mcp_infra/compositor",
        "//mcp_infra/compositor:notifications_buffer",
        "//mcp_infra/display:event_renderer",
        "//mcp_infra/enhanced:server",
        "//mcp_infra/exec:docker",
        "//mcp_infra/exec:docker_types",
        "//mcp_infra/exec:models",
        "//openai_utils:client_factory",
        "//openai_utils:model",
        "//x/agent_server/server:bus",
        "//x/agent_server/server:mode_handler",
        "@pypi//aiodocker",
        "@pypi//fastmcp",
        "@pypi//pydantic",
        "@pypi//typer_slim",
    ],
)

py_library(
    name = "presets",
    srcs = ["presets.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":agent_types",
        "//x/agent_server/persist:sqlite",
        "//x/agent_server/persist:types",
        "@pypi//fastmcp",
        "@pypi//platformdirs",
        "@pypi//pydantic",
        "@pypi//pyyaml",
    ],
)
