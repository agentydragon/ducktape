"""MCP Bridge - two-compositor architecture for agent-MCP integration."""

load("@rules_python//python:defs.bzl", "py_library")
load("//devinfra/testing:defs.bzl", "py_test")

py_test(
    name = "test_agents_server",
    srcs = ["test_agents_server.py"],
    imports = ["../../.."],
    deps = [
        ":agents",
        "//mcp_infra:resource_utils",
        "//x/agent_server:conftest",
        "//x/agent_server/persist:types",
        "@pypi//fastmcp",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",  # keep
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_integration",
    srcs = ["test_integration.py"],
    data = ["//third_party/containers:debian_slim"],
    imports = ["../../.."],
    requires_docker = True,
    deps = [
        ":agents",
        ":auth",
        ":registry",
        "//x/agent_server:conftest",
        "@pypi//fastmcp",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",  # keep
        "@pypi//pytest_bazel",
        "@pypi//starlette",
    ],
)

