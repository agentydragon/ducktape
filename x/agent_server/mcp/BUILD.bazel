"""MCP servers - standalone server modules and cross-cutting tests."""

load("//devinfra/python:defs.bzl", "py_library", "py_test")

py_library(
    name = "matrix_server",
    srcs = ["matrix_server.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//mcp_infra:flat_tool",
        "//mcp_infra/enhanced:server",
        "//openai_utils:pydantic_strict_mode",
        "//x/agent_server/server:bus",
        "@pypi//aiohttp",
        "@pypi//fastmcp_slim",
        "@pypi//mautrix",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    visibility = ["//x/agent_server/mcp:__subpackages__"],
    deps = [
        "//mcp_infra/testing:fixtures",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",
    ],
)

py_test(
    name = "test_notifications_envelope",
    srcs = ["test_notifications_envelope.py"],
    deps = [
        ":conftest",
        "//mcp_infra:naming",
        "//mcp_infra:prefix",
        "//mcp_infra/compositor:notifications_buffer",
        "//mcp_infra/enhanced:server",
        "//mcp_infra/testing:notifications",
        "//mcp_infra/testing:stdio_notifier_lib",
        "//x/agent_server/notifications",
        "@pypi//fastmcp_slim",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",  # keep
        "@pypi//pytest_bazel",
    ],
)
