"""Runtime package - container lifecycle and agent registry."""

load("@rules_python//python:defs.bzl", "py_library")
load("//devinfra/testing:defs.bzl", "py_test")

# Utility modules with minimal dependencies - can be imported by persist
py_library(
    name = "images",
    srcs = ["images.py"],
    imports = ["../../.."],
    visibility = ["//x/agent_server:__subpackages__"],
)

py_library(
    name = "auto_attach",
    srcs = ["auto_attach.py"],
    imports = ["../../.."],
    visibility = ["//x/agent_server:__subpackages__"],
    deps = ["@pypi//fastmcp"],
)

py_library(
    name = "container",
    srcs = ["container.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":handlers",
        ":images",
        "//agent_core:agent",
        "//agent_core:loop_control",
        "//agent_core:mcp_provider",
        "//mcp_infra:mounted",
        "//mcp_infra:prefix",
        "//mcp_infra:snapshots",
        "//mcp_infra/compositor",
        "//mcp_infra/compositor:clients",
        "//mcp_infra/compositor:notifications_buffer",
        "//mcp_infra/enhanced:server",
        "//mcp_infra/exec:docker",
        "//openai_utils:client_factory",
        "//openai_utils:model",
        "//x/agent_server:agent_types",
        "//x/agent_server:approvals",
        "//x/agent_server:presets",
        "//x/agent_server/mcp/approval_policy:engine",
        "//x/agent_server/mcp/chat",
        "//x/agent_server/mcp/loop",
        "//x/agent_server/mcp/runtime:mcp_runtime",
        "//x/agent_server/mcp/ui",
        "//x/agent_server/persist:handler",
        "//x/agent_server/persist:sqlite",
        "//x/agent_server/persist:types",
        "//x/agent_server/server:bus",
        "//x/agent_server/server:runtime",
        "//x/agent_server/server:system_message",
        "@pypi//aiodocker",
        "@pypi//fastmcp",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "handlers",
    srcs = ["handlers.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//agent_core:handler",
        "//mcp_infra/compositor",
        "//mcp_infra/display:event_renderer",
        "//mcp_infra/notifications:types",
        "//x/agent_server:agent_types",
        "//x/agent_server/notifications",
        "//x/agent_server/persist:handler",
        "//x/agent_server/persist:types",
        "//x/agent_server/server:bus",
        "//x/agent_server/server:mode_handler",
        "//x/agent_server/server:runtime",
    ],
)

py_library(
    name = "registry",
    srcs = ["registry.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":container",
        "//openai_utils:model",
        "//x/agent_server/persist:sqlite",
        "@pypi//aiodocker",
        "@pypi//fastmcp",
    ],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    imports = ["../../.."],
    visibility = ["//x/agent_server/runtime:__subpackages__"],
    deps = [
        "@pypi//pytest",
    ],
)

py_test(
    name = "test_notifications_handler",
    size = "medium",
    srcs = ["test_notifications_handler.py"],
    data = [
        "//third_party/containers:debian_slim",
        "//x/agent_server:image_info",
    ],
    imports = ["../../.."],
    requires_docker = True,
    tags = ["manual"],
    deps = [
        ":conftest",
        "//agent_core/testing/mcp:responses",
        "//mcp_infra:constants",
        "//openai_utils:model",
        "//x/agent_server:conftest",
        "//x/agent_server/mcp/approval_policy:engine",
        "//x/agent_server/runtime:container",
        "@pypi//fastmcp",
        "@pypi//pyhamcrest",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",  # keep
        "@pypi//pytest_bazel",
    ],
)
