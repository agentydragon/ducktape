load("@aspect_rules_ts//ts:defs.bzl", "ts_config")
load("//devinfra/js:spa_bundle.bzl", "spa_bundle")
load("//devinfra/js:ts_library.bzl", "ts_library")

package(
    default_testonly = True,
    default_visibility = ["//x/agentplane_sync:__pkg__"],
)

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
)

ts_library(
    name = "main",
    srcs = ["main.tsx"],
    tsconfig = ":tsconfig",
    deps = [
        "//:node_modules/@electric-sql/client",
        "//:node_modules/@tanstack/electric-db-collection",
        "//:node_modules/@tanstack/react-db",
        "//:node_modules/@types/react",
        "//:node_modules/@types/react-dom",
        "//:node_modules/react",
        "//:node_modules/react-dom",
        "//:node_modules/zod",
    ],
)

spa_bundle(
    name = "bundle",
    entry_point = "main.tsx",
    index_html = "index.html",
    jsx = "automatic",
    deps = [
        ":main",
        "//:node_modules/@electric-sql/client",
        "//:node_modules/@tanstack/electric-db-collection",
        "//:node_modules/@tanstack/react-db",
        "//:node_modules/react",
        "//:node_modules/react-dom",
        "//:node_modules/zod",
    ],
)
