# Inherit nix devShell from repo root.
source_up

# python-build-standalone (used by uv) bundles its own ld-linux, bypassing
# nix-ld. Explicitly expose nix-ld's libraries and NVIDIA driver libs so
# native extensions find libstdc++, libcuda, etc.
export LD_LIBRARY_PATH="/run/opengl-driver/lib:${NIX_LD_LIBRARY_PATH}${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# Triton calls /sbin/ldconfig to find libcuda, which doesn't exist on NixOS.
# Point it directly to the NVIDIA driver libs instead.
export TRITON_LIBCUDA_PATH=/run/opengl-driver/lib
