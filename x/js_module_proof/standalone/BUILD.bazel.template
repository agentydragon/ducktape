load("@aspect_rules_js//js:defs.bzl", "js_test")

js_test(
    name = "end_to_end_test",
    data = [
        "Bindings.lean",
        "Combined.lean",
        "Counter.lean",
        "Effects.lean",
        "Semantics.lean",
        "bindings.mjs",
        "checker.mjs",
        "combined.mjs",
        "effects.mjs",
        "main.mjs",
        "@acorn_dist//:dist/acorn.js",
        "@lean_dist//:lean_bin",
        "@lean_dist//:runtime",
    ] + glob(["example/**"]),
    entry_point = "end_to_end_test.mjs",
    env = {
        "ACORN_RLOCATION": "$(rlocationpath @acorn_dist//:dist/acorn.js)",
        "LEAN_RLOCATION": "$(rlocationpath @lean_dist//:lean_bin)",
    },
    no_copy_to_bin = [
        "@acorn_dist//:dist/acorn.js",
        "@lean_dist//:lean_bin",
        "@lean_dist//:runtime",
    ],
)

