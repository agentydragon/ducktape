load("//devinfra/python:defs.bzl", "py_binary", "py_library")

py_library(
    name = "models",
    srcs = ["models.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "@pypi//pydantic",
    ],
)

py_library(
    name = "loaders",
    srcs = ["loaders.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":models",
    ],
)

py_library(
    name = "matcher",
    srcs = ["matcher.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":models",
    ],
)

py_library(
    name = "main_lib",
    srcs = ["main.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":loaders",
        ":matcher",
        ":models",
    ],
)

py_library(
    name = "pdf_utils",
    srcs = ["pdf_utils.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "@pypi//more_itertools",
    ],
)

py_library(
    name = "extract_pdfs_lib",
    srcs = ["extract_pdfs.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":models",
        ":pdf_utils",
        "@pypi//httpx",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "parse_eob_listing_lib",
    srcs = ["parse_eob_listing.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "@pypi//beautifulsoup4",
        "@pypi//lxml",
    ],
)

py_binary(
    name = "parse_eob_listing",
    main_module = "x.eob_matching.parse_eob_listing",
    visibility = ["//visibility:public"],
    deps = [":parse_eob_listing_lib"],
)

py_binary(
    name = "eob_matching",
    main_module = "x.eob_matching.main",
    visibility = ["//visibility:public"],
    deps = [":main_lib"],
)

py_binary(
    name = "extract_pdfs",
    main_module = "x.eob_matching.extract_pdfs",
    visibility = ["//visibility:public"],
    deps = [":extract_pdfs_lib"],
)

py_library(
    name = "eval_extraction_lib",
    srcs = ["eval_extraction.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":extract_pdfs_lib",
        ":models",
        ":pdf_utils",
        "@pypi//pydantic",
    ],
)

py_binary(
    name = "eval_extraction",
    main_module = "x.eob_matching.eval_extraction",
    visibility = ["//visibility:public"],
    deps = [":eval_extraction_lib"],
)
