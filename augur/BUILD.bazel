load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "dates",
    srcs = ["dates.py"],
    imports = [".."],
)

py_test(
    name = "dates_test",
    srcs = ["dates_test.py"],
    deps = [
        ":dates",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "dev_server_lib",
    srcs = ["dev_server.py"],
    deps = [
        "//augur/api:config",
        "//augur/api:server_lib",
        "//augur/calibration:manifold",
        "//util/bazel:runfiles",
        "@pypi//fastapi",
    ],
)

py_binary(
    name = "dev",
    data = [
        "//augur/api:public_fixture_calibration_catalog",
        "//augur/api:public_fixture_config",
        "//augur/api:public_fixture_properties",
        "//augur/frontend:bundle_base",
    ],
    env = {
        "AUGUR_BUNDLE_INDEX_RUNFILE": "_main/augur/frontend/dist/index.html",
        "AUGUR_CONFIG_PATH": "$(location //augur/api:public_fixture_config)",
    },
    main_module = "augur.dev_server",
    deps = [":dev_server_lib"],
)

py_test(
    name = "browser_shell_test",
    size = "large",
    srcs = ["browser_shell_test.py"],
    data = [
        ":dev",
        "//augur/api:public_fixture_calibration_catalog",
        "//augur/api:public_fixture_config",
        "//augur/api:public_fixture_properties",
        "@playwright_browsers//:chromium-headless-shell",
    ],
    env = {
        "AUGUR_BUNDLE_INDEX_RUNFILE": "_main/augur/frontend/dist/index.html",
        "CHROMIUM_HEADLESS_SHELL": "$(rootpath @playwright_browsers//:chromium-headless-shell)",
    },
    deps = [
        "//util:net",
        "//util:playwright",
        "//util/bazel:runfiles",
        "//util/testing:undeclared_outputs",
        "@pypi//playwright",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "frames",
    srcs = ["frames.py"],
    deps = [
        "@pypi//polars",
    ],
)

py_test(
    name = "visual_test",
    size = "large",
    srcs = ["visual_test.py"],
    data = [
        "//augur/api:public_fixture_calibration_catalog",
        "//augur/api:public_fixture_config",
        "//augur/api:public_fixture_properties",
        "//augur/frontend:bundle_base",
        "//augur/frontend:visual_golden_snapshots",
        "//util/testing/frontend_visual:fonts",
        "//util/testing/frontend_visual:fonts_conf",
        "@playwright_browsers//:chromium-headless-shell",
    ],
    env = {
        "AUGUR_BUNDLE_INDEX_RUNFILE": "_main/augur/frontend/dist/index.html",
        "CHROMIUM_HEADLESS_SHELL": "$(rootpath @playwright_browsers//:chromium-headless-shell)",
        "FONTCONFIG_FILE": "$(rootpath //util/testing/frontend_visual:fonts_conf)",
        "FREETYPE_PROPERTIES": "cff:no-stem-darkening=1",
    },
    deps = [
        ":dev_server_lib",
        "//augur/api:config",
        "//augur/calibration:catalog",
        "//augur/calibration:testing",
        "//util:net",
        "//util:playwright",
        "//util/bazel:runfiles",
        "//util/testing:frontend_visual",
        "//util/testing:png_diff",
        "//util/testing:undeclared_outputs",
        "@pypi//playwright",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//uvicorn",
    ],
)
