load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "projection_py",
    srcs = ["projection.py"],
    deps = [
        "//augur/api:schemas_py",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "projection_service_py",
    srcs = ["projection_service.py"],
    deps = [
        ":projection_py",
        "//augur/api:config_py",
        "//augur/api:scenario_set_py",
        "//augur/api:schemas_py",
        "//augur/model:exogenous_py",
        "//augur/model:series_py",
        "//augur/sim:external_series",
        "//augur/sim:projections",
        "//augur/sim:run",
        "//augur/sim:scenario",
        "//augur/sim:simulate",
        "@pypi//numpy",
        "@pypi//polars",
    ],
)

py_library(
    name = "portfolio_py",
    srcs = ["portfolio.py"],
    deps = [
        "//augur/api:finance_py",
        "//augur/api:portfolio_py",
        "//augur/api:schemas_py",
        "@pypi//pydantic",
    ],
)

py_test(
    name = "portfolio_test",
    srcs = ["portfolio_test.py"],
    deps = [
        ":portfolio_py",
        "//augur/api:finance_py",
        "//augur/api:portfolio_py",
        "@pypi//pytest_bazel",
    ],
)

PROJECTION_SERVICE_TEST_DEPS = [
    ":projection_py",
    ":projection_service_py",
    "//augur/api:config_py",
    "//augur/model:exogenous_py",
    "//augur/model:simple_exogenous_py",
    "//util/bazel:runfiles",
    "@pypi//pytest_bazel",
]

py_test(
    name = "projection_service_test",
    srcs = ["projection_service_test.py"],
    data = ["//augur/api:public_fixture_config"],
    deps = PROJECTION_SERVICE_TEST_DEPS,
)

py_test(
    name = "projection_service_numba_test",
    size = "medium",
    srcs = ["projection_service_test.py"],
    data = ["//augur/api:public_fixture_config"],
    env = {"AUGUR_SIM_ENGINE": "numba"},
    main = "projection_service_test.py",
    deps = PROJECTION_SERVICE_TEST_DEPS,
)
