load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "wire",
    srcs = ["wire.py"],
    deps = [
        "//augur/api:schemas",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "scenarios",
    srcs = ["scenarios.py"],
    deps = [
        ":asset_key",
        ":wire",
        "//augur/api:bootstrap",
        "//augur/api:config",
        "//augur/api:portfolio",
        "//augur/model:series",
        "//augur/sim:locations",
        "//augur/sim:pricing",
        "//augur/sim:scenario",
        "@pypi//more_itertools",
    ],
)

py_library(
    name = "decode",
    srcs = ["decode.py"],
    deps = [
        ":asset_key",
        ":wire",
        "//augur/model:series",
        "//augur/sim:codec",
        "//augur/sim:engine",
        "//augur/sim:scenario",
        "@pypi//numpy",
        "@pypi//polars",
    ],
)

py_library(
    name = "service",
    srcs = ["service.py"],
    deps = [
        ":decode",
        ":scenarios",
        ":wire",
        "//augur/api:bootstrap",
        "//augur/api:portfolio",
        "//augur/api:schemas",
        "//augur/model:exogenous",
        "//augur/sim:codec",
        "//augur/sim:external_series",
        "//augur/sim:locations",
        "//augur/sim:simulate",
        "//augur/sim:slice",
        "@pypi//numpy",
    ],
)

py_library(
    name = "portfolio",
    srcs = ["portfolio.py"],
    deps = [
        "//augur/api:finance",
        "//augur/api:portfolio",
        "//augur/api:schemas",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "testing",
    testonly = True,
    srcs = ["testing.py"],
    deps = [
        "//augur/model:series",
        "//augur/model:testing",
    ],
)

py_test(
    name = "portfolio_test",
    srcs = ["portfolio_test.py"],
    deps = [
        ":portfolio",
        "//:conftest",
        "//augur/api:finance",
        "//augur/api:portfolio",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "service_test",
    size = "medium",
    srcs = ["service_test.py"],
    data = [
        "//augur/api:public_fixture_config",
        "//augur/api:public_fixture_properties",
    ],
    deps = [
        ":decode",
        ":scenarios",
        ":service",
        ":testing",
        ":wire",
        "//:conftest",
        "//augur/api:catalog",
        "//augur/api:config",
        "//augur/model:exogenous",
        "//augur/model:exogenous_provider_config",
        "//augur/model:independent",
        "//augur/model:series",
        "//augur/model:testing",
        "//augur/sim:external_series",
        "//augur/sim:scenario",
        "//augur/sim:simulate",
        "//util/bazel:runfiles",
        "@pypi//more_itertools",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "asset_key",
    srcs = ["asset_key.py"],
    deps = [
        "//augur/model:schemas",
        "//augur/model:series",
        "@pypi//pydantic",
    ],
)
