py_library(
    name = "server_lib",
    srcs = ["server.py"],
    deps = [
        ":bootstrap",
        ":calibration_wire",
        ":casing",
        ":catalog",
        ":config",
        ":deployment",
        ":schemas",
        "//augur/calibration",
        "//augur/calibration:catalog",
        "//augur/calibration:manifold",
        "//augur/model:exogenous",
        "//augur/model:sample_sanity",
        "//augur/model:series",
        "//augur/product:portfolio",
        "//augur/product:scenarios",
        "//augur/product:service",
        "//augur/product:wire",
        "@pypi//fastapi",
        "@pypi//pydantic",
        "@pypi//pyyaml",
        "@pypi//types_pyyaml",
        "@pypi//uvicorn",
    ],
)

py_binary(
    name = "server",
    main_module = "augur.api.server",
    deps = [":server_lib"],
)

py_binary(
    name = "profile_metric_fan",
    srcs = ["profile_metric_fan.py"],
    data = [
        ":public_fixture_config",
        ":public_fixture_properties",
    ],
    main_module = "augur.api.profile_metric_fan",
    deps = [
        ":catalog",
        ":config",
        "//augur/model:exogenous",
        "//augur/product:scenarios",
        "//augur/product:service",
        "//augur/product:wire",
        "//util/bazel:runfiles",
    ],
)

aspect_py_binary(
    name = "server_image_binary",
    srcs = ["server.py"],
    main = "server.py",
    deps = [
        ":server_lib",
        "@pypi//fastapi",
        "@pypi//more_itertools",
        "@pypi//pyyaml",
        "@pypi//types_pyyaml",
        "@pypi//uvicorn",
    ],
)

py_image_layer(
    name = "server_image_layers",
    binary = ":server_image_binary",
)

oci_image(
    name = "image",
    base = "@debian_slim_linux_amd64",
    cmd = [
        "--host",
        "0.0.0.0",
        "--port",
        "8080",
        "--api-only",
    ],
    entrypoint = py_image_entrypoint("server_image_binary"),
    env = py_image_env(
        binary_name = "server_image_binary",
        extra_env = {
            "HOME": "/tmp",
            "MPLCONFIGDIR": "/tmp/matplotlib",
            "PYTHONSAFEPATH": "1",
            "RULES_PYTHON_EXTRACT_ROOT": "/tmp/rules_python",
            "XDG_CACHE_HOME": "/tmp/cache",
        },
    ),
    exposed_ports = ["8080/tcp"],
    labels = {
        "org.opencontainers.image.source": "https://github.com/agentydragon/ducktape",
        "org.opencontainers.image.title": "augur",
    },
    tars = [
        ":server_image_layers",
        "//augur/fit/calibrated:trained_vecm_image_layer",
    ],
)

oci_load(
    name = "image_load",
    image = ":image",
    repo_tags = ["augur:dev"],
)

py_library(
    name = "export_schema",
    srcs = ["export_schema.py"],
    deps = [
        ":bootstrap",
        ":config",
        ":finance",
        ":local_regulation",
        ":server_lib",
        "//augur/model:independent",
    ],
)

py_binary(
    name = "export_schema_bin",
    main_module = "augur.api.export_schema",
    deps = [":export_schema"],
)

py_test(
    name = "export_schema_test",
    srcs = ["test_export_schema.py"],
    # Source follows the test_<module>.py convention while the target keeps the
    # conventional <name>_test label, so the inferred main wouldn't match srcs.
    main = "test_export_schema.py",
    deps = [
        ":export_schema",
        "@pypi//pytest_bazel",
    ],
)

filegroup(
    name = "public_fixture_config",
    srcs = ["testdata/config.yaml"],
)

filegroup(
    name = "public_fixture_properties",
    srcs = ["testdata/properties.json"],
)

# The public fixture config registers a calibration catalog at
# `../../calibration/example_openai_catalog.yaml`; anything that loads that config at
# startup (the server binary under test, the calibration endpoint test) needs the
# catalog in its runfiles at the resolved path.
filegroup(
    name = "public_fixture_calibration_catalog",
    srcs = ["//augur/calibration:example_openai_catalog"],
)
