py_test(
    name = "server_test",
    size = "medium",
    srcs = ["server_test.py"],
    data = [
        ":public_fixture_calibration_catalog",
        ":public_fixture_config",
        ":public_fixture_properties",
        ":server",
    ],
    deps = [
        ":config",
        ":server_lib",
        "//augur/model:series",
        "//augur/product:testing",
        "//util:net",
        "//util/bazel:runfiles",
        "//util/testing:undeclared_outputs",
        "@pypi//fastapi",
        "@pypi//httpx",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_calibration_endpoint",
    srcs = ["test_calibration_endpoint.py"],
    data = [
        ":public_fixture_calibration_catalog",
        ":public_fixture_config",
        ":public_fixture_properties",
    ],
    deps = [
        ":config",
        ":server_lib",
        "//augur/calibration:catalog",
        "//augur/calibration:testing",
        "//augur/model:sample_sanity",
        "//augur/model:series",
        "//util/bazel:runfiles",
