py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    deps = [
        ":locations",
        "//augur/model:deterministic",
        "//augur/model:level_series_groups",
        "//augur/model:series_model",
        "@pypi//pytest",
    ],
)

