        "//augur/model:series_model",
        "//augur/product:asset_key",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "runtime",
    srcs = ["runtime.py"],
    deps = [
        ":jurisdictions",
        ":locations",
        ":scenario",
    ],
)

py_library(
    name = "tensor_fifo",
    srcs = ["tensor_fifo.py"],
    deps = ["@pypi//numpy"],
)

py_library(
    name = "pricing",
    srcs = ["pricing.py"],
)

py_test(
    name = "pricing_test",
    srcs = ["pricing_test.py"],
    deps = [
        ":pricing",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "tensor_fifo_test",
    srcs = ["tensor_fifo_test.py"],
