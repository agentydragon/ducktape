        ":buffers",
        ":codec",
        ":compiler",
        ":enums",
        ":external_series",
        ":runtime",
        ":scenario",
        ":tax",
        ":tensor_fifo",
        "//augur/model:series",
        "@pypi//numpy",
    ],
)

py_library(
    name = "slice",
    srcs = ["slice.py"],
    deps = [
        ":engine",
        ":external_series",
        "@pypi//numpy",
        "@pypi//polars",
    ],
