load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "state",
    srcs = ["state.py"],
    deps = [
        "//augur:frames",
        "@pypi//polars",
    ],
)

py_library(
    name = "events",
    srcs = ["events.py"],
    deps = [
        "//augur:frames",
        "@pypi//polars",
    ],
)

py_library(
    name = "external_series",
    srcs = ["external_series.py"],
    deps = [
        "//augur:frames",
        "//augur/model:exogenous",
        "//augur/model:private_equity_bundle",
        "//augur/model:series_model",
        "@pypi//polars",
    ],
)

filegroup(
    name = "jurisdiction_data",
    srcs = glob(["data/jurisdictions/*.yaml"]),
)

filegroup(
    name = "location_data",
    srcs = glob(["data/locations/*.yaml"]),
)

py_library(
    name = "locations",
    srcs = ["locations.py"],
    deps = [
        "@pypi//pydantic",
    ],
)

py_test(
    name = "locations_test",
    srcs = ["locations_test.py"],
    data = [":location_data"],
    deps = [
        ":locations",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//pyyaml",
    ],
)

py_library(
    name = "jurisdictions",
    srcs = ["jurisdictions.py"],
    data = [":jurisdiction_data"],
    deps = [
        "@pypi//pydantic",
        "@pypi//pyyaml",
    ],
)

py_test(
    name = "jurisdictions_test",
    srcs = ["jurisdictions_test.py"],
    deps = [
        ":jurisdictions",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "tax",
    srcs = ["tax.py"],
    deps = [
        ":jurisdictions",
        "@pypi//numpy",
    ],
)

py_test(
    name = "tax_test",
    srcs = ["tax_test.py"],
    deps = [
        ":jurisdictions",
        ":tax",
        "@pypi//numpy",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
