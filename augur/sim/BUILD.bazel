        ":codec",
        "//augur:frames",
        "@pypi//polars",
    ],
)

py_library(
    name = "simulate",
    srcs = ["simulate.py"],
    deps = [
        ":codec",
        ":engine",
        ":external_series",
        ":scenario",
        "@pypi//polars",
    ],
)

py_library(
    name = "enums",
    srcs = ["enums.py"],
    deps = ["@pypi//numpy"],
)

py_library(
    name = "compiler",
    srcs = [
        "compiler/__init__.py",
        "compiler/assets.py",
        "compiler/deductions.py",
        "compiler/helpers.py",
        "compiler/lifecycle.py",
        "compiler/liquidity.py",
        "compiler/obligations.py",
        "compiler/plan.py",
        "compiler/primary_residence.py",
