    deps = [
        ":enums",
        ":external_series",
        ":jurisdictions",
        ":locations",
        ":runtime",
        ":scenario",
        "//augur/model:private_equity_bundle",
        "//augur/model:series",
        "//augur/product:asset_key",
        "@pypi//numpy",
        "@pypi//polars",
    ],
)

py_library(
    name = "buffers",
    srcs = ["buffers.py"],
    deps = [
        ":compiler",
        ":enums",
        "@pypi//numpy",
    ],
)

py_library(
    name = "codec",
    srcs = [
        "codec/__init__.py",
        "codec/assets.py",
        "codec/helpers.py",
        "codec/liabilities.py",
        "codec/lifecycle.py",
        "codec/obligations.py",
        "codec/plan.py",
        "codec/primary_residence.py",
        "codec/properties.py",
        "codec/tax.py",
