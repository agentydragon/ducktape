load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "evidence_source_files",
    srcs = ["//augur/data:evidence_source_files"],
)

py_library(
    name = "evidence_data",
    srcs = ["evidence_data.py"],
    data = [":evidence_source_files"],
    deps = [
        "//augur/model:location_series_sources",
        "//util/bazel:runfiles",
        "@pypi//numpy",
        "@pypi//pandas",
    ],
)

py_library(
    name = "model",
    srcs = ["model.py"],
    deps = [
        "//augur/model:exogenous",
        "//augur/model/path_models:scenarios",
        "@pypi//numpyro",
    ],
)

py_library(
    name = "scoring",
    srcs = ["scoring.py"],
    deps = [
        "@pypi//jax",
        "@pypi//numpy",
        "@pypi//numpyro",
    ],
)

py_library(
    name = "metrics",
    srcs = ["metrics.py"],
    deps = [
        ":model",
        ":scoring",
        "//augur/model/path_models:scenarios",
        "@pypi//numpy",
        "@pypi//numpyro",
    ],
)

py_library(
    name = "state_space",
    srcs = ["state_space.py"],
    deps = [
        ":evidence_data",
        ":private_equity",
        "//augur:dates",
        "//augur/model:conditioning",
        "//augur/model:series",
        "//augur/model:state_space",
        "//augur/model/path_models:scenarios",
        "//augur/product:asset_key",
        "@pypi//numpy",
        "@pypi//pandas",
    ],
)

py_library(
    name = "data",
    srcs = ["data.py"],
    deps = [
        ":evidence_data",
        "//augur/model:location_series_sources",
        "//augur/model/path_models:scenarios",
        "//util/bazel:runfiles",
        "@pypi//numpy",
        "@pypi//pandas",
    ],
)

py_binary(
    name = "metrics_report",
    srcs = ["metrics_report.py"],
    data = ["//augur/api:public_fixture_config"],
    deps = [
        ":data",
        ":metrics",
        ":model",
        "//augur/api:config",
        "//augur/model:independent",
        "//augur/model:provider_config",
        "//augur/model:vecm",
        "//util/bazel:runfiles",
    ],
)

py_library(
    name = "train_lib",
    srcs = ["main.py"],
    deps = [
        ":data",
        ":evidence_data",
        ":state_space",
        "//augur/model:provider_config",
        "//augur/model:state_space",
        "//augur/model:vecm",
        "@pypi//pyyaml",
    ],
)

py_binary(
    name = "train",
    main_module = "augur.fit.main",
    deps = [":train_lib"],
)

py_library(
    name = "private_equity",
    srcs = ["private_equity.py"],
    deps = [
        "//augur:dates",
        "//augur/model:schemas",
        "//augur/model:trained_private_equity",
        "@pypi//numpy",
        "@pypi//pydantic",
        "@pypi//pyyaml",
        "@pypi//types_pyyaml",
    ],
)

py_library(
    name = "stock_like_priors",
    srcs = ["stock_like_priors.py"],
    deps = [
        "//augur/model:schemas",
        "@pypi//numpy",
        "@pypi//pydantic",
    ],
)

py_binary(
    name = "train_private_equity",
    main_module = "augur.fit.private_equity",
    deps = [":private_equity"],
)

py_test(
    name = "data_test",
    srcs = ["data_test.py"],
    deps = [
        ":data",
        ":evidence_data",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "metrics_test",
    srcs = ["metrics_test.py"],
    deps = [
        ":metrics",
        ":model",
        "//augur/model:exogenous",
        "//augur/model/path_models:scenarios",
        "@pypi//jax",
        "@pypi//numpy",
        "@pypi//numpyro",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "private_equity_test",
    srcs = ["private_equity_test.py"],
    deps = [
        ":private_equity",
        "//augur/model:exogenous",
        "//augur/model:series",
        "//augur/model:trained_private_equity",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "stock_like_priors_test",
    srcs = ["stock_like_priors_test.py"],
    deps = [
        ":stock_like_priors",
        "@pypi//numpy",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "train_round_trip_test",
    size = "large",
    srcs = ["train_round_trip_test.py"],
    deps = [
        ":train_lib",
        "//augur/model:exogenous",
        "//augur/model:independent",
        "//augur/model:provider_config",
        "//augur/model:series",
        "//augur/model:state_space",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//pyyaml",
    ],
)

py_test(
    name = "state_space_acceptance_test",
    size = "large",
    srcs = ["state_space_acceptance_test.py"],
    deps = [
        ":train_lib",
        "//augur/model:exogenous",
        "//augur/model:provider_config",
        "//augur/model:series",
        "//augur/model:state_space",
        "@pypi//numpy",
        "@pypi//pydantic",
        "@pypi//pytest_bazel",
        "@pypi//pyyaml",
    ],
)

py_library(
    name = "dilution_prior",
    srcs = ["dilution_prior.py"],
    deps = [":private_equity"],
)

py_library(
    name = "derive_dilution_prior_lib",
    srcs = ["derive_dilution_prior.py"],
    deps = [
        ":dilution_prior",
        ":private_equity",
        "@pypi//pyyaml",
        "@pypi//types_pyyaml",
    ],
)

py_binary(
    name = "derive_dilution_prior",
    main_module = "augur.fit.derive_dilution_prior",
    deps = [":derive_dilution_prior_lib"],
)

py_test(
    name = "test_dilution_prior",
    srcs = ["test_dilution_prior.py"],
    deps = [
        ":dilution_prior",
        ":private_equity",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_derive_dilution_prior",
    srcs = ["test_derive_dilution_prior.py"],
    deps = [
        ":derive_dilution_prior_lib",
        ":dilution_prior",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//pyyaml",
    ],
)
