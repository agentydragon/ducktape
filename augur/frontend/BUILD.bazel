    deps = ["//:node_modules/react"],
)

js_library(
    name = "skeleton",
    srcs = ["skeleton.tsx"],
    deps = [
        ":header",
        "//:node_modules/react",
    ],
)

js_library(
    name = "events_panel",
    srcs = ["events_panel.tsx"],
    deps = [
        ":data_helpers",
        "//:node_modules/react",
        "//augur/frontend/lib:format",
    ],
)

js_library(
    name = "fan_chart",
    srcs = ["fan_chart.tsx"],
    deps = [
        ":data_helpers",
        ":input_helpers",
        "//:node_modules/react",
        "//augur/frontend/lib:chart",
        "//augur/frontend/lib:format",
    ],
)

js_library(
    name = "histogram",
    srcs = ["histogram.tsx"],
    deps = [
        ":data_helpers",
        ":input_helpers",
        "//:node_modules/react",
        "//augur/frontend/lib:chart",
        "//augur/frontend/lib:format",
    ],
)

js_library(
    name = "metric_table",
    srcs = ["metric_table.tsx"],
    deps = [
        ":data_helpers",
        ":hooks",
        ":input_helpers",
        "//:node_modules/react",
        "//augur/frontend/lib:chart",
        "//augur/frontend/lib:format",
    ],
)

js_library(
    name = "scenario_tabs",
    srcs = ["scenario_tabs.tsx"],
    deps = [
        ":input_helpers",
        "//:node_modules/react",
    ],
)

js_library(
    name = "scenario_editor",
    srcs = ["scenario_editor.tsx"],
    deps = [
        ":forms",
        ":input_helpers",
        ":scenario_tabs",
        "//:node_modules/@mantine/core",
        "//:node_modules/react",
        "//augur/frontend/lib:controls",
        "//augur/frontend/lib:format",
    ],
)

js_library(
    name = "forms",
    srcs = ["forms.tsx"],
    deps = [
        ":data_helpers",
        ":header",
        ":input_helpers",
        "//:node_modules/@mantine/core",
        "//:node_modules/react",
        "//augur/frontend/lib:chart",
        "//augur/frontend/lib:controls",
        "//augur/frontend/lib:format",
    ],
)

js_library(
    name = "calibration",
    srcs = ["calibration.tsx"],
    deps = [
        ":client",
        ":data_helpers",
        ":fan_chart",
        ":hooks",
        ":input_helpers",
        ":sanity_bands",
        ":skeleton",
        "//:node_modules/react",
        "//augur/frontend/lib:format",
    ],
)

# Pure CSV serialization for the budget tab's export buttons (no React/DOM, so it's
# unit-testable under vitest; see `:budget_csv_test`).
js_library(
    name = "budget_csv",
    srcs = ["budget_csv.ts"],
)

# Pure planning-adjustment model (hidden / override) + URL encoding + adjusted-total math for the
# budget tab (no React/DOM; see `:budget_adjustments_test`).
js_library(
    name = "budget_adjustments",
    srcs = ["budget_adjustments.ts"],
)

js_library(
    name = "budget",
    srcs = ["budget.tsx"],
    deps = [
        ":budget_adjustments",
        ":budget_csv",
        ":client",
        "//:node_modules/@mantine/core",
        "//:node_modules/react",
        "//augur/frontend/lib:format",
    ],
)

js_library(
    name = "product",
    srcs = ["product.tsx"],
    deps = [
        ":client",
        ":data_helpers",
        ":events_panel",
        ":fan_chart",
        ":header",
        ":histogram",
        ":hooks",
        ":input_helpers",
        ":metric_table",
        ":scenario_editor",
        ":skeleton",
        "//:node_modules/@mantine/core",
        "//:node_modules/react",
        "//augur/frontend/lib:chart",
        "//augur/frontend/lib:format",
    ],
)

js_library(
    name = "app",
    srcs = ["app.tsx"],
    deps = [
        ":budget",
        ":calibration",
        ":client",
        ":header",
        ":hooks",
        ":input_helpers",
        ":product",
        ":skeleton",
        "//:node_modules/@mantine/core",
        "//:node_modules/react",
    ],
)

# -- Bundle entry point ---------------------------------------------------------

js_library(
    name = "main_lib",
    srcs = ["main.tsx"],
    deps = [
        ":app",
        "//:node_modules/react",
        "//:node_modules/react-dom",
    ],
)

esbuild(
    name = "main_bundle",
    config = {
        "jsx": "automatic",
    },
    entry_point = "main.tsx",
    format = "esm",
    output = "dist/main.js",
    platform = "browser",
    sourcemap = "linked",
    target = ["es2022"],
    deps = [":main_lib"],
)

# Tailwind v4 scans `@source`-declared files for class names. We concatenate
# every .jsx/.js source whose classes we want to keep into a single text file
# the stylesheet references.
filegroup(
    name = "tailwind_content_srcs",
    srcs = [
        "app.tsx",
        "budget.tsx",
        "calibration.tsx",
        "client.ts",
        "data_helpers.ts",
        "events_panel.tsx",
        "fan_chart.tsx",
        "forms.tsx",
        "header.tsx",
        "histogram.tsx",
        "hooks.ts",
        "index.html",
        "input_helpers.ts",
        "main.tsx",
        "metric_table.tsx",
        "product.tsx",
        "sanity_bands.ts",
        "scenario_editor.tsx",
        "scenario_tabs.tsx",
        "skeleton.tsx",
        "//augur/frontend/lib:casing",
        "//augur/frontend/lib:chart",
        "//augur/frontend/lib:controls",
        "//augur/frontend/lib:format",
        "//augur/frontend/lib:frame",
    ],
)

genrule(
    name = "tailwind_content_index",
    srcs = [":tailwind_content_srcs"],
    outs = ["tailwind_content.txt"],
    cmd = "cat $(SRCS) > $@",
)

tailwindcss_bin.tailwindcss_binary(
    name = "tailwind_cli",
    data = [
        "//:node_modules/@mantine/core",
        "//:node_modules/@tailwindcss/cli",
        # `@import "tailwindcss"` in styles.src.css resolves to this package.
        "//:node_modules/tailwindcss",
    ],
)

js_run_binary(
    name = "styles_css",
    srcs = [
        "styles.src.css",
        ":tailwind_content_index",
    ],
    outs = ["dist/styles.css"],
    args = [
        "--input",
        "styles.src.css",
        "--output",
        "dist/styles.css",
        "--minify",
    ],
    chdir = package_name(),
    tool = ":tailwind_cli",
)

copy_file(
    name = "bundle_index_html",
    src = "index.html",
    out = "dist/index.html",
)

copy_file(
    name = "bundle_favicon",
    src = "favicon.svg",
    out = "dist/favicon.svg",
)

filegroup(
    name = "bundle_base",
    srcs = [
        ":bundle_favicon",
        ":bundle_index_html",
        ":main_bundle",
        ":styles_css",
    ],
)

# -- OCI image -----------------------------------------------------------------
#
# Static-assets sidecar: `nginx_unprivileged` serving the React bundle from
# `/usr/share/nginx/html`. The nginx config itself is mounted into the pod
# at runtime via a ConfigMap (see gaffer-private's k8s/augur/nginx.conf).

copy_to_directory(
    name = "frontend_files",
    srcs = [":bundle_base"],
    out = "usr/share/nginx/html",
    root_paths = ["augur/frontend/dist"],
)

pkg_tar(
    name = "frontend_tar",
    srcs = [":frontend_files"],
    package_dir = "/usr/share/nginx",
)

oci_image(
    name = "image",
    base = "@nginx_unprivileged_linux_amd64",
    labels = {
        "org.opencontainers.image.source": "https://github.com/agentydragon/ducktape",
        "org.opencontainers.image.title": "augur-frontend",
    },
    tars = [":frontend_tar"],
)

oci_load(
    name = "image_load",
    image = ":image",
    repo_tags = ["augur-frontend:dev"],
)

build_test(
    name = "image_build_test",
    targets = [
        ":image",
        ":image.digest",
    ],
)

# -- Type-check + unit tests ----------------------------------------------------

# Full TypeScript type-check over the app (the hard correctness gate). `tsc --noEmit`
# resolves free identifiers and prop shapes that esbuild bundling silently ignores
# (e.g. a component referencing an undestructured prop).
tsc_bin.tsc_test(
    name = "tsc_test",
    args = [
        "--noEmit",
        "-p",
        "tsconfig.json",
    ],
    chdir = package_name(),
    data = [
        "budget_adjustments.test.ts",
        "budget_csv.test.ts",
        "input_helpers.test.ts",
        "sanity_bands.test.ts",
        "tsconfig.json",
        ":budget_adjustments",
        ":budget_csv",
        ":main_lib",
        ":sanity_bands",
        "//:node_modules",
    ],
    tags = ["lint"],
)

# Type-aware ESLint (no-floating-promises, no-misused-promises, await-thenable).
# Runs as a whole-program test, not via the per-file lint-gate aspect: type-aware
# rules need the full TS program (built from tsconfig.json), which only a
# whole-package sandbox provides. Mirrors tsc_test's inputs. See P3 in
# plans/eslint_tightening.md.
eslint_bin.eslint_test(
    name = "eslint_typed_test",
    args = [
        "--no-config-lookup",
        "--config",
        "eslint.typed.config.js",
        ".",
    ],
    chdir = package_name(),
    data = [
        "budget_adjustments.test.ts",
        "budget_csv.test.ts",
        "eslint.typed.config.js",
        "input_helpers.test.ts",
        "sanity_bands.test.ts",
        "tsconfig.json",
        ":budget_adjustments",
        ":budget_csv",
        ":main_lib",
        ":sanity_bands",
        "//:node_modules",
    ],
    tags = ["lint"],
)

vitest_bin.vitest_test(
    name = "sanity_bands_test",
    args = ["run"],
    chdir = package_name(),
    data = [
        "sanity_bands.test.ts",
        "vitest.config.ts",
        ":sanity_bands",
        "//:node_modules",
    ],
)

vitest_bin.vitest_test(
    name = "budget_csv_test",
    args = ["run"],
    chdir = package_name(),
    data = [
        "budget_csv.test.ts",
        "vitest.config.ts",
        ":budget_csv",
        "//:node_modules",
    ],
)

vitest_bin.vitest_test(
    name = "budget_adjustments_test",
    args = ["run"],
    chdir = package_name(),
    data = [
        "budget_adjustments.test.ts",
        "vitest.config.ts",
        ":budget_adjustments",
        "//:node_modules",
    ],
)

vitest_bin.vitest_test(
    name = "input_helpers_test",
    args = ["run"],
    chdir = package_name(),
    data = [
        "input_helpers.test.ts",
        "vitest.config.ts",
        ":input_helpers",
        "//:node_modules",
    ],
)

filegroup(
    name = "visual_golden_snapshots",
    testonly = True,
    srcs = glob(
        ["__screenshots__/*.png"],
        allow_empty = True,
    ),
)
