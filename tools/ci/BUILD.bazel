load("@rules_python//python:defs.bzl", "py_library")

# === Base modules (no internal deps) ===

py_library(
    name = "bazel_query",
    srcs = ["bazel_query.py"],
    imports = ["../.."],
    visibility = ["//:__subpackages__"],
)

