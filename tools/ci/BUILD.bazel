load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("//tools/testing:defs.bzl", "py_test")

# Source of truth for CI workflow definitions
exports_files(["workflows.yaml"])

# Generated workflow files consumed by test_generate_ci
filegroup(
    name = "generated_workflows",
    srcs = [
        "//.github/workflows:ci.yml",
        "//.github/workflows:ducktape-release.yml",
        "//.github/workflows:gnome-terminal-profile-switcher-release.yml",
        "//.github/workflows:headscale-cleanup-release.yml",
    ],
)

# === Base modules (no internal deps) ===

py_library(
    name = "bazel_query",
    srcs = ["bazel_query.py"],
    imports = ["../.."],
    visibility = ["//:__subpackages__"],
    deps = ["//bazel_util:query"],
)

py_library(
    name = "github_actions",
    srcs = ["github_actions.py"],
    imports = ["../.."],
    visibility = ["//:__subpackages__"],
    deps = [
        "//env_utils",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "models",
    srcs = ["models.py"],
    imports = ["../.."],
    visibility = ["//:__subpackages__"],
    deps = [
        "//bazel_util:query",
        "@pypi//pydantic",
        "@pypi//pyyaml",
    ],
)

# === Library modules ===

py_library(
    name = "diff_utils",
    srcs = ["diff_utils.py"],
    imports = ["../.."],
    visibility = ["//:__subpackages__"],
    deps = [
        ":github_actions",
        "@pypi//pygit2",
    ],
)

# === Exec stubs ===

py_library(
    name = "check_release",
    srcs = ["check_release.py"],
    imports = ["../.."],
    visibility = ["//:__subpackages__"],
    deps = [
        ":diff_utils",
        ":github_actions",
        "//env_utils",
        "@pypi//pydantic",
        "@pypi//pygit2",
    ],
)

py_library(
    name = "ci_decide",
    srcs = ["ci_decide.py"],
    imports = ["../.."],
    visibility = ["//:__subpackages__"],
    deps = [
        ":bazel_query",
        ":diff_utils",
        ":github_actions",
        ":models",
        "//env_utils",
        "//fmt_util",
        "@pypi//pydantic",
        "@pypi//pygit2",
    ],
)

py_library(
    name = "generate_ci",
    srcs = ["generate_ci.py"],
    data = [":workflows.yaml"],
    imports = ["../.."],
    visibility = ["//:__subpackages__"],
    deps = [
        ":github_actions",
        ":models",
        "//bazel_util:workspace",
        "@pypi//pyyaml",
    ],
)

# === Binaries ===

py_binary(
    name = "generate_ci_bin",
    imports = ["../.."],
    main_module = "tools.ci.generate_ci",
    deps = [":generate_ci"],
)

# === Tests ===

py_test(
    name = "test_generate_ci",
    srcs = ["test_generate_ci.py"],
    data = [
        ":generated_workflows",
        ":workflows.yaml",
    ],
    imports = ["../.."],
    deps = [
        ":generate_ci",
        "@pypi//pytest_bazel",
        "@pypi//pyyaml",
    ],
)
