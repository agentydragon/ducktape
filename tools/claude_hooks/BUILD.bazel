load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("@rules_python//python:packaging.bzl", "py_package", "py_wheel")
load("//tools/lint:linters.bzl", "ruff_test")

py_library(
    name = "auth_proxy",
    srcs = [
        "proxy/auth_forwarding_proxy.py",
        "proxy/run_auth_proxy.py",
    ],
    imports = ["../.."],
    visibility = ["//visibility:public"],
)

py_library(
    name = "claude_hooks",
    srcs = [
        "bazel_wrapper.py",
        "bazelisk_setup.py",
        "binary_tools.py",
        "env_file.py",
        "errors.py",
        "nix_setup.py",
        "paths.py",
        "podman_service.py",
        "proxy_credentials.py",
        "proxy_setup.py",
        "resources.py",
        "session_start.py",
        "streaming.py",
        "supervisor_setup.py",
    ],
    data = [
        "config/bazelrc.mako",
        "config/env.mako",
        "config/nix.conf",
        "config/podman/containers.conf",
        "config/podman/storage.conf",
    ],
    imports = ["../.."],
    visibility = ["//visibility:public"],
    deps = [
        ":auth_proxy",
        "//tools:env_utils",
        "@pypi//cryptography",
        "@pypi//mako",
        "@pypi//platformdirs",
        "@pypi//pydantic",
        "@pypi//pyjwt",
        "@pypi//supervisor",
    ],
)

py_package(
    name = "claude_hooks_pkg",
    packages = [
        "tools",
        "tools.claude_hooks",
        "tools.claude_hooks.proxy",
    ],
    deps = [":claude_hooks"],
)

py_wheel(
    name = "claude_hooks_wheel",
    distribution = "claude_hooks",
    entry_points = {
        "console_scripts": [
            "claude-session-start = tools.claude_hooks.session_start:main",
            "bazel = tools.claude_hooks.bazel_wrapper:main",
            "bazelisk = tools.claude_hooks.bazel_wrapper:main",
            "claude-auth-proxy = tools.claude_hooks.proxy.run_auth_proxy:main",
        ],
    },
    python_requires = ">=3.13",
    requires = [
        "cryptography",
        "mako",
        "platformdirs",
        "pydantic",
        "pyjwt",
        "supervisor",
    ],
    version = "0.1.0",
    deps = [":claude_hooks_pkg"],
)

py_test(
    name = "test_session_start",
    srcs = ["test_session_start.py"],
    imports = ["../.."],
    deps = [
        ":claude_hooks",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_proxy",
    srcs = ["test_proxy.py"],
    imports = ["../.."],
    deps = [
        ":claude_hooks",
        "@pypi//pyjwt",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_integration",
    srcs = ["test_integration.py"],
    imports = ["../.."],
    tags = ["integration"],
    deps = [
        ":claude_hooks",
        "//net_util",
        "@pypi//cryptography",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_e2e",
    srcs = ["test_e2e.py"],
    data = [
        "//tools/claude_hooks/testdata/test_workspace:workspace_files",
    ],
    imports = ["../.."],
    tags = [
        "e2e",
        "external",  # Requires network access (but now works without it!)
    ],
    deps = [
        ":claude_hooks",
        "//tools/claude_hooks/testing:forwarding_tls_proxy",
        "//tools/claude_hooks/testing:shell_helpers",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

ruff_test(
    name = "ruff",
    srcs = [":claude_hooks"],
)
