# === Packaging ===

py_package(
    name = "claude_hooks_pkg",
    packages = [
        "bazel_util",
        "env_utils",
        "fmt_util",
        "net_util",
        "tools",
        "tools.claude_hooks",
        "tools.claude_hooks.auth_proxy",
        "tools.claude_hooks.supervisor",
    ],
    deps = [
        ":bazel_wrapper_lib",
        ":bazelisk_setup",
        ":buildbuddy_setup",
        ":cli_tools_setup",
        ":env_file",
        ":errors",
        ":kubeconfig_setup",
        ":managed_files",
        ":mkcert_setup",
        ":nix_setup",
        ":platform_utils",
        ":podman_service",
        ":precommit_setup",
        ":proxy_credentials",
        ":proxy_setup",
        ":proxy_vars",
        ":secrets_setup",
        ":session_start_lib",
        ":settings",
        ":streaming",
        ":tmpfs_setup",
        ":tracing",
        "//bazel_util:subprocess",
        "//net_util:net",
        "//tools/claude_hooks/auth_proxy:main",
        "//tools/claude_hooks/auth_proxy:proxy",
        "//tools/claude_hooks/supervisor:client",
        "//tools/claude_hooks/supervisor:setup",
    ],
)

py_wheel(
    name = "wheel",
    distribution = "claude_hooks",
    # Only claude-session-start is a console script. Other commands are invoked via
    # sys.executable -m (bazel wrapper, auth proxy) to ensure correct Python environment.
    entry_points = {"console_scripts": ["claude-session-start = tools.claude_hooks.session_start:main"]},
    python_requires = ">=3.13",
    requires = [
        "cryptography",
        "httpx",
        "mako",
        "opentelemetry-api",
        "opentelemetry-sdk",
        "platformdirs",
        "pydantic",
        "pydantic-settings",
        "pyjwt",
        "pyrage",
        "pyyaml",
        "supervisor",
        "tenacity",
    ],
    version = "0.1.0",
    deps = [":claude_hooks_pkg"],
)

