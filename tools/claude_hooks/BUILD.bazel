py_library(
    name = "podman_service",
    srcs = ["podman_service.py"],
    imports = ["../.."],
    visibility = ["//visibility:public"],
    deps = [
        ":errors",
        ":managed_files",
        ":proxy_setup",
        ":proxy_vars",
        ":settings",
        "//tools/claude_hooks/supervisor:client",
    ],
