# Stub: provides system diff instead of hermetic diff from gitlab.arm.com.
# Workaround for gitlab.arm.com outages (rules_diff -> ape -> Zig SDK).
# See https://github.com/aspect-build/rules_lint/issues/797

genrule(
    name = "resolved",
    outs = ["diff_wrapper.sh"],
    cmd = 'echo \'#!/bin/sh\nexec diff "$$@"\' > $@',
    executable = True,
    visibility = ["//visibility:public"],
)
