load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "schema",
    srcs = ["schema.py"],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "wire",
    srcs = ["wire.py"],
    deps = [
        ":schema",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "sql_read_model",
    srcs = ["sql_read_model.py"],
    deps = [
        ":schema",
        ":wire",
        "@pypi//sqlalchemy",
    ],
)

py_test(
    name = "test_sql_read_model",
    size = "medium",
    srcs = ["test_sql_read_model.py"],
    data = [
        "//finance/plaid/db:migrations",
    ],
    requires_docker = True,
    deps = [
        ":conftest",
        ":schema",
        ":sql_read_model",
        "//:conftest",
        "//finance/plaid/db:schema",
        "//util/bazel:runfiles",
        "//util/testing:postgres",
        "@pypi//alembic",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "csv_export",
    srcs = ["csv_export.py"],
    deps = [":wire"],
)

py_test(
    name = "test_csv_export",
    srcs = ["test_csv_export.py"],
    deps = [
        ":conftest",
        ":csv_export",
        ":schema",
        ":wire",
        "//:conftest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "service",
    srcs = ["service.py"],
    deps = [
        ":csv_export",
        ":schema",
        ":sql_read_model",
        ":wire",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    deps = [
        "//util/testing:postgres_fixtures",
        "@pypi//pytest",
        "@pypi//testcontainers",
    ],
)
