load("@aspect_rules_py//py:defs.bzl", "py_image_layer", aspect_py_binary = "py_binary")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")
load("//props:oci.bzl", "py_image_entrypoint", "py_image_env")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "export",
    srcs = ["export.py"],
    deps = [
        "//finance/augur/budget:schema",
        "@pypi//beancount",
    ],
)

py_library(
    name = "runner",
    srcs = ["runner.py"],
    deps = [
        ":export",
        "//finance/augur/budget:schema",
        "//finance/augur/budget:sql_read_model",
        "//plaid_utils:schema",
        "@pypi//beancount",
        "@pypi//pyyaml",
        "@pypi//structlog",
        "@pypi//typer",
    ],
)

py_binary(
    name = "export_ledger",
    main_module = "finance.beancount_export.runner",
    deps = [":runner"],
)

py_test(
    name = "test_export",
    srcs = ["test_export.py"],
    deps = [
        ":export",
        "//finance/augur/budget:schema",
        "@pypi//beancount",
        "@pypi//pytest_bazel",
    ],
)

# ── OCI image (budget exporter CronJob) ────────────────────────────────
# git + ca-certificates (apt layer) so `export_ledger sync` can push the ledger.

aspect_py_binary(
    name = "export_ledger_image_bin",
    main = "runner.py",
    deps = [":runner"],
)

py_image_layer(
    name = "layers",
    binary = ":export_ledger_image_bin",
    group = "1000",
    owner = "1000",
)

oci_image(
    name = "image",
    base = "@debian_trixie_slim_linux_amd64",
    entrypoint = py_image_entrypoint("export_ledger_image_bin"),
    env = py_image_env(binary_name = "export_ledger_image_bin"),
    labels = {
        "org.opencontainers.image.source": "https://github.com/agentydragon/ducktape",
        "org.opencontainers.image.title": "budget-exporter",
    },
    tars = [
        ":layers",
        "@trixie_budget_exporter//:flat",
    ],
    user = "1000:1000",
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["budget-exporter:latest"],
)
