    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//finance/worthy:asset",
        "//finance/worthy:converter",
        "//finance/worthy:denomination",
        "//finance/worthy:exchange_rate",
        "@crates//:log",
        "@crates//:reqwest",
        "@crates//:rust_decimal",
        "@crates//:serde",
        "@crates//:url",
    ],
