load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config")
load("//devinfra/js:openapi_typescript.bzl", "openapi_typescript")
load("//devinfra/js:spa_bundle.bzl", "spa_bundle")
load("//devinfra/js:ts_library.bzl", "ts_library")
load("//devinfra/js:typed_eslint.bzl", "typed_eslint_test")
load("//devinfra/js:vitest.bzl", "check_vitest_specs", "vitest_config")
load("//devinfra/python:defs.bzl", "py_test")
load(":vitest.bzl", "spend_vitest_test")

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
)

vitest_config(
    name = "vitest_config",
    data = ["//:node_modules/happy-dom"],
    environment = "node",
)

filegroup(
    name = "typed_lint_srcs",
    srcs = glob(
        [
            "*.ts",
            "*.tsx",
            "**/*.ts",
            "**/*.tsx",
        ],
        allow_empty = True,
    ),
)

filegroup(
    name = "typed_lint_program_data",
    srcs = [
        ":schema",
        "//:node_modules/@mantine/core",
        "//:node_modules/@tabler/icons-react",
        "//:node_modules/chart.js",
    ],
)

typed_eslint_test(
    name = "eslint_typed_test",
    srcs = ":typed_lint_srcs",
    extra_data = [
        ":main",
        ":typed_lint_program_data",
        "//util/frontend:typed_lint_program_data",
    ],
    source_data = ["//util/frontend:typed_lint_srcs"],
    tsconfig = "tsconfig.json",
)

# Generate browser wire types from the API's Pydantic response models.
openapi_typescript(
    name = "_schema_types",
    out = "api/schema.d.ts",
    schema = "//finance/plaid/spend:openapi_schema",
)

js_library(
    name = "schema",
    srcs = [":_schema_types"],
    tags = ["no-lint"],
)

js_library(
    name = "styles",
    srcs = ["styles.css"],
)

ts_library(
    name = "types",
    srcs = ["types.ts"],
    tsconfig = ":tsconfig",
    deps = [":schema"],
)

ts_library(
    name = "rule_display",
    srcs = ["rule_display.ts"],
    tsconfig = ":tsconfig",
    deps = [":types"],
)

ts_library(
    name = "spend_display",
    srcs = ["spend_display.tsx"],
    tsconfig = ":tsconfig",
    deps = [
        ":types",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/react",
    ],
)

ts_library(
    name = "SpendingHistoryChart",
    srcs = ["SpendingHistoryChart.tsx"],
    tsconfig = ":tsconfig",
    deps = [
        ":schema",
        ":types",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/chart.js",
        "//:node_modules/react",
        "//util/frontend:help_tooltip",
    ],
)

