load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config")
load("//devinfra/js:openapi.bzl", "js_openapi_schema")
load("//devinfra/js:spa_bundle.bzl", "spa_bundle")
load("//devinfra/js:ts_library.bzl", "ts_library")
load("//devinfra/python:defs.bzl", "py_test")

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
)

# Generate browser wire types from the API's Pydantic response models.
js_openapi_schema(
    name = "schema",
    generator = "//finance/plaid/spend:export_schema_bin",
)

js_library(
    name = "styles",
    srcs = ["styles.css"],
)

ts_library(
    name = "types",
    srcs = ["types.ts"],
    tsconfig = ":tsconfig",
    deps = [":schema"],
)

ts_library(
    name = "rule_display",
    srcs = ["rule_display.ts"],
    tsconfig = ":tsconfig",
    deps = [":types"],
)

ts_library(
    name = "spend_display",
    srcs = ["spend_display.tsx"],
    tsconfig = ":tsconfig",
    deps = [
        ":types",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/react",
    ],
)

ts_library(
    name = "SpendingHistoryChart",
    srcs = ["SpendingHistoryChart.tsx"],
    tsconfig = ":tsconfig",
    deps = [
        ":types",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/chart.js",
        "//:node_modules/react",
    ],
)

ts_library(
    name = "configuration",
    srcs = ["configuration.tsx"],
    tsconfig = ":tsconfig",
    deps = [
        ":rule_display",
        ":spend_display",
        ":types",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/react",
    ],
)

ts_library(
    name = "spending",
    srcs = ["spending.tsx"],
    tsconfig = ":tsconfig",
    deps = [
        ":SpendingHistoryChart",
        ":spend_display",
        ":types",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/react",
    ],
)

ts_library(
    name = "transactions",
    srcs = [
        "tabler_icons.d.ts",
        "transactions.tsx",
    ],
    tsconfig = ":tsconfig",
    deps = [
        ":rule_display",
        ":spend_display",
        ":types",
        "//:node_modules/@mantine/core",
        "//:node_modules/@tabler/icons-react",
        "//:node_modules/@types/react",
        "//:node_modules/react",
    ],
)

ts_library(
    name = "use_spend_data",
    srcs = ["use_spend_data.ts"],
    tsconfig = ":tsconfig",
    deps = [
        ":types",
        "//:node_modules/@types/react",
        "//:node_modules/react",
    ],
)

ts_library(
    name = "main",
    srcs = [
        "main.tsx",
    ],
    tsconfig = ":tsconfig",
    deps = [
        ":configuration",
        ":spending",
        ":styles",
        ":transactions",
        ":types",
        ":use_spend_data",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/@types/react-dom",
        "//:node_modules/react",
        "//:node_modules/react-dom",
    ],
)

spa_bundle(
    name = "bundle",
    entry_point = "main.js",
    jsx = "automatic",
    visibility = ["//finance/plaid/spend:__pkg__"],
    deps = [":main"],
)

py_test(
    name = "visual_test",
    size = "large",
    srcs = ["visual_test.py"],
    data = [
        "accordion-readiness-fixture.html",
        ":bundle",
    ],
    tags = ["visual"],
    deps = [
        "//:conftest",
        "//finance/plaid/spend:allowance",
        "//finance/plaid/spend:conftest",
        "//finance/plaid/spend:models",
        "//util:playwright",
        "//util/bazel:runfiles",
        "//util/testing:asgi",
        "//util/testing:frontend_visual",
        "//util/testing:undeclared_outputs",
        "//util/testing:visual_capture",
        "@pypi//fastapi",
        "@pypi//playwright",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
