load("@aspect_rules_ts//ts:defs.bzl", "ts_config")
load("//devinfra/js:openapi.bzl", "js_openapi_schema")
load("//devinfra/js:spa_bundle.bzl", "spa_bundle")
load("//devinfra/js:ts_library.bzl", "ts_library")
load("//devinfra/python:defs.bzl", "py_test")

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
)

# Generate browser wire types from the API's Pydantic response models.
js_openapi_schema(
    name = "schema",
    generator = "//finance/plaid/spend:export_schema_bin",
)

ts_library(
    name = "main",
    srcs = ["main.tsx"],
    tsconfig = ":tsconfig",
    deps = [
        ":schema",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/@types/react-dom",
        "//:node_modules/react",
        "//:node_modules/react-dom",
    ],
)

spa_bundle(
    name = "bundle",
    entry_point = "main.js",
    jsx = "automatic",
    visibility = ["//finance/plaid/spend:__pkg__"],
    deps = [":main"],
)

py_test(
    name = "visual_test",
    size = "large",
    srcs = ["visual_test.py"],
    data = [":bundle"],
    tags = ["visual"],
    deps = [
        "//:conftest",
        "//finance/plaid/spend:allowance",
        "//finance/plaid/spend:conftest",
        "//finance/plaid/spend:models",
        "//util:playwright",
        "//util/bazel:runfiles",
        "//util/testing:asgi",
        "//util/testing:visual_review",
        "@pypi//fastapi",
        "@pypi//playwright",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
