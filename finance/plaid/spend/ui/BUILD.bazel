    deps = [
        ":schema",
        ":spend_display",
        ":types",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/chart.js",
        "//:node_modules/react",
    ],
)

ts_library(
    name = "configuration",
    srcs = ["configuration.tsx"],
    tsconfig = ":tsconfig",
    deps = [
        ":rule_display",
        ":schema",
        ":spend_display",
        ":types",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//util/frontend:help_tooltip",
    ],
)

ts_library(
    name = "spending",
    srcs = ["spending.tsx"],
    tsconfig = ":tsconfig",
    deps = [
        ":SpendingHistoryChart",
        ":schema",
        ":spend_display",
        ":types",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//util/frontend:help_tooltip",
    ],
)

ts_library(
    name = "transactions",
    srcs = [
        "tabler_icons.d.ts",
        "transactions.tsx",
    ],
    tsconfig = ":tsconfig",
    deps = [
        ":rule_display",
        ":schema",
        ":spend_display",
        ":types",
        "//:node_modules/@mantine/core",
        "//:node_modules/@tabler/icons-react",
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//util/frontend:help_tooltip",
    ],
)

ts_library(
    name = "sustainability",
    srcs = ["sustainability.tsx"],
    tsconfig = ":tsconfig",
    deps = [
        ":SustainabilityHistoryChart",
        ":schema",
        ":spend_display",
        ":types",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//util/frontend:help_tooltip",
    ],
)

ts_library(
    name = "use_spend_data",
    srcs = ["use_spend_data.ts"],
    tsconfig = ":tsconfig",
    deps = [
        ":schema",
        ":types",
        "//:node_modules/@types/react",
        "//:node_modules/react",
    ],
)

spend_vitest_test(
    name = "use_spend_data_test",
    srcs = ["use_spend_data.test.tsx"],
    deps = [
        ":schema",
        ":types",
        ":use_spend_data",
        "//:node_modules/@types/react",
        "//:node_modules/@types/react-dom",
        "//:node_modules/react",
        "//:node_modules/react-dom",
        "//:node_modules/vitest",
    ],
)

ts_library(
    name = "main",
    srcs = [
        "main.tsx",
    ],
    tsconfig = ":tsconfig",
    deps = [
        ":configuration",
        ":spending",
        ":styles",
        ":sustainability",
        ":transactions",
        ":types",
        ":use_spend_data",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/@types/react-dom",
        "//:node_modules/react",
        "//:node_modules/react-dom",
    ],
)

spa_bundle(
    name = "bundle",
    entry_point = "main.js",
    jsx = "automatic",
    visibility = ["//finance/plaid/spend:__pkg__"],
    deps = [":main"],
)

py_test(
    name = "visual_test",
    size = "large",
    srcs = ["visual_test.py"],
    data = [
        "accordion-readiness-fixture.html",
        ":bundle",
    ],
    tags = ["visual"],
    deps = [
        "//:conftest",
        "//finance/plaid/spend:allowance",
        "//finance/plaid/spend:conftest",
        "//finance/plaid/spend:models",
        "//util:playwright",
        "//util/bazel:runfiles",
        "//util/testing:asgi",
        "//util/testing:frontend_visual",
        "//util/testing:undeclared_outputs",
        "//util/testing:visual_capture",
        "@pypi//fastapi",
        "@pypi//playwright",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

check_vitest_specs()
