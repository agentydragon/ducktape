load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files", "strip_prefix")
load("@rules_pkg//pkg:zip.bzl", "pkg_zip")
load("//devinfra/lint:linters.bzl", "eslint_test")
load("//devinfra/python:defs.bzl", "py_test")
load("//gnome:devkit.bzl", "gnome_devkit")

pkg_files(
    name = "extension_files",
    srcs = [
        "extension.js",
        "metadata.json",
        "prefs.js",
        "schemas/org.gnome.shell.extensions.plaid-spend.gschema.xml",
        "stylesheet.css",
    ],
    strip_prefix = strip_prefix.from_pkg(),
    visibility = ["//visibility:public"],
)

pkg_zip(
    name = "plaid_spend_extension",
    srcs = [":extension_files"],
    out = "plaid-spend-desktop.zip",
    visibility = ["//visibility:public"],
)

filegroup(
    name = "test_fixtures",
    testonly = True,
    srcs = glob(["fixtures/*.json"]),
)

js_library(
    name = "fake_daemon",
    testonly = True,
    srcs = ["fake-daemon.js"],
    deps = ["//gnome/testing:fake_daemon_js"],
)

eslint_test(
    name = "fake_daemon_lint",
    srcs = [":fake_daemon"],
)

py_test(
    name = "test_render",
    size = "medium",
    srcs = ["test_render.py"],
    data = [
        ":fake_daemon",
        ":plaid_spend_extension",
        ":test_fixtures",
    ],
    requires_docker = True,
    tags = ["visual"],
    deps = [
        "//:conftest",
        "//devinfra/oci",
        "//devinfra/testing:output_writer",
        "//finance/plaid/spend:allowance",
        "//finance/plaid/spend:conftest",
        "//finance/plaid/spend:models",
        "//finance/plaid/spend/testing:dashboard",
        "//gnome/test_image:gnome_shell_test",
        "//gnome/testing:fake_daemon",
        "//gnome/testing:session",
        "@pypi//pillow",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@rules_python//python/runfiles",
    ],
)

gnome_devkit(
    name = "devkit",
    daemon = "//finance/plaid/spend/desktop:daemon_bin",
    daemon_arg = "--ephemeral-credentials",
    default_fixture = "fixtures/ready_allowance.json",
    extension_zip = ":plaid_spend_extension",
    fixture_env = "PLAID_SPEND_FIXTURE",
    host_bus_env = "PLAID_SPEND_DEVKIT_HOST_BUS_ADDRESS",
    uuid = "plaid-spend@allegedly.works",
)
