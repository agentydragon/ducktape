load("@aspect_rules_py//py:defs.bzl", "py_image_layer", aspect_py_binary = "py_binary")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")
load("//props:oci.bzl", "py_image_entrypoint", "py_image_env")

py_library(
    name = "app",
    srcs = ["app.py"],
    deps = [
        ":models",
        ":service",
        ":settings",
        "//mcp_infra:oidc_principal",
        "//util:oidc_login",
        "@pypi//fastapi",
        "@pypi//uvicorn",
    ],
)

py_library(
    name = "allowance",
    srcs = ["allowance.py"],
    visibility = ["//finance/plaid/spend:__subpackages__"],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "models",
    srcs = ["models.py"],
    visibility = ["//finance/plaid/spend:__subpackages__"],
    deps = [
        ":allowance",
        "@pypi//pydantic",
        "@pypi//pyyaml",
    ],
)

py_library(
    name = "service",
    srcs = ["service.py"],
    deps = [
        ":allowance",
        ":models",
        "@pypi//asyncpg",
        "@pypi//babel",
    ],
)

py_library(
    name = "settings",
    srcs = ["settings.py"],
    visibility = ["//cluster/cdk8s:__subpackages__"],
    deps = [
        "@pypi//pydantic",
        "@pypi//pydantic_settings",
    ],
)

py_test(
    name = "test_allowance",
    srcs = ["test_allowance.py"],
    deps = [
        ":allowance",
        ":conftest",
        ":models",
        "//:conftest",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_ui",
    srcs = ["test_ui.py"],
    data = ["//finance/plaid/spend/ui:bundle"],
    deps = [
        ":app",
        ":conftest",
        ":models",
        ":service",
        ":settings",
        "//:conftest",
        "//mcp_infra:oidc_principal",
        "//util:oidc_login",
        "@pypi//httpx",
        "@pypi//itsdangerous",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_service",
    size = "medium",
    srcs = ["test_service.py"],
    data = ["//finance/plaid/spend/ui:bundle"],
    requires_docker = True,
    deps = [
        ":allowance",
        ":app",
        ":conftest",
        ":models",
        ":service",
        "//:conftest",
        "//finance/plaid/db:link_store",
        "//util/testing:postgres",
        "@pypi//asyncpg",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)

py_binary(
    name = "app_cli",
    data = ["//finance/plaid/spend/ui:bundle"],
    main_module = "finance.plaid.spend.app",
    deps = [":app"],
)

py_library(
    name = "export_schema",
    srcs = ["export_schema.py"],
    deps = [
        ":app",
        ":service",
        ":settings",
        "@pypi//pydantic",
    ],
)

py_binary(
    name = "export_schema_bin",
    main_module = "finance.plaid.spend.export_schema",
    visibility = ["//finance/plaid/spend/ui:__pkg__"],
    deps = [":export_schema"],
)

aspect_py_binary(
    name = "server_bin",
    data = ["//finance/plaid/spend/ui:bundle"],
    main = "app.py",
    deps = [":app"],
)

py_image_layer(
    name = "server_layers",
    binary = ":server_bin",
    group = "1000",
    owner = "1000",
)

oci_image(
    name = "server_image",
    base = "@debian_trixie_slim_linux_amd64",
    entrypoint = py_image_entrypoint("server_bin"),
    env = py_image_env(binary_name = "server_bin"),
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [":server_layers"],
    user = "1000:1000",
    visibility = ["//visibility:public"],
)

oci_load(
    name = "server_load",
    image = ":server_image",
    repo_tags = ["plaid-spend:latest"],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    visibility = ["//finance/plaid/spend:__subpackages__"],
    deps = [
        "//util/testing:postgres_fixtures",
        "@pypi//pytest",
        "@pypi//testcontainers",
    ],
)
