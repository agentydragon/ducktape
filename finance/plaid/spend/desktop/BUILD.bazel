# gazelle:ignore
load("@rules_python//python:packaging.bzl", "py_wheel")

py_wheel(
    name = "plaid_spend_desktop_wheel",
    distribution = "plaid-spend-desktop",
    entry_points = {
        "console_scripts": [
            "plaid-spend = plaid_spend_desktop.cli:main",
            "plaid-spend-daemon = plaid_spend_desktop.daemon:main",
        ],
    },
    python_requires = ">=3.14",
    requires = [
        "Babel>=2.15.0",
        "dbus-next>=0.2.3",
        "httpx>=0.27.0",
    ],
    strip_path_prefixes = ["finance/plaid/spend/desktop/"],
    version = "0.1.0",
    visibility = ["//visibility:public"],
    deps = [
        "//finance/plaid/spend/desktop/plaid_spend_desktop:cli",
        "//finance/plaid/spend/desktop/plaid_spend_desktop:credentials",
        "//finance/plaid/spend/desktop/plaid_spend_desktop:daemon",
        "//finance/plaid/spend/desktop/plaid_spend_desktop:oauth",
        "//finance/plaid/spend/desktop/plaid_spend_desktop:package_init",
    ],
