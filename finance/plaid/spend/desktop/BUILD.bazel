# gazelle:ignore
load("@rules_python//python:packaging.bzl", "py_wheel")
load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

py_library(
    name = "credentials",
    srcs = ["credentials.py"],
)

py_library(
    name = "oauth",
    srcs = ["oauth.py"],
    deps = [
        ":credentials",
        "@pypi//httpx",
    ],
)

py_test(
    name = "test_oauth",
    srcs = ["test_oauth.py"],
    deps = [
        ":oauth",
        "//:conftest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "daemon",
    srcs = ["daemon.py"],
    deps = [
        ":credentials",
        ":oauth",
        "@pypi//dbus_next",
        "@pypi//httpx",
    ],
)

py_library(
    name = "cli",
    srcs = ["cli.py"],
    deps = [
        "//finance/plaid/spend:allowance",
        "//finance/plaid/spend:models",
        "@pypi//babel",
        "@pypi//dbus_next",
    ],
)

py_test(
    name = "test_cli",
    srcs = ["test_cli.py"],
    deps = [
        ":cli",
        "//:conftest",
        "//finance/plaid/spend:allowance",
        "//finance/plaid/spend:models",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_binary(
    name = "plaid_spend_cli",
    main_module = "finance.plaid.spend.desktop.cli",
    visibility = ["//visibility:public"],
    deps = [":cli"],
)

py_library(
    name = "package_init",
    srcs = ["__init__.py"],
)

py_wheel(
    name = "plaid_spend_desktop_wheel",
    distribution = "plaid-spend-desktop",
    entry_points = {
        "console_scripts": [
            "plaid-spend = finance.plaid.spend.desktop.cli:main",
            "plaid-spend-daemon = finance.plaid.spend.desktop.daemon:main",
        ],
    },
    python_requires = ">=3.14",
    requires = [
        "Babel>=2.15.0",
        "dbus-next>=0.2.3",
        "httpx>=0.27.0",
        "pydantic>=2.0",
        "PyYAML>=6.0.0",
    ],
    version = "0.1.0",
    visibility = ["//visibility:public"],
    deps = [
        ":cli",
        ":credentials",
        ":daemon",
        ":oauth",
        ":package_init",
        "//finance/plaid/spend:allowance",
        "//finance/plaid/spend:models",
    ],
)
