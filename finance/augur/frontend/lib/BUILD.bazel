load("//devinfra/js:openapi_zod_ts_library.bzl", "openapi_zod_ts_library")
load("//devinfra/js:ts_library.bzl", "ts_library")

package(default_visibility = ["//visibility:public"])

TSCONFIG = "//finance/augur/frontend:tsconfig"

openapi_zod_ts_library(
    name = "schema_zod",
    config = "openapi-ts.config.mjs",
    schema = "//finance/augur/api:frontend_openapi_json",
    tsconfig = TSCONFIG,
    deps = ["//:node_modules/zod"],
)

ts_library(
    name = "casing",
    srcs = ["casing.ts"],
    tsconfig = TSCONFIG,
)

ts_library(
    name = "frame",
    srcs = ["frame.ts"],
    tsconfig = TSCONFIG,
)

ts_library(
    name = "chart",
    srcs = ["chart.ts"],
    tsconfig = TSCONFIG,
    deps = [":format"],
)

ts_library(
    name = "controls",
    srcs = ["controls.tsx"],
    tsconfig = TSCONFIG,
    deps = [
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/react",
    ],
)

ts_library(
    name = "format",
    srcs = ["format.ts"],
    tsconfig = TSCONFIG,
)

ts_library(
    name = "toast",
    srcs = ["toast.ts"],
    tsconfig = TSCONFIG,
    deps = ["//:node_modules/@mantine/notifications"],
)

# This package's half of //finance/augur/frontend:typed_lint_srcs — a glob cannot cross a package
# boundary. Include the generated source alongside this package's hand-written TS modules.
filegroup(
    name = "typed_lint_srcs",
    srcs = glob([
        "*.ts",
        "*.tsx",
    ]) + [":schema_zod.ts"],
)
