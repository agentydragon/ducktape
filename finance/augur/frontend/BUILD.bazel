# -- Bundle entry point ---------------------------------------------------------

js_library(
    name = "main_lib",
    srcs = ["main.tsx"],
    deps = [
        ":app",
        "//:node_modules/react",
        "//:node_modules/react-dom",
    ],
)

esbuild(
    name = "main_bundle",
    config = {
        "jsx": "automatic",
    },
    entry_point = "main.tsx",
    format = "esm",
    output = "dist/main.js",
    platform = "browser",
    sourcemap = "linked",
    target = ["es2022"],
    deps = [":main_lib"],
)

# Tailwind v4 scans `@source`-declared files for class names. We concatenate
# every .jsx/.js source whose classes we want to keep into a single text file
# the stylesheet references.
filegroup(
    name = "tailwind_content_srcs",
    srcs = [
        "app.tsx",
        "budget.tsx",
        "calibration.tsx",
        "calibration_format.tsx",
        "calibration_tables.tsx",
        "categorical_chart.tsx",
        "client.ts",
        "data_helpers.ts",
        "events_panel.tsx",
        "fan_chart.tsx",
        "forms.tsx",
        "header.tsx",
        "hooks.ts",
        "index.html",
        "input_helpers.ts",
        "main.tsx",
        "metric_table.tsx",
        "product.tsx",
        "sanity_bands.ts",
        "sanity_bands_panel.tsx",
        "scenario_editor.tsx",
        "scenario_tabs.tsx",
        "skeleton.tsx",
        "terminal_distribution.tsx",
        "//finance/augur/frontend/lib:casing",
        "//finance/augur/frontend/lib:chart",
        "//finance/augur/frontend/lib:controls",
        "//finance/augur/frontend/lib:format",
        "//finance/augur/frontend/lib:frame",
    ],
)

genrule(
    name = "tailwind_content_index",
    srcs = [":tailwind_content_srcs"],
    outs = ["tailwind_content.txt"],
    cmd = "cat $(SRCS) > $@",
)

tailwindcss_bin.tailwindcss_binary(
    name = "tailwind_cli",
    data = [
        "//:node_modules/@mantine/core",
        "//:node_modules/@mantine/notifications",
        "//:node_modules/@tailwindcss/cli",
        # `@import "tailwindcss"` in styles.src.css resolves to this package.
        "//:node_modules/tailwindcss",
    ],
)

js_run_binary(
    name = "styles_css",
    srcs = [
        "styles.src.css",
        ":tailwind_content_index",
    ],
    outs = ["dist/styles.css"],
    args = [
        "--input",
        "styles.src.css",
        "--output",
        "dist/styles.css",
        "--minify",
    ],
    chdir = package_name(),
    tool = ":tailwind_cli",
)

copy_file(
    name = "bundle_index_html",
    src = "index.html",
    out = "dist/index.html",
)

copy_file(
    name = "bundle_favicon",
    src = "favicon.svg",
    out = "dist/favicon.svg",
)

filegroup(
    name = "bundle_base",
    srcs = [
        ":bundle_favicon",
        ":bundle_index_html",
        ":main_bundle",
        ":styles_css",
    ],
)

# -- OCI image -----------------------------------------------------------------
#
# Static-assets sidecar: `nginx_unprivileged` serving the React bundle from
# `/usr/share/nginx/html`. The nginx config itself is mounted into the pod
# at runtime via a ConfigMap (see gaffer-private's k8s/augur/nginx.conf).

copy_to_directory(
    name = "frontend_files",
    srcs = [":bundle_base"],
    out = "usr/share/nginx/html",
    # Strip the full package-relative prefix so the bundle lands at the docroot root
    # (/usr/share/nginx/html/index.html). After the augur -> finance/augur reorg this is
    # finance/augur/frontend/dist; a stale prefix silently fails to strip, nesting the SPA
    # under .../finance/augur/frontend/dist and leaving nginx to serve the stock index.
    root_paths = ["finance/augur/frontend/dist"],
)

pkg_tar(
    name = "frontend_tar",
    srcs = [":frontend_files"],
    package_dir = "/usr/share/nginx",
)

oci_image(
    name = "image",
    base = "@nginx_unprivileged_linux_amd64",
    labels = {
        "org.opencontainers.image.source": "https://github.com/agentydragon/ducktape",
        "org.opencontainers.image.title": "augur-frontend",
    },
    tars = [":frontend_tar"],
)

oci_load(
    name = "image_load",
    image = ":image",
    repo_tags = ["augur-frontend:dev"],
)

build_test(
    name = "image_build_test",
    targets = [
        ":image",
        ":image.digest",
    ],
)

# Regression guard for the docroot layout: the SPA bundle must land at the root of
# /usr/share/nginx/html (index.html, main.js, styles.css) to match gaffer-private's augur
# nginx.conf. A stale copy_to_directory root_paths (e.g. after a package move) silently nests
# the bundle under a subdir, so nginx serves the stock welcome index instead of the app.
genrule(
    name = "frontend_layout_listing",
    srcs = [":frontend_files"],
    outs = ["frontend_layout_listing.txt"],
    cmd = "( cd $(location :frontend_files) && find . -type f | LC_ALL=C sort ) > $@",
)

diff_test(
    name = "frontend_layout_test",
    file1 = "frontend_layout.golden.txt",
    file2 = ":frontend_layout_listing",
)

# -- Type-check + unit tests ----------------------------------------------------

# Full TypeScript type-check over the app (the hard correctness gate). `tsc --noEmit`
# resolves free identifiers and prop shapes that esbuild bundling silently ignores
# (e.g. a component referencing an undestructured prop).
tsc_bin.tsc_test(
    name = "tsc_test",
    args = [
        "--noEmit",
        "-p",
        "tsconfig.json",
    ],
    chdir = package_name(),
    data = [
        "budget_adjustments.test.ts",
        "format.test.ts",
        "input_helpers.test.ts",
        "sanity_bands.test.ts",
        "tsconfig.json",
        ":budget_adjustments",
        ":main_lib",
        ":sanity_bands",
        "//:node_modules",
    ],
    tags = ["lint"],
)

# Type-aware ESLint (no-floating-promises, no-misused-promises, await-thenable).
# Runs as a whole-program test, not via the per-file lint-gate aspect: type-aware
# rules need the full TS program (built from tsconfig.json), which only a
# whole-package sandbox provides. Mirrors tsc_test's inputs. See P3 in
# plans/eslint_tightening.md.
eslint_bin.eslint_test(
    name = "eslint_typed_test",
    args = [
        "--no-config-lookup",
        "--config",
        "eslint.typed.config.js",
        ".",
    ],
    chdir = package_name(),
    data = [
        "budget_adjustments.test.ts",
        "eslint.typed.config.js",
        "format.test.ts",
        "input_helpers.test.ts",
        "sanity_bands.test.ts",
        "tsconfig.json",
        ":budget_adjustments",
        ":main_lib",
        ":sanity_bands",
        "//:node_modules",
    ],
    tags = ["lint"],
)

vitest_bin.vitest_test(
    name = "sanity_bands_test",
    args = ["run"],
    chdir = package_name(),
    data = [
        "sanity_bands.test.ts",
        "vitest.config.ts",
        ":sanity_bands",
        "//:node_modules",
    ],
)

vitest_bin.vitest_test(
    name = "budget_adjustments_test",
    args = ["run"],
    chdir = package_name(),
    data = [
        "budget_adjustments.test.ts",
        "vitest.config.ts",
        ":budget_adjustments",
        "//:node_modules",
    ],
)

vitest_bin.vitest_test(
    name = "input_helpers_test",
    args = ["run"],
    chdir = package_name(),
    data = [
        "input_helpers.test.ts",
        "vitest.config.ts",
        ":input_helpers",
        "//:node_modules",
    ],
)

vitest_bin.vitest_test(
    name = "format_test",
    args = [
        "run",
        "format.test.ts",
    ],
    chdir = package_name(),
    data = [
        "format.test.ts",
        "vitest.config.ts",
        "//:node_modules",
        "//finance/augur/frontend/lib:format",
    ],
)

filegroup(
    name = "visual_golden_snapshots",
    testonly = True,
    srcs = glob(
        ["__screenshots__/*.png"],
        allow_empty = True,
    ),
)
