load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_binary(
    name = "compare_bin",
    main_module = "finance.augur.x.joint_spending_allocation.compare",
    deps = [":compare"],
)

py_test(
    name = "test_compare",
    srcs = ["test_compare.py"],
    data = [":compare_bin"],
    deps = [
        ":compare",
        ":situation",
        "//:conftest",
        "//finance/augur:conftest",
        "//finance/augur/sim:results",
        "//finance/augur/x/bounded_spending:python_policy",
        "//util/bazel:runfiles",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "compare",
    srcs = ["compare.py"],
    deps = [
        ":policy",
        ":situation",
        "//finance/augur/sim:books",
        "//finance/augur/sim:holdings",
        "//finance/augur/sim:quantiles",
        "//finance/augur/sim:results",
        "//finance/augur/sim:world",
        "//finance/augur/x/bounded_spending:python_policy",
        "@pypi//numpy",
    ],
)

py_library(
    name = "policy",
    srcs = ["policy.py"],
    deps = [
        "//finance/augur/sim:actions",
        "//finance/augur/sim:agent",
        "//finance/augur/sim:books",
        "//finance/augur/sim:ids",
        "//finance/augur/sim:observations",
        "//finance/augur/x/allocation_glide:policy",
        "//finance/augur/x/bounded_spending:python_policy",
    ],
)

py_library(
    name = "situation",
    srcs = ["situation.py"],
    deps = [
        "//finance/augur/model:series",
        "//finance/augur/sim:bills",
        "//finance/augur/sim:books",
        "//finance/augur/sim:external_series",
        "//finance/augur/sim:fixed_point",
        "//finance/augur/sim:ids",
        "//finance/augur/sim:jurisdictions",
        "//finance/augur/sim:market_path",
        "//finance/augur/sim:prepared",
        "//finance/augur/sim:scenario",
        "//finance/augur/sim:tax_authority",
        "//finance/augur/sim:world",
        "//finance/augur/sim/compiler:execution",
        "//finance/augur/sim/compiler:tax",
        "@pypi//numpy",
    ],
)
