load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

# Only study/ and x/ may depend on this package: finance/augur/README.md § Stability tiers.
package(default_visibility = [
    "//finance/augur/study:__subpackages__",
    "//finance/augur/x:__subpackages__",
])

py_library(
    name = "profile",
    srcs = ["profile.py"],
    deps = [":run"],
)

py_binary(
    name = "profile_bin",
    main_module = "finance.augur.x.monthly_actions.profile",
    deps = [":profile"],
)

py_binary(
    name = "run_bin",
    main_module = "finance.augur.x.monthly_actions.run",
    deps = [":run"],
)

py_library(
    name = "run",
    srcs = ["run.py"],
    deps = [
        ":policy",
        "//finance/augur/model:series",
        "//finance/augur/sim:bills",
        "//finance/augur/sim:books",
        "//finance/augur/sim:claims",
        "//finance/augur/sim:external_series",
        "//finance/augur/sim:fixed_point",
        "//finance/augur/sim:ids",
        "//finance/augur/sim:income",
        "//finance/augur/sim:jurisdictions",
        "//finance/augur/sim:market_path",
        "//finance/augur/sim:money",
        "//finance/augur/sim:prepared",
        "//finance/augur/sim:results",
        "//finance/augur/sim:schedule",
        "//finance/augur/sim:session",
        "//finance/augur/sim:tax_authority",
        "//finance/augur/sim:tax_indexation",
        "//finance/augur/sim:tax_profile",
        "//finance/augur/sim:world",
        "@pypi//numpy",
    ],
)

py_test(
    name = "test_run",
    srcs = ["test_run.py"],
    data = [
        ":profile_bin",
        ":run_bin",
    ],
    deps = [
        ":run",
        "//:conftest",
        "//finance/augur:conftest",
        "//finance/augur/sim:books",
        "//finance/augur/sim:ids",
        "//finance/augur/sim:results",
        "//util/bazel:runfiles",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "policy",
    srcs = ["policy.py"],
    deps = [
        "//finance/augur/policy:cash_band",
        "//finance/augur/sim:actions",
        "//finance/augur/sim:fixed_point",
        "//finance/augur/sim:ids",
        "//finance/augur/sim:observations",
    ],
)

py_test(
    name = "test_policy",
    srcs = ["test_policy.py"],
    deps = [
        ":policy",
        ":run",
        "//:conftest",
        "//finance/augur:conftest",
        "//finance/augur/sim:bills",
        "//finance/augur/sim:books",
        "//finance/augur/sim:claims",
        "//finance/augur/sim:fixed_point",
        "//finance/augur/sim:ids",
        "//finance/augur/sim:income",
        "//finance/augur/sim:market_path",
        "//finance/augur/sim:money",
        "//finance/augur/sim:prepared",
        "//finance/augur/sim:results",
        "//finance/augur/sim:schedule",
        "//finance/augur/sim:session",
        "//finance/augur/sim:world",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
