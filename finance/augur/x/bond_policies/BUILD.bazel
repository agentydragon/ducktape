load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

# Only study/ and x/ may depend on this package: finance/augur/README.md § Stability tiers.
package(default_visibility = [
    "//finance/augur/study:__subpackages__",
    "//finance/augur/x:__subpackages__",
])

py_binary(
    name = "run_bin",
    main_module = "finance.augur.x.bond_policies.run",
    deps = [":run"],
)

py_library(
    name = "construction",
    srcs = ["construction.py"],
    deps = [
        "//finance/augur/model:bond_fund",
        "//finance/augur/model:nominal_bond",
        "//finance/augur/sim:bonds",
        "@pypi//jax",
        "@pypi//numpy",
    ],
)

py_library(
    name = "run",
    srcs = ["run.py"],
    deps = [
        ":construction",
        "//finance/augur/model:series",
        "//finance/augur/policy:funding",
        "//finance/augur/sim:bills",
        "//finance/augur/sim:books",
        "//finance/augur/sim:claims",
        "//finance/augur/sim:external_series",
        "//finance/augur/sim:fixed_point",
        "//finance/augur/sim:ids",
        "//finance/augur/sim:income",
        "//finance/augur/sim:market_path",
        "//finance/augur/sim:money",
        "//finance/augur/sim:prepared",
        "//finance/augur/sim:results",
        "//finance/augur/sim:schedule",
        "//finance/augur/sim:session",
        "//finance/augur/sim:world",
        "@pypi//numpy",
        "@pypi//pydantic",
    ],
)

py_test(
    name = "test_construction",
    srcs = ["test_construction.py"],
    deps = [
        ":construction",
        "//:conftest",
        "//finance/augur:conftest",
        "@pypi//numpy",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_run",
    srcs = ["test_run.py"],
    data = [":run_bin"],
    deps = [
        ":construction",
        ":run",
        "//:conftest",
        "//finance/augur:conftest",
        "//finance/augur/sim:results",
        "//util/bazel:runfiles",
        "@pypi//numpy",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
