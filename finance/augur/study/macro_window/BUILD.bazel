load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

# Only study/ and x/ may depend on this package: finance/augur/README.md § Stability tiers.
package(default_visibility = [
    "//finance/augur/study:__subpackages__",
    "//finance/augur/x:__subpackages__",
])

py_library(
    name = "compare",
    srcs = ["compare.py"],
    deps = [
        "//finance/augur/model:historical_windows",
        "//finance/augur/study/trinity:evidence_snapshot",
        "//finance/augur/x/models:macro_var",
        "//finance/augur/x/models:structural_macro",
        "//finance/augur/x/models:structural_macro_fit",
        "//finance/evidence:sources",
        "@pypi//numpy",
    ],
)

py_test(
    name = "compare_test",
    size = "medium",
    srcs = ["compare_test.py"],
    # Fetches the record from the public upstreams, so it is off CI's default filter for the
    # reason //finance/augur/study/trinity:replay_test is: an upstream outage must not redden an
    # unrelated PR. Run it by name when the window question is being decided.
    tags = ["manual"],
    deps = [
        ":compare",
        "//:conftest",
        "//finance/augur:conftest",
        "//finance/augur/x/models:structural_macro_fit",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "holdout",
    srcs = ["holdout.py"],
    deps = [
        "//finance/augur/fit:scoring",
        "//finance/augur/model:historical_windows",
        "//finance/augur/study/trinity:evidence_snapshot",
        "//finance/augur/x/models:macro_var",
        "//finance/augur/x/models:structural_macro",
        "//finance/augur/x/models:structural_macro_fit",
        "@pypi//jax",
        "@pypi//numpy",
        "@pypi//numpyro",
    ],
)

py_test(
    name = "holdout_test",
    size = "medium",
    srcs = ["holdout_test.py"],
    # Manual for the same reason :compare_test is: it fetches the record from the public
    # upstreams, and an upstream outage must not redden an unrelated PR. Run it by name when the
    # window question is being decided.
    tags = ["manual"],
    deps = [
        ":holdout",
        "//:conftest",
        "//finance/augur:conftest",
        "@pypi//numpy",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "mixed_windows",
    srcs = ["mixed_windows.py"],
    deps = [
        ":holdout",
        "//finance/augur/x/models:macro_var",
        "//finance/augur/x/models:structural_macro",
        "@pypi//numpy",
    ],
)

py_test(
    name = "mixed_windows_test",
    size = "medium",
    srcs = ["mixed_windows_test.py"],
    # Manual for the same reason :holdout_test is: it fetches the record from the public
    # upstreams, and an upstream outage must not redden an unrelated PR.
    tags = ["manual"],
    deps = [
        ":holdout",
        ":mixed_windows",
        "//:conftest",
        "//finance/augur:conftest",
        "@pypi//numpy",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "covariance_span_test",
    size = "medium",
    srcs = ["covariance_span_test.py"],
    # Manual for the same reason :holdout_test is: it fetches from the public upstreams.
    tags = ["manual"],
    deps = [
        ":holdout",
        ":mixed_windows",
        "//:conftest",
        "//finance/augur:conftest",
        "@pypi//numpy",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "stability",
    srcs = ["stability.py"],
    deps = [
        ":holdout",
        "//finance/augur/x/models:macro_var",
    ],
)

py_test(
    name = "test_stability_reporting",
    srcs = ["test_stability_reporting.py"],
    deps = [
        ":stability",
        "//:conftest",
        "//finance/augur:conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "demo_stability",
    srcs = ["demo_stability.py"],
    deps = [
        ":holdout",
        ":stability",
    ],
)

py_binary(
    name = "demo_stability_bin",
    main_module = "finance.augur.study.macro_window.demo_stability",
    deps = [":demo_stability"],
)
