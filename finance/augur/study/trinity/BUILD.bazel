load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "evidence_snapshot",
    srcs = ["evidence_snapshot.py"],
    deps = [
        "//finance/evidence:sources",
        "//finance/scraper:http_fetch",
    ],
)

py_library(
    name = "replay",
    srcs = ["replay.py"],
    deps = [
        ":evidence_snapshot",
        ":policy",
        ":synthetic",
        "//finance/augur/model:bond_fund",
        "//finance/augur/model:equity",
        "//finance/augur/model:historical_windows",
        "//finance/augur/model:series",
        "//finance/augur/rust:simulator_ext",
        "//finance/augur/sim:backend",
        "//finance/augur/sim:external_series",
        "//finance/augur/sim:scenario",
        "@pypi//numpy",
    ],
)

py_binary(
    name = "replay_bin",
    main_module = "finance.augur.study.trinity.replay",
    deps = [":replay"],
)

py_test(
    name = "replay_test",
    # Fetches the record from the public upstreams and runs ~55 474-rollout simulations, so it
    # is excluded from CI's default filter: an upstream outage must not redden an unrelated PR.
    # See the package README; throughput of the Python migration has not been measured here.
    size = "large",
    srcs = ["replay_test.py"],
    tags = ["manual"],
    deps = [
        ":evidence_snapshot",
        ":replay",
        "//:conftest",
        "//finance/augur:conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_actions",
    srcs = ["test_actions.py"],
    data = [":replay_bin"],
    deps = [
        ":replay",
        "//:conftest",
        "//finance/augur:conftest",
        "//finance/augur/model:series",
        "//finance/augur/sim:backend",
        "//finance/augur/sim:external_series",
        "//finance/augur/sim:scenario",
        "//util/bazel:runfiles",
        "@pypi//numpy",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_path_identity",
    srcs = ["test_path_identity.py"],
    deps = [
        ":replay",
        ":synthetic",
        "//:conftest",
        "//finance/augur:conftest",
        "//finance/augur/model:historical_windows",
        "//finance/augur/sim:backend",
        "//finance/augur/sim:external_series",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "policy",
    srcs = ["policy.py"],
    deps = [
        "//finance/augur/policy:sleeves",
        "//finance/augur/rust:simulator_ext",
    ],
)

py_library(
    name = "synthetic",
    srcs = ["synthetic.py"],
    deps = [
        "//finance/augur/model:historical_windows",
        "@pypi//numpy",
    ],
)
