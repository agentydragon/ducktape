load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "schema",
    srcs = ["schema.py"],
    deps = [
        "//finance/augur/api:schemas",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "wire",
    srcs = ["wire.py"],
    deps = [
        ":schema",
        "//finance/augur/api:schemas",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "sql_read_model",
    srcs = ["sql_read_model.py"],
    deps = [
        ":schema",
        ":wire",
        "//finance/augur:dates",
        "@pypi//sqlalchemy",
    ],
)

py_test(
    name = "test_sql_read_model",
    size = "medium",
    srcs = ["test_sql_read_model.py"],
    data = [
        "//plaid_utils:migrations",
        "//third_party/containers:postgres_18",
        "//third_party/containers:ryuk",
    ],
    requires_docker = True,
    deps = [
        ":schema",
        ":sql_read_model",
        "//:conftest",
        "//finance/augur:dates",
        "//plaid_utils:schema",
        "//third_party/containers:rlocations",
        "//util:oci",
        "//util/bazel:runfiles",
        "//util/testing:postgres",
        "@pypi//alembic",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
        "@pypi//testcontainers",
    ],
)

py_library(
    name = "csv_export",
    srcs = ["csv_export.py"],
    deps = [":wire"],
)

py_test(
    name = "test_csv_export",
    srcs = ["test_csv_export.py"],
    deps = [
        ":csv_export",
        ":schema",
        ":wire",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "service",
    srcs = ["service.py"],
    deps = [
        ":csv_export",
        ":schema",
        ":sql_read_model",
        ":wire",
    ],
)
