load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

# An engine's internals — its month loop and the output layout it writes — are visible only
# in here. Everything outside reads an engine through `sim/backend.py`, whose whole point is
# that the product does not name one engine's output shape. Convention did not hold that
# line before; this does.
package_group(
    name = "inside_the_simulator",
    packages = [
        "//finance/augur/sim/...",
    ],
)

py_library(
    name = "events",
    srcs = ["events.py"],
    deps = [
        "//finance/augur:frames",
        "@pypi//polars",
    ],
)

py_library(
    name = "external_series",
    srcs = ["external_series.py"],
    deps = [
        "//finance/augur/model:exogenous",
        "//finance/augur/model:private_equity_bundle",
        "//finance/augur/model:series",
        "//finance/augur/model:series_model",
        "@pypi//jaxtyping",
        "@pypi//numpy",
    ],
)

filegroup(
    name = "jurisdiction_data",
    srcs = glob(["data/jurisdictions/*.yaml"]),
)

filegroup(
    name = "location_data",
    srcs = glob(["data/locations/*.yaml"]),
)

py_library(
    name = "locations",
    srcs = ["locations.py"],
    deps = [
        ":fixed_point",
        "@pypi//pydantic",
    ],
)

py_test(
    name = "locations_test",
    size = "medium",
    srcs = ["locations_test.py"],
    data = [":location_data"],
    deps = [
        ":locations",
        "//:conftest",
        "//finance/augur:conftest",
        "@pypi//pytest_bazel",
        "@pypi//pyyaml",
    ],
)

