load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

# An engine's internals — its month loop and the output layout it writes — are visible only
# in here. Everything outside reads an engine through `sim/backend.py`, whose whole point is
# that the product does not name one engine's output shape. Convention did not hold that
# line before; this does.
package_group(
    name = "inside_the_simulator",
    packages = [
        # A benchmark measures an engine rather than reading its results as a product would,
        # and it times compilation and execution separately — which is naming the insides on
        # purpose. Routing it through the contract would move compilation out of the timed
        # region and quietly change what the published numbers mean.
        "//finance/augur/benchmark/...",
        "//finance/augur/sim/...",
    ],
)

py_library(
    name = "events",
    srcs = ["events.py"],
    deps = [
        "//finance/augur:frames",
        "@pypi//polars",
    ],
)

