py_test(
    name = "jax_backend_test",
    # Every acceptance case is its own scenario shape and so its own XLA compile, and the
    # 36-month property lifecycle is the longest of them. That per-case compile is what the
    # runtime is, and no two cases share a program, so splitting the cases splits the work
    # rather than duplicating it -- which is the condition py_test's shard_count asks for.
    # Serially the ~200 cases run past a medium timeout; Rust runs the same set in 17s.
    size = "medium",
    srcs = ["jax_backend_test.py"],
    shard_count = 4,
    deps = [
        ":jax_backend",
        "//:conftest",
        "//finance/augur:conftest",
        "//finance/augur/sim:backend",
        "//finance/augur/sim:conftest",
        "//finance/augur/sim/testing:behaviour",
        "//finance/augur/sim/testing:bonds",
        "//finance/augur/sim/testing:cash_conservation",
        "//finance/augur/sim/testing:deductions",
        "//finance/augur/sim/testing:engine_acceptance",
        "//finance/augur/sim/testing:frozen_rollout",
        "//finance/augur/sim/testing:income_sources",
        "//finance/augur/sim/testing:jax_result",
        "//finance/augur/sim/testing:private_equity",
        "//finance/augur/sim/testing:property_stakes",
        "//finance/augur/sim/testing:rental_lifecycle",
        "//finance/augur/sim/testing:rollout_independence",
        "//finance/augur/sim/testing:security_distributions",
        "//finance/augur/sim/testing:simulation_result",
        "//finance/augur/sim/testing:target_allocation",
        "//finance/augur/sim/testing:tax_statute",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
