load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

# Shared `augur_config` fixture for every augur test tree (api, product). pytest discovers it by
# walking up from each test; the per-package conftests depend on this target so it lands in their
# runfiles.
py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    deps = [
        "//finance/augur/api:config",
        "//finance/augur/fit:synthetic_evidence",
        "//finance/augur/model:series",
        "//finance/augur/model:testing",
        "//finance/augur/product:testing",
        "//util/bazel:runfiles",
        "@pypi//pytest",
    ],
)

py_library(
    name = "dates",
    srcs = ["dates.py"],
)

py_test(
    name = "dates_test",
    srcs = ["dates_test.py"],
    deps = [
        ":dates",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "dev_server_lib",
    srcs = ["dev_server.py"],
    deps = [
        "//finance/augur/api:config",
        "//finance/augur/api:server_lib",
        "//finance/augur/calibration:default_clients",
        "//finance/augur/calibration:platform",
        "//util/bazel:runfiles",
        "@pypi//fastapi",
    ],
)

py_binary(
    name = "dev",
    data = [
        "//finance/augur/api:public_fixture_calibration_catalog",
        "//finance/augur/api:public_fixture_config",
        "//finance/augur/api:public_fixture_properties",
        "//finance/augur/frontend:bundle_base",
    ],
    env = {
        "AUGUR_BUNDLE_INDEX_RUNFILE": "_main/finance/augur/frontend/dist/index.html",
        "AUGUR_CONFIG_PATH": "$(location //finance/augur/api:public_fixture_config)",
    },
    main_module = "finance.augur.dev_server",
    deps = [":dev_server_lib"],
)

py_test(
    name = "browser_shell_test",
    size = "large",
    srcs = ["browser_shell_test.py"],
    data = [
        ":dev",
        "//finance/augur/api:public_fixture_calibration_catalog",
        "//finance/augur/api:public_fixture_config",
        "//finance/augur/api:public_fixture_properties",
        "@playwright_browsers//:chromium-headless-shell",
    ],
    env = {
        "AUGUR_BUNDLE_INDEX_RUNFILE": "_main/finance/augur/frontend/dist/index.html",
        "CHROMIUM_HEADLESS_SHELL": "$(rootpath @playwright_browsers//:chromium-headless-shell)",
    },
    deps = [
        "//util:net",
        "//util:playwright",
        "//util/bazel:runfiles",
        "//util/testing:undeclared_outputs",
        "@pypi//playwright",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "frames",
    srcs = ["frames.py"],
    deps = [
        "@pypi//polars",
    ],
)

py_test(
    name = "visual_test",
    size = "large",
    srcs = ["visual_test.py"],
    data = [
        "//finance/augur/api:public_fixture_calibration_catalog",
        "//finance/augur/api:public_fixture_config",
        "//finance/augur/api:public_fixture_properties",
        "//finance/augur/frontend:bundle_base",
        "//finance/augur/frontend:visual_golden_snapshots",
        "//util/testing/frontend_visual:fonts",
        "//util/testing/frontend_visual:fonts_conf",
        "@playwright_browsers//:chromium-headless-shell",
    ],
    env = {
        "AUGUR_BUNDLE_INDEX_RUNFILE": "_main/finance/augur/frontend/dist/index.html",
        "CHROMIUM_HEADLESS_SHELL": "$(rootpath @playwright_browsers//:chromium-headless-shell)",
        "FONTCONFIG_FILE": "$(rootpath //util/testing/frontend_visual:fonts_conf)",
        "FREETYPE_PROPERTIES": "cff:no-stem-darkening=1",
    },
    deps = [
        ":dev_server_lib",
        "//finance/augur:conftest",
        "//finance/augur/api:config",
        "//finance/augur/calibration:catalog",
        "//finance/augur/calibration:testing",
        "//finance/evidence:markets",
        "//util:net",
        "//util:playwright",
        "//util/bazel:runfiles",
        "//util/testing:frontend_visual",
        "//util/testing:png_diff",
        "//util/testing:undeclared_outputs",
        "@pypi//playwright",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//uvicorn",
    ],
)
