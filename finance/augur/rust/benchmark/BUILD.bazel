load("@rules_rust//rust:defs.bzl", "rust_binary")
load("//devinfra/python:defs.bzl", "py_binary", "py_library")

# Measurement, not production: this writes out the feature-rich case, which is scenario
# scaffolding under `sim/testing/`, and Bazel is right to refuse a production target that
# reads it. Matches the call `//finance/augur/benchmark` makes for the same reason.
package(
    default_testonly = True,
    default_visibility = ["//visibility:public"],
)

rust_binary(
    name = "simulator_bench",
    srcs = ["main.rs"],
    edition = "2024",
    deps = [
        "//finance/augur/rust:simulator",
        "@crates//:serde",
        "@crates//:serde_json",
    ],
)

py_binary(
    name = "fixture_bin",
    imports = ["../../../.."],
    main_module = "finance.augur.rust.benchmark.fixture",
    deps = [":fixture"],
)

py_binary(
    name = "driver_bin",
    data = [":simulator_bench"],
    imports = ["../../../.."],
    main_module = "finance.augur.rust.benchmark.driver",
    deps = [":driver"],
)

py_library(
    name = "driver",
    srcs = ["driver.py"],
    deps = [
        ":fixture",
        "@rules_python//python/runfiles",
    ],
)

py_library(
    name = "fixture",
    srcs = ["fixture.py"],
    deps = [
        "//finance/augur/benchmark:scenario",
        "//finance/augur/rust/differential:fixture",
    ],
)
