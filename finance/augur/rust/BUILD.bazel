# Test scaffolding: it derives an engine's input from a `Case`, which is `sim/testing/`.
py_library(
    name = "case_fixture",
    testonly = True,
    srcs = ["case_fixture.py"],
    deps = ["//finance/augur/sim/testing:case"],
)

# Test scaffolding: it projects a run into the shape the behavioural suites read.
py_library(
    name = "result",
    testonly = True,
    srcs = ["result.py"],
    deps = [
        ":case_fixture",
        ":event_log",
        "//finance/augur/rust:simulator_ext",
        "//finance/augur/sim:scenario",
        "//finance/augur/sim/testing:case",
        "//finance/augur/sim/testing:simulation_result",
        "@pypi//polars",
    ],
)

