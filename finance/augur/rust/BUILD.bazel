load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_shared_library", "rust_test")
load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "native_invocation",
    srcs = ["invocation.rs"],
    crate_name = "augur_native_invocation",
    edition = "2024",
    deps = [
        ":simulator",
        "@crates//:serde",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "native_invocation_test",
    crate = ":native_invocation",
)

# `simulator` is a `rust_shared_library` staged as `simulator.so`; there is no `.py` for
# gazelle's import scan to resolve against.
# gazelle:resolve py finance.augur.rust.simulator //finance/augur/rust:simulator_ext

rust_library(
    name = "simulator",
    srcs = [
        "allocation.rs",
        "engine.rs",
        "engine/accounts.rs",
        "engine/allocation.rs",
        "engine/cashflows.rs",
        "engine/claims.rs",
        "engine/errors.rs",
        "engine/obligations.rs",
        "engine/observations.rs",
        "engine/payments.rs",
        "engine/payments_test.rs",
        "engine/private_equity.rs",
        "engine/property.rs",
        "engine/recorder.rs",
        "engine/securities.rs",
        "engine/spending.rs",
        "engine/spending/batch.rs",
        "engine/target_allocation.rs",
        "engine/taxes.rs",
        "engine/tests.rs",
        "engine/tlh.rs",
        "engine/trades.rs",
        "engine/trades_test.rs",
        "engine/validation.rs",
        "event_frames.rs",
        "execution.rs",
        "holdings.rs",
        "ledger.rs",
        "lib.rs",
        "money.rs",
        "money_proptest.rs",
        "product.rs",
        "property.rs",
        "tax.rs",
    ],
    crate_name = "augur_rust_simulator",
    edition = "2024",
    deps = [
        "@crates//:rayon",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:thiserror",
    ],
)

rust_binary(
    name = "simulator_cli",
    srcs = ["main.rs"],
    edition = "2024",
    deps = [
        ":simulator",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "simulator_test",
    crate = ":simulator",
    deps = ["@crates//:proptest"],
)

# The CPython extension module. `crate_name` is what names the emitted
# `libsimulator.so`; `simulator` must also be the `#[pymodule]` function name and the
# final file stem, or the interpreter refuses the module on import.
rust_shared_library(
    name = "simulator_pyo3",
    srcs = ["python.rs"],
    crate_name = "simulator",
    crate_root = "python.rs",
    edition = "2024",
    deps = [
        ":simulator",
        "@crates//:pyo3",
        "@crates//:serde_json",
    ],
)

copy_file(
    name = "simulator_so",
    src = ":simulator_pyo3",
    out = "simulator.so",
    allow_symlink = True,
)

# `simulator.pyi` is the extension's only type surface — the `.so` carries no Python
# source for mypy to read.
py_library(
    name = "simulator_ext",
    data = [
        "simulator.pyi",
        ":simulator_so",
    ],
    imports = ["../../.."],
)

py_test(
    name = "batch_test",
    srcs = ["batch_test.py"],
    deps = [
        "//:conftest",
        "//finance/augur:conftest",
        "//finance/augur/model:series",
        "//finance/augur/rust:simulator_ext",
