load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_shared_library", "rust_test")
load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

# `simulator` is a `rust_shared_library` staged as `simulator.so`; there is no `.py` for
# gazelle's import scan to resolve against.
# gazelle:resolve py finance.augur.rust.simulator //finance/augur/rust:simulator_ext

rust_library(
    name = "simulator",
    srcs = [
        "allocation.rs",
        "engine.rs",
        "engine/accounts.rs",
        "engine/cashflows.rs",
        "engine/errors.rs",
        "engine/obligations.rs",
        "engine/private_equity.rs",
        "engine/property.rs",
        "engine/recorder.rs",
        "engine/securities.rs",
        "engine/target_allocation.rs",
        "engine/taxes.rs",
        "engine/tests.rs",
        "engine/tlh.rs",
        "engine/validation.rs",
        "event_frames.rs",
        "fixture.rs",
        "ledger.rs",
        "lib.rs",
        "money.rs",
        "product.rs",
        "tax.rs",
    ],
    crate_name = "augur_rust_simulator",
    edition = "2024",
    deps = [
        "@crates//:rayon",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:thiserror",
    ],
)

rust_binary(
    name = "simulator_cli",
    srcs = ["main.rs"],
    edition = "2024",
    deps = [
        ":simulator",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "simulator_test",
    crate = ":simulator",
)

# The CPython extension module. `crate_name` is what names the emitted
# `libsimulator.so`; `simulator` must also be the `#[pymodule]` function name and the
# final file stem, or the interpreter refuses the module on import.
rust_shared_library(
    name = "simulator_pyo3",
    srcs = ["python.rs"],
    crate_name = "simulator",
    crate_root = "python.rs",
    edition = "2024",
    deps = [
        ":simulator",
        "@crates//:pyo3",
        "@crates//:serde_json",
    ],
)

copy_file(
    name = "simulator_so",
    src = ":simulator_pyo3",
    out = "simulator.so",
    allow_symlink = True,
)

# `simulator.pyi` is the extension's only type surface — the `.so` carries no Python
# source for mypy to read.
py_library(
    name = "simulator_ext",
    data = [
        "simulator.pyi",
        ":simulator_so",
    ],
    imports = ["../../.."],
)

py_library(
    name = "backend",
    srcs = ["backend.py"],
    deps = [
        ":event_log",
        ":fixture_encoder",
        "//finance/augur/product:metric_composition",
        "//finance/augur/product:quantiles",
        "//finance/augur/rust:simulator_ext",
        "//finance/augur/sim:backend",
        "//finance/augur/sim:events",
        "//finance/augur/sim:product_metrics",
        "@pypi//jaxtyping",
        "@pypi//numpy",
    ],
)

py_library(
    name = "fixture_encoder",
    srcs = ["fixture_encoder.py"],
    deps = [
        "//finance/augur/model:private_equity_bundle",
        "//finance/augur/model:series",
        "//finance/augur/product:asset_key",
        "//finance/augur/sim:bonds",
        "//finance/augur/sim:external_series",
        "//finance/augur/sim:fixed_point",
        "//finance/augur/sim:jurisdictions",
        "//finance/augur/sim:locations",
        "//finance/augur/sim:scenario",
        "//finance/augur/sim/compiler:plan",
        "//finance/augur/sim/compiler:tax",
        "@pypi//jaxtyping",
        "@pypi//numpy",
    ],
)

py_library(
    name = "fixture_spec",
    srcs = ["fixture_spec.py"],
    deps = ["@pypi//more_itertools"],
)

py_library(
    name = "event_log",
    srcs = ["event_log.py"],
    deps = [
        "//finance/augur:frames",
        "//finance/augur/sim:events",
        "@pypi//polars",
    ],
)

py_test(
    name = "backend_test",
    srcs = ["backend_test.py"],
    deps = [
        ":backend",
        ":result",
        "//:conftest",
        "//finance/augur:conftest",
        "//finance/augur/sim:backend",
        "//finance/augur/sim/testing:engine_acceptance",
        "//finance/augur/sim/testing:rollout_independence",
        "//finance/augur/sim/testing:simulation_result",
        "//finance/augur/sim/testing:tax_statute",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

# Test scaffolding: it derives an engine's input from a `Case`, which is `sim/testing/`.
py_library(
    name = "case_fixture",
    testonly = True,
    srcs = ["case_fixture.py"],
    deps = [
        ":fixture_encoder",
        "//finance/augur/sim/testing:case",
    ],
)

# Test scaffolding: it projects a run into the shape the behavioural suites read.
py_library(
    name = "result",
    testonly = True,
    srcs = ["result.py"],
    deps = [
        ":case_fixture",
        ":event_log",
        "//finance/augur/rust:simulator_ext",
        "//finance/augur/sim:scenario",
        "//finance/augur/sim/testing:case",
        "//finance/augur/sim/testing:simulation_result",
        "@pypi//polars",
    ],
)
