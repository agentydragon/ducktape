# The CPython extension module. `crate_name` is what names the emitted
# `lib_simulator.so`; `_simulator` must also be the `#[pymodule]` function name and the
# final file stem, or the interpreter refuses the module on import.
rust_shared_library(
    name = "simulator_pyo3",
    srcs = [
        "action_bindings.rs",
        "python.rs",
    ],
    crate_name = "_simulator",
    crate_root = "python.rs",
    edition = "2024",
    deps = [
        ":simulator",
        "@crates//:pyo3",
        "@crates//:serde",
        "@crates//:serde_json",
    ],
)

copy_file(
    name = "simulator_so",
    src = ":simulator_pyo3",
    out = "_simulator.so",
    allow_symlink = True,
)

# `_simulator.pyi` is the extension's only type surface — the `.so` carries no Python
# source for mypy to read.
py_library(
    name = "simulator_ext",
    data = [
        "_simulator.pyi",
        ":simulator_so",
    ],
    imports = ["../../.."],
    deps = [
        ":prepared",  # Imported by the native boundary; not visible to Gazelle.
        "//finance/augur/sim:prepared",
        "//finance/augur/sim:results",
    ],
)

