load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_shared_library", "rust_test")
load("//devinfra/python:defs.bzl", "py_binary", "py_library")

package(default_visibility = ["//visibility:public"])

# `simulator` is a `rust_shared_library` staged as `simulator.so`; there is no `.py` for
# gazelle's import scan to resolve against.
# gazelle:resolve py finance.augur.rust.simulator //finance/augur/rust:simulator_ext

rust_library(
    name = "simulator",
    srcs = [
        "allocation.rs",
        "engine.rs",
        "fixture.rs",
        "ledger.rs",
        "lib.rs",
        "money.rs",
        "product.rs",
        "tax.rs",
    ],
    crate_name = "augur_rust_simulator",
    edition = "2024",
    deps = [
        "@crates//:rayon",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:thiserror",
    ],
)

rust_binary(
    name = "simulator_cli",
    srcs = ["main.rs"],
    edition = "2024",
    deps = [
        ":simulator",
        "@crates//:serde_json",
    ],
)

rust_binary(
    name = "simulator_bench",
    srcs = ["benchmark.rs"],
    edition = "2024",
    deps = [
        ":simulator",
        "@crates//:serde",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "simulator_test",
    crate = ":simulator",
)

# The CPython extension module. `crate_name` is what names the emitted
# `libsimulator.so`; `simulator` must also be the `#[pymodule]` function name and the
# final file stem, or the interpreter refuses the module on import.
rust_shared_library(
    name = "simulator_pyo3",
    srcs = ["python.rs"],
    crate_name = "simulator",
    crate_root = "python.rs",
    edition = "2024",
    deps = [
        ":simulator",
        "@crates//:pyo3",
        "@crates//:serde_json",
    ],
)

copy_file(
    name = "simulator_so",
    src = ":simulator_pyo3",
    out = "simulator.so",
    allow_symlink = True,
)

# `simulator.pyi` is the extension's only type surface — the `.so` carries no Python
# source for mypy to read.
py_library(
    name = "simulator_ext",
    data = [
        "simulator.pyi",
        ":simulator_so",
    ],
    imports = ["../../.."],
)

py_binary(
    name = "benchmark_fixture_bin",
    imports = ["../../.."],
    main_module = "finance.augur.rust.benchmark_fixture",
    deps = [":benchmark_fixture"],
)

py_library(
    name = "backend",
    srcs = ["backend.py"],
    deps = [
        "//finance/augur/product:metric_composition",
        "//finance/augur/product:quantiles",
        "//finance/augur/rust:simulator_ext",
        "//finance/augur/sim:product_metrics",
        "@pypi//jaxtyping",
        "@pypi//numpy",
    ],
)

py_binary(
    name = "benchmark_driver_bin",
    data = [":simulator_bench"],
    imports = ["../../.."],
    main_module = "finance.augur.rust.benchmark_driver",
    deps = [":benchmark_driver"],
)

py_binary(
    name = "jax_benchmark_driver_bin",
    imports = ["../../.."],
    main_module = "finance.augur.rust.jax_benchmark_driver",
    deps = [":jax_benchmark_driver"],
)

py_library(
    name = "benchmark_driver",
    srcs = ["benchmark_driver.py"],
    deps = [
        ":benchmark_fixture",
        "@rules_python//python/runfiles",
    ],
)

py_library(
    name = "benchmark_fixture",
    srcs = ["benchmark_fixture.py"],
)

py_library(
    name = "jax_benchmark_driver",
    srcs = ["jax_benchmark_driver.py"],
    deps = [
        ":benchmark_fixture",
        "//finance/augur/rust/differential:fixture_adapter",
        "//finance/augur/sim:events",
        "//finance/augur/sim:simulate",
        "@pypi//jax",
        "@pypi//numpy",
    ],
)
