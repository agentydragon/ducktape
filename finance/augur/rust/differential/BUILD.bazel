)

# Drives the testonly `backend` layer, so it is testonly too.
py_library(
    name = "campaign",
    testonly = True,
    srcs = ["campaign.py"],
    deps = [
        ":backend",
        ":generator",
        ":shrink",
        "//util/testing:undeclared_outputs",
    ],
)

py_library(
    name = "generator",
    srcs = ["generator.py"],
