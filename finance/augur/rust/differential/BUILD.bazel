load("//devinfra/python:defs.bzl", "py_library", "py_test")

# The whole harness is scaffolding: it authors cases with `sim/testing/`, runs both engines
# and compares them. Nothing in production reads any of it, and Bazel is right to refuse a
# production target that names it.
package(
    default_testonly = True,
    default_visibility = ["//visibility:public"],
)

# Shared across the suites below; the single-suite cases live in the suite that uses them.
py_library(
    name = "fixtures",
    srcs = ["fixtures.py"],
    deps = [
        "//finance/augur/model:series",
        "//finance/augur/sim:locations",
        "//finance/augur/sim:scenario",
        "//finance/augur/sim/testing:case",
        "@pypi//jaxtyping",
        "@pypi//numpy",
    ],
)

