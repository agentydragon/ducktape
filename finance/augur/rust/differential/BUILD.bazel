load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "fixture_adapter",
    srcs = ["fixture_adapter.py"],
    deps = [
        "//finance/augur/model:private_equity_bundle",
        "//finance/augur/model:series",
        "//finance/augur/product:asset_key",
        "//finance/augur/sim:external_series",
        "//finance/augur/sim:fixed_point",
        "//finance/augur/sim:locations",
        "//finance/augur/sim:scenario",
        "//finance/augur/sim:simulate",
        "//finance/augur/sim:tlh_harvest",
        "@pypi//numpy",
    ],
)

# Shared across the suites below; the single-suite fixtures live in the suite that
# uses them. `rust_run` shells out to the simulator, so every dependent needs the
# binary in its runfiles.
py_library(
    name = "fixtures",
    testonly = True,
    srcs = ["fixtures.py"],
    data = ["//finance/augur/rust:simulator_cli"],
    deps = [
        ":fixture_adapter",
        "//finance/augur/rust/benchmark:fixture",
        "//finance/augur/sim:runtime",
        "//finance/augur/sim/compiler:plan",
        "@pypi//polars",
    ],
)

py_library(
    name = "output_adapter",
    srcs = ["output_adapter.py"],
    deps = [
        "//finance/augur:frames",
        "//finance/augur/sim:events",
        "@pypi//polars",
    ],
)

