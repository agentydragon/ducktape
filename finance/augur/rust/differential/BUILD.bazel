# Reads the JAX engine through `sim/testing/state_helpers`, so the layer is testonly like
# the fixtures beside it.
py_library(
    name = "backend",
    testonly = True,
    srcs = ["backend.py"],
    deps = [
        ":fixture_adapter",
        ":output_adapter",
        "//finance/augur/rust:simulator_ext",
        "//finance/augur/sim:events",
        "//finance/augur/sim/testing:state_helpers",
        "@pypi//polars",
    ],
)

