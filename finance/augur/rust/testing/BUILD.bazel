load("//devinfra/python:defs.bzl", "py_library")

package(
    default_testonly = True,
    default_visibility = ["//visibility:public"],
)

py_library(
    name = "fixtures",
    srcs = ["fixtures.py"],
    # `rust_run` shells out to the simulator, so every suite that imports these fixtures
    # needs the binary in its runfiles.
    data = ["//finance/augur/rust:simulator_cli"],
    deps = [
        "//finance/augur/rust:benchmark_fixture",
        "//finance/augur/rust:fixture_adapter",
        "//finance/augur/rust:output_adapter",
        "//finance/augur/sim:runtime",
        "//finance/augur/sim/compiler:plan",
        "//finance/augur/sim/testing:state_helpers",
        "@pypi//polars",
    ],
)
