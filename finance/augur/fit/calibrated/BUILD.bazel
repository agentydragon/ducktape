load("//devinfra/python:defs.bzl", "py_test")

package(default_visibility = ["//visibility:public"])

# Quarantined: fails `sanity_test` (reason and numbers in its `QUARANTINED`). Kept as a real
# sample of the typed observation boundary, never as a model.
filegroup(
    name = "trained_vecm_provider",
    srcs = ["trained_vecm_provider.yaml"],
)

# Checked-in structural_macro fit — produced by `bb run //finance/augur/fit:train -- --model
# structural_macro ...` and loaded via runfiles as StructuralMacroProviderConfig's/EquityProcess's
# shipped defaults (see model/structural_macro.py's `_fitted_defaults`). Unlike the VECM
# provider config, this isn't itself a deployable ProviderConfig — deployment-specific fields
# (equity symbol, instruments) aren't fit outputs, so they stay in the deployment YAML.
filegroup(
    name = "trained_structural_macro_blob",
    srcs = ["trained_structural_macro.yaml"],
)

py_test(
    name = "sanity_test",
    size = "medium",
    srcs = ["sanity_test.py"],
    # Every checked-in artifact, so a new one is checked without editing this rule.
    data = glob(["*.yaml"]),
    deps = [
        "//:conftest",
        "//finance/augur:conftest",
        "//finance/augur/fit:conftest",
        "//finance/augur/fit:model",
        "//finance/augur/model:equity",
        "//finance/augur/model:exogenous",
        "//finance/augur/model:series",
        "//finance/augur/model:structural_macro",
        "//finance/augur/model:vecm",
        "//finance/augur/model/path_models:scenarios",
        "@pypi//numpy",
        "@pypi//numpyro",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//pyyaml",
    ],
)
