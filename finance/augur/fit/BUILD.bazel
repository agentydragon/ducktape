py_test(
    name = "test_dilution_prior",
    srcs = ["test_dilution_prior.py"],
    deps = [
        ":dilution_prior",
        ":private_equity",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_bayes_dilution",
    size = "large",
    srcs = ["test_bayes_dilution.py"],
    deps = [
        ":bayes_dilution",
        ":private_equity",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
