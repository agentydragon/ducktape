load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "evidence_data",
    srcs = ["evidence_data.py"],
    deps = [
        "//finance/augur/model:conditioning",
        "//finance/augur/model:evidence",
        "//finance/augur/model:series",
        "//finance/evidence:loading",
        "//finance/evidence:sources",
        "@pypi//numpy",
        "@pypi//polars",
    ],
)

py_library(
    name = "synthetic_evidence",
    testonly = True,
    srcs = ["synthetic_evidence.py"],
    deps = [
        "//finance/evidence:loading",
        "//finance/evidence:sources",
        "@pypi//pytest",
    ],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    deps = [":synthetic_evidence"],
)

py_library(
    name = "model",
    srcs = ["model.py"],
    deps = [
        "//finance/augur/model/path_models:scenarios",
        "@pypi//numpyro",
    ],
)

py_library(
    name = "scoring",
    srcs = ["scoring.py"],
    deps = [
        "@pypi//jax",
        "@pypi//numpy",
        "@pypi//numpyro",
    ],
)

py_library(
    name = "metrics",
    srcs = ["metrics.py"],
    deps = [
        ":model",
        ":scoring",
        "//finance/augur/model/path_models:scenarios",
        "@pypi//numpy",
    ],
)

py_library(
    name = "data",
    srcs = ["data.py"],
    deps = [
        ":evidence_data",
        "//finance/augur/model:conditioning",
        "//finance/augur/model:evidence",
        "//finance/augur/model:series",
        "//finance/augur/model/path_models:scenarios",
        "//finance/evidence:loading",
        "//finance/evidence:sources",
        "@pypi//numpy",
    ],
)

py_test(
    name = "data_test",
    size = "medium",
    srcs = ["data_test.py"],
    deps = [
        ":conftest",
        ":data",
        ":evidence_data",
        "//:conftest",
        "//finance/augur:conftest",
        "//finance/augur/model:conditioning",
        "//finance/augur/model:series",
        "//finance/evidence:sources",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "metrics_test",
    srcs = ["metrics_test.py"],
    deps = [
        ":conftest",
        ":metrics",
        "//:conftest",
        "//finance/augur:conftest",
        "//finance/augur/model:series",
        "//finance/augur/model/path_models:scenarios",
        "@pypi//jax",
        "@pypi//numpy",
        "@pypi//numpyro",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
