py_test(
    name = "test_bayes_mint_streams",
    size = "large",
    srcs = ["test_bayes_mint_streams.py"],
    deps = [
        ":bayes_mint_streams",
        ":private_equity",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
