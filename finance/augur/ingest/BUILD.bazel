load("@aspect_rules_py//py:defs.bzl", "py_image_layer", aspect_py_binary = "py_binary")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")
load("//props:oci.bzl", "py_image_entrypoint", "py_image_env")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "http_fetch",
    srcs = ["http_fetch.py"],
    deps = [
        "@pypi//certifi",
        "@pypi//httpx",
        "@pypi//tenacity",
    ],
)

py_library(
    name = "fetch",
    srcs = ["fetch.py"],
    deps = [
        ":http_fetch",
        "//finance/evidence:sources",
        "@pypi//pygit2",
    ],
)

py_binary(
    name = "evidence",
    main_module = "finance.augur.ingest.fetch",
    deps = [":fetch"],
)

py_test(
    name = "test_ingest",
    srcs = ["test_ingest.py"],
    deps = [
        ":fetch",
        ":http_fetch",
        "//:conftest",
        "//finance/evidence:sources",
        "@pypi//httpx",
        "@pypi//pygit2",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",
        "@pypi//pytest_bazel",
    ],
)

# ── OCI image: augur-evidence (git-scrape CronJob) ──────────────────────
# ca-certificates apt layer (@trixie_evidence): pygit2's Settings() eagerly loads
# libgit2's OpenSSL cert locations from the system trust store at *import* time, so
# `import pygit2` raises GitError on the bare slim base (no CA bundle) before the
# scraper does anything. The certs are needed only to satisfy that init — libgit2
# push targets in-cluster Forgejo over plain HTTP, and the upstream HTTPS GETs use
# certifi via httpx (see http_fetch).
aspect_py_binary(
    name = "evidence_image_bin",
    main = "fetch.py",
    deps = [":fetch"],
)

py_image_layer(
    name = "layers",
    binary = ":evidence_image_bin",
    group = "1000",
    owner = "1000",
)

oci_image(
    name = "image",
    base = "@debian_trixie_slim_linux_amd64",
    entrypoint = py_image_entrypoint("evidence_image_bin"),
    env = py_image_env(binary_name = "evidence_image_bin"),
    labels = {
        "org.opencontainers.image.source": "https://github.com/agentydragon/ducktape",
        "org.opencontainers.image.title": "augur-evidence",
    },
    tars = [
        ":layers",
        "@trixie_evidence//:flat",
    ],
    user = "1000:1000",
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["augur-evidence:latest"],
)
