load("@aspect_rules_py//py:defs.bzl", "py_image_layer", aspect_py_binary = "py_binary")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")
load("//props:oci.bzl", "py_image_entrypoint", "py_image_env")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "evidence_sources",
    srcs = ["evidence_sources.py"],
)

py_library(
    name = "http_fetch",
    srcs = ["http_fetch.py"],
    deps = [
        "@pypi//certifi",
        "@pypi//tenacity",
    ],
)

py_library(
    name = "fetch",
    srcs = ["fetch.py"],
    deps = [
        ":evidence_sources",
        ":http_fetch",
        "@pypi//pygit2",
    ],
)

py_binary(
    name = "evidence",
    main_module = "finance.augur.ingest.fetch",
    deps = [":fetch"],
)

py_test(
    name = "test_evidence_sources",
    srcs = ["test_evidence_sources.py"],
    deps = [
        ":evidence_sources",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_ingest",
    srcs = ["test_ingest.py"],
    deps = [
        ":evidence_sources",
        ":fetch",
        ":http_fetch",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

# ── OCI image: augur-evidence (git-scrape CronJob) ──────────────────────
# No apt layer: pygit2's manylinux wheel bundles libgit2 + its TLS backend, the
# push targets in-cluster Forgejo over plain HTTP, and the upstream HTTPS GETs
# pin certifi's CA bundle (see http_fetch). So the slim base needs nothing extra.
aspect_py_binary(
    name = "evidence_image_bin",
    main = "fetch.py",
    deps = [":fetch"],
)

py_image_layer(
    name = "layers",
    binary = ":evidence_image_bin",
    group = "1000",
    owner = "1000",
)

oci_image(
    name = "image",
    base = "@debian_trixie_slim_linux_amd64",
    entrypoint = py_image_entrypoint("evidence_image_bin"),
    env = py_image_env(binary_name = "evidence_image_bin"),
    labels = {
        "org.opencontainers.image.source": "https://github.com/agentydragon/ducktape",
        "org.opencontainers.image.title": "augur-evidence",
    },
    tars = [":layers"],
    user = "1000:1000",
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["augur-evidence:latest"],
)
