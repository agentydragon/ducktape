load("//devinfra/python:defs.bzl", "py_binary", "py_library")

# Measurement, not production: the benchmark exists to time an engine, and it reads the
# scenario scaffolding in `sim/testing/` to do it.
package(
    default_testonly = True,
    default_visibility = ["//visibility:public"],
)

py_binary(
    name = "driver_bin",
    main_module = "finance.augur.benchmark.driver",
    deps = [":driver"],
)

py_library(
    name = "scenario",
    srcs = ["scenario.py"],
    deps = [
        "//finance/augur/model:asset_key",
        "//finance/augur/model:private_equity_bundle",
        "//finance/augur/model:series",
        "//finance/augur/sim:locations",
        "//finance/augur/sim:scenario",
        "//finance/augur/sim:tlh",
        "//finance/augur/sim/testing:case",
        "@pypi//jaxtyping",
        "@pypi//numpy",
    ],
)
