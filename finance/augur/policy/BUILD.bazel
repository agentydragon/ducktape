load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "cash_band",
    srcs = ["cash_band.py"],
)

py_library(
    name = "sleeves",
    srcs = ["sleeves.py"],
    deps = [
        "//finance/augur/sim:actions",
        "//finance/augur/sim:fixed_point",
        "//finance/augur/sim:observations",
    ],
)

py_test(
    name = "test_cash_band",
    srcs = ["test_cash_band.py"],
    deps = [
        ":cash_band",
        "//:conftest",
        "//finance/augur:conftest",
        "//finance/augur/sim:fixed_point",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_sleeves",
    srcs = ["test_sleeves.py"],
    deps = [
        ":sleeves",
        "//:conftest",
        "//finance/augur:conftest",
        "//finance/augur/model:series",
        "//finance/augur/sim:actions",
        "//finance/augur/sim:books",
        "//finance/augur/sim:prepared",
        "//finance/augur/sim:results",
        "//finance/augur/sim:scenario",
        "//finance/augur/sim:session",
        "//finance/augur/sim/testing:case",
        "//finance/augur/sim/testing:fixtures",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "funding",
    srcs = ["funding.py"],
    deps = [
        ":sleeves",
        "//finance/augur/sim:actions",
        "//finance/augur/sim:observations",
    ],
)

py_library(
    name = "configured_allocation",
    srcs = ["configured_allocation.py"],
    deps = [
        ":cash_band",
        ":sleeves",
        "//finance/augur/sim:actions",
        "//finance/augur/sim:fixed_point",
        "//finance/augur/sim:observations",
        "//finance/augur/sim:prepared",
    ],
)

py_test(
    name = "configured_allocation_test",
    srcs = ["configured_allocation_test.py"],
    deps = [
        ":configured_allocation",
        ":sleeves",
        "//:conftest",
        "//finance/augur:conftest",
        "//finance/augur/sim:actions",
        "//finance/augur/sim:books",
        "//finance/augur/sim:observations",
        "//finance/augur/sim:prepared",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
