)

py_test(
    name = "export_schema_test",
    size = "medium",
    srcs = ["test_export_schema.py"],
    # Source follows the test_<module>.py convention while the target keeps the
    # conventional <name>_test label, so the inferred main wouldn't match srcs.
    main = "test_export_schema.py",
    deps = [
        ":export_schema",
        "@pypi//pytest_bazel",
    ],
)

filegroup(
    name = "public_fixture_config",
    srcs = ["testdata/config.yaml"],
)

filegroup(
    name = "public_fixture_properties",
    srcs = ["testdata/properties.json"],
)

# The public fixture config registers a calibration catalog at
# `../../calibration/example_openai_catalog.yaml`; anything that loads that config at
# startup (the server binary under test, the calibration endpoint test) needs the
# catalog in its runfiles at the resolved path.
filegroup(
    name = "public_fixture_calibration_catalog",
    srcs = ["//finance/augur/calibration:example_openai_catalog"],
)

py_test(
    name = "test_export_schema",
