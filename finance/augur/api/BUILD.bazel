aspect_py_binary(
    name = "server_image_binary",
    srcs = ["server.py"],
    main = "server.py",
    deps = [
        ":server",
        "@pypi//fastapi",
        "@pypi//more_itertools",
        "@pypi//pyyaml",
        "@pypi//types_pyyaml",
        "@pypi//uvicorn",
    ],
)

py_image_layer(
    name = "server_image_layers",
    binary = ":server_image_binary",
)

oci_image(
    name = "image",
    base = "@debian_trixie_slim_linux_amd64",
    cmd = [
        "--host",
        "0.0.0.0",
        "--port",
        "8080",
        "--api-only",
    ],
    entrypoint = py_image_entrypoint("server_image_binary"),
    env = py_image_env(
        binary_name = "server_image_binary",
        extra_env = {
            "HOME": "/tmp",
            "MPLCONFIGDIR": "/tmp/matplotlib",
            "PYTHONSAFEPATH": "1",
            "RULES_PYTHON_EXTRACT_ROOT": "/tmp/rules_python",
            "XDG_CACHE_HOME": "/tmp/cache",
        },
    ),
    exposed_ports = ["8080/tcp"],
    labels = {
        "org.opencontainers.image.source": "https://github.com/agentydragon/ducktape",
        "org.opencontainers.image.title": "augur",
    },
    tars = [
        ":server_image_layers",
        "//third_party/debian_slim:cacerts",
    ],
)

oci_load(
    name = "image_load",
    image = ":image",
    repo_tags = ["augur:dev"],
)

build_test(
    name = "image_build_test",
    targets = [
        ":image",
        ":image.digest",
    ],
)

py_library(
    name = "export_schema",
    srcs = ["export_schema.py"],
