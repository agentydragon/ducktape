+def _image_blob_descriptors(image: BazelImage) -> list[dict[str, object]]:
+    image_path = Runfiles.CreateOrRaise().root() / image.image_rlocation
+    index = json.loads((image_path / "index.json").read_text())
+    manifest_digest = index["manifests"][0]["digest"].split(":", 1)[1]
+    manifest = json.loads((image_path / "blobs" / "sha256" / manifest_digest).read_text())
+    descriptors = [manifest["config"], *manifest["layers"]]
+    return [{"digest": item["digest"], "size": item["size"]} for item in descriptors]
+
+
+def _head_blob_status(registry_url: str, repo: str, digest: str) -> int | str:
+    request = Request(f"{registry_url}/v2/{repo}/blobs/{digest}", method="HEAD")
+    try:
+        with urlopen(request, timeout=10) as response:
+            return response.status
+    except HTTPError as error:
+        return error.code
+    except OSError as error:
+        return f"error: {error}"
+
+
+def _instrument_registry_proxy(db: AsyncDatabase, events: list[dict[str, Any]]) -> FastAPI:
+    app = create_registry_proxy_app(db=db)
+
+    @app.middleware("http")
+    async def capture_registry_requests(
+        request: FastAPIRequest, call_next: Callable[[FastAPIRequest], Awaitable[Response]]
+    ) -> Response:
+        response = await call_next(request)
+        if request.url.path.startswith("/v2/"):
+            events.append(
+                {
+                    "method": request.method,
+                    "path": request.url.path,
+                    "query": request.url.query,
+                    "status": response.status_code,
+                }
+            )
+        return response
+
+    return app
