# ── Production bundle (esbuild) ────────────────────────────────────────────────
#
# esbuild bundles main.jsx → dist/main.js; index.html (referencing /main.js) and
# the public/ tree (manifest, icon, fonts) are copied in alongside. The .js files
# carry JSX, so the loader treats them as such. Served verbatim by the FastAPI
# app's StaticFiles mount.

spa_bundle(
    name = "bundle",
    entry_point = "main.jsx",
    jsx = "automatic",
    loader = {".js": "jsx"},
    public = glob(["public/**/*"]),
    visibility = [
        "//study_casino:__pkg__",
        "//study_casino/tests:__pkg__",
    ],
    deps = [":main"],
)

# ── Visual render-health tests ───────────────────────────────────────────────
#
# Renders the StudyCasino component with mocked state and publishes the
# screenshot for PR visual review (publishOnly — no checked-in baselines).
# Reuses the shared Puppeteer lib at //util/testing/frontend_visual.
# Casino fonts above are wired in instead of the lib's Inter so the test
# captures the same typography users see in production.

js_library(
    name = "visual_harness_lib",
    srcs = ["tests/harness/harness.jsx"],
    tags = ["no-lint"],
    deps = [
        ":changelog_modal",
        ":node_modules/react",
        ":node_modules/react-dom",
        ":shared",
        ":study_casino",
        ":study_view",
        ":sync",
    ],
)

js_binary(
    name = "build_visual_harness",
    data = [
        "tests/harness/esbuild.config.mjs",
        ":casino_fonts",
        ":node_modules",
        ":visual_harness_lib",
    ],
    entry_point = "tests/harness/esbuild.config.mjs",
)

js_run_binary(
    name = "visual_harness_bundle",
    srcs = [
        "tests/harness/esbuild.config.mjs",
        ":casino_fonts",
        ":visual_harness_lib",
    ],
    outs = [
        "tests/harness/dist/harness.js",
    ],
    args = ["tests/harness/dist"],
    chdir = package_name(),
    tool = ":build_visual_harness",
)

# Single-file alias so $(rootpath) resolves to one path the test can read.
filegroup(
    name = "visual_harness_js",
    srcs = ["tests/harness/dist/harness.js"],
)

# One js_test per harness scenario (?page=<scenario> in tests/harness/harness.jsx);
# each has a same-named entry at tests/visual_test_<scenario>.mjs.
[
    js_test(
        name = "visual_%s" % scenario,
        size = "small",
        data = [
            "tests/harness/index.html",
            "tests/scene_ready.mjs",
            ":casino_fonts",
            ":visual_harness_js",
            "//util/testing/frontend_visual:fonts_conf",
            "//util/testing/frontend_visual:visual_test_lib",
            "@playwright_browsers//:chromium-headless-shell",
        ],
        entry_point = "tests/visual_test_%s.mjs" % scenario,
        env = {
            "HARNESS_PATH": "$(rootpath :visual_harness_js)",
            "CHROMIUM_HEADLESS_SHELL": "$(rootpath @playwright_browsers//:chromium-headless-shell)",
            "FONTCONFIG_FILE": "$(rootpath //util/testing/frontend_visual:fonts_conf)",
            "FREETYPE_PROPERTIES": "cff:no-stem-darkening=1",
            "EXPECTED_FONT_FAMILY": "Outfit",
        },
        no_copy_to_bin = [
            ":casino_fonts",
            ":visual_harness_js",
            "//util/testing/frontend_visual:fonts_conf",
            "//util/testing/frontend_visual:visual_test_lib",
            "@playwright_browsers//:chromium-headless-shell",
        ],
    )
    for scenario in [
        "main_page",
        "streak_rest",
        "session_award",
        "changelog",
        "active_bonus_countdown",
        "active_bonus_unlocked",
    ]
]
