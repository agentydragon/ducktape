load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library", "js_run_binary", "js_test")
load("@npm_ducktape//:defs.bzl", "npm_link_all_packages")
load("//devinfra/js:spa_bundle.bzl", "spa_bundle")

npm_link_all_packages(name = "node_modules")

# Hermetic font assets bundled with both the production frontend and the
# visual-regression test harness. The two woff2 files are latin-subset
# variable fonts (Playfair Display v40 / Outfit v15, OFL-licensed); fonts.css
# wires them into @font-face declarations the React component expects. The
# files live under public/ so Vite copies them to dist/ verbatim during the
# production build.
filegroup(
    name = "casino_fonts",
    srcs = [
        "public/fonts/Outfit-latin.woff2",
        "public/fonts/PlayfairDisplay-latin.woff2",
        "public/fonts/fonts.css",
    ],
    visibility = ["//study_casino:__subpackages__"],
)

