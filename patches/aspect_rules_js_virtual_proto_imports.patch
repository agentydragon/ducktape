+def _get_import_rewrites(deps, js_extension, proto_info, output_root):
+    output_dir = proto_common.output_directory(proto_info, output_root)
+    importer_root = output_dir.removeprefix(output_root.path).removeprefix("/")
@@ -40 +45 @@
-                rewrites.append(_original_import(canonical_path, js_extension) + ":" + _replacement(dep.label.package, dep.label.name))
+                rewrites.append(_original_import(canonical_path, js_extension) + ":" + _replacement(dep.label.package, dep.label.name, importer_root))
