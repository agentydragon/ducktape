--- a/js/private/proto.bzl
+++ b/js/private/proto.bzl
@@ -28,2 +28,5 @@
-def _replacement(package, name):
-    return ("./" + package if package else ".") + "/_virtual_imports/" + name
+def _replacement(package, name, importer_root):
+    # protoc-gen-es resolves the rewritten path from the importer's logical
+    # proto root, while generated files live under its actual output root.
+    prefix = "../" * len(importer_root.split("/")) if importer_root else "./"
+    return prefix + (package + "/" if package else "") + "_virtual_imports/" + name
