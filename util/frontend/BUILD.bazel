    config = ":vitest_config",
    tsconfig = ":tsconfig",
    deps = [
        ":help_tooltip",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/@types/react-dom",
        "//:node_modules/react",
        "//:node_modules/react-dom",
        "//:node_modules/vitest",
    ],
)

js_library(
    name = "disclosure_css",
    srcs = ["disclosure.css"],
)

ts_library(
    name = "disclosure",
    srcs = ["disclosure.tsx"],
    tsconfig = ":tsconfig",
    visibility = [
        "//agentplane:__subpackages__",
        "//util/frontend/transcript:__pkg__",
        "//x/ai_session_archive/frontend:__pkg__",
    ],
    deps = [
        ":disclosure_css",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/react",
    ],
