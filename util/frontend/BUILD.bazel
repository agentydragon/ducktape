vitest_test(
    name = "clamped_block_test",
    srcs = ["clamped_block.test.tsx"],
    config = ":vitest_config",
    tsconfig = ":tsconfig",
    deps = [
        ":clamped_block",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/@types/react-dom",
        "//:node_modules/react",
