ts_library(
    name = "clamped_block",
    srcs = ["clamped_block.tsx"],
    tsconfig = ":tsconfig",
    visibility = ["//agentplane:__subpackages__"],
    deps = [
        ":disclosure",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/react",
    ],
