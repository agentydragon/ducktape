load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config")
load("//devinfra/js:ts_library.bzl", "ts_library")
load("//devinfra/js:typed_eslint.bzl", "typed_eslint_test")
load("//devinfra/js:vitest.bzl", "check_vitest_specs", "vitest_config", "vitest_test")

package(default_visibility = ["//visibility:private"])

filegroup(
    name = "typed_lint_srcs",
    srcs = ["//util/frontend/transcript:typed_lint_srcs"] + glob(
        [
            "*.ts",
            "*.tsx",
            "**/*.ts",
            "**/*.tsx",
        ],
        allow_empty = True,
    ),
    visibility = [
        "//agentplane/app/frontend:__pkg__",
        "//devinfra/claude/session_export/frontend:__pkg__",
        "//finance/plaid/spend/ui:__pkg__",
        "//props/frontend:__pkg__",
        "//x/ai_session_archive/frontend:__pkg__",
    ],
)

filegroup(
    name = "typed_lint_program_data",
    srcs = [
        "//:node_modules/@codemirror/lang-json",
        "//:node_modules/@codemirror/lang-yaml",
        "//:node_modules/@codemirror/language",
        "//:node_modules/@codemirror/legacy-modes",
        "//:node_modules/@codemirror/state",
        "//:node_modules/@codemirror/view",
        "//:node_modules/@lezer/highlight",
        "//:node_modules/@replit/codemirror-lang-nix",
        "//:node_modules/@types/dompurify",
        "//:node_modules/@uiw/react-codemirror",
        "//:node_modules/dompurify",
        "//:node_modules/happy-dom",
        "//:node_modules/jsdom",
        "//:node_modules/marked",
    ],
    visibility = [
        "//agentplane/app/frontend:__pkg__",
        "//devinfra/claude/session_export/frontend:__pkg__",
        "//finance/plaid/spend/ui:__pkg__",
        "//props/frontend:__pkg__",
        "//x/ai_session_archive/frontend:__pkg__",
    ],
)

typed_eslint_test(
    name = "eslint_typed_test",
    srcs = ":typed_lint_srcs",
    extra_data = [":typed_lint_program_data"],
    tsconfig = "tsconfig.json",
)

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    visibility = ["//util/frontend/transcript:__pkg__"],
)

js_library(
    name = "code_block_css",
    srcs = ["code_block.css"],
    visibility = [
        "//agentplane:__subpackages__",
        "//props/frontend:__subpackages__",
    ],
)

ts_library(
    name = "code_block",
    srcs = [
        "code_block.tsx",
    ],
    tsconfig = ":tsconfig",
    visibility = [
        "//agentplane:__subpackages__",
        "//props/frontend:__subpackages__",
    ],
    deps = [
        ":code_block_css",
        "//:node_modules/@codemirror/lang-json",
        "//:node_modules/@codemirror/lang-yaml",
        "//:node_modules/@codemirror/language",
        "//:node_modules/@codemirror/legacy-modes",
        "//:node_modules/@codemirror/state",
        "//:node_modules/@codemirror/view",
        "//:node_modules/@lezer/highlight",
        "//:node_modules/@replit/codemirror-lang-nix",
        "//:node_modules/@types/react",
        "//:node_modules/@uiw/react-codemirror",
        "//:node_modules/react",
    ],
)

js_library(
    name = "markdown_css",
    srcs = ["markdown.css"],
)

ts_library(
    name = "markdown",
    srcs = [
        "markdown.tsx",
    ],
    tsconfig = ":tsconfig",
    visibility = [
        "//agentplane:__subpackages__",
        "//devinfra/claude/session_export/frontend:__pkg__",
        "//x/ai_session_archive/frontend:__pkg__",
    ],
    deps = [
        ":code_block",
        ":markdown_css",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/dompurify",
        "//:node_modules/@types/react",
        "//:node_modules/dompurify",
        "//:node_modules/marked",
        "//:node_modules/react",
    ],
)

ts_library(
    name = "resize_handle",
    srcs = ["resize_handle.tsx"],
    isolated_typecheck = True,
    tsconfig = ":tsconfig",
    visibility = [
        "//agentplane:__subpackages__",
        "//x/ai_session_archive/frontend:__pkg__",
    ],
    deps = [
        "//:node_modules/@mantine/hooks",
        "//:node_modules/@types/react",
        "//:node_modules/react",
    ],
)

ts_library(
    name = "test_intersection_observer",
    testonly = True,
    srcs = ["test_intersection_observer.ts"],
    tsconfig = ":tsconfig",
    visibility = ["//agentplane/app/frontend:__subpackages__"],
)

ts_library(
    name = "test_setup",
    testonly = True,
    srcs = ["test_setup.ts"],
    tsconfig = ":tsconfig",
    visibility = [
        "//agentplane/app/frontend:__pkg__",
        "//x/ai_session_archive/frontend:__pkg__",
    ],
    deps = [":test_intersection_observer"],
)

vitest_config(
    name = "vitest_config",
    data = [
        ":test_setup",
        "//:node_modules/happy-dom",
        "//:node_modules/jsdom",
    ],
    environment = "node",
    setup_files = ["test_setup.js"],
)

vitest_test(
    name = "code_block_test",
    srcs = ["code_block.test.ts"],
    config = ":vitest_config",
    tsconfig = ":tsconfig",
    deps = [
        ":code_block",
        "//:node_modules/vitest",
    ],
)

vitest_test(
    name = "inline_code_test",
    srcs = ["inline_code.test.tsx"],
    config = ":vitest_config",
    tsconfig = ":tsconfig",
    deps = [
        ":code_block",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/@types/react-dom",
        "//:node_modules/react",
        "//:node_modules/react-dom",
        "//:node_modules/vitest",
    ],
)

vitest_test(
    name = "markdown_test",
    srcs = ["markdown.test.tsx"],
    config = ":vitest_config",
    tsconfig = ":tsconfig",
    deps = [
        ":markdown",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/@types/react-dom",
        "//:node_modules/react",
        "//:node_modules/react-dom",
        "//:node_modules/vitest",
    ],
)

ts_library(
    name = "help_tooltip",
    srcs = ["help_tooltip.tsx"],
    tsconfig = ":tsconfig",
    visibility = [
        "//agentplane:__subpackages__",
        "//finance:__subpackages__",
    ],
    deps = [
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/react",
