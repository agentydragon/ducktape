load("@aspect_rules_js//js:defs.bzl", "js_library", "js_test")
load("@npm_ducktape//:defs.bzl", "npm_link_all_packages")

# Link npm packages for this workspace member
npm_link_all_packages(name = "node_modules")

# The one Puppeteer launcher for JS visual/screenshot tests. The flag/clock
# assets it reads live in //util/testing:browser_launcher_assets, shared with
# the Python launcher (//util/testing:frontend_visual).
js_library(
    name = "launcher",
    srcs = ["launcher.mjs"],
    visibility = ["//visibility:public"],
    deps = [
        ":node_modules/puppeteer",
        "//util/testing:browser_launcher_assets_js",
    ],
)

# Puppeteer-based visual render-health test runner.
js_library(
    name = "visual_test_lib",
    srcs = ["visual-test-lib.mjs"],
    visibility = [
        "//airlock/frontend:__pkg__",
        "//props/frontend:__pkg__",
        "//props/frontend/src:__subpackages__",
        "//x/study_casino/frontend:__pkg__",
    ],
    deps = [
        ":launcher",
        ":visual_review_manifest",
    ],
)

js_library(
    name = "visual_review_manifest",
    srcs = ["visual-review-manifest.mjs"],
    visibility = ["//visibility:public"],
)

js_test(
    name = "visual_review_manifest_test",
    data = [":visual_review_manifest"],
    entry_point = "visual-review-manifest.test.mjs",
)

# Font files for hermetic rendering.
filegroup(
    name = "fonts",
    srcs = [
        "fonts/Inter.woff2",
        "fonts/fonts.conf",
        "test-fonts.css",
    ],
    visibility = ["//visibility:public"],
)

# Single-file target for FONTCONFIG_FILE env var (rootpath needs a single file).
filegroup(
    name = "fonts_conf",
    srcs = ["fonts/fonts.conf"],
    visibility = ["//visibility:public"],
)
