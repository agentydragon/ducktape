py_package(
    name = "util_pkg",
    packages = [
        "util",
        "util.bazel",
    ],
    # `util.bazel.runfiles` is intentionally not shipped: it calls into
    # `rules_python.runfiles`, which fails when imported from a path that
    # isn't under a Bazel-built binary's runfiles tree. Shipping it in a
    # Nix-installed wheel just shadows the Bazel-runfiles version with a
    # broken copy — `Rlocation()` calls `CurrentRepository(frame=...)` on
    # the caller, sees the /nix/store path, and raises "does not lie under
    # the runfiles root". `util.bazel.{subprocess,workspace}` work fine
    # outside Bazel and are needed by Nix-shipped wheels (claude-hooks,
    # ducktape-git-hooks).
    deps = [
        ":env",
        ":fmt",
        ":fs",
        ":net",
        ":otel",
        ":typer",
        "//util/bazel:subprocess",
        "//util/bazel:workspace",
    ],
)

py_wheel(
    name = "wheel",
    distribution = "ducktape_util",
    python_requires = ">=3.13",
    requires = [
        "opentelemetry-api",
        "opentelemetry-sdk",
        "tenacity",
    ],
    version = "0.1.0",
    visibility = ["//devinfra/claude/claude_hook/container_e2e:__pkg__"],
    deps = [":util_pkg"],
)
