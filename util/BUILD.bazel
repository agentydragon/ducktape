    visibility = ["//visibility:public"],
)

py_library(
    name = "playwright",
    testonly = True,
    srcs = ["playwright.py"],
    imports = [".."],
    visibility = ["//visibility:public"],
    deps = [
        "@pypi//playwright",
        "@pypi//pytest",
    ],
