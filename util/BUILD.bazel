    imports = [".."],
    visibility = ["//visibility:public"],
)

py_library(
    name = "net",
    srcs = ["net.py"],
    imports = [".."],
    visibility = ["//visibility:public"],
    deps = ["@pypi//tenacity"],
)

py_library(
    name = "docker",
    srcs = ["docker.py"],
    imports = [".."],
    visibility = ["//visibility:public"],
    deps = [
        "@pypi//aiodocker",
        "@pypi//docker",
    ],
)

py_library(
    name = "env",
    srcs = ["env.py"],
    imports = [".."],
    visibility = ["//visibility:public"],
)

py_library(
    name = "typer",
    srcs = ["typer.py"],
    imports = [".."],
    visibility = ["//visibility:public"],
)

py_library(
