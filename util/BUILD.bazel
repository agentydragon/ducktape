# No deps and no runfiles on purpose: the CI publish planners import this as bare
# `python3 -m` on a GitHub Actions runner, where Bazel and pypi do not exist. The
# Bazel-facing half (resolving @crane, pushing a Bazel-built layout) is in :oci.
py_library(
    name = "crane",
    srcs = ["crane.py"],
    visibility = ["//visibility:public"],
)

