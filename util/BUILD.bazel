py_wheel(
    name = "wheel",
    distribution = "ducktape_util",
    python_requires = ">=3.13",
    requires = ["tenacity"],
    version = "0.1.0",
    visibility = ["//devinfra/claude/hook_daemon/session_start/container_e2e:__pkg__"],
    deps = [":util_pkg"],
)
