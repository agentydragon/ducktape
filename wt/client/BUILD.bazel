load("@rules_python//python:defs.bzl", "py_library", "py_test")

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    imports = ["../.."],
    visibility = ["//wt:__subpackages__"],
    deps = [
        "//wt/testing:conftest",
        "@pypi//pytest",
    ],
)

py_library(
    name = "__init__",
    srcs = ["__init__.py"],
    visibility = ["//:__subpackages__"],
)

py_library(
    name = "cd_utils",
    srcs = ["cd_utils.py"],
    visibility = ["//:__subpackages__"],
)

py_library(
    name = "handlers",
    srcs = ["handlers.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":cd_utils",
        "@pypi//click",
        "@pypi//psutil",
    ],
)

py_library(
    name = "shell_utils",
    srcs = ["shell_utils.py"],
    visibility = ["//:__subpackages__"],
    deps = ["@pypi//click"],
)

py_library(
    name = "view_formatter",
    srcs = ["view_formatter.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "@pypi//click",
        "@pypi//colorama",
        "@pypi//tabulate",
    ],
)

py_library(
    name = "wt_client",
    srcs = ["wt_client.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//wt/shared:error_handling",
        "@pypi//click",
        "@pypi//psutil",
        "@pypi//pydantic",
        "@pypi//pygit2",
    ],
)

py_test(
    name = "test_cli_click_integration",
    srcs = ["test_cli_click_integration.py"],
    deps = [
        ":conftest",
        "//wt:cli",
        "//wt/shared:protocol",
        "//wt/testing:asserts",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//typer_slim",
    ],
)
