load("@rules_python//python:defs.bzl", "py_library", "py_test")

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    imports = ["../.."],
    visibility = ["//wt:__subpackages__"],
    deps = [
        "//wt",
        "@pypi//pytest",
    ],
)

py_test(
    name = "test_integration",
    srcs = [
        "conftest.py",
        "test_integration_cli_daemon.py",
        "test_integration_cli_output_format.py",
        "test_integration_shell.py",
    ],
    data = [
        "//wt:wt-cli",  # Shell integration tests need the CLI binary
    ],
    main = "test_integration_cli_daemon.py",
    deps = [
        ":conftest",
        "@pypi//pygit2",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_integration_cli_daemon",
    srcs = ["test_integration_cli_daemon.py"],
    deps = [
        "//wt",
        "@pypi//pygit2",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_integration_cli_output_format",
    srcs = ["test_integration_cli_output_format.py"],
    deps = [
        "//wt",
        "//wt:cli",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_integration_shell",
    srcs = ["test_integration_shell.py"],
    deps = [
        "//wt",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
