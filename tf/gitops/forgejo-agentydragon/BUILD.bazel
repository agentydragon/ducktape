load("@aspect_bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@rules_tf//tf:def.bzl", "tf_module", "tf_providers_versions")

tf_providers_versions(
    name = "providers",
    providers = {
        "forgejo": "svalabs/forgejo:~>1.5",
        "kubernetes": "hashicorp/kubernetes:~>3.0",
    },
    tf_version = "1.12.6",
)

tf_module(
    name = "forgejo-agentydragon",
    data = [
        "//ssh_keys:atlas-forgejo.pub",
        "//ssh_keys:iguana-forgejo.pub",
        "//ssh_keys:rugged-forgejo.pub",
        "//ssh_keys:wyrm2-forgejo.pub",
    ],
    providers = [
        "forgejo",
        "kubernetes",
    ],
    providers_versions = ":providers",
)

# Native HCL read by cdk8s when rendering the Inline Workspace.
copy_to_directory(
    name = "inline_source",
    srcs = glob(["*.tf"]),
    out = "inline_source",
    root_paths = [package_name()],
    visibility = ["//cluster/cdk8s:__pkg__"],
)
