load("@rules_tf//tf:def.bzl", "tf_module", "tf_providers_versions")

tf_providers_versions(
    name = "providers",
    providers = {
        "forgejo": "svalabs/forgejo:~>1.5",
        "kubernetes": "hashicorp/kubernetes:~>3.0",
        "restapi": "mastercard/restapi:~>2.0",
    },
    tf_version = "1.12.6",
)

tf_module(
    name = "forgejo-images",
    providers = [
        "forgejo",
        "kubernetes",
        "restapi",
    ],
    providers_versions = ":providers",
)

filegroup(
    name = "inline_source",
    srcs = glob(["*.tf"]),
    visibility = ["//cluster/cdk8s:__subpackages__"],
)
