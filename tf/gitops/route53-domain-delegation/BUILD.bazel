load("@aspect_bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@rules_tf//tf:def.bzl", "tf_module", "tf_providers_versions")

exports_files(["variables.tf"])

tf_providers_versions(
    name = "providers",
    providers = {
        "aws": "hashicorp/aws:~>6.0",
    },
    tf_version = "1.12.6",
)

tf_module(
    name = "route53-domain-delegation",
    providers = [
        "aws",
    ],
    providers_versions = ":providers",
)

# Native HCL read by cdk8s when rendering the Inline Workspace.
copy_to_directory(
    name = "inline_source",
    srcs = glob(["*.tf"]),
    out = "inline_source",
    root_paths = [package_name()],
    visibility = ["//cluster/cdk8s:__pkg__"],
)
