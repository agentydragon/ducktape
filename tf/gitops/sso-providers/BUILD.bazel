load("@aspect_bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@rules_tf//tf:def.bzl", "tf_module", "tf_providers_versions")

tf_providers_versions(
    name = "providers",
    providers = {
        "authentik": "goauthentik/authentik:~>2026.8.0",
        "kubernetes": "hashicorp/kubernetes:~>3.0",
        "random": "hashicorp/random:~>3.9.0",
    },
    tf_version = "1.12.6",
)

tf_module(
    name = "sso-providers",
    providers = [
        "authentik",
        "kubernetes",
        "random",
    ],
    providers_versions = ":providers",
)

copy_to_directory(
    name = "inline_source",
    srcs = glob(["*.tf"]),
    out = "inline_source",
    root_paths = [package_name()],
    visibility = ["//cluster/cdk8s:__subpackages__"],
)
