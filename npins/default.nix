# This file is generated by npins. Do not edit it manually.
let
  data = builtins.fromJSON (builtins.readFile ./sources.json);
  version =
    data.version or (throw ''
      npins: sources.json has no "version" field.
      If you are migrating from an older version of npins, please run `npins upgrade`.
    '');
  _ =
    if version == 2 then
      null
    else
      throw "npins: unsupported version ${toString version} in sources.json";

  fetch =
    name: pin:
    let
      type = pin.type or (throw "npins: pin \"${name}\" has no \"type\" field");
    in
    if type == "GitHub" then
      builtins.fetchTarball {
        url = "https://github.com/${pin.owner}/${pin.repo}/archive/${pin.revision}.tar.gz";
        sha256 = pin.hash;
      }
    else if type == "Url" then
      builtins.fetchurl {
        url = pin.url;
        sha256 = pin.hash;
      }
    else
      throw "npins: unsupported pin type \"${type}\" for \"${name}\"";

in
builtins.mapAttrs fetch data.pins
