load("@rules_python//python:defs.bzl", "py_library")
load("//devinfra/python:defs.bzl", "py_binary", "py_test")

py_library(
    name = "find_orphans",
    srcs = ["find_orphans.py"],
    deps = [
        "//devinfra/bazel:workspace",
        "@pypi//pathspec",
        "@pypi//pygit2",
    ],
)

py_binary(
    name = "find_orphans_bin",
    main_module = "devinfra.orphans.find_orphans",
    visibility = ["//:__subpackages__"],
    deps = [":find_orphans"],
)

py_test(
    name = "test_find_orphans",
    srcs = ["test_find_orphans.py"],
    deps = [
        ":find_orphans",
        "//:conftest",
        "//devinfra/bazel:workspace",
        "@pypi//pytest_bazel",
    ],
)
