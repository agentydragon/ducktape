# gazelle:resolve py devinfra.skills.reverse_engineer.reverse_engineer_skill_spec //devinfra/skills/reverse_engineer:reverse_engineer_skill_spec
# gazelle:exclude ci
# ci/ is excluded, so pin the one module indexed code imports from it.
# gazelle:resolve py devinfra.buildbuddy.ci.invocation_ids //devinfra/buildbuddy/ci:invocation_ids
# gazelle:exclude nixos_bazel_test/testdata
# gazelle:exclude x

load("@bazel_gazelle//:def.bzl", "gazelle", "gazelle_binary")
load("@pypi//:requirements.bzl", "all_whl_requirements")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_python_gazelle_plugin//manifest:defs.bzl", "gazelle_python_manifest")
load("@rules_python_gazelle_plugin//modules_mapping:def.bzl", "modules_mapping")
load("//devinfra/python:defs.bzl", "py_library")

exports_files([
    "image_pins.json",
    "lockfile.json",
])

# These wheels need system libraries outside Bazel's Python toolchain.
_GAZELLE_WHEEL_EXCLUSIONS = [
    "dbus_python",  # dbus-1
    "pycairo",  # cairo
    "pygobject",  # girepository-2.0
]

# Extract import metadata from wheels for Gazelle's Python import resolution.
modules_mapping(
    name = "modules_map",
    wheels = [
        wheel
        for wheel in all_whl_requirements
        if package_relative_label(wheel).package not in _GAZELLE_WHEEL_EXCLUSIONS
    ],
)

# Generate gazelle_python.yaml manifest for Gazelle to resolve PyPI imports.
# Run `bazel run //devinfra:gazelle_python_manifest.update` to regenerate.
# The .test target verifies the manifest is up-to-date.
gazelle_python_manifest(
    name = "gazelle_python_manifest",
    modules_mapping = ":modules_map",
    pip_repository_name = "pypi",
    requirements = "//:requirements_bazel.txt",
)

gazelle_binary(
    name = "gazelle_python_binary",
    languages = [
        "@bazel_gazelle//language/proto",
        "@rules_python_gazelle_plugin//python",
    ],
    race = "off",
)

gazelle(
    name = "gazelle",
    data = [":gazelle_python_manifest"],
    gazelle = ":gazelle_python_binary",
)

py_library(
    name = "prettier_cli",
    srcs = ["prettier_cli.py"],
    visibility = ["//visibility:public"],
)

pkg_tar(
    name = "prettier_cli_layer",
    srcs = ["//:node_modules/prettier"],
    mode = "0755",
    package_dir = "/usr/local/lib",
    visibility = ["//visibility:public"],
)

pkg_tar(
    name = "prettier_bin_layer",
    symlinks = {"/usr/local/bin/prettier": "../lib/prettier/bin/prettier.cjs"},
    visibility = ["//visibility:public"],
)

pkg_tar(
    name = "node_bin_layer",
    srcs = ["@nodejs_linux_amd64//:bin/node"],
    mode = "0755",
    package_dir = "/usr/local/bin",
    visibility = ["//visibility:public"],
)

py_library(
    name = "update_image_pin",
    srcs = ["update_image_pin.py"],
)
