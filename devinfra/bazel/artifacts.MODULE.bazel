# The one browser every Playwright test drives: Chrome for Testing's headless shell. `:executable`
# is a single-file target, so `$(rootpath ...)` of it is a path a test can be handed (the grafana skill
# takes it as CHROMIUM_HEADLESS_SHELL); the visual tests find the binary in the runfiles of
# //util/testing/browser:launcher. The rest of the archive (libs, .pak, icudtl.dat, ...)
# rides along as its runfiles, because the executable loads those from its own directory.
# Pinned to the `chromium-headless-shell` browserVersion in Playwright 1.62.0's browsers.json, the
# Chromium that Playwright release is tested against; keep in step with `playwright==1.62.0` in
# pyproject.toml. To bump: read browserVersion for `chromium-headless-shell` from
# https://unpkg.com/playwright-core@<playwright version>/browsers.json, then take the sha256 of
# https://storage.googleapis.com/chrome-for-testing-public/<browserVersion>/linux64/chrome-headless-shell-linux64.zip
http_archive(
    name = "chrome_headless_shell",
    build_file_content = """
filegroup(
    name = "executable",
    srcs = ["chrome-headless-shell"],
    data = glob(
        ["**"],
        exclude = [
            "BUILD.bazel",
            "REPO.bazel",
        ],
    ),
    visibility = ["//visibility:public"],
)
""",
    sha256 = "3cfc2bd00d1bafcf8a68dc74c9c92bb7150ddc8d26ade948a776316e1cec4f14",
    strip_prefix = "chrome-headless-shell-linux64",
    urls = ["https://storage.googleapis.com/chrome-for-testing-public/151.0.7922.34/linux64/chrome-headless-shell-linux64.zip"],
)

