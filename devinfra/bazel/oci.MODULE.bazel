# Hermetic deb packages for container images (rules_distroless).
# Replaces Dockerfile apt-get with snapshot-pinned deb extraction.
apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")

# Keep all images in one extension so they share a coherent resolution graph.
# CI retains the generated MODULE.bazel.lock outside the cleaned checkout as a
# disposable cache; Bazel validates its inputs before reusing the resolution.
apt.sources_list(
    architectures = ["amd64"],
    components = ["main"],
    suites = ["forky"],
    types = ["deb"],
    uris = ["https://snapshot.debian.org/archive/debian/20260905T000000Z"],
)
apt.sources_list(
    architectures = ["amd64"],
    components = ["main"],
    suites = [
        "trixie",
        "trixie-updates",
    ],
    types = ["deb"],
    uris = ["https://snapshot.debian.org/archive/debian/20260301T000000Z"],
)
apt.sources_list(
    architectures = ["amd64"],
    components = ["updates/main"],
    suites = ["trixie-security"],
    types = ["deb"],
    uris = ["https://snapshot.debian.org/archive/debian-security/20260301T000000Z"],
)

