# Minimal Codex `exec_command` environment for the Agentplane runner-layering spike. Keep this
# separate from the harness and boot artifacts so a shell update does not rebuild either one.
apt.install(
    dependency_set = "trixie_runner_tools",
    # `mawk` is explicit because the shared apt resolver also sees forky's newer
    # mawk metadata, which evicts trixie's `awk` provider while resolving Bash.
    packages = [
        "bash",
        "mawk",
    ],
    suites = [
        "trixie",
        "trixie-security",
        "trixie-updates",
    ],
)

