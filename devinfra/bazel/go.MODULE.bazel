# Patch garble's decodeBuildIDHash to pad short hashes (<15 bytes) instead
# of panicking. Bazel-built Go binaries embed "redacted" (6 decoded bytes)
# in their build ID ELF note, which is shorter than garble's expected 15.
# This affects even -seed=random builds: garble reads its own build ID in
# toolexecCmd regardless of the seed source.
go_deps.module_override(
    patch_strip = 1,
    patches = ["//devinfra/skills/reverse_engineer/examples:garble_hash_fix.patch"],
    path = "mvdan.cc/garble",
)

# go-tree-sitter's generated cgo libraries reference its current allocator
# symbols in a way LLD rejects. Keep this exception narrow while RBE links use
# LLD globally. sed against gazelle's own generated BUILD files (patch_cmds
# runs after gazelle, same as `patches`) rather than a line-numbered patch:
# gazelle's exact output isn't pinned to a stable line layout, so a positional
# diff silently breaks (CONTENT_DOES_NOT_MATCH_TARGET) the moment it changes.
go_deps.module_override(
    patch_cmds = [
        """sed -i '/cgo = True,/a\\    clinkopts = ["-fuse-ld=gold"],' BUILD.bazel""",
        """sed -i '/cgo = True,/a\\    clinkopts = ["-fuse-ld=gold"],' python/BUILD.bazel""",
    ],
    path = "github.com/smacker/go-tree-sitter",
)

