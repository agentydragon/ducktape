# Single tool: `workspace-gc {all,worktrees,bazel-bases}` reclaims stale git worktrees and
# orphaned Bazel output bases via one joint scan, and reports merged local branch candidates.
py_binary(
    name = "workspace_gc_bin",
    main_module = "devinfra.gc.workspace_gc",
    visibility = ["//visibility:public"],
    deps = [":workspace_gc"],
)

py_package(
    name = "workspace_gc_pkg",
    packages = ["devinfra.gc"],
    deps = [":workspace_gc"],
)

py_wheel(
    name = "workspace_gc_wheel",
    distribution = "workspace_gc",
    entry_points = {"console_scripts": ["workspace-gc = devinfra.gc.workspace_gc:main"]},
    python_requires = ">=3.14",
    # SYNC: propagatedBuildInputs in nix/packages/default.nix (workspace-gc).
    requires = [
        "httpx",
        "humanize>=4.0.0",
        "pygit2>=1.14",
        "rich",
        "tabulate>=0.9",
        "typer",
    ],
    version = "0.1.0",
    visibility = ["//visibility:public"],
    deps = [":workspace_gc_pkg"],
)

