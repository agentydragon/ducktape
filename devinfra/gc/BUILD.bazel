# Single tool: `workspace-gc {all,worktrees,bazel-bases}` reclaims stale git worktrees, merged
# local branches, and orphaned Bazel output bases via one joint scan.
py_binary(
    name = "workspace_gc_bin",
    main_module = "devinfra.gc.workspace_gc",
    visibility = ["//visibility:public"],
    deps = [":workspace_gc"],
)

