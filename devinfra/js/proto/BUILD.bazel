load("@aspect_bazel_lib//lib:directory_path.bzl", "directory_path")
load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library")
load("@aspect_rules_js//js:proto.bzl", "js_proto_toolchain")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config")
load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("//devinfra/js:vitest.bzl", "check_vitest_specs", "vitest_config", "vitest_test")
load(":virtual_proto.bzl", "virtual_proto_library")

# gazelle:proto disable

directory_path(
    name = "protoc_gen_es_entry",
    directory = "//:node_modules/@bufbuild/protoc-gen-es/dir",
    path = "bin/protoc-gen-es",
)

js_binary(
    name = "protoc_gen_es",
    data = ["//:node_modules/@bufbuild/protoc-gen-es"],
    entry_point = ":protoc_gen_es_entry",
)

js_proto_toolchain(
    name = "protobuf_es",
    out_dts_extension = "_pb.d.ts",
    out_js_extension = "_pb.js",
    plugin_bin = ":protoc_gen_es",
    plugin_name = "es",
    plugin_options = [
        "keep_empty_files=true",
        "target=js+dts",
    ],
    runtime = "//:node_modules/@bufbuild/protobuf",
)

ts_config(
    name = "test_tsconfig",
    testonly = True,
    src = "tsconfig.json",
)

vitest_config(
    name = "vitest_config",
    environment = "node",
)

virtual_proto_library(
    name = "invocation_proto_fixture",
    testonly = True,
    protos = ["@buildbuddy_protos//:invocation_proto"],
    deps = [
        "//third_party/buildbuddy:build_event_stream_proto",
        "//third_party/googleapis:api_proto",
        "//third_party/googleapis:rpc_proto",
        "@protobuf//:any_proto",
        "@protobuf//:descriptor_proto",
        "@protobuf//:duration_proto",
        "@protobuf//:empty_proto",
        "@protobuf//:field_mask_proto",
        "@protobuf//:timestamp_proto",
        "@protobuf//:wrappers_proto",
    ],
)

proto_library(
    name = "external_invocation_fixture_proto",
    testonly = True,
    srcs = ["external_invocation_fixture.proto"],
    deps = [":invocation_proto_fixture"],
)

js_library(
    name = "integration_protos",
    testonly = True,
    deps = [
        ":external_invocation_fixture_proto",
        "//devinfra/buildbuddy/bbapi/proto:bbapi_proto",
        "//platform_sessions/management/v1:management_proto",
    ],
)

vitest_test(
    name = "external_protos_test",
    srcs = ["external_protos.test.ts"],
    config = ":vitest_config",
    tsconfig = ":test_tsconfig",
    deps = [
        ":integration_protos",
        "//:node_modules/@bufbuild/protobuf",
        "//:node_modules/vitest",
    ],
)

check_vitest_specs()
