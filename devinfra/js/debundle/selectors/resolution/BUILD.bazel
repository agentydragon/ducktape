        "//devinfra/js/debundle/selectors/resolution/selector_resolve",
        "//devinfra/js/debundle/spec",
        "//devinfra/js/debundle/spec:spec_modules",
        "@crates//:anyhow",
        "@crates//:swc_ecma_ast",
    ],
)

rust_test(
    name = "anonymous_resolution_test",
    crate = ":anonymous_resolution",
    edition = "2024",
)

rust_library(
    name = "selector_outcome",
