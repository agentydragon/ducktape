load("@aspect_bazel_lib//lib:run_binary.bzl", "run_binary")
load("@aspect_rules_esbuild//esbuild:defs.bzl", "esbuild")
load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@rules_rust//rust:defs.bzl", "rust_test")
load("//devinfra/js/debundle:pipeline.bzl", "debundle_analysis", "debundle_apply", "debundle_resolve_placement")
load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_testonly = True)

_ENTRY_POINTS = [
    "app/main.js",
    "app/vendor/clsx.js",
    "app/vendor/roughjs.js",
]

_PACKAGE_ROOTS = {
    "//:node_modules/clsx/dir": "clsx",
    "//:node_modules/roughjs/dir": "roughjs",
}

js_library(
    name = "app",
    srcs = _ENTRY_POINTS,
    deps = [
        "//:node_modules/@excalidraw/excalidraw",
        "//:node_modules/clsx",
        "//:node_modules/react",
        "//:node_modules/react-dom",
        "//:node_modules/roughjs",
    ],
)

# Production build: minified, identifier-mangled, tree-shaken ESM, split at
# Excalidraw's dynamic-import boundaries and into the `app/vendor/` chunks.
esbuild(
    name = "bundle",
    config = {
        # `@excalidraw/excalidraw/index.css` is exported only under the
        # `development`/`production` conditions.
        "conditions": [
            "browser",
            "production",
        ],
        "loader": {".woff2": "file"},
    },
    define = {"process.env.NODE_ENV": "\"production\""},
    entry_points = _ENTRY_POINTS,
    # The text-to-diagram dialog's lazy mermaid closure (~170 chunks, d3,
    # cytoscape, katex) would dominate the corpus; it stays an unresolved
    # dynamic import, so only that dialog fails to load.
    external = ["@excalidraw/mermaid-to-excalidraw"],
    format = "esm",
    metafile = True,
    minify = True,
    output_dir = True,
    platform = "browser",
    sourcemap = False,
    splitting = True,
    target = ["es2022"],
    visibility = ["//devinfra/js/debundle/x/split_proof/integration/excalidraw:__pkg__"],
    deps = [":app"],
)

py_library(
    name = "gen_inputs",
    srcs = ["gen_inputs.py"],
    deps = [
        "@pypi//more_itertools",
        "@pypi//pyyaml",
    ],
)

py_binary(
    name = "gen_inputs_bin",
    main_module = "devinfra.js.debundle.excalidraw.gen_inputs",
    deps = [":gen_inputs"],
)

run_binary(
    name = "inputs",
    srcs = [
        "app/index.html",
        "spec/chunk_aliases.yaml",
        "spec/config_template.yaml",
        ":bundle",
    ],
    outs = [
        "config.yaml",
        "js-files.txt",
    ],
    args = [
        "--bundle-dir",
        "$(RULEDIR)/bundle",
        "--metafile",
        "$(RULEDIR)/bundle_metadata.json",
        "--chunks-dir",
        "$(RULEDIR)/chunks",
        "--inputs-root",
        package_name() + "/chunks",
        "--template",
        "$(execpath spec/config_template.yaml)",
        "--aliases",
        "$(execpath spec/chunk_aliases.yaml)",
        "--index-html",
        "$(execpath app/index.html)",
        "--js-list",
        "$(execpath js-files.txt)",
        "--js-list-path",
        package_name() + "/js-files.txt",
        "--config",
        "$(execpath config.yaml)",
    ],
    out_dirs = ["chunks"],
    tool = ":gen_inputs_bin",
    visibility = [
        "//devinfra/js/debundle/perf:__pkg__",
        "//devinfra/js/debundle/x/split_proof/integration/excalidraw:__pkg__",
    ],
)

# Chunks and their JS list share bazel-bin, the root the generated config's
# `inputs` paths resolve against.
filegroup(
    name = "source",
    srcs = [
        "js-files.txt",
        ":inputs",
    ],
    visibility = ["//devinfra/js/debundle/perf:__pkg__"],
)

filegroup(
    name = "spec",
    srcs = glob(["spec/**"]),
    visibility = ["//devinfra/js/debundle/perf:__pkg__"],
)

exports_files(
    ["spec/vendor_marks.yaml"],
    visibility = ["//devinfra/js/debundle/perf:__pkg__"],
)

# Both stages use the same authored spec and generated sources.
debundle_analysis(
    name = "analysis",
    package_roots = _PACKAGE_ROOTS,
    spec_tree_inputs = [":spec"],
    tree_config = "config.yaml",
    tree_modules = "spec/modules",
    tree_source_root = ":source",
    tree_vendor_marks = "spec/vendor_marks.yaml",
)

debundle_apply(
    name = "debundle",
    analysis = ":analysis",
    package_roots = _PACKAGE_ROOTS,
    spec_tree_inputs = [":spec"],
    split_dependency_graphs = True,
    tree_config = "config.yaml",
    tree_modules = "spec/modules",
    tree_source_root = ":source",
    tree_vendor_marks = "spec/vendor_marks.yaml",
)

filegroup(
    name = "spec_graphs",
    srcs = [":debundle"],
    output_group = "dependency_graphs",
    visibility = ["//devinfra/js/debundle/x/split_proof/integration/excalidraw:__pkg__"],
)

# One solve of the complete authored context, then two views of its claims.
_PROPOSALS = "//devinfra/js/debundle/x/split_proof/integration/excalidraw/proposals/scroll:"

debundle_resolve_placement(
    name = "selected_editor_placement",
    canonical_out = "canonical_editor_placement.json",
    chunk = "editor",
    ownership_subset = "editor_smoke_subset.json",
    package_roots = _PACKAGE_ROOTS,
    proposal_fragments = {
        "//devinfra/js/debundle/x/split_proof/integration/excalidraw/proposals/transform_handles:transform.yaml": "packages/excalidraw/element/transformhandles",
        "//devinfra/js/debundle/x/split_proof/integration/excalidraw/proposals/math_geometry:line.yaml": "packages/math/line",
        "//devinfra/js/debundle/x/split_proof/integration/excalidraw/proposals/math_geometry:segment.yaml": "packages/math/segment",
        "//devinfra/js/debundle/x/split_proof/integration/excalidraw/proposals/math_geometry:rectangle.yaml": "packages/math/rectangle",
        "//devinfra/js/debundle/x/split_proof/integration/excalidraw/proposals/math_geometry:curve.yaml": "packages/math/curve",
        "//devinfra/js/debundle/x/split_proof/integration/excalidraw/proposals/size_resize:size_helpers.yaml": "packages/excalidraw/element/sizehelpers",
        "//devinfra/js/debundle/x/split_proof/integration/excalidraw/proposals/size_resize:resize_test.yaml": "packages/excalidraw/element/resizetest",
        "//devinfra/js/debundle/x/split_proof/integration/excalidraw/proposals/heading:packages/excalidraw/element/heading.yaml": "packages/excalidraw/element/heading",
        "//devinfra/js/debundle/x/split_proof/integration/excalidraw/proposals/library_helpers:average.yaml": "packages/math/utils",
        "//devinfra/js/debundle/x/split_proof/integration/excalidraw/proposals/library_helpers:rtl_strings.yaml": "packages/excalidraw/utils",
        "//devinfra/js/debundle/x/split_proof/integration/excalidraw/proposals/library_helpers:utils_prefix.yaml": "packages/excalidraw/utils",
        "//devinfra/js/debundle/x/split_proof/integration/excalidraw/proposals/library_helpers:default_font_family.yaml": "packages/excalidraw/constants",
        "//devinfra/js/debundle/x/split_proof/integration/excalidraw/proposals/library_helpers:numeric_thresholds.yaml": "packages/excalidraw/constants",
        "//devinfra/js/debundle/x/split_proof/integration/excalidraw/proposals/library_helpers:shift_locking_angle.yaml": "packages/excalidraw/constants",
        "//devinfra/js/debundle/x/split_proof/integration/excalidraw/proposals/new_element:packages/excalidraw/colors.yaml": "packages/excalidraw/colors",
        "//devinfra/js/debundle/x/split_proof/integration/excalidraw/proposals/new_element:packages/excalidraw/constants.yaml": "packages/excalidraw/constants",
        "//devinfra/js/debundle/x/split_proof/integration/excalidraw/proposals/new_element:packages/excalidraw/groups.yaml": "packages/excalidraw/groups",
        "//devinfra/js/debundle/x/split_proof/integration/excalidraw/proposals/new_element:packages/excalidraw/random.yaml": "packages/excalidraw/random",
        _PROPOSALS + "packages/excalidraw/element/bounds.yaml": "packages/excalidraw/element/bounds",
        _PROPOSALS + "packages/excalidraw/scene/Shape.yaml": "packages/excalidraw/scene/shape",
        _PROPOSALS + "packages/utils/geometry/shape.yaml": "packages/utils/geometry/shape",
    },
    spec_tree_inputs = [":spec"],
    tree_config = "config.yaml",
    tree_modules = "spec/modules",
    tree_source_root = ":source",
    tree_vendor_marks = "spec/vendor_marks.yaml",
    visibility = ["//devinfra/js/debundle/x/split_proof/integration/excalidraw:__pkg__"],
)

filegroup(
    name = "canonical_editor_placement",
    srcs = ["canonical_editor_placement.json"],
    visibility = ["//devinfra/js/debundle/x/split_proof/integration/excalidraw:__pkg__"],
)

py_test(
    name = "test_proposal_fragments",
    srcs = ["test_proposal_fragments.py"],
    data = [
        ":canonical_editor_placement",
        ":inputs",
        ":selected_editor_placement",
    ],
    env = {
        "CANONICAL": "$(rlocationpath :canonical_editor_placement)",
        "SELECTED": "$(rlocationpath :selected_editor_placement)",
        "INPUTS": "$(rlocationpaths :inputs)",
    },
    deps = [
        "//:conftest",
        "@pypi//pytest_bazel",
        "@rules_python//python/runfiles",
    ],
)

py_test(
    name = "test_debundle_tree",
    srcs = ["test_debundle_tree.py"],
    data = [
        "js-files.txt",
        ":debundle",
    ],
    env = {
        "DEBUNDLE_JS_LIST": "$(rlocationpath js-files.txt)",
        "DEBUNDLE_OUT": "$(rlocationpath :debundle)",
    },
    deps = [
        "//:conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@rules_python//python/runfiles",
    ],
)

rust_test(
    name = "spec_output_test",
    srcs = ["spec_output_test.rs"],
    crate_root = "spec_output_test.rs",
    data = [":debundle"],
    edition = "2024",
    env = {"DEBUNDLE_OUT": "$(rlocationpath :debundle)"},
    deps = [
        "//devinfra/js/debundle/e2e:support",
        "@crates//:serde_json",
        "@crates//:tempfile",
        "@rules_rust//tools/runfiles",
    ],
)

# Per-chunk verdicts and emitted-file hashes; an engine change diffs this file
# between its base and its head.
run_binary(
    name = "canonical_summary",
    srcs = [":debundle"],
    outs = ["canonical_summary.json"],
    args = [
        "--out-dir",
        "$(execpath :debundle)",
        "--summary",
        "$(execpath canonical_summary.json)",
    ],
    tool = ":summarize_tree_bin",
)

py_binary(
    name = "summarize_tree_bin",
    main_module = "devinfra.js.debundle.excalidraw.summarize_tree",
    deps = [":summarize_tree"],
)

py_library(
    name = "summarize_tree",
    srcs = ["summarize_tree.py"],
)

# Browser smoke over the accepted tree.
py_test(
    name = "test_smoke",
    srcs = ["test_smoke.py"],
    data = [
        ":debundle",
        "//:node_modules/@excalidraw/excalidraw/dir",
    ] + _PACKAGE_ROOTS.keys(),
    env = {
        "DEBUNDLE_OUT": "$(rlocationpath :debundle)",
        "EXCALIDRAW_PACKAGE": "$(rlocationpath //:node_modules/@excalidraw/excalidraw/dir)",
        "PACKAGE_ROOTS": json.encode({
            package: "$(rlocationpath {})".format(label)
            for label, package in _PACKAGE_ROOTS.items()
        }),
    },
    shard_count = 4,
    deps = [
        "//:conftest",
        "//testing:asgi",
        "//testing/frontend_visual:context",
        "//testing/frontend_visual:fixtures",
        "@pypi//playwright",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",
        "@pypi//pytest_bazel",
        "@pypi//starlette",
        "@rules_python//python/runfiles",
    ],
)
