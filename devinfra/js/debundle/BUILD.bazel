# The `globals` package's environment lists name the hosts' standard global
# properties (SPEC.md § Predefined globals).
genrule(
    name = "standard_globals_json",
    srcs = ["//:node_modules/globals"],
    outs = ["standard_globals.json"],
    cmd = "for f in $(SRCS); do if [ -f $$f/globals.json ]; then cp $$f/globals.json $@; fi; done; test -s $@",
)

