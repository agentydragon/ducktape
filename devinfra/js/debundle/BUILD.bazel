rust_prost_transform(
    name = "spec_wire_serde_enums",
    prost_opts = ["btree_map=."] + [
        "type_attribute=debundle.spec.{}={}".format(name, attribute)
        for name in _SPEC_WIRE_SERDE_ENUMS
        for attribute in [
            "#[derive(::serde::Serialize)]",
            "#[derive(::serde::Deserialize)]",
            "#[serde(rename_all = \"snake_case\")]",
        ]
    ] + [
        "type_attribute=debundle.spec.{}={}".format(name, attribute)
        for name in [
            "ReentryFreeOperation",
            "InitializerExternalEffects",
        ]
        for attribute in [
            "#[derive(::serde::Serialize)]",
            "#[derive(::serde::Deserialize)]",
            "#[derive(::strum::Display)]",
            "#[serde(rename_all = \"snake_case\")]",
            "#[strum(serialize_all = \"snake_case\")]",
        ]
    ] + [
        "type_attribute=debundle.spec.{}={}".format(name, attribute)
        for name in [
            "ResolvedMemberSelector",
            "SourceMatchBindingDetail",
        ]
        for attribute in [
            "#[derive(::serde::Serialize)]",
            "#[derive(::serde::Deserialize)]",
            "#[derive(Eq)]",
            "#[serde(deny_unknown_fields)]",
        ]
    ] + [
        "field_attribute=debundle.spec.SourceMatchBindingDetail.name=#[serde(default)]",
        "field_attribute=debundle.spec.SourceMatchBindingDetail.name=#[serde(skip_serializing_if = \"Option::is_none\")]",
    ],
    deps = [
        "@crates//:serde",
        "@crates//:strum",
    ],
)

