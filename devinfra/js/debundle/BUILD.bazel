    edition = "2024",
)

# The shape matcher's kernel: a structural homomorphism from a selector needle's
# chunk_facts onto a candidate's, fail-closed outside the faithful subset.
# Operates over the AST-facts EDB, not by re-walking ASTs.
rust_library(
    name = "selector_match",
    srcs = glob(["selectors/matching/selector_match/*.rs"]),
    crate_root = "selectors/matching/selector_match/mod.rs",
    edition = "2024",
    deps = [
        ":chunk_facts",
        ":source_match_holes",
        "@crates//:regex",
    ],
)

