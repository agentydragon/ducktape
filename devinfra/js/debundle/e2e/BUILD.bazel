load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# End-to-end tests treating the debundler as a black-box binary.

rust_library(
    name = "support",
    srcs = ["support.rs"],
    crate_name = "debundle_e2e_support",
    crate_root = "support.rs",
    data = [
        "//devinfra/js/debundle",
        "@nodejs_linux_amd64//:bin/node",
    ],
    edition = "2024",
    deps = [
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:serde_yaml",
        "@crates//:swc_common",
        "@crates//:swc_ecma_ast",
        "@crates//:swc_ecma_parser",
        "@crates//:tempfile",
        "@rules_rust//tools/runfiles",
    ],
)

[
    rust_test(
        name = name,
        srcs = ["{}.rs".format(name)],
        crate_root = "{}.rs".format(name),
        data = [
            "//devinfra/js/debundle",
            "@nodejs_linux_amd64//:bin/node",
        ],
        edition = "2024",
        deps = [
            ":support",
            "//devinfra/js/debundle:analysis",
            "@crates//:serde",
            "@crates//:serde_json",
            "@crates//:serde_yaml",
            "@crates//:swc_common",
            "@crates//:swc_ecma_ast",
            "@crates//:swc_ecma_parser",
            "@crates//:tempfile",
            "@rules_rust//tools/runfiles",
        ],
    )
    for name in [
        "anonymous_statement_ambiguous_match_test",
        "anonymous_statement_comma_list_offset_test",
        "anonymous_statement_iife_multiline_test",
        "anonymous_statement_round_trip_test",
        "anonymous_statement_source_order_test",
        "anonymous_statement_zero_match_test",
        "lowering_test",
        "naturalization_test",
        "url_rebase_test",
        "vendor_swap_test",
        "identifier_rename_queue_test",
        "sibling_declarator_steal_test",
        "chunk_rename_cross_module_test",
        "chunk_renames_test",
        "missing_binding_member_test",
        "residual_member_rename_test",
        "source_order_emit_test",
        "realizability_test",
        "cross_module_emission_test",
        "purity_builtin_new_test",
        "purity_chunk_rename_test",
        "purity_optional_chain_test",
        "purity_symbol_literal_test",
        "purity_test",
        "peelability_lazy_only_residual_test",
        "peelability_emit_resolvability_test",
        "peelability_three_vertex_scc_test",
        "peelability_empty_declared_closure_test",
        "owner_graph_purity_reason_test",
    ]
]
