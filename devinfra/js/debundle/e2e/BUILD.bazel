load("@aspect_rules_js//js:defs.bzl", "js_library")
load(":defs.bzl", "e2e_test")

# End-to-end tests treating the debundler as a black-box binary.
# `support` only depends on node stdlib and the run_transform binary —
# no debundler-internal modules — so a re-implementation in another
# language can drive these tests verbatim.

js_library(
    name = "support",
    srcs = ["support.mjs"],
)

e2e_test(name = "lowering_test")

e2e_test(name = "cross_module_test")

e2e_test(name = "naturalization_test")

e2e_test(name = "url_rebase_test")
