load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# End-to-end tests treating the debundler as a black-box binary.

rust_library(
    name = "support",
    srcs = ["support.rs"],
    crate_name = "debundle_e2e_support",
    crate_root = "support.rs",
    data = [
        "//devinfra/js/debundle",
        "@nodejs_linux_amd64//:bin/node",
    ],
    edition = "2024",
    deps = [
        "@crates//:serde_json",
        "@crates//:tempfile",
        "@rules_rust//tools/runfiles",
    ],
)

[
    rust_test(
        name = name,
        srcs = ["{}.rs".format(name)],
        crate_root = "{}.rs".format(name),
        data = [
            "//devinfra/js/debundle",
            "@nodejs_linux_amd64//:bin/node",
        ],
        edition = "2024",
        deps = [
            ":support",
            "@crates//:serde_json",
            "@crates//:swc_common",
            "@crates//:swc_ecma_ast",
            "@crates//:swc_ecma_parser",
            "@crates//:tempfile",
            "@rules_rust//tools/runfiles",
        ],
    )
    for name in [
        "lowering_test",
        "cross_module_test",
        "naturalization_test",
        "url_rebase_test",
        "vendor_swap_test",
        "import_collision_test",
        "scrambled_id_frequencies_test",
        "sibling_declarator_steal_test",
        "import_specifier_member_test",
        "missing_binding_member_test",
        "runtime_import_reference_test",
        "init_call_order_test",
        "validator_rejects_cycle_test",
        "source_order_emit_test",
        "multi_module_re_export_test",
        "lazy_back_edge_cycle_test",
    ]
]
