    ],
)

# The `reads_member` primitive (P4 step 2) through the full lowering pipeline:
# a member pinned by the member it reads (`obj.X`) — the stable identity of the
# ~72 TS codegen helpers — resolves to the correct binding, lands in the right
# module, and runs under Node, with fail-closed ambiguous/zero/unknown-object
# cases. See plans/selector_resolver_endpoint.md Phase X2.
rust_test(
    name = "reads_member_lowering_test",
    srcs = ["reads_member_lowering_test.rs"],
    crate_root = "reads_member_lowering_test.rs",
    data = [
        "//devinfra/js/debundle",
        "@nodejs_linux_amd64//:bin/node",
    ],
    edition = "2024",
    deps = [
        ":support",
    ],
)

