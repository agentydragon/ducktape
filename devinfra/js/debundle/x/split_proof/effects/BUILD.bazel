load("@aspect_rules_js//js:defs.bzl", "js_library", "js_test")
load("//devinfra/lint:linters.bzl", "eslint_test")

js_library(
    name = "cases",
    srcs = [
        "cases.mjs",
        "cases_general.mjs",
        "targeted.mjs",
    ],
    deps = ["//devinfra/js/debundle/x/split_proof:seeded_random"],
)

# Include first-party runfile helpers as lint sources.
js_library(
    name = "lint_sources",
    testonly = True,
    srcs = glob(["**/*.mjs"]),
)

eslint_test(
    name = "eslint_test",
    srcs = [
        ":lint_sources",
        "//devinfra/js/debundle/x/split_proof/effects/debug/general_known_gaps:cases",
        "//devinfra/js/debundle/x/split_proof/effects/debug/p1_known_gaps:cases",
    ],
)

# The golden cases of the effect analysis: what each unit of a small bundle touches, and Node's verdict on reorders.
_TRANSLATE = "//devinfra/js/debundle/x/split_proof/lean:translate"

_EFFECTS_CASES_DATA = [
    ":cases",
    "//devinfra/js/debundle/x/split_proof:seeded_random",
    "//devinfra/js/debundle/x/split_proof/translation:pair",
    _TRANSLATE,
    "//devinfra/js/debundle/x/split_proof/lean:lower",
]

_EFFECTS_CASES_ENV = {
    "LOWER": "$(rootpath //devinfra/js/debundle/x/split_proof/lean:lower)",
    "TRANSLATE": "$(rootpath " + _TRANSLATE + ")",
}

js_test(
    name = "effects_cases_test",
    size = "medium",
    data = _EFFECTS_CASES_DATA,
    entry_point = "run.mjs",
    env = _EFFECTS_CASES_ENV,
    shard_count = 4,
)

js_test(
    name = "effects_known_gaps_test",
    size = "medium",
    args = ["--known-gaps"],
    data = _EFFECTS_CASES_DATA + [
        "//devinfra/js/debundle/x/split_proof/effects/debug/general_known_gaps:cases",
        "//devinfra/js/debundle/x/split_proof/effects/debug/p1_known_gaps:cases",
        "//devinfra/js/debundle/x/split_proof/translation/debug/generator_findings:cases",
    ],
    entry_point = "run.mjs",
    env = _EFFECTS_CASES_ENV,
)

js_test(
    name = "effects_generated_known_gaps_test",
    size = "medium",
    args = [
        "--generated-known-gaps",
        "--seed",
        "20261121",
    ],
    data = _EFFECTS_CASES_DATA + [
        "//devinfra/js/debundle/x/split_proof/translation/testing/gen:program_generator",
    ],
    entry_point = "run.mjs",
    env = _EFFECTS_CASES_ENV,
)

js_test(
    name = "effects_permutations_test",
    size = "large",
    args = [
        "--permutations",
        "3",
        "--seed",
        "1",
    ],
    data = _EFFECTS_CASES_DATA,
    entry_point = "run.mjs",
    env = _EFFECTS_CASES_ENV,
    shard_count = 4,
    tags = ["manual"],
)

js_test(
    name = "effects_targeted_fuzz_test",
    size = "medium",
    args = [
        "--seed",
        "20261121",
    ],
    data = _EFFECTS_CASES_DATA,
    entry_point = "run.mjs",
    env = {
        "CASES": "./targeted.mjs",
        "LOWER": "$(rootpath //devinfra/js/debundle/x/split_proof/lean:lower)",
        "TRANSLATE": "$(rootpath " + _TRANSLATE + ")",
    },
)

_REFLECTIVE_RECEIVER_DATA = _EFFECTS_CASES_DATA + ["reflective_receivers.mjs"]

_REFLECTIVE_RECEIVER_ENV = dict(
    _EFFECTS_CASES_ENV,
    CASES = "./reflective_receivers.mjs",
)

js_test(
    name = "reflective_receivers_test",
    size = "medium",
    args = [
        "--seed",
        "20261121",
    ],
    data = _REFLECTIVE_RECEIVER_DATA,
    entry_point = "run.mjs",
    env = _REFLECTIVE_RECEIVER_ENV,
)

js_test(
    name = "reflective_receivers_second_seed_test",
    size = "medium",
    args = [
        "--seed",
        "77",
    ],
    data = _REFLECTIVE_RECEIVER_DATA,
    entry_point = "run.mjs",
    env = _REFLECTIVE_RECEIVER_ENV,
)

js_test(
    name = "prototype_observations_test",
    entry_point = "prototype_observations_test.mjs",
)
