load("@aspect_rules_js//js:defs.bzl", "js_library", "js_test")
load("//devinfra/js/debundle/x/split_proof:executable_test.bzl", "test_runner")
load("//devinfra/lint:linters.bzl", "eslint_test")

js_library(
    name = "to_core",
    srcs = ["to_core.mjs"],
    visibility = ["//devinfra/js/debundle/x/split_proof/translation:__pkg__"],
    deps = [
        "//:node_modules/acorn",
        "//devinfra/js/debundle/x/split_proof/translation:scope_metadata",
    ],
)

# Include first-party runfile helpers as lint sources.
js_library(
    name = "lint_sources",
    testonly = True,
    srcs = glob(["*.mjs"]),
)

eslint_test(
    name = "eslint_test",
    srcs = [":lint_sources"],
)

_DIFFERENTIAL_DATA = [
    "cases.mjs",
    "generate.mjs",
    "module_cases.mjs",
    "opaque_cases.mjs",
    ":to_core",
    "//devinfra/js/debundle/x/split_proof:seeded_random",
    "//devinfra/js/debundle/x/split_proof/translation/testing/gen:program_generator",
    "//devinfra/js/debundle/x/split_proof/translation:split_dump",
    "//devinfra/js/debundle/x/split_proof:corejs",
    "//devinfra/js/debundle/x/split_proof:evalorder",
]

_DIFFERENTIAL_ENV = {
    "COREJS": "$(rootpath //devinfra/js/debundle/x/split_proof:corejs)",
    "EVALORDER": "$(rootpath //devinfra/js/debundle/x/split_proof:evalorder)",
}

js_test(
    name = "error_allocation_host_test",
    entry_point = "error_allocation_host_test.mjs",
)

test_runner(
    name = "error_realm_test_runner",
    src = "ErrorRealmTest.lean",
    deps = ["//devinfra/js/debundle/x/split_proof:corejs_eval"],
)

js_test(
    name = "error_realm_differential_test",
    data = [":error_realm_test_runner"],
    entry_point = "error_realm_differential.mjs",
    env = {"ERROR_REALM_TEST": "$(rootpath :error_realm_test_runner)"},
)

test_runner(
    name = "global_env_test_runner",
    src = "GlobalEnvTest.lean",
    deps = ["//devinfra/js/debundle/x/split_proof:corejs_eval"],
)

js_test(
    name = "global_env_differential_test",
    data = [":global_env_test_runner"],
    entry_point = "global_env_differential.mjs",
    env = {"GLOBAL_ENV_TEST": "$(rootpath :global_env_test_runner)"},
)

js_test(
    name = "corejs_differential_test",
    size = "medium",
    args = [
        "--count",
        "2",
        "--seed",
        "1",
    ],
    data = _DIFFERENTIAL_DATA,
    entry_point = "differential.mjs",
    env = _DIFFERENTIAL_ENV,
)

js_test(
    name = "corejs_inheritance_differential_test",
    size = "medium",
    args = [
        "--inheritance-only",
        "--count",
        "24",
        "--seed",
        "1",
    ],
    data = _DIFFERENTIAL_DATA,
    entry_point = "differential.mjs",
    env = _DIFFERENTIAL_ENV,
    shard_count = 2,
)

js_test(
    name = "corejs_binding_differential_test",
    size = "medium",
    args = [
        "--bindings-only",
        "--count",
        "12",
        "--seed",
        "1",
    ],
    data = _DIFFERENTIAL_DATA,
    entry_point = "differential.mjs",
    env = _DIFFERENTIAL_ENV,
)

js_test(
    name = "corejs_differential_sweep_test",
    size = "large",
    args = [
        "--count",
        "40",
        "--seed",
        "1",
    ],
    data = _DIFFERENTIAL_DATA,
    entry_point = "differential.mjs",
    env = _DIFFERENTIAL_ENV,
    tags = ["manual"],
)

test_runner(
    name = "async_prefix_test_runner",
    src = "AsyncPrefixTest.lean",
    deps = [
        "//devinfra/js/debundle/x/split_proof:corejs_async_prefix",
        "//devinfra/js/debundle/x/split_proof:corejs_eval",
    ],
)

js_test(
    name = "async_prefix_differential_test",
    data = [":async_prefix_test_runner"],
    entry_point = "async_prefix_differential_test.mjs",
    env = {"ASYNC_PREFIX_TEST": "$(rootpath :async_prefix_test_runner)"},
)

test_runner(
    name = "linked_async_test_runner",
    src = "LinkedAsyncTest.lean",
    deps = [
        "//devinfra/js/debundle/x/split_proof:corejs_eval",
        "//devinfra/js/debundle/x/split_proof:corejs_linked_input",
        "//devinfra/js/debundle/x/split_proof:corejs_property_turn",
    ],
)

js_test(
    name = "linked_async_differential_test",
    data = [
        "linked_async_fixture.mjs",
        ":linked_async_test_runner",
        "//devinfra/js/debundle/e2e:cases/emission/syntactic_holes/memoized_sequence_tail/static/app.js",
        "//devinfra/js/debundle/x/split_proof/translation:parser",
    ],
    entry_point = "linked_async_differential_test.mjs",
    env = {"LINKED_ASYNC_TEST": "$(rootpath :linked_async_test_runner)"},
    no_copy_to_bin = ["//devinfra/js/debundle/e2e:cases/emission/syntactic_holes/memoized_sequence_tail/static/app.js"],
)

test_runner(
    name = "primitive_await_test_runner",
    src = "PrimitiveAwaitTest.lean",
    deps = [
        "//devinfra/js/debundle/x/split_proof:corejs_eval",
        "//devinfra/js/debundle/x/split_proof:corejs_primitive_await",
    ],
)

js_test(
    name = "primitive_await_differential_test",
    data = [":primitive_await_test_runner"],
    entry_point = "primitive_await_differential_test.mjs",
    env = {"PRIMITIVE_AWAIT_TEST": "$(rootpath :primitive_await_test_runner)"},
)

test_runner(
    name = "linked_primitive_await_test_runner",
    src = "LinkedPrimitiveAwaitTest.lean",
    deps = [
        "//devinfra/js/debundle/x/split_proof:corejs_eval",
        "//devinfra/js/debundle/x/split_proof:corejs_linked_primitive_await",
        "//devinfra/js/debundle/x/split_proof:corejs_primitive_await",
    ],
)

js_test(
    name = "linked_primitive_await_differential_test",
    data = [
        "linked_primitive_await_fixture.mjs",
        ":linked_primitive_await_test_runner",
        "//devinfra/js/debundle/x/split_proof/translation:parser",
    ],
    entry_point = "linked_primitive_await_differential_test.mjs",
    env = {"LINKED_PRIMITIVE_AWAIT_TEST": "$(rootpath :linked_primitive_await_test_runner)"},
)
