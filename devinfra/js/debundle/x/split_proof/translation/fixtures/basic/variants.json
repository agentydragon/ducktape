[
  {
    "name": "local rename is fine",
    "edits": [
      {
        "file": "lib/math.js",
        "find": "function double(n) {\n  return Lodash.identity(n) * 2;",
        "replace": "function double(count) {\n  return Lodash.identity(count) * 2;"
      }
    ],
    "cert": "match",
    "expect": { "code": 0, "contains": "PLAN SOUND" }
  },
  {
    "name": "a literal changed",
    "edits": [{ "file": "lib/consts.js", "find": "[1, 2, 3]", "replace": "[1, 2, 4]" }],
    "cert": "base",
    "expect": { "code": 1, "contains": "against" }
  },
  {
    "name": "a reference points at another declaration",
    "edits": [
      { "file": "lib/counter.js", "find": "import { items } from", "replace": "import { limit } from" },
      { "file": "lib/counter.js", "find": "items.length", "replace": "limit.length" }
    ],
    "cert": "base",
    "expect": { "code": 1, "contains": "but it stands for `B`" }
  },
  {
    "name": "a parameter captures a module-scope name",
    "edits": [
      {
        "file": "lib/math.js",
        "find": "function addBase(value) {\n  return double(value) + limit;",
        "replace": "function addBase(limit) {\n  return double(limit) + limit;"
      }
    ],
    "cert": "base",
    "expect": { "code": 1, "contains": "`A` is T but `limit` is L" }
  },
  {
    "name": "an import is missing",
    "edits": [{ "file": "lib/math.js", "find": "import { limit } from \"./consts.js\";\n", "replace": "" }],
    "cert": "base",
    "expect": { "code": 1, "contains": "`A` is T but `limit` is G" }
  },
  {
    "name": "a declaration renamed but not its use",
    "edits": [{ "file": "lib/math.js", "find": "function double(n) {", "replace": "function twice(n) {" }],
    "cert": "base",
    "expect": { "code": 1, "contains": "`g` is T but `double` is G" }
  },
  {
    "name": "an import from a module that does not export the name",
    "edits": [
      {
        "file": "lib/counter.js",
        "find": "import { addBase } from \"./math.js\";",
        "replace": "import { addBase } from \"./consts.js\";"
      }
    ],
    "cert": "base",
    "expect": { "code": 1, "contains": "does not export `addBase`" }
  },
  {
    "name": "one outside import stands for two things",
    "edits": [
      {
        "file": "lib/math.js",
        "find": "import Lodash from \"../vendors/lodash.js\";",
        "replace": "import Other from \"../vendors/other.js\";"
      },
      { "file": "lib/math.js", "find": "Lodash.identity(n)", "replace": "Other.identity(n)" }
    ],
    "cert": "match",
    "expect": { "code": 1, "contains": "stands for two different things" }
  },
  {
    "name": "a unit is duplicated",
    "edits": [
      {
        "file": "lib/math.js",
        "find": "export { addBase };",
        "replace": "function double2(n) {\n  return Lodash.identity(n) * 2;\n}\nexport { addBase };"
      }
    ],
    "cert": "match",
    "expect": { "code": 1, "contains": "the output has 10 units" }
  },
  {
    "name": "a unit is missing",
    "edits": [{ "file": "entry.js", "find": "console.log(run(3));\n", "replace": "" }],
    "cert": "match",
    "expect": { "code": 1, "contains": "has no unit in the output" }
  },
  {
    "name": "two effects run in the other order",
    "edits": [
      {
        "file": "entry.js",
        "find": "Registry.hooks.register(\"h\", run);\nconsole.log(run(3));",
        "replace": "console.log(run(3));\nRegistry.hooks.register(\"h\", run);"
      }
    ],
    "cert": "match",
    "expect": { "code": 4, "contains": "OBLIGATIONS" }
  }
]
