load("@aspect_rules_js//js:defs.bzl", "js_library", "js_test")
load("//devinfra/lint:linters.bzl", "eslint_test")

package(default_testonly = True)

# Sources resolve the parser and printer through the parent package's isolated npm links.
js_library(
    name = "harness",
    srcs = ["harness.mjs"],
    deps = [
        "//devinfra/js/debundle/x/split_proof/translation:node_modules/acorn",
        "//devinfra/js/debundle/x/split_proof/translation:node_modules/astring",
        "//devinfra/js/debundle/x/split_proof/translation/testing:deployment_manifest",
        "//devinfra/js/debundle/x/split_proof/translation/testing:split",
    ],
)

js_test(
    name = "input_test",
    data = [
        "//devinfra/js/debundle/x/split_proof/lean:linked_input_test_runner",
        "//devinfra/js/debundle/x/split_proof/translation:parser",
    ],
    entry_point = "input_test.mjs",
    env = {"LINKED_INPUT_CHECKER": "$(rootpath //devinfra/js/debundle/x/split_proof/lean:linked_input_test_runner)"},
)

js_test(
    name = "metadata_link_worlds_test",
    entry_point = "metadata_link_worlds_test.mjs",
    env = {"NODE_OPTIONS": "--experimental-vm-modules"},
)

js_library(
    name = "module_graph_fixture",
    srcs = ["module_graph_fixture.mjs"],
    visibility = ["//devinfra/js/debundle/x/split_proof/integration/excalidraw:__pkg__"],
)

_TEST_DATA = [
    ":harness",
    "//devinfra/js/debundle/x/split_proof/lean:lowersplit",
]

_TEST_ENV = {"LOWERSPLIT": "$(rootpath //devinfra/js/debundle/x/split_proof/lean:lowersplit)"}

# These valid Lean-backed shards exceed the medium budget or have timed out in CI.
_LONG_TIMEOUT_TESTS = [
    "browser_globals_test",
    "host_profile_test",
    "if_test",
    "literal_records_test",
    "mutations_test",
    "programs_test",
    "property_assignment_test",
    "provider_programs_test",
    "sequence_test",
    "switch_test",
    "wide_table_reversal_test",
]

js_test(
    name = "static_provider_boundary_input_test",
    data = glob(["fixtures/static_provider_boundary/**/*.mjs"]) + [
        "//devinfra/js/debundle/x/split_proof/lean:provider_input_boundary_test_runner",
        "//devinfra/js/debundle/x/split_proof/translation:parser",
    ],
    entry_point = "static_provider_boundary_input_test.mjs",
    env = {"PROVIDER_BOUNDARY_CHECKER": "$(rootpath //devinfra/js/debundle/x/split_proof/lean:provider_input_boundary_test_runner)"},
)

# Acceptance probe: distinguish this constructor from other certified strategies.
js_test(
    name = "module_graph_constructor_test",
    size = "medium",
    timeout = "long",
    data = _TEST_DATA + [
        ":module_graph_fixture",
        "//devinfra/js/debundle/x/split_proof/lean:linked_input_test_runner",
        "//devinfra/js/debundle/x/split_proof/translation:parser",
        "//devinfra/js/debundle/x/split_proof/translation/testing:split",
    ],
    entry_point = "module_graph_constructor_test.mjs",
    env = dict(
        _TEST_ENV,
        LINKED_INPUT_CHECKER = "$(rootpath //devinfra/js/debundle/x/split_proof/lean:linked_input_test_runner)",
    ),
)

js_test(
    name = "checked_artifact_test",
    size = "medium",
    data = [
        ":harness",
        "//devinfra/js/debundle/x/split_proof/lean:checked_artifact_test_runner",
        "//devinfra/js/debundle/x/split_proof/translation:module_io",
    ],
    entry_point = "checked_artifact_test.mjs",
    env = {
        "LOWERSPLIT": "$(rootpath //devinfra/js/debundle/x/split_proof/lean:checked_artifact_test_runner)",
        "SPLIT_PROOF_MODULE_IO": "$(rootpath //devinfra/js/debundle/x/split_proof/translation:module_io)",
        "SPLIT_PROOF_TIMINGS": "1",
    },
)

js_test(
    name = "sparse_checked_artifact_test",
    size = "medium",
    data = [
        ":harness",
        "//devinfra/js/debundle/x/split_proof/lean:checked_artifact_test_runner",
        "//devinfra/js/debundle/x/split_proof/translation:module_io",
    ],
    entry_point = "sparse_checked_artifact_test.mjs",
    env = {
        "LOWERSPLIT": "$(rootpath //devinfra/js/debundle/x/split_proof/lean:checked_artifact_test_runner)",
        "SPLIT_PROOF_MODULE_IO": "$(rootpath //devinfra/js/debundle/x/split_proof/translation:module_io)",
        "SPLIT_PROOF_TEST_SPARSE": "1",
    },
)

js_test(
    name = "terminal_export_artifact_test",
    size = "medium",
    data = _TEST_DATA,
    entry_point = "terminal_export_artifact_test.mjs",
    env = _TEST_ENV,
)

js_test(
    name = "joint_static_test",
    size = "medium",
    data = _TEST_DATA + [
        "//devinfra/js/debundle/x/split_proof/lean:joint_static_test_runner",
        "//devinfra/js/debundle/x/split_proof/translation:parser",
    ],
    entry_point = "joint_static_test.mjs",
    env = dict(
        _TEST_ENV,
        JOINT_CHECKER = "$(rootpath //devinfra/js/debundle/x/split_proof/lean:joint_static_test_runner)",
    ),
)

_UNSHARDED_TESTS = [
    "arithmetic_observer_test",
    "arithmetic_test",
    "arrays_test",
    "bitwise_test",
    "composition_test",
    "function_declaration_test",
    "if_test",
    "import_cells_test",
    "literal_records_test",
    "logical_test",
    "member_test",
    "module_graph_test",
    "module_metadata_test",
    "named_constructor_cli_test",
    "object_elements_test",
    "object_spread_test",
    "optional_callee_test",
    "provider_location_test",
    "realm_constructors_test",
    "record_values_test",
    "regexp_test",
    "relational_test",
    "reordering_test",
    "resolved_placement_test",
    "small_records_test",
    "switch_test",
    "wide_provider_scope_test",
    "wide_records_test",
]

_SHARD_COUNTS = {
    "browser_globals_test": 4,
    "dense_array_batch_test": 2,
    "host_profile_test": 3,
    "identifier_assignment_test": 3,
    "loops_test": 4,
    "mutations_test": 3,
    "numeric_property_keys_test": 2,
    "optional_chain_test": 3,
    "programs_test": 3,
    "property_assignment_test": 8,
    "provider_programs_test": 3,
    "sequence_test": 3,
    "wide_table_reversal_test": 2,
}

[
    js_test(
        name = name,
        size = "medium",
        timeout = "long" if name in _LONG_TIMEOUT_TESTS else "moderate",
        data = _TEST_DATA + ([":module_graph_fixture"] if name == "module_graph_test" else []),
        entry_point = name + ".mjs",
        env = _TEST_ENV,
        shard_count = _SHARD_COUNTS.get(name),
    )
    for name in _UNSHARDED_TESTS + _SHARD_COUNTS.keys()
]

# Preserve the 48-reader reduction-budget regression for explicit runs.
js_test(
    name = "module_graph_scale_test",
    size = "medium",
    args = ["--full-graph"],
    data = _TEST_DATA + [":module_graph_fixture"],
    entry_point = "module_graph_test.mjs",
    env = _TEST_ENV,
    tags = ["manual"],
)

js_test(
    name = "staged_ast_gate_test",
    size = "medium",
    data = _TEST_DATA + ["//devinfra/js/debundle/x/split_proof/translation/testing:deployment_manifest"],
    entry_point = "staged_ast_gate_test.mjs",
    env = dict(
        _TEST_ENV,
        SPLIT_PROOF_TIMINGS = "1",
    ),
)

js_test(
    name = "table_lookups_test",
    size = "medium",
    data = _TEST_DATA + [
        "//devinfra/js/debundle/x/split_proof/translation:node_modules/acorn",
        "//devinfra/js/debundle/x/split_proof/translation:node_modules/astring",
    ],
    entry_point = "table_lookups_test.mjs",
    env = _TEST_ENV,
)

js_test(
    name = "certified_split_test",
    data = [
        ":harness",
        "//devinfra/js/debundle/x/split_proof/lean:lowersplit",
        "//devinfra/js/debundle/x/split_proof/translation:parser",
        "//devinfra/js/debundle/x/split_proof/translation/testing:deployment_manifest",
        "//devinfra/js/debundle/x/split_proof/translation/testing:split",
    ],
    entry_point = "certified_split_test.mjs",
    env = {"LOWERSPLIT": "$(rootpath //devinfra/js/debundle/x/split_proof/lean:lowersplit)"},
    shard_count = 6,
)

js_library(
    name = "lint_sources",
    srcs = glob(["*.mjs"]),
)

eslint_test(
    name = "eslint_test",
    srcs = [":lint_sources"],
)
