load("@aspect_rules_js//js:defs.bzl", "js_library", "js_test")
load("//devinfra/lint:linters.bzl", "eslint_test")

package(default_testonly = True)

# Sources resolve the parser and printer through the parent package's isolated npm links.
js_library(
    name = "harness",
    srcs = ["harness.mjs"],
    deps = [
        "//devinfra/js/debundle/x/split_proof/translation:node_modules/acorn",
        "//devinfra/js/debundle/x/split_proof/translation:node_modules/astring",
        "//devinfra/js/debundle/x/split_proof/translation/testing:split",
    ],
)

js_test(
    name = "hoisted_helper_link_test",
    data = [
        "//devinfra/js/debundle/x/split_proof:hoisted_helper_link_test_runner",
        "//devinfra/js/debundle/x/split_proof/translation:parser",
    ],
    entry_point = "hoisted_helper_link_test.mjs",
    env = {"HOISTED_HELPER_CHECKER": "$(rootpath //devinfra/js/debundle/x/split_proof:hoisted_helper_link_test_runner)"},
)

js_test(
    name = "input_test",
    data = [
        "//devinfra/js/debundle/x/split_proof:linked_input_test_runner",
        "//devinfra/js/debundle/x/split_proof/translation:parser",
    ],
    entry_point = "input_test.mjs",
    env = {"LINKED_INPUT_CHECKER": "$(rootpath //devinfra/js/debundle/x/split_proof:linked_input_test_runner)"},
)

js_test(
    name = "metadata_link_worlds_test",
    entry_point = "metadata_link_worlds_test.mjs",
    env = {"NODE_OPTIONS": "--experimental-vm-modules"},
)

js_library(
    name = "module_graph_fixture",
    srcs = ["module_graph_fixture.mjs"],
    visibility = ["//devinfra/js/debundle/x/split_proof/integration/excalidraw:__pkg__"],
)

_TEST_DATA = [
    ":harness",
    "//devinfra/js/debundle/x/split_proof:lowersplit",
]

_TEST_ENV = {"LOWERSPLIT": "$(rootpath //devinfra/js/debundle/x/split_proof:lowersplit)"}

js_test(
    name = "ranked_allocation_test",
    data = _TEST_DATA + ["//devinfra/js/debundle/x/split_proof/translation/testing:split"],
    entry_point = "ranked_allocation_test.mjs",
    env = _TEST_ENV,
)

js_test(
    name = "static_provider_boundary_input_test",
    data = glob(["fixtures/static_provider_boundary/**/*.mjs"]) + [
        "//devinfra/js/debundle/x/split_proof:provider_input_boundary_test_runner",
        "//devinfra/js/debundle/x/split_proof/translation:parser",
    ],
    entry_point = "static_provider_boundary_input_test.mjs",
    env = {"PROVIDER_BOUNDARY_CHECKER": "$(rootpath //devinfra/js/debundle/x/split_proof:provider_input_boundary_test_runner)"},
)

# Acceptance probe: distinguish this constructor from other certified strategies.
js_test(
    name = "module_graph_constructor_test",
    size = "medium",
    timeout = "long",
    data = _TEST_DATA + [
        ":module_graph_fixture",
        "//devinfra/js/debundle/x/split_proof:linked_input_test_runner",
        "//devinfra/js/debundle/x/split_proof/translation:parser",
        "//devinfra/js/debundle/x/split_proof/translation/testing:split",
    ],
    entry_point = "module_graph_constructor_test.mjs",
    env = dict(
        _TEST_ENV,
        LINKED_INPUT_CHECKER = "$(rootpath //devinfra/js/debundle/x/split_proof:linked_input_test_runner)",
    ),
)

js_test(
    name = "checked_artifact_test",
    size = "medium",
    data = [
        ":harness",
        "//devinfra/js/debundle/x/split_proof:checked_artifact_test_runner",
        "//devinfra/js/debundle/x/split_proof/translation:module_io",
    ],
    entry_point = "checked_artifact_test.mjs",
    env = {
        "LOWERSPLIT": "$(rootpath //devinfra/js/debundle/x/split_proof:checked_artifact_test_runner)",
        "SPLIT_PROOF_MODULE_IO": "$(rootpath //devinfra/js/debundle/x/split_proof/translation:module_io)",
        "SPLIT_PROOF_TIMINGS": "1",
    },
)

js_test(
    name = "sparse_checked_artifact_test",
    size = "medium",
    data = [
        ":harness",
        "//devinfra/js/debundle/x/split_proof:checked_artifact_test_runner",
        "//devinfra/js/debundle/x/split_proof/translation:module_io",
    ],
    entry_point = "sparse_checked_artifact_test.mjs",
    env = {
        "LOWERSPLIT": "$(rootpath //devinfra/js/debundle/x/split_proof:checked_artifact_test_runner)",
        "SPLIT_PROOF_MODULE_IO": "$(rootpath //devinfra/js/debundle/x/split_proof/translation:module_io)",
        "SPLIT_PROOF_TEST_SPARSE": "1",
    },
)

_CATCHALL_SOURCE = "//devinfra/js/debundle/e2e:cases/emission/catchall_exports/main.js"

_CATCHALL_PROBE = "//devinfra/js/debundle/e2e:cases/emission/catchall_exports/read.probe.mjs"

js_test(
    name = "private_priority_cli_test",
    data = _TEST_DATA + [
        _CATCHALL_SOURCE,
        _CATCHALL_PROBE,
    ],
    entry_point = "private_priority_cli_test.mjs",
    env = dict(
        _TEST_ENV,
        CATCHALL_PROBE = "$(rootpath " + _CATCHALL_PROBE + ")",
        CATCHALL_SOURCE = "$(rootpath " + _CATCHALL_SOURCE + ")",
    ),
    no_copy_to_bin = [
        _CATCHALL_SOURCE,
        _CATCHALL_PROBE,
    ],
)

js_test(
    name = "terminal_export_artifact_test",
    size = "medium",
    data = _TEST_DATA,
    entry_point = "terminal_export_artifact_test.mjs",
    env = _TEST_ENV,
)

js_test(
    name = "joint_static_test",
    size = "medium",
    data = _TEST_DATA + [
        "//devinfra/js/debundle/x/split_proof:joint_static_test_runner",
        "//devinfra/js/debundle/x/split_proof/translation:parser",
    ],
    entry_point = "joint_static_test.mjs",
    env = dict(
        _TEST_ENV,
        JOINT_CHECKER = "$(rootpath //devinfra/js/debundle/x/split_proof:joint_static_test_runner)",
    ),
)

_UNSHARDED_TESTS = [
    "arithmetic_test",
    "generator_test",
    "hoisted_helper_constructor_test",
    "import_cells_test",
    "logical_test",
    "module_graph_test",
    "module_metadata_test",
    "named_constructor_cli_test",
    "provider_location_test",
]

[
    js_test(
        name = name,
        size = "medium",
        data = _TEST_DATA + ([":module_graph_fixture"] if name == "module_graph_test" else []),
        entry_point = name + ".mjs",
        env = _TEST_ENV,
    )
    for name in _UNSHARDED_TESTS
]

# Preserve the 48-reader reduction-budget regression for explicit runs.
js_test(
    name = "module_graph_scale_test",
    size = "medium",
    args = ["--full-graph"],
    data = _TEST_DATA + [":module_graph_fixture"],
    entry_point = "module_graph_test.mjs",
    env = _TEST_ENV,
    tags = ["manual"],
)

js_test(
    name = "staged_ast_gate_test",
    size = "medium",
    data = _TEST_DATA + ["//devinfra/js/debundle/x/split_proof/translation/testing:deployment_manifest"],
    entry_point = "staged_ast_gate_test.mjs",
    env = dict(
        _TEST_ENV,
        SPLIT_PROOF_TIMINGS = "1",
    ),
)

js_test(
    name = "certified_split_test",
    data = [
        ":harness",
        "//devinfra/js/debundle/x/split_proof:lowersplit",
        "//devinfra/js/debundle/x/split_proof/translation:parser",
        "//devinfra/js/debundle/x/split_proof/translation/testing:deployment_manifest",
        "//devinfra/js/debundle/x/split_proof/translation/testing:split",
    ],
    entry_point = "certified_split_test.mjs",
    env = {"LOWERSPLIT": "$(rootpath //devinfra/js/debundle/x/split_proof:lowersplit)"},
    shard_count = 6,
)

js_library(
    name = "lint_sources",
    srcs = glob(["*.mjs"]),
)

eslint_test(
    name = "eslint_test",
    srcs = [":lint_sources"],
)

js_test(
    name = "var_constructor_test",
    data = [
        "//devinfra/js/debundle/x/split_proof:lowersplit",
        "//devinfra/js/debundle/x/split_proof/translation/testing:split",
    ],
    entry_point = "var_constructor_test.mjs",
    env = {"LOWERSPLIT": "$(rootpath //devinfra/js/debundle/x/split_proof:lowersplit)"},
)

js_test(
    name = "await_placement_boundary_test",
    data = _TEST_DATA,
    entry_point = "await_placement_boundary_test.mjs",
    env = _TEST_ENV,
)

js_test(
    name = "await_staged_link_test",
    data = _TEST_DATA + [
        "//devinfra/js/debundle/x/split_proof:await_staged_link_test_runner",
        "//devinfra/js/debundle/x/split_proof/translation:module_io",
    ],
    entry_point = "await_staged_link_test.mjs",
    env = _TEST_ENV | {
        "AWAIT_STAGED_LINK": "$(rootpath //devinfra/js/debundle/x/split_proof:await_staged_link_test_runner)",
        "SPLIT_PROOF_MODULE_IO": "$(rootpath //devinfra/js/debundle/x/split_proof/translation:module_io)",
    },
)
