load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library")

package(
    default_testonly = True,
    default_visibility = ["//devinfra/js/debundle/x/split_proof/translation:__pkg__"],
)

js_library(
    name = "ast_assertions",
    srcs = ["ast_assertions.mjs"],
    visibility = [
        "//devinfra/js/debundle/x/split_proof/integration/excalidraw:__pkg__",
        "//devinfra/js/debundle/x/split_proof/translation:__pkg__",
    ],
    deps = [
        "//devinfra/js/debundle/x/split_proof/translation:node_modules/acorn",
        "//devinfra/js/debundle/x/split_proof/translation:scope_metadata",
    ],
)

js_library(
    name = "ast_generator",
    srcs = ["ast_generator.mjs"],
    deps = [
        "//devinfra/js/debundle/x/split_proof:seeded_random",
        "//devinfra/js/debundle/x/split_proof/translation:node_modules/astring",
    ],
)

js_library(
    name = "check_translation",
    srcs = ["check_translation.mjs"],
    deps = [
        "//devinfra/js/debundle/x/split_proof/translation:frontend",
        "//devinfra/js/debundle/x/split_proof/translation:pair",
    ],
)

js_library(
    name = "diagnostic_split",
    srcs = ["diagnostic_split.mjs"],
    deps = [
        ":deployment_manifest",
        ":split",
        "//devinfra/js/debundle/x/split_proof/translation:parser",
    ],
)

js_library(
    name = "linked_model_probe",
    srcs = ["linked_model_probe.mjs"],
    visibility = ["//devinfra/js/debundle/x/split_proof/translation/linked:__pkg__"],
    deps = ["//devinfra/js/debundle/x/split_proof/translation:parser"],
)

js_library(
    name = "lint_sources",
    srcs = glob(["**/*.mjs"]),
)

js_library(
    name = "public_refusal",
    srcs = ["public_refusal.mjs"],
    visibility = ["//devinfra/js/debundle/x/split_proof:__subpackages__"],
)

js_library(
    name = "split",
    srcs = ["split.mjs"],
    visibility = ["//devinfra/js/debundle/x/split_proof:__subpackages__"],
    deps = [":deployment_manifest"],
)

js_library(
    name = "split_preview",
    srcs = ["split_preview.mjs"],
    visibility = ["//devinfra/js/debundle/x/split_proof:__subpackages__"],
    deps = [":deployment_manifest"],
)

js_binary(
    name = "split_cli",
    data = [
        ":split",
        "//devinfra/js/debundle/x/split_proof/lean:lowersplit",
    ],
    entry_point = "split_cli.mjs",
    env = {
        "LOWERSPLIT": "$(rootpath //devinfra/js/debundle/x/split_proof/lean:lowersplit)",
    },
    visibility = ["//devinfra/js/debundle/x/split_proof/translation:__pkg__"],
)

js_library(
    name = "deployment_manifest",
    testonly = False,
    srcs = ["deployment_manifest.mjs"],
    visibility = ["//devinfra/js/debundle/x/split_proof:__subpackages__"],
)
