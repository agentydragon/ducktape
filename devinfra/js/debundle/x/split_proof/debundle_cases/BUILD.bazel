load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_test")

_RUNNER_DATA = [
    "certify.mjs",
    "expectations.mjs",
    "results/cases.jsonl",
    "verdict.mjs",
    "//:node_modules/yaml",
    "//devinfra/js/debundle:debundle_resolve_placement",
    "//devinfra/js/debundle/e2e:corpus_files",
    "//devinfra/js/debundle/x/split_proof:lowersplit",
    "//devinfra/js/debundle/x/split_proof/translation:annotated_estree",
    "//devinfra/js/debundle/x/split_proof/translation:parser",
    "//devinfra/js/debundle/x/split_proof/translation/testing:deployment_manifest",
]

_RUNNER_ENV = {
    "DEBUNDLE_RESOLVER": "$(rootpath //devinfra/js/debundle:debundle_resolve_placement)",
    "LOWERSPLIT": "$(rootpath //devinfra/js/debundle/x/split_proof:lowersplit)",
}

js_binary(
    name = "debundle_cases",
    testonly = True,
    data = _RUNNER_DATA,
    entry_point = "run_cases.mjs",
    env = _RUNNER_ENV,
    tags = ["manual"],
)

js_test(
    name = "ordinary_certification_test",
    size = "large",
    args = ["--certify"],
    data = _RUNNER_DATA,
    entry_point = "run_cases.mjs",
    env = _RUNNER_ENV,
    shard_count = 6,
)

js_test(
    name = "member_rename_boundary_test",
    data = _RUNNER_DATA + ["run_cases.mjs"],
    entry_point = "member_rename_boundary_test.mjs",
    env = _RUNNER_ENV,
)

js_binary(
    name = "summarize_debundle_cases",
    data = ["//devinfra/js/debundle/x/split_proof:reporting"],
    entry_point = "summarize.mjs",
    tags = ["manual"],
)

js_test(
    name = "corpus_verdict_test",
    data = ["verdict.mjs"],
    entry_point = "verdict_test.mjs",
)

_CORPUS_CHUNK = "//devinfra/js/debundle/e2e:cases/emission/catchall_export_consumer/app.js"

_PROBE = "//devinfra/js/debundle/e2e:cases/emission/catchall_export_consumer/read.probe.mjs"

js_test(
    name = "corpus_certificate_test",
    data = [
        _CORPUS_CHUNK,
        _PROBE,
        "//devinfra/js/debundle/x/split_proof:lowersplit",
        "//devinfra/js/debundle/x/split_proof/translation/testing:split",
    ],
    entry_point = "certificate_test.mjs",
    env = {
        "PROBE": "$(rootpath " + _PROBE + ")",
        "CHUNK": "$(rootpath " + _CORPUS_CHUNK + ")",
        "LOWERSPLIT": "$(rootpath //devinfra/js/debundle/x/split_proof:lowersplit)",
    },
    no_copy_to_bin = [
        _CORPUS_CHUNK,
        _PROBE,
    ],
)

js_test(
    name = "provider_runtime_test",
    size = "medium",
    data = [
        "//devinfra/js/debundle/e2e:cases/emission/return_object_provider_import/main.js",
        "//devinfra/js/debundle/e2e:cases/emission/return_object_provider_import/provider_module.js",
    ],
    entry_point = "provider_runtime_test.mjs",
    env = {
        "MAIN_JS": "$(rootpath //devinfra/js/debundle/e2e:cases/emission/return_object_provider_import/main.js)",
        "PROVIDER_MODULE": "$(rootpath //devinfra/js/debundle/e2e:cases/emission/return_object_provider_import/provider_module.js)",
    },
    no_copy_to_bin = [
        "//devinfra/js/debundle/e2e:cases/emission/return_object_provider_import/main.js",
        "//devinfra/js/debundle/e2e:cases/emission/return_object_provider_import/provider_module.js",
    ],
)

js_test(
    name = "placement_routing_test",
    data = ["//devinfra/js/debundle:debundle_resolve_placement"],
    entry_point = "placement_routing_test.mjs",
    env = {"DEBUNDLE_RESOLVER": "$(rootpath //devinfra/js/debundle:debundle_resolve_placement)"},
)

js_test(
    name = "prefix_readback_test",
    size = "medium",
    data = _RUNNER_DATA + [
        "run_cases.mjs",
        "//devinfra/js/debundle",
        "//devinfra/js/debundle/x/split_proof:prefix_readback_test_runner",
        "//devinfra/js/debundle/x/split_proof/translation:module_io",
    ],
    entry_point = "prefix_readback_test.mjs",
    env = dict(
        _RUNNER_ENV,
        DEBUNDLE = "$(rootpath //devinfra/js/debundle:debundle)",
        PREFIX_READBACK = "$(rootpath //devinfra/js/debundle/x/split_proof:prefix_readback_test_runner)",
        SPLIT_PROOF_MODULE_IO = "$(rootpath //devinfra/js/debundle/x/split_proof/translation:module_io)",
    ),
)

js_test(
    name = "expectation_ledger_test",
    size = "large",
    data = _RUNNER_DATA + ["run_cases.mjs"],
    entry_point = "expectation_ledger_test.mjs",
    env = _RUNNER_ENV,
)
