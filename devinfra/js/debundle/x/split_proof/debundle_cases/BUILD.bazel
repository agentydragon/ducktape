load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_test")

_RUNNER_DATA = [
    "certify.mjs",
    "results/cases.jsonl",
    "verdict.mjs",
    "//:node_modules/yaml",
    "//devinfra/js/debundle:debundle_resolve_placement",
    "//devinfra/js/debundle/e2e:corpus_files",
    "//devinfra/js/debundle/x/split_proof/lean:lowersplit",
    "//devinfra/js/debundle/x/split_proof/translation:annotated_estree",
    "//devinfra/js/debundle/x/split_proof/translation:parser",
    "//devinfra/js/debundle/x/split_proof/translation/testing:deployment_manifest",
]

_RUNNER_ENV = {
    "DEBUNDLE_RESOLVER": "$(rootpath //devinfra/js/debundle:debundle_resolve_placement)",
    "LOWERSPLIT": "$(rootpath //devinfra/js/debundle/x/split_proof/lean:lowersplit)",
}

_SPLIT_PREVIEW = "//devinfra/js/debundle/x/split_proof/lean:split_preview"

js_binary(
    name = "debundle_cases",
    testonly = True,
    data = _RUNNER_DATA + [
        _SPLIT_PREVIEW,
    ],
    entry_point = "run_cases.mjs",
    env = _RUNNER_ENV | {"SPLIT_PREVIEW": "$(rootpath " + _SPLIT_PREVIEW + ")"},
    tags = ["manual"],
)

js_test(
    name = "pinned_certificates_test",
    size = "large",
    args = ["--check-certificates"],
    data = _RUNNER_DATA + ["results/certificates.jsonl"],
    entry_point = "run_cases.mjs",
    env = _RUNNER_ENV,
    shard_count = 6,
)

js_binary(
    name = "summarize_debundle_cases",
    data = ["//devinfra/js/debundle/x/split_proof:reporting"],
    entry_point = "summarize.mjs",
    tags = ["manual"],
)

js_test(
    name = "corpus_verdict_test",
    data = ["verdict.mjs"],
    entry_point = "verdict_test.mjs",
)

_CORPUS_CHUNK = "//devinfra/js/debundle/e2e:cases/emission/catchall_export_consumer/app.js"

_PROBE = "//devinfra/js/debundle/e2e:cases/emission/catchall_export_consumer/read.probe.mjs"

js_test(
    name = "corpus_certificate_test",
    data = [
        _CORPUS_CHUNK,
        _PROBE,
        "//devinfra/js/debundle/x/split_proof/lean:lowersplit",
        "//devinfra/js/debundle/x/split_proof/translation/testing:split",
    ],
    entry_point = "certificate_test.mjs",
    env = {
        "PROBE": "$(rootpath " + _PROBE + ")",
        "CHUNK": "$(rootpath " + _CORPUS_CHUNK + ")",
        "LOWERSPLIT": "$(rootpath //devinfra/js/debundle/x/split_proof/lean:lowersplit)",
    },
    no_copy_to_bin = [
        _CORPUS_CHUNK,
        _PROBE,
    ],
)

js_test(
    name = "provider_runtime_test",
    size = "medium",
    data = [":debundle_cases"],
    entry_point = "provider_runtime_test.mjs",
    env = {"CASE_RUNNER": "$(rootpath :debundle_cases)"},
)

js_test(
    name = "placement_routing_test",
    data = [":debundle_cases"],
    entry_point = "placement_routing_test.mjs",
    env = {"CASE_RUNNER": "$(rootpath :debundle_cases)"},
)
