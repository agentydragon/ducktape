    env = {
        "COREJS": "$(rootpath //devinfra/js/debundle/x/split_proof/lean:corejs)",
        "CORPUS_MANIFEST": "$(rootpath //devinfra/js/debundle/e2e:corpus_files)",
        "EXCALIDRAW_OUTPUTS": "$(rootpaths //devinfra/js/debundle/excalidraw:bundle)",
        "LIBRARY_PREPARE": "$(rootpath //devinfra/js/debundle/x/split_proof/integration/library_splits:prepare)",
    },
    shard_count = 4,
