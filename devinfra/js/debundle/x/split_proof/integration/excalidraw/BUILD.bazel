        "bench",
        "manual",
    ],
)

# Bounded public-workload investigation; reports refusals without treating them as proof failures.
js_test(
    name = "excalidraw_certificate_census",
    size = "large",
    timeout = "long",
    data = _DUMP_DATA + [
        "//devinfra/js/debundle/excalidraw:bundle",
        "//devinfra/js/debundle/x/split_proof/lean:lower",
        "//devinfra/js/debundle/x/split_proof/translation/testing:deployment_manifest",
    ],
    entry_point = "run.mjs",
    env = dict(
        _LOWERSPLIT_ENV,
        EXCALIDRAW_OUTPUTS = "$(rootpaths //devinfra/js/debundle/excalidraw:bundle)",
        LOWER = "$(rootpath //devinfra/js/debundle/x/split_proof/lean:lower)",
    ),
    tags = ["manual"],
)

_EXCALIDRAW_GRAPHS = "//devinfra/js/debundle/excalidraw:spec_graphs"

_EXCALIDRAW_SPEC_DIR = "excalidraw_lean_specs"

_EXCALIDRAW_EDITOR_SPEC = _EXCALIDRAW_SPEC_DIR + "/editor.json"

_EXCALIDRAW_MAIN_SPEC = _EXCALIDRAW_SPEC_DIR + "/main.json"

js_binary(
    name = "generate_excalidraw_lean_specs",
    entry_point = "generate_specs.mjs",
)

js_run_binary(
    name = "excalidraw_lean_specs",
    testonly = True,
    srcs = [_EXCALIDRAW_GRAPHS],
    outs = [
        _EXCALIDRAW_EDITOR_SPEC,
        _EXCALIDRAW_MAIN_SPEC,
    ],
    args = [
        "$(execpath " + _EXCALIDRAW_GRAPHS + ")",
        "$(RULEDIR)/" + _EXCALIDRAW_SPEC_DIR,
        "editor",
        "main",
    ],
    tool = ":generate_excalidraw_lean_specs",
)

js_test(
    name = "excalidraw_lean_specs_test",
    data = [":generate_specs"],
    entry_point = "generate_specs_test.mjs",
)

js_test(
    name = "excalidraw_authored_placements",
    size = "large",
    data = _DUMP_DATA + [
        "//devinfra/js/debundle/x/split_proof/translation/testing:ast_assertions",
        ":" + _EXCALIDRAW_EDITOR_SPEC,
        ":" + _EXCALIDRAW_MAIN_SPEC,
        "//devinfra/js/debundle/excalidraw:inputs",
