    entry_point = "authored.mjs",
    env = dict(
        _LOWERSPLIT_ENV,
        EDITOR_LEAN_SPEC = "$(rootpath :" + _EXCALIDRAW_EDITOR_SPEC + ")",
        EXCALIDRAW_INPUTS = "$(rootpaths //devinfra/js/debundle/excalidraw:inputs)",
        MAIN_LEAN_SPEC = "$(rootpath :" + _EXCALIDRAW_MAIN_SPEC + ")",
        SPEC_GRAPHS = "$(rootpath " + _EXCALIDRAW_GRAPHS + ")",
    ),
    tags = ["manual"],
)

