_LOWERSPLIT_ENV = {"LOWERSPLIT": "$(rootpath //devinfra/js/debundle/x/split_proof/lean:lowersplit)"}

js_test(
    name = "lowering_census",
    data = [
        "//devinfra/js/debundle/e2e:corpus_files",
        "//devinfra/js/debundle/excalidraw:bundle",
        "//devinfra/js/debundle/x/split_proof/integration/library_splits:prepare",
