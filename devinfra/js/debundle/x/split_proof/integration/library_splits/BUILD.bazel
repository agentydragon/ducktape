_LIBRARY_CERT_VARIANTS = [
    "acorn",
    "semver",
]

_LIBRARY_VARIANTS = _LIBRARY_CERT_VARIANTS + [
    "lodash",
    "zod",
]

[
    js_run_binary(
        name = "prepare_" + variant,
        outs = ["real_bundles/" + variant + ext for ext in [
            ".mjs",
            ".json",
            ".map",
            ".meta.json",
        ]],
        args = [
            "real_bundles",
            "--provenance",
            variant,
        ],
        chdir = package_name(),
        tool = ":prepare",
    )
    for variant in _LIBRARY_VARIANTS
]

_CENSUS_EXTRA = [
    "acorn.min",
    "lodash.min",
    "semver.min",
    "zod.min",
]

