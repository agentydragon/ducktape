load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library", "js_run_binary", "js_test")
load("@npm_split_proof//:defs.bzl", "npm_link_all_packages")
load("//devinfra/lint:linters.bzl", "eslint_test")

npm_link_all_packages(name = "node_modules")

js_binary(
    name = "prepare",
    data = glob(["entries/*.mjs"]) + [
        ":node_modules/acorn",
        ":node_modules/eslint-scope",
        ":node_modules/lodash-es",
        ":node_modules/semver",
        ":node_modules/zod",
        "//:node_modules/esbuild",
        "//devinfra/js/debundle/x/split_proof/translation:annotated_estree",
        "//devinfra/js/debundle/x/split_proof/translation:scope_metadata",
    ],
    entry_point = "prepare.mjs",
    visibility = ["//devinfra/js/debundle/x/split_proof/integration/excalidraw:__pkg__"],
)

js_test(
    name = "standalone_parser_dump_test",
    size = "small",
    data = [
        "entries/acorn.mjs",
        "entries/semver.mjs",
        "prepare.mjs",
        ":node_modules/acorn",
        ":node_modules/eslint-scope",
        ":node_modules/semver",
        "//:node_modules/esbuild",
        "//devinfra/js/debundle/x/split_proof/translation:annotated_estree",
        "//devinfra/js/debundle/x/split_proof/translation:scope_metadata",
    ],
    entry_point = "standalone_parser_dump_test.mjs",
)

_LIBRARY_CERT_VARIANTS = [
    "acorn",
    "semver",
]

[
    js_run_binary(
        name = "prepare_" + variant,
        outs = ["real_bundles/" + variant + ext for ext in [
            ".mjs",
            ".json",
        ]],
        args = [
            "real_bundles",
            variant,
        ],
        chdir = package_name(),
        tool = ":prepare",
    )
    for variant in _LIBRARY_CERT_VARIANTS
]

_LIBRARY_SOURCES = [":real_bundles/" + variant + ".mjs" for variant in _LIBRARY_CERT_VARIANTS]

js_test(
    name = "library_certificate_test",
    size = "medium",
    args = ["$(rootpath " + src + ")" for src in _LIBRARY_SOURCES],
    data = _LIBRARY_SOURCES + [src.removesuffix(".mjs") + ".json" for src in _LIBRARY_SOURCES] + [
        "gen_spec.mjs",
        "smoke.mjs",
        "//devinfra/js/debundle/x/split_proof:lowersplit",
        "//devinfra/js/debundle/x/split_proof:seeded_random",
        "//devinfra/js/debundle/x/split_proof/translation:scope_metadata",
        "//devinfra/js/debundle/x/split_proof/translation/testing:deployment_manifest",
        "//devinfra/js/debundle/x/split_proof/translation/testing:split",
    ],
    entry_point = "certificate_test.mjs",
    env = {"LOWERSPLIT": "$(rootpath //devinfra/js/debundle/x/split_proof:lowersplit)"},
)

js_library(
    name = "lint_sources",
    testonly = True,
    srcs = glob([
        "*.mjs",
        "entries/*.mjs",
    ]),
)

eslint_test(
    name = "eslint_test",
    srcs = [":lint_sources"],
)

js_test(
    name = "acorn_projection",
    size = "medium",
    args = ["$(rootpath :real_bundles/acorn.mjs)"],
    data = [
        ":node_modules/acorn",
        ":real_bundles/acorn.mjs",
        "//devinfra/js/debundle/x/split_proof:lowersplit",
        "//devinfra/js/debundle/x/split_proof/translation:scope_metadata",
        "//devinfra/js/debundle/x/split_proof/translation/testing:split",
    ],
    entry_point = "acorn_projection.mjs",
    env = {"LOWERSPLIT": "$(rootpath //devinfra/js/debundle/x/split_proof:lowersplit)"},
    tags = ["manual"],
)
