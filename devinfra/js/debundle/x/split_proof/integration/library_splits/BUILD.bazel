load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library")
load("//devinfra/lint:linters.bzl", "eslint_test")
load(":sweep.bzl", "real_split_sweeps")

js_binary(
    name = "real_split",
    data = [
        "gen_spec.mjs",
        "smoke.mjs",
        "//devinfra/js/debundle/x/split_proof:seeded_random",
        "//devinfra/js/debundle/x/split_proof/lean:lower",
        "//devinfra/js/debundle/x/split_proof/lean:lowersplit",
        "//devinfra/js/debundle/x/split_proof/translation:scope_metadata",
    ],
    entry_point = "run_splits.mjs",
    env = {
        "LOWER": "$(rootpath //devinfra/js/debundle/x/split_proof/lean:lower)",
        "LOWERSPLIT": "$(rootpath //devinfra/js/debundle/x/split_proof/lean:lowersplit)",
    },
    tags = ["manual"],
)

js_binary(
    name = "summarize_real_splits",
    data = ["//devinfra/js/debundle/x/split_proof:reporting"],
    entry_point = "summarize.mjs",
    tags = ["manual"],
)

real_split_sweeps()

js_library(
    name = "lint_sources",
    testonly = True,
    srcs = glob(["*.mjs"]),
)

eslint_test(
    name = "eslint_test",
    srcs = [":lint_sources"],
)
