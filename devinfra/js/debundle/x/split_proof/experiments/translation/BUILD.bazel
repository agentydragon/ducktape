load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_run_binary", "js_test")
load("@npm_split_proof_translation//:defs.bzl", "npm_link_all_packages")

npm_link_all_packages(name = "node_modules")

_TRANSLATE = "//devinfra/js/debundle/x/split_proof/lean:translate"

_CHECKER_RUNFILES = [
    "frontend.mjs",
    "scope_metadata.mjs",
    ":node_modules/acorn",
    ":node_modules/eslint-scope",
    _TRANSLATE,
]

js_test(
    name = "fixtures_test",
    data = [
        "mutate.mjs",
        "pair.mjs",
    ] + _CHECKER_RUNFILES + glob(
        ["fixtures/**"],
        allow_empty = False,
    ),
    entry_point = "test.mjs",
    env = {"TRANSLATE": "$(rootpath " + _TRANSLATE + ")"},
)

js_test(
    name = "identity_emission_test",
    data = _CHECKER_RUNFILES + [
        "fixtures/local_identity/bundle.js",
        "pair.mjs",
        "//devinfra/js/debundle/x/split_proof:lowering_dump_core",
        "//devinfra/js/debundle/x/split_proof/lean:lowersplit",
    ],
    entry_point = "identity_emission_test.mjs",
    env = {
        "LOWERSPLIT": "$(rootpath //devinfra/js/debundle/x/split_proof/lean:lowersplit)",
        "TRANSLATE": "$(rootpath " + _TRANSLATE + ")",
    },
)

js_test(
    name = "factory_emission_test",
    data = _CHECKER_RUNFILES + [
        "pair.mjs",
        "//devinfra/js/debundle/x/split_proof:lowering_dump_core",
        "//devinfra/js/debundle/x/split_proof/lean:lowersplit",
    ],
    entry_point = "factory_emission_test.mjs",
    env = {
        "LOWERSPLIT": "$(rootpath //devinfra/js/debundle/x/split_proof/lean:lowersplit)",
        "TRANSLATE": "$(rootpath " + _TRANSLATE + ")",
    },
)

js_binary(
    name = "identity_certificate_tool",
    data = [
        "fixtures/local_identity/bundle.js",
        "scope_metadata.mjs",
        ":node_modules/acorn",
        ":node_modules/eslint-scope",
        "//devinfra/js/debundle/x/split_proof:lowering_dump_core",
        "//devinfra/js/debundle/x/split_proof/lean:lowersplit",
    ],
    entry_point = "identity_certificate.mjs",
    env = {"LOWERSPLIT": "$(rootpath //devinfra/js/debundle/x/split_proof/lean:lowersplit)"},
)

js_run_binary(
    name = "identity_certificate_source",
    stdout = "generated/IdentityCertificate.lean",
    tool = ":identity_certificate_tool",
    visibility = ["//devinfra/js/debundle/x/split_proof/lean/generated:__pkg__"],
)

js_test(
    name = "callback_fuzz_test",
    size = "small",
    args = [
        "--callback-corpus",
        "--count",
        "16",
        "--seed",
        "1",
        "--trees",
        "2",
        "--jobs",
        "4",
        "--require-accepted",
    ],
    data = _CHECKER_RUNFILES,
    entry_point = "fuzz.mjs",
    env = {"TRANSLATE": "$(rootpath " + _TRANSLATE + ")"},
)

js_test(
    name = "callback_fuzz_second_seed_test",
    size = "small",
    args = [
        "--callback-corpus",
        "--count",
        "16",
        "--seed",
        "2026",
        "--trees",
        "2",
        "--jobs",
        "4",
        "--require-accepted",
    ],
    data = _CHECKER_RUNFILES,
    entry_point = "fuzz.mjs",
    env = {"TRANSLATE": "$(rootpath " + _TRANSLATE + ")"},
)

js_test(
    name = "fuzz_test",
    size = "small",
    args = [
        "--count",
        "16",
        "--seed",
        "1",
        "--trees",
        "4",
        "--jobs",
        "2",
        "--require-accepted",
    ],
    data = _CHECKER_RUNFILES,
    entry_point = "fuzz.mjs",
    env = {"TRANSLATE": "$(rootpath " + _TRANSLATE + ")"},
    tags = ["manual"],
)

js_test(
    name = "prototype_guard_test",
    data = [
        "prototype_guard.mjs",
        ":node_modules/acorn",
    ],
    entry_point = "prototype_guard_test.mjs",
)

js_binary(
    name = "prototype_guard",
    data = [
        "prototype_guard.mjs",
        ":node_modules/acorn",
    ],
    entry_point = "prototype_guard_cli.mjs",
)

js_test(
    name = "call_facts_test",
    data = [
        "call_facts.mjs",
        ":node_modules/acorn",
        ":node_modules/eslint-scope",
    ],
    entry_point = "call_facts_test.mjs",
)

js_binary(
    name = "call_facts",
    data = [
        "call_facts.mjs",
        ":node_modules/acorn",
        ":node_modules/eslint-scope",
    ],
    entry_point = "call_facts_cli.mjs",
)

exports_files(
    ["fixtures/callback/bundle.js"],
    visibility = ["//devinfra/js/debundle/x/split_proof:__pkg__"],
)

js_binary(
    name = "frontend_lean",
    data = [
        "frontend.mjs",
        "scope_metadata.mjs",
        ":node_modules/acorn",
        ":node_modules/eslint-scope",
    ],
    entry_point = "frontend_lean.mjs",
    visibility = ["//devinfra/js/debundle/x/split_proof:__pkg__"],
)
