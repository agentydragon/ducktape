    size = "medium",
    data = glob(["gen/*.mjs"]) + [
        "syntax_inventory.mjs",
        ":node_modules/acorn",
    ],
    entry_point = "gen_validity_test.mjs",
)

# The end-to-end oracle on programs of `gen/`: a tree the checker accepts must print what the bundle prints. The constructs of
# the findings that stand (`debug/generator_findings`: F3 `new Array(n)`, F4 `delete a?.b`, F6 a read through a `Proxy` whose
# traps write) are left out, so that this fails on a new one.
js_test(
    name = "full_fuzz_test",
    size = "medium",
    args = [
        "--full-corpus",
        "--count",
        "16",
        "--seed",
        "1",
        "--trees",
        "3",
        "--jobs",
        "4",
        "--require-accepted",
        "--avoid",
        "array-constructor,optional-delete,proxy",
    ],
    data = _CHECKER_RUNFILES + _FUZZ_SOURCES,
    entry_point = "fuzz.mjs",
    env = {"TRANSLATE": "$(rootpath " + _TRANSLATE + ")"},
)

# Delta debugging over the units of a program that the footprint oracle finds a wrong footprint in.
