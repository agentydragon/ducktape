load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@rules_lean//lean:defs.bzl", "lean_binary", "lean_library")

_SOURCE = "//devinfra/js/debundle/x/split_proof:EsmSplit/Translate.lean"

_BASE = "//devinfra/js/debundle/x/split_proof:EsmSplit/TranslateMain.lean"

# The checker with every statement's computed write footprint erased. `ast_write_mutation_test` runs the generated
# AST corpus against it and against the real checker. The genrule fails if the edited line is not present exactly once.
genrule(
    name = "mutated_translate",
    srcs = [_SOURCE],
    outs = ["EsmSplit/Translate.lean"],
    cmd = "test \"$$(grep -F -c 'writes := f.writes,' $(location " + _SOURCE + "))\" -eq 1 && " +
          "sed 's/writes := f.writes,/writes := [],/' $(location " + _SOURCE + ") > $@",
)

# Both inputs must belong to this Bazel package so their relative names match
# the Lean modules the entry imports, including the intentionally replaced one.
copy_file(
    name = "translate_entry",
    src = _BASE,
    out = "EsmSplit/TranslateMain.lean",
)

lean_library(
    name = "translate_modules",
    srcs = [
        # Keep import order for the native Lean rule.
        ":mutated_translate",
        ":translate_entry",
    ],
    visibility = ["//visibility:private"],
    deps = [
        "//devinfra/js/debundle/x/split_proof:cli",
        "//devinfra/js/debundle/x/split_proof:correct",
        "//devinfra/js/debundle/x/split_proof:effects",
        "//devinfra/js/debundle/x/split_proof:translate_input",
    ],
)

lean_binary(
    name = "translate",
    visibility = ["//devinfra/js/debundle/x/split_proof/translation:__pkg__"],
    deps = [":translate_modules"],
)
