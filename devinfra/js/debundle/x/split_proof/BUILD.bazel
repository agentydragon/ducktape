# Keep the experimental scripts out of their parent package's globs and Gazelle.
# gazelle:exclude experiments
# gazelle:exclude fuzz

load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library", "js_run_binary", "js_test")

exports_files(
    [
        "example/input/bundle.mjs",
        "proof_fixture/bundle.mjs",
        "example/spec.json",
        "example/variants/cycle.json",
        "example/controls/claimed_twice.json",
        "example/controls/cycle_tdz.json",
        "example/controls/effect_order.json",
    ],
    visibility = ["//devinfra/js/debundle/x/split_proof/lean:__pkg__"],
)

js_library(
    name = "lowering_dump_core",
    srcs = ["experiments/lowering/dump_core.mjs"],
    visibility = ["//devinfra/js/debundle/x/split_proof/experiments/translation:__pkg__"],
)

js_binary(
    name = "extract",
    data = ["//:node_modules/acorn"],
    entry_point = "extract/extract.mjs",
    visibility = ["//devinfra/js/debundle/x/split_proof/lean:__pkg__"],
)

js_run_binary(
    name = "generated_instance",
    srcs = [
        "example/controls/claimed_twice.json",
        "example/controls/cycle_tdz.json",
        "example/controls/effect_order.json",
        "example/input/bundle.mjs",
        "example/spec.json",
        "example/variants/cycle.json",
    ],
    args = [
        "example/input/bundle.mjs",
        "example/spec.json",
        "--variant",
        "example/variants/cycle.json",
        "--control",
        "example/controls/claimed_twice.json",
        "--control",
        "example/controls/cycle_tdz.json",
        "--control",
        "example/controls/effect_order.json",
    ],
    chdir = package_name(),
    stdout = "generated/Instance.lean",
    tool = ":extract",
    visibility = ["//devinfra/js/debundle/x/split_proof/lean/generated:__pkg__"],
)

js_test(
    name = "extract_callback_test",
    data = [
        "extract/extract.mjs",
        "//:node_modules/acorn",
        "//devinfra/js/debundle/x/split_proof/experiments/translation:fixtures/callback/bundle.js",
    ],
    entry_point = "extract/callback_test.mjs",
    env = {"BUNDLE": "$(rootpath //devinfra/js/debundle/x/split_proof/experiments/translation:fixtures/callback/bundle.js)"},
    no_copy_to_bin = ["//devinfra/js/debundle/x/split_proof/experiments/translation:fixtures/callback/bundle.js"],
)

js_run_binary(
    name = "proof_fixture_instance",
    srcs = [
        "proof_fixture/bad.json",
        "proof_fixture/bundle.mjs",
        "proof_fixture/spec.json",
    ],
    args = [
        "proof_fixture/bundle.mjs",
        "proof_fixture/spec.json",
        "--control",
        "proof_fixture/bad.json",
    ],
    chdir = package_name(),
    stdout = "generated/ProofFixture.lean",
    tool = ":extract",
    visibility = ["//devinfra/js/debundle/x/split_proof/lean/generated:__pkg__"],
)

js_run_binary(
    name = "identity_fixture_instance",
    srcs = [
        "identity_fixture/bundle.mjs",
        "identity_fixture/crossing.json",
        "identity_fixture/spec.json",
    ],
    args = [
        "identity_fixture/bundle.mjs",
        "identity_fixture/spec.json",
        "--control",
        "identity_fixture/crossing.json",
    ],
    chdir = package_name(),
    stdout = "generated/IdentityFixture.lean",
    tool = ":extract",
    visibility = ["//devinfra/js/debundle/x/split_proof/lean/generated:__pkg__"],
)

js_run_binary(
    name = "identity_frontend_instance",
    srcs = ["identity_fixture/bundle.mjs"],
    args = ["identity_fixture/bundle.mjs"],
    chdir = package_name(),
    stdout = "generated/IdentityAnnotated.lean",
    tool = "//devinfra/js/debundle/x/split_proof/experiments/translation:frontend_lean",
    visibility = ["//devinfra/js/debundle/x/split_proof/lean/generated:__pkg__"],
)
