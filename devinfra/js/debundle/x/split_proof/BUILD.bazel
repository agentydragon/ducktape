# gazelle:exclude experiments

load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@npm_split_proof//:defs.bzl", "npm_link_all_packages")
load("//devinfra/lint:linters.bzl", "eslint_test")

npm_link_all_packages(name = "node_modules")

js_library(
    name = "seeded_random",
    srcs = ["seeded_random.mjs"],
    visibility = ["//devinfra/js/debundle/x/split_proof:__subpackages__"],
)

js_library(
    name = "reporting",
    srcs = ["reporting.mjs"],
    visibility = [
        "//devinfra/js/debundle/x/split_proof/debundle_cases:__pkg__",
        "//devinfra/js/debundle/x/split_proof/integration/library_splits:__pkg__",
    ],
)

eslint_test(
    name = "eslint_test",
    srcs = [
        ":reporting",
        ":seeded_random",
        "//devinfra/js/debundle/x/split_proof/lowering:lint_sources",
    ],
)
