# Keep sibling tools, experiments and fuzz fixtures out of the parent package and Gazelle.
# gazelle:exclude debundle_cases
# gazelle:exclude experiments
# gazelle:exclude fuzz
# gazelle:exclude lowering

load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library", "js_run_binary", "js_test")
load("//devinfra/lint:linters.bzl", "eslint_test")
load("//devinfra/python:defs.bzl", "py_binary")
load(":experiments/splits/sweep.bzl", "real_split_sweeps")

exports_files(
    [
        "example/input/bundle.mjs",
        "proof_fixture/bundle.mjs",
        "example/spec.json",
        "example/variants/cycle.json",
        "example/controls/claimed_twice.json",
        "example/controls/cycle_tdz.json",
        "example/controls/effect_order.json",
    ],
    visibility = [
        "//devinfra/js/debundle/x/split_proof/lean:__pkg__",
        "//devinfra/js/debundle/x/split_proof/lean/generated:__pkg__",
        "//devinfra/js/debundle/x/split_proof/translation:__pkg__",
    ],
)

js_library(
    name = "lowering_dump_core",
    srcs = [
        "lowering/dump_core.mjs",
    ],
    visibility = ["//devinfra/js/debundle/x/split_proof/translation:__pkg__"],
    deps = ["//devinfra/js/debundle/x/split_proof/translation:scope_metadata"],
)

js_binary(
    name = "extract",
    data = ["//:node_modules/acorn"],
    entry_point = "extract/extract.mjs",
    visibility = ["//devinfra/js/debundle/x/split_proof/lean:__pkg__"],
)

js_run_binary(
    name = "generated_instance",
    srcs = [
        "example/controls/claimed_twice.json",
        "example/controls/cycle_tdz.json",
        "example/controls/effect_order.json",
        "example/input/bundle.mjs",
        "example/spec.json",
        "example/variants/cycle.json",
    ],
    args = [
        "example/input/bundle.mjs",
        "example/spec.json",
        "--variant",
        "example/variants/cycle.json",
        "--control",
        "example/controls/claimed_twice.json",
        "--control",
        "example/controls/cycle_tdz.json",
        "--control",
        "example/controls/effect_order.json",
    ],
    chdir = package_name(),
    stdout = "generated/Instance.lean",
    tool = ":extract",
    visibility = ["//devinfra/js/debundle/x/split_proof/lean/generated:__pkg__"],
)

js_test(
    name = "extract_callback_test",
    data = [
        "extract/extract.mjs",
        "//:node_modules/acorn",
        "//devinfra/js/debundle/x/split_proof/translation:fixtures/callback/bundle.js",
    ],
    entry_point = "extract/callback_test.mjs",
    env = {"BUNDLE": "$(rootpath //devinfra/js/debundle/x/split_proof/translation:fixtures/callback/bundle.js)"},
    no_copy_to_bin = ["//devinfra/js/debundle/x/split_proof/translation:fixtures/callback/bundle.js"],
)

js_run_binary(
    name = "proof_fixture_instance",
    srcs = [
        "proof_fixture/bad.json",
        "proof_fixture/bundle.mjs",
        "proof_fixture/spec.json",
    ],
    args = [
        "proof_fixture/bundle.mjs",
        "proof_fixture/spec.json",
        "--control",
        "proof_fixture/bad.json",
    ],
    chdir = package_name(),
    stdout = "generated/ProofFixture.lean",
    tool = ":extract",
    visibility = ["//devinfra/js/debundle/x/split_proof/lean/generated:__pkg__"],
)

# Include first-party runfile helpers as lint sources.
js_library(
    name = "lint_sources",
    testonly = True,
    srcs = glob(
        [
            "extract/*.mjs",
            "experiments/**/*.mjs",
        ],
        exclude = [
            "experiments/lowering/entries/**",
            "experiments/lowering/torture.mjs",
        ],
    ),
)

eslint_test(
    name = "eslint_test",
    srcs = [":lint_sources"],
)

# keep
py_binary(
    name = "render_fuzz",
    srcs = [
        "fuzz/bazel_main.py",
        "fuzz/fuzz.py",
    ],
    data = [
        "example/input/bundle.mjs",
        "example/spec.json",
        "//devinfra/js/debundle/x/split_proof/lean:render",
        "@nodejs_linux_amd64//:bin/node",
    ],
    env = {
        "NODE_RUNFILE": "$(rlocationpath @nodejs_linux_amd64//:bin/node)",
        "RENDER_RUNFILE": "$(rlocationpath //devinfra/js/debundle/x/split_proof/lean:render)",
    },
    main = "fuzz/bazel_main.py",
    tags = ["manual"],
    deps = ["@rules_python//python/runfiles"],
)

js_binary(
    name = "debundle_cases",
    testonly = True,
    data = [
        ":lowering_dump_core",
        "//:node_modules/acorn",
        "//:node_modules/yaml",
        "//devinfra/js/debundle/e2e:corpus_files",
        "//devinfra/js/debundle/x/split_proof/lean:lowersplit",
        "//devinfra/js/debundle/x/split_proof/translation:bazel_parser",
    ],
    entry_point = "debundle_cases/run_cases.mjs",
    env = {"LOWERSPLIT": "$(rootpath //devinfra/js/debundle/x/split_proof/lean:lowersplit)"},
    tags = ["manual"],
)

js_binary(
    name = "summarize_debundle_cases",
    entry_point = "debundle_cases/summarize.mjs",
    tags = ["manual"],
)

js_run_binary(
    name = "example_ast",
    srcs = ["example/input/bundle.mjs"],
    args = ["example/input/bundle.mjs"],
    chdir = package_name(),
    stdout = "generated/example.json",
    tool = "//devinfra/js/debundle/x/split_proof/translation:dump_ast",
    visibility = ["//devinfra/js/debundle/x/split_proof/lean/generated:__pkg__"],
)

js_library(
    name = "real_bundle_entries",
    srcs = glob(["lowering/entries/*.mjs"]),
    visibility = ["//devinfra/js/debundle/x/split_proof/translation:__pkg__"],
)

js_binary(
    name = "compare_footprints",
    data = [
        "extract/extract.mjs",
        "//:node_modules/acorn",
        "//devinfra/js/debundle/x/split_proof/lean:lower",
        "//devinfra/js/debundle/x/split_proof/translation:bazel_parser",
        "//devinfra/js/debundle/x/split_proof/translation:scope_metadata",
    ],
    entry_point = "lowering/compare.mjs",
    env = {"LOWER": "$(rootpath //devinfra/js/debundle/x/split_proof/lean:lower)"},
    tags = ["manual"],
)

js_binary(
    name = "real_split",
    data = [
        "experiments/splits/gen_spec.mjs",
        "experiments/splits/smoke.mjs",
        "//devinfra/js/debundle/x/split_proof/lean:lower",
        "//devinfra/js/debundle/x/split_proof/lean:lowersplit",
        "//devinfra/js/debundle/x/split_proof/translation:scope_metadata",
    ],
    entry_point = "experiments/splits/run_splits.mjs",
    env = {
        "LOWER": "$(rootpath //devinfra/js/debundle/x/split_proof/lean:lower)",
        "LOWERSPLIT": "$(rootpath //devinfra/js/debundle/x/split_proof/lean:lowersplit)",
    },
    tags = ["manual"],
)

js_binary(
    name = "summarize_real_splits",
    entry_point = "experiments/splits/summarize.mjs",
    tags = ["manual"],
)

real_split_sweeps()
