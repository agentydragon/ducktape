load("@rules_lean//lean:lean.bzl", "lean_library")
load("//devinfra/js/debundle/x/split_proof/lean:module_sources.bzl", "lean_module_sources")

_LEAN = "//devinfra/js/debundle/x/split_proof/lean"

lean_module_sources(
    name = "sources",
    srcs = [
        "Certified.lean",
        "Diagnostic.lean",
        "Input.lean",
    ],
    module_prefix = "EsmSplit/LowerSplit",
)

lean_library(
    name = "workflows",
    srcs = [":sources"],
    visibility = [_LEAN + ":__pkg__"],
    deps = [
        _LEAN + ":corejs_certificates",
        _LEAN + ":corejs_runtime",
        _LEAN + ":corejs_structural",
        _LEAN + ":lowersplit_support",
    ],
)
