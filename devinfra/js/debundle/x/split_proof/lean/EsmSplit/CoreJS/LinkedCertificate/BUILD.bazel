load("@rules_lean//lean:lean.bzl", "lean_library")
load("//devinfra/js/debundle/x/split_proof/lean:module_sources.bzl", "lean_module_sources")

_LEAN = "//devinfra/js/debundle/x/split_proof/lean"

_MODULE_PREFIX = "EsmSplit/CoreJS/LinkedCertificate"

lean_module_sources(
    name = "proof_sources",
    srcs = ["Proof.lean"],
    module_prefix = _MODULE_PREFIX,
)

# Generated certificates import the proof layer on its own.
lean_library(
    name = "proof",
    srcs = [":proof_sources"],
    deps = [
        _LEAN + ":corejs_certificate_support",
        _LEAN + ":corejs_linked_input",
    ],
)

lean_module_sources(
    name = "generator_sources",
    srcs = [
        "Probe.lean",
        "QuoteCoreJS.lean",
        "QuoteJson.lean",
        "QuoteRecords.lean",
        "QuoteWrites.lean",
    ],
    module_prefix = _MODULE_PREFIX,
)

lean_library(
    name = "generation_support",
    srcs = [":generator_sources"],
    visibility = [_LEAN + ":__pkg__"],
    deps = [":proof"],
)
