import EsmSplit.Cli

namespace EsmSplit.InstanceSource

open Lean

private def q (s : String) : String := (Json.str s).compress
private def qs (xs : List String) : String := "[" ++ ", ".intercalate (xs.map q) ++ "]"

private def stmtLean (s : Stmt) : String :=
  let fields := [s!"src := {q s.src}"]
    ++ (if s.defs.isEmpty then [] else [s!"defs := {qs s.defs}"])
    ++ (if s.writes.isEmpty then [] else [s!"writes := {qs s.writes}"])
    ++ (if s.assigns.isEmpty then [] else [s!"assigns := {qs s.assigns}"])
    ++ (if s.deps.isEmpty then [] else [s!"deps := {qs s.deps}"])
    ++ (if s.eager.isEmpty then [] else [s!"eager := {qs s.eager}"])
    ++ (if s.lazy.isEmpty then [] else [s!"lazy := {qs s.lazy}"])
    ++ (if s.exports.isEmpty then [] else
          [s!"exports := [{", ".intercalate (s.exports.map fun (p, l) => s!"({q p}, {match l with | some l => s!"some {q l}" | none => "none"})")}]"])
    ++ (if s.hoisted then ["hoisted := true"] else [])
    ++ (if s.effect then ["effect := true"] else [])
  "  { " ++ ", ".intercalate fields ++ " }"

private def selLean : Selector → String
  | .name u => s!".name {q u}"
  | .stmt i => s!".stmt {i}"

private def specLean (name : String) (S : Spec) : String :=
  let mods := ",\n".intercalate (S.modules.map fun (m, sels) =>
    s!"    ({q m}, [{", ".intercalate (sels.map selLean)}])")
  s!"def {name} : Spec := \{
  entry := {q S.entry}
  modules := [
{mods}
  ]{if S.order.isEmpty then "" else s!"\n  order := {qs S.order}"}{if S.sequential then "\n  sequential := true" else ""}
}"

structure Options where
  namespaceName : String := "Generated"
  variants : List (String × Spec) := []
  controls : List (String × Spec × String) := []

private def identifier (name : String) : Bool :=
  match name.toList with
  | [] => false
  | first :: rest => (first.isAlpha || first == '_') && rest.all (fun c => c.isAlphanum || c == '_')

private def readCase (path : System.FilePath) : IO (String × Spec × Json) := do
  let some name := path.fileStem | throw (IO.userError s!"missing spec filename: {path}")
  unless identifier name do throw (IO.userError s!"invalid case name {name}")
  let json ← IO.ofExcept (Json.parse (← IO.FS.readFile path))
  return (name, ← IO.ofExcept (parseSpec json), json)

def parseOptions (options : Options) : List String → IO Options
  | [] => pure options
  | "--namespace" :: name :: rest => do
    unless identifier name do throw (IO.userError s!"invalid Lean namespace {name}")
    parseOptions { options with namespaceName := name } rest
  | "--variant" :: path :: rest => do
    let (name, spec, _) ← readCase path
    parseOptions { options with variants := options.variants ++ [(name, spec)] } rest
  | "--control" :: path :: rest => do
    let (name, spec, json) ← readCase path
    let check ← IO.ofExcept (json.getObjValAs? String "fails")
    unless ["Faithful", "Linkable", "Hygienic", "Permutes", "OrderOk"].contains check do
      throw (IO.userError s!"control {name}: unknown check {check}")
    parseOptions { options with controls := options.controls ++ [(name, spec, check)] } rest
  | arg :: _ => throw (IO.userError s!"invalid instance-generator option {arg}")

private def casesLean (options : Options) : String :=
  let caseList := fun (kind : String) (entries : List String) =>
    ", ".intercalate (entries.map fun name => s!"({q name}, {kind}_{name})")
  let variants := options.variants.map fun (name, spec) =>
    let id := s!"variant_{name}"
    s!"{specLean id spec}\n\ntheorem {id}_valid : Valid bundle {id} (mkPlan bundle {id}) := by decide +kernel"
  let controls := options.controls.map fun (name, spec, check) =>
    let id := s!"control_{name}"
    let args := if check == "Faithful" then s!"bundle {id}" else "bundle"
    s!"{specLean id spec}\n\ntheorem {id}_rejected : ¬ {check} {args} (mkPlan bundle {id}) := by decide +kernel"
  if variants.isEmpty && controls.isEmpty then "" else
    "\n" ++ "\n\n".intercalate (variants ++ [
      s!"def specVariants : List (String × Spec) := [{caseList "variant" (options.variants.map Prod.fst)}]"
    ] ++ controls ++ [
      s!"def specControls : List (String × Spec) := [{caseList "control" (options.controls.map Prod.fst)}]"
    ]) ++ "\n"

def render (B : Bundle) (S : Spec) (options : Options) : String :=
  s!"-- GENERATED by `split_instance_generator` from acorn's ESTree. Footprints were computed in Lean.
-- The kernel checks this supplied bundle and plan, not the source-to-footprint analysis.
import EsmSplit.Split
import EsmSplit.Correct
open EsmSplit

namespace {options.namespaceName}

def bundle : Bundle := [
{",\n".intercalate (B.map stmtLean)}
]

{specLean "spec" S}

def plan : Plan := mkPlan bundle spec

theorem plan_valid : Valid bundle spec plan := by decide +kernel

theorem plan_correct : Correct bundle plan := split_correct plan_valid

#print axioms plan_correct
{casesLean options}
end {options.namespaceName}
"

end EsmSplit.InstanceSource
