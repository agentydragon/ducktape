# The checker's Lean sources, less the entry and the module that converts footprints to
# statements, so the `no_writes` mutation test can swap in a changed `Translate.lean`.
_TRANSLATE_BASE = [
    "EsmSplit/Bundle.lean",
    "EsmSplit/Cli.lean",
    "EsmSplit/Correct.lean",
    "EsmSplit/Fast.lean",
    "EsmSplit/Plan.lean",
    "EsmSplit/ModulePath.lean",
    "EsmSplit/Semantics.lean",
    "EsmSplit/Split.lean",
    "EsmSplit/Effects.lean",
    "EsmSplit/IntrinsicMembers.lean",
    "EsmSplit/Intrinsics.lean",
    "EsmSplit/Lower.lean",
    "EsmSplit/TranslateInput.lean",
    "EsmSplit/TranslateMain.lean",
] + _ESTREE_SOURCES

lean_binary(
    name = "translate",
    srcs = _TRANSLATE_BASE + ["EsmSplit/Translate.lean"],
    # `lean_binary` runs the entry with `lean --run` on each call: it elaborates the entry and interprets the checker,
    # about ten times slower than the native build of `lake build`. The tests that call it are `medium` or larger.
    entry = "EsmSplit/TranslateMain.lean",
    visibility = ["//devinfra/js/debundle/x/split_proof/translation:__pkg__"],
)

lean_binary(
    name = "lower",
    srcs = [
        "EsmSplit/Effects.lean",
        "EsmSplit/IntrinsicMembers.lean",
        "EsmSplit/Intrinsics.lean",
        "EsmSplit/Lower.lean",
        "EsmSplit/LowerMain.lean",
        "EsmSplit/TranslateInput.lean",
    ] + _ESTREE_SOURCES,
    entry = "EsmSplit/LowerMain.lean",
    visibility = [
        "//devinfra/js/debundle/x/split_proof:__pkg__",
        "//devinfra/js/debundle/x/split_proof/translation:__pkg__",
    ],
)

# Source groups used only to compile the deliberately unsound `no_writes` checker.
filegroup(
    name = "translate_mutation_base_sources",
    srcs = _TRANSLATE_BASE,
    visibility = ["//devinfra/js/debundle/x/split_proof/lean/mutants:__subpackages__"],
)

filegroup(
    name = "translate_mutation_source",
    srcs = ["EsmSplit/Translate.lean"],
    visibility = ["//devinfra/js/debundle/x/split_proof/lean/mutants:__subpackages__"],
)

# The interpreter and the Acorn helper are both runfiles when another tool invokes lowersplit.
genrule(
    name = "lowersplit_launcher",
    srcs = [
        ":lowersplit_core",
        "//devinfra/js/debundle/x/split_proof/translation:module_io",
    ],
    outs = ["lowersplit_launcher.sh"],
    cmd = """cat > $@ <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
export SPLIT_PROOF_MODULE_IO="$$(rlocation '$(rlocationpath //devinfra/js/debundle/x/split_proof/translation:module_io)')"
exec "$$(rlocation '$(rlocationpath :lowersplit_core)')" "$$@"
EOF
chmod +x $@
""",
)

sh_binary(
    name = "lowersplit",
    srcs = [":lowersplit_launcher"],
    data = [
        ":lowersplit_core",
        "//devinfra/js/debundle/x/split_proof/translation:module_io",
    ],
    use_bash_launcher = True,
    visibility = [
        "//devinfra/js/debundle/x/split_proof:__pkg__",
        "//devinfra/js/debundle/x/split_proof/lean/generated:__pkg__",
        "//devinfra/js/debundle/x/split_proof/translation:__pkg__",
    ],
)

