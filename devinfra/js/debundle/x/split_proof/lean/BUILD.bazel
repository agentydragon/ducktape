    ],
    entry = "Experiments/LowerSplit.lean",
    visibility = ["//devinfra/js/debundle/x/split_proof/experiments/translation:__pkg__"],
)

# The order in which the modules of a plan run. `experiments/model/differential.mjs` compares the CoreJS model's with it.
lean_binary(
    name = "evalorder",
    srcs = [
        "EsmSplit/Bundle.lean",
        "EsmSplit/Plan.lean",
        "Experiments/EvalOrder.lean",
    ],
    entry = "Experiments/EvalOrder.lean",
    visibility = ["//devinfra/js/debundle/x/split_proof/experiments/translation:__pkg__"],
)

# The CoreJS model. `experiments/model/differential.mjs` runs it against Node.
