load("@rules_lean//lean:lean.bzl", "lean_axiom_test", "lean_binary")

lean_axiom_test(
    name = "axioms_test",
    srcs = ["EsmSplit.lean"] + glob(
        ["EsmSplit/*.lean"],
        exclude = ["EsmSplit/Audit.lean"],
    ),
    imports = ["EsmSplit"],
    theorems = [
        "EsmSplit.Bundle.exec_reorder",
        "EsmSplit.split_correct",
        "Example.plan_valid",
        "Example.plan_correct",
        "Example.control_effect_order_rejected",
        "Example.control_cycle_tdz_rejected",
        "Example.control_claimed_twice_rejected",
        "Example.missing_import_rejected",
        "Example.dropped_module_rejected",
        "Example.variant_cycle_valid",
        "Example.good_observes_same",
        "Example.cycle_variant_observes_same",
        "Example.effect_order_observes_differently",
        "Example.cycle_tdz_observes_differently",
    ],
)

lean_binary(
    name = "translate",
    srcs = [
        "EsmSplit/Bundle.lean",
        "EsmSplit/Cli.lean",
        "EsmSplit/Correct.lean",
        "EsmSplit/Fast.lean",
        "EsmSplit/Plan.lean",
        "EsmSplit/Render.lean",
        "EsmSplit/Semantics.lean",
        "EsmSplit/Split.lean",
        "Experiments/CheckOutput.lean",
        "Experiments/Lower.lean",
        "Experiments/Translate.lean",
        "Experiments/TranslateMain.lean",
    ],
    # lean_binary elaborates the entry on each call. Import the compiled checker.
    entry = "Experiments/TranslateMain.lean",
    visibility = ["//devinfra/js/debundle/x/split_proof/experiments/translation:__pkg__"],
)
