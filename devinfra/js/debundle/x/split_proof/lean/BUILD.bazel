load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@rules_lean//lean:lean.bzl", "lean_axiom_test", "lean_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

_EXAMPLE = "//devinfra/js/debundle/x/split_proof:example/"

_PROOF_SOURCES = [
    "EsmSplit.lean",
    "//devinfra/js/debundle/x/split_proof/lean/generated:generate_instance",
] + glob(
    ["EsmSplit/*.lean"],
    exclude = [
        "EsmSplit/Audit.lean",
        "EsmSplit/Instance.lean",
    ],
)

lean_axiom_test(
    name = "axioms_test",
    srcs = _PROOF_SOURCES,
    imports = ["EsmSplit"],
    theorems = [
        "EsmSplit.Bundle.exec_reorder",
        "EsmSplit.split_correct",
        "EsmSplit.sound_correct",
        "Example.plan_valid",
        "Example.plan_correct",
        "Example.control_effect_order_rejected",
        "Example.control_cycle_tdz_rejected",
        "Example.control_claimed_twice_rejected",
        "Example.missing_import_rejected",
        "Example.dropped_module_rejected",
        "Example.variant_cycle_valid",
        "Example.good_observes_same",
        "Example.cycle_variant_observes_same",
        "Example.effect_order_observes_differently",
        "Example.cycle_tdz_observes_differently",
    ],
)

lean_binary(
    name = "render",
    srcs = ["Main.lean"] + _PROOF_SOURCES,
    entry = "Main.lean",
)

sh_test(
    name = "example_test",
    srcs = ["example_test.sh"],
    args = [
        "$(rlocationpath :render)",
        "$(rlocationpath @nodejs_linux_amd64//:bin/node)",
        "$(rlocationpath " + _EXAMPLE + "input/bundle.mjs)",
    ],
    data = [
        ":render",
        _EXAMPLE + "input/bundle.mjs",
        "@nodejs_linux_amd64//:bin/node",
    ],
    use_bash_launcher = True,
)

diff_test(
    name = "instance_freshness_test",
    file1 = "EsmSplit/Instance.lean",
    file2 = "//devinfra/js/debundle/x/split_proof/lean/generated:generate_instance",
)

lean_binary(
    name = "translate",
    srcs = [
        "EsmSplit/Bundle.lean",
        "EsmSplit/Cli.lean",
        "EsmSplit/Correct.lean",
        "EsmSplit/Fast.lean",
        "EsmSplit/Plan.lean",
        "EsmSplit/Render.lean",
        "EsmSplit/Semantics.lean",
        "EsmSplit/Split.lean",
        "Experiments/Lower.lean",
        "Experiments/Translate.lean",
        "Experiments/TranslateMain.lean",
    ],
    # lean_binary elaborates the entry on each call. Import the compiled checker.
    entry = "Experiments/TranslateMain.lean",
    visibility = ["//devinfra/js/debundle/x/split_proof/experiments/translation:__pkg__"],
)

_PROOF_FIXTURE_SOURCES = [
    "EsmSplit/Bundle.lean",
    "EsmSplit/Cli.lean",
    "EsmSplit/Correct.lean",
    "EsmSplit/Fast.lean",
    "EsmSplit/Plan.lean",
    "EsmSplit/Render.lean",
    "EsmSplit/Semantics.lean",
    "EsmSplit/Split.lean",
    "Experiments/MiniJS.lean",
    "Experiments/MiniJSSource.lean",
    "Experiments/ProofFixture.lean",
    "//devinfra/js/debundle/x/split_proof/lean/generated:generate_proof_fixture",
]

lean_axiom_test(
    name = "local_call_axioms_test",
    srcs = [
        "EsmSplit/Bundle.lean",
        "EsmSplit/Semantics.lean",
        "Experiments/LocalCall.lean",
        "Experiments/MiniJS.lean",
    ],
    imports = ["Experiments.LocalCall"],
    theorems = [
        "MJS.inert_subst_num",
        "MJS.local_call_world",
        "MJS.local_call_inert_sound",
        "MJS.local_call_reads",
        "MJS.effectful_body_rejected",
        "MJS.effectful_argument_rejected",
        "MJS.effectful_call_changes_world",
        "MJS.inert_identity_accepted",
        "MJS.changed_binding_rejected",
    ],
)

lean_axiom_test(
    name = "property_read_axioms_test",
    srcs = [
        "EsmSplit/Bundle.lean",
        "EsmSplit/Semantics.lean",
        "Experiments/LocalCall.lean",
        "Experiments/MiniJS.lean",
        "Experiments/PropertyRead.lean",
    ],
    imports = ["Experiments.PropertyRead"],
    theorems = [
        "PropertyRead.read_no_accessor_preserves_trace",
        "PropertyRead.own_data_read_ignores_prototype",
        "PropertyRead.own_data_write_preserves_trace",
        "PropertyRead.initialize_preserves_trace",
        "PropertyRead.local_call_then_initialize_preserves_trace",
        "PropertyRead.own_data_positive",
        "PropertyRead.missing_argument_invokes_getter",
        "PropertyRead.fresh_receiver_invokes_setter",
        "PropertyRead.inherited_getter_rejected",
        "PropertyRead.inherited_setter_rejected",
        "PropertyRead.missing_read_depends_on_prototype",
        "PropertyRead.prototype_mutation_invalidates_guard",
    ],
)

lean_axiom_test(
    name = "proof_fixture_axioms_test",
    srcs = _PROOF_FIXTURE_SOURCES,
    imports = ["Experiments.ProofFixture"],
    theorems = [
        "Example.plan_valid",
        "Example.control_bad_rejected",
        "ProofFixture.extracted_footprints",
        "ProofFixture.source_accepted",
        "ProofFixture.program_value",
        "ProofFixture.unsupported_nonconst",
        "ProofFixture.unsupported_extra_tokens",
        "ProofFixture.unsupported_call",
        "ProofFixture.unsupported_coercion",
        "ProofFixture.unsupported_number",
        "ProofFixture.unsupported_escape",
        "ProofFixture.unsupported_keyword",
        "ProofFixture.unsupported_reserved_name",
        "ProofFixture.unsupported_strict_name",
        "ProofFixture.execution_order",
        "ProofFixture.preserves_model",
        "ProofFixture.rendered_base",
        "ProofFixture.rendered_entry",
    ],
)

lean_binary(
    name = "proof_fixture_render",
    srcs = ["ProofFixtureMain.lean"] + _PROOF_FIXTURE_SOURCES,
    entry = "ProofFixtureMain.lean",
)

sh_test(
    name = "proof_fixture_test",
    srcs = ["proof_fixture_test.sh"],
    args = [
        "$(rlocationpath :proof_fixture_render)",
        "$(rlocationpath @nodejs_linux_amd64//:bin/node)",
        "$(rlocationpath //devinfra/js/debundle/x/split_proof:proof_fixture/bundle.mjs)",
    ],
    data = [
        ":proof_fixture_render",
        "//devinfra/js/debundle/x/split_proof:proof_fixture/bundle.mjs",
        "@nodejs_linux_amd64//:bin/node",
    ],
    use_bash_launcher = True,
)
