load("@rules_lean//lean:defs.bzl", "lean_library")
load(":certificate.bzl", "lowered_certificate")

_ROOT = "//devinfra/js/debundle/x/split_proof:"

_EXAMPLE = _ROOT + "example/"

_PROOF_FIXTURE = _ROOT + "proof_fixture/"

_GENERATOR = "//devinfra/js/debundle/x/split_proof/lean:split_instance_generator"

_VISIBILITY = ["//devinfra/js/debundle/x/split_proof/lean:__pkg__"]

lowered_certificate(
    name = "generate_instance",
    out = "EsmSplit/Instance.lean",
    controls = [
        _EXAMPLE + "controls/claimed_twice.json",
        _EXAMPLE + "controls/cycle_tdz.json",
        _EXAMPLE + "controls/effect_order.json",
    ],
    entry = "main.mjs",
    generator = _GENERATOR,
    namespace = "Example",
    source = _EXAMPLE + "input/bundle.mjs",
    spec = _EXAMPLE + "spec.json",
    variants = [_EXAMPLE + "variants/cycle.json"],
    visibility = _VISIBILITY,
)

lowered_certificate(
    name = "generate_proof_fixture",
    out = "ProofFixture/Instance.lean",
    controls = [_PROOF_FIXTURE + "bad.json"],
    entry = "main.mjs",
    generator = _GENERATOR,
    namespace = "Example",
    source = _PROOF_FIXTURE + "bundle.mjs",
    spec = _PROOF_FIXTURE + "spec.json",
    visibility = _VISIBILITY,
)

lowered_certificate(
    name = "generate_lowered_example_certificate",
    out = "Experiments/Generated.lean",
    entry = "main.mjs",
    generator = _GENERATOR,
    source = _ROOT + "example_ast",
    spec = _EXAMPLE + "spec.json",
    visibility = _VISIBILITY,
)

lean_library(
    name = "instance_module",
    srcs = [":generate_instance"],
    visibility = _VISIBILITY,
    deps = ["//devinfra/js/debundle/x/split_proof/lean:planner"],
)

lean_library(
    name = "proof_fixture_module",
    srcs = [":generate_proof_fixture"],
    visibility = _VISIBILITY,
    deps = ["//devinfra/js/debundle/x/split_proof/lean:planner"],
)

lean_library(
    name = "lowered_example_module",
    srcs = [":generate_lowered_example_certificate"],
    visibility = _VISIBILITY,
    deps = ["//devinfra/js/debundle/x/split_proof/lean:planner"],
)
