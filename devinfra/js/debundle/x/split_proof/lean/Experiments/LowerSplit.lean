import EsmSplit.Cli
import Experiments.Lower
import Std.Data.HashSet

/-!
# AST + spec in; modules, verdict and a kernel certificate out. No JavaScript analysis outside Lean.

    lowersplit <bundle.json> <spec.json> <outdir> [--lean <Generated.lean>] [--replicate <K>] [--force]

`bundle.json` is acorn's ESTree (`experiments/lowering/dump.mjs`). Lean computes the footprints
(`Lower.lean`), plans the split, runs the checks, writes the modules, and with `--lean` writes a
Lean file whose `by decide +kernel` makes the kernel certify the same facts.
`--force` writes the modules even when a check rejects the split, to see what Node does with them.
`--replicate K` is for timing: K renamed copies of the bundle (the spec must cover K times as many statements).
-/

open Lean EsmSplit

def toStmt (src : String) (f : Lower.Footprint) : Stmt :=
  { src, defs := f.defs, eager := f.eager, lazy := f.lazy, hoisted := f.hoisted, effect := f.effect }

def q (s : String) : String := (Json.str s).compress
def qs (xs : List String) : String := "[" ++ ", ".intercalate (xs.map q) ++ "]"

def stmtLean (s : Stmt) : String :=
  let fields := [s!"src := {q s.src}"]
    ++ (if s.defs.isEmpty then [] else [s!"defs := {qs s.defs}"])
    ++ (if s.eager.isEmpty then [] else [s!"eager := {qs s.eager}"])
    ++ (if s.lazy.isEmpty then [] else [s!"lazy := {qs s.lazy}"])
    ++ (if s.hoisted then ["hoisted := true"] else [])
    ++ (if s.effect then ["effect := true"] else [])
  "  { " ++ ", ".intercalate fields ++ " }"

def selLean : Selector → String
  | .name u => s!".name {q u}"
  | .stmt i => s!".stmt {i}"

def instanceLean (B : Bundle) (S : Spec) : String :=
  let mods := ",\n".intercalate (S.modules.map fun (m, sels) =>
    s!"    ({q m}, [{", ".intercalate (sels.map selLean)}])")
  s!"-- GENERATED by `lowersplit` from acorn's ESTree. Footprints were computed in Lean.
import EsmSplit.Split
import EsmSplit.Correct
open EsmSplit

namespace Generated

def bundle : Bundle := [
{",\n".intercalate (B.map stmtLean)}
]

def spec : Spec := \{
  entry := {q S.entry}
  modules := [
{mods}
  ]
}

def plan : Plan := mkPlan bundle spec

theorem plan_valid : Valid bundle spec plan := by decide +kernel

theorem plan_correct : Correct bundle plan := split_correct plan_valid

#print axioms plan_correct

end Generated
"

/-- Timing only: `K` copies of the bundle, each declaring its own renamed copy of every declared name.
The statement text is not renamed, so the modules written from this are meaningless. -/
def replicateBundle (K : Nat) (B : Bundle) : Bundle :=
  let declared : Std.HashSet String := Std.HashSet.ofList (B.flatMap (·.defs))
  (List.range K).flatMap fun k =>
    let r (n : String) := if declared.contains n then s!"{n}${k}" else n
    B.map fun s => { s with defs := s.defs.map r, eager := s.eager.map r, lazy := s.lazy.map r }

def takeFlag (name : String) : List String → Option String × List String
  | a :: v :: rest =>
    if a == name then (some v, rest) else let (r, l) := takeFlag name (v :: rest); (r, a :: l)
  | l => (none, l)

/-- Statement types the model does not cover. -/
def unsupported (t : String) : Bool := t == "ImportDeclaration" || t == "ExportAllDeclaration"

def main (args : List String) : IO UInt32 := do
  let (replicate?, args) := takeFlag "--replicate" args
  let force := args.contains "--force"
  let args := args.filter (· != "--force")
  let (bundlePath, specPath, out, leanOut?) ← match args with
    | [b, s, o] => pure (b, s, o, none)
    | [b, s, o, "--lean", l] => pure (b, s, o, some l)
    | _ => do IO.eprintln "usage: lowersplit <bundle.json> <spec.json> <outdir> [--lean <file>]"; throw (IO.userError "usage")
  let tStart ← IO.monoMsNow
  let lap (what : String) (t0 : Nat) : IO Nat := do
    let t ← IO.monoMsNow
    IO.println s!"  [time] {what}: {t - t0} ms"; (← IO.getStdout).flush; return t
  let j ← IO.ofExcept (Json.parse (← IO.FS.readFile bundlePath))
  let t1 ← lap "read + parse JSON" tStart
  let stmts := Lower.items (Lower.fld j "statements")
  for s in stmts do
    let t := Lower.typ (Lower.fld s "ast")
    if unsupported t then
      IO.eprintln s!"unsupported top-level statement: {t}"; return 3
  let fps ← IO.lazyPure fun _ => Lower.finalize (stmts.map fun s => Lower.analyzeTop (Lower.fld s "ast"))
  let t2 ← lap "footprints (Lean analysis)" t1
  let B0 : Bundle := (stmts.zip fps).toList.map fun (s, f) => toStmt (Lower.str (Lower.fld s "src")) f
  let B := match replicate?.bind String.toNat? with
    | some K => replicateBundle K B0
    | none => B0
  let S ← loadSpec specPath
  let t3 ← lap "load spec" t2
  IO.println s!"{B.length} statements; footprints computed in Lean; {(fps.filter (·.effect)).size} effects; {(fps.filter (·.fallback ≠ [])).size} with fallback nodes"
  -- Two rules Lean does not check. They talk about the original statements, so `--replicate` skips them.
  let mut bad := false
  if replicate?.isNone then
    -- ES imports are read-only: a statement may only assign to names its own module declares.
    for (f, i) in fps.toList.zipIdx do
      for n in f.assigned do
        match B.ownerOf n with
        | some k => if S.moduleOf B k != S.moduleOf B i then
            IO.println s!"  FAIL  statement {i} assigns `{n}`, declared by statement {k} in another module"; bad := true
        | none => pure ()
    -- An `export` is the entry module's interface: it must stay in the entry module.
    for (st, i) in stmts.toList.zipIdx do
      let t := Lower.typ (Lower.fld st "ast")
      if (t == "ExportNamedDeclaration" || t == "ExportDefaultDeclaration") && S.moduleOf B i != some S.entry then
        IO.println s!"  FAIL  statement {i} is an `{t}` outside the entry module"; bad := true
  let P ← IO.lazyPure fun _ => mkPlan B S
  let _ ← IO.lazyPure fun _ => P.mods.length + (P.mods.map (·.imports.length)).sum
  let t4 ← lap "mkPlan" t3
  let ok ← report B S P
  let t5 ← lap "all seven checks" t4
  if let some l := leanOut? then
    if bad then
      IO.println "  no kernel certificate: a front-end rule above failed, and Lean does not check those"
    else
      IO.FS.writeFile l (instanceLean B S)
      IO.println s!"  wrote kernel certificate source to {l}"
  if force || (ok && !bad) then
    writeModules B P out
    let _ ← lap "render + write" t5
    IO.println s!"  [time] total: {(← IO.monoMsNow) - tStart} ms"
  if ok && !bad then return 0
  IO.eprintln (if force then "rejected; written anyway (--force)" else "rejected; nothing written"); return 1
