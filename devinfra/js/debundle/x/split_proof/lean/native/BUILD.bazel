load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//devinfra/python:defs.bzl", "py_binary", "py_library")

py_binary(
    name = "compile_driver",
    srcs = ["compile.py"],
    main = "compile.py",
    visibility = ["//devinfra/js/debundle/x/split_proof:__subpackages__"],
)

sh_test(
    name = "sorry_test",
    srcs = ["sorry_test.sh"],
    args = [
        "$(rlocationpath :compile_driver)",
        "$(rlocationpath @lean_dist//:lean_bin)",
