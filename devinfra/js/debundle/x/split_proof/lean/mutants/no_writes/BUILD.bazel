load("@rules_lean//lean:lean.bzl", "lean_binary")

_SOURCE = "//devinfra/js/debundle/x/split_proof/lean:translate_mutation_source"

_BASE = "//devinfra/js/debundle/x/split_proof/lean:translate_mutation_base_sources"

# The checker with every statement's computed write footprint erased. `ast_write_mutation_test` runs the generated
# AST corpus against it and against the real checker. The genrule fails if the edited line is not present exactly once.
genrule(
    name = "mutated_translate",
    srcs = [_SOURCE],
    outs = ["EsmSplit/Translate.lean"],
    cmd = "test \"$$(grep -F -c 'writes := f.writes,' $(location " + _SOURCE + "))\" -eq 1 && " +
          "sed 's/writes := f.writes,/writes := [],/' $(location " + _SOURCE + ") > $@",
)

lean_binary(
    name = "translate",
    srcs = [
        _BASE,
        ":mutated_translate",
    ],
    entry = "EsmSplit/TranslateMain.lean",
    visibility = ["//devinfra/js/debundle/x/split_proof/translation:__pkg__"],
)
