load("@rules_lean//lean:lean.bzl", "lean_binary")

_LOWER = "//devinfra/js/debundle/x/split_proof/lean:lower_mutation_source"

_BASE = "//devinfra/js/debundle/x/split_proof/lean:translation_mutation_base_sources"

genrule(
    name = "mutated_lower",
    srcs = [_LOWER],
    outs = ["Experiments/Lower.lean"],
    cmd = "test \"$$(grep -F -c 'let factoryInert := unobserved && !factoryIdentifiers.contains' $(location " + _LOWER + "))\" -eq 1 && " +
          "sed 's|let factoryInert := unobserved && !factoryIdentifiers.contains|let factoryInert := !factoryIdentifiers.contains|' $(location " + _LOWER + ") > $@",
)

lean_binary(
    name = "translate",
    srcs = [
        _BASE,
        ":mutated_lower",
    ],
    entry = "Experiments/TranslateMain.lean",
    visibility = ["//devinfra/js/debundle/x/split_proof/experiments/translation:__pkg__"],
)
