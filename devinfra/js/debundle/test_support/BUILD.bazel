load("@aspect_rules_js//js:defs.bzl", "js_info_files", "js_library")

js_info_files(
    name = "sources",
    srcs = [
        ":libs",
        ":pipeline_fixture_lib",
    ],
    visibility = ["//visibility:public"],
)

# Black-box test helpers with no dependency on debundler internals.
