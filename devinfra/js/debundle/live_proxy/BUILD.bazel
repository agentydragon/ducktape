load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library", "js_test")

filegroup(
    name = "serve_entry_point",
    srcs = ["serve.mjs"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "browser_load_test_entry_point",
    srcs = ["browser_load_test.mjs"],
    visibility = ["//visibility:public"],
)

js_library(
    name = "libs",
    srcs = ["proxy.mjs"],
    visibility = ["//visibility:public"],
    deps = [
        "//:node_modules/http-mitm-proxy",
        "//:node_modules/node-forge",
        "//devinfra/js/debundle/common:libs",
    ],
)

js_binary(
    name = "serve_bin",
    data = [
        "proxy.mjs",
        ":serve_entry_point",
        "//:node_modules/http-mitm-proxy",
        "//:node_modules/node-forge",
        "//devinfra/js/debundle/common:libs",
    ],
    entry_point = ":serve_entry_point",
    visibility = ["//visibility:public"],
)

js_test(
    name = "proxy_test",
    data = [
        "proxy.mjs",
        "//:node_modules/http-mitm-proxy",
        "//:node_modules/node-forge",
        "//devinfra/js/debundle/common:sources",
        "//devinfra/js/debundle/test_support:sources",
    ],
    entry_point = "proxy_test.mjs",
)
