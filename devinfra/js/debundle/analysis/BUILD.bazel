        "boundary.mjs",
        "//devinfra/js/debundle/common:sources",
        "//devinfra/js/debundle/test_support:sources",
    ] + _BABEL_DEPS,
    entry_point = "boundary_test.mjs",
)

js_test(
    name = "identifier_frequency_test",
    data = [
        "identifier_frequency.mjs",
        "//devinfra/js/debundle/common:sources",
        "//devinfra/js/debundle/test_support:sources",
    ] + _BABEL_DEPS,
    entry_point = "identifier_frequency_test.mjs",
)
