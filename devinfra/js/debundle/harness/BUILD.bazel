load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library", "js_run_binary", "js_test")
load("//devinfra/oci:defs.bzl", "extract_image_subdir")

# Sourced from the digest-pinned excalidraw/excalidraw image (see
# devinfra/image_pins.json). The extracted /assets/ directory is the deployed
# Vite/Rollup ESM webapp, used as the logical-module materialization benchmark
# corpus. Tagged `manual` so `bazel build //...` doesn't pull a 30 MB OCI image
# and run the extraction action — only the manual benchmark targets ever
# consume it.
extract_image_subdir(
    name = "excalidraw_bundle_assets",
    image = "@excalidraw_linux_amd64",
    subdir = "usr/share/nginx/html/assets",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

js_binary(
    name = "benchmark_excalidraw",
    data = [
        "benchmark_excalidraw.mjs",
        "benchmark_shared.mjs",
        ":excalidraw_bundle_assets",
        "//:node_modules/jsonc-parser",
        "//devinfra/js/debundle/common:libs",
        "//devinfra/js/debundle/extract:libs",
        "//devinfra/js/debundle/split:libs",
    ],
    entry_point = "benchmark_excalidraw.mjs",
    node_options = ["--max-old-space-size=8192"],
)

js_test(
    name = "benchmark_excalidraw_test",
    size = "enormous",
    data = [
        "benchmark_excalidraw.mjs",
        "benchmark_shared.mjs",
        ":excalidraw_bundle_assets",
        "//devinfra/js/debundle/common:libs",
        "//devinfra/js/debundle/extract:libs",
        "//devinfra/js/debundle/split:libs",
    ],
    entry_point = "benchmark_excalidraw.mjs",
    node_options = ["--max-old-space-size=8192"],
    tags = ["manual"],
)

js_library(
    name = "libs",
    srcs = [
        "emit.mjs",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//devinfra/js/debundle/common:libs",
        "//devinfra/js/debundle/split:libs",
    ],
)

filegroup(
    name = "mock_testdata",
    srcs = glob(["testdata/mock_browser_bundle/**"]),
)

filegroup(
    name = "mock_source",
    srcs = [
        "build_mock_bundle.mjs",
    ] + glob(["testdata/mock_browser_bundle/source/**"]),
)

js_library(
    name = "build_mock_bundle_lib",
    srcs = ["build_mock_bundle.mjs"],
    deps = [
        "//:node_modules/vite",
    ],
)

js_library(
    name = "mock_pipeline_lib",
    srcs = [
        "mock_pipeline.mjs",
        "mock_spec.mjs",
    ],
    deps = [
        "//devinfra/js/debundle/test_support:libs",
        "//devinfra/js/debundle/transforms:libs",
    ],
)

js_library(
    name = "build_mock_golden_lib",
    srcs = ["build_mock_golden.mjs"],
    deps = [":mock_pipeline_lib"],
)

js_binary(
    name = "build_mock_bundle",
    data = [
        ":build_mock_bundle_lib",
        ":mock_source",
    ],
    entry_point = "build_mock_bundle.mjs",
)

js_run_binary(
    name = "mock_fixture",
    srcs = [":mock_source"],
    outs = [
        "testdata/mock_browser_bundle/generated/extracted/asset-summary.json",
        "testdata/mock_browser_bundle/generated/extracted/js-files.txt",
        "testdata/mock_browser_bundle/generated/snapshot/index.html",
        "testdata/mock_browser_bundle/generated/snapshot/preload/app.css",
        "testdata/mock_browser_bundle/generated/snapshot/static/ActivityPanel-DuckMock.js",
        "testdata/mock_browser_bundle/generated/snapshot/static/SummaryChip-DuckMock.js",
        "testdata/mock_browser_bundle/generated/snapshot/static/chunk-DuckMock.js",
        "testdata/mock_browser_bundle/generated/snapshot/static/index-DuckMock.js",
    ],
    args = ["testdata/mock_browser_bundle/generated"],
    chdir = package_name(),
    tool = ":build_mock_bundle",
)

js_binary(
    name = "build_mock_golden",
    data = [
        ":build_mock_golden_lib",
        ":mock_testdata",
    ],
    entry_point = "build_mock_golden.mjs",
)

js_test(
    name = "emit_test",
    data = [
        "emit.mjs",
        "//devinfra/js/debundle/common:sources",
        "//devinfra/js/debundle/split:libs",
        "//devinfra/js/debundle/test_support:sources",
        "//devinfra/js/debundle/transforms:libs",
        "//devinfra/js/debundle/vendor:libs",
    ],
    entry_point = "emit_test.mjs",
)

js_test(
    name = "pipeline_e2e_test",
    size = "small",
    data = [
        ":mock_pipeline_lib",
        ":mock_testdata",
        "//devinfra/js/debundle/test_support:sources",
        "//util/testing/frontend_visual:puppeteer_lib",
        "@playwright_browsers//:chromium-headless-shell",
    ],
    entry_point = "pipeline_e2e_test.mjs",
    env = {
        "PUPPETEER_EXECUTABLE_PATH": "$(rootpath @playwright_browsers//:chromium-headless-shell)",
    },
    no_copy_to_bin = [
        "@playwright_browsers//:chromium-headless-shell",
    ],
)

js_test(
    name = "mock_equivalence_test",
    size = "small",
    data = [
        ":build_mock_bundle_lib",
        ":mock_testdata",
        "//devinfra/js/debundle/test_support:sources",
    ],
    entry_point = "mock_equivalence_test.mjs",
)

js_test(
    name = "mock_golden_test",
    size = "small",
    data = [
        ":build_mock_golden_lib",
        ":mock_pipeline_lib",
        ":mock_testdata",
        "//devinfra/js/debundle/test_support:sources",
    ],
    entry_point = "mock_golden_test.mjs",
)

js_binary(
    name = "generate_excalidraw_reference",
    data = [
        "benchmark_excalidraw.mjs",
        "testdata/excalidraw_reference/HUMANLIKE_GAPS.md",
        "testdata/excalidraw_reference/excalidraw_app_state.js",
        "testdata/excalidraw_reference/excalidraw_canvas_interactions.js",
        "testdata/excalidraw_reference/excalidraw_element_mutations.js",
        "testdata/excalidraw_reference/excalidraw_history_stack.js",
        "testdata/excalidraw_reference/excalidraw_scene_restore.js",
        "testdata/excalidraw_reference/excalidraw_ui_actions.js",
        "testdata/excalidraw_reference/spec.jsonc",
        ":excalidraw_bundle_assets",
        ":generate_excalidraw_reference_lib",
        "//devinfra/js/debundle/common:libs",
        "//devinfra/js/debundle/extract:libs",
        "//devinfra/js/debundle/split:libs",
    ],
    entry_point = "generate_excalidraw_reference.mjs",
    node_options = ["--max-old-space-size=8192"],
)

js_library(
    name = "generate_excalidraw_reference_lib",
    srcs = [
        "benchmark_shared.mjs",
        "generate_excalidraw_reference.mjs",
    ],
    deps = [
        "//:node_modules/jsonc-parser",
        "//devinfra/js/debundle/common:libs",
        "//devinfra/js/debundle/extract:libs",
        "//devinfra/js/debundle/split:libs",
    ],
)

js_test(
    name = "excalidraw_reference_golden_test",
    size = "large",
    data = [
        "excalidraw_reference_golden_test.mjs",
        "testdata/excalidraw_reference/HUMANLIKE_GAPS.md",
        "testdata/excalidraw_reference/README.md",
        "testdata/excalidraw_reference/excalidraw_app_state.js",
        "testdata/excalidraw_reference/excalidraw_canvas_interactions.js",
        "testdata/excalidraw_reference/excalidraw_element_mutations.js",
        "testdata/excalidraw_reference/excalidraw_history_stack.js",
        "testdata/excalidraw_reference/excalidraw_scene_restore.js",
        "testdata/excalidraw_reference/excalidraw_ui_actions.js",
        "testdata/excalidraw_reference/spec.jsonc",
        ":excalidraw_bundle_assets",
        ":generate_excalidraw_reference_lib",
        "//devinfra/js/debundle/test_support:sources",
    ],
    entry_point = "excalidraw_reference_golden_test.mjs",
    node_options = ["--max-old-space-size=8192"],
)
