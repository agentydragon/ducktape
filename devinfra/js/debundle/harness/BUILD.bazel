load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library", "js_run_binary", "js_test")
load("//devinfra/oci:defs.bzl", "extract_image_subdir")

# Sourced from the digest-pinned excalidraw/excalidraw image (see
# devinfra/image_pins.json). The extracted /assets/ directory is the deployed
# Vite/Rollup ESM webapp — same shape as Tana's bundles, used as the debundler
# benchmark corpus.
extract_image_subdir(
    name = "excalidraw_bundle_assets",
    image = "@excalidraw_linux_amd64",
    subdir = "usr/share/nginx/html/assets",
    visibility = ["//visibility:public"],
)

js_binary(
    name = "benchmark_excalidraw",
    data = [
        "benchmark_excalidraw.mjs",
        ":excalidraw_bundle_assets",
        "//devinfra/js/debundle/common:libs",
        "//devinfra/js/debundle/extract:libs",
        "//devinfra/js/debundle/split:libs",
    ],
    entry_point = "benchmark_excalidraw.mjs",
    node_options = ["--max-old-space-size=8192"],
)

js_library(
    name = "libs",
    srcs = [
        "emit_browser_harness_lib.mjs",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//devinfra/js/debundle/common:libs",
        "//devinfra/js/debundle/split:libs",
    ],
)

filegroup(
    name = "mock_browser_bundle_testdata",
    srcs = glob(["testdata/mock_browser_bundle/**"]),
)

filegroup(
    name = "mock_browser_bundle_source",
    srcs = [
        "build_mock_browser_bundle.mjs",
    ] + glob(["testdata/mock_browser_bundle/source/**"]),
)

js_library(
    name = "build_mock_browser_bundle_lib",
    srcs = ["build_mock_browser_bundle.mjs"],
    deps = [
        "//:node_modules/vite",
    ],
)

js_library(
    name = "mock_browser_bundle_pipeline_lib",
    srcs = [
        "mock_browser_bundle_pipeline_lib.mjs",
        "mock_browser_bundle_pipeline_spec.mjs",
    ],
    deps = [
        "//devinfra/js/debundle/test_support:libs",
        "//devinfra/js/debundle/transforms:libs",
    ],
)

js_library(
    name = "build_mock_browser_pipeline_golden_lib",
    srcs = ["build_mock_browser_pipeline_golden.mjs"],
    deps = [":mock_browser_bundle_pipeline_lib"],
)

js_binary(
    name = "build_mock_browser_bundle",
    data = [
        ":build_mock_browser_bundle_lib",
        ":mock_browser_bundle_source",
    ],
    entry_point = "build_mock_browser_bundle.mjs",
)

js_run_binary(
    name = "mock_browser_bundle_fixture",
    srcs = [":mock_browser_bundle_source"],
    outs = [
        "testdata/mock_browser_bundle/generated/extracted/asset-summary.json",
        "testdata/mock_browser_bundle/generated/extracted/js-files.txt",
        "testdata/mock_browser_bundle/generated/snapshot/index.html",
        "testdata/mock_browser_bundle/generated/snapshot/preload/app.css",
        "testdata/mock_browser_bundle/generated/snapshot/static/ActivityPanel-DuckMock.js",
        "testdata/mock_browser_bundle/generated/snapshot/static/SummaryChip-DuckMock.js",
        "testdata/mock_browser_bundle/generated/snapshot/static/chunk-DuckMock.js",
        "testdata/mock_browser_bundle/generated/snapshot/static/index-DuckMock.js",
    ],
    args = ["testdata/mock_browser_bundle/generated"],
    chdir = package_name(),
    tool = ":build_mock_browser_bundle",
)

js_binary(
    name = "build_mock_browser_pipeline_golden",
    data = [
        ":build_mock_browser_pipeline_golden_lib",
        ":mock_browser_bundle_testdata",
    ],
    entry_point = "build_mock_browser_pipeline_golden.mjs",
)

js_test(
    name = "emit_browser_harness_test",
    data = [
        "emit_browser_harness_lib.mjs",
        "//devinfra/js/debundle/common:sources",
        "//devinfra/js/debundle/split:libs",
        "//devinfra/js/debundle/test_support:sources",
        "//devinfra/js/debundle/transforms:libs",
        "//devinfra/js/debundle/vendor:libs",
    ],
    entry_point = "emit_browser_harness_test.mjs",
)

js_test(
    name = "browser_harness_pipeline_e2e_test",
    size = "small",
    data = [
        ":mock_browser_bundle_pipeline_lib",
        ":mock_browser_bundle_testdata",
        "//devinfra/js/debundle/test_support:sources",
        "//util/testing/frontend_visual:puppeteer_lib",
        "@playwright_browsers//:chromium-headless-shell",
    ],
    entry_point = "browser_harness_pipeline_e2e_test.mjs",
    env = {
        "PUPPETEER_EXECUTABLE_PATH": "$(rootpath @playwright_browsers//:chromium-headless-shell)",
    },
    no_copy_to_bin = [
        "@playwright_browsers//:chromium-headless-shell",
    ],
)

js_test(
    name = "mock_browser_bundle_fixture_equivalence_test",
    size = "small",
    data = [
        ":build_mock_browser_bundle_lib",
        ":mock_browser_bundle_testdata",
        "//devinfra/js/debundle/test_support:sources",
    ],
    entry_point = "mock_browser_bundle_fixture_equivalence_test.mjs",
)

js_test(
    name = "mock_browser_bundle_pipeline_golden_test",
    size = "small",
    data = [
        ":build_mock_browser_pipeline_golden_lib",
        ":mock_browser_bundle_pipeline_lib",
        ":mock_browser_bundle_testdata",
        "//devinfra/js/debundle/test_support:sources",
    ],
    entry_point = "mock_browser_bundle_pipeline_golden_test.mjs",
)
