load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//devinfra/js/debundle:__subpackages__"])

rust_library(
    name = "peel",
    srcs = [
        "assignment.rs",
        "baseline_insertion.rs",
        "mod.rs",
        "placement.rs",
        "plan.rs",
        "search.rs",
    ],
    crate_root = "mod.rs",
    edition = "2024",
    deps = [
        "//devinfra/js/debundle:analysis",
        "//devinfra/js/debundle:analysis_model",
        "//devinfra/js/debundle:anonymous_resolution",
        "//devinfra/js/debundle:gate",
        "//devinfra/js/debundle:graph_provenance",
        "//devinfra/js/debundle:report_io",
        "//devinfra/js/debundle:source_identity",
        "//devinfra/js/debundle:spec",
        "//devinfra/js/debundle:spec_modules",
        "//devinfra/js/debundle:spec_tree",
        "//devinfra/js/debundle/graph",
        "@crates//:anyhow",
        "@crates//:clap",
        "@crates//:petgraph",
        "@crates//:serde",
        "@crates//:strum",
        "@crates//:thiserror",
    ],
)

rust_test(
    name = "peel_test",
    crate = ":peel",
    edition = "2024",
    deps = ["@crates//:proptest"],
)
