load("@aspect_rules_js//js:defs.bzl", "js_library", "js_test")

_BABEL_DEPS = [
    "//:node_modules/@babel/generator",
    "//:node_modules/@babel/parser",
    "//:node_modules/@babel/traverse",
    "//:node_modules/@babel/types",
]

js_library(
    name = "libs",
    srcs = [
        "apply_vendor_annotations_lib.mjs",
        "rename_vendor_exports_lib.mjs",
        "swap_vendor_chunks_lib.mjs",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//devinfra/js/debundle/common:libs",
    ] + _BABEL_DEPS,
)

js_test(
    name = "apply_vendor_annotations_test",
    data = [
        "apply_vendor_annotations_lib.mjs",
        "//devinfra/js/debundle/test_support:sources",
    ],
    entry_point = "apply_vendor_annotations_test.mjs",
)

js_test(
    name = "rename_vendor_exports_test",
    data = [
        "rename_vendor_exports_lib.mjs",
        "//devinfra/js/debundle/common:sources",
        "//devinfra/js/debundle/test_support:sources",
    ] + _BABEL_DEPS,
    entry_point = "rename_vendor_exports_test.mjs",
)

js_test(
    name = "swap_vendor_chunks_test",
    data = [
        "rename_vendor_exports_lib.mjs",
        "swap_vendor_chunks_lib.mjs",
        "//devinfra/js/debundle/common:sources",
        "//devinfra/js/debundle/test_support:sources",
    ] + _BABEL_DEPS,
    entry_point = "swap_vendor_chunks_test.mjs",
)
