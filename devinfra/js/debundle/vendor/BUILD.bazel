load("@aspect_rules_js//js:defs.bzl", "js_library", "js_test")

_BABEL_DEPS = [
    "//:node_modules/@babel/generator",
    "//:node_modules/@babel/parser",
    "//:node_modules/@babel/traverse",
    "//:node_modules/@babel/types",
]

js_library(
    name = "libs",
    srcs = [
        "annotate.mjs",
        "exports.mjs",
        "swap.mjs",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//devinfra/js/debundle/common:libs",
    ] + _BABEL_DEPS,
)

js_test(
    name = "annotate_test",
    data = [
        "annotate.mjs",
        "//devinfra/js/debundle/test_support:sources",
    ],
    entry_point = "annotate_test.mjs",
)

js_test(
    name = "exports_test",
    data = [
        "exports.mjs",
        "//devinfra/js/debundle/common:sources",
        "//devinfra/js/debundle/test_support:sources",
    ] + _BABEL_DEPS,
    entry_point = "exports_test.mjs",
)

js_test(
    name = "swap_test",
    data = [
        "exports.mjs",
        "swap.mjs",
        "//devinfra/js/debundle/common:sources",
        "//devinfra/js/debundle/test_support:sources",
    ] + _BABEL_DEPS,
    entry_point = "swap_test.mjs",
)
