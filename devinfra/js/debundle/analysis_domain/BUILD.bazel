load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//devinfra/js/debundle:__subpackages__"])

rust_library(
    name = "analysis_domain",
    srcs = glob(["*.rs"]),
    crate_root = "lib.rs",
    edition = "2024",
    deps = [
        "//devinfra/js/debundle:analysis_model",
        "//devinfra/js/debundle:binding_targets",
        "//devinfra/js/debundle:js_ast",
        "//devinfra/js/debundle/analysis_vocabulary",
        "//devinfra/js/debundle/inference",
        "@crates//:serde",
        "@crates//:strum",
        "@crates//:swc_common",
        "@crates//:swc_ecma_ast",
        "@crates//:swc_ecma_visit",
    ],
)

rust_test(
    name = "analysis_domain_test",
    crate = ":analysis_domain",
    edition = "2024",
    deps = [
        "//devinfra/js/debundle:raw_js_test_support",
        "//devinfra/js/debundle:source_identity",
    ],
)
