load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//devinfra/js/debundle:__subpackages__"])

rust_library(
    name = "sync_effects",
    srcs = glob(["**/*.rs"]),
    crate_root = "mod.rs",
    edition = "2024",
    deps = [
        "//devinfra/js/debundle:analysis",
        "//devinfra/js/debundle:analysis_model",
        "//devinfra/js/debundle:binding_targets",
        "//devinfra/js/debundle:js_ast",
        "//devinfra/js/debundle:source_identity",
        "//devinfra/js/debundle:work_metrics",
        "//devinfra/js/debundle/analysis_domain",
        "//devinfra/js/debundle/analysis_vocabulary",
        "//devinfra/js/debundle/facts/sync_effects/kernel",
        "//devinfra/js/debundle/facts/sync_effects/value_model",
        "//devinfra/js/debundle/facts/sync_effects/world",
        "//devinfra/js/debundle/inference",
        "//devinfra/js/debundle/purity",
        "//devinfra/js/debundle/spec",
        "//devinfra/js/debundle/value_flow",
        "@crates//:imbl",
        "@crates//:rustc-hash",
        "@crates//:swc_atoms",
        "@crates//:swc_common",
        "@crates//:swc_ecma_ast",
        "@crates//:swc_ecma_visit",
    ],
)

rust_test(
    name = "sync_effects_test",
    crate = ":sync_effects",
    edition = "2024",
    deps = [
        "//devinfra/js/debundle:raw_js_test_support",
    ],
)
