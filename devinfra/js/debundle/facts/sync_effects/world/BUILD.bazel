load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//devinfra/js/debundle:__subpackages__"])

rust_library(
    name = "world",
    srcs = glob(["*.rs"]),
    crate_root = "mod.rs",
    edition = "2024",
    deps = [
        "//devinfra/js/debundle:analysis",
        "//devinfra/js/debundle:analysis_model",
        "//devinfra/js/debundle:source_identity",
        "//devinfra/js/debundle/analysis_domain",
        "//devinfra/js/debundle/analysis_vocabulary",
        "//devinfra/js/debundle/facts/sync_effects/value_model",
        "@crates//:imbl",
        "@crates//:rustc-hash",
        "@crates//:swc_atoms",
        "@crates//:swc_common",
        "@crates//:swc_ecma_ast",
    ],
)

rust_test(
    name = "world_test",
    crate = ":world",
    edition = "2024",
)
