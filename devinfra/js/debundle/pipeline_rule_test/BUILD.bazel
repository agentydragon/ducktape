load("//devinfra/js/debundle:debundle_cli.bzl", "debundle_cli")
load("//devinfra/js/debundle:pipeline.bzl", "debundle_apply")
load("//devinfra/python:defs.bzl", "py_test")
load(":pipeline_rule_test.bzl", "analysis_identity_inputs_test", "analysis_threads_action_test", "apply_projection_inputs_test", "fixture_analysis", "fixture_apply", "ownership_subset_split_graphs_test", "package_root_fixture", "pipeline_report_flags_test", "selected_subset_cli_contract_test", "shared_analysis_test", "source_tree_fixture")

package(default_testonly = True)

analysis_identity_inputs_test(
    name = "identity_inputs_test",
    target_under_test = "//devinfra/js/debundle:analysis_identity_source",
)

filegroup(
    name = "spec",
    srcs = glob(["fixture/**/*.yaml"]),
)

filegroup(
    name = "source",
    srcs = [
        "fixture/js-files.txt",
        "fixture/source/main.js",
    ],
)

exports_files(["ownership_subset.json"])

package_root_fixture(
    name = "package_root",
)

source_tree_fixture(
    name = "relocatable_source",
    srcs = {
        "devinfra/js/debundle/pipeline_rule_test/fixture/js-files.txt": "fixture/js-files.txt",
        "devinfra/js/debundle/pipeline_rule_test/fixture/source/main.js": "fixture/source/main.js",
    },
)

fixture_analysis(name = "analysis")

fixture_apply(
    name = "jsonl_default",
    analysis = ":analysis",
)

fixture_apply(
    name = "tree_projection_inputs",
    analysis = ":analysis",
    package_roots = {":package_root": "fixture-package"},
)

fixture_apply(
    name = "tree_extra_spec_input",
    analysis = ":analysis",
    package_roots = {":package_root": "fixture-package"},
    spec_tree_inputs = [
        ":spec",
        "flat_spec.yaml",
    ],
)

debundle_apply(
    name = "flat_projection_inputs",
    analysis = ":analysis",
    input_data = [":source"],
    package_roots = {":package_root": "fixture-package"},
    spec = "flat_spec.yaml",
    tags = ["manual"],
    tree_source_root = ":source",
)

apply_projection_inputs_test(
    name = "tree_projection_inputs_test",
    apply_only_inputs = [
        "fixture/js-files.txt",
        "pipeline_rule_test/package_root",
        "fixture/source/main.js",
    ],
    spec_inputs = [
        "fixture/config.yaml",
        "fixture/modules/main/values.yaml",
        "fixture/vendor_marks.yaml",
        "flat_spec.yaml",
    ],
    target_under_test = ":tree_extra_spec_input",
)

apply_projection_inputs_test(
    name = "flat_projection_inputs_test",
    apply_only_inputs = [
        "fixture/js-files.txt",
        "pipeline_rule_test/package_root",
        "fixture/source/main.js",
    ],
    spec_inputs = ["flat_spec.yaml"],
    target_under_test = ":flat_projection_inputs",
)

fixture_apply(
    name = "jsonl_readable_default",
    analysis = ":analysis",
    emit_on_rejection = True,
    split_dependency_graphs = True,
)

fixture_apply(
    name = "subset_graphs",
    analysis = ":analysis",
    ownership_subset = "ownership_subset.json",
    split_dependency_graphs = True,
)

ownership_subset_split_graphs_test(
    name = "ownership_subset_split_graphs_test",
    target_under_test = ":subset_graphs",
)

debundle_cli(
    name = "selected_subset_cli",
    testonly = True,
    debundle = ":subset_graphs",
    graph_relpath = "reports/tree/main/dependency_graph.json.gz",
    graph_source_data = ":relocatable_source",
    modules_path = "devinfra/js/debundle/pipeline_rule_test/fixture/modules",
    ownership_subset = "ownership_subset.json",
    source_data = ":relocatable_source",
    spec_root = "devinfra/js/debundle/pipeline_rule_test/fixture",
)

selected_subset_cli_contract_test(
    name = "selected_subset_cli_contract_test",
    cli_target = ":selected_subset_cli",
    target_under_test = ":selected_subset_cli",
)

py_test(
    name = "selected_subset_cli_test",
    srcs = ["selected_subset_cli_test.py"],
    data = [
        "fixture/modules/main/values.yaml",
        "ownership_subset.json",
        ":selected_subset_cli",
        ":selected_subset_cli__debundler",
        ":selected_subset_cli__graph__tree",
        ":selected_subset_cli__relocatable_source__tree",
        ":selected_subset_cli__source__tree",
        ":source",
        ":spec",
    ],
    env = {
        "DEBUNDLER": "$(rlocationpath :selected_subset_cli__debundler)",
        "GRAPH_SOURCE_TREE": "$(rlocationpath :selected_subset_cli__relocatable_source__tree)",
        "GRAPH_TREE": "$(rlocationpath :selected_subset_cli__graph__tree)",
        "OWNERSHIP_SUBSET": "$(rlocationpath ownership_subset.json)",
        "RUNNER": "$(rlocationpath :selected_subset_cli)",
        "SOURCE_TREE": "$(rlocationpath :selected_subset_cli__source__tree)",
    },
    deps = [
        "//:conftest",
        "@pypi//pytest_bazel",
        "@rules_python//python/runfiles",
    ],
)

fixture_analysis(
    name = "thread_limited",
    analysis_threads = 2,
)

analysis_threads_action_test(
    name = "analysis_threads_action_test",
    target_under_test = ":thread_limited",
)

[
    fixture_apply(
        name = name,
        analysis = ":analysis",
        effect_conflicts_chunks = chunks,
        effect_conflicts_jsonl = export,
        emit_on_rejection = readable,
        split_dependency_graphs = readable,
    )
    for name, export, chunks, readable in [
        ("jsonl_export", True, [], False),
        (
            "jsonl_filtered",
            True,
            [
                "main",
                "static/quote'; $(printf injected) `printf injected`",
            ],
            False,
        ),
        (
            "jsonl_readable_filtered",
            True,
            [
                "main",
                "worker",
            ],
            True,
        ),
    ]
]

pipeline_report_flags_test(
    name = "default_test",
    baseline = ":jsonl_default",
    target_under_test = ":jsonl_default",
)

pipeline_report_flags_test(
    name = "export_test",
    baseline = ":jsonl_default",
    expected_flags = "--effect-conflicts-jsonl",
    target_under_test = ":jsonl_export",
)

pipeline_report_flags_test(
    name = "filtered_test",
    baseline = ":jsonl_default",
    expected_flags = "--effect-conflicts-jsonl --effect-conflicts-chunk 'main' --effect-conflicts-chunk 'static/quote'\\''; $(printf injected) `printf injected`'",
    target_under_test = ":jsonl_filtered",
)

pipeline_report_flags_test(
    name = "readable_test",
    baseline = ":jsonl_readable_default",
    expected_flags = "--effect-conflicts-jsonl --effect-conflicts-chunk 'main' --effect-conflicts-chunk 'worker'",
    readable = True,
    target_under_test = ":jsonl_readable_filtered",
)

[
    fixture_apply(
        name = name,
        analysis = ":analysis",
        emit_on_rejection = readable,
        full_report_chunks = chunks,
        full_reports = kinds,
        split_dependency_graphs = readable,
    )
    for name, chunks, readable, kinds in [
        (
            "full_translation",
            [],
            False,
            ["translation_validation"],
        ),
        (
            "full_reentry",
            [],
            False,
            ["export_reentry"],
        ),
        (
            "full_translation_filtered",
            ["static/quote'; $(printf injected) `printf injected`"],
            True,
            ["translation_validation"],
        ),
    ]
]

pipeline_report_flags_test(
    name = "full_report_test",
    baseline = ":jsonl_default",
    expected_flags = "--full-report 'translation_validation'",
    target_under_test = ":full_translation",
)

pipeline_report_flags_test(
    name = "full_report_filtered_test",
    baseline = ":jsonl_readable_default",
    expected_flags = "--full-report 'translation_validation' --full-report-chunk 'static/quote'\\''; $(printf injected) `printf injected`'",
    readable = True,
    target_under_test = ":full_translation_filtered",
)

pipeline_report_flags_test(
    name = "full_reentry_test",
    baseline = ":jsonl_default",
    expected_flags = "--full-report 'export_reentry'",
    target_under_test = ":full_reentry",
)

shared_analysis_test(
    name = "shared_analysis_test",
    distinct_variants = ["//devinfra/js/debundle/pipeline_rule_test/shared_analysis:b"],
    target_under_test = "//devinfra/js/debundle/pipeline_rule_test/shared_analysis:analysis",
    variants = ["//devinfra/js/debundle/pipeline_rule_test/shared_analysis:a"],
)

shared_analysis_test(
    name = "same_spec_different_packages_test",
    target_under_test = ":analysis",
    variants = [":tree_projection_inputs"],
)

py_test(
    name = "shared_analysis_behavior_test",
    srcs = ["shared_analysis_behavior_test.py"],
    data = [
        "//devinfra/js/debundle/pipeline_rule_test/shared_analysis:a",
        "//devinfra/js/debundle/pipeline_rule_test/shared_analysis:b",
        "@nodejs_linux_amd64//:bin/node",
    ],
    env = {
        "OUTPUT_A": "$(rlocationpath //devinfra/js/debundle/pipeline_rule_test/shared_analysis:a)",
        "OUTPUT_B": "$(rlocationpath //devinfra/js/debundle/pipeline_rule_test/shared_analysis:b)",
        "NODE": "$(rlocationpath @nodejs_linux_amd64//:bin/node)",
    },
    deps = [
        "//:conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@rules_python//python/runfiles",
    ],
)

test_suite(
    name = "tests",
    tests = [
        ":analysis_threads_action_test",
        ":default_test",
        ":export_test",
        ":filtered_test",
        ":flat_projection_inputs_test",
        ":full_reentry_test",
        ":full_report_filtered_test",
        ":full_report_test",
        ":identity_inputs_test",
        ":ownership_subset_split_graphs_test",
        ":readable_test",
        ":selected_subset_cli_contract_test",
        ":selected_subset_cli_test",
        ":shared_analysis_behavior_test",
        ":shared_analysis_test",
        ":tree_projection_inputs_test",
    ],
)
