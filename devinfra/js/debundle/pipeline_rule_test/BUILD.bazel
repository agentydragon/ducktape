load("//devinfra/js/debundle:pipeline.bzl", "debundle_pipeline")
load("//devinfra/python:defs.bzl", "py_test")
load(":pipeline_rule_test.bzl", "analysis_identity_inputs_test", "analysis_threads_action_test", "pipeline_report_flags_test", "product_family_test")

package(default_testonly = True)

analysis_identity_inputs_test(
    name = "identity_inputs_test",
    target_under_test = "//devinfra/js/debundle:analysis_identity_source",
)

filegroup(
    name = "spec",
    srcs = glob(["fixture/**/*.yaml"]),
)

filegroup(
    name = "source",
    srcs = [
        "fixture/js-files.txt",
        "fixture/source/main.js",
    ],
)

debundle_pipeline(
    name = "jsonl_default",
    input_data = [":source"],
    spec_tree_inputs = [":spec"],
    tags = ["manual"],
    tree_config = "fixture/config.yaml",
    tree_modules = "fixture/modules",
    tree_source_root = ":source",
    tree_vendor_marks = "fixture/vendor_marks.yaml",
)

debundle_pipeline(
    name = "jsonl_readable_default",
    emit_on_rejection = True,
    input_data = [":source"],
    spec_tree_inputs = [":spec"],
    split_dependency_graphs = True,
    tags = ["manual"],
    tree_config = "fixture/config.yaml",
    tree_modules = "fixture/modules",
    tree_source_root = ":source",
    tree_vendor_marks = "fixture/vendor_marks.yaml",
)

debundle_pipeline(
    name = "thread_limited",
    analysis_threads = 2,
    input_data = [":source"],
    spec_tree_inputs = [":spec"],
    split_dependency_graphs = True,
    tags = ["manual"],
    tree_config = "fixture/config.yaml",
    tree_modules = "fixture/modules",
    tree_source_root = ":source",
    tree_vendor_marks = "fixture/vendor_marks.yaml",
)

analysis_threads_action_test(
    name = "analysis_threads_action_test",
    target_under_test = ":thread_limited",
)

[
    debundle_pipeline(
        name = name,
        effect_conflicts_chunks = chunks,
        effect_conflicts_jsonl = export,
        emit_on_rejection = readable,
        input_data = [":source"],
        spec_tree_inputs = [":spec"],
        split_dependency_graphs = readable,
        tags = ["manual"],
        tree_config = "fixture/config.yaml",
        tree_modules = "fixture/modules",
        tree_source_root = ":source",
        tree_vendor_marks = "fixture/vendor_marks.yaml",
    )
    for name, export, chunks, readable in [
        ("jsonl_export", True, [], False),
        (
            "jsonl_filtered",
            True,
            [
                "main",
                "static/quote'; $(printf injected) `printf injected`",
            ],
            False,
        ),
        (
            "jsonl_readable_filtered",
            True,
            [
                "main",
                "worker",
            ],
            True,
        ),
    ]
]

pipeline_report_flags_test(
    name = "default_test",
    baseline = ":jsonl_default",
    target_under_test = ":jsonl_default",
)

pipeline_report_flags_test(
    name = "export_test",
    baseline = ":jsonl_default",
    expected_flags = "--effect-conflicts-jsonl",
    target_under_test = ":jsonl_export",
)

pipeline_report_flags_test(
    name = "filtered_test",
    baseline = ":jsonl_default",
    expected_flags = "--effect-conflicts-jsonl --effect-conflicts-chunk 'main' --effect-conflicts-chunk 'static/quote'\\''; $(printf injected) `printf injected`'",
    target_under_test = ":jsonl_filtered",
)

pipeline_report_flags_test(
    name = "readable_test",
    baseline = ":jsonl_readable_default",
    expected_flags = "--effect-conflicts-jsonl --effect-conflicts-chunk 'main' --effect-conflicts-chunk 'worker'",
    readable = True,
    target_under_test = ":jsonl_readable_filtered",
)

[
    debundle_pipeline(
        name = name,
        emit_on_rejection = readable,
        full_report_chunks = chunks,
        full_reports = kinds,
        input_data = [":source"],
        spec_tree_inputs = [":spec"],
        split_dependency_graphs = readable,
        tags = ["manual"],
        tree_config = "fixture/config.yaml",
        tree_modules = "fixture/modules",
        tree_source_root = ":source",
        tree_vendor_marks = "fixture/vendor_marks.yaml",
    )
    for name, chunks, readable, kinds in [
        (
            "full_translation",
            [],
            False,
            ["translation-validation"],
        ),
        (
            "full_reentry",
            [],
            False,
            ["export-reentry"],
        ),
        (
            "full_translation_filtered",
            ["static/quote'; $(printf injected) `printf injected`"],
            True,
            ["translation-validation"],
        ),
    ]
]

pipeline_report_flags_test(
    name = "full_report_test",
    baseline = ":jsonl_default",
    expected_flags = "--full-report 'translation-validation'",
    target_under_test = ":full_translation",
)

pipeline_report_flags_test(
    name = "full_report_filtered_test",
    baseline = ":jsonl_readable_default",
    expected_flags = "--full-report 'translation-validation' --full-report-chunk 'static/quote'\\''; $(printf injected) `printf injected`'",
    readable = True,
    target_under_test = ":full_translation_filtered",
)

pipeline_report_flags_test(
    name = "full_reentry_test",
    baseline = ":jsonl_default",
    expected_flags = "--full-report 'export-reentry'",
    target_under_test = ":full_reentry",
)

product_family_test(
    name = "product_family_test",
    analysis = "//devinfra/js/debundle/pipeline_rule_test/product:product_analysis",
    graphs = "//devinfra/js/debundle/pipeline_rule_test/product:product_graphs",
    passing = "//devinfra/js/debundle/pipeline_rule_test/product:product_passing",
    readable = "//devinfra/js/debundle/pipeline_rule_test/product:product_readable",
    residual_baseline = "//devinfra/js/debundle/pipeline_rule_test/product:product_residual_baseline",
    residual_baseline_analysis = "//devinfra/js/debundle/pipeline_rule_test/product:product_residual_baseline_analysis",
    target_under_test = "//devinfra/js/debundle/pipeline_rule_test/product:product",
)

product_family_test(
    name = "product_shared_baseline_test",
    analysis = "//devinfra/js/debundle/pipeline_rule_test/product:product_shared_baseline_analysis",
    graphs = "//devinfra/js/debundle/pipeline_rule_test/product:product_shared_baseline_graphs",
    residual_baseline = "//devinfra/js/debundle/pipeline_rule_test/product:product_shared_baseline_residual_baseline",
    residual_baseline_analysis = "//devinfra/js/debundle/pipeline_rule_test/product:product_shared_baseline_residual_baseline_analysis",
    residual_baseline_reuses_analysis = True,
    target_under_test = "//devinfra/js/debundle/pipeline_rule_test/product:product_shared_baseline",
)

# Declared targets and launcher arguments, as Bazel sees them after expansion.
genquery(
    name = "product_targets",
    expression = "//devinfra/js/debundle/pipeline_rule_test/product:all",
    opts = ["--output=xml"],
    # Exactly the expected family: an undeclared target fails the query, a
    # missing one fails analysis. Launcher helpers are in their launchers' closure.
    scope = ["//devinfra/js/debundle/pipeline_rule_test/product:" + name for name in [
        "product",
        "product_analysis",
        "product_graphs",
        "product_readable",
        "product_passing",
        "product_residual_baseline",
        "product_residual_baseline_analysis",
        "product_cli",
        "product_cli_worker",
        "product_cli_lazy",
        "product_shared_baseline",
        "product_shared_baseline_analysis",
        "product_shared_baseline_graphs",
        "product_shared_baseline_residual_baseline",
        "product_shared_baseline_residual_baseline_analysis",
        "product_minimal",
        "product_minimal_analysis",
        "product_minimal_graphs",
    ]],
)

py_test(
    name = "test_debundle_product",
    srcs = ["test_debundle_product.py"],
    data = [":product_targets"],
    env = {"PRODUCT_TARGETS": "$(rlocationpath :product_targets)"},
    deps = [
        "//:conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@rules_python//python/runfiles",
    ],
)

test_suite(
    name = "tests",
    tests = [
        ":analysis_threads_action_test",
        ":default_test",
        ":export_test",
        ":filtered_test",
        ":full_reentry_test",
        ":full_report_filtered_test",
        ":full_report_test",
        ":identity_inputs_test",
        ":product_family_test",
        ":product_shared_baseline_test",
        ":readable_test",
        ":test_debundle_product",
    ],
)
