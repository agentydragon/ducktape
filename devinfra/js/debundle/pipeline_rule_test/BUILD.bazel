load("//devinfra/js/debundle:pipeline.bzl", "debundle_analysis", "debundle_apply")
load("//devinfra/python:defs.bzl", "py_test")
load(":pipeline_rule_test.bzl", "analysis_identity_inputs_test", "analysis_threads_action_test", "pipeline_report_flags_test", "shared_analysis_test")

package(default_testonly = True)

analysis_identity_inputs_test(
    name = "identity_inputs_test",
    target_under_test = "//devinfra/js/debundle:analysis_identity_source",
)

filegroup(
    name = "spec",
    srcs = glob(["fixture/**/*.yaml"]),
)

filegroup(
    name = "source",
    srcs = [
        "fixture/js-files.txt",
        "fixture/source/main.js",
    ],
)

debundle_analysis(
    name = "analysis",
    input_data = [":source"],
    spec_tree_inputs = [":spec"],
    tags = ["manual"],
    tree_config = "fixture/config.yaml",
    tree_modules = "fixture/modules",
    tree_source_root = ":source",
    tree_vendor_marks = "fixture/vendor_marks.yaml",
)

debundle_apply(
    name = "jsonl_default",
    analysis = ":analysis",
    input_data = [":source"],
    spec_tree_inputs = [":spec"],
    tags = ["manual"],
    tree_config = "fixture/config.yaml",
    tree_modules = "fixture/modules",
    tree_source_root = ":source",
    tree_vendor_marks = "fixture/vendor_marks.yaml",
)

debundle_apply(
    name = "jsonl_readable_default",
    analysis = ":analysis",
    emit_on_rejection = True,
    input_data = [":source"],
    spec_tree_inputs = [":spec"],
    split_dependency_graphs = True,
    tags = ["manual"],
    tree_config = "fixture/config.yaml",
    tree_modules = "fixture/modules",
    tree_source_root = ":source",
    tree_vendor_marks = "fixture/vendor_marks.yaml",
)

debundle_analysis(
    name = "thread_limited",
    analysis_threads = 2,
    input_data = [":source"],
    spec_tree_inputs = [":spec"],
    tags = ["manual"],
    tree_config = "fixture/config.yaml",
    tree_modules = "fixture/modules",
    tree_source_root = ":source",
    tree_vendor_marks = "fixture/vendor_marks.yaml",
)

analysis_threads_action_test(
    name = "analysis_threads_action_test",
    target_under_test = ":thread_limited",
)

[
    debundle_apply(
        name = name,
        analysis = ":analysis",
        effect_conflicts_chunks = chunks,
        effect_conflicts_jsonl = export,
        emit_on_rejection = readable,
        input_data = [":source"],
        spec_tree_inputs = [":spec"],
        split_dependency_graphs = readable,
        tags = ["manual"],
        tree_config = "fixture/config.yaml",
        tree_modules = "fixture/modules",
        tree_source_root = ":source",
        tree_vendor_marks = "fixture/vendor_marks.yaml",
    )
    for name, export, chunks, readable in [
        ("jsonl_export", True, [], False),
        (
            "jsonl_filtered",
            True,
            [
                "main",
                "static/quote'; $(printf injected) `printf injected`",
            ],
            False,
        ),
        (
            "jsonl_readable_filtered",
            True,
            [
                "main",
                "worker",
            ],
            True,
        ),
    ]
]

pipeline_report_flags_test(
    name = "default_test",
    baseline = ":jsonl_default",
    target_under_test = ":jsonl_default",
)

pipeline_report_flags_test(
    name = "export_test",
    baseline = ":jsonl_default",
    expected_flags = "--effect-conflicts-jsonl",
    target_under_test = ":jsonl_export",
)

pipeline_report_flags_test(
    name = "filtered_test",
    baseline = ":jsonl_default",
    expected_flags = "--effect-conflicts-jsonl --effect-conflicts-chunk 'main' --effect-conflicts-chunk 'static/quote'\\''; $(printf injected) `printf injected`'",
    target_under_test = ":jsonl_filtered",
)

pipeline_report_flags_test(
    name = "readable_test",
    baseline = ":jsonl_readable_default",
    expected_flags = "--effect-conflicts-jsonl --effect-conflicts-chunk 'main' --effect-conflicts-chunk 'worker'",
    readable = True,
    target_under_test = ":jsonl_readable_filtered",
)

[
    debundle_apply(
        name = name,
        analysis = ":analysis",
        emit_on_rejection = readable,
        full_report_chunks = chunks,
        full_reports = kinds,
        input_data = [":source"],
        spec_tree_inputs = [":spec"],
        split_dependency_graphs = readable,
        tags = ["manual"],
        tree_config = "fixture/config.yaml",
        tree_modules = "fixture/modules",
        tree_source_root = ":source",
        tree_vendor_marks = "fixture/vendor_marks.yaml",
    )
    for name, chunks, readable, kinds in [
        (
            "full_translation",
            [],
            False,
            ["translation_validation"],
        ),
        (
            "full_reentry",
            [],
            False,
            ["export_reentry"],
        ),
        (
            "full_translation_filtered",
            ["static/quote'; $(printf injected) `printf injected`"],
            True,
            ["translation_validation"],
        ),
    ]
]

pipeline_report_flags_test(
    name = "full_report_test",
    baseline = ":jsonl_default",
    expected_flags = "--full-report 'translation_validation'",
    target_under_test = ":full_translation",
)

pipeline_report_flags_test(
    name = "full_report_filtered_test",
    baseline = ":jsonl_readable_default",
    expected_flags = "--full-report 'translation_validation' --full-report-chunk 'static/quote'\\''; $(printf injected) `printf injected`'",
    readable = True,
    target_under_test = ":full_translation_filtered",
)

pipeline_report_flags_test(
    name = "full_reentry_test",
    baseline = ":jsonl_default",
    expected_flags = "--full-report 'export_reentry'",
    target_under_test = ":full_reentry",
)

shared_analysis_test(
    name = "shared_analysis_test",
    target_under_test = "//devinfra/js/debundle/pipeline_rule_test/shared_analysis:analysis",
    variants = [
        "//devinfra/js/debundle/pipeline_rule_test/shared_analysis:a",
        "//devinfra/js/debundle/pipeline_rule_test/shared_analysis:b",
    ],
)

py_test(
    name = "shared_analysis_behavior_test",
    srcs = ["shared_analysis_behavior_test.py"],
    data = [
        "//devinfra/js/debundle/pipeline_rule_test/shared_analysis:a",
        "//devinfra/js/debundle/pipeline_rule_test/shared_analysis:b",
        "@nodejs_linux_amd64//:bin/node",
    ],
    env = {
        "OUTPUT_A": "$(rlocationpath //devinfra/js/debundle/pipeline_rule_test/shared_analysis:a)",
        "OUTPUT_B": "$(rlocationpath //devinfra/js/debundle/pipeline_rule_test/shared_analysis:b)",
        "NODE": "$(rlocationpath @nodejs_linux_amd64//:bin/node)",
    },
    deps = [
        "//:conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@rules_python//python/runfiles",
    ],
)

test_suite(
    name = "tests",
    tests = [
        ":analysis_threads_action_test",
        ":default_test",
        ":export_test",
        ":filtered_test",
        ":full_reentry_test",
        ":full_report_filtered_test",
        ":full_report_test",
        ":identity_inputs_test",
        ":readable_test",
        ":shared_analysis_behavior_test",
        ":shared_analysis_test",
    ],
)
