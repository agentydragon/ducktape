load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//devinfra/js/debundle:__subpackages__"])

rust_library(
    name = "analyze",
    srcs = glob(["*.rs"]),
    crate_root = "mod.rs",
    edition = "2024",
    deps = [
        "//devinfra/js/debundle:analysis",
        "//devinfra/js/debundle:source_identity",
        "//devinfra/js/debundle:work_metrics",
        "//devinfra/js/debundle/facts/sync_effects",
        "@crates//:swc_common",
        "@crates//:swc_ecma_ast",
        "@crates//:swc_ecma_visit",
    ],
)

rust_test(
    name = "analyze_test",
    crate = ":analyze",
    edition = "2024",
    deps = [
        "//devinfra/js/debundle:analysis_model",
        "//devinfra/js/debundle:js_ast",
        "//devinfra/js/debundle:raw_js_test_support",
        "@crates//:serde_json",
        "@crates//:swc_ecma_parser",
    ],
)
