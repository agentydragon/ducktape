load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library", "js_test")

filegroup(
    name = "run_transform_entry_point",
    srcs = ["run_transform.mjs"],
    visibility = ["//visibility:public"],
)

_JSONC_DEPS = [
    "//:node_modules/jsonc-parser",
]

js_library(
    name = "libs",
    srcs = [
        "rewrite_specifiers.mjs",
        "runner.mjs",
        "write.mjs",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//devinfra/js/debundle/analysis:libs",
        "//devinfra/js/debundle/common:libs",
        "//devinfra/js/debundle/extract:libs",
        "//devinfra/js/debundle/harness:libs",
        "//devinfra/js/debundle/split:libs",
        "//devinfra/js/debundle/vendor:libs",
    ] + _JSONC_DEPS,
)

js_binary(
    name = "run_transform",
    data = [
        ":libs",
        ":run_transform_entry_point",
    ],
    entry_point = ":run_transform_entry_point",
    node_options = [
        "--max-old-space-size=8192",
    ],
    visibility = ["//visibility:public"],
)

js_test(
    name = "rewrite_specifiers_test",
    data = [
        ":libs",
        "//devinfra/js/debundle/split:libs",
        "//devinfra/js/debundle/test_support:sources",
    ],
    entry_point = "rewrite_specifiers_test.mjs",
)

js_test(
    name = "write_test",
    data = [
        ":libs",
        "//:node_modules/@babel/types",
        "//devinfra/js/debundle/common:sources",
        "//devinfra/js/debundle/test_support:sources",
    ],
    entry_point = "write_test.mjs",
)
