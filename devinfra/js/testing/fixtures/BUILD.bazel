package(default_visibility = ["//devinfra/js/testing:__pkg__"])

genrule(
    name = "external_model_artifact",
    srcs = ["external_model.json"],
    outs = ["generated/external_model.json"],
    cmd = "mkdir -p $(RULEDIR)/generated && cp $(location external_model.json) $(RULEDIR)/generated/external_model.json",
)

genrule(
    name = "openapi_artifact",
    srcs = ["openapi.json"],
    outs = ["generated/openapi.json"],
    cmd = "mkdir -p $(RULEDIR)/generated && cp $(location openapi.json) $(RULEDIR)/generated/openapi.json",
)
