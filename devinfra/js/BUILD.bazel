# Shared JavaScript/TypeScript Bazel macros.

load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library", "js_test")
load("@rules_python//python:defs.bzl", "py_library")
load("//devinfra/python:defs.bzl", "py_binary", "py_test")

exports_files(
    ["eslint.typed.config.js"],
    visibility = ["//visibility:public"],
)

js_library(
    name = "eslint_typed_config",
    srcs = ["eslint.typed.config.js"],
    visibility = ["//visibility:public"],
    deps = [
        "//:node_modules/@typescript-eslint/eslint-plugin",
        "//:node_modules/@typescript-eslint/parser",
        "//:node_modules/eslint-plugin-react",
        "//:node_modules/eslint-plugin-react-hooks",
    ],
)

js_binary(
    name = "strip_ts_types",
    data = ["//:node_modules/typescript"],
    entry_point = "strip_ts_types.mjs",
    visibility = ["//visibility:public"],
)

js_binary(
    name = "openapi_typescript_codegen",
    data = [
        ":schema_remote_fetch_guard",
        "//:node_modules/openapi-typescript",
    ],
    entry_point = "openapi_typescript_codegen.mjs",
    visibility = ["//visibility:public"],
)

js_binary(
    name = "json_schema_typescript_codegen",
    data = ["//:node_modules/json-schema-to-typescript"],
    entry_point = "json_schema_typescript_codegen.mjs",
    visibility = ["//visibility:public"],
)

js_binary(
    name = "openapi_zod_codegen",
    data = [
        ":schema_remote_fetch_guard",
        "//:node_modules/@hey-api/openapi-ts",
    ],
    entry_point = "openapi_zod_codegen.mjs",
    visibility = ["//visibility:public"],
)

js_library(
    name = "schema_remote_fetch_guard",
    srcs = ["schema_remote_fetch_guard.mjs"],
)

js_test(
    name = "schema_remote_references_test",
    data = [
        ":json_schema_typescript_codegen",
        ":openapi_typescript_codegen",
        ":openapi_zod_codegen",
    ],
    entry_point = "schema_remote_references.test.mjs",
)

py_library(
    name = "spa_fingerprint",
    srcs = ["spa_fingerprint.py"],
)

py_binary(
    name = "spa_fingerprint_bin",
    main_module = "devinfra.js.spa_fingerprint",
    visibility = ["//visibility:public"],
    deps = [":spa_fingerprint"],
)

py_library(
    name = "bun_standalone_extract",
    srcs = ["bun_standalone_extract.py"],
)

py_binary(
    name = "bun_standalone_extract_bin",
    main_module = "devinfra.js.bun_standalone_extract",
    visibility = ["//visibility:public"],
    deps = [":bun_standalone_extract"],
)

py_test(
    name = "bun_standalone_extract_test",
    srcs = ["bun_standalone_extract_test.py"],
    deps = [
        ":bun_standalone_extract",
        "//:conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
