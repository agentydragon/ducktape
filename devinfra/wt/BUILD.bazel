# This tree deliberately uses the slim dist; the manifest maps `typer` to the fat one.
# gazelle:resolve py typer @pypi//typer_slim
load("//devinfra/python:defs.bzl", "py_binary", "py_library")

py_library(
    name = "cli",
    srcs = ["cli.py"],
    visibility = ["//visibility:public"],
    deps = [
        "//devinfra/wt/client:cd_utils",
        "//devinfra/wt/client:handlers",
        "//devinfra/wt/client:view_formatter",
        "//devinfra/wt/client:wt_client",
        "//devinfra/wt/shared:configuration",
        "//devinfra/wt/shared:constants",
        "//util:logging",
        "//util:typer",
        "@pypi//click",
        "@pypi//colorama",
        "@pypi//typer_slim",
    ],
)

py_binary(
    name = "wt_cli",
    main_module = "devinfra.wt.cli",
    visibility = ["//visibility:public"],
    deps = [":cli"],
)
