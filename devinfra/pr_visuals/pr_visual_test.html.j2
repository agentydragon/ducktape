{% import "issue_provenance.j2" as provenance -%}
{% macro issue_list(items) %}<ul>{% for issue in items %}<li>{{ provenance.issue_details(issue, issue.source.invocation_label if issue.source else none, issue.source.configuration_label if issue.source else none) }}</li>{% endfor %}</ul>{% endmacro %}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ title }} · {{ commit_sha }}</title>
    <link rel="stylesheet" href="{{ gallery_stylesheet }}">
    <link rel="stylesheet" href="{{ gallery_slider_stylesheet }}">
  </head>
  <body class="gallery-test">
    <header>
      <a href="../../index.html">All visual tests</a>
      <h1>{% if title == target_label %}<code>{{ target_label }}</code>{% else %}{{ title }}{% endif %}</h1>
      <div>{% if title != target_label %}<code>{{ target_label }}</code> · {% endif %}{{ repository }} · <code>{{ commit_sha }}</code>{% if base_sha %} · base <code>{{ base_sha[:8] }}</code>{% endif %}</div>
    </header>
    <main>
      {% if issues %}<div role="alert"><strong>Incomplete visual results</strong>{{ issue_list(issues) }}</div>{% endif %}
      {% if notices %}<details><summary>Retries and execution notices</summary>{{ issue_list(notices) }}</details>{% endif %}
      {% for asset in assets if asset.classification == "unstable" %}
      <figure id="{{ asset.path }}">
        <figcaption>{{ asset.label }}<span class="badge modified">unstable across runs</span></figcaption>
        {% for variant in asset.variants %}
        <div><div class="variant-provenance">{% for source in variant.provenance %}{{ provenance.variant_provenance(source) }}{% if not loop.last %}; {% endif %}{% endfor %}</div>
          <a class="sample-frame" href="{{ variant.url }}"><img src="{{ variant.url }}" alt="{{ asset.label }} variant {{ loop.index }}" loading="lazy"></a>
        </div>
        {% endfor %}
      </figure>
      {% endfor %}
      {% if base_sha %}
        {% set modified = assets | selectattr("classification", "equalto", "modified") | list %}
        {% set new_assets = assets | selectattr("classification", "equalto", "new") | list %}
        {% set removed = assets | selectattr("classification", "equalto", "removed") | list %}
        {% set unchanged = assets | selectattr("classification", "equalto", "unchanged") | list %}
        {% for asset in modified %}
        <figure id="{{ asset.path }}">
          <figcaption>{{ asset.label }}<span class="badge modified">modified</span>{% if asset.baseline_stale %}<span class="badge removed" title="This screenshot's baseline is not from the PR's merge base, so the diff may include devel drift.">stale baseline {{ base_sha[:8] }} ≠ merge base {{ merge_base_sha[:8] }}</span>{% endif %}
            {% if asset.dimension_changed %}<span class="badge modified">dims {{ asset.candidate_dimensions[0] }}×{{ asset.candidate_dimensions[1] }} ← {{ asset.baseline_dimensions[0] }}×{{ asset.baseline_dimensions[1] }}</span>{% endif %}
            <span class="metric">{{ "%.2f"|format(asset.changed_fraction * 100) }}% · {{ asset.changed_pixels }} px</span></figcaption>
          {% if asset.dimension_changed %}
          <div class="pair">
            <div><div>Before</div><a class="sample-frame" href="{{ asset.baseline_url }}"><img src="{{ asset.baseline_url }}" alt="{{ asset.label }} before" loading="lazy"></a></div>
            <div><div>After</div><a class="sample-frame" href="{{ asset.candidate_url }}"><img src="{{ asset.candidate_url }}" alt="{{ asset.label }} after" loading="lazy"></a></div>
          </div>
          <div class="sample-frame sample-frame--empty" role="note">Difference overlay unavailable because the screenshot dimensions changed.</div>
          {% else %}
          <div class="label-line comparison-labels"><span>Before</span><span>After</span></div>
          <img-comparison-slider class="comparison-slider" tabindex="0" keyboard="enabled" aria-label="{{ asset.label }} before and after">
            <img slot="first" width="100%" src="{{ asset.baseline_url }}" alt="{{ asset.label }} before">
            <img slot="second" width="100%" src="{{ asset.candidate_url }}" alt="{{ asset.label }} after">
          </img-comparison-slider>
          <details class="source-pair">
            <summary>View before and after separately</summary>
            <div class="pair">
              <div><div>Before</div><a class="sample-frame" href="{{ asset.baseline_url }}"><img src="{{ asset.baseline_url }}" alt="{{ asset.label }} before" loading="lazy"></a></div>
              <div><div>After</div><a class="sample-frame" href="{{ asset.candidate_url }}"><img src="{{ asset.candidate_url }}" alt="{{ asset.label }} after" loading="lazy"></a></div>
            </div>
          </details>
          <div class="label-line">Diff</div>
          <a class="sample-frame" href="{{ asset.diff_url }}"><img src="{{ asset.diff_url }}" alt="{{ asset.label }} diff" loading="lazy"></a>
          {% endif %}
        </figure>
        {% endfor %}
        {% for asset in new_assets %}
        <figure id="{{ asset.path }}">
          <figcaption>{{ asset.label }}<span class="badge new">new</span></figcaption>
          <a class="sample-frame" href="{{ asset.candidate_url }}"><img src="{{ asset.candidate_url }}" alt="{{ asset.label }}" loading="lazy"></a>
        </figure>
        {% endfor %}
        {% for asset in removed %}
        <figure id="{{ asset.path }}">
          <figcaption>{{ asset.label }}<span class="badge removed">removed</span>{% if asset.baseline_stale %}<span class="badge removed" title="This screenshot's baseline is not from the PR's merge base, so the diff may include devel drift.">stale baseline {{ base_sha[:8] }} ≠ merge base {{ merge_base_sha[:8] }}</span>{% endif %}</figcaption>
          <a class="sample-frame" href="{{ asset.baseline_url }}"><img src="{{ asset.baseline_url }}" alt="{{ asset.label }} before" loading="lazy"></a>
        </figure>
        {% endfor %}
        {% if unchanged %}
        <details>
          <summary>{{ unchanged | length }} unchanged</summary>
          <div class="pair" style="margin-top: 8px">
            {% for asset in unchanged %}
            <figure id="{{ asset.path }}"><figcaption>{{ asset.label }}</figcaption><a class="sample-frame" href="{{ asset.candidate_url }}"><img src="{{ asset.candidate_url }}" alt="{{ asset.label }}" loading="lazy"></a></figure>
            {% endfor %}
          </div>
        </details>
        {% endif %}
      {% else %}
        {% for asset in assets if asset.classification != "unstable" %}
        <figure id="{{ asset.path }}">
          <a class="sample-frame" href="{{ asset.candidate_url }}"><img src="{{ asset.candidate_url }}" alt="{{ asset.label }}" loading="lazy"></a>
          <figcaption>{{ asset.label }}</figcaption>
        </figure>
        {% endfor %}
      {% endif %}
    </main>
    <script src="{{ gallery_slider_script }}" defer></script>
  </body>
</html>
