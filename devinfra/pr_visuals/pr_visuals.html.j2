<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Visual review · {{ commit_sha }}</title>
    <link rel="stylesheet" href="{{ gallery_stylesheet }}">
  </head>
  <body class="gallery-index">
    <header>
      <h1>Visual review</h1>
      <div>{{ repository }} · <code>{{ commit_sha }}</code> · {{ tests | length }} Bazel test targets</div>
    </header>
    <div class="gallery-controls">
      <label for="test-sort">Sort tests</label>
      <select id="test-sort">
        <option value="impact">Review impact (comment order)</option>
        <option value="name">Test name (A–Z)</option>
        <option value="changed">Most changed screenshots</option>
      </select>
    </div>
    <main>
      {% for test in tests %}
      <section data-title="{{ test.title | lower }}" data-changed-count="{{ test.sort_changed_count }}" data-largest-change="{{ test.sort_largest_change }}">
        <h2><a href="tests/{{ test.slug }}/index.html">{{ test.title }}</a></h2>
        <p>
          <code>{{ test.target_label }}</code>
          {% if test.summary %}
            · {{ test.summary.modified }} modified, {{ test.summary.new }} new, {{ test.summary.removed }} removed, {{ test.summary.unchanged }} unchanged
          {% else %}
            · {{ test.assets | length }} assets
          {% endif %}
        </p>
        <div class="assets">
          {% if test.preview and test.preview.classification == "modified" %}
          <figure>
            {% if test.preview.dimension_changed %}
            <a class="sample-frame" href="{{ test.preview.anchor_url }}">
              <img src="{{ test.preview.candidate_url }}" alt="{{ test.preview.label }} after" loading="lazy">
            </a>
            <figcaption>{{ test.preview.label }} after · dimensions changed</figcaption>
            {% else %}
            <a class="sample-frame" href="{{ test.preview.anchor_url }}">
              <img src="{{ test.preview.diff_url }}" alt="{{ test.preview.label }} diff" loading="lazy">
            </a>
            <figcaption>{{ test.preview.label }} diff</figcaption>
            {% endif %}
          </figure>
          {% elif test.preview %}
          <figure>
            <a class="sample-frame" href="{{ test.preview.anchor_url }}">
              <img src="{{ test.preview.candidate_url }}" alt="{{ test.preview.label }}" loading="lazy">
            </a>
            <figcaption>{{ test.preview.label }} (new)</figcaption>
          </figure>
          {% elif not test.summary %}
            {% for asset in test.assets[:2] %}
            <figure>
              <a class="sample-frame" href="{{ asset.anchor_url }}">
                <img src="{{ asset.candidate_url }}" alt="{{ asset.label }}" loading="lazy">
              </a>
              <figcaption>{{ asset.label }}</figcaption>
            </figure>
            {% endfor %}
          {% endif %}
        </div>
      </section>
      {% endfor %}
    </main>
    <script src="gallery_sort.js" defer></script>
  </body>
</html>
