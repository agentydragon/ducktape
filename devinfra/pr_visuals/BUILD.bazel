load("@rules_python//python:packaging.bzl", "py_package", "py_wheel")
load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")
load("//util/testing/frontend_visual:py_visual_test.bzl", "py_visual_test")

# gazelle:exclude test_gallery_visual.py

py_library(
    name = "check_run",
    srcs = ["check_run.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "@pypi//pydantic",
        "@pypi//pygithub",
    ],
)

py_binary(
    name = "check_run_bin",
    main_module = "devinfra.pr_visuals.check_run",
    deps = [":check_run"],
)

py_library(
    name = "artifacts",
    srcs = ["artifacts.py"],
    visibility = ["//:__subpackages__"],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "determinism",
    srcs = ["determinism.py"],
    deps = [
        ":artifacts",
        ":targets",
        "//util:visual_review",
        "//util/bazel:workspace",
    ],
)

py_library(
    name = "targets",
    srcs = ["targets.py"],
    deps = [
        ":artifacts",
        "@pypi//pydantic",
    ],
)

py_binary(
    name = "determinism_bin",
    main_module = "devinfra.pr_visuals.determinism",
    deps = [":determinism"],
)

py_test(
    name = "test_determinism",
    srcs = ["test_determinism.py"],
    deps = [
        ":determinism",
        "//:conftest",
        "//util:visual_review",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "publisher",
    srcs = ["publisher.py"],
    data = [
        "gallery.css",
        "gallery_sort.js",
        "pr_visual_test.html.j2",
        "pr_visuals.html.j2",
    ],
    visibility = ["//:__subpackages__"],
    deps = [
        ":artifacts",
        ":check_run",
        ":pull_request",
        "//devinfra/ci:invocation_ids",
        "//util:visual_diff",
        "//util:visual_review",
        "@pypi//boto3",
        "@pypi//botocore",
        "@pypi//jinja2",
        "@pypi//more_itertools",
        "@pypi//pydantic",
        "@pypi//pygithub",
        "@pypi//tenacity",
    ],
)

py_test(
    name = "test_check_run",
    srcs = ["test_check_run.py"],
    deps = [
        ":check_run",
        "//:conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_binary(
    name = "publisher_bin",
    main_module = "devinfra.pr_visuals.publisher",
    deps = [":publisher"],
)

py_test(
    name = "test_publisher",
    srcs = ["test_publisher.py"],
    deps = [
        ":publisher",
        ":pull_request",
        "//:conftest",
        "//devinfra/ci:invocation_ids",
        "//util:visual_review",
        "@pypi//botocore",
        "@pypi//pillow",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

filegroup(
    name = "gallery_visual_harness",
    testonly = True,
    srcs = ["gallery_harness/gallery_harness.js"],
)

py_visual_test(
    name = "test_gallery_visual",
    size = "medium",
    assets = ["gallery_harness/index.html"],
    harness = ":gallery_visual_harness",
    test_deps = [
        ":publisher",
        "//util:playwright",
        "//util/testing:viewports",
        "//util/testing:visual_capture",
        "@pypi//pillow",
        "@pypi//playwright",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
    test_module = "devinfra.pr_visuals.test_gallery_visual",
    test_srcs = ["test_gallery_visual.py"],
    title = "PR visual gallery",
)

py_library(
    name = "pull_request",
    srcs = ["pull_request.py"],
    deps = [
        "@pypi//more_itertools",
        "@pypi//pygithub",
    ],
)

py_test(
    name = "test_pull_request",
    srcs = ["test_pull_request.py"],
    deps = [
        ":pull_request",
        "//:conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

# Keep this wheel limited to the publisher's import closure. The internal helper
# modules are included here rather than making the release depend on another
# ducktape wheel.
py_package(
    name = "pr_visuals_pkg",
    packages = [
        "devinfra.ci",
        "devinfra.pr_visuals",
        "util",
    ],
    deps = [":publisher"],
)

py_wheel(
    name = "wheel",
    distribution = "pr_visuals",
    entry_points = {
        "console_scripts": [
            "pr-visuals-announce = devinfra.pr_visuals.check_run:main",
            "pr-visuals-publish = devinfra.pr_visuals.publisher:main",
        ],
    },
    python_requires = ">=3.14",
    # SYNC: Keep this list aligned with the runtime dependencies of publisher
    # and nix/packages/default.nix (pr-visuals) when Nix packaging is enabled.
    requires = [
        "boto3",
        "botocore",
        "jinja2",
        "more-itertools",
        "Pillow",
        "pydantic>=2.0",
        "PyGithub",
        "tenacity",
    ],
    version = "0.1.0",
    visibility = ["//visibility:public"],
    deps = [":pr_visuals_pkg"],
)

py_test(
    name = "test_wheel",
    srcs = ["test_wheel.py"],
    data = [":wheel"],
    deps = [
        "//:conftest",
        "//devinfra/pr_visuals:publisher",
        "//util/bazel:runfiles",
        "@pypi//pytest_bazel",
    ],
)
