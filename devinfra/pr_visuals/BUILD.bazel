# Keep this wheel limited to the publisher's import closure. The internal helper
# modules are included here rather than making the release depend on another
# ducktape wheel.
py_package(
    name = "pr_visuals_pkg",
    packages = [
        "devinfra.buildbuddy.ci",
        "devinfra.pr_visuals",
        "devinfra.testing",
    ],
    deps = [":publisher"],
)

py_wheel(
    name = "wheel",
    distribution = "pr_visuals",
    entry_points = {
        "console_scripts": [
            "pr-visuals-announce = devinfra.pr_visuals.check_run:main",
            "pr-visuals-publish = devinfra.pr_visuals.publisher:main",
        ],
    },
    python_requires = ">=3.14",
    # SYNC: Keep this list aligned with the runtime dependencies of publisher
    # and nix/packages/default.nix (pr-visuals) when Nix packaging is enabled.
    requires = [
        "boto3",
        "botocore",
        "jinja2",
        "more-itertools",
        "Pillow",
        "pydantic>=2.0",
        "PyGithub",
    ],
    version = "0.1.0",
    visibility = ["//visibility:public"],
    deps = [":pr_visuals_pkg"],
)

py_test(
    name = "test_wheel",
    srcs = ["test_wheel.py"],
    data = [
        "wheel_render_probe.py",
        ":wheel",
    ],
    env = {"PR_VISUALS_WHEEL_RLOCATION": "$(rlocationpath :wheel)"},
    deps = [
        "//:conftest",
        "//devinfra/pr_visuals:publisher",
        "@pypi//pytest_bazel",
        "@rules_python//python/runfiles",
