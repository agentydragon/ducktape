{% macro image(url, alt, table=false) -%}
<a href="{{ url | e }}"><img src="{{ url | e }}" width="260" alt="{{ (alt | replace('|', '\\|') if table else alt) | e }}"></a>
{%- endmacro %}

{% macro asset_body(item, include_heading) -%}
