| --- | --- | --- |
| {{ image(item.urls.baseline_url, asset.label ~ ' baseline', true) }} | {{ image(item.urls.candidate_url, asset.label ~ ' candidate', true) }} | {% if asset.dimension_changed %}_(dimensions changed)_{% else %}{{ image(item.urls.diff_url, asset.label ~ ' diff', true) }}{% endif %} |
{% elif asset.classification == 'new' %}
{{ image(item.urls.candidate_url, asset.label) }}
{% elif asset.classification == 'removed' %}
{{ image(item.urls.baseline_url, asset.label ~ ' baseline') }}
