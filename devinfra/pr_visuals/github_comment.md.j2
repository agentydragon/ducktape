{% if include_heading %}
<p><strong><a href="{{ item.anchor | e }}">{{ asset.label | e }}</a></strong>{% if asset.classification == 'unstable' %} · unstable across runs{% elif asset.classification == 'modified' %} · {{ '%.1f' | format((asset.changed_fraction or 0) * 100) }}% changed{% if asset.baseline_stale %} · {{ stale_warning(item.test) }}{% endif %}{% elif asset.classification == 'new' %} · new{% elif asset.classification == 'removed' %} · removed{% if asset.baseline_stale %} · {{ stale_warning(item.test) }}{% endif %}{% endif %}</p>

{% elif asset.baseline_stale and asset.classification != 'unstable' %}
<p>{{ stale_warning(item.test) }}</p>

{% endif %}
{% if asset.classification == 'unstable' %}
{% for variant in item.urls.variants %}
- {{ image(variant.url, asset.label) }}
