{% macro issue(issue) -%}
{{ issue.message | e }}{% if issue.source %} ({{ 'shard' if issue.source.shards | length == 1 else 'shards' }} {{ issue.source.shards | shard_ranges }} · run {{ issue.source.run or 'unknown' }} · attempt {{ issue.source.attempt or 'unknown' }}{% if issue.source.configuration %} · config {{ issue.source.configuration[:8] | e }}{% endif %}) · <a href="{{ issue.source.invocation | buildbuddy_url | e }}">BuildBuddy</a>{% endif %}
