{% macro counts(test) -%}
{% set counts = test.summary %}
{% set entries = [] %}
{% if counts %}
{% for value, label in [(counts.unstable, 'unstable'), (counts.modified, 'modified'), (counts.new, 'new'), (counts.removed, 'removed')] %}
{% if value %}{% set _ = entries.append(value ~ ' ' ~ label) %}{% endif %}
{% endfor %}
{% endif %}
{% if test.issues %}incomplete or non-comparable{% if entries %}; {% endif %}{% endif %}{{ entries | join(', ') if entries else ('unchanged' if not test.issues else '') }}
{%- endmacro %}

{% macro stale_warning(test) -%}
⚠️ stale baseline ({% if test.base_sha %}`{{ test.base_sha[:8] | e }}`{% else %}an unavailable commit{% endif %}, not merge base {% if test.merge_base_sha %}`{{ test.merge_base_sha[:8] | e }}`{% else %}the merge base{% endif %})
