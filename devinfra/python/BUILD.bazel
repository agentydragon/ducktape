load("@aspect_rules_py//py:defs.bzl", "py_layer_tier")
load("@rules_python//python/entry_points:py_console_script_binary.bzl", "py_console_script_binary")
load("//devinfra/python:defs.bzl", "py_binary")

package(default_visibility = ["//visibility:public"])

py_layer_tier(
    name = "layer_tier_1000",
    group = "1000",
    owner = "1000",
)

py_layer_tier(
    name = "layer_tier_65532",
    group = "65532",
    owner = "65532",
)

py_layer_tier(
    name = "layer_tier_65534",
    group = "65534",
    owner = "65534",
)

# The generator behind //devinfra/python:grpc.bzl. Not ours to lint: `protoc` runs a wheel's
# module and the plugins are entry-point scripts rules_python generates.
py_binary(
    name = "protoc",
    main_module = "grpc_tools.protoc",
    tags = [
        "no-lint",
        "no-mypy",
    ],
    deps = ["@pypi//grpcio_tools"],
)

py_console_script_binary(
    name = "protoc_gen_mypy",
    pkg = "@pypi//mypy_protobuf",
    script = "protoc-gen-mypy",
    tags = [
        "no-lint",
        "no-mypy",
    ],
)

py_console_script_binary(
    name = "protoc_gen_mypy_grpc",
    pkg = "@pypi//mypy_protobuf",
    script = "protoc-gen-mypy_grpc",
    tags = [
        "no-lint",
        "no-mypy",
    ],
)
