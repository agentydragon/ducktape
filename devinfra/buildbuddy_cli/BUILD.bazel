load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "bbapi_lib",
    srcs = [
        "client.go",
        "cmd_artifact.go",
        "cmd_ask.go",
        "cmd_cache.go",
        "cmd_execution.go",
        "cmd_invocation.go",
        "cmd_target.go",
        "cmd_tool_log.go",
        "cmd_trend.go",
        "cmd_workflow.go",
        "git.go",
        "main.go",
        "table.go",
    ],
    importpath = "github.com/agentydragon/ducktape/devinfra/buildbuddy_cli",
    deps = [
        "@buildbuddy_protos//:build_event_stream_go_proto",
        "@buildbuddy_protos//:cache_go_proto",
        "@buildbuddy_protos//:context_go_proto",
        "@buildbuddy_protos//:execution_stats_go_proto",
        "@buildbuddy_protos//:invocation_go_proto",
        "@buildbuddy_protos//:remote_execution_go_proto",
        "@buildbuddy_protos//:resource_go_proto",
        "@buildbuddy_protos//:stats_go_proto",
        "@buildbuddy_protos//:suggestion_go_proto",
        "@buildbuddy_protos//:target_go_proto",
        "@buildbuddy_protos//:workflow_go_proto",
        "@com_github_dustin_go_humanize//:go-humanize",
        "@com_github_go_git_go_git_v5//:go-git",
        "@com_github_spf13_cobra//:cobra",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

go_binary(
    name = "bbapi",
    embed = [":bbapi_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "bbapi_test",
    srcs = ["helpers_test.go"],
    embed = [":bbapi_lib"],
)
