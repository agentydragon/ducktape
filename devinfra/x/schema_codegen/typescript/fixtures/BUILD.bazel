package(default_visibility = ["//devinfra/x/schema_codegen/typescript:__pkg__"])

genrule(
    name = "external_model_artifact",
    srcs = ["external_model.json"],
    outs = ["generated/external_model.json"],
    cmd = "mkdir -p $(RULEDIR)/generated && cp $(location external_model.json) $(RULEDIR)/generated/external_model.json",
)

genrule(
    name = "openapi_artifact",
    srcs = ["openapi.json"],
    outs = ["generated/openapi.json"],
    cmd = "mkdir -p $(RULEDIR)/generated && cp $(location openapi.json) $(RULEDIR)/generated/openapi.json",
)

genrule(
    name = "standalone_artifact",
    srcs = ["standalone.json"],
    outs = ["generated/standalone.json"],
    cmd = "mkdir -p $(RULEDIR)/generated && cp $(location standalone.json) $(RULEDIR)/generated/standalone.json",
)

genrule(
    name = "openapi_config_artifact",
    srcs = ["openapi-ts.config.mjs"],
    outs = ["generated/openapi-ts.config.mjs"],
    cmd = "mkdir -p $(RULEDIR)/generated && cp $(location openapi-ts.config.mjs) $(RULEDIR)/generated/openapi-ts.config.mjs",
)
