load("@rules_python//python:packaging.bzl", "py_package", "py_wheel")
load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

py_library(
    name = "statusline",
    srcs = ["statusline.py"],
    visibility = ["//visibility:public"],
    deps = [
        "//aiquota:cache",
        "//aiquota:config",
        "//aiquota:models",
        "//aiquota/render:format_lib",
        "//devinfra/claude:session_paths",
        "//devinfra/claude/claude_api:credentials",
        "//devinfra/claude/claude_api:statusline",
        "@pypi//rich",
    ],
)

py_binary(
    name = "statusline_bin",
    main_module = "devinfra.claude.statusline.statusline",
    visibility = ["//visibility:public"],
    deps = [":statusline"],
)

py_package(
    name = "claude_statusline_pkg",
    packages = ["devinfra.claude.statusline"],
    deps = [":statusline"],
)

py_wheel(
    name = "claude_statusline_wheel",
    distribution = "claude_statusline",
    entry_points = {
        "console_scripts": [
            "claude-statusline = devinfra.claude.statusline.statusline:main",
        ],
    },
    python_requires = ">=3.14",
    # SYNC: This list must match propagatedBuildInputs in nix/packages/default.nix
    # (claude-statusline). Nix provides these at runtime on NixOS/devShell.
    # When adding a dependency, update BOTH places.
    #
    # `aiquota` and `ducktape-claude-api` are local artifact-pinned wheels. Nix
    # provides both through propagatedBuildInputs.
    requires = [
        "aiquota",
        "ducktape-claude-api",
        "httpx",
        "platformdirs",
        "pydantic>=2.0",
        "rich",
    ],
    version = "0.1.0",
    visibility = ["//visibility:public"],
    deps = [
        ":claude_statusline_pkg",
        # Pack only this parent-package module; selecting `devinfra.claude` in
        # py_package would also include the nested claude_api package.
        "//devinfra/claude:session_paths",
    ],
)

py_test(
    name = "test_statusline",
    srcs = ["test_statusline.py"],
    data = ["__snapshots__/test_statusline.ambr"],
    uses_syrupy = True,
    deps = [
        ":statusline",
        "//:conftest",
        "//aiquota:models",
        "//devinfra/claude:conftest",
        "//devinfra/claude/claude_api:credentials",
        "//devinfra/claude/claude_api:statusline",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//syrupy",
    ],
)
