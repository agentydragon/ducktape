load("@rules_python//python:packaging.bzl", "py_package", "py_wheel")
load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

py_library(
    name = "statusline",
    srcs = ["statusline.py"],
    visibility = ["//visibility:public"],
    deps = [
        "//aiquota:cache",
        "//aiquota:config",
        "//aiquota:models",
        "//aiquota/render:format_lib",
        "//devinfra/claude:session_paths",
        "//devinfra/claude/claude_api:credentials",
        "//devinfra/claude/claude_api:statusline",
        "@pypi//rich",
    ],
)

py_binary(
    name = "statusline_bin",
    main_module = "devinfra.claude.statusline.statusline",
    visibility = ["//visibility:public"],
    deps = [":statusline"],
)

py_package(
    name = "claude_statusline_pkg",
    packages = [
        "devinfra.claude",
        "devinfra.claude.claude_api",
        "devinfra.claude.claude_api.hooks",
        "devinfra.claude.statusline",
    ],
    deps = [":statusline"],
)

py_wheel(
    name = "claude_statusline_wheel",
    distribution = "claude_statusline",
    entry_points = {
        "console_scripts": [
            "claude-statusline = devinfra.claude.statusline.statusline:main",
        ],
    },
    python_requires = ">=3.13",
    # SYNC: This list must match propagatedBuildInputs in nix/packages/default.nix
    # (claude-statusline). Nix provides these at runtime on NixOS/devShell.
    # When adding a dependency, update BOTH places.
    #
    # `aiquota` is the local artifact-pinned wheel (not on PyPI); the statusline
    # imports it for quota data. Nix provides it via the aiquota derivation in
    # propagatedBuildInputs (which also brings typer/atomicwrites transitively).
    requires = [
        "aiquota",
        "httpx",
        "platformdirs",
        "pydantic>=2.0",
        "rich",
    ],
    version = "0.1.0",
    visibility = ["//visibility:public"],
    deps = [":claude_statusline_pkg"],
)

py_test(
    name = "test_statusline",
    srcs = ["test_statusline.py"],
    data = ["__snapshots__/test_statusline.ambr"],
    uses_syrupy = True,
    deps = [
        ":statusline",
        "//:conftest",
        "//aiquota:models",
        "//devinfra/claude:conftest",
        "//devinfra/claude/claude_api:credentials",
        "//devinfra/claude/claude_api:statusline",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//syrupy",
    ],
)
