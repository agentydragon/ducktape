load("@rules_oci//oci:defs.bzl", "oci_image")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files", "strip_prefix")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//devinfra/oci:defs.bzl", "oci_layout_rloc")
load("//devinfra/python:defs.bzl", "py_library", "py_test")

# Apt manifest + lockfile for rules_distroless (referenced from MODULE.bazel).
exports_files([
    "trixie_e2e.yaml",
    "trixie_e2e.lock.json",
])

# Bazelisk + sops baked into /tools/ (on PATH). Neither is in Debian main,
# so we fetch them as static binaries via http_file.
pkg_tar(
    name = "e2e_tools",
    testonly = True,
    srcs = [
        "@bazelisk_linux_amd64//file",
        "@sops_linux_amd64//file",
    ],
    package_dir = "/tools",
    remap_paths = {
        "/file/bazelisk": "bazelisk",
        "/file/sops": "sops",
    },
)

pkg_files(
    name = "pyyaml_site_packages_files",
    testonly = True,
    srcs = ["@pypi//pyyaml:pkg"],
    prefix = "/usr/local/lib/python3.13",
    strip_prefix = strip_prefix.from_pkg(),
)

pkg_tar(
    name = "pyyaml_site_packages",
    testonly = True,
    srcs = [":pyyaml_site_packages_files"],
)

pkg_files(
    name = "bazelisk_bazel_8_6_0_binary",
    testonly = True,
    srcs = ["@bazel_8_6_0_linux_amd64//file"],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "/root/.cache/bazelisk/downloads/sha256/9860da9c9386bbc023feed8f43af3105d338727d77b644fa6aeca45a4a11957c/bin",
    renames = {"@bazel_8_6_0_linux_amd64//file": "bazel"},
    strip_prefix = strip_prefix.files_only(),
)

pkg_files(
    name = "bazelisk_bazel_8_6_0_metadata",
    testonly = True,
    srcs = ["bazelisk-bazel-8.6.0-linux-x86_64.metadata"],
    prefix = "/root/.cache/bazelisk/downloads/metadata/bazelbuild",
    renames = {"bazelisk-bazel-8.6.0-linux-x86_64.metadata": "bazel-8.6.0-linux-x86_64"},
    strip_prefix = strip_prefix.files_only(),
)

pkg_tar(
    name = "bazelisk_cache",
    testonly = True,
    srcs = [
        ":bazelisk_bazel_8_6_0_binary",
        ":bazelisk_bazel_8_6_0_metadata",
    ],
)

# E2E test container: python:3.13-slim base + curl + git + JDK from trixie,
# bazelisk + sops as static binaries. See trixie_e2e.yaml.
oci_image(
    name = "e2e_container_image",
    testonly = True,
    base = "@python_3_13_slim_linux_amd64",
    env = {
        "BAZELISK_HOME": "/root/.cache/bazelisk",
        "PATH": "/tools:/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin",
    },
    tars = [
        "@trixie_e2e//:flat",
        ":e2e_tools",
        ":pyyaml_site_packages",
        ":bazelisk_cache",
    ],
)

oci_layout_rloc(
    name = "e2e_container",
    testonly = True,
    image = ":e2e_container_image",
    visibility = ["//devinfra/claude:__subpackages__"],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    deps = ["//devinfra/claude/testing:container_e2e"],
)

py_test(
    name = "test_container_e2e",
    size = "medium",
    srcs = ["test_container_e2e.py"],
    data = [
        "test_profile.yaml",
        ":e2e_container",
        "//devinfra/claude/claude_hook",
        "//devinfra/claude/claude_hook/testdata/e2e_secrets:e2e_secrets_files",
        "//devinfra/claude/testdata/test_workspace:workspace_files",
        "//devinfra/k8s:kubeconfig.py",
        "//devinfra/secrets:_common.sh",
        "//devinfra/secrets:web_env.sh",
    ],
    requires_docker = True,
    tags = [
        "e2e",
    ],
    deps = [
        ":conftest",
        "//:conftest",
        "//devinfra/claude:conftest",
        "//devinfra/claude:env_file",
        "//devinfra/claude/claude_hook:conftest",
        "//devinfra/claude/testing:container_e2e",
        "//util/bazel:runfiles",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//pyyaml",
    ],
)
