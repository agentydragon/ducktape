load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

py_library(
    name = "manifest",
    srcs = ["manifest.py"],
    data = ["//devinfra/claude/web_env:exclusions.yaml"],
    deps = [
        "@pypi//pydantic",
        "@pypi//pyyaml",
        "@rules_python//python/runfiles",
    ],
)

py_library(
    name = "capture_manifest",
    srcs = ["capture_manifest.py"],
    deps = [":manifest"],
)

py_binary(
    name = "capture_manifest_bin",
    main_module = "devinfra.claude.web_env.tools.capture_manifest",
    deps = [":capture_manifest"],
)

py_library(
    name = "capture_versions",
    srcs = ["capture_versions.py"],
)

py_binary(
    name = "capture_versions_bin",
    main_module = "devinfra.claude.web_env.tools.capture_versions",
    deps = [":capture_versions"],
)

py_library(
    name = "diff_manifests",
    srcs = ["diff_manifests.py"],
    deps = [
        ":manifest",
        "@pypi//pydantic",
    ],
)

py_binary(
    name = "diff_manifests_bin",
    main_module = "devinfra.claude.web_env.tools.diff_manifests",
    deps = [":diff_manifests"],
)

py_library(
    name = "fetch_debs",
    srcs = ["fetch_debs.py"],
    deps = [
        "//devinfra/bazel:workspace",
        "@pypi//requests",
        "@pypi//urllib3",  # keep: mypy checks requests stubs' transitive imports
    ],
)

py_binary(
    name = "fetch_debs_bin",
    main_module = "devinfra.claude.web_env.tools.fetch_debs",
    deps = [":fetch_debs"],
)

py_library(
    name = "build_and_diff",
    srcs = ["build_and_diff.py"],
    deps = [
        ":capture_manifest",
        ":capture_versions",
        ":diff_manifests",
        ":fetch_debs",
        ":manifest",
        "//devinfra/bazel:workspace",
    ],
)

py_binary(
    name = "build_and_diff_bin",
    main_module = "devinfra.claude.web_env.tools.build_and_diff",
    deps = [":build_and_diff"],
)

py_test(
    name = "build_and_diff_test",
    srcs = ["build_and_diff_test.py"],
    requires_docker = True,
    deps = [
        ":build_and_diff",
        "//:conftest",
        "//devinfra/claude:conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
