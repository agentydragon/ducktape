load("@aspect_rules_py//py:defs.bzl", "py_image_layer", aspect_py_binary = "py_binary")
load("@rules_oci//oci:defs.bzl", "oci_image")
load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")
load("//props:oci.bzl", "py_image_entrypoint", "py_image_env")

# gazelle:resolve py httpx_sse @pypi//httpx_sse

py_library(
    name = "api",
    srcs = ["api.py"],
    deps = [
        ":failures",
        ":models",
        ":oauth",
        "@pypi//httpx",
        "@pypi//httpx_sse",
        "@pypi//more_itertools",
        "@pypi//pydantic",
        "@pypi//tenacity",
    ],
)

py_library(
    name = "archive",
    srcs = ["archive.py"],
    deps = [
        ":api",
        ":models",
        ":progress",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "export_sessions",
    srcs = ["export_sessions.py"],
    # The page's bundle rides with the CLI that serves it; the OpenAPI exporter the bundle's types come from
    # imports `:web`, which stays free of it.
    data = ["//devinfra/claude/session_export/frontend:bundle"],
    deps = [
        ":api",
        ":archive",
        ":database_migrate",
        ":models",
        ":oauth",
        ":probe",
        ":settings",
        ":store",
        ":supervisor",
        ":sync",
        ":web",
        "//util/bazel:workspace",
        "@pypi//httpx",
        "@pypi//uvicorn",
    ],
)

# Prints the OpenAPI schema; the frontend's js_openapi_schema runs it to generate types.
py_binary(
    name = "export_schema_bin",
    main_module = "devinfra.claude.session_export.export_schema",
    visibility = ["//devinfra/claude/session_export/frontend:__pkg__"],
    deps = [":export_schema"],
)

py_binary(
    name = "export_sessions_bin",
    main_module = "devinfra.claude.session_export.export_sessions",
    deps = [":export_sessions"],
)

aspect_py_binary(
    name = "export_sessions_image_bin",
    main = "export_sessions.py",
    deps = [":export_sessions"],
)

py_image_layer(
    name = "image_layers",
    binary = ":export_sessions_image_bin",
    group = "1000",
    owner = "1000",
)

oci_image(
    name = "image",
    base = "@debian_trixie_slim_linux_amd64",
    entrypoint = py_image_entrypoint("export_sessions_image_bin"),
    env = py_image_env(binary_name = "export_sessions_image_bin"),
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [":image_layers"],
    user = "1000:1000",
    visibility = ["//visibility:public"],
)

py_library(
    name = "models",
    srcs = ["models.py"],
    deps = ["@pypi//pydantic"],
)

