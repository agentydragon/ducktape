load("@aspect_rules_py//py:defs.bzl", "py_image_layer", aspect_py_binary = "py_binary")
load("@rules_oci//oci:defs.bzl", "oci_image")
load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")
load("//props:oci.bzl", "py_image_entrypoint", "py_image_env")

py_library(
    name = "api",
    srcs = ["api.py"],
    deps = [
        ":models",
        ":oauth",
        "@pypi//httpx",
        "@pypi//pydantic",
        "@pypi//tenacity",
    ],
)

py_library(
    name = "archive",
    srcs = ["archive.py"],
    deps = [
        ":api",
        ":models",
        ":progress",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "export_sessions",
    srcs = ["export_sessions.py"],
    visibility = ["//cluster/cdk8s/claude_session_sync:__pkg__"],
    deps = [
        ":api",
        ":archive",
        ":database_migrate",
        ":models",
        ":oauth",
        ":store",
        ":sync",
        "//util/bazel:workspace",
        "@pypi//httpx",
        "@pypi//pydantic_settings",
    ],
)

py_binary(
    name = "export_sessions_bin",
    main_module = "devinfra.claude.session_export.export_sessions",
    deps = [":export_sessions"],
)

aspect_py_binary(
    name = "export_sessions_image_bin",
    main = "export_sessions.py",
    deps = [":export_sessions"],
)

py_image_layer(
    name = "image_layers",
    binary = ":export_sessions_image_bin",
    group = "1000",
    owner = "1000",
)

oci_image(
    name = "image",
    base = "@debian_trixie_slim_linux_amd64",
    entrypoint = py_image_entrypoint("export_sessions_image_bin"),
    env = py_image_env(binary_name = "export_sessions_image_bin"),
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [":image_layers"],
    user = "1000:1000",
    visibility = ["//visibility:public"],
)

py_library(
    name = "models",
    srcs = ["models.py"],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    deps = [
        ":api",
        ":database_migrate",
        ":models",
        ":oauth",
        ":store",
        "//util/testing:postgres",
        "//util/testing:postgres_fixtures",
        "@pypi//httpx",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//sqlalchemy",
        "@pypi//tenacity",
        "@pypi//testcontainers",
    ],
)

py_test(
    name = "test_api",
    srcs = ["test_api.py"],
    deps = [
        ":api",
        ":conftest",
        ":oauth",
        "//:conftest",
        "//devinfra/claude:conftest",
        "@pypi//httpx",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//tenacity",
    ],
)

py_test(
    name = "test_archive",
    srcs = ["test_archive.py"],
    deps = [
        ":api",
        ":archive",
        ":conftest",
        ":progress",
        "//:conftest",
        "//devinfra/claude:conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "oauth",
    srcs = ["oauth.py"],
    deps = [
        "//devinfra/claude/claude_api:oauth_client",
        "@pypi//httpx",
        "@pypi//pydantic",
        "@pypi//tenacity",
    ],
)

py_test(
    name = "test_oauth",
    srcs = ["test_oauth.py"],
    deps = [
        ":conftest",
        ":oauth",
        "//:conftest",
        "//devinfra/claude:conftest",
        "//devinfra/claude/claude_api:oauth_client",
        "@pypi//httpx",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "database_migrate",
    srcs = ["database_migrate.py"],
    data = ["//devinfra/claude/session_export/migrations:files"],
    deps = [
        ":store",
        "//util:db_migrations",
    ],
)

py_library(
    name = "progress",
    srcs = ["progress.py"],
)

py_library(
    name = "store",
    srcs = ["store.py"],
    visibility = ["//devinfra/claude/session_export/migrations:__pkg__"],
    deps = [
        ":models",
        "@pypi//asyncpg",
        "@pypi//sqlalchemy",
    ],
)

py_library(
    name = "sync",
    srcs = ["sync.py"],
    deps = [
        ":api",
        ":models",
        ":progress",
        ":store",
    ],
)

py_test(
    name = "test_store",
    srcs = ["test_store.py"],
    deps = [
        ":conftest",
        ":store",
        "//:conftest",
        "//devinfra/claude:conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_sync",
    size = "medium",
    srcs = ["test_sync.py"],
    requires_docker = True,
    deps = [
        ":api",
        ":conftest",
        ":models",
        ":store",
        ":sync",
        "//:conftest",
        "//devinfra/claude:conftest",
        "@pypi//alembic",
        "@pypi//httpx",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//sqlalchemy",
    ],
)
