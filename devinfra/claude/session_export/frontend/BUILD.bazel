vitest_config(
    name = "vitest_config",
    # Specs that need a DOM opt in with `// @vitest-environment happy-dom`.
    data = ["//:node_modules/happy-dom"],
    environment = "node",
)

# The screenshot harness mounts the full app with deterministic API fixtures. CI publishes
# the desktop, dark, and narrow captures on the PR visual-review page.
ts_library(
    name = "visual_harness_lib",
    testonly = True,
    srcs = ["harness/harness.tsx"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [
        ":api",
        ":app",
        ":noisy_session_fixture",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/@types/react-dom",
        "//:node_modules/react",
        "//:node_modules/react-dom",
    ],
)

esbuild(
    name = "visual_harness_bundle",
    testonly = True,
    config = {"jsx": "automatic"},
    entry_point = "harness/harness.tsx",
    format = "iife",
    minify = False,
    output = "harness/dist/harness.js",
    output_css = "harness/dist/harness.css",
    platform = "browser",
    sourcemap = "linked",
    target = ["es2022"],
    deps = [":visual_harness_lib"],
)

filegroup(
    name = "visual_harness_js",
    testonly = True,
    srcs = ["harness/dist/harness.js"],
)

filegroup(
    name = "visual_harness_css",
    testonly = True,
    srcs = ["harness/dist/harness.css"],
)

py_visual_test(
    name = "visual",
    # Browser startup plus 11–12 captures per shard can exceed small's 60-second budget on RBE.
    size = "medium",
    assets = [
        "harness/index.html",
        ":visual_harness_css",
    ],
    harness = ":visual_harness_js",
    shard_count = 4,
    test_deps = [
        "//util/testing:page_capture",
        "//util/testing:viewports",
        "//util/testing:visual_capture",
        "@pypi//playwright",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",
        "@pypi//pytest_bazel",
    ],
    test_module = "devinfra.claude.session_export.frontend.test_visual",
    test_srcs = ["test_visual.py"],
    title = "Claude session sync",
)

check_vitest_specs()
