load("@aspect_rules_esbuild//esbuild:defs.bzl", "esbuild")
load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config")
load("//devinfra/js:openapi.bzl", "js_openapi_schema")
load("//devinfra/js:spa_bundle.bzl", "spa_bundle")
load("//devinfra/js:ts_library.bzl", "ts_library")
load("//devinfra/js:vitest.bzl", "check_vitest_specs", "vitest_config")
load("//util/testing/frontend_visual:visual_test.bzl", "visual_test")
load(":vitest.bzl", "session_export_vitest_test")

package(default_visibility = ["//devinfra/claude/session_export:__pkg__"])

TSCONFIG = ":tsconfig"

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
)

# Wire types generated from the API's own OpenAPI document, so the page's idea of a status is the
# Pydantic model rather than a hand-kept copy. Not checked in.
js_openapi_schema(
    name = "schema",
    generator = "//devinfra/claude/session_export:export_schema_bin",
)

ts_library(
    name = "status",
    srcs = ["status.ts"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
)

ts_library(
    name = "api",
    srcs = ["api.ts"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [":schema"],
)

ts_library(
    name = "overview",
    srcs = ["overview.tsx"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [
        ":api",
        ":status",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/react",
    ],
)

ts_library(
    name = "pairing",
    srcs = ["pairing.tsx"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [
        ":api",
        ":status",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/react",
    ],
)

ts_library(
    name = "app",
    srcs = ["app.tsx"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [
        ":api",
        ":overview",
        ":pairing",
        ":viewer",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/react",
    ],
)

ts_library(
    name = "transcript",
    srcs = ["transcript.ts"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [
        ":api",
        ":narration",
    ],
)

ts_library(
    name = "narration",
    srcs = ["narration.ts"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
)

ts_library(
    name = "tool_groups",
    srcs = ["tool-groups.ts"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [
        ":api",
        ":transcript",
    ],
)

ts_library(
    name = "event_inspector",
    srcs = ["event-inspector.tsx"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [
        ":api",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/react",
    ],
)

ts_library(
    name = "event_timeline",
    srcs = ["event-timeline.tsx"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [
        ":api",
        ":event_inspector",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/react",
    ],
)

ts_library(
    name = "viewer",
    srcs = ["viewer.tsx"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [
        ":api",
        ":event_inspector",
        ":event_timeline",
        ":tool_groups",
        ":transcript",
        "//:node_modules/@mantine/core",
        "//:node_modules/@mantine/hooks",
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//agentplane/app/frontend:markdown",
    ],
)

ts_library(
    name = "main",
    srcs = ["main.tsx"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [
        ":app",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/@types/react-dom",
        "//:node_modules/react",
        "//:node_modules/react-dom",
    ],
)

spa_bundle(
    name = "bundle",
    entry_point = "main.tsx",
    jsx = "automatic",
    deps = [
        ":main",
    ],
)

# ── Unit tests ─────────────────────────────────────────────────────────────────

session_export_vitest_test(
    name = "status_test",
    srcs = ["status.test.ts"],
    isolated_typecheck = True,
    deps = [
        ":status",
        "//:node_modules/vitest",
    ],
)

session_export_vitest_test(
    name = "transcript_test",
    srcs = ["transcript.test.ts"],
    isolated_typecheck = True,
    deps = [
        ":api",
        ":transcript",
        "//:node_modules/vitest",
    ],
)

session_export_vitest_test(
    name = "narration_test",
    srcs = ["narration.test.ts"],
    isolated_typecheck = True,
    deps = [
        ":narration",
        "//:node_modules/vitest",
    ],
)

session_export_vitest_test(
    name = "api_test",
    srcs = ["api.test.ts"],
    isolated_typecheck = True,
    deps = [
        ":api",
        "//:node_modules/vitest",
    ],
)

ts_library(
    name = "noisy_session_fixture",
    testonly = True,
    srcs = ["fixtures/noisy-session.ts"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [":api"],
)

session_export_vitest_test(
    name = "viewer_test",
    srcs = ["viewer.test.tsx"],
    isolated_typecheck = True,
    deps = [
        ":api",
        ":noisy_session_fixture",
        ":viewer",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/@types/react-dom",
        "//:node_modules/react",
        "//:node_modules/react-dom",
        "//:node_modules/vitest",
    ],
)

session_export_vitest_test(
    name = "tool_groups_test",
    srcs = ["tool-groups.test.ts"],
    isolated_typecheck = True,
    deps = [
        ":noisy_session_fixture",
        ":tool_groups",
        ":transcript",
        "//:node_modules/vitest",
    ],
)

session_export_vitest_test(
    name = "event_timeline_test",
    srcs = ["event-timeline.test.tsx"],
    isolated_typecheck = True,
    deps = [
        ":api",
        ":event_timeline",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/@types/react-dom",
        "//:node_modules/react",
        "//:node_modules/react-dom",
        "//:node_modules/vitest",
    ],
)

vitest_config(
    name = "vitest_config",
    # Specs that need a DOM opt in with `// @vitest-environment happy-dom`.
    data = ["//:node_modules/happy-dom"],
    environment = "node",
)

# The screenshot harness mounts the full app with deterministic API fixtures. CI publishes
# the desktop, dark, and narrow captures on the PR visual-review page.
js_library(
    name = "visual_scenarios",
    testonly = True,
    srcs = ["visual/scenarios.mjs"],
)

ts_library(
    name = "visual_harness_lib",
    testonly = True,
    srcs = ["visual/harness.tsx"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [
        ":api",
        ":app",
        ":noisy_session_fixture",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/@types/react-dom",
        "//:node_modules/react",
        "//:node_modules/react-dom",
    ],
)

esbuild(
    name = "visual_harness_bundle",
    testonly = True,
    config = {"jsx": "automatic"},
    entry_point = "visual/harness.tsx",
    format = "iife",
    minify = False,
    output = "visual/dist/harness.js",
    output_css = "visual/dist/harness.css",
    platform = "browser",
    sourcemap = "linked",
    target = ["es2022"],
    deps = [":visual_harness_lib"],
)

filegroup(
    name = "visual_harness_js",
    testonly = True,
    srcs = ["visual/dist/harness.js"],
)

filegroup(
    name = "visual_harness_css",
    testonly = True,
    srcs = ["visual/dist/harness.css"],
)

visual_test(
    name = "visual",
    size = "small",
    assets = [
        "visual/index.html",
        ":visual_harness_css",
    ],
    entry_point = "visual/runner.mjs",
    env = {"TZ": "UTC"},
    harness = ":visual_harness_js",
    scenarios = ":visual_scenarios",
    shard_count = 2,
)

check_vitest_specs()
