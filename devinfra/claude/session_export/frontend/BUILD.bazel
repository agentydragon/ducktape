ts_library(
    name = "transcript",
    srcs = ["transcript.ts"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [
        ":api",
        ":narration",
    ],
)

ts_library(
    name = "narration",
    srcs = ["narration.ts"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
