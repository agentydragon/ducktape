load("@aspect_rules_esbuild//esbuild:defs.bzl", "esbuild")
load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config")
load("@npm_ducktape//:vitest/package_json.bzl", vitest_bin = "bin")
load("//devinfra/js:openapi.bzl", "js_openapi_schema")
load("//devinfra/js:spa_bundle.bzl", "spa_bundle")
load("//devinfra/js:ts_library.bzl", "ts_library")
load("//util/testing/frontend_visual:visual_test.bzl", "visual_test")

package(default_visibility = ["//devinfra/claude/session_export:__pkg__"])

TSCONFIG = ":tsconfig"

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
)

# Wire types generated from the API's own OpenAPI document, so the page's idea of a status is the
# Pydantic model rather than a hand-kept copy. Not checked in.
js_openapi_schema(
    name = "schema",
    generator = "//devinfra/claude/session_export:export_schema_bin",
)

ts_library(
    name = "status",
    srcs = ["status.ts"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
)

ts_library(
    name = "api",
    srcs = ["api.ts"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [":schema"],
)

ts_library(
    name = "overview",
    srcs = ["overview.tsx"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [
        ":api",
        ":status",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/react",
    ],
)

ts_library(
    name = "pairing",
    srcs = ["pairing.tsx"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [
        ":api",
        ":status",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/react",
    ],
)

ts_library(
    name = "app",
    srcs = ["app.tsx"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [
        ":api",
        ":overview",
        ":pairing",
        ":viewer",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/react",
    ],
)

ts_library(
    name = "transcript",
    srcs = ["transcript.ts"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [":api"],
)

ts_library(
    name = "viewer",
    srcs = ["viewer.tsx"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [
        ":api",
        ":transcript",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/react",
    ],
)

ts_library(
    name = "main",
    srcs = ["main.tsx"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [
        ":app",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/@types/react-dom",
        "//:node_modules/react",
        "//:node_modules/react-dom",
    ],
)

spa_bundle(
    name = "bundle",
    entry_point = "main.tsx",
    jsx = "automatic",
    deps = [
        ":main",
    ],
)

# ── Unit tests ─────────────────────────────────────────────────────────────────

ts_library(
    name = "status_test",
    testonly = True,
    srcs = ["status.test.ts"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [
        ":status",
        "//:node_modules/vitest",
    ],
)

ts_library(
    name = "transcript_test",
    testonly = True,
    srcs = ["transcript.test.ts"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [
        ":api",
        ":transcript",
        "//:node_modules/vitest",
    ],
)

ts_library(
    name = "api_test",
    testonly = True,
    srcs = ["api.test.ts"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [
        ":api",
        "//:node_modules/vitest",
    ],
)

vitest_bin.vitest_test(
    name = "vitest_test",
    args = ["run"],
    chdir = package_name(),
    data = [
        "vitest.config.mts",
        ":api_test",
        ":status_test",
        ":transcript_test",
        "//:node_modules/vitest",
    ],
)

# The screenshot harness mounts the full app with deterministic API fixtures. CI publishes
# the desktop, dark, and narrow captures on the PR visual-review page.
js_library(
    name = "visual_scenarios",
    testonly = True,
    srcs = ["visual/scenarios.mjs"],
)

ts_library(
    name = "visual_harness_lib",
    testonly = True,
    srcs = ["visual/harness.tsx"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [
        ":api",
        ":app",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/@types/react-dom",
        "//:node_modules/react",
        "//:node_modules/react-dom",
    ],
)

esbuild(
    name = "visual_harness_bundle",
    testonly = True,
    config = {"jsx": "automatic"},
    entry_point = "visual/harness.tsx",
    format = "iife",
    minify = False,
    output = "visual/dist/harness.js",
    output_css = "visual/dist/harness.css",
    platform = "browser",
    sourcemap = "linked",
    target = ["es2022"],
    deps = [":visual_harness_lib"],
)

filegroup(
    name = "visual_harness_js",
    testonly = True,
    srcs = ["visual/dist/harness.js"],
)

filegroup(
    name = "visual_harness_css",
    testonly = True,
    srcs = ["visual/dist/harness.css"],
)

visual_test(
    name = "visual",
    size = "small",
    assets = [
        "visual/index.html",
        ":visual_harness_css",
    ],
    entry_point = "visual/runner.mjs",
    env = {"TZ": "UTC"},
    harness = ":visual_harness_js",
    scenarios = ":visual_scenarios",
)
