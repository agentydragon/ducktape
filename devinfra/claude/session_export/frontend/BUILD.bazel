# gazelle:exclude test_visual.py
load("@aspect_rules_esbuild//esbuild:defs.bzl", "esbuild")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config")
load("//devinfra/js:openapi.bzl", "js_openapi_schema")
load("//devinfra/js:spa_bundle.bzl", "spa_bundle")
load("//devinfra/js:ts_library.bzl", "ts_library")
load("//devinfra/js:typed_eslint.bzl", "typed_eslint_test")
load("//devinfra/js:vitest.bzl", "check_vitest_specs", "vitest_config")
load("//util/testing/frontend_visual:py_visual_test.bzl", "py_visual_test")
load(":vitest.bzl", "session_export_vitest_test")

package(default_visibility = ["//devinfra/claude/session_export:__pkg__"])

TSCONFIG = ":tsconfig"

filegroup(
    name = "typed_lint_srcs",
    srcs = glob(
        [
            "*.ts",
            "*.tsx",
            "**/*.ts",
            "**/*.tsx",
        ],
        allow_empty = True,
    ),
)

filegroup(
    name = "typed_lint_program_data",
    srcs = [
        ":schema",
        "//:node_modules/@mantine/core",
        "//:node_modules/@mantine/hooks",
        "//:node_modules/@types/react-dom",
        "//:node_modules/happy-dom",
    ],
)

typed_eslint_test(
    name = "eslint_typed_test",
    srcs = ":typed_lint_srcs",
    extra_data = [
        ":main",
        ":typed_lint_program_data",
        "//util/frontend:typed_lint_program_data",
    ],
    source_data = ["//util/frontend:typed_lint_srcs"],
    tsconfig = "tsconfig.json",
)

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
)

# Wire types generated from the API's own OpenAPI document, so the page's idea of a status is the
# Pydantic model rather than a hand-kept copy. Not checked in.
js_openapi_schema(
    name = "schema",
    generator = "//devinfra/claude/session_export:export_schema_bin",
)

ts_library(
    name = "status",
    srcs = ["status.ts"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
)

ts_library(
    name = "api",
    srcs = ["api.ts"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [":schema"],
)

ts_library(
    name = "overview",
    srcs = ["overview.tsx"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [
        ":api",
        ":status",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/react",
    ],
)

ts_library(
    name = "pairing",
    srcs = ["pairing.tsx"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [
        ":api",
        ":status",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/react",
    ],
)

ts_library(
    name = "app",
    srcs = ["app.tsx"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [
        ":api",
        ":overview",
        ":pairing",
        ":viewer",
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/react",
    ],
