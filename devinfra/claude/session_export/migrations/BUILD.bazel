"""Alembic discovers its revisions at runtime from this script directory."""

# gazelle:exclude env.py
# gazelle:exclude versions

filegroup(
    name = "files",
    srcs = [
        "env.py",
        "script.py.mako",
    ] + glob(["versions/*.py"]),
    visibility = ["//devinfra/claude/session_export:__pkg__"],
)
