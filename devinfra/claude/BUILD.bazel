load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

# === Base modules (no internal deps) ===

py_library(
    name = "otlp_forwarder",
    srcs = ["otlp_forwarder.py"],
    visibility = ["//visibility:public"],
)

py_library(
    name = "session_paths",
    srcs = ["session_paths.py"],
    visibility = ["//visibility:public"],
    deps = [
        "@pypi//platformdirs",
    ],
)

# Packaging targets are in the root //:wheel (merged ducktape wheel).
# See /BUILD.bazel for ducktape_pkg and wheel targets.

# === Tests ===

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":session_paths",
        "@pypi//pytest",
    ],
)

py_test(
    name = "test_session_start_input",
    srcs = ["test_session_start_input.py"],
    deps = [
        ":conftest",
        "//:conftest",
        "//devinfra/claude/claude_api/hooks:common",
        "//devinfra/claude/claude_api/hooks:session_start",
        "@pypi//pytest_bazel",
    ],
)

# === Transcript permission scanner ===

py_library(
    name = "readonly_commands",
    srcs = ["readonly_commands.py"],
    imports = ["../.."],
    visibility = ["//visibility:public"],
)

py_library(
    name = "scan_transcript_permissions",
    srcs = ["scan_transcript_permissions.py"],
    imports = ["../.."],
    deps = [
        ":readonly_commands",
    ],
)

py_binary(
    name = "scan_transcript_permissions_bin",
    main_module = "devinfra.claude.scan_transcript_permissions",
    deps = [":scan_transcript_permissions"],
)

# === Linting ===
