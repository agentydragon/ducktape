load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("//devinfra/testing:defs.bzl", "py_test")

exports_files(
    [
        "templates/post_tool_use.mako",
        "templates/session_context.mako",
    ],
    visibility = ["//devinfra/claude/hook_daemon:__subpackages__"],
)

# === Base modules (no internal deps) ===

py_library(
    name = "errors",
    srcs = ["errors.py"],
    imports = ["../.."],
    visibility = ["//visibility:public"],
)

py_library(
    name = "streaming",
    srcs = ["streaming.py"],
    imports = ["../.."],
    visibility = ["//visibility:public"],
)

py_library(
    name = "debug",
    srcs = ["debug.py"],
    imports = ["../.."],
    visibility = ["//visibility:public"],
)

py_library(
    name = "managed_files",
    srcs = ["managed_files.py"],
    imports = ["../.."],
    visibility = ["//visibility:public"],
)

py_library(
    name = "session_paths",
    srcs = ["session_paths.py"],
    imports = ["../.."],
    visibility = ["//visibility:public"],
    deps = [
        "@pypi//platformdirs",
    ],
)

py_library(
    name = "settings",
    srcs = ["settings.py"],
    data = [
        "config/bazelrc.mako",
    ],
    imports = ["../.."],
    visibility = ["//visibility:public"],
    deps = [
        "@pypi//platformdirs",
        "@pypi//pydantic",
        "@pypi//pydantic_settings",
    ],
)

py_library(
    name = "hook_config",
    srcs = ["hook_config.py"],
    imports = ["../.."],
    visibility = ["//visibility:public"],
    deps = [
        "@pypi//pydantic",
        "@pypi//pyyaml",
    ],
)

# === Modules with internal deps ===

py_library(
    name = "env_file",
    srcs = ["env_file.py"],
    imports = ["../.."],
    visibility = ["//visibility:public"],
    deps = [
        ":managed_files",
        ":settings",
        "//devinfra/claude/auth_proxy:setup",
        "//util/bazel:subprocess",
    ],
)

# === Libraries for binary sources ===
# py_library targets for source files that are also py_binary entry points.
# py_package depends on these (not the py_binary targets) to avoid pulling in
# venv artifacts that break py_wheel packaging.

py_library(
    name = "bazel_wrapper_lib",
    srcs = ["bazel_wrapper.py"],
    imports = ["../.."],
    visibility = ["//visibility:public"],
    deps = [
        ":debug",
        ":env_file",
        ":errors",
        ":session_paths",
        ":settings",
        "//devinfra/claude/auth_proxy:credentials",
        "//devinfra/claude/auth_proxy:vars",
        "//devinfra/claude/hook_daemon:client",
    ],
)

# === Binaries ===

py_binary(
    name = "bazel_wrapper",
    imports = ["../.."],
    main_module = "devinfra.claude.bazel_wrapper",
    visibility = ["//visibility:public"],
    deps = [":bazel_wrapper_lib"],
)

# Packaging targets are in the root //:wheel (merged ducktape wheel).
# See /BUILD.bazel for ducktape_pkg and wheel targets.

