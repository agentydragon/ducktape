load("@rules_python//python:packaging.bzl", "py_package", "py_wheel")
load("//devinfra/python:defs.bzl", "py_library", "py_test")

py_library(
    name = "statusline",
    srcs = ["statusline.py"],
    visibility = ["//visibility:public"],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "credentials",
    srcs = ["credentials.py"],
    visibility = ["//visibility:public"],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "usage",
    srcs = ["usage.py"],
    visibility = ["//visibility:public"],
    deps = ["@pypi//pydantic"],
)

# Canonical wheel for the shared Claude Code API models. The AIQuota and
# statusline wheels depend on this distribution instead of bundling overlapping
# copies of devinfra.claude.claude_api.
py_package(
    name = "claude_api_pkg",
    packages = [
        "devinfra.claude",
        "devinfra.claude.claude_api",
    ],
    deps = [
        ":credentials",
        ":statusline",
        ":usage",
        "//devinfra/claude/claude_api/hooks:dispatch_input",
        "//devinfra/claude/claude_api/hooks:output",
    ],
)

py_wheel(
    name = "claude_api_wheel",
    distribution = "ducktape_claude_api",
    python_requires = ">=3.14",
    requires = ["pydantic>=2.0"],
    version = "0.1.0",
    visibility = ["//visibility:public"],
    deps = [":claude_api_pkg"],
)

py_test(
    name = "test_usage",
    srcs = ["test_usage.py"],
    deps = [
        ":usage",
        "//:conftest",
        "//devinfra/claude:conftest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_schema_equivalence",
    srcs = ["test_schema_equivalence.py"],
    data = [
        "//devinfra/claude/claude_api/hooks/schemas/2.1.105:hook_schemas",
    ],
    deps = [
        "//:conftest",
        "//devinfra/claude:conftest",
        "//devinfra/claude/claude_api/hooks:output",
        "//util:json_schema",
        "//util/bazel:runfiles",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
