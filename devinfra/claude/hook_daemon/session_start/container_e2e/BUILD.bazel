load("@rules_oci//oci:defs.bzl", "oci_image")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//devinfra/oci:defs.bzl", "oci_layout_rloc")
load("//devinfra/python:defs.bzl", "py_test")

# Apt manifest + lockfile for rules_distroless (referenced from MODULE.bazel).
exports_files([
    "trixie_e2e.yaml",
    "trixie_e2e.lock.json",
])

# Wheels baked into the container image at /wheel/ so the test can
# `pip install --find-links /wheel/` without bind-mounting from runfiles.
pkg_tar(
    name = "e2e_wheels",
    testonly = True,
    srcs = [
        "//:claude_hooks_wheel",
        "//util:wheel",
    ],
    package_dir = "/wheel",
)

# Bazelisk + sops baked into /tools/ (on PATH). Neither is in Debian main,
# so we fetch them as static binaries via @bazelisk_linux_amd64 / @sops_linux_amd64.
pkg_tar(
    name = "e2e_bazelisk",
    testonly = True,
    srcs = ["@bazelisk_linux_amd64//file"],
    package_dir = "/tools",
    remap_paths = {"/file/bazelisk": "bazelisk"},
)

pkg_tar(
    name = "e2e_sops",
    testonly = True,
    srcs = ["@sops_linux_amd64//file"],
    package_dir = "/tools",
    remap_paths = {"/file/sops": "sops"},
)

# E2E test container: python:3.13-slim base + curl + git + JDK from trixie,
# bazelisk + sops as static binaries. See trixie_e2e.yaml.
oci_image(
    name = "e2e_container_image",
    testonly = True,
    base = "@python_3_13_slim_linux_amd64",
    # JDK update-alternatives postinst doesn't run in rules_distroless, so
    # /usr/bin/keytool won't exist. Extend PATH to include JDK bin directly.
    env = {
        "PATH": "/tools:/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin:/usr/lib/jvm/java-21-openjdk-amd64/bin",
    },
    tars = [
        "@trixie_e2e//:flat",
        ":e2e_wheels",
        ":e2e_bazelisk",
        ":e2e_sops",
    ],
)

oci_layout_rloc(
    name = "e2e_container",
    testonly = True,
    image = ":e2e_container_image",
)

py_test(
    name = "test_container_e2e",
    size = "large",
    srcs = ["test_container_e2e.py"],
    data = [
        ":e2e_container",
        "//devinfra/claude/hook_daemon/testdata/e2e_secrets:e2e_secrets_files",
        "//devinfra/claude/testdata/test_workspace:workspace_files",
        "//devinfra/secrets:_common.sh",
        "//devinfra/secrets:web_env.sh",
    ],
    requires_docker = True,
    tags = [
        "e2e",
        "external",
    ],
    deps = [
        "//devinfra/claude:conftest",
        "//devinfra/claude:env_file",
        "//devinfra/claude/testing:conftest",
        "//util:oci",
        "//util/bazel:runfiles",
        "//util/testing:undeclared_outputs",
        "@pypi//docker",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//pyyaml",
    ],
)
