py_test(
    name = "test_session_start",
    size = "medium",
    srcs = ["test_session_start.py"],
    data = [
        ":hook_dispatch",
        "//devinfra/claude/testdata/test_workspace:workspace_files",
        "//third_party/jdk:cacerts",
        "//third_party/jdk:keytool",
    ],
    env = {
        "JAVA_CACERTS_RLOCATION": "$(rlocationpath //third_party/jdk:cacerts)",
        "KEYTOOL_RLOCATION": "$(rlocationpath //third_party/jdk:keytool)",
    },
    # Inherit proxy env vars so MockEgressProxy can chain through real proxy
    env_inherit = [
        "CURL_CA_BUNDLE",
        "HTTPS_PROXY",
        "https_proxy",
        "NODE_EXTRA_CA_CERTS",
        "REQUESTS_CA_BUNDLE",
        "SSL_CERT_FILE",
    ],
    imports = ["../../.."],
    # local: keytool (Adoptium JDK) needs libjli.so which isn't on the RBE worker image
    local = True,
    tags = [
        "e2e",
        "external",
    ],
    deps = [
        "//devinfra/claude:conftest",
        "//devinfra/claude:settings",
        "//devinfra/claude/testing:fixtures",
        "//devinfra/claude/testing:session_start_helpers",
        "//devinfra/claude/testing:shell_helpers",
        "//util/testing:undeclared_outputs",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",
        "@pypi//pytest_bazel",
    ],
)

