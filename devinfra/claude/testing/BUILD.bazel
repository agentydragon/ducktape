load("@rules_oci//oci:defs.bzl", "oci_load")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//devinfra/claude:__subpackages__"])

py_library(
    name = "proxy_ca",
    testonly = True,
    srcs = ["proxy_ca.py"],
    imports = ["../../.."],
    deps = [
        "@pypi//cryptography",
    ],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    imports = ["../../.."],
    deps = ["@pypi//pytest"],
)

py_library(
    name = "shell_helpers",
    testonly = True,
    srcs = ["shell_helpers.py"],
    imports = ["../../.."],
)

py_library(
    name = "fixtures",
    testonly = True,
    srcs = ["fixtures.py"],
    imports = ["../../.."],
    deps = [
        ":mitmproxy_fixture",
        "//devinfra/claude:session_paths",
        "//devinfra/claude:settings",
        "//devinfra/claude/supervisor:client",
        "//util:net",
        "//util/testing:undeclared_outputs",
        "@pypi//pytest",
    ],
)

# =============================================================================
# mitmproxy testcontainer
# =============================================================================

oci_load(
    name = "mitmproxy_load",
    testonly = True,
    image = "@mitmproxy_linux_amd64",
    repo_tags = ["mitmproxy:11"],
)

filegroup(
    name = "mitmproxy_tarball",
    testonly = True,
    srcs = [":mitmproxy_load"],
    output_group = "tarball",
)

py_library(
    name = "mitmproxy_fixture",
    testonly = True,
    srcs = ["mitmproxy_fixture.py"],
    data = [":mitmproxy_tarball"],
    imports = ["../../.."],
    deps = [
        ":proxy_ca",
        "//util:oci",
        "//util/testing:undeclared_outputs",
        "@pypi//docker",
        "@pypi//pytest",
        "@pypi//testcontainers",
    ],
)

py_library(
    name = "session_start_helpers",
    testonly = True,
    srcs = ["session_start_helpers.py"],
    imports = ["../../.."],
    deps = [
        ":mitmproxy_fixture",
        ":shell_helpers",
        "//devinfra/claude:settings",
        "//devinfra/claude:tmpfs_setup",
        "//devinfra/claude/auth_proxy:setup",
        "//devinfra/claude/auth_proxy:vars",
        "//devinfra/claude/claude_api/hooks:common",
        "//devinfra/claude/claude_api/hooks:session_start",
        "//util:net",
        "//util/bazel:runfiles",
        "//util/testing:undeclared_outputs",
        "@pypi//pytest",
    ],
)
