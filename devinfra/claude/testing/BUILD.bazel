load("@aspect_rules_py//py:defs.bzl", "py_image_layer", aspect_py_binary = "py_binary")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_python//python:defs.bzl", "py_library")
load("//devinfra/testing:defs.bzl", "py_test")
load("//props:oci.bzl", "py_image_entrypoint", "py_image_env")

package(default_visibility = ["//devinfra/claude:__subpackages__"])

py_library(
    name = "mock_egress_proxy",
    testonly = True,
    srcs = ["mock_egress_proxy.py"],
    imports = ["../../.."],
    deps = [
        "//devinfra/claude/auth_proxy:setup",
        "//devinfra/claude/auth_proxy:vars",
        "@pypi//cryptography",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    imports = ["../../.."],
    deps = ["@pypi//pytest"],
)

py_test(
    name = "test_mock_egress_proxy",
    srcs = ["test_mock_egress_proxy.py"],
    args = ["--asyncio-mode=auto"],
    imports = ["../../.."],
    deps = [
        ":conftest",
        ":fixtures",
        ":mock_egress_proxy",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "shell_helpers",
    testonly = True,
    srcs = ["shell_helpers.py"],
    imports = ["../../.."],
)

py_library(
    name = "fixtures",
    testonly = True,
    srcs = ["fixtures.py"],
    imports = ["../../.."],
    deps = [
        ":mock_egress_proxy",
        "//devinfra/claude:session_paths",
        "//devinfra/claude:settings",
        "//devinfra/claude/supervisor:client",
        "//util:net",
        "//util/testing:undeclared_outputs",
        "@pypi//pytest",
    ],
)

# =============================================================================
# MockEgressProxy OCI image (for container E2E test)
# =============================================================================

py_library(
    name = "mock_egress_proxy_main",
    testonly = True,
    srcs = ["mock_egress_proxy_main.py"],
    imports = ["../../.."],
    deps = [
        ":mock_egress_proxy",
        "@pypi//aiohttp",
        "@pypi//yarl",
    ],
)

aspect_py_binary(
    name = "mock_egress_proxy_bin",
    testonly = True,
    imports = ["../../.."],
    main = "mock_egress_proxy_main.py",
    deps = [":mock_egress_proxy_main"],
)

py_image_layer(
    name = "mock_egress_proxy_layers",
    testonly = True,
    binary = ":mock_egress_proxy_bin",
)

oci_image(
    name = "mock_egress_proxy_image",
    testonly = True,
    base = "@debian_slim_linux_amd64",
    entrypoint = py_image_entrypoint("mock_egress_proxy_bin"),
    env = py_image_env(binary_name = "mock_egress_proxy_bin"),
    tars = [":mock_egress_proxy_layers"],
)

oci_load(
    name = "mock_egress_proxy_load",
    testonly = True,
    image = ":mock_egress_proxy_image",
    repo_tags = ["mock-egress-proxy:latest"],
)

filegroup(
    name = "mock_egress_proxy_tarball",
    testonly = True,
    srcs = [":mock_egress_proxy_load"],
    output_group = "tarball",
)

py_library(
    name = "session_start_helpers",
    testonly = True,
    srcs = ["session_start_helpers.py"],
    imports = ["../../.."],
    deps = [
        ":mock_egress_proxy",
        ":shell_helpers",
        "//devinfra/claude:settings",
        "//devinfra/claude:tmpfs_setup",
        "//devinfra/claude/auth_proxy:setup",
        "//devinfra/claude/auth_proxy:vars",
        "//devinfra/claude/claude_api/hooks:common",
        "//devinfra/claude/claude_api/hooks:session_start",
        "//util:net",
        "//util/bazel:runfiles",
        "//util/testing:undeclared_outputs",
        "@pypi//pytest",
    ],
)
