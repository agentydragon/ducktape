load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("//devinfra/testing:defs.bzl", "py_test")

# Apt manifest + lockfile for rules_distroless (referenced from MODULE.bazel).
exports_files([
    "trixie_e2e.yaml",
    "trixie_e2e.lock.json",
])

# E2E test container: python:3.13-slim base + git + JDK from rules_distroless.
# See trixie_e2e.yaml for the deb manifest.
#
# TODO: Eventually switch the base to the Claude Code web container RE
# (reverse-engineered container snapshot) so the E2E test exercises a
# realistic environment.
oci_image(
    name = "e2e_container",
    testonly = True,
    base = "@python_3_13_slim_linux_amd64",
    # JDK update-alternatives postinst doesn't run in rules_distroless, so
    # /usr/bin/keytool won't exist. Extend PATH to include JDK bin directly.
    env = {
        "PATH": "/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin:/usr/lib/jvm/java-21-openjdk-amd64/bin",
    },
    tars = [
        "@trixie_e2e//:flat",
    ],
)

oci_load(
    name = "e2e_container_load",
    testonly = True,
    image = ":e2e_container",
    repo_tags = ["e2e-container:pinned"],
)

filegroup(
    name = "e2e_container_tarball",
    testonly = True,
    srcs = [":e2e_container_load"],
    output_group = "tarball",
)

py_test(
    name = "test_container_e2e",
    size = "large",
    srcs = ["test_container_e2e.py"],
    data = [
        ":e2e_container_tarball",
        "//:claude_hooks_wheel",
        "//devinfra/claude/testdata/test_workspace:workspace_files",
        "@bazelisk_linux_amd64//file",
    ],
    env_inherit = [
        "DOCKER_HOST",
    ],
    imports = ["../../../.."],
    tags = [
        "e2e",
        "external",
    ],
    deps = [
        "//devinfra/claude:conftest",
        "//devinfra/claude/auth_proxy:setup",
        "//devinfra/claude/auth_proxy:vars",
        "//devinfra/claude/testing:conftest",
        "//devinfra/claude/testing:mitmproxy_fixture",
        "//util:oci",
        "//util/bazel:runfiles",
        "//util/testing:undeclared_outputs",
        "@pypi//docker",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
