load("@io_bazel_rules_go//go:def.bzl", "go_test")

go_test(
    name = "kvm_test",
    srcs = ["kvm_test.go"],
    exec_properties = {
        "test.EstimatedComputeUnits": "1",
        "test.Pool": "wyrm2-kvm",
