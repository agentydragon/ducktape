# gazelle:exclude **/bad
# gazelle:exclude **/ok

"""Detector rules — each py_detector() generates a library + fixture test."""

load(":defs.bzl", "py_detector")

py_detector(
    name = "broad_except_order",
    deps = ["//devinfra/lint/x/py_detectors:utils"],
)

py_detector(name = "dynamic_attr_probe")

py_detector(name = "flatten_nested_guards")

py_detector(name = "import_aliasing")

py_detector(
    name = "imports_inside_def",
    deps = [
        "//devinfra/lint/x/py_detectors:import_graph",
        "//devinfra/lint/x/py_detectors:utils",
    ],
)

py_detector(name = "magic_tuple_indices")

py_detector(name = "optional_string_simplify")

py_detector(name = "pathlike_str_casts")

py_detector(name = "pydantic_v1_shims")

py_detector(
    name = "swallow_errors",
    deps = ["//devinfra/lint/x/py_detectors:utils"],
)

py_detector(name = "trivial_alias")

py_detector(name = "trivial_passthrough")

py_detector(name = "walrus_suggest")
