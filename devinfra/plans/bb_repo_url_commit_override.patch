+// repoFetchURL returns the URL the remote runner should use to fetch the
+// repo: an explicit --repo_url override, a cached
+// buildbuddy.remote-bazel-repo-url .git/config value, or (the default) the
+// local remote's own URL as `git remote -v` reports it.
+//
+// This is a pure URL substitution -- determineRemote/determineDefaultBranch/
+// getBaseBranchAndCommit above still resolve branch/commit against the
+// local remote's own tracking refs (refs/remotes/<remote.name>/...), so
+// overriding the fetch URL doesn't require pinning an explicit commit or
+// disabling patch generation the way --run_from_commit/--run_from_branch
+// do. Meant for sandboxed/proxied environments where the URL reachable
+// locally isn't reachable from the runner, but both identify the exact
+// same repo/history.
+func repoFetchURL(remote *gitRemote) string {
+	if *repoURL != "" {
+		return *repoURL
+	}
+	if cached, _ := storage.ReadRepoConfig(gitConfigRemoteBazelRepoURL); cached != "" {
+		return cached
+	}
+	return remote.url
+}
