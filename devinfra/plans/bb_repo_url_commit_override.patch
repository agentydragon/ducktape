+func TestGitConfig_RepoURLOverride(t *testing.T) {
+	// Setup the "remote" repo
+	remoteRepoPath, originalMasterHeadCommit := testgit.MakeTempRepo(t, map[string]string{"hello.txt": "exit 0"})
+	remoteURL := "file://" + remoteRepoPath
+	overrideURL := "https://runner-reachable.example.com/owner/repo"
+
+	newLocalRepo := func(t *testing.T) string {
+		localRepoPath := testgit.MakeTempRepoClone(t, remoteRepoPath)
+		err := os.Chdir(localRepoPath)
+		require.NoError(t, err)
+		resetRepoRootPathForTest(t)
+		return localRepoPath
+	}
+
+	t.Run("repo_url flag substitutes the URL; branch/commit/patches still auto-detect", func(t *testing.T) {
+		localRepoPath := newLocalRepo(t)
+		testgit.CommitFiles(t, localRepoPath, map[string]string{"local_only.txt": "exit 0"})
+
+		*repoURL = overrideURL
+		defer func() { *repoURL = "" }()
+
+		config, err := Config()
+		require.NoError(t, err)
+		require.Equal(t, overrideURL, config.URL)
+		require.Equal(t, "master", config.Ref)
+		require.Equal(t, originalMasterHeadCommit, config.CommitSHA)
+		require.Len(t, config.Patches, 1)
+		require.Contains(t, string(config.Patches[0]), "local_only.txt")
+	})
+
+	t.Run("repo_url falls back to .git/config when flag is unset", func(t *testing.T) {
+		localRepoPath := newLocalRepo(t)
+		testshell.Run(t, localRepoPath, fmt.Sprintf("git config --replace-all %s.%s %s", gitConfigSection, gitConfigRemoteBazelRepoURL, overrideURL))
+
+		config, err := Config()
+		require.NoError(t, err)
+		require.Equal(t, overrideURL, config.URL)
+		require.Equal(t, "master", config.Ref)
+		require.Equal(t, originalMasterHeadCommit, config.CommitSHA)
+	})
+
+	t.Run("repo_url flag takes precedence over .git/config", func(t *testing.T) {
+		localRepoPath := newLocalRepo(t)
+		testshell.Run(t, localRepoPath, fmt.Sprintf("git config --replace-all %s.%s %s", gitConfigSection, gitConfigRemoteBazelRepoURL, "https://should-not-be-used.example.com"))
+		*repoURL = overrideURL
+		defer func() { *repoURL = "" }()
+
+		config, err := Config()
+		require.NoError(t, err)
+		require.Equal(t, overrideURL, config.URL)
+	})
+
+	t.Run("no override leaves the local remote's own URL", func(t *testing.T) {
+		newLocalRepo(t)
+
+		config, err := Config()
+		require.NoError(t, err)
+		require.Equal(t, remoteURL, config.URL)
+	})
+}
