+func TestGitConfig_RepoURLOverride(t *testing.T) {
+	remoteRepoPath, originalMasterHeadCommit := testgit.MakeTempRepo(t, map[string]string{"hello.txt": "exit 0"})
+	remoteURL := "file://" + remoteRepoPath
+
+	localRepoPath := testgit.MakeTempRepoClone(t, remoteRepoPath)
+	err := os.Chdir(localRepoPath)
+	require.NoError(t, err)
+	resetRepoRootPathForTest(t)
+
+	t.Run("repo_url without run_from_commit is rejected", func(t *testing.T) {
+		*repoURL = remoteURL
+		defer func() { *repoURL = "" }()
+
+		_, err := Config()
+		require.Error(t, err)
+		require.Contains(t, err.Error(), "--run_from_commit")
+	})
+
+	t.Run("repo_url with run_from_commit uses the override URL, no patches by default", func(t *testing.T) {
+		testgit.CommitFiles(t, localRepoPath, map[string]string{"dirty.txt": "exit 0"})
+
+		*repoURL = remoteURL
+		*runFromCommit = originalMasterHeadCommit
+		defer func() {
+			*repoURL = ""
+			*runFromCommit = ""
+		}()
+
+		config, err := Config()
+		require.NoError(t, err)
+		require.Equal(t, remoteURL, config.URL)
+		require.Equal(t, originalMasterHeadCommit, config.CommitSHA)
+		require.Empty(t, config.Patches)
+	})
+
+	t.Run("repo_url with run_from_commit and apply_local_patches mirrors local changes", func(t *testing.T) {
+		testgit.CommitFiles(t, localRepoPath, map[string]string{"dirty2.txt": "exit 0"})
+
+		*repoURL = remoteURL
+		*runFromCommit = originalMasterHeadCommit
+		*applyLocalPatches = true
+		defer func() {
+			*repoURL = ""
+			*runFromCommit = ""
+			*applyLocalPatches = false
+		}()
+
+		config, err := Config()
+		require.NoError(t, err)
+		require.Equal(t, remoteURL, config.URL)
+		require.Equal(t, originalMasterHeadCommit, config.CommitSHA)
+		require.NotEmpty(t, config.Patches)
+		require.Contains(t, string(config.Patches[0]), "dirty2.txt")
+	})
+
+	t.Run("repo_url falls back to .git/config when flag is unset", func(t *testing.T) {
+		testshell.Run(t, localRepoPath, fmt.Sprintf("git config --replace-all %s.%s %s", gitConfigSection, gitConfigRemoteBazelRepoURL, remoteURL))
+		*runFromCommit = originalMasterHeadCommit
+		defer func() {
+			testshell.Run(t, localRepoPath, fmt.Sprintf("git config --unset %s.%s", gitConfigSection, gitConfigRemoteBazelRepoURL))
+			*runFromCommit = ""
+		}()
+
+		config, err := Config()
+		require.NoError(t, err)
+		require.Equal(t, remoteURL, config.URL)
+		require.Equal(t, originalMasterHeadCommit, config.CommitSHA)
+	})
+
+	t.Run("repo_url flag takes precedence over .git/config", func(t *testing.T) {
+		testshell.Run(t, localRepoPath, fmt.Sprintf("git config --replace-all %s.%s %s", gitConfigSection, gitConfigRemoteBazelRepoURL, "file:///should-not-be-used"))
+		*repoURL = remoteURL
+		*runFromCommit = originalMasterHeadCommit
+		defer func() {
+			testshell.Run(t, localRepoPath, fmt.Sprintf("git config --unset %s.%s", gitConfigSection, gitConfigRemoteBazelRepoURL))
+			*repoURL = ""
+			*runFromCommit = ""
+		}()
+
+		config, err := Config()
+		require.NoError(t, err)
+		require.Equal(t, remoteURL, config.URL)
+	})
+}
