--- a/tests/test_attic_jobs.py
+++ b/tests/test_attic_jobs.py
@@ -0,0 +1,22 @@
+import asyncio
+import unittest
+from unittest.mock import AsyncMock, patch
+
+from nix_fast_build import Build, Options, parse_args
+
+
+class AtticJobsTest(unittest.TestCase):
+    def test_cli_option(self) -> None:
+        with patch("nix_fast_build.get_nix_config", new=AsyncMock(return_value={"system": "x86_64-linux"})):
+            opts = asyncio.run(parse_args(["--attic-cache", "ducktape:main", "--attic-jobs", "1"]))
+        self.assertEqual(opts.attic_jobs, 1)
+
+    def test_upload_job_limit(self) -> None:
+        build = Build(attr="test", drv_path="/nix/store/test.drv", outputs={"out": "/nix/store/test"})
+        for jobs, expected_options in [(None, []), (1, ["--jobs", "1"])]:
+            with self.subTest(jobs=jobs), patch("nix_fast_build.nix_shell", return_value=["attic"]), patch(
+                "nix_fast_build.asyncio.create_subprocess_exec"
+            ) as create:
+                create.return_value.wait = AsyncMock(return_value=0)
+                self.assertEqual(asyncio.run(build.upload_attic(Options(attic_cache="ducktape:main", attic_jobs=jobs))), 0)
+            create.assert_awaited_once_with("attic", "push", *expected_options, "ducktape:main", "/nix/store/test")
