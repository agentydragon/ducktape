load("@npm_ducktape//:prettier/package_json.bzl", prettier_bin = "bin")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("//devinfra/testing:defs.bzl", "py_test")

# Source of truth for CI workflow definitions
exports_files(["workflows.yaml"])

# Generated workflow files consumed by test_generate_ci
filegroup(
    name = "generated_workflows",
    srcs = [
        "//.github/workflows:bazel-harbor-images.yml",
        "//.github/workflows:ci.yml",
        "//.github/workflows:release.yml",
    ],
)

prettier_bin.prettier_binary(
    name = "prettier",
    data = ["//:prettierrc"],
    fixed_args = [
        "--config",
        "\"$$JS_BINARY__RUNFILES\"/$(rlocationpath //:prettierrc)",
    ],
    visibility = ["//visibility:private"],
)

# === Base modules (no internal deps) ===

py_library(
    name = "bazel_query",
    srcs = ["bazel_query.py"],
    imports = ["../.."],
    visibility = ["//:__subpackages__"],
    deps = ["//util/bazel:query"],
)

py_library(
    name = "github_actions",
    srcs = ["github_actions.py"],
    imports = ["../.."],
    visibility = ["//:__subpackages__"],
    deps = [
        "//util:env",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "models",
    srcs = ["models.py"],
    imports = ["../.."],
    visibility = ["//:__subpackages__"],
    deps = [
        "//util/bazel:query",
        "@pypi//pydantic",
        "@pypi//pyyaml",
    ],
)

# === Library modules ===

py_library(
    name = "diff_utils",
    srcs = ["diff_utils.py"],
    imports = ["../.."],
    visibility = ["//:__subpackages__"],
    deps = [
        ":github_actions",
        "//util/bazel:query",
        "@pypi//pygit2",
    ],
)

# === Exec stubs ===

py_library(
    name = "check_release",
    srcs = ["check_release.py"],
    imports = ["../.."],
    visibility = ["//:__subpackages__"],
    deps = [
        ":diff_utils",
        ":github_actions",
        "//util:env",
        "//util/bazel:query",
        "@pypi//pydantic",
        "@pypi//pygit2",
    ],
)

py_library(
    name = "ci_decide",
    srcs = ["ci_decide.py"],
    imports = ["../.."],
    visibility = ["//:__subpackages__"],
    deps = [
        ":bazel_query",
        ":diff_utils",
        ":github_actions",
        ":models",
        "//util:env",
        "//util:fmt",
        "@pypi//pydantic",
        "@pypi//pygit2",
    ],
)

py_library(
    name = "generate_ci",
    srcs = ["generate_ci.py"],
    data = [
        ":prettier",
        ":workflows.yaml",
    ],
    imports = ["../.."],
    visibility = ["//:__subpackages__"],
    deps = [
        ":diff_utils",
        ":github_actions",
        ":models",
        "//util/bazel:runfiles",
        "//util/bazel:workspace",
        "@pypi//pyyaml",
    ],
)

# === Binaries ===

py_binary(
    name = "check_release_bin",
    imports = ["../.."],
    main_module = "devinfra.ci.check_release",
    deps = [":check_release"],
)

py_binary(
    name = "ci_decide_bin",
    imports = ["../.."],
    main_module = "devinfra.ci.ci_decide",
    deps = [":ci_decide"],
)

py_binary(
    name = "generate_ci_bin",
    imports = ["../.."],
    main_module = "devinfra.ci.generate_ci",
    deps = [":generate_ci"],
)

# === Tests ===

py_test(
    name = "test_generate_ci",
    srcs = ["test_generate_ci.py"],
    data = [
        ":generated_workflows",
        ":workflows.yaml",
    ],
    imports = ["../.."],
    deps = [
        ":generate_ci",
        "@pypi//pytest_bazel",
        "@pypi//pyyaml",
    ],
)
