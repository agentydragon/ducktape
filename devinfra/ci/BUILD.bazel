load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

# === Base modules (no internal deps) ===

py_library(
    name = "github_actions",
    srcs = ["github_actions.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//util:env",
        "@pypi//pydantic",
    ],
)

# === Library modules ===

py_library(
    name = "diff_utils",
    srcs = ["diff_utils.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":github_actions",
        "//util/bazel:workspace",
        "@pypi//pygit2",
    ],
)

# === Exec stubs ===

py_library(
    name = "check_release",
    srcs = ["check_release.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":diff_utils",
        ":github_actions",
        "//util:env",
        "//util/bazel:workspace",
        "@pypi//pydantic",
        "@pypi//pygit2",
    ],
)

py_library(
    name = "artifacts",
    srcs = ["artifacts.py"],
    data = [
        "artifact_targets.json",
        "//skills:skills_registry.json",
    ],
    visibility = ["//:__subpackages__"],
    deps = [
        "//util/bazel:workspace",
        "@pypi//httpx",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "sync_pins",
    srcs = ["sync_pins.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":artifacts",
        "@pypi//more_itertools",
        "@pypi//pygithub",
    ],
)

py_library(
    name = "prune_releases",
    srcs = ["prune_releases.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":artifacts",
        "@pypi//pydantic",
        "@pypi//pygithub",
    ],
)

py_test(
    name = "test_prune_releases",
    srcs = ["test_prune_releases.py"],
    deps = [
        ":prune_releases",
        "//:conftest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "release_metadata",
    srcs = ["release_metadata.py"],
    visibility = ["//:__subpackages__"],
)

py_library(
    name = "release_content_hash",
    srcs = ["release_content_hash.py"],
    visibility = ["//:__subpackages__"],
)

py_library(
    name = "bb_runner_probe",
    srcs = ["bb_runner_probe.py"],
    visibility = ["//:__subpackages__"],
)

py_library(
    name = "collect_bazel_ci_profiles",
    srcs = ["collect_bazel_ci_profiles.py"],
    visibility = ["//:__subpackages__"],
)

py_library(
    name = "emit_bb_remote_linkage",
    srcs = ["emit_bb_remote_linkage.py"],
    visibility = ["//:__subpackages__"],
)

# === Binaries ===

py_binary(
    name = "sync_pins_bin",
    main_module = "devinfra.ci.sync_pins",
    deps = [":sync_pins"],
)

py_binary(
    name = "check_release_bin",
    main_module = "devinfra.ci.check_release",
    deps = [":check_release"],
)

py_binary(
    name = "release_metadata_bin",
    main_module = "devinfra.ci.release_metadata",
    deps = [":release_metadata"],
)

py_binary(
    name = "bb_runner_probe_bin",
    main_module = "devinfra.ci.bb_runner_probe",
    deps = [":bb_runner_probe"],
)

py_binary(
    name = "collect_bazel_ci_profiles_bin",
    main_module = "devinfra.ci.collect_bazel_ci_profiles",
    deps = [":collect_bazel_ci_profiles"],
)

py_binary(
    name = "emit_bb_remote_linkage_bin",
    main_module = "devinfra.ci.emit_bb_remote_linkage",
    deps = [":emit_bb_remote_linkage"],
)

py_test(
    name = "test_artifacts",
    srcs = ["test_artifacts.py"],
    deps = [
        ":artifacts",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_release_metadata",
    srcs = ["test_release_metadata.py"],
    deps = [
        ":release_metadata",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_release_content_hash",
    srcs = ["test_release_content_hash.py"],
    deps = [
        ":release_content_hash",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_bb_runner_probe",
    srcs = ["test_bb_runner_probe.py"],
    deps = [
        ":bb_runner_probe",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_collect_bazel_ci_profiles",
    srcs = ["test_collect_bazel_ci_profiles.py"],
    deps = [
        ":collect_bazel_ci_profiles",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_emit_bb_remote_linkage",
    srcs = ["test_emit_bb_remote_linkage.py"],
    deps = [
        ":emit_bb_remote_linkage",
        "@pypi//pytest_bazel",
    ],
)
