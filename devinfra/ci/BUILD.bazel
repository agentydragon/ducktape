load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("//devinfra/testing:defs.bzl", "py_test")

# Source of truth for CI workflow definitions
exports_files(["workflows.yaml"])

# Generated workflow files consumed by test_generate_ci
filegroup(
    name = "generated_workflows",
    srcs = [
        "//.github/workflows:ci.yml",
    ],
)

# === Base modules (no internal deps) ===

py_library(
    name = "github_actions",
    srcs = ["github_actions.py"],
    imports = ["../.."],
    visibility = ["//:__subpackages__"],
    deps = [
        "//util:env",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "models",
    srcs = ["models.py"],
    imports = ["../.."],
    visibility = ["//:__subpackages__"],
    deps = [
        "//util/bazel:workspace",
        "@pypi//pydantic",
        "@pypi//pyyaml",
    ],
)

# === Library modules ===

py_library(
    name = "diff_utils",
    srcs = ["diff_utils.py"],
    imports = ["../.."],
    visibility = ["//:__subpackages__"],
    deps = [
        ":github_actions",
        "//util/bazel:workspace",
        "@pypi//pygit2",
    ],
)

# === Exec stubs ===

py_library(
    name = "check_release",
    srcs = ["check_release.py"],
    imports = ["../.."],
    visibility = ["//:__subpackages__"],
    deps = [
        ":diff_utils",
        ":github_actions",
        "//util:env",
        "//util/bazel:workspace",
        "@pypi//pydantic",
        "@pypi//pygit2",
    ],
)

py_library(
    name = "ci_decide",
    srcs = ["ci_decide.py"],
    imports = ["../.."],
    visibility = ["//:__subpackages__"],
    deps = [
        ":diff_utils",
        ":github_actions",
        ":models",
        "//util:fmt",
        "@pypi//pydantic",
        "@pypi//pygit2",
    ],
)

py_library(
    name = "generate_ci",
    srcs = ["generate_ci.py"],
    data = [":workflows.yaml"],
    imports = ["../.."],
    visibility = ["//:__subpackages__"],
    deps = [
        ":github_actions",
        ":models",
        "//devinfra:prettier",
        "//util/bazel:workspace",
        "@pypi//pyyaml",
    ],
)

py_library(
    name = "artifacts",
    srcs = ["artifacts.py"],
    imports = ["../.."],
    visibility = ["//:__subpackages__"],
    deps = [
        "@pypi//pydantic",
        "@pypi//requests",
    ],
)

py_library(
    name = "bb_release",
    srcs = ["bb_release.py"],
    imports = ["../.."],
    visibility = ["//:__subpackages__"],
    deps = [
        ":artifacts",
        "@pypi//more-itertools",
        "@pypi//pygit2",
        "@pypi//pygithub",
    ],
)

py_library(
    name = "sync_pins",
    srcs = ["sync_pins.py"],
    imports = ["../.."],
    visibility = ["//:__subpackages__"],
    deps = [
        ":artifacts",
        "@pypi//pygithub",
    ],
)

# === Binaries ===

py_binary(
    name = "bb_release_bin",
    imports = ["../.."],
    main_module = "devinfra.ci.bb_release",
    deps = [":bb_release"],
)

py_binary(
    name = "sync_pins_bin",
    imports = ["../.."],
    main_module = "devinfra.ci.sync_pins",
    deps = [":sync_pins"],
)

py_binary(
    name = "check_release_bin",
    imports = ["../.."],
    main_module = "devinfra.ci.check_release",
    deps = [":check_release"],
)

py_binary(
    name = "ci_decide_bin",
    imports = ["../.."],
    main_module = "devinfra.ci.ci_decide",
    deps = [":ci_decide"],
)

py_binary(
    name = "generate_ci_bin",
    imports = ["../.."],
    main_module = "devinfra.ci.generate_ci",
    deps = [":generate_ci"],
)

# === Tests ===

py_test(
    name = "test_generate_ci",
    srcs = ["test_generate_ci.py"],
    data = [
        ":generated_workflows",
        ":workflows.yaml",
    ],
    imports = ["../.."],
    deps = [
        ":generate_ci",
        "@pypi//pytest_bazel",
        "@pypi//pyyaml",
    ],
)
