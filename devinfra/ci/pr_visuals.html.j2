<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Visual review · {{ commit_sha }}</title>
    <style>
      :root { color-scheme: light dark; font: 15px/1.45 system-ui, sans-serif; background: #f4f5f7; color: #16181d; }
      body { margin: 0; }
      header { padding: 16px 24px; background: Canvas; border-bottom: 1px solid #bbb; }
      h1 { margin: 0 0 4px; font-size: 18px; }
      h2 { font-size: 16px; }
      code { overflow-wrap: anywhere; font-size: 12px; }
      main { padding: 20px; }
      section { margin-bottom: 28px; }
      .assets { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(360px, 100%), 1fr)); gap: 16px; }
      figure { margin: 0; padding: 10px; border: 1px solid #bbb; border-radius: 10px; background: Canvas; }
      img { display: block; width: 100%; height: auto; border-radius: 6px; background: white; }
      figcaption { padding-top: 8px; font-weight: 600; }
      @media (prefers-color-scheme: dark) { :root { background: #17181b; color: #eee; } figure, header { border-color: #444; } }
    </style>
  </head>
  <body>
    <header>
      <h1>Visual review</h1>
      <div>{{ repository }} · <code>{{ commit_sha }}</code> · {{ tests | length }} Bazel test targets</div>
    </header>
    <main>
      {% for test in tests %}
      <section>
        <h2><a href="tests/{{ test.slug }}/index.html">{{ test.title }}</a></h2>
        <p><code>{{ test.target_label }}</code> · {{ test.assets | length }} assets</p>
        <div class="assets">
          {% for asset in test.assets[:2] %}
          <figure>
            <a href="tests/{{ test.slug }}/index.html#{{ asset.path }}">
              <img src="tests/{{ test.slug }}/{{ asset.path }}" alt="{{ asset.label }}" loading="lazy">
            </a>
            <figcaption>{{ asset.label }}</figcaption>
          </figure>
          {% endfor %}
        </div>
      </section>
      {% endfor %}
    </main>
  </body>
</html>
