<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ title }} · {{ commit_sha }}</title>
    <style>
      :root { color-scheme: light dark; font: 15px/1.45 system-ui, sans-serif; background: #f4f5f7; color: #16181d; }
      body { margin: 0; }
      header { padding: 16px 24px; background: Canvas; border-bottom: 1px solid #bbb; }
      h1 { margin: 0 0 4px; font-size: 18px; }
      code { overflow-wrap: anywhere; font-size: 12px; }
      main { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(520px, 100%), 1fr)); gap: 20px; padding: 20px; }
      figure { margin: 0; padding: 12px; border: 1px solid #bbb; border-radius: 10px; background: Canvas; }
      img { display: block; width: 100%; height: auto; border-radius: 6px; background: white; }
      figcaption { padding-top: 9px; font-weight: 600; }
      @media (prefers-color-scheme: dark) { :root { background: #17181b; color: #eee; } figure, header { border-color: #444; } }
    </style>
  </head>
  <body>
    <header>
      <a href="../../index.html">All visual tests</a>
      <h1>{{ title }}</h1>
      <div><code>{{ target_label }}</code> · {{ repository }} · <code>{{ commit_sha }}</code></div>
    </header>
    <main>
      {% for asset in assets %}
      <figure id="{{ asset.path }}">
        <a href="{{ asset.path }}"><img src="{{ asset.path }}" alt="{{ asset.label }}" loading="lazy"></a>
        <figcaption>{{ asset.label }}</figcaption>
      </figure>
      {% endfor %}
    </main>
  </body>
</html>
