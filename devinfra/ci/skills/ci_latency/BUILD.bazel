load("@aspect_bazel_lib//lib:jq.bzl", "jq")
load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("//devinfra/python:defs.bzl", "py_library", "py_test")
load("//skills:defs.bzl", "skill_mapping", "skill_package")

skill_package(
    name = "ci_latency",
    contents = [
        skill_mapping(
            srcs = [
                "SKILL.md",
                "scripts/attribution.py",
                "scripts/checks.jq",
                "scripts/collect.sh",
                "scripts/contention.jq",
                "scripts/evidence.sh",
                "scripts/inspect.sh",
                "scripts/summarize.jq",
            ],
            preserve_paths = True,
        ),
        skill_mapping(
            srcs = ["//devinfra/ci/reports:publish.py"],
            prefix = "scripts",
        ),
    ],
)

# Captured live jobs: twelve CodeQL runners coexist with queued Bazel at 20:44.
# Fixed fixture assertions test the shipped recipe, not a second implementation.
[jq(
    name = recipe + "_fixture",
    srcs = ["testdata/jobs.json"],
    args = [
        "--arg",
        "since",
        "2026-09-09T20:00:00Z",
        "--arg",
        "until",
        "2026-09-09T21:15:00Z",
    ],
    filter_file = "scripts/" + recipe + ".jq",
) for recipe in [
    "summarize",
    "contention",
]]

jq(
    name = "assert_contention",
    srcs = [":contention_fixture"],
    filter_file = "testdata/assert_contention.jq",
)

jq(
    name = "assert_summary",
    srcs = [":summarize_fixture"],
    filter_file = "testdata/assert_summary.jq",
)

[diff_test(
    name = "test_" + recipe,
    file1 = ":assert_" + recipe,
    file2 = "testdata/true.json",
) for recipe in [
    "summary",
    "contention",
]]

py_library(
    name = "artifact_tools",
    srcs = [
        "scripts/attribution.py",
    ],
)

py_test(
    name = "test_artifacts",
    srcs = ["test_artifacts.py"],
    deps = [
        ":artifact_tools",
        "//:conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
