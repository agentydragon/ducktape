load("@aspect_rules_py//py:defs.bzl", "py_image_layer", aspect_py_binary = "py_binary")
load("@rules_oci//oci:defs.bzl", "oci_image")
load("//devinfra/oci:py_image.bzl", "py_image_entrypoint", "py_image_env")
load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

py_library(
    name = "card",
    srcs = ["card.py"],
    visibility = ["//visibility:public"],
)

py_library(
    name = "gitstore",
    srcs = ["gitstore.py"],
)

py_library(
    name = "sync",
    srcs = ["sync.py"],
    deps = [
        ":card",
        ":gitstore",
        "@pypi//pydantic",
    ],
)

py_binary(
    name = "sync_bin",
    main_module = "cpap.sync",
    deps = [":sync"],
)

py_test(
    name = "test_sync",
    srcs = ["test_sync.py"],
    deps = [
        ":card",
        ":sync",
        "//:conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_card",
    srcs = ["test_card.py"],
    deps = [
        ":card",
        "//:conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

# ── OCI Image ────────────────────────────────────────────────────────────────

aspect_py_binary(
    name = "sync_image_bin",
    main = "sync.py",
    deps = [":sync"],
)

py_image_layer(
    name = "layers",
    binary = ":sync_image_bin",
)

oci_image(
    name = "image",
    base = "@debian_trixie_slim_linux_amd64",
    entrypoint = py_image_entrypoint("sync_image_bin"),
    env = py_image_env(binary_name = "sync_image_bin"),
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [
        "@trixie_cpap_sync//:flat",
        ":layers",
    ],
)
