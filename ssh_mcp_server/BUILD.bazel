load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_py//py:defs.bzl", "py_image_layer", aspect_py_binary = "py_binary")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("//devinfra/js:json_schema_js_library.bzl", "json_schema_js_library")
load("//devinfra/oci:py_image.bzl", "py_image_entrypoint", "py_image_env")
load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "server",
    srcs = ["server.py"],
    deps = [
        "//mcp_infra:static_bearer",
        "@pypi//fastmcp_slim",
        "@pypi//mcp",
        "@pypi//mcp_types",
        "@pypi//paramiko",
        "@pypi//pydantic",
        "@pypi//pyyaml",
        "@pypi//starlette",
        "@pypi//uvicorn",
    ],
)

py_binary(
    name = "server_cli",
    main_module = "ssh_mcp_server.server",
    deps = [":server"],
)

py_library(
    name = "export_frontend_schema",
    srcs = ["export_frontend_schema.py"],
    deps = [
        ":server",
        "@pypi//fastmcp_slim",
    ],
)

py_binary(
    name = "export_frontend_schema_bin",
    main_module = "ssh_mcp_server.export_frontend_schema",
    deps = [":export_frontend_schema"],
)

genrule(
    name = "frontend_exec_schemas",
    outs = [
        "exec.arguments.schema.json",
        "exec.result.schema.json",
    ],
    cmd = "$(location :export_frontend_schema_bin) $(RULEDIR)/exec.arguments.schema.json $(RULEDIR)/exec.result.schema.json",
    tools = [":export_frontend_schema_bin"],
    visibility = ["//agentplane/app/frontend/actions:__pkg__"],
)

json_schema_js_library(
    name = "exec_arguments_types",
    schema = ":exec.arguments.schema.json",
    visibility = ["//agentplane/app/frontend/actions:__pkg__"],
)

json_schema_js_library(
    name = "exec_result_types",
    schema = ":exec.result.schema.json",
    visibility = ["//agentplane/app/frontend/actions:__pkg__"],
)

js_library(
    name = "exec_schemas",
    srcs = [
        ":exec.arguments.schema.json",
        ":exec.result.schema.json",
    ],
    visibility = ["//agentplane/app/frontend/actions:__pkg__"],
    deps = [
        ":exec_arguments_types",
        ":exec_result_types",
    ],
)

py_library(
    name = "export_exec_payload_fixture",
    testonly = True,
    srcs = ["export_exec_payload_fixture.py"],
    deps = [
        ":server",
        "@pypi//fastmcp_slim",
    ],
)

py_binary(
    name = "export_exec_payload_fixture_bin",
    testonly = True,
    main_module = "ssh_mcp_server.export_exec_payload_fixture",
    deps = [":export_exec_payload_fixture"],
)

genrule(
    name = "exec_payload_fixture",
    testonly = True,
    outs = ["exec_payload_fixture.json"],
    cmd = "$(location :export_exec_payload_fixture_bin) $@",
    tools = [":export_exec_payload_fixture_bin"],
    visibility = ["//agentplane/app/frontend/actions/rendering:__pkg__"],
)

js_library(
    name = "exec_payload_fixture_js",
    testonly = True,
    srcs = [":exec_payload_fixture.json"],
    visibility = ["//agentplane/app/frontend/actions/rendering:__pkg__"],
)

py_test(
    name = "test_server",
    srcs = ["test_server.py"],
    deps = [
        ":server",
        "//:conftest",
        "@pypi//fastmcp_slim",
        "@pypi//httpx",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

aspect_py_binary(
    name = "server_bin",
    main = "server.py",
    deps = [":server"],
)

py_image_layer(
    name = "server_layers",
    binary = ":server_bin",
    group = "1000",
    owner = "1000",
)

oci_image(
    name = "image",
    base = "@debian_trixie_slim_linux_amd64",
    entrypoint = py_image_entrypoint("server_bin"),
    env = py_image_env(binary_name = "server_bin"),
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [":server_layers"],
    user = "1000:1000",
    visibility = ["//visibility:public"],
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["ssh-mcp:latest"],
)
