+@pytest.mark.parametrize(
+    ("body", "expected_error"),
+    [
+        ({"models": [{"model": "route", "displayName": "Route"}]}, None),
+        ({"models": [{"model": "route"}, {"model": "route"}]}, "duplicate model ids"),
+        ({"harnesses": [{"harness": 9999}]}, "9999"),
+        (
+            {"harnesses": [{"harness": "HARNESS_CODEX", "models": ["missing"]}]},
+            "outside ModelCatalog.models",
+        ),
+    ],
+)
+async def test_generated_model_catalog_probe(body: dict[str, object], expected_error: str | None) -> None:
+    async def models(_after: int, writer: asyncio.StreamWriter) -> None:
+        await _respond(writer, "200 OK", json.dumps(body).encode(), "application/json")
+
+    async with _app(models) as (client, _):
+        if expected_error is not None:
+            with pytest.raises(ValueError, match=expected_error):
+                await client.models()
+        else:
+            catalog = await client.models()
+            assert catalog.models[0].reasoning_efforts == []
+            assert catalog.harnesses == {}
+
+
