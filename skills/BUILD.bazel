# skill_spec_library() (defs.bzl) generates each <name>_skill_spec module;
# gazelle cannot see generated sources, so pin the imports to their targets.
# gazelle:resolve py skills.eval_infra.empty_skill.empty_skill_skill_spec //skills/eval_infra/empty_skill:empty_skill_skill_spec
# gazelle:resolve py skills.freecad.freecad_skill_spec //skills/freecad:freecad_skill_spec
# gazelle:resolve py skills.info_gathering.info_gathering_skill_spec //skills/info_gathering:info_gathering_skill_spec
# gazelle:resolve py skills.reverse_engineer.reverse_engineer_skill_spec //skills/reverse_engineer:reverse_engineer_skill_spec

load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

exports_files(
    ["skills_registry.json"],
    visibility = ["//devinfra/ci:__pkg__"],
)

py_library(
    name = "skill_spec",
    srcs = ["skill_spec.py"],
    visibility = ["//visibility:public"],
)

py_library(
    name = "frontmatter_validation",
    srcs = ["frontmatter_validation.py"],
    visibility = ["//skills/testing:__pkg__"],
    deps = ["@pypi//pyyaml"],
)

py_binary(
    name = "frontmatter_validation_bin",
    main_module = "skills.frontmatter_validation",
    visibility = ["//visibility:public"],
    deps = [":frontmatter_validation"],
)

py_test(
    name = "test_frontmatter",
    srcs = ["test_frontmatter.py"],
    deps = [
        ":frontmatter_validation",
        "//:conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
