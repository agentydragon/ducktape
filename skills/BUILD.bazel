load("@rules_pkg//pkg:zip.bzl", "pkg_zip")
load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

# Every skill's packaged files combined into one `.skill` zip for deployment.
# Each `:<name>_files` filegroup already re-roots its contents under `<name>/`
# (see skill_package in defs.bzl), so the archive holds `<name>/SKILL.md`, …
# Extract with: unzip all_skills.skill -d ~/.claude/skills/
pkg_zip(
    name = "all_skills",
    srcs = [
        "//cluster/skills/cluster_health:cluster_health_files",
        "//cluster/skills/cnpg_region_switch:cnpg_region_switch_files",
        "//cluster/skills/flux_reconcile_audit:flux_reconcile_audit_files",
        "//cluster/skills/hetzner_vnc_screenshot:hetzner_vnc_screenshot_files",
        "//cluster/skills/proxmox_vm:proxmox_vm_files",
        "//cpap/skill:cpap_files",
        "//devinfra/buildbuddy_cli/skills/buildbuddy_api:buildbuddy_api_files",
        "//devinfra/ci/skills/cihealth:cihealth_files",
        "//devinfra/claude/skills/web_selfcheck:web_selfcheck_files",
        "//devinfra/gc:clean_workspaces_files",
        "//devinfra/js/debundle/skills/debundle_architect:debundle_architect_files",
        "//devinfra/js/debundle/skills/debundle_intake:debundle_intake_files",
        "//devinfra/js/debundle/skills/debundle_integrator:debundle_integrator_files",
        "//devinfra/js/debundle/skills/debundle_lane_worker:debundle_lane_worker_files",
        "//devinfra/js/debundle/skills/debundle_mint_names:debundle_mint_names_files",
        "//devinfra/js/debundle/skills/debundle_orchestrator:debundle_orchestrator_files",
        "//devinfra/js/debundle/skills/debundle_plan_work:debundle_plan_work_files",
        "//devinfra/js/debundle/skills/debundle_stabilize:debundle_stabilize_files",
        "//skills/backtrace:backtrace_files",
        "//skills/branch_splitter:branch_splitter_files",
        "//skills/followups:followups_files",
        "//skills/forensic_surgeon:forensic_surgeon_files",
        "//skills/forgejo:forgejo_files",
        "//skills/freecad:freecad_files",
        "//skills/google_photos_link:google_photos_link_files",
        "//skills/ground_skill:ground_skill_files",
        "//skills/ikea_3d_models:ikea_3d_models_files",
        "//skills/info_gathering:info_gathering_files",
        "//skills/knowledge_hygiene:knowledge_hygiene_files",
        "//skills/later:later_files",
        "//skills/lint_audit:lint_audit_files",
        "//skills/mcp_design:mcp_design_files",
        "//skills/pave:pave_files",
        "//skills/readback:readback_files",
        "//skills/reverse_engineer:reverse_engineer_files",
        "//skills/session_logs:session_logs_files",
        "//skills/superforecaster:superforecaster_files",
        "//skills/update_deps:update_deps_files",
        "//skills/verify_docs:verify_docs_files",
    ],
    out = "all_skills.skill",
    visibility = ["//visibility:public"],
)

py_library(
    name = "skill_spec",
    srcs = ["skill_spec.py"],
    visibility = ["//visibility:public"],
)

py_library(
    name = "frontmatter_validation",
    srcs = ["frontmatter_validation.py"],
    deps = ["@pypi//pyyaml"],
)

py_binary(
    name = "frontmatter_validation_bin",
    main_module = "skills.frontmatter_validation",
    visibility = ["//visibility:public"],
    deps = [":frontmatter_validation"],
)

py_library(
    name = "skill_frontmatter_test_lib",
    srcs = ["skill_frontmatter_test.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":frontmatter_validation",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_frontmatter",
    srcs = ["test_frontmatter.py"],
    deps = [
        ":frontmatter_validation",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
