load("//devinfra/oci:defs.bzl", "oci_layout_py")
load("//devinfra/python:defs.bzl", "py_binary", "py_library")

oci_layout_py(
    name = "freecad_test_image",
    image = "@freecad_test_linux_amd64",
)

py_library(
    name = "run_eval",
    srcs = ["run_eval.py"],
    deps = [
        "//mcp_infra/exec/docker:types",
        # Carries the freecad `.skill` archive as a data dep and the
        # SkillSpec read by stage_skill().
        "//skills/eval_infra:skill_staging",
        "//skills/freecad:freecad_skill_spec",
        "//skills/freecad/eval:freecad_test_image",
        "@rules_python//python/runfiles",
        "@pypi//claude_agent_sdk",
        "//devinfra/oci",
    ],
)

py_binary(
    name = "run_eval_bin",
    data = [
        "baseplate/CHECKLIST.md",
        "baseplate/TASK.md",
        "//mcp_infra/exec:docker_launcher",
    ],
    main_module = "skills.freecad.eval.run_eval",
    deps = [":run_eval"],
)
