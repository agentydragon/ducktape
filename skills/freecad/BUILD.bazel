load("@rules_oci//oci:defs.bzl", "oci_load")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("//devinfra/testing:defs.bzl", "py_test")
load("//skills:defs.bzl", "skill_package")

skill_package(
    name = "freecad",
    srcs = [
        "01_sketch_and_parts.py",
        "02_techdraw_and_dims.py",
        "SKILL.md",
        "build_cube_with_hole.py",
        "export_dxf.py",
        "export_page.py",
        "parametric_rect.py",
        "render_dxf.py",
        "render_fcstd.py",
    ],
)

py_library(
    name = "render_dxf",
    srcs = ["render_dxf.py"],
    imports = ["../.."],
    deps = [
        "@pypi//ezdxf",
        "@pypi//matplotlib",
        "@pypi//pillow",
    ],
)

py_binary(
    name = "render_dxf_bin",
    imports = ["../.."],
    main_module = "skills.freecad.render_dxf",
    deps = [":render_dxf"],
)

py_library(
    name = "compare_dxf",
    testonly = True,
    srcs = ["compare_dxf.py"],
    imports = ["../.."],
)

py_library(
    name = "compare_svg",
    testonly = True,
    srcs = ["compare_svg.py"],
    imports = ["../.."],
)

py_library(
    name = "compare_pdf",
    testonly = True,
    srcs = ["compare_pdf.py"],
    imports = ["../.."],
)

oci_load(
    name = "freecad_test_load",
    testonly = True,
    image = "@freecad_test_linux_amd64",
    repo_tags = ["freecad-test:pinned"],
)

filegroup(
    name = "freecad_test_tarball",
    testonly = True,
    srcs = [":freecad_test_load"],
    output_group = "tarball",
)

py_test(
    name = "test_container_primitives",
    size = "medium",
    srcs = ["test_container_primitives.py"],
    data = [
        ":freecad_test_tarball",
        "//third_party/debian_slim:tarball",
    ],
    requires_docker = True,
    deps = [
        "//third_party/debian_slim:rlocations",
        "//util:oci",
        "//util/testing:container_logs",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_render_dxf",
    srcs = ["test_render_dxf.py"],
    data = [
        "golden/rect.dxf",
        "golden/rect.png",
    ],
    deps = [
        ":render_dxf",
        "//util/bazel:runfiles",
        "@pypi//pillow",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_render_3d",
    size = "medium",
    srcs = ["test_render_3d.py"],
    data = [
        "build_cube_with_hole.py",
        "golden/cube_with_hole.png",
        "render_fcstd.py",
        ":freecad_test_tarball",
    ],
    requires_docker = True,
    deps = [
        "//util:oci",
        "//util/bazel:runfiles",
        "//util/testing:container_logs",
        "//util/testing:undeclared_outputs",
        "@pypi//pillow",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_export_formats",
    size = "medium",
    srcs = ["test_export_formats.py"],
    data = [
        "golden/rect.dxf",
        "golden/rect.pdf",
        "golden/rect.svg",
        "parametric_rect.py",
        ":freecad_test_tarball",
    ],
    requires_docker = True,
    deps = [
        ":compare_dxf",
        ":compare_pdf",
        ":compare_svg",
        "//util:oci",
        "//util/bazel:runfiles",
        "//util/testing:container_logs",
        "//util/testing:undeclared_outputs",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//testcontainers",
    ],
)
