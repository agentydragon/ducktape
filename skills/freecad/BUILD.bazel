load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("//devinfra/freecad_appimage:defs.bzl", "freecad_appimage_rloc")
load("//devinfra/oci:defs.bzl", "oci_layout_rloc")
load("//devinfra/testing:defs.bzl", "py_test")
load("//skills:defs.bzl", "skill_package")

skill_package(
    name = "freecad",
    srcs = [
        "SKILL.md",
        "build_bearing_block.py",
        "build_bearing_block_techdraw.py",
        "build_compound.py",
        "build_cube_with_hole.py",
        "debug/qt_shutdown_segfault.md",
        "export_page.py",
        "freecad_helpers.py",
        "parametric_sketch.py",
        "render_debug_edges.py",
        "render_debug_faces.py",
        "render_dxf.py",
        "render_fcstd.py",
        "render_multi_angle.py",
    ],
)

py_library(
    name = "render_dxf",
    srcs = ["render_dxf.py"],
    imports = ["../.."],
    deps = [
        "@pypi//ezdxf",
        "@pypi//matplotlib",
        "@pypi//pillow",
    ],
)

py_binary(
    name = "render_dxf_bin",
    imports = ["../.."],
    main_module = "skills.freecad.render_dxf",
    deps = [":render_dxf"],
)

# FreeCAD AppImage for subprocess-based tests (no Docker required)
freecad_appimage_rloc(
    name = "freecad_appimage",
    testonly = True,
)

oci_layout_rloc(
    name = "freecad_test",
    testonly = True,
    image = "@freecad_test_linux_amd64",
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    data = [":freecad_appimage"],
    imports = ["../.."],
    deps = [
        "//util:oci",
        "//util/bazel:runfiles",
        "//util/testing:container_logs",
        "//util/testing:otel_tracing",
        "@pypi//opentelemetry_api",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_container_primitives",
    size = "medium",
    srcs = ["test_container_primitives.py"],
    data = [
        ":freecad_test",
        "//third_party/containers:debian_slim",
    ],
    requires_docker = True,
    deps = [
        ":conftest",
        "//third_party/containers:rlocations",
        "//util:oci",
        "//util/testing:container_logs",
        "@pypi//opentelemetry_api",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

