load("@rules_pkg//pkg:mappings.bzl", "pkg_files", "strip_prefix")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//devinfra/oci:defs.bzl", "oci_layout_rloc")
load("//devinfra/python:defs.bzl", "py_library", "py_test")

# skill_package can't handle cross-package srcs (strip_prefix.from_pkg() loses
# subdirectory structure for files from other packages). Build the tarball manually.
pkg_files(
    name = "freecad_local_files",
    srcs = [
        "SKILL.md",
        "debug/qt_shutdown_segfault.md",
        "gotchas.md",
        "interactive.md",
        "partdesign.md",
        "sketcher.md",
        "techdraw.md",
    ],
    strip_prefix = strip_prefix.from_pkg(),
)

pkg_files(
    name = "freecad_examples_files",
    srcs = [
        "//skills/freecad/examples:export_page.py",
        "//skills/freecad/examples:freecad_helpers.py",
        "//skills/freecad/examples:render_debug_edges.py",
        "//skills/freecad/examples:render_debug_faces.py",
        "//skills/freecad/examples:render_dxf.py",
        "//skills/freecad/examples:render_fcstd.py",
        "//skills/freecad/examples:render_multi_angle.py",
        "//skills/freecad/examples:verify_fcstd_load.py",
    ],
    prefix = "examples",
    strip_prefix = strip_prefix.files_only(),
)

pkg_files(
    name = "freecad_bearing_block_files",
    srcs = [
        "//skills/freecad/examples/bearing_block:build.py",
        "//skills/freecad/examples/bearing_block:build_techdraw.py",
    ],
    prefix = "examples/bearing_block",
    strip_prefix = strip_prefix.files_only(),
)

pkg_files(
    name = "freecad_bracket_files",
    srcs = ["//skills/freecad/examples/bracket:parametric_sketch.py"],
    prefix = "examples/bracket",
    strip_prefix = strip_prefix.files_only(),
)

pkg_files(
    name = "freecad_compound_files",
    srcs = ["//skills/freecad/examples/compound:build.py"],
    prefix = "examples/compound",
    strip_prefix = strip_prefix.files_only(),
)

pkg_files(
    name = "freecad_cube_with_hole_files",
    srcs = ["//skills/freecad/examples/cube_with_hole:build.py"],
    prefix = "examples/cube_with_hole",
    strip_prefix = strip_prefix.files_only(),
)

pkg_tar(
    name = "freecad_tar",
    srcs = [
        ":freecad_bearing_block_files",
        ":freecad_bracket_files",
        ":freecad_compound_files",
        ":freecad_cube_with_hole_files",
        ":freecad_examples_files",
        ":freecad_local_files",
    ],
    package_dir = "freecad",
    visibility = ["//visibility:public"],
)

# FreeCAD conda binaries for subprocess-based tests.
# Referenced directly in data deps (not via filegroup) to preserve runfiles
# from the conda environment — filegroup only propagates DefaultInfo.files.

filegroup(
    name = "freecad_mcp_addon",
    testonly = True,
    srcs = ["@freecad_mcp//:addon"],
)

oci_layout_rloc(
    name = "freecad_test",
    testonly = True,
    image = "@freecad_test_linux_amd64",
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    data = [
        "//skills/freecad/conda:freecadcmd",
    ],
    visibility = ["//skills/freecad:__subpackages__"],
    deps = [
        "//util:oci",
        "//util/bazel:runfiles",
        "//util/bazel:subprocess",
        "//util/testing:container_logs",
        "//util/testing:otel_tracing",
        "@pypi//opentelemetry_api",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_interactive",
    size = "medium",
    srcs = ["test_interactive.py"],
    data = [
        ":freecad_mcp_addon",
        "//skills/freecad/conda:freecadcmd",
    ],
    deps = [
        ":conftest",
        "//util/bazel:runfiles",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
