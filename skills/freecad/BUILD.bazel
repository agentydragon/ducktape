load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("//devinfra/oci:defs.bzl", "oci_layout_rloc")
load("//devinfra/testing:defs.bzl", "py_test")
load("//skills:defs.bzl", "skill_package")

skill_package(
    name = "freecad",
    srcs = [
        "01_sketch_and_parts.py",
        "02_techdraw_and_dims.py",
        "SKILL.md",
        "build_cube_with_hole.py",
        "export_page.py",
        "parametric_rect.py",
        "parametric_sketch.py",
        "render_dxf.py",
        "render_fcstd.py",
    ],
)

py_library(
    name = "render_dxf",
    srcs = ["render_dxf.py"],
    imports = ["../.."],
    deps = [
        "@pypi//ezdxf",
        "@pypi//matplotlib",
        "@pypi//pillow",
    ],
)

py_binary(
    name = "render_dxf_bin",
    imports = ["../.."],
    main_module = "skills.freecad.render_dxf",
    deps = [":render_dxf"],
)

oci_layout_rloc(
    name = "freecad_test",
    testonly = True,
    image = "@freecad_test_linux_amd64",
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    imports = ["../.."],
    deps = [
        "//util:oci",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_container_primitives",
    size = "medium",
    srcs = ["test_container_primitives.py"],
    data = [
        ":freecad_test",
        "//third_party/containers:debian_slim",
    ],
    requires_docker = True,
    deps = [
        ":conftest",
        "//third_party/containers:rlocations",
        "//util:oci",
        "//util/bazel:runfiles",
        "//util/testing:container_logs",
        "//util/testing:undeclared_outputs",
        "@pypi//pillow",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_render_dxf",
    srcs = ["test_render_dxf.py"],
    data = [
        "golden/rect.dxf",
        "golden/rect.png",
    ],
    deps = [
        ":render_dxf",
        "//util/bazel:runfiles",
        "@pypi//pillow",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_render_3d",
    size = "medium",
    srcs = ["test_render_3d.py"],
    data = [
        "build_cube_with_hole.py",
        "golden/cube_with_hole.png",
        "render_fcstd.py",
        ":freecad_test",
    ],
    requires_docker = True,
    deps = [
        ":conftest",
        "//util:oci",
        "//util/bazel:runfiles",
        "//util/testing:container_logs",
        "//util/testing:undeclared_outputs",
        "@pypi//pillow",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_parametric_sketch",
    size = "medium",
    srcs = ["test_parametric_sketch.py"],
    data = [
        "export_page.py",
        "golden/bracket.dxf",
        "golden/bracket.pdf",
        "golden/bracket.svg",
        "parametric_sketch.py",
        ":freecad_test",
    ],
    requires_docker = True,
    deps = [
        ":conftest",
        "//skills/freecad/testing:compare",
        "//util:oci",
        "//util/bazel:runfiles",
        "//util/testing:container_logs",
        "//util/testing:undeclared_outputs",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_export_formats",
    size = "medium",
    srcs = ["test_export_formats.py"],
    data = [
        "export_page.py",
        "golden/rect.dxf",
        "golden/rect.pdf",
        "golden/rect.svg",
        "parametric_rect.py",
        ":freecad_test",
    ],
    requires_docker = True,
    deps = [
        ":conftest",
        "//skills/freecad/testing:compare",
        "//util:oci",
        "//util/bazel:runfiles",
        "//util/testing:container_logs",
        "//util/testing:undeclared_outputs",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//testcontainers",
    ],
)
