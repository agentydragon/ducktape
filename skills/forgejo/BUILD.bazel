load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")
load("//skills:defs.bzl", "skill_package")

skill_package(
    name = "forgejo",
    srcs = [
        "SKILL.md",
        "scripts/forgejo.py",
    ],
)

py_library(
    name = "forgejo_lib",
    srcs = ["scripts/forgejo.py"],
    visibility = ["//visibility:public"],
    deps = ["@pypi//httpx"],
)

py_binary(
    name = "cli",
    srcs = ["scripts/forgejo.py"],
    main = "scripts/forgejo.py",
    visibility = ["//visibility:public"],
    deps = ["@pypi//httpx"],
)

py_test(
    name = "test_forgejo",
    srcs = ["test_forgejo.py"],
    deps = [
        ":forgejo_lib",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
