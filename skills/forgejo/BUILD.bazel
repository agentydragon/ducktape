load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")
load("//skills:defs.bzl", "skill_package")

# skill_package(preserve_paths = True) requires same-package files, so scripts/
# must stay part of this package rather than getting a generated BUILD.
# gazelle:exclude scripts
# gazelle:resolve py skills.forgejo.scripts.forgejo //skills/forgejo:forgejo_lib

# keep: srcs lives in the excluded scripts/; the resolve above points here
py_library(
    name = "forgejo_lib",
    srcs = ["scripts/forgejo.py"],
    visibility = ["//visibility:public"],
    deps = [
        "@pypi//httpx",
        "@pypi//pydantic",
    ],
)

skill_package(
    name = "forgejo",
    srcs = [
        "SKILL.md",
        "scripts/forgejo.py",
    ],
)

py_binary(
    name = "cli",
    imports = ["../.."],
    main_module = "skills.forgejo.scripts.forgejo",
    visibility = ["//visibility:public"],
    deps = [":forgejo_lib"],
)

py_test(
    name = "test_forgejo",
    srcs = ["test_forgejo.py"],
    deps = [
        "//:conftest",
        "//skills/forgejo:forgejo_lib",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
