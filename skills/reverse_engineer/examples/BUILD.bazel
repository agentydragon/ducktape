load("@io_bazel_rules_go//go:def.bzl", "go_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

exports_files(
    [
        "garble_hash_fix.patch",
        "garble_re_recipe.sh",
        "pclntool.go",
    ],
    visibility = [
        "//skills/reverse_engineer:__pkg__",
        "//third_party:__pkg__",
    ],
)

go_binary(
    name = "pclntool",
    srcs = ["pclntool.go"],
    pure = "on",
)

sh_test(
    name = "test_go_objdump_demo",
    srcs = ["test_scaffold.sh"],
    data = [
        "garble_re_recipe.sh",
        ":pclntool",
        "//skills/reverse_engineer/cmd/garble_target:srcs",
        "//third_party:go.mod",
        "//third_party:go.sum",
        "@cc_mvdan_garble//:garble",
        "@com_github_goretk_redress//:redress",
        "@com_github_mandiant_goresym//:GoReSym",
        "@io_bazel_rules_go//go",
    ],
    env = {
        "GARBLE": "$(rlocationpath @cc_mvdan_garble//:garble)",
        "GO": "$(rlocationpath @io_bazel_rules_go//go:go)",
        "GORESYM": "$(rlocationpath @com_github_mandiant_goresym//:GoReSym)",
        "PCLNTOOL": "$(rlocationpath :pclntool)",
        "RECIPE": "$(rlocationpath garble_re_recipe.sh)",
        "REDRESS": "$(rlocationpath @com_github_goretk_redress//:redress)",
    },
)
