load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

py_library(
    name = "catalog",
    srcs = ["catalog.py"],
    visibility = ["//visibility:public"],
    deps = [":ollama"],
)

py_library(
    name = "policies",
    srcs = ["policies.py"],
    visibility = ["//visibility:public"],
    deps = [":catalog"],
)

py_library(
    name = "nix",
    srcs = ["nix.py"],
    deps = [
        ":catalog",
        ":policies",
        "//util/bazel:workspace",
    ],
)

py_binary(
    name = "generate_nix",
    main_module = "model_catalog.nix",
    visibility = ["//visibility:public"],
    deps = [":nix"],
)

py_test(
    name = "test_nix",
    srcs = ["test_nix.py"],
    data = ["claude-wrappers.json"],
    deps = [
        ":nix",
        "//:conftest",
        "//util/bazel:runfiles",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_policies",
    srcs = ["test_policies.py"],
    deps = [
        ":catalog",
        ":policies",
        "//:conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "ollama",
    srcs = ["ollama.py"],
    visibility = ["//visibility:public"],
)
