# gazelle:ignore
load("@aspect_rules_py//py:defs.bzl", "py_image_layer", aspect_py_binary = "py_binary")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("//props:oci.bzl", "py_image_entrypoint", "py_image_env")
load("//tools/testing:defs.bzl", "py_test")

py_library(
    name = "webhook_inbox",
    srcs = ["webhook_inbox.py"],
    data = glob(["templates/**"]),
    visibility = ["//visibility:public"],
    deps = [
        "@pypi//compact_json",
        "@pypi//cryptography",
        "@pypi//fastapi",
        "@pypi//jinja2",
        "@pypi//starlette",
    ],
)

py_binary(
    name = "gen_key",
    srcs = ["gen_key.py"],
    deps = ["@pypi//cryptography"],
)

py_test(
    name = "test_webhook_inbox",
    srcs = ["test_webhook_inbox.py"],
    imports = ["."],
    deps = [
        ":webhook_inbox",
        "@pypi//cryptography",
        "@pypi//fastapi",
        "@pypi//httpx",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//starlette",
    ],
)

# --- OCI Image ---

py_binary(
    name = "server",
    srcs = ["server.py"],
    imports = ["."],
    deps = [
        ":webhook_inbox",
        "@pypi//uvicorn",
    ],
)

aspect_py_binary(
    name = "server_bin",
    srcs = ["server.py"],
    imports = ["."],
    main = "server.py",
    deps = [
        ":webhook_inbox",
        "@pypi//uvicorn",
    ],
)

py_image_layer(
    name = "layers",
    binary = ":server_bin",
)

oci_image(
    name = "image",
    base = "@debian_slim_linux_amd64",
    entrypoint = py_image_entrypoint("server_bin"),
    env = py_image_env("server_bin"),
    exposed_ports = ["8000/tcp"],
    tars = [":layers"],
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["webhook-inbox:latest"],
)
