    name = "adgn_trivial_patterns",
    srcs = ["tools/trivial_patterns.py"],
    main = "tools/trivial_patterns.py",
    deps = [":adgn"],
)

ruff_test(
    name = "ruff",
    srcs = [":adgn"],
)
