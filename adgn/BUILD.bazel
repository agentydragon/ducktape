# CLI entry points
py_binary(
    name = "adgn_agent",
    srcs = ["agent/cli.py"],
    main = "agent/cli.py",
    deps = [
        ":adgn",
        "@pypi//fastmcp",
        "@pypi//rich",
        "@pypi//typer",
