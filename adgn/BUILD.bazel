        "//openai_utils:model",
        "@pypi//aiodocker",
        "@pypi//aiosqlite",
        "@pypi//anthropic",
        "@pypi//anyio",
        "@pypi//claude_code_sdk",
        "@pypi//docker",
        "@pypi//fastapi",
        "@pypi//fastmcp",
