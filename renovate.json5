{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  dependencyDashboard: true,
  prCreation: "approval",
  // The manifest regeneration workflow pushes to Renovate's branches as this
  // App; Renovate keeps rebasing a branch whose only foreign commits are its.
  gitIgnoredAuthors: ["281469510+ducktape-automation[bot]@users.noreply.github.com"],
  // Keep approved updates arriving as a controlled stream. This limits the
  // number of independently merged changes that can be waiting for devel CI.
  prConcurrentLimit: 3,
  prHourlyLimit: 1,
  // Renovate's native Nix manager is opt-in while it remains in beta. It owns
  // flake input updates; release artifacts under nix/artifact-pins.json have
  // their own sync-pins workflow and are intentionally not part of this.
  nix: {
    enabled: true,
  },
  // The flux manager defaults to bootstrap's gotk-components.yaml only. Scan
  // the hand-written manifests under cluster/k8s for HelmRelease/HelmRepository
  // pins and image references in Helm values; generated `*.k8s.yaml` files are
  // in ignorePaths and their pins live in the cdk8s custom manager below.
  flux: {
    managerFilePatterns: ["/^cluster\\/k8s\\/.+\\.ya?ml$/"],
  },
  // Scan ordinary Kubernetes resources for image references. Flux's
  // ImageUpdateAutomation remains the owner of resources carrying an
  // $imagepolicy marker; this manager covers the remaining pins.
  kubernetes: {
    managerFilePatterns: ["/^cluster\\/k8s\\/.+\\.ya?ml$/"],
  },
  customManagers: [
    {
      // Versions the cdk8s generators render into cluster/k8s/**/*.k8s.yaml,
      // each behind a `# renovate:` comment (format: cluster/cdk8s/AGENTS.md).
      // The first form names the dependency and the next line's last string
      // literal is the version; the bare `datasource=docker` form reads a whole
      // image reference. Either may sit on the line after an opening `(`.
      // .github/workflows/renovate-regenerate.yml regenerates the manifests.
      customType: "regex",
      managerFilePatterns: ["/^cluster\\/cdk8s\\/.+\\.py$/"],
      matchStrings: [
        '# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)(?: registryUrl=(?<registryUrl>\\S+))?(?: versioning=(?<versioning>\\S+))?\\n(?:[^\\n]*\\(\\n)?[^\\n]*"(?<currentValue>[^"@\\s]+)(?:@(?<currentDigest>sha256:[0-9a-f]+))?"[^"\\n]*\\n',
        '# renovate: datasource=(?<datasource>docker)\\n(?:[^\\n]*\\(\\n)?[^\\n]*"(?<depName>[^"@:\\s]+)(?::(?<currentValue>[^"@\\s]+))?(?:@(?<currentDigest>sha256:[0-9a-f]+))?"[^"\\n]*\\n',
      ],
      depTypeTemplate: "cdk8s",
    },
    {
      // rules_tf keeps its hermetic provider mirror in a nonstandard MODULE.bazel map.
      customType: "regex",
      managerFilePatterns: ["/^MODULE\\.bazel$/"],
      matchStrings: ['"[^"\\n]+":\\s*"(?<packageName>[^"\\n]+/[^"\\n]+):(?<currentValue>\\d+\\.\\d+\\.\\d+)"'],
      datasourceTemplate: "terraform-provider",
      versioningTemplate: "hashicorp",
      depTypeTemplate: "terraform_provider_mirror",
    },
  ],
  // The generated Bazel lockfiles are ignored below. Extend Renovate's pip
  // requirements matcher to the canonical .in inputs so those environments
  // remain visible; retain the default .txt/.pip matcher as well because
  // homeassistant/requirements.override.txt is a real source input.
  pip_requirements: {
    managerFilePatterns: [
      "/(^|\\/)[\\w-]*requirements([-._]\\w+)?\\.(txt|pip)$/",
      "/(^|\\/)requirements\\.in$/",
    ],
  },
  ignorePaths: [
    // Rendered by //cluster/cdk8s:generate_manifests; the cdk8s custom manager
    // updates the generator source instead.
    "cluster/k8s/**/*.k8s.yaml",
    "props/specimens/**",
    "devinfra/claude/web_env/**",
    // Generated from pyproject.toml; Renovate should update the source instead.
    "requirements_bazel.txt",
    // Generated by //homeassistant:requirements.update from requirements.in.
    "homeassistant/requirements.txt",
    // Generated by //tana/litellm_proxy:requirements.update from requirements.in.
    // Renovate must update the input; transitive companion pins are not direct deps.
    "tana/litellm_proxy/requirements.txt",
    // Rendered by crate-universe; the canonical Cargo files remain visible.
    "Cargo.Bazel.lock",
    // The ActivityWatch nested crate universe renders the same kind of lock.
    "third_party/activitywatch/Cargo.Bazel.lock",
    // Bazel owns these locks; Renovate should watch their package.json inputs.
    "pnpm-lock.yaml",
    "third_party/manifold_mcp_server/pnpm-lock.yaml",
    // Generated from pixi.toml; keep the manifest as Renovate's input.
    "skills/freecad/conda/pixi.lock",
    // These npm inputs are coupled to Nix package metadata and must move
    // together with the version/hash or release-specific patch in the Nix
    // consumer; an npm-only Renovate PR would leave the Nix build invalid.
    "nix/packages/prettier/package.json",
    "nix/packages/prettier/package-lock.json",
    "openclaw/npm_wrapper/package.json",
    "openclaw/npm_wrapper/package-lock.json",
  ],
  packageRules: [
    {
      // These managers can alter the Bazel graph, generated code, toolchains,
      // or deployed runtime behavior. Keep their non-patch updates isolated
      // so a red devel result still has a small failure surface.
      description: "Keep high-risk dependency updates isolated",
      matchManagers: [
        "bazel",
        "cargo",
        "gomod",
        "npm",
        "pip_requirements",
        "pep621",
        "nix",
        "flux",
        "kubernetes",
        "helm-values",
      ],
      matchUpdateTypes: ["major", "minor", "pin", "pinDigest", "digest"],
      groupName: null,
      automerge: false,
      minimumReleaseAge: "3 days",
    },
    {
      description: "Keep cdk8s generator pin updates isolated",
      matchDepTypes: ["cdk8s"],
      matchUpdateTypes: ["major", "minor", "patch", "pin", "pinDigest", "digest"],
      groupName: null,
      automerge: false,
      minimumReleaseAge: "3 days",
    },
    {
      description: "Move the Prometheus Operator CRD source with kube-prometheus-stack",
      matchDepTypes: ["cdk8s"],
      matchPackageNames: ["kube-prometheus-stack", "prometheus-operator/prometheus-operator"],
      groupName: "kube-prometheus-stack",
    },
    {
      description: "Move the External Secrets CRD source with its chart",
      matchDepTypes: ["cdk8s"],
      matchPackageNames: ["external-secrets", "external-secrets/external-secrets"],
      groupName: "external-secrets",
    },
    {
      description: "Move the SeaweedFS CSI images with their chart source",
      matchDepTypes: ["cdk8s"],
      matchPackageNames: ["seaweedfs/seaweedfs-csi-driver", "chrislusf/seaweedfs-csi-driver"],
      groupName: "seaweedfs-csi-driver",
    },
    {
      description: "Keep mirrored Terraform provider updates isolated",
      matchDepTypes: ["terraform_provider_mirror"],
      matchUpdateTypes: ["major", "minor", "patch", "pin", "pinDigest", "digest"],
      groupName: null,
      automerge: false,
      minimumReleaseAge: "3 days",
    },
    {
      // Patch updates can be reviewed together when they stay within one
      // ecosystem. Do not create a cross-ecosystem bulk bump.
      description: "Batch Bazel patch updates only",
      matchManagers: ["bazel"],
      matchUpdateTypes: ["patch"],
      groupName: "Bazel patch updates",
      automerge: false,
    },
    {
      description: "Batch Rust patch updates only",
      matchManagers: ["cargo"],
      matchUpdateTypes: ["patch"],
      groupName: "Rust patch updates",
      automerge: false,
    },
    {
      description: "Batch Go patch updates only",
      matchManagers: ["gomod"],
      matchUpdateTypes: ["patch"],
      groupName: "Go patch updates",
      automerge: false,
    },
    {
      description: "Batch npm patch updates only",
      matchManagers: ["npm"],
      matchUpdateTypes: ["patch"],
      groupName: "npm patch updates",
      automerge: false,
    },
    {
      description: "Batch Python patch updates only",
      matchManagers: ["pip_requirements", "pep621"],
      matchUpdateTypes: ["patch"],
      groupName: "Python patch updates",
      automerge: false,
    },
    {
      description: "Batch Nix patch updates only",
      matchManagers: ["nix"],
      matchUpdateTypes: ["patch"],
      groupName: "Nix patch updates",
      automerge: false,
    },
    {
      description: "Keep deployed dependency patches isolated",
      matchManagers: ["flux", "kubernetes", "helm-values"],
      matchUpdateTypes: ["patch"],
      groupName: null,
      automerge: false,
      minimumReleaseAge: "3 days",
    },
    {
      description: "Leave Bazel-owned pnpm lock regeneration to Bazel",
      matchManagers: ["npm"],
      matchFileNames: [
        "package.json",
        "airlock/frontend/package.json",
        "props/frontend/package.json",
        "study_casino/frontend/package.json",
        "util/testing/frontend_visual/package.json",
        "x/rspcache/admin_ui/package.json",
        "third_party/manifold_mcp_server/package.json",
      ],
      skipArtifactsUpdate: true,
    },
    {
      description: "Leave Pixi lock regeneration to Bazel",
      matchManagers: ["pixi"],
      matchFileNames: ["skills/freecad/conda/pixi.toml"],
      skipArtifactsUpdate: true,
    },
    {
      description: "Review the community Claude Managed Agents provider manually",
      matchDatasources: ["terraform-provider"],
      matchPackageNames: ["modus-agendi/anthropic-claude-managed-agents"],
      automerge: false,
    },
  ],
}
