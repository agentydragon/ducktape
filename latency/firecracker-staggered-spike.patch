+                        "message",
+                        "count",
+                        "firstTimestamp",
+                        "lastTimestamp",
+                        "eventTime",
+                        "reportingComponent",
+                    )
+                    if k in item
+                }
+                for item in json.loads(raw)["items"]
+            ]
+            for uid, raw in zip(pods, event_lists, strict=True)
+        }
