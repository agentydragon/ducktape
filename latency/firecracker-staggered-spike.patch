+    async def sample_pods() -> None:
+        selector = f"{GROUP}/sandbox in ({live_name},{trust_name})"
+        while not stop.is_set():
+            raw = await cluster.kubectl("get", "pods", "-l", selector, "-o", "json", timeout_s=12)
+            now = datetime.now(UTC).isoformat()
+            for pod in json.loads(raw)["items"]:
+                metadata, spec = pod["metadata"], pod["spec"]
+                sandbox_name = metadata["labels"][f"{GROUP}/sandbox"]
+                uid = metadata["uid"]
+                condition: dict[str, Any] = next((c for c in pod["status"].get("conditions", []) if c["type"] == "PodScheduled"), {})
+                previous = pods.get(uid, {}).get("scheduling_condition")
+                pods[uid] = {
+                    "sandbox": "live" if sandbox_name == live_name else "trust",
+                    "name": metadata["name"],
+                    "created_at": metadata["creationTimestamp"],
+                    "node": spec.get("nodeName"),
+                    "scheduler": spec.get("schedulerName"),
+                    "node_selector": spec.get("nodeSelector"),
+                    "resources": [
+                        {"container": c["name"], **c.get("resources", {})}
+                        for c in spec["containers"] + spec.get("initContainers", [])
+                    ],
+                    "overhead": spec.get("overhead"),
+                    "scheduling_condition": condition,
+                }
+                if previous != condition:
+                    changes.append({"uid": uid, "observed_at": now, "condition": condition})
+                if sandbox_name == live_name and condition.get("status") == "True" and not scheduled.is_set():
+                    gate["live_schedule_observed_at"] = now
+                    scheduled.set()
+            await asyncio.sleep(0.8)
+
+    async def write_scheduler_evidence() -> None:
