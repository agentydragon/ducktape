{
  "agents": {
    "defaults": {
      "model": {
        "primary": "litellm-subscription/codex-gpt-5.6-luna"
      },
      "sandbox": {
        "mode": "off"
      },
      "skills": []
    },
    "list": [
      {
        "id": "solo",
        "name": "Solo"
      }
    ]
  },
  "commands": {
    "config": false,
    "mcp": false,
    "restart": false
  },
  "cron": {
    "enabled": false
  },
  "gateway": {
    "auth": {
      "mode": "trusted-proxy",
      "trustedProxy": {
        "allowLoopback": true,
        "allowUsers": ["agentydragon"],
        "requiredHeaders": ["x-authentik-email", "x-forwarded-host", "x-forwarded-proto"],
        "userHeader": "x-authentik-username"
      }
    },
    "bind": "loopback",
    "controlUi": {
      "allowedOrigins": ["https://openclaw.allegedly.works"],
      "dangerouslyDisableDeviceAuth": true
    },
    "mode": "local",
    "trustedProxies": ["127.0.0.0/8"]
  },
  "hooks": {
    "internal": {
      "entries": {
        "session-memory": {
          "enabled": true,
          "llmSlug": false,
          "messages": 15
        }
      }
    }
  },
  "models": {
    "providers": {
      "litellm-subscription": {
        "agentRuntime": {
          "id": "openclaw"
        },
        "api": "anthropic-messages",
        "apiKey": "${OPENCLAW_LITELLM_API_KEY}",
        "baseUrl": "http://litellm.litellm.svc.cluster.local:4000/v1",
        "models": [
          {
            "contextWindow": 200000,
            "id": "codex-gpt-5.6-luna",
            "input": ["text", "image"],
            "maxTokens": 64000,
            "name": "GPT-5.6 Luna (Codex subscription via LiteLLM)",
            "reasoning": true
          }
        ],
        "request": {
          "allowPrivateNetwork": true
        }
      }
    }
  },
  "tools": {
    "allow": [
      "exec",
      "process",
      "read",
      "write",
      "edit",
      "apply_patch",
      "memory_get",
      "memory_search",
      "session_status"
    ],
    "elevated": {
      "enabled": false
    },
    "fs": {
      "workspaceOnly": true
    },
    "sessions": {
      "visibility": "agent"
    }
  }
}
