load("//devinfra/python:defs.bzl", "py_library")

package(default_testonly = True)

py_library(
    name = "echo_server",
    srcs = ["echo_server.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//openai_utils:pydantic_strict_mode",
        "@pypi//fastmcp_slim",
    ],
)

py_library(
    name = "fixtures",
    srcs = ["fixtures.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":echo_server",
        "//agent_core:mcp_provider",
        "//agent_core:tool_provider",
