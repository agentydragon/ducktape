        "@pypi//pytest",
    ],
)

py_library(
    name = "responses",
    srcs = ["responses.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":echo_server",
        "//agent_core/testing:responses",
        "//mcp_infra/testing:naming",
        "//openai_utils:model",
        "@pypi//pydantic",
        "@pypi//pytest",
    ],
