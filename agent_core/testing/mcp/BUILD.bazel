load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_testonly = True)

py_library(
    name = "echo_server",
    srcs = ["echo_server.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//mcp_infra:naming",
        "//mcp_infra/enhanced:flat_mixin",
        "//openai_utils:pydantic_strict_mode",
    ],
)

py_library(
    name = "fixtures",
    srcs = ["fixtures.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":echo_server",
        "//agent_core:events",
        "//agent_core:mcp_provider",
        "//agent_core:tool_provider",
        "//mcp_infra:naming",
        "//mcp_infra:prefix",
        "@pypi//fastmcp_slim",
        "@pypi//pytest",
    ],
)

py_library(
    name = "responses",
    srcs = ["responses.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":echo_server",
        "//agent_core/testing:responses",
        "//mcp_infra:mounted",
        "//mcp_infra:naming",
        "//mcp_infra/exec:models",
        "//mcp_infra/exec/docker:server",
        "//openai_utils:model",
        "@pypi//fastmcp_slim",
        "@pypi//pydantic",
        "@pypi//pytest",
    ],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    deps = [
        ":responses",
        "//agent_core/testing:responses",
        "@pypi//pytest",
    ],
)

py_test(
    name = "test_responses",
    srcs = ["test_responses.py"],
    deps = [
        ":conftest",
        ":responses",
        "//:conftest",
        "//agent_core:conftest",
        "//agent_core/testing:matchers",
        "//mcp_infra:prefix",
        "//openai_utils:model",
        "@pypi//pydantic",
        "@pypi//pyhamcrest",
        "@pypi//pytest_bazel",
    ],
)
