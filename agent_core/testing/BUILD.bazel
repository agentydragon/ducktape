load("//devinfra/python:defs.bzl", "py_library")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

py_library(
    name = "fixtures",
    srcs = ["fixtures.py"],
    deps = [
        ":handlers",
        "//agent_core:events",
        "//agent_core:handler",
        "@pypi//pytest",
    ],
)

py_library(
    name = "handlers",
    srcs = ["handlers.py"],
    deps = [
        "//agent_core:events",
        "//agent_core:handler",
        "//agent_core:loop_control",
    ],
)

py_library(
    name = "matchers",
    srcs = ["matchers.py"],
    deps = [
        "//agent_core:events",
        "//agent_core:tool_provider",
        "@pypi//pyhamcrest",
    ],
)

py_library(
    name = "responses",
    srcs = ["responses.py"],
    deps = [
        "//openai_utils:builders",
        "//openai_utils:model",
        "@pypi//pydantic",
        "@pypi//pytest",
    ],
)
