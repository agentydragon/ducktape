{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Setup": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash devinfra/claude/web_setup_hook.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "claude-hook"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "claude-hook"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "claude-hook"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "claude-hook"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "claude-hook"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "claude-hook"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "claude-hook"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "claude-hook"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "claude-hook"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "claude-hook"
          }
        ]
      }
    ],
    "Elicitation": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "claude-hook"
          }
        ]
      }
    ],
    "ElicitationResult": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "claude-hook"
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "claude-hook"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "claude-hook"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "claude-hook"
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "claude-hook"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "claude-hook"
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "claude-hook"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "claude-hook"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bazel build:*)",
      "Bash(bazel info:*)",
      "Bash(bazel mod:*)",
      "Bash(bazel query:*)",
      "Bash(bazel run @bazel_gazelle//cmd/gazelle:*)",
      "Bash(bazel test:*)",
      "Bash(bb build:*)",
      "Bash(bb query:*)",
      "Bash(bb remote:*)",
      "Bash(bb test:*)",
      "Bash(bbapi artifact:*)",
      "Bash(bbapi invocation:*)",
      "Bash(bbapi target:*)",
      "Bash(bbr:*)",
      "Bash(flux reconcile:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh search:*)",
      "Bash(git log:*)",
      "Bash(kubectl get gitrepository:*)",
      "Bash(kubectl get grafanadatasource:*)",
      "Bash(kubectl get helmrelease:*)",
      "Bash(kubectl get imagerepository:*)",
      "Bash(kubectl get job:*)",
      "Bash(kubectl get kustomization:*)",
      "Bash(kubectl get networkpolicy:*)",
      "Bash(kubectl get ns:*)",
      "Bash(kubectl get pod:*)",
      "Bash(kubectl get pods:*)",
      "Bash(kubectl get receiver:*)",
      "Bash(kubectl get svc:*)",
      "Bash(kubectl get terraform:*)",
      "Bash(kubectl rollout restart:*)",
      "Bash(kubectl top:*)",
      "Bash(pre-commit run:*)",
      "Skill(followups)",
      "WebFetch(domain:docs.attic.rs)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "mcp__kubectl-local__*"
    ]
  }
}
