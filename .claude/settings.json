{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Setup": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uv tool install https://github.com/agentydragon/ducktape/releases/download/ducktape-ab388584/ducktape-0.1.0-py3-none-any.whl --force >&2"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uv tool install https://github.com/agentydragon/ducktape/releases/download/ducktape-ab388584/ducktape-0.1.0-py3-none-any.whl --force >&2; ~/.local/bin/claude-hook"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/claude-hook"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/claude-hook"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bazel build:*)",
      "Bash(bazel test:*)",
      "Bash(bazel info:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh search:*)",
      "Bash(gsettings get:*)",
      "Bash(kubectl describe:*)",
      "Bash(kubectl get pod:*)",
      "Bash(kubectl get terraform:*)",
      "Bash(kubectl logs:*)",
      "Bash(kubectl rollout restart:*)",
      "Bash(kubectl top:*)",
      "Bash(modinfo:*)",
      "Bash(nix search:*)",
      "WebFetch(domain:raw.githubusercontent.com)"
    ]
  }
}
