server {
    listen 80;
    server_name adgn.link www.adgn.link;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name adgn.link www.adgn.link;

    ssl_certificate /etc/letsencrypt/live/adgn.link/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/adgn.link/privkey.pem;

    location / {
        return 301 https://www.agentydragon.com;
    }

    location /nfc {
        return 302 https://www.agentydragon.com/nfc.html;
    }

    location /found {
        return 302 https://www.agentydragon.com/found.html;
    }

    location /furry-rationalists-telegram {
        return 302 https://furryrationalists.proofgrid.tech/;
    }

    location /effective-anthropomorphism-discord {
        return 302 https://discord.com/invite/Mcdsh757Ht;
    }
}
