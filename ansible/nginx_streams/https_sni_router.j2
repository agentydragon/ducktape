# TLS passthrough routing on port 443 using SNI inspection
# Matches *.test-cluster.agentydragon.com and forwards directly to the
# cluster control plane while all other hostnames terminate locally.

{% set sni_pattern = test_cluster_stream_sni_pattern %}
{% set cluster_backend = test_cluster_stream_backend | default('test-cluster:443') %}
{% set default_backend = nginx_stream_default_backend | default('127.0.0.1:4443') %}
{% set proxy_connect_timeout = test_cluster_stream_proxy_connect_timeout | default('15s') %}
{% set proxy_timeout = test_cluster_stream_proxy_timeout | default('300s') %}

map $ssl_preread_server_name $https_stream_upstream {
    hostnames;

    {{ sni_pattern }} test_cluster_backend;
    default default_https_backend;
}

upstream test_cluster_backend {
    server {{ cluster_backend }};
}

upstream default_https_backend {
    server {{ default_backend }};
}

server {
    listen 443;
    proxy_pass $https_stream_upstream;
    ssl_preread on;
    proxy_connect_timeout {{ proxy_connect_timeout }};
    proxy_timeout {{ proxy_timeout }};
}
