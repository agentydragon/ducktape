# /org/gnome/desktop/wm/keybindings/
[/]
move-to-workspace-down=['<Primary><Shift><Alt>Down']
move-to-workspace-left=['<Primary><Shift><Alt>Up']
move-to-workspace-right=['<Primary><Shift><Alt>Down']
move-to-workspace-up=['<Primary><Shift><Alt>Up']
switch-to-workspace-1=['<Super>Home', '<Primary><Super>1']
switch-to-workspace-2=['<Primary><Super>2']
switch-to-workspace-down=['<Primary><Super>Down', '<Primary><Super>j', '<Primary><Alt>Down']
switch-to-workspace-left=['<Primary><Alt>Up']
switch-to-workspace-right=['<Primary><Alt>Down']
switch-to-workspace-up=['<Primary><Super>Up', '<Primary><Super>k', '<Primary><Alt>Up']

# /org/gnome/shell/keybindings/

# /org/gnome/shell/extensions/pop-shell/
[/]
active-hint=false
active-hint-border-radius=uint32 0
gap-inner=uint32 0
gap-outer=uint32 0
pop-monitor-down=@as []
pop-monitor-left=@as []
pop-monitor-right=@as []
pop-monitor-up=@as []
pop-workspace-down=@as []
pop-workspace-up=@as []
show-title=true
smart-gaps=false
tile-by-default=true
tile-enter=['<Super>Return']

[tileable-wm]
key-bindings=false
