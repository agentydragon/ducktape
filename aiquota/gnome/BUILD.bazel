load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files", "strip_prefix")
load("@rules_pkg//pkg:zip.bzl", "pkg_zip")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//devinfra/lint:linters.bzl", "eslint_test")
load("//devinfra/python:defs.bzl", "py_test")

pkg_files(
    name = "extension_files",
    # Source files that GNOME Shell loads at runtime. Single source of
    # truth: the zip target, local devkit launcher, and render tests all
    # consume this package mapping.
    srcs = [
        "extension.js",
        "icons/claude-symbolic.svg",
        "icons/openai-symbolic.svg",
        "icons/zai-symbolic.svg",
        "metadata.json",
        "stylesheet.css",
    ],
    strip_prefix = strip_prefix.from_pkg(),
    visibility = ["//visibility:public"],
)

# The extension loads this shared implementation relative to extension.js. Keep
# the module beside it in the packaged extension while the source lives in the
# platform-neutral aiquota/shared package.
pkg_files(
    name = "shared_presentation_file",
    srcs = ["//aiquota/shared:presentation.js"],
    strip_prefix = strip_prefix.files_only(),
)

# GNOME extension zip distribution. Layout is the standard convention used by
# `gnome-extensions pack` and `gnome-extensions install --from-file`: the
# extension's files live at the root of the archive (no UUID-prefixed
# subdirectory). This is what gets shipped to users via the CI release pin
# and what the render tests + devkit launcher consume.
pkg_zip(
    name = "aiquota_zip",
    srcs = [
        ":extension_files",
        ":shared_presentation_file",
    ],
    out = "aiquota.zip",
    visibility = ["//visibility:public"],
)

js_library(
    name = "fake_daemon",
    testonly = True,
    srcs = ["fake-daemon.js"],
)

eslint_test(
    name = "fake_daemon_lint",
    srcs = [":fake_daemon"],
)

py_test(
    name = "test_render",
    size = "medium",
    srcs = ["test_render.py"],
    data = [
        ":aiquota_zip",
        ":fake_daemon",
        "//aiquota/testing:fixtures",
        "//gnome/test_image:gnome_shell_test",
    ],
    requires_docker = True,
    tags = ["visual"],
    deps = [
        "//:conftest",
        "//aiquota/testing:quota_fixtures",
        "//util:oci",
        "//util/bazel:runfiles",
        "//util/testing:gnome",
        "//util/testing:undeclared_outputs",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//testcontainers",
    ],
)

# Local iteration: install the bazel-built extension zip into the user's
# gnome-shell extension dir and launch a nested devkit shell.
sh_binary(
    name = "devkit",
    srcs = ["devkit.sh"],
    data = [
        ":aiquota_zip",
        "//aiquota:desktop_bin",
    ],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)
