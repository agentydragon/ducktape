# gazelle:exclude test_visual.py
load("@aspect_rules_esbuild//esbuild:defs.bzl", "esbuild")
load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config")
load("//devinfra/js:openapi.bzl", "js_openapi_schema")
load("//devinfra/js:spa_bundle.bzl", "spa_bundle")
load("//devinfra/js:ts_library.bzl", "ts_library")
load("//devinfra/js:typed_eslint.bzl", "typed_eslint_test")
load("//devinfra/js:vitest.bzl", "check_vitest_specs", "vitest_config")
load("//util/testing/frontend_visual:py_visual_test.bzl", "py_visual_test")
load(":vitest.bzl", "aiquota_vitest_test")

package(default_visibility = ["//visibility:public"])

TSCONFIG = ":tsconfig"

filegroup(
    name = "typed_lint_srcs",
    srcs = glob(
        [
            "*.ts",
            "*.tsx",
            "**/*.ts",
            "**/*.tsx",
        ],
        allow_empty = True,
    ),
)

filegroup(
    name = "typed_lint_program_data",
    srcs = [
        ":schema",
        "//:node_modules/@types/react-dom",
        "//:node_modules/happy-dom",
    ],
)

typed_eslint_test(
    name = "eslint_typed_test",
    srcs = ":typed_lint_srcs",
    extra_data = [
        ":main",
        ":typed_lint_program_data",
    ],
    tsconfig = "tsconfig.json",
)

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
)

# Wire types generated from the API's own OpenAPI document, so the dashboard's idea of a
# quota window is the Pydantic model rather than a hand-kept copy. Not checked in.
js_openapi_schema(
    name = "schema",
    generator = "//aiquota:export_schema_bin",
)

ts_library(
    name = "format",
    srcs = ["format.ts"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = ["//aiquota/shared:presentation"],
)

ts_library(
    name = "quotas",
    srcs = ["quotas.ts"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [":schema"],
)

# The board is the shareable half: the Haku Console renders it from its own shell, so it must
# stay free of page chrome and of anything that fetches.
ts_library(
    name = "board",
    srcs = ["board.tsx"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [
        ":format",
        ":quotas",
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//aiquota/shared:presentation",
    ],
)

ts_library(
    name = "dashboard",
    srcs = ["dashboard.tsx"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [
        ":board",
        ":format",
        ":quotas",
        "//:node_modules/@types/react",
        "//:node_modules/react",
    ],
)

ts_library(
    name = "app",
    srcs = ["app.tsx"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [
        ":dashboard",
        ":quotas",
        "//:node_modules/@types/react",
        "//:node_modules/react",
    ],
)

ts_library(
    name = "main",
    srcs = ["main.tsx"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [
        ":app",
        ":board_css",
        ":page_css",
        "//:node_modules/@types/react",
        "//:node_modules/@types/react-dom",
        "//:node_modules/react",
        "//:node_modules/react-dom",
    ],
)

# Split so an embedder takes the board's styles without the standalone page's body, margins
# and title chrome. //haku/console/frontend imports board.css into its own stylesheet.
js_library(
    name = "board_css",
    srcs = ["board.css"],
)

js_library(
    name = "page_css",
    srcs = ["page.css"],
)

spa_bundle(
    name = "bundle",
    entry_point = "main.tsx",
    jsx = "automatic",
    deps = [
        ":board_css",
        ":main",
        ":page_css",
    ],
)

# ── Test fixtures ──────────────────────────────────────────────────────────────
#
# Generated from the scenario YAML the GNOME renders and the CLI snapshot also use, by the
# Python that serves and renders it: `scenes.json` is exactly what `/v1/quotas` returns for
# each scenario, `format_cases.json` what the Python renderers print for every window in them.

genrule(
    name = "web_fixtures",
    testonly = True,
    outs = [
        "fixtures/scenes.json",
        "fixtures/format_cases.json",
    ],
    cmd = "$(location //aiquota/testing:export_web_fixtures_bin) --scenes $(location fixtures/scenes.json) " +
          "--format-cases $(location fixtures/format_cases.json)",
    tools = ["//aiquota/testing:export_web_fixtures_bin"],
)

js_library(
    name = "fixtures",
    testonly = True,
    srcs = [":web_fixtures"],
    tags = ["no-lint"],
)

# Single-file view so $(rootpath) resolves to one path.
filegroup(
    name = "scenes_json",
    testonly = True,
    srcs = ["fixtures/scenes.json"],
)

# ── Unit tests ─────────────────────────────────────────────────────────────────

aiquota_vitest_test(
    name = "format_test",
    srcs = ["format.test.ts"],
    isolated_typecheck = True,
    deps = [
        ":fixtures",
        ":format",
        "//:node_modules/vitest",
        "//aiquota/shared:presentation",
    ],
)

aiquota_vitest_test(
    name = "quotas_test",
    srcs = ["quotas.test.ts"],
    isolated_typecheck = True,
    deps = [
        ":quotas",
        "//:node_modules/vitest",
    ],
)

aiquota_vitest_test(
    name = "app_test",
    srcs = ["app.test.tsx"],
    isolated_typecheck = True,
    deps = [
        ":app",
        "//:node_modules/@types/react",
        "//:node_modules/@types/react-dom",
        "//:node_modules/react",
        "//:node_modules/react-dom",
        "//:node_modules/vitest",
    ],
)

vitest_config(
    name = "vitest_config",
    data = ["//:node_modules/happy-dom"],
    environment = "node",
)

# ── Visual renders ─────────────────────────────────────────────────────────────
#
# One PNG per scenario per theme, published for PR visual review — the browser counterpart of
# //aiquota/gnome:test_render. Browser rendering needs the RBE worker's display stack, so this
# is a test rather than a `bazel run` binary.

ts_library(
    name = "screenshot_harness_lib",
    testonly = True,
    srcs = ["harness/harness.tsx"],
    isolated_typecheck = True,
    tsconfig = TSCONFIG,
    deps = [
        ":app",
        ":board_css",
        ":dashboard",
        ":fixtures",
        ":page_css",
        ":quotas",
        "//:node_modules/@types/react",
        "//:node_modules/@types/react-dom",
        "//:node_modules/react",
        "//:node_modules/react-dom",
    ],
)

# A classic script (iife) so harness/index.html loads it from file:// without module CORS.
esbuild(
    name = "screenshot_bundle",
    testonly = True,
    config = {"jsx": "automatic"},
    entry_point = "harness/harness.js",
    format = "iife",
    minify = False,
    output = "harness/bundle.js",
    output_css = "harness/bundle.css",
    platform = "browser",
    sourcemap = "linked",
    target = ["es2022"],
    deps = [":screenshot_harness_lib"],
)

# Single-file views so $(rootpath) resolves to one path each.
filegroup(
    name = "screenshot_bundle_js",
    testonly = True,
    srcs = ["harness/bundle.js"],
)

filegroup(
    name = "screenshot_bundle_css",
    testonly = True,
    srcs = ["harness/bundle.css"],
)

# Peak-burn hours and credit expiries render in the viewer's zone; the sweep's browser context is UTC.
py_visual_test(
    name = "screenshots",
    # medium: 13 shots, each on a browser of its own, measured 22s.
    size = "medium",
    assets = [
        ":scenes_json",
        "harness/index.html",
        ":screenshot_bundle_css",
    ],
    env = {"FIXTURE_CATALOG": "$(rlocationpath :scenes_json)"},
    harness = ":screenshot_bundle_js",
    test_deps = [
        "//util/bazel:runfiles",
        "//util/testing:viewports",
        "//util/testing:visual_capture",
        "@pypi//playwright",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",
        "@pypi//pytest_bazel",
    ],
    test_module = "aiquota.frontend.test_visual",
    test_srcs = ["test_visual.py"],
    title = "aiquota dashboard",
)

check_vitest_specs()
