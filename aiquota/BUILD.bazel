py_package(
    name = "aiquota_pkg",
    packages = ["aiquota"],
    visibility = ["//visibility:public"],
    deps = [
        ":cli_lib",
        ":desktop_lib",
    ],
)

py_wheel(
    name = "aiquota_wheel",
    distribution = "aiquota",
    entry_points = {
        "console_scripts": [
            "aiquota = aiquota.cli:app",
            "aiquota-desktop-daemon = aiquota.desktop:main",
        ],
    },
    python_requires = ">=3.14",
    # Local distribution; Nix provides it through gnome-shell-aiquota.nix.
    requires = [
        "atomicwrites>=1.4.1",
        "ducktape-claude-api",
        "ducktape-network-monitor",
        "dbus-next>=0.2.3",
        "httpx>=0.27",
        "httpx-sse>=0.4.3",
        "platformdirs>=3.0",
        "pydantic>=2.0",
        "typer>=0.9",
    ],
    version = "0.1.0",
    visibility = ["//visibility:public"],
    deps = [":aiquota_pkg"],
)

py_library(
    name = "export_schema",
    srcs = ["export_schema.py"],
    deps = [
        ":api",
        ":models",
