load("@aspect_rules_py//py:defs.bzl", "py_image_layer", aspect_py_binary = "py_binary")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load("@rules_python//python:packaging.bzl", "py_package", "py_wheel")
load("//devinfra/python:defs.bzl", "py_library")
load("//props:oci.bzl", "py_image_entrypoint", "py_image_env")

py_library(
    name = "models",
    srcs = ["models.py"],
    imports = [".."],
    visibility = ["//visibility:public"],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "peak_windows",
    srcs = ["peak_windows.py"],
    imports = [".."],
    visibility = ["//aiquota:__subpackages__"],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "pace",
    srcs = ["pace.py"],
    imports = [".."],
    visibility = ["//aiquota:__subpackages__"],
    deps = [":models"],
)

py_library(
    name = "cache",
    srcs = ["cache.py"],
    imports = [".."],
    visibility = ["//visibility:public"],
    deps = [
        ":config",
        ":models",
        ":remote",
        "//aiquota/providers:base",
        "//aiquota/providers:claude_lib",
        "//aiquota/providers:cli_proxy_lib",
        "//aiquota/providers:client",
        "//aiquota/providers:codex_lib",
        "//aiquota/providers:zai_lib",
        "@pypi//platformdirs",
    ],
)

py_library(
    name = "remote",
    srcs = ["remote.py"],
    imports = [".."],
    visibility = ["//visibility:public"],
    deps = [
        ":models",
        "@pypi//httpx",
    ],
)

py_library(
    name = "config",
    srcs = ["config.py"],
    imports = [".."],
    visibility = ["//visibility:public"],
    deps = [
        "//aiquota/providers:claude_lib",
        "//aiquota/providers:codex_lib",
        "//aiquota/providers:zai_lib",
        "@pypi//platformdirs",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "cli_lib",
    srcs = ["cli.py"],
    imports = [".."],
    deps = [
        ":cache",
        ":config",
        "//aiquota/render:human_lib",
        "//aiquota/render:tmux_lib",
        "//aiquota/render:view_model_lib",
        "@pypi//typer",
    ],
)

py_library(
    name = "api",
    srcs = ["api.py"],
    data = ["//aiquota/frontend:bundle"],  # keep: SPA mounted by aiquota.api
    imports = [".."],
    deps = [
        ":cache",
        ":clickhouse",
        ":config",
        ":models",
        "//aiquota/providers:base",
        "//util/bazel:runfiles",
        "@pypi//authlib",
        "@pypi//fastapi",
        "@pypi//httpx",
        # keep: starlette.middleware.sessions imports it at runtime; no aiquota module
        # names it, so the import scan cannot see it.
        "@pypi//itsdangerous",
        "@pypi//prometheus_client",
        "@pypi//pydantic",
        "@pypi//pydantic_settings",
        "@pypi//starlette",
        "@pypi//uvicorn",
    ],
)

py_library(
    name = "clickhouse",
    srcs = ["clickhouse.py"],
    deps = [
        ":models",
        "@pypi//httpx",
    ],
)

py_binary(
    name = "aiquota",
    imports = [".."],
    main_module = "aiquota.cli",
    visibility = ["//aiquota:__subpackages__"],
    deps = [
        ":cli_lib",
        "@pypi//typer",
    ],
)

py_binary(
    name = "server",
    imports = [".."],
    main_module = "aiquota.api",
    visibility = ["//visibility:public"],
    deps = [":api"],
)

aspect_py_binary(
    name = "server_bin",
    main = "api.py",
    deps = [":api"],
)

py_image_layer(
    name = "server_layers",
    binary = ":server_bin",
    group = "1000",
    owner = "1000",
)

oci_image(
    name = "api_image",
    base = "@debian_trixie_slim_linux_amd64",
    entrypoint = py_image_entrypoint("server_bin"),
    env = py_image_env(binary_name = "server_bin"),
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [":server_layers"],
    user = "1000:1000",
    visibility = ["//visibility:public"],
)

oci_load(
    name = "api_load",
    image = ":api_image",
    repo_tags = ["aiquota-api:latest"],
    visibility = ["//visibility:public"],
)

py_test(
    name = "test_models",
    srcs = ["test_models.py"],
    imports = [".."],
    deps = [
        ":models",
        "//:conftest",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_peak_windows",
    srcs = ["test_peak_windows.py"],
    imports = [".."],
    deps = [
        ":peak_windows",
        "//:conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_pace",
    srcs = ["test_pace.py"],
    imports = [".."],
    deps = [
        ":models",
        ":pace",
        "//:conftest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_cache",
    srcs = ["test_cache.py"],
    imports = [".."],
    deps = [
        ":cache",
        ":models",
        "//:conftest",
        "//aiquota/providers:base",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_remote",
    srcs = ["test_remote.py"],
    imports = [".."],
    deps = [
        ":models",
        ":remote",
        "//:conftest",
        "@pypi//httpx",
        "@pypi//pytest_bazel",
        "@pypi//respx",
    ],
)

py_test(
    name = "test_config",
    srcs = ["test_config.py"],
    imports = [".."],
    deps = [
        ":config",
        "//:conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_api",
    srcs = ["test_api.py"],
    imports = [".."],
    deps = [
        ":api",
        ":models",
        "//:conftest",
        "@pypi//httpx",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_clickhouse",
    srcs = ["test_clickhouse.py"],
    imports = [".."],
    deps = [
        ":api",
        ":clickhouse",
        ":models",
        "//:conftest",
        "@pypi//httpx",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_package(
    name = "aiquota_pkg",
    packages = [
        "aiquota",
        "devinfra.claude",
        "devinfra.claude.claude_api",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":cli_lib",
    ],
)

py_wheel(
    name = "aiquota_wheel",
    distribution = "aiquota",
    entry_points = {
        "console_scripts": [
            "aiquota = aiquota.cli:app",
        ],
    },
    python_requires = ">=3.13",
    requires = [
        "atomicwrites>=1.4.1",
        "httpx>=0.27",
        "platformdirs>=3.0",
        "pydantic>=2.0",
        "typer>=0.9",
    ],
    version = "0.1.0",
    visibility = ["//visibility:public"],
    deps = [":aiquota_pkg"],
)
