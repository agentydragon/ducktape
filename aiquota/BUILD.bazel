load("@aspect_rules_py//py:defs.bzl", "py_image_layer", aspect_py_binary = "py_binary")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_python//python:defs.bzl", "py_binary")
load("@rules_python//python:packaging.bzl", "py_package", "py_wheel")
load("//devinfra/oci:py_image.bzl", "py_image_entrypoint", "py_image_env")
load("//devinfra/python:defs.bzl", "py_library", "py_test")

py_library(
    name = "models",
    srcs = ["models.py"],
    imports = [".."],
    visibility = ["//visibility:public"],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "peak_windows",
    srcs = ["peak_windows.py"],
    imports = [".."],
    visibility = ["//aiquota:__subpackages__"],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "pace",
    srcs = ["pace.py"],
    imports = [".."],
    visibility = ["//aiquota:__subpackages__"],
    deps = [":models"],
)

py_library(
    name = "cache",
    srcs = ["cache.py"],
    imports = [".."],
    visibility = ["//visibility:public"],
    deps = [
        ":config",
        ":models",
        ":remote",
        "//aiquota/providers:base",
        "//aiquota/providers:claude_lib",
        "//aiquota/providers:cli_proxy_lib",
        "//aiquota/providers:client",
        "//aiquota/providers:codex_lib",
        "//aiquota/providers:zai_lib",
        "@pypi//platformdirs",
    ],
)

py_library(
    name = "remote",
    srcs = ["remote.py"],
    imports = [".."],
    visibility = ["//visibility:public"],
    deps = [
        ":models",
        "@pypi//httpx",
    ],
)

py_library(
    name = "config",
    srcs = ["config.py"],
    imports = [".."],
    visibility = ["//visibility:public"],
    deps = [
        "//aiquota/providers:claude_lib",
        "//aiquota/providers:codex_lib",
        "//aiquota/providers:zai_lib",
        "@pypi//platformdirs",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "cli_lib",
    srcs = ["cli.py"],
    imports = [".."],
    deps = [
        ":cache",
        ":config",
        "//aiquota/render:human_lib",
        "//aiquota/render:tmux_lib",
        "//aiquota/render:view_model_lib",
        "@pypi//typer",
    ],
)

py_library(
    name = "desktop_lib",
    srcs = ["desktop.py"],
    imports = [".."],
    deps = [
        ":cache",
        ":config",
        ":models",
        "//aiquota/render:view_model_lib",
        "//util:network_monitor",
        "@pypi//dbus_next",
        "@pypi//httpx",
        "@pypi//httpx_sse",
        "@pypi//pydantic",
    ],
)

py_test(
    name = "test_desktop",
    srcs = ["test_desktop.py"],
    imports = [".."],
    deps = [
        ":cache",
        ":config",
        ":desktop_lib",
        "//:conftest",
        "@pypi//dbus_next",
        "@pypi//httpx",
        "@pypi//httpx_sse",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_binary(
    name = "desktop_bin",
    imports = [".."],
    main_module = "aiquota.desktop",
    visibility = ["//visibility:public"],
    deps = [":desktop_lib"],
)

py_library(
    name = "api",
    srcs = ["api.py"],
    imports = [".."],
    visibility = ["//cluster/cdk8s:__pkg__"],
    deps = [
        ":cache",
        ":clickhouse",
        ":config",
        ":models",
        "//aiquota/providers:base",
        "//aiquota/render:view_model_lib",
        "//util/bazel:runfiles",
        "@pypi//authlib",
        # keep: the pinned Gazelle parser does not accept api.py's Python 3.14 syntax.
        "@pypi//anyio",
        "@pypi//fastapi",
        "@pypi//httpx",
        # keep: starlette.middleware.sessions imports it at runtime; no aiquota module
        # names it, so the import scan cannot see it.
        "@pypi//itsdangerous",
        "@pypi//prometheus_client",
        "@pypi//starlette",
        "@pypi//uvicorn",
        ":settings",
    ],
)

py_library(
    name = "clickhouse",
    srcs = ["clickhouse.py"],
    # keep: apply_schema reads it from runfiles; no module imports it.
    data = ["schema.sql"],
    deps = [
        ":models",
        "//util/bazel:runfiles",
        "@pypi//httpx",
        "@pypi//sqlparse",
    ],
)

py_binary(
    name = "aiquota",
    imports = [".."],
    main_module = "aiquota.cli",
    visibility = ["//aiquota:__subpackages__"],
    deps = [
        ":cli_lib",
        "@pypi//typer",
    ],
)

py_binary(
    name = "server",
    # keep: the SPA aiquota.api mounts from runfiles; no module imports it.
    data = ["//aiquota/frontend:bundle"],
    imports = [".."],
    main_module = "aiquota.api",
    visibility = ["//visibility:public"],
    deps = [":api"],
)

aspect_py_binary(
    name = "server_bin",
    data = ["//aiquota/frontend:bundle"],
    main = "api.py",
    deps = [":api"],
)

# Prints the OpenAPI schema artifact consumed by the frontend's file-input converter.
py_binary(
    name = "export_schema_bin",
    imports = [".."],
    main_module = "aiquota.export_schema",
    visibility = ["//aiquota/frontend:__pkg__"],
    deps = [":export_schema"],
)

genrule(
    name = "openapi_schema",
    outs = ["openapi.json"],
    cmd = "$(location :export_schema_bin) > $@",
    tools = [":export_schema_bin"],
    visibility = ["//aiquota/frontend:__pkg__"],
)

py_image_layer(
    name = "server_layers",
    binary = ":server_bin",
    group = "1000",
    owner = "1000",
)

oci_image(
    name = "api_image",
    base = "@debian_trixie_slim_linux_amd64",
    entrypoint = py_image_entrypoint("server_bin"),
    env = py_image_env(binary_name = "server_bin"),
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [":server_layers"],
    user = "1000:1000",
    visibility = ["//visibility:public"],
)

oci_load(
    name = "api_load",
    image = ":api_image",
    repo_tags = ["aiquota-api:latest"],
    visibility = ["//visibility:public"],
)

