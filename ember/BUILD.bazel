# --- OCI Image ---

aspect_py_binary(
    name = "emberd_bin",
    main = "app.py",
    deps = [":app"],
)

py_image_layer(
    name = "layers",
    binary = ":emberd_bin",
)

oci_image(
    name = "image",
    base = "@debian_slim_linux_amd64",
    entrypoint = py_image_entrypoint("emberd_bin"),
    env = py_image_env("emberd_bin"),
    exposed_ports = ["8000/tcp"],
    tars = [":layers"],
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["emberd:latest"],
)

py_library(
    name = "app",
    srcs = ["app.py"],
    visibility = ["//:__subpackages__"],
