"""Ember agent package."""

# gazelle:resolve py ember //ember:system_prompt

load("@aspect_rules_py//py:defs.bzl", "py_image_layer", aspect_py_binary = "py_binary")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("//props:oci.bzl", "py_image_entrypoint", "py_image_env")

filegroup(
    name = "data_files",
    srcs = [
        "docs/agent_ontology.md",
        "plan/SPEC.md",
        "resources/examples/matrix_client/quickstart.py",
        "resources/examples/python-session/demo.sh",
        "resources/examples/python-session/test_demo.sh",
        "system_prompt.md.mako",
    ],
    visibility = ["//:__subpackages__"],
)

py_binary(
    name = "emberd",
    main_module = "ember.app",
    visibility = ["//:__subpackages__"],
    deps = [":app"],
)

