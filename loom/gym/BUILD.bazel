load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

# keep
py_binary(
    name = "baseline_eval",
    main_module = "loom.gym.run_eval",
    deps = [":run_eval"],
)

py_library(
    name = "baseline_llm",
    srcs = ["baseline_llm.py"],
    deps = [
        ":scoring",
        ":task",
        "@pypi//httpx",
        "@pypi//more_itertools",
    ],
)

filegroup(
    name = "data",
    srcs = glob(["data/*.csv"]),
)

py_library(
    name = "monthly_series",
    srcs = ["monthly_series.py"],
    data = [":data"],  # keep
)

py_library(
    name = "bundle_tasks",
    srcs = ["bundle_tasks.py"],
    deps = [
        ":monthly_series",
        ":task",
    ],
)

py_library(
    name = "series_tasks",
    srcs = ["series_tasks.py"],
    deps = [
        ":bundle_tasks",
        ":monthly_series",
        ":seed_tasks",
        ":task",
    ],
)

py_library(
    name = "dossier",
    srcs = ["dossier.py"],
    deps = [":monthly_series"],
)

filegroup(
    name = "sandbox_compose",
    srcs = ["sandbox/compose.yaml"],
)

py_library(
    name = "inspect_harness",
    srcs = ["inspect_harness.py"],
    data = [":sandbox_compose"],  # keep
    deps = [
        ":baseline_llm",
        ":dossier",
        ":scoring",
        ":task",
        "@pypi//inspect_ai",
    ],
)

py_library(
    name = "run_eval",
    srcs = ["run_eval.py"],
    deps = [
        ":baseline_llm",
        ":dossier",
        ":model_cutoffs",
        ":scoring",
        ":series_tasks",
        ":task",
        "@pypi//httpx",
    ],
)

py_library(
    name = "scoring",
    srcs = ["scoring.py"],
    deps = [
        ":task",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "seed_tasks",
    srcs = ["seed_tasks.py"],
    deps = [":task"],
)

py_library(
    name = "task",
    srcs = ["task.py"],
    deps = ["@pypi//pydantic"],
)

py_test(
    name = "test_baseline_llm",
    srcs = ["test_baseline_llm.py"],
    deps = [
        ":baseline_llm",
        ":scoring",
        ":task",
        "//:conftest",
        "@pypi//httpx",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",  # keep
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_model_cutoffs",
    srcs = ["test_model_cutoffs.py"],
    deps = [
        ":model_cutoffs",
        "//:conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_scoring",
    srcs = ["test_scoring.py"],
    deps = [
        ":scoring",
        ":task",
        "//:conftest",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_task",
    srcs = ["test_task.py"],
    deps = [
        ":seed_tasks",
        ":task",
        "//:conftest",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "model_cutoffs",
    srcs = ["model_cutoffs.py"],
)

py_test(
    name = "test_series_tasks",
    srcs = ["test_series_tasks.py"],
    deps = [
        ":monthly_series",
        ":series_tasks",
        ":task",
        "//:conftest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_dossier",
    srcs = ["test_dossier.py"],
    deps = [
        ":dossier",
        "//:conftest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_bundle_tasks",
    srcs = ["test_bundle_tasks.py"],
    deps = [
        ":bundle_tasks",
        ":monthly_series",
        ":task",
        "//:conftest",
        "@pypi//more_itertools",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_inspect_harness",
    size = "large",
    srcs = ["test_inspect_harness.py"],
    requires_docker = True,
    deps = [
        ":inspect_harness",
        ":series_tasks",
        "//:conftest",
        "@pypi//inspect_ai",
        "@pypi//more_itertools",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//pyyaml",
        "@pypi//types_pyyaml",
    ],
)
