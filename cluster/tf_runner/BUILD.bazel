load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@io_bazel_rules_go//go:def.bzl", "go_binary")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")
load(":plugin_layer.bzl", "provider_plugin_layer")

PROVIDERS_DIR = "/usr/share/tofu/providers"

CLI_CONFIG = "/etc/tofu/tofurc"

py_library(
    name = "plugin_layer",
    srcs = ["plugin_layer.py"],
)

py_binary(
    name = "plugin_layer_bin",
    main_module = "cluster.tf_runner.plugin_layer",
    deps = [":plugin_layer"],
)

py_test(
    name = "test_plugin_layer",
    srcs = ["test_plugin_layer.py"],
    deps = [
        ":plugin_layer",
        "//:conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

go_binary(
    name = "buildbuddy-secret-sync",
    srcs = ["buildbuddy_secret_sync.go"],
    importpath = "github.com/agentydragon/ducktape/cluster/tf_runner/buildbuddy_secret_sync",
    race = "off",
    deps = ["@org_golang_x_crypto//nacl/box"],
)

pkg_tar(
    name = "buildbuddy_secret_sync_layer",
    srcs = [":buildbuddy-secret-sync"],
    mode = "0755",
    package_dir = "/usr/local/bin",
)

provider_plugin_layer(
    name = "providers_layer",
    prefix = PROVIDERS_DIR,
)

# No `direct` fallback: a module asking for a version the layer lacks fails `tofu init` instead of
# downloading it.
write_file(
    name = "cli_config",
    out = "tofurc",
    content = [
        "provider_installation {",
        "  filesystem_mirror {",
        '    path = "%s"' % PROVIDERS_DIR,
        "  }",
        "}",
    ],
)

pkg_tar(
    name = "tofurc_layer",
    srcs = [":cli_config"],
    mode = "0644",
    package_dir = CLI_CONFIG.rpartition("/")[0],
)

# The runner pods tofu-controller starts (its `runner.image` Helm value). The base must stay at the
# controller's own version: the controller and runner speak a gRPC protocol that changes between
# releases.
oci_image(
    name = "image",
    base = "@tf_runner_linux_amd64",
    env = {"TF_CLI_CONFIG_FILE": CLI_CONFIG},
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [
        ":providers_layer",
        ":tofurc_layer",
        ":buildbuddy_secret_sync_layer",
    ],
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["tf-runner:latest"],
)
