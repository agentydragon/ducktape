# The cluster-wide validators build this directory's Kustomization and inspect its files.
filegroup(
    name = "manifests",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
    visibility = [
        "//cluster/cdk8s:__pkg__",
        "//cluster/validation:__pkg__",
    ],
)

filegroup(
    name = "image_pins",
    srcs = glob(["image-pins/**"]),
    visibility = ["//cluster/validation:__pkg__"],
)

exports_files(
    ["agentplane-staging.k8s.yaml"],
    visibility = ["//agentplane/app/go:__pkg__"],
)
