load("@rules_python//python:defs.bzl", "py_library")
load("//devinfra/python:defs.bzl", "py_test")

# gazelle:resolve py install_dreo //cluster/k8s/home-assistant/app:install_dreo
# gazelle:resolve py install_oidc //cluster/k8s/home-assistant/app:install_oidc

py_library(
    name = "install_oidc",
    srcs = ["install_oidc.py"],
    imports = ["."],
    visibility = ["//visibility:public"],
)

py_library(
    name = "install_dreo",
    srcs = ["install_dreo.py"],
    imports = ["."],
    visibility = ["//visibility:public"],
)

py_test(
    name = "test_install_oidc",
    srcs = ["test_install_oidc.py"],
    deps = [
        "//:conftest",
        "//cluster/k8s/home-assistant/app:install_oidc",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_install_dreo",
    srcs = ["test_install_dreo.py"],
    deps = [
        "//:conftest",
        "//cluster/k8s/home-assistant/app:install_dreo",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

# Cluster manifests for cluster/validation's flux-build test (the
# //cluster/k8s:cluster_all_files glob stops at this package boundary).
filegroup(
    name = "manifests",
    srcs = glob(
        ["**"],
        exclude = [
            "BUILD.bazel",
            "test_*.py",
        ],
    ),
    visibility = ["//cluster/validation:__pkg__"],
)
