load("@rules_python//python:defs.bzl", "py_library")
load("//devinfra/python:defs.bzl", "py_test")

# Top-level module names by design (imports = ["."]): the onboarding Job runs
# these as scripts, and the tests import them bare.
# gazelle:resolve py bootstrap_onboarding //cluster/k8s/home-assistant/app:bootstrap_onboarding
# gazelle:resolve py install_oidc //cluster/k8s/home-assistant/app:install_oidc

py_library(
    name = "bootstrap_onboarding",
    srcs = ["bootstrap_onboarding.py"],
    imports = ["."],
)

py_test(
    name = "test_bootstrap_onboarding",
    srcs = ["test_bootstrap_onboarding.py"],
    deps = [
        "//:conftest",
        "//cluster/k8s/home-assistant/app:bootstrap_onboarding",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "install_oidc",
    srcs = ["install_oidc.py"],
    imports = ["."],
    visibility = ["//visibility:public"],
)

py_test(
    name = "test_install_oidc",
    srcs = ["test_install_oidc.py"],
    deps = [
        "//:conftest",
        "//cluster/k8s/home-assistant/app:install_oidc",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

# Cluster manifests for cluster/validation's flux-build test (the
# //cluster/k8s:cluster_all_files glob stops at this package boundary).
filegroup(
    name = "manifests",
    srcs = glob(
        ["**"],
        exclude = [
            "BUILD.bazel",
            "test_*.py",
        ],
    ),
    visibility = ["//cluster/validation:__pkg__"],
)
