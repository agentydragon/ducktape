# gazelle:ignore

load("//devinfra/python:defs.bzl", "py_test")

py_test(
    name = "mailbox_plan_test",
    srcs = ["mailbox_plan_test.py"],
    data = ["mailbox-plan.ndjson"],
    deps = [
        "//util/bazel:runfiles",
        "@pypi//pytest_bazel",
    ],
)

# Cluster manifests for cluster/validation's flux-build test (the
# //cluster/k8s:cluster_all_files glob stops at this package boundary).
filegroup(
    name = "manifests",
    srcs = glob(
        ["**"],
        exclude = [
            "BUILD.bazel",
            "*_test.py",
        ],
    ),
    visibility = ["//cluster/validation:__pkg__"],
)
