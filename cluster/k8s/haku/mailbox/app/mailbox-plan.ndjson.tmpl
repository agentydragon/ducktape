{"@type":"upsert","object":"Certificate","matchOn":["certificate"],"value":{"cert-mx":{"certificate":"@@TLS_CERT@@","privateKey":"@@TLS_KEY@@"}}}
{"@type":"upsert","object":"Domain","matchOn":["name"],"value":{"dom":{"name":"allegedly.works","description":"Haku mailbox domain"}}}
{"@type":"upsert","object":"Account","matchOn":["name"],"value":{"acct-haku":{"@type":"User","name":"haku","domainId":"#dom","description":"Haku background agent (auth: Authentik OIDC bearer only)"}}}
{"@type":"upsert","object":"Directory","matchOn":["description"],"value":{"dir-authentik":{"@type":"Oidc","description":"Authentik (stalwart-haku provider)","issuerUrl":"https://auth.allegedly.works/application/o/stalwart-haku/","requireAudience":"stalwart-haku","requireScopes":["openid","email"],"claimUsername":"preferred_username","usernameDomain":"allegedly.works","claimName":"name"}}}
{"@type":"upsert","object":"SieveSystemScript","matchOn":["name"],"value":{"script-wl":{"name":"operator-whitelist","description":"Reject delivery unless DMARC-verified From is on the operator whitelist","isActive":true,"contents":"require [\"variables\", \"reject\"];\n\nif not string :is \"${env.dmarc.result}\" \"pass\" {\n    reject \"550 5.7.1 DMARC verification failed\";\n    stop;\n}\n\nif not string :is :comparator \"i;ascii-casemap\" \"${env.from}\" \"agentydragon@gmail.com\" {\n    reject \"550 5.7.1 sender not authorized for this mailbox\";\n}\n"}}}
{"@type":"upsert","object":"NetworkListener","matchOn":["protocol"],"value":{"lst-smtp":{"protocol":"smtp","bind":["0.0.0.0:2525"],"useTls":true,"tlsImplicit":false},"lst-http":{"protocol":"http","bind":["0.0.0.0:8080"],"useTls":false}}}
{"@type":"update","object":"Authentication","value":{"directoryId":"#dir-authentik"}}
{"@type":"update","object":"MtaStageData","value":{"script":{"else":"'operator-whitelist'"}}}
{"@type":"update","object":"SystemSettings","value":{"defaultHostname":"mx.allegedly.works","defaultDomainId":"#dom","defaultCertificateId":"#cert-mx"}}
