# Rendered by the initContainer with envsubst; the rendered copy lands on tmpfs
# and never in a ConfigMap, a Secret manifest, or git.
#
# Each rule is (placeholder AND destination). Both halves are required: the
# placeholder alone is an exfiltration primitive, since the agent holds it.

acl ph_bearer req_header Authorization -i ^Bearer\ spike-bearer-placeholder$
request_header_access Authorization deny ph_bearer
request_header_add    Authorization "Bearer ${SPIKE_BEARER_SECRET}" ph_bearer to_echo

# Second credential on the same header, different destination — the "several
# credentials per fence" question the 3.5 spike never exercised.
acl ph_other req_header Authorization -i ^Bearer\ spike-other-placeholder$
request_header_access Authorization deny ph_other
request_header_add    Authorization "Bearer ${SPIKE_OTHER_SECRET}" ph_other to_elsewhere

# base64 Basic, the shape git-over-HTTPS uses. Both sides are static, so the
# whole header value is precomputed at render time rather than rewritten in
# flight — the question is whether matching a base64 blob in a req_header ACL
# behaves.
acl ph_basic req_header Authorization -i ^Basic\ ${SPIKE_BASIC_PLACEHOLDER_B64}$
request_header_access Authorization deny ph_basic
request_header_add    Authorization "Basic ${SPIKE_BASIC_REAL_B64}" ph_basic to_echo
