# gazelle:ignore

load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

exports_files(
    [
        "chatgpt-proxy-config.yaml",
        "proxy-config.yaml",
    ],
    visibility = ["//debug/litellm_probe:__pkg__"],
)

py_library(
    name = "generate_litellm",
    srcs = ["generate_litellm.py"],
    visibility = ["//cluster/k8s/haku/dispatch/litellm:__pkg__"],
    deps = [
        "//devinfra:prettier",
        "//util/bazel:workspace",
        "@pypi//pyyaml",
    ],
)

py_binary(
    name = "generate_litellm_bin",
    main_module = "cluster.k8s.litellm.app.generate_litellm",
    deps = [":generate_litellm"],
)

py_test(
    name = "test_generate_litellm",
    srcs = ["test_generate_litellm.py"],
    data = [
        "chatgpt-deployment.yaml",
        "chatgpt-proxy-config.yaml",
        "chatgpt-service.yaml",
        "deployment.yaml",
        "httproute.yaml",
        "kustomization.yaml",
        "proxy-config.yaml",
        "service.yaml",
    ],
    deps = [
        ":generate_litellm",
        "//util/bazel:runfiles",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//pyyaml",
    ],
)

py_test(
    name = "test_openclaw_models",
    srcs = ["test_openclaw_models.py"],
    data = ["//cluster/k8s:openclaw_model_config"],
    deps = [
        ":generate_litellm",
        "//util/bazel:runfiles",
        "@pypi//pytest_bazel",
        "@pypi//pyyaml",
    ],
)

# Cluster manifests for cluster/validation's flux-build test (the
# //cluster/k8s:cluster_all_files glob stops at this package boundary).
filegroup(
    name = "manifests",
    srcs = glob(
        ["**"],
        exclude = [
            "BUILD.bazel",
            "test_*.py",
        ],
    ),
    visibility = ["//cluster/validation:__pkg__"],
)
