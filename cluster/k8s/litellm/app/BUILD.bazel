# gazelle:ignore

load("//devinfra/python:defs.bzl", "py_library", "py_test")

exports_files(
    [
        "proxy-config.yaml",
    ],
    visibility = ["//debug/litellm_probe:__pkg__"],
)

py_library(
    name = "model_rosters",
    srcs = ["model_rosters.py"],
    visibility = ["//cluster/k8s/x/haku/dispatch/litellm:__pkg__"],
)

py_test(
    name = "test_litellm_config",
    srcs = ["test_litellm_config.py"],
    data = [
        "deployment.yaml",
        "httproute.yaml",
        "kustomization.yaml",
        "proxy-config.yaml",
        "service.yaml",
        "//cluster/k8s:haku_console_config",
        "//tf/gitops/litellm-keys:main.tf",
    ],
    deps = [
        ":model_rosters",
        "//cluster/validation:terraform_hcl",
        "//util/bazel:runfiles",
        "@pypi//more_itertools",
        "@pypi//pytest_bazel",
        "@pypi//pyyaml",
    ],
)

py_test(
    name = "test_openclaw_models",
    srcs = ["test_openclaw_models.py"],
    data = [
        "proxy-config.yaml",
        "//cluster/k8s:openclaw_model_config",
        "//tf/gitops/litellm-keys:main.tf",
    ],
    deps = [
        ":model_rosters",
        "//util/bazel:runfiles",
        "@pypi//json5",
        "@pypi//pytest_bazel",
        "@pypi//pyyaml",
    ],
)

# Cluster manifests for cluster/validation's flux-build test (the
# //cluster/k8s:cluster_all_files glob stops at this package boundary).
filegroup(
    name = "manifests",
    srcs = glob(
        ["**"],
        exclude = [
            "BUILD.bazel",
            "test_*.py",
        ],
    ),
    visibility = ["//cluster/validation:__pkg__"],
)
