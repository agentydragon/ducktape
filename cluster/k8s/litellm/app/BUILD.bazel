# gazelle:ignore

load("//devinfra/python:defs.bzl", "py_test")

exports_files(
    [
        "flux-kustomization.yaml",
        "kustomization.yaml",
        "litellm.k8s.yaml",
    ],
    visibility = ["//cluster/cdk8s:__pkg__"],
)

py_test(
    name = "test_litellm_config",
    srcs = ["test_litellm_config.py"],
    data = ["//tf/gitops/litellm-keys:main.tf"],
    deps = [
        "//cluster/cdk8s:litellm_config",
        "//cluster/cdk8s:model_rosters",
        "//cluster/validation:terraform_hcl",
        "//util/bazel:runfiles",
        "@pypi//more_itertools",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_model_roster_consumers",
    srcs = ["test_model_roster_consumers.py"],
    data = ["//tf/gitops/litellm-keys:main.tf"],
    deps = [
        "//cluster/cdk8s:agentplane_staging_config",
        "//cluster/cdk8s:model_rosters",
        "//cluster/validation:terraform_hcl",
        "//util/bazel:runfiles",
        "@pypi//more_itertools",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_openclaw_models",
    srcs = ["test_openclaw_models.py"],
    data = ["//cluster/k8s:openclaw_model_config"],
    deps = [
        "//cluster/cdk8s:haku_openclaw_spike_config",
        "//cluster/cdk8s:litellm_config",
        "//cluster/cdk8s:model_rosters",
        "//cluster/cdk8s:public_coder_agent_config",
        "//util/bazel:runfiles",
        "@pypi//pytest_bazel",
        "@pypi//pyyaml",
    ],
)

# Cluster manifests for cluster/validation's flux-build test (the
# //cluster/k8s:cluster_all_files glob stops at this package boundary).
filegroup(
    name = "manifests",
    srcs = glob(
        ["**"],
        exclude = [
            "BUILD.bazel",
            "test_*.py",
        ],
    ),
    visibility = ["//cluster/validation:__pkg__"],
)
