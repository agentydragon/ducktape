<clickhouse>
  <!-- These high-volume self-profiling tables are unnecessary for this
       small shared cluster and previously grew Langfuse by GiB/week. -->
  <trace_log remove="1" />
  <text_log remove="1" />
  <metric_log remove="1" />
  <asynchronous_metric_log remove="1" />
  <query_log>
    <max_size_rows>8192</max_size_rows>
    <reserved_size_rows>8192</reserved_size_rows>
  </query_log>
</clickhouse>
