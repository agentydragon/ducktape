# Kustomize transformer configuration; not a Kubernetes manifest
# (kubeconform-excluded, cluster-manifest-ignored).
nameReference:
  - kind: ConfigMap
    version: v1
    fieldSpecs:
      - group: clickhouse.altinity.com
        version: v1
        kind: ClickHouseInstallation
        path: spec/templates/podTemplates/spec/volumes/projected/sources/configMap/name
