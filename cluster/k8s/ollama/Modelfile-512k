FROM gpt-oss:20b

# Extend context to 512k via linear RoPE position interpolation.
# rope_freq_scale = native_ctx / target_ctx = 128k / 512k = 0.25
# WARNING: KV cache at q8_0 for a 20B model ≈ 40 GB at 512k context.
# Requires sufficient GPU VRAM + CPU RAM for offloaded layers.
PARAMETER num_ctx 524288
PARAMETER rope_freq_scale 0.25
