load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

# sops binary layer — placed at /usr/local/bin/sops.
pkg_tar(
    name = "sops_layer",
    srcs = ["@sops_linux_amd64//file:sops"],
    package_dir = "/usr/local/bin",
)

# kubectl binary layer — placed at /usr/local/bin/kubectl.
# CronJobs use `kubectl exec deploy/attic -- atticadm make-token …` to mint
# JWTs against the running attic pod (so atticadm runs in its native nix
# environment, no need to repackage attic binaries here).
pkg_tar(
    name = "kubectl_layer",
    srcs = ["@kubectl_linux_amd64//file:kubectl"],
    package_dir = "/usr/local/bin",
)

oci_image(
    name = "image",
    base = "@debian_trixie_slim_linux_amd64",
    entrypoint = ["/usr/bin/bash"],
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [
        "@trixie_attic_rotation//:flat",
        ":sops_layer",
        ":kubectl_layer",
    ],
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["attic-jwt-rotation:latest"],
)

# Cluster manifests for cluster/validation's flux-build test (the
# //cluster/k8s:cluster_all_files glob stops at this package boundary).
filegroup(
    name = "manifests",
    srcs = glob(
        ["**"],
        exclude = [
            "BUILD.bazel",
            "test_*.py",
        ],
    ),
    visibility = ["//cluster/validation:__pkg__"],
)
