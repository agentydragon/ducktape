{
  "agents": {
    "defaults": {
      "model": {
        "primary": "litellm-subscription/codex-gpt-5.6-luna"
      },
      "sandbox": {
        "mode": "off"
      },
      "skills": [],
      "verboseDefault": "full",
      "memorySearch": {
        "enabled": true,
        "sources": ["memory"],
        "provider": "openai-compatible",
        "model": "gemini-embedding-2",
        "remote": {
          "baseUrl": "http://litellm.litellm.svc.cluster.local:4000/v1",
          "apiKey": "${OPENCLAW_LITELLM_API_KEY}",
          "nonBatchConcurrency": 2
        }
      }
    },
    "list": [
      {
        "id": "coder",
        "name": "Coder"
      }
    ]
  },
  "commands": {
    "config": false,
    "mcp": false,
    "restart": false
  },
  "cron": {
    "enabled": true,
    "triggers": {
      "enabled": true
    }
  },
  "gateway": {
    "auth": {
      "mode": "trusted-proxy",
      "trustedProxy": {
        "allowLoopback": true,
        "allowUsers": ["agentydragon"],
        "requiredHeaders": ["x-authentik-email", "x-forwarded-host", "x-forwarded-proto"],
        "userHeader": "x-authentik-username"
      }
    },
    "bind": "lan",
    "controlUi": {
      "allowedOrigins": ["https://public-coder-agent.allegedly.works"],
      "dangerouslyDisableDeviceAuth": true
    },
    "mode": "local",
    "trustedProxies": ["10.0.0.0/8"]
  },
  "hooks": {
    "internal": {
      "entries": {
        "session-memory": {
          "enabled": true,
          "llmSlug": false,
          "messages": 15
        }
      }
    }
  },
  "models": {
    "providers": {
      "litellm-subscription": {
        "agentRuntime": {
          "id": "openclaw"
        },
        "api": "anthropic-messages",
        "apiKey": "${OPENCLAW_LITELLM_API_KEY}",
        "baseUrl": "http://litellm.litellm.svc.cluster.local:4000/v1",
        "models": [
          {
            "contextWindow": 372000,
            "id": "codex-gpt-5.6-luna",
            "input": ["text", "image"],
            "maxTokens": 128000,
            "name": "GPT-5.6 Luna (Codex subscription via LiteLLM)",
            "reasoning": true
          },
          {
            "contextWindow": 372000,
            "id": "codex-gpt-5.6-terra",
            "input": ["text", "image"],
            "maxTokens": 128000,
            "name": "GPT-5.6 Terra (Codex subscription via LiteLLM)",
            "reasoning": true
          },
          {
            "contextWindow": 372000,
            "id": "codex-gpt-5.6-sol",
            "input": ["text", "image"],
            "maxTokens": 128000,
            "name": "GPT-5.6 Sol (Codex subscription via LiteLLM)",
            "reasoning": true
          }
        ],
        "request": {
          "allowPrivateNetwork": true
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "haku-console": {
        "url": "https://haku.allegedly.works/mcp",
        "transport": "streamable-http",
        // Haku can synchronously wait up to 60s for a terminal result. Keep this
        // client timeout above that so Haku returns a non-terminal stub instead
        // of OpenClaw surfacing an MCP protocol-level timeout.
        "requestTimeoutMs": 70000,
        "headers": {
          "Authorization": "Bearer ${HAKU_CONSOLE_TOKEN}"
        }
      }
    }
  },
  "tools": {
    "allow": [
      "exec",
      "process",
      "read",
      "write",
      "edit",
      "apply_patch",
      "memory_get",
      "memory_search",
      "session_status",
      "bundle-mcp"
    ],
    "elevated": {
      "enabled": false
    },
    "fs": {
      "workspaceOnly": true
    },
    "sessions": {
      "visibility": "agent"
    }
  }
}
