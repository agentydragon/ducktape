{
  "agents": {
    "defaults": {
      "model": {
        "primary": "litellm-subscription/codex-gpt-5.6-luna"
      },
      "sandbox": {
        "mode": "off"
      },
      "skills": []
    },
    "list": [
      {
        "id": "coder",
        "name": "Coder"
      }
    ]
  },
  "commands": {
    "config": false,
    "mcp": false,
    "restart": false
  },
  "cron": {
    "enabled": false
  },
  "gateway": {
    "auth": {
      "mode": "trusted-proxy",
      "trustedProxy": {
        "allowLoopback": true,
        "allowUsers": ["agentydragon"],
        "requiredHeaders": ["x-authentik-email", "x-forwarded-host", "x-forwarded-proto"],
        "userHeader": "x-authentik-username"
      }
    },
    "bind": "lan",
    "controlUi": {
      "allowedOrigins": ["https://public-coder-agent.allegedly.works"],
      "dangerouslyDisableDeviceAuth": true
    },
    "mode": "local",
    "trustedProxies": ["10.0.0.0/8"]
  },
  "hooks": {
    "internal": {
      "entries": {
        "session-memory": {
          "enabled": true,
          "llmSlug": false,
          "messages": 15
        }
      }
    }
  },
  "models": {
    "providers": {
      "litellm-subscription": {
        "agentRuntime": {
          "id": "openclaw"
        },
        "api": "anthropic-messages",
        "apiKey": "${OPENCLAW_LITELLM_API_KEY}",
        "baseUrl": "http://litellm.litellm.svc.cluster.local:4000/v1",
        "models": [
          {
            "contextWindow": 372000,
            "id": "codex-gpt-5.6-luna",
            "input": ["text", "image"],
            "maxTokens": 128000,
            "name": "GPT-5.6 Luna (Codex subscription via LiteLLM)",
            "reasoning": true
          },
          {
            "contextWindow": 372000,
            "id": "codex-gpt-5.6-terra",
            "input": ["text", "image"],
            "maxTokens": 128000,
            "name": "GPT-5.6 Terra (Codex subscription via LiteLLM)",
            "reasoning": true
          },
          {
            "contextWindow": 372000,
            "id": "codex-gpt-5.6-sol",
            "input": ["text", "image"],
            "maxTokens": 128000,
            "name": "GPT-5.6 Sol (Codex subscription via LiteLLM)",
            "reasoning": true
          }
        ],
        "request": {
          "allowPrivateNetwork": true
        }
      },
      "litellm-zai": {
        "agentRuntime": {
          "id": "openclaw"
        },
        "api": "anthropic-messages",
        "apiKey": "${OPENCLAW_LITELLM_API_KEY}",
        "baseUrl": "http://litellm.litellm.svc.cluster.local:4000/v1",
        "models": [
          {
            "contextWindow": 200000,
            "id": "glm-4.5-anthropic",
            "input": ["text"],
            "maxTokens": 96000,
            "name": "GLM-4.5 (z.ai via LiteLLM)",
            "reasoning": true
          },
          {
            "contextWindow": 200000,
            "id": "glm-4.5-air-anthropic",
            "input": ["text"],
            "maxTokens": 96000,
            "name": "GLM-4.5-AIR (z.ai via LiteLLM)",
            "reasoning": true
          },
          {
            "contextWindow": 200000,
            "id": "glm-4.6-anthropic",
            "input": ["text"],
            "maxTokens": 96000,
            "name": "GLM-4.6 (z.ai via LiteLLM)",
            "reasoning": true
          },
          {
            "contextWindow": 200000,
            "id": "glm-4.7-anthropic",
            "input": ["text"],
            "maxTokens": 96000,
            "name": "GLM-4.7 (z.ai via LiteLLM)",
            "reasoning": true
          },
          {
            "contextWindow": 200000,
            "id": "glm-5-anthropic",
            "input": ["text"],
            "maxTokens": 96000,
            "name": "GLM-5 (z.ai via LiteLLM)",
            "reasoning": true
          },
          {
            "contextWindow": 200000,
            "id": "glm-5-turbo-anthropic",
            "input": ["text"],
            "maxTokens": 96000,
            "name": "GLM-5-TURBO (z.ai via LiteLLM)",
            "reasoning": true
          },
          {
            "contextWindow": 200000,
            "id": "glm-5.1-anthropic",
            "input": ["text"],
            "maxTokens": 96000,
            "name": "GLM-5.1 (z.ai via LiteLLM)",
            "reasoning": true
          },
          {
            "contextWindow": 200000,
            "id": "glm-5.2-anthropic",
            "input": ["text"],
            "maxTokens": 96000,
            "name": "GLM-5.2 (z.ai via LiteLLM)",
            "reasoning": true
          }
        ],
        "request": {
          "allowPrivateNetwork": true
        }
      }
    }
  },
  "tools": {
    "allow": [
      "exec",
      "process",
      "read",
      "write",
      "edit",
      "apply_patch",
      "memory_get",
      "memory_search",
      "session_status"
    ],
    "elevated": {
      "enabled": false
    },
    "fs": {
      "workspaceOnly": true
    },
    "sessions": {
      "visibility": "agent"
    }
  }
}
