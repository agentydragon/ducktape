# Manifests only. The proxy's Python source and image build live in
# //cluster/proxies/loki_read_proxy, following this tree's split: k8s/ holds
# Kubernetes config, source lives beside rotators/ and provisioners/.

# Cluster manifests for cluster/validation's flux-build test (the
# //cluster/k8s:cluster_all_files glob stops at this package boundary).
filegroup(
    name = "manifests",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//cluster/validation:__pkg__"],
)

# cdk8s-generated (cluster/cdk8s/loki_read_proxy.py) -- read by the
# test_generate_manifests pinning test.
exports_files(
    [
        "kustomization.yaml",
        "loki-read-proxy.k8s.yaml",
    ],
    visibility = ["//cluster/cdk8s:__pkg__"],
)
