{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Mimir",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": { "list": [] },
  "description": "Laptop battery and RAPL telemetry for Rugged. Adapted from Grafana dashboard 12542; RAPL panels deliberately select the canonical intel-rapl path to exclude duplicate MMIO counters.",
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 20 },
              { "color": "green", "value": 50 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "displayMode": "lcd",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true
      },
      "targets": [
        {
          "expr": "node_power_supply_capacity{instance=~\"$instance\",power_supply=~\"BAT.*\"}",
          "legendFormat": "{{power_supply}}",
          "refId": "A"
        }
      ],
      "title": "Battery charge",
      "type": "bargauge"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "custom": {} }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "options": { "showHeader": true },
      "targets": [
        {
          "expr": "node_power_supply_info{instance=~\"$instance\",type=~\"Battery|Mains|USB\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Battery and external-power state",
      "transformations": [{ "id": "labelsToFields", "options": {} }],
      "type": "table"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "id": 3,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "rate(node_rapl_package_joules_total{instance=~\"$instance\",path=~\".*/intel-rapl:[^/]+$\"}[$__rate_interval])",
          "legendFormat": "package",
          "refId": "A"
        },
        {
          "expr": "rate(node_rapl_dram_joules_total{instance=~\"$instance\",path=~\".*/intel-rapl:[^/]+:[^/]+$\"}[$__rate_interval])",
          "legendFormat": "DRAM",
          "refId": "B"
        },
        {
          "expr": "rate(node_rapl_psys_joules_total{instance=~\"$instance\",path=~\".*/intel-rapl:[^/]+$\"}[$__rate_interval])",
          "legendFormat": "platform",
          "refId": "C"
        }
      ],
      "title": "RAPL power draw",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 4,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "node_power_supply_current_ampere{instance=~\"$instance\",power_supply=~\"BAT.*\"} * on (power_supply) node_power_supply_voltage_volt{instance=~\"$instance\",power_supply=~\"BAT.*\"}",
          "legendFormat": "{{power_supply}}",
          "refId": "A"
        }
      ],
      "title": "Battery electrical power (sign follows kernel current)",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 5,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "node_power_supply_temp_celsius{instance=~\"$instance\",power_supply=~\"BAT.*\"}",
          "legendFormat": "{{power_supply}}",
          "refId": "A"
        }
      ],
      "title": "Battery temperature",
      "type": "timeseries"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["laptop", "power", "rapl", "rugged"],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": "${DS_PROMETHEUS}",
        "definition": "label_values(node_uname_info{nodename=\"rugged\"}, instance)",
        "hide": 0,
        "includeAll": false,
        "label": "Rugged instance",
        "multi": false,
        "name": "instance",
        "options": [],
        "query": "label_values(node_uname_info{nodename=\"rugged\"}, instance)",
        "refresh": 1,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": { "refresh_intervals": ["10s", "30s", "1m", "5m", "15m", "1h"] },
  "timezone": "",
  "title": "Rugged Power",
  "uid": "rugged-power"
}
