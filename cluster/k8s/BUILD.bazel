filegroup(
    name = "source_watcher_crd_bundle",
    srcs = ["flux/flux-system/gotk-components.yaml"],
    visibility = ["//cluster/cdk8s/providers/source_watcher:__pkg__"],
)

filegroup(
    name = "flux_bootstrap_files",
    srcs = [
        "flux/flux-system/gotk-components.yaml",
        "flux/flux-system/gotk-sync.yaml",
    ],
    visibility = [
        "//cluster/terraform/main:__pkg__",
        "//cluster/validation:__pkg__",
    ],
)

# Whole flux-system overlay (kustomization.yaml + the GitHub App Secret it
# references), which cluster_all_files excludes. cluster/validation's flux-build
# test needs it because the central Flux root includes flux-system/ as a resource.
filegroup(
    name = "flux_system_files",
    srcs = glob(["flux/flux-system/**"]),
    visibility = ["//cluster/validation:__pkg__"],
)

filegroup(
    name = "cluster_yaml_files",
    srcs = glob(
        ["**/*.yaml"],
        exclude = ["flux/flux-system/**"],
    ),
    visibility = ["//cluster:__subpackages__"],
)

filegroup(
    name = "cluster_all_files",
    srcs = glob(
        ["**"],
        exclude = ["flux/flux-system/**"],
    ),
    visibility = ["//cluster:__subpackages__"],
)

# Focused validation targets inline these direct-file inputs in their data lists.
exports_files(
    [
        "clickhouse/cluster/public-coder-credentials.sops.yaml",
        "haku/forgejo-tea/haku-forgejo-tea.sops.yaml",
        "kustomization.yaml",
    ],
    visibility = [
        "//cluster/cdk8s:__pkg__",
        "//cluster/cdk8s/haku_ci:__pkg__",
        "//cluster/validation:__pkg__",
    ],
)

# //cluster/cdk8s/authentik:app lists every one in the `authentik-sso-blueprints` ConfigMap.
filegroup(
    name = "authentik_blueprints",
    srcs = glob(["authentik/app/blueprints/*.yaml"]),
    visibility = [
        "//cluster/cdk8s/authentik:__pkg__",
        "//cluster/validation:__pkg__",
    ],
)

filegroup(
    name = "authentik_blueprint_contract_files",
    srcs = [
        "kustomization.yaml",
        ":authentik_blueprints",
    ],
    visibility = ["//cluster/validation:__pkg__"],
)
