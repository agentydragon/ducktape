filegroup(
    name = "cluster_all_files",
    srcs = glob(
        ["**"],
        exclude = ["flux/flux-system/**"],
    ),
    visibility = ["//cluster:__subpackages__"],
)

# Focused tests inline these direct-file inputs in their data lists.
exports_files(
    ["haku/forgejo-tea/haku-forgejo-tea.sops.yaml"],
    visibility = ["//cluster/cdk8s/haku_ci:__pkg__"],
)

exports_files(
    ["haku/mailbox/nginx.conf"],
    visibility = ["//cluster/cdk8s/haku:__pkg__"],
)

exports_files(
    ["clickhouse/cluster/public-coder-credentials.sops.yaml"],
    visibility = ["//cluster/cdk8s/clickhouse:__pkg__"],
)

exports_files(
    ["agents/plaid-mcp/readonly-role.sql"],
    visibility = ["//cluster/cdk8s/plaid_mcp:__pkg__"],
)
