filegroup(
    name = "source_watcher_crd_bundle",
    srcs = ["flux/flux-system/gotk-components.yaml"],
    visibility = ["//cluster/cdk8s/crd_bindings/source_watcher:__pkg__"],
)

filegroup(
    name = "flux_bootstrap_files",
    srcs = [
        "flux/flux-system/gotk-components.yaml",
        "flux/flux-system/gotk-sync.yaml",
    ],
    visibility = [
        "//cluster/terraform/main:__pkg__",
        "//cluster/validation:__pkg__",
    ],
)

# Whole flux-system overlay (kustomization.yaml + the GitHub App Secret it
# references), which cluster_all_files excludes. cluster/validation's flux-build
# test needs it because the central Flux root includes flux-system/ as a resource.
filegroup(
    name = "flux_system_files",
    srcs = glob(["flux/flux-system/**"]),
    visibility = ["//cluster/validation:__pkg__"],
)

filegroup(
    name = "cluster_yaml_files",
    srcs = glob(
        ["**/*.yaml"],
        exclude = ["flux/flux-system/**"],
    ),
    visibility = ["//cluster:__subpackages__"],
)

# Grafana's candidate verifier reads the dashboard JSON from Bazel runfiles.
filegroup(
    name = "grafana_dashboard_json_files",
    srcs = [
        "monitoring/grafana-instance/cluster-storage-io.json",
        "monitoring/grafana-instance/flux-cluster.json",
        "monitoring/grafana-instance/interface-flap-frequency.json",
        "monitoring/grafana-instance/rugged-power.json",
    ],
    visibility = ["//cluster/skills/grafana:__pkg__"],
)

filegroup(
    name = "ssh_mcp_known_hosts",
    srcs = ["ssh-mcp/known_hosts"],
    visibility = [
        "//cluster/cdk8s:__pkg__",
        "//cluster/cdk8s:__subpackages__",
        "//cluster/validation:__pkg__",
    ],
)

filegroup(
    name = "cluster_all_files",
    srcs = glob(
        ["**"],
        exclude = ["flux/flux-system/**"],
    ),
    visibility = ["//cluster:__subpackages__"],
)

# Focused validation targets inline these direct-file inputs in their data lists.
exports_files(
    [
        "agentplane-crds/crd-actionpolicybindings.yaml",
        "agentplane-crds/crd-actionpolicysets.yaml",
        "agentplane-crds/crd-egressbindings.yaml",
        "agentplane-crds/crd-egresscredentials.yaml",
        "agentplane-crds/crd-egresspolicies.yaml",
        "clickhouse/cluster/clickhouse.k8s.yaml",
        "clickhouse/cluster/public-coder-credentials.sops.yaml",
        "haku/forgejo-tea/haku-forgejo-tea.sops.yaml",
        "kustomization.yaml",
    ],
    visibility = [
        "//agentplane/crds:__pkg__",
        "//cluster/cdk8s:__pkg__",
        "//cluster/cdk8s/haku_ci:__pkg__",
        "//cluster/validation:__pkg__",
    ],
)

# Small direct-file surface for focused schema/wiring contracts. Keeping this
# separate from cluster_all_files lets Bazel avoid the full cluster parse and all
# Kustomize builds when one of these manifests changes.
filegroup(
    name = "haku_manifest_contract_files",
    srcs = [
        "agentplane-staging/agentplane.k8s.yaml",
        "haku/workspaces/app/haku-workspaces.k8s.yaml",
        "haku/workspaces/app/kustomization.yaml",
        "haku/workspaces/image/haku-sandbox-setup.sh",
        "kustomization.yaml",
    ],
    visibility = ["//cluster/validation:__pkg__"],
)

# The rotation manifest the authentik-jwt-rotation CronJob runs, pinned by
# //cluster/validation:test_rotations_config.
filegroup(
    name = "rotations_config",
    srcs = ["agents/authentik-jwt-rotation/rotations.yaml"],
    visibility = ["//cluster/validation:__pkg__"],
)

# The hand-written egress allowlists //cluster/validation:test_egress_allowlists checks
# alongside the generated fences (cluster/cdk8s/egress_fences.py).
filegroup(
    name = "egress_allowlist_files",
    srcs = [
        "agents/haku-egress-proxy/openclaw-spike-iron.yaml",
        "kustomization.yaml",
    ],
    visibility = ["//cluster/validation:__pkg__"],
)

filegroup(
    name = "authentik_blueprint_contract_files",
    srcs = [
        "authentik/app/kustomization.yaml",
        "kustomization.yaml",
    ] + glob(["authentik/app/blueprints/*.yaml"]),
    visibility = ["//cluster/validation:__pkg__"],
)
