filegroup(
    name = "flux_bootstrap_files",
    srcs = [
        "flux-system/gotk-components.yaml",
        "flux-system/gotk-sync.yaml",
    ],
    visibility = [
        "//cluster/terraform/main:__pkg__",
        "//cluster/validation:__pkg__",
    ],
)

# Whole flux-system overlay (kustomization.yaml + the GitHub App Secret it
# references), which cluster_all_files excludes. cluster/validation's flux-build
# test needs it because the root kustomization lists flux-system/ as a resource.
filegroup(
    name = "flux_system_files",
    srcs = glob(["flux-system/**"]),
    visibility = ["//cluster/validation:__pkg__"],
)

filegroup(
    name = "cluster_yaml_files",
    srcs = glob(
        ["**/*.yaml"],
        exclude = ["flux-system/**"],
    ),
    visibility = ["//cluster:__subpackages__"],
)

filegroup(
    name = "openclaw_model_config",
    srcs = [
        "agents/haku-openclaw-spike/app/openclaw.json",
        "agents/public-coder-agent/app/openclaw.json",
    ],
    visibility = ["//cluster/k8s/litellm/app:__pkg__"],
)

filegroup(
    name = "cluster_all_files",
    srcs = glob(
        ["**"],
        exclude = ["flux-system/**"],
    ),
    visibility = ["//cluster:__subpackages__"],
)

# Small direct-file surface for focused schema/wiring contracts. Keeping this
# separate from cluster_all_files lets Bazel avoid the full cluster parse and all
# Kustomize builds when one of these manifests changes.
filegroup(
    name = "haku_manifest_contract_files",
    srcs = [
        "agents/haku-egress-proxy/ccnp-haku-claude-sandbox-egress.yaml",
        "agents/haku-egress-proxy/ccnp-haku-proxy-egress.yaml",
        "agents/haku-egress-proxy/claude-networkpolicy.yaml",
        "haku/console/config.yaml",
        "haku/console/deployment.yaml",
        "haku/console/httproute.yaml",
        "haku/console/service.yaml",
        "haku/workspaces/app/sandboxtemplate-haku-claude.yaml",
        "kustomization.yaml",
        "kyverno/policies/inject-haku-egress-proxy.yaml",
    ],
    visibility = ["//cluster/validation:__pkg__"],
)

# Every egress allowlist in the cluster, pinned by
# //cluster/validation:test_egress_allowlists.
filegroup(
    name = "egress_allowlist_files",
    srcs = [
        "agents/haku-egress-proxy/cnp-haku-claude-egress.yaml",
        "agents/haku-egress-proxy/cnp-haku-cloud-api-egress.yaml",
        "agents/haku-egress-proxy/openclaw-spike-iron.yaml",
        "agents/haku-zones-mitmproxy/cnp-zones-egress.yaml",
        "agents/mitmproxy/cnp-cloud-api-egress.yaml",
        "agents/public-coder-agent/proxy/cnp-egress.yaml",
        "kustomization.yaml",
    ],
    visibility = ["//cluster/validation:__pkg__"],
)

# Every policy that injects proxy configuration into a sandbox namespace, pinned
# to one shared variable set by //cluster/validation:test_proxy_injection.
filegroup(
    name = "proxy_injection_policy_files",
    srcs = [
        "haku/zones/policies/inject-haku-zones-mitmproxy.yaml",
        "kyverno/policies/inject-haku-egress-proxy.yaml",
        "kyverno/policies/inject-mitmproxy.yaml",
    ],
    visibility = ["//cluster/validation:__pkg__"],
)

filegroup(
    name = "ntfy_manifest_contract_files",
    srcs = ["flux-webhook/ntfy-webhook.sops.yaml"],
    visibility = ["//cluster/validation:__pkg__"],
)

filegroup(
    name = "authentik_blueprint_contract_files",
    srcs = [
        "authentik/app/kustomization.yaml",
        "kustomization.yaml",
    ] + glob(["authentik/app/blueprints/*.yaml"]),
    visibility = ["//cluster/validation:__pkg__"],
)

# The production mirror roster, consumed by loom/gym's panel-coverage test (the gym
# panel and the deployed roster must not drift).
filegroup(
    name = "market_roster_yaml",
    srcs = ["evidence/market-roster/market-roster.yaml"],
    visibility = ["//loom/gym:__pkg__"],
)
