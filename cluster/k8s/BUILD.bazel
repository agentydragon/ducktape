filegroup(
    name = "cluster_yaml_files",
    srcs = glob(
        ["**/*.yaml"],
        exclude = ["flux/flux-system/**"],
    ),
    visibility = ["//cluster:__subpackages__"],
)

filegroup(
    name = "cluster_all_files",
    srcs = glob(
        ["**"],
        exclude = ["flux/flux-system/**"],
    ),
    visibility = ["//cluster:__subpackages__"],
)

filegroup(
    name = "buildbuddy_kvm_worker_manifests",
    srcs = [
        "buildbuddy-kvm-worker/buildbuddy-kvm-worker.k8s.yaml",
        "buildbuddy-kvm-worker/image-pins/kustomization.yaml",
        "buildbuddy-kvm-worker/image-pins/kustomizeconfig",
        "buildbuddy-kvm-worker/kustomization.yaml",
    ],
    visibility = ["//cluster/validation:__pkg__"],
)

