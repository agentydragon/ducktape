load("@rules_python//python:defs.bzl", "py_library")
load("//devinfra/python:defs.bzl", "py_binary", "py_test")

py_library(
    name = "probe_models",
    srcs = ["probe_models.py"],
    deps = [
        "@pypi//httpx",
        "@pypi//jinja2",
        "@pypi//pydantic",
        "@pypi//pyyaml",
        "@rules_python//python/runfiles",
    ],
)

py_binary(
    name = "probe_models_bin",
    data = [
        "report.html.j2",
        "//cluster/k8s/litellm/app:proxy_manifest",
    ],
    main_module = "cluster.debug.litellm_probe.probe_models",
    deps = [":probe_models"],
)

py_test(
    name = "test_probe_models",
    srcs = ["test_probe_models.py"],
    deps = [
        ":probe_models",
        "//:conftest",
        "@pypi//pytest_bazel",
        "@pypi//pyyaml",
    ],
)
