# Bench Job template. Substitute __TARGET_NAME__ (the cell label, e.g. seaweedfs-ssd).
# Prereqs (see README): GitLab deployed in `gitlab-bench` with Gitaly on the target
# storage class; ConfigMap `gitlab-bench-script` (from gitlab-bench.sh) and Secret
# `gitlab-bench-token` (key `token`, a root PAT with api+write_repository) present.
apiVersion: batch/v1
kind: Job
metadata:
  name: gitlab-storage-bench-__TARGET_NAME__
  namespace: gitlab-bench
spec:
  backoffLimit: 2 # unlike the Forgejo one-shot jobs: retry transient setup 500s
  template:
    metadata:
      labels:
        app.kubernetes.io/name: gitlab-storage-bench
    spec:
      restartPolicy: Never
      nodeSelector:
        topology.kubernetes.io/region: hil
      containers:
        - name: benchmark
          image: alpine:3.20
          command:
            - /bin/sh
            - -c
            - apk add --no-cache git curl jq >/dev/null && exec /bin/sh /scripts/gitlab-bench.sh
          env:
            - name: TARGET_NAME
              value: __TARGET_NAME__
            - name: GITLAB_URL
              value: http://gitlab-bench-webservice-default.gitlab-bench.svc.cluster.local:8181
            - name: GITLAB_TOKEN
              valueFrom:
                secretKeyRef:
                  name: gitlab-bench-token
                  key: token
          volumeMounts:
            - name: scripts
              mountPath: /scripts
      volumes:
        - name: scripts
          configMap:
            name: gitlab-bench-script
            defaultMode: 0555
