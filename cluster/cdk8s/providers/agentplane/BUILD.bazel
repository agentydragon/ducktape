# Generic, cluster-topology-free cdk8s wrapper constructors for Agentplane's own CRDs
# (agentplane/crds/manifests/crd-*.yaml). These CRDs are first-party (unlike every other provider under
# cluster/cdk8s/providers/), so their cdk8s_import declarations stay colocated with their
# authoritative YAML source under //agentplane/crds -- see that package's BUILD.bazel header --
# and this package only depends on those targets.

load("//devinfra/python:defs.bzl", "py_library", "py_test")

py_library(
    name = "egress_credential",
    srcs = ["egress_credential.py"],
    visibility = [
        "//agentplane/system_tests/k3s:__pkg__",
        "//cluster/cdk8s:__subpackages__",
    ],
    deps = [
        "//agentplane/crds:egresscredential",
        "@pypi//cdk8s",
        "@pypi//constructs",
    ],
)

py_test(
    name = "test_egress_credential",
    srcs = ["test_egress_credential.py"],
    data = ["@nodejs_linux_amd64//:bin/node"],
    env = {"JSII_NODE": "$(rootpath @nodejs_linux_amd64//:bin/node)"},
    deps = [
        ":egress_credential",
        "//:conftest",
        "//agentplane/crds:egresscredential",
        "//cluster/cdk8s/testing:scratch",
        "@pypi//cdk8s",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "policy_set",
    srcs = ["policy_set.py"],
    visibility = [
        "//agentplane/system_tests/k3s:__pkg__",
        "//cluster/cdk8s:__subpackages__",
    ],
    deps = [
        "//agentplane/crds:policyset",
        "@pypi//cdk8s",
        "@pypi//constructs",
    ],
)

py_library(
    name = "policy_binding",
    srcs = ["policy_binding.py"],
    visibility = ["//cluster/cdk8s:__subpackages__"],
    deps = [
        "//agentplane/crds:policybinding",
        "@pypi//cdk8s",
        "@pypi//constructs",
    ],
)
