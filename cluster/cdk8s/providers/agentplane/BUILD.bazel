# Generic, cluster-topology-free cdk8s wrapper constructors for Agentplane's own CRDs
# (agentplane/crds/manifests/crd-*.yaml). These CRDs are first-party (unlike every other provider under
# cluster/cdk8s/providers/), so their cdk8s_import declarations stay colocated with their
# authoritative YAML source under //agentplane/crds -- see that package's BUILD.bazel header --
# and this package only depends on those targets.

# gazelle:resolve py agentplane_kubernetesroleset_crds //agentplane/crds:kubernetesroleset
# gazelle:resolve py agentplane_policybinding_crds //agentplane/crds:policybinding
load("//devinfra/python:defs.bzl", "py_library")

py_library(
    name = "egress_credential",
    srcs = ["egress_credential.py"],
    visibility = ["//cluster/cdk8s:deployment_consumers"],
    deps = [
        "//agentplane/crds:egresscredential",
        "@pypi//cdk8s_plus_34",
    ],
)

py_library(
    name = "policy_set",
    srcs = ["policy_set.py"],
    visibility = ["//cluster/cdk8s:deployment_consumers"],
    deps = ["//agentplane/crds:policyset"],
)

py_library(
    name = "identity",
    srcs = ["identity.py"],
    visibility = [
        "//agentplane/system_tests/deployment:__pkg__",
        "//cluster/cdk8s:__subpackages__",
    ],
    deps = [
        "//agentplane/crds:identity",
        "//agentplane/crds:policybinding",
        "@pypi//cdk8s",
        "@pypi//constructs",
    ],
)

py_library(
    name = "kubernetes_role_set",
    srcs = ["kubernetes_role_set.py"],
    visibility = ["//cluster/cdk8s:__subpackages__"],
    deps = ["//agentplane/crds:kubernetesroleset"],
)

py_library(
    name = "service_account_grant",
    srcs = ["service_account_grant.py"],
    visibility = ["//cluster/cdk8s:__subpackages__"],
    deps = [
        "//agentplane/crds:kubernetesroleset",
        "//agentplane/crds:serviceaccountgrant",
        "@pypi//cdk8s",
        "@pypi//cdk8s_plus_34",
        "@pypi//constructs",
    ],
)

py_library(
    name = "workload_credential",
    srcs = ["workload_credential.py"],
    visibility = ["//cluster/cdk8s:__subpackages__"],
    deps = [
        ":identity",
        "//agentplane/crds:workloadcredential",
        "@pypi//cdk8s",
        "@pypi//constructs",
    ],
)
