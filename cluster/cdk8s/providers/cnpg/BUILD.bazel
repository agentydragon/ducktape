    module_name = "cnpg_cluster_crds",
    module_path = "io/cnpg/postgresql",
    visibility = ["//visibility:public"],
)

cdk8s_import(
    name = "database",
    crd = "@cnpg_database_crd//file",
    module_name = "cnpg_database_crds",
    module_path = "io/cnpg/postgresql",
    visibility = ["//visibility:public"],
)

cdk8s_import(
    name = "scheduledbackup",
    crd = "@cnpg_scheduledbackup_crd//file",
    module_name = "cnpg_scheduledbackup_crds",
    module_path = "io/cnpg/postgresql",
    visibility = ["//visibility:public"],
)

cdk8s_import(
    name = "objectstore",
    crd = "@barman_cloud_objectstore_crd//file",
    module_name = "barman_cloud_objectstore_crds",
    module_path = "io/cnpg/barmancloud",
    visibility = ["//visibility:public"],
)

py_library(
    name = "cnpg_cluster",
    srcs = ["cluster.py"],
    visibility = ["//cluster/cdk8s:__subpackages__"],
