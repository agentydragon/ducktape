# gazelle:ignore
# gazelle:resolve py agent_sandbox_sandboxtemplate_crds //cluster/cdk8s/providers/agent_sandbox:sandboxtemplate
# gazelle:resolve py agent_sandbox_sandboxwarmpool_crds //cluster/cdk8s/providers/agent_sandbox:sandboxwarmpool

load("//devinfra/js:cdk8s_import.bzl", "cdk8s_import")
load("//devinfra/python:defs.bzl", "py_library")

cdk8s_import(
    name = "sandboxtemplate",
    # The release asset bundles several CRDs plus controller manifests; only import
    # SandboxTemplate, the CRD statically authored by Agentplane. Sandbox objects are
    # created at runtime. Pin the served+storage version because the bundle also lists
    # a deprecated v1alpha1 after v1beta1.
    crd = "@agent_sandbox_release_bundle//file",
    crd_name = "sandboxtemplates.extensions.agents.x-k8s.io",
    crd_version = "v1beta1",
    jsii_module_path = "io/x-k8s/agents/extensions",
    module_name = "agent_sandbox_sandboxtemplate_crds",
    module_path = "io/x_k8s/agents/extensions",
    visibility = ["//visibility:public"],
)

# Pinned to v1beta1 for the same reason as SandboxTemplate.
cdk8s_import(
    name = "sandboxwarmpool",
    crd = "@agent_sandbox_release_bundle//file",
    crd_name = "sandboxwarmpools.extensions.agents.x-k8s.io",
    crd_version = "v1beta1",
    jsii_module_path = "io/x-k8s/agents/extensions",
    module_name = "agent_sandbox_sandboxwarmpool_crds",
    module_path = "io/x_k8s/agents/extensions",
    visibility = ["//visibility:public"],
)

py_library(
    name = "sandbox_template",
    srcs = ["sandbox_template.py"],
    visibility = ["//cluster/cdk8s:__subpackages__"],
    deps = [
        ":sandboxtemplate",
        "//cluster/cdk8s:metadata",
        "@pypi//constructs",
    ],
)
