+func TestReadKeyClearsOrganizationIDWhenAPIOmitsIt(t *testing.T) {
+	t.Parallel()
+
+	for _, testCase := range []struct {
+		name           string
+		organizationID types.String
+	}{
+		{name: "unknown", organizationID: types.StringUnknown()},
+		{name: "stale value", organizationID: types.StringValue("ducktape")},
+	} {
+		t.Run(testCase.name, func(t *testing.T) {
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("Content-Type", "application/json")
+				_ = json.NewEncoder(w).Encode(map[string]interface{}{
+					"key":  "key-123",
+					"info": map[string]interface{}{"key": "key-123"},
+				})
+			}))
+			defer server.Close()
+
+			r := &KeyResource{
+				client: &Client{
+					APIBase:    server.URL,
+					APIKey:     "test-key",
+					HTTPClient: server.Client(),
+				},
+			}
+
+			data := KeyResourceModel{
+				ID:             types.StringValue("key-123"),
+				Key:            types.StringValue("key-123"),
+				OrganizationID: testCase.organizationID,
+			}
+
+			if err := r.readKey(context.Background(), &data); err != nil {
+				t.Fatalf("readKey returned error: %v", err)
+			}
+			if !data.OrganizationID.IsNull() {
+				t.Fatalf("organization_id should resolve to null when omitted, got %#v", data.OrganizationID)
+			}
+		})
+	}
+}
