# gazelle:ignore
# gazelle:resolve py litellm_key_crds //cluster/cdk8s/providers/litellm:key
# gazelle:resolve py litellm_team_crds //cluster/cdk8s/providers/litellm:team
# gazelle:resolve py litellm_providerconfig_crds //cluster/cdk8s/providers/litellm:providerconfig

load("//devinfra/js:cdk8s_import.bzl", "cdk8s_import")

cdk8s_import(
    name = "key",
    crd = "@crossplane_litellm_keys_crd//file",
    crd_name = "keys.litellm.m.crossplane.io",
    module_name = "litellm_key_crds",
    module_path = "io/crossplane/m/litellm",
    visibility = ["//cluster/cdk8s:__subpackages__"],
)

cdk8s_import(
    name = "team",
    crd = "@crossplane_litellm_teams_crd//file",
    crd_name = "teams.litellm.m.crossplane.io",
    module_name = "litellm_team_crds",
    module_path = "io/crossplane/m/litellm",
    visibility = ["//cluster/cdk8s:__subpackages__"],
)

cdk8s_import(
    name = "providerconfig",
    crd = "@crossplane_litellm_providerconfigs_crd//file",
    crd_name = "providerconfigs.litellm.m.crossplane.io",
    # cdk8s import uppercases the wire enum values here, but the installed CRD accepts the
    # case-sensitive values `Secret`, `Environment`, and so on. Keep this generated field a
    # typed string so callers can supply the actual CRD values.
    crd_remove_paths = ["spec.versions.0.schema.openAPIV3Schema.properties.spec.properties.credentials.properties.source.enum"],
    module_name = "litellm_providerconfig_crds",
    module_path = "io/crossplane/m/litellm",
    visibility = ["//cluster/cdk8s:__subpackages__"],
)
