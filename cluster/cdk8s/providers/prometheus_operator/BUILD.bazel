    name = "prometheusrule",
    crd = "@prometheus_operator_prometheusrule_crd//file",
    module_name = "prometheus_operator_prometheusrule_crds",
    module_path = "com/coreos/monitoring",
    visibility = ["//visibility:public"],
)

py_library(
    name = "service_monitor",
    srcs = ["service_monitor.py"],
    visibility = ["//cluster/cdk8s:__subpackages__"],
    deps = [
        ":servicemonitor",
        "@pypi//cdk8s",
        "@pypi//constructs",
    ],
)

