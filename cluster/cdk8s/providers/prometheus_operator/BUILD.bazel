load("//devinfra/js:cdk8s_import.bzl", "cdk8s_import")
load("//devinfra/python:defs.bzl", "py_library", "py_test")

cdk8s_import(
    name = "servicemonitor",
    crd = "@prometheus_operator_servicemonitor_crd//file",
    module_name = "prometheus_operator_crds",
    module_path = "com/coreos/monitoring",
    visibility = ["//visibility:public"],
)

cdk8s_import(
    name = "podmonitor",
    crd = "@prometheus_operator_podmonitor_crd//file",
    module_name = "prometheus_operator_podmonitor_crds",
    module_path = "com/coreos/monitoring",
    visibility = ["//visibility:public"],
)

