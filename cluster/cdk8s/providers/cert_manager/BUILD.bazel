# gazelle:ignore
# gazelle:resolve py cert_manager_crds //cluster/cdk8s/providers/cert_manager:certificate
# gazelle:resolve py trust_manager_crds //cluster/cdk8s/providers/cert_manager:bundle
# gazelle:resolve py cert_manager_clusterissuer_crds //cluster/cdk8s/providers/cert_manager:clusterissuer
# gazelle:resolve py cert_manager_issuer_crds //cluster/cdk8s/providers/cert_manager:issuer

load("//devinfra/js:cdk8s_import.bzl", "cdk8s_import")
load("//devinfra/python:defs.bzl", "py_library")

cdk8s_import(
    name = "certificate",
    crd = "@cert_manager_certificate_crd//file",
    # The CRD group (cert-manager.io) has a dash -- the jsii assembly tarball keeps it,
    # unlike the Python package path (see cdk8s_import.bzl's jsii_module_path doc).
    jsii_module_path = "io/cert-manager",
    module_name = "cert_manager_crds",
    module_path = "io/cert_manager",
    visibility = ["//visibility:public"],
)

cdk8s_import(
    name = "bundle",
    crd = "@trust_manager_bundle_crd//file",
    jsii_module_path = "io/cert-manager/trust",
    module_name = "trust_manager_crds",
    module_path = "io/cert_manager/trust",
    visibility = ["//visibility:public"],
)

cdk8s_import(
    name = "clusterissuer",
    crd = "@cert_manager_clusterissuer_crd//file",
    jsii_module_path = "io/cert-manager",
    module_name = "cert_manager_clusterissuer_crds",
    module_path = "io/cert_manager",
    visibility = ["//visibility:public"],
)

cdk8s_import(
    name = "issuer",
    crd = "@cert_manager_issuer_crd//file",
    jsii_module_path = "io/cert-manager",
    module_name = "cert_manager_issuer_crds",
    module_path = "io/cert_manager",
    visibility = ["//visibility:public"],
)

py_library(
    name = "cert_manager_certificate",
    srcs = ["certificate.py"],
    visibility = ["//cluster/cdk8s:__subpackages__"],
    deps = [
        ":certificate",
        "//cluster/cdk8s:metadata",
        "@pypi//constructs",
    ],
)

py_library(
    name = "cluster_issuer",
    srcs = ["cluster_issuer.py"],
    visibility = ["//cluster/cdk8s:__subpackages__"],
    deps = [
        ":clusterissuer",
        "@pypi//cdk8s",
        "@pypi//constructs",
    ],
)
