    name = "test_generate_manifests",
    # Synth imports the agentplane services' Settings, and with them their runtime modules.
    size = "medium",
    srcs = ["test_generate_manifests.py"],
    # Everything the generator may write, so each written file finds its committed twin, and
    # the whole generated root, which the test holds closed. cluster_all_files' glob stops at
    # sub-package boundaries.
    data = [
        "//cluster:generated_manifests",
        "//cluster/k8s:cluster_all_files",
        "//cluster/k8s/agents/ha-mcp/app:manifests",
        "//cluster/k8s/agents/loki-read-proxy:manifests",
