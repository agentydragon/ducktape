# gazelle:alias_kind grafana_dashboard py_library
# gazelle:resolve py grafana_grafanadashboard_crds //cluster/cdk8s/providers/grafana_operator:grafanadashboard
# gazelle:resolve py prometheus_operator_crds //cluster/cdk8s/providers/prometheus_operator:servicemonitor
load("//devinfra/python:defs.bzl", "py_library")
load("//grafana:dashboard.bzl", "grafana_dashboard")
load("//grafana/visual_tests:visual_test.bzl", "grafana_dashboard_visual_test")

py_library(
    name = "app",
    srcs = ["app.py"],
    data = [
        ":github-api-quotas.json",
    ],
    visibility = ["//cluster/cdk8s:__pkg__"],
    deps = [
        "//cluster/cdk8s:container_resources",
        "//cluster/cdk8s:external_creds",
        "//cluster/cdk8s:manifest_roots",
        "//cluster/cdk8s:service_ref",
        "//cluster/cdk8s/forgejo_registry:pull_credentials",
        "//cluster/cdk8s/monitoring:grafana_instance",
        "//cluster/cdk8s/providers/external_secrets:external_secret",
        "//cluster/cdk8s/providers/external_secrets:externalsecret",
        "//cluster/cdk8s/providers/prometheus_operator:servicemonitor",
        "@pypi//cdk8s",
        "@pypi//cdk8s_plus_34",
        "@rules_python//python/runfiles",
    ],
)

grafana_dashboard_visual_test(
    name = "dashboard_visual_test",
    dashboard = ":github-api-quotas.json",
    fixture_data = ":dashboard_visual_fixture.json",
)

grafana_dashboard(
    name = "github_api_quotas",
    srcs = ["github_api_quotas.py"],
    deps = [
        "//cluster/cdk8s/monitoring/dashboards:foundation",
        "@pypi//grafana_foundation_sdk",
    ],
)
