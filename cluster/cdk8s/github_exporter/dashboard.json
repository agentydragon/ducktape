{
  "annotations": {
    "list": []
  },
  "editable": false,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 20
              },
              {
                "color": "green",
                "value": 50
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "100 * github_graphql_rate_remaining / on (github_account) github_graphql_rate_limit",
          "legendFormat": "{{github_account}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "GraphQL quota remaining",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "min"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "github_graphql_rate_remaining",
          "legendFormat": "{{github_account}} remaining",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "github_graphql_rate_limit",
          "legendFormat": "{{github_account}} limit",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "GraphQL quota history",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "id": 3,
      "options": {
        "legend": {
          "calcs": ["lastNotNull"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "github_rate_remaining{resource!=\"graphql\"}",
          "legendFormat": "{{github_account}} / {{resource}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Remaining quota by REST API resource",
      "type": "timeseries",
      "description": "From REST /rate_limit. `graphql` is excluded: that endpoint reports the GraphQL bucket as permanently full even while GraphQL is exhausted. The GraphQL panels above read GitHub's GraphQL response headers instead."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "GraphQL points consumed in the current window. This can exceed the limit: GitHub keeps counting requests it is already rejecting.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "id": 4,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "github_graphql_rate_used",
          "legendFormat": "{{github_account}} used",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "github_graphql_rate_limit",
          "legendFormat": "{{github_account}} limit",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "GraphQL points used this window",
      "type": "timeseries"
    }
  ],
  "refresh": "5m",
  "schemaVersion": 41,
  "tags": ["github", "quotas"],
  "time": {
    "from": "now-7d",
    "to": "now"
