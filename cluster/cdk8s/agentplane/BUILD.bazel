# The conftest's in-memory synth needs jsii's Node runtime.
py_test(
    name = "test_actions_constructs",
    # Synth imports the agentplane services' Settings, and with them their runtime modules.
    size = "medium",
    srcs = ["test_actions_constructs.py"],
    data = ["@nodejs_linux_amd64//:bin/node"],
    env = {"JSII_NODE": "$(rootpath @nodejs_linux_amd64//:bin/node)"},
    deps = [
        ":conftest",
        "//:conftest",
        "@pypi//more_itertools",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

