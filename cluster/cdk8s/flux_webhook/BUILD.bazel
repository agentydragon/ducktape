# gazelle:ignore

load("//devinfra/python:defs.bzl", "py_library", "py_test")

py_library(
    name = "chart",
    srcs = ["chart.py"],
    visibility = ["//cluster/cdk8s:__pkg__"],
    deps = [
        "//cluster/cdk8s:flux",
        "//cluster/cdk8s:gateway",
        "//cluster/cdk8s:generation",
        "//cluster/cdk8s:manifest_roots",
        "//cluster/cdk8s:metadata",
        "//cluster/cdk8s:ntfy",
        "//cluster/cdk8s/crd_bindings/external_secrets:externalsecret",
        "//cluster/cdk8s/crd_bindings/flux:alert",
        "//cluster/cdk8s/crd_bindings/flux:provider",
        "//cluster/cdk8s/crd_bindings/flux:receiver",
        "//cluster/cdk8s/crd_bindings/source_watcher:artifactgenerator",
        "//cluster/cdk8s/external_secrets:external_secret",
        "@pypi//cdk8s",
        "@pypi//cdk8s_plus_34",
    ],
)

py_test(
    name = "test_chart",
    srcs = ["test_chart.py"],
    data = ["@nodejs_linux_amd64//:bin/node"],
    env = {"JSII_NODE": "$(rootpath @nodejs_linux_amd64//:bin/node)"},
    deps = [
        ":chart",
        "//:conftest",
        "@pypi//pytest_bazel",
        "@pypi//pyyaml",
    ],
)
