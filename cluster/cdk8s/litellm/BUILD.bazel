# gazelle:ignore

load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//cluster/cdk8s:__pkg__"])

py_library(
    name = "config",
    srcs = ["config.py"],
    visibility = [
        "//cluster/cdk8s/litellm:__pkg__",
        "//cluster/debug/litellm_probe:__pkg__",
    ],
    deps = ["//cluster/cdk8s:model_rosters"],
)

py_library(
    name = "keys",
    srcs = ["keys.py"],
    visibility = [
        "//cluster/cdk8s:__pkg__",
        "//cluster/cdk8s/agentplane:__pkg__",
    ],
    deps = [
        ":config",
        "//cluster/cdk8s:flux",
        "//cluster/cdk8s:generation",
        "//cluster/cdk8s:manifest_roots",
        "//cluster/cdk8s:model_rosters",
        "//cluster/cdk8s:terraform",
        "//cluster/cdk8s/crd_bindings/source_watcher:artifactgenerator",
        "@pypi//cdk8s",
    ],
)

py_library(
    name = "credentials",
    srcs = ["credentials.py"],
    deps = [
        "//cluster/cdk8s:flux",
        "//cluster/cdk8s:generation",
        "//cluster/cdk8s:manifest_roots",
        "//cluster/cdk8s:metadata",
        "//cluster/cdk8s/crd_bindings/external_secrets:clustersecretstore",
        "//cluster/cdk8s/crd_bindings/external_secrets:externalsecret",
        "//cluster/cdk8s/external_secrets:external_secret",
        "@pypi//cdk8s",
        "@pypi//cdk8s_plus_34",
        "@pypi//constructs",
    ],
)

py_library(
    name = "proxy",
    srcs = ["proxy.py"],
    deps = [
        ":config",
        "//cluster/cdk8s:config_format",
        "//cluster/cdk8s:fleet_rules",
        "//cluster/cdk8s:flux",
        "//cluster/cdk8s:forgejo_images",
        "//cluster/cdk8s:gateway",
        "//cluster/cdk8s:generation",
        "//cluster/cdk8s:manifest_roots",
        "//cluster/cdk8s:metadata",
        "//cluster/cdk8s:pod_spec_patches",
        "//cluster/cdk8s:probes",
        "//cluster/cdk8s/crd_bindings/flux:kustomization",
        "//cluster/cdk8s/crd_bindings/prometheus_operator:servicemonitor",
        "//cluster/cdk8s/crd_bindings/source_watcher:artifactgenerator",
        "@pypi//cdk8s",
        "@pypi//cdk8s_plus_34",
        "@pypi//constructs",
    ],
)

py_library(
    name = "namespace",
    srcs = ["namespace.py"],
    deps = [
        ":database",
        "//cluster/cdk8s:flux",
        "//cluster/cdk8s:generation",
        "//cluster/cdk8s:manifest_roots",
    ],
)

py_library(
    name = "database",
    srcs = ["database.py"],
    deps = [
        "//cluster/cdk8s:cnpg",
        "//cluster/cdk8s:generation",
        "//cluster/cdk8s:manifest_roots",
        "//cluster/cdk8s/crd_bindings/cnpg:cluster",
        "@pypi//cdk8s",
    ],
)

py_library(
    name = "secrets",
    srcs = ["secrets.py"],
    deps = [
        "//cluster/cdk8s:flux",
        "//cluster/cdk8s:generation",
        "//cluster/cdk8s:manifest_roots",
        "//cluster/cdk8s:metadata",
        "//cluster/cdk8s/crd_bindings/external_secrets:externalsecret",
        "//cluster/cdk8s/external_secrets:external_secret",
        "//cluster/cdk8s/external_secrets:single_secret_store",
        "@pypi//cdk8s",
        "@pypi//cdk8s_plus_34",
    ],
)

py_test(
    name = "test_config",
    srcs = ["test_config.py"],
    deps = [
        ":config",
        "//:conftest",
        "//cluster/cdk8s:model_rosters",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_openclaw_models",
    srcs = ["test_openclaw_models.py"],
    data = ["@nodejs_linux_amd64//:bin/node"],
    env = {"JSII_NODE": "$(rootpath @nodejs_linux_amd64//:bin/node)"},
    deps = [
        ":config",
        "//:conftest",
        "//cluster/cdk8s:haku_openclaw_spike_config",
        "//cluster/cdk8s:model_rosters",
        "//cluster/cdk8s:public_coder_agent_config",
        "@pypi//cdk8s",
        "@pypi//pytest_bazel",
    ],
)
