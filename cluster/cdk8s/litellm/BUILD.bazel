# gazelle:ignore

load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//cluster/cdk8s:__pkg__"])

py_library(
    name = "config",
    srcs = ["config.py"],
    visibility = [
        "//cluster/cdk8s:__pkg__",
        "//cluster/cdk8s/litellm:__pkg__",
    ],
    deps = [
        ":upstreams",
        "//model_catalog:catalog",
    ],
)

py_library(
    name = "keys",
    srcs = ["keys.py"],
    visibility = [
        "//cluster/cdk8s:__pkg__",
        "//cluster/cdk8s/agentplane:__pkg__",
    ],
    deps = [
        "//cluster/cdk8s:flux",
        "//cluster/cdk8s:manifest_roots",
        "//cluster/cdk8s:secret_ref",
        "//cluster/cdk8s:terraform",
        "//model_catalog:policies",
        "@pypi//cdk8s",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "credentials",
    srcs = ["credentials.py"],
    visibility = [
        "//cluster/cdk8s:__pkg__",
        "//cluster/cdk8s/agentplane:__pkg__",
    ],
    deps = [
        "//cluster/cdk8s:flux",
        "//cluster/cdk8s:generation",
        "//cluster/cdk8s:secret_ref",
        "//cluster/cdk8s/external_secrets:single_secret_store",
        "//cluster/cdk8s/providers/external_secrets:external_secret",
        "//cluster/cdk8s/providers/external_secrets:externalsecret",
        "@pypi//cdk8s",
        "@pypi//cdk8s_plus_34",
        "@pypi//constructs",
    ],
)

py_library(
    name = "proxy",
    srcs = ["proxy.py"],
    visibility = [
        "//cluster/cdk8s:__pkg__",
        "//cluster/cdk8s/agentplane:__pkg__",
        "//cluster/cdk8s/gatus:__pkg__",
    ],
    deps = [
        ":config",
        ":database",
        "//cluster/cdk8s:config_format",
        "//cluster/cdk8s:fleet_rules",
        "//cluster/cdk8s:flux",
        "//cluster/cdk8s:forgejo_images",
        "//cluster/cdk8s:gateway",
        "//cluster/cdk8s:generation",
        "//cluster/cdk8s:manifest_roots",
        "//cluster/cdk8s:node_scheduling",
        "//cluster/cdk8s:pod_policy",
        "//cluster/cdk8s:probes",
        "//cluster/cdk8s:secret_ref",
        "//cluster/cdk8s:service_ref",
        "//cluster/cdk8s/providers/flux:kustomization",
        "//cluster/cdk8s/providers/prometheus_operator:service_monitor",
        "//cluster/cdk8s/providers/prometheus_operator:servicemonitor",
        "//cluster/cdk8s/providers/source_watcher:artifactgenerator",
        "@pypi//cdk8s",
        "@pypi//cdk8s_plus_34",
        "@pypi//constructs",
    ],
)

py_library(
    name = "namespace",
    srcs = ["namespace.py"],
    deps = [
        ":database",
        "//cluster/cdk8s:flux",
        "//cluster/cdk8s:generation",
        "//cluster/cdk8s:manifest_roots",
        "//cluster/cdk8s:namespaces",
    ],
)

py_library(
    name = "database",
    srcs = ["database.py"],
    deps = [
        "//cluster/cdk8s:cnpg",
        "//cluster/cdk8s:generation",
        "//cluster/cdk8s:manifest_roots",
        "//cluster/cdk8s:node_scheduling",
        "@pypi//cdk8s",
    ],
)

py_library(
    name = "secrets",
    srcs = ["secrets.py"],
    deps = [
        "//cluster/cdk8s:flux",
        "//cluster/cdk8s:generation",
        "//cluster/cdk8s:manifest_roots",
        "//cluster/cdk8s/external_secrets:single_secret_store",
