/*
!/nebula-mesh.json
# data.sops_file.ovh_{credentials,rescue_ssh} and, if -target ever stops
# pruning them, the nebula certs under secrets/nebula/. Ciphertext only.
!/secrets
!/cluster
/cluster/*
!/cluster/terraform
# Every file()-family call in the root, wherever it sits: -target does not
# prune configuration evaluation. talos-cloud-controller-manager for
# talos-ccm.tf's locals, flux-system for null_resource.flux_bootstrap's
# triggers. The rest of cluster/{k8s,generated} (10 MB) reads nothing.
!/cluster/generated
/cluster/generated/*
!/cluster/generated/talos-cloud-controller-manager
!/cluster/k8s
/cluster/k8s/*
!/cluster/k8s/flux
/cluster/k8s/flux/*
!/cluster/k8s/flux/flux-system
# module "wyrm2_image": `tofu init` installs every module block in the
# config, whether or not -target keeps it in the plan graph.
!/terraform
/terraform/*
!/terraform/modules
