# gazelle:ignore

load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//cluster/cdk8s:__pkg__"])

py_library(
    name = "console_config",
    srcs = ["console_config.py"],
    visibility = [
        "//cluster/cdk8s:__pkg__",
        "//cluster/cdk8s/haku:__pkg__",
        "//cluster/cdk8s/ssh_mcp:__pkg__",
        "//cluster/validation:__pkg__",
    ],
    deps = ["//cluster/cdk8s/ssh_mcp:config"],
)

py_library(
    name = "database",
    srcs = ["database.py"],
    deps = [
        "//cluster/cdk8s:cnpg",
        "//cluster/cdk8s:metadata",
        "//cluster/cdk8s/agentplane:node_scheduling",
        "//cluster/cdk8s/crd_bindings/cnpg:cluster",
        "//cluster/cdk8s/crd_bindings/cnpg:database",
        "//cluster/cdk8s/crd_bindings/external_secrets:externalsecret",
        "//cluster/cdk8s/crd_bindings/external_secrets:passwordgenerator",
        "@pypi//cdk8s",
        "@pypi//constructs",
    ],
)

py_library(
    name = "console",
    srcs = ["console.py"],
    deps = [
        ":console_config",
        ":database",
        "//cluster/cdk8s:config_format",
        "//cluster/cdk8s:external_creds",
        "//cluster/cdk8s:forgejo_images",
        "//cluster/cdk8s:gateway",
        "//cluster/cdk8s:metadata",
        "//cluster/cdk8s:pod_spec_patches",
        "//cluster/cdk8s:probes",
        "//cluster/cdk8s/agentplane:container_security",
        "//cluster/cdk8s/agentplane:node_scheduling",
        "//cluster/cdk8s/crd_bindings/prometheus_operator:servicemonitor",
        "//cluster/cdk8s/ssh_mcp:config",
        "//haku/console:config",
        "//haku/console:mcp_config",
        "//haku/console:settings",
        "//util:settings_contract",
        "@pypi//cdk8s",
        "@pypi//cdk8s_plus_34",
        "@pypi//constructs",
    ],
)

py_library(
    name = "kube_api_proxy",
    srcs = ["kube_api_proxy.py"],
    deps = [
        ":console",
        "//cluster/cdk8s:cilium",
        "//cluster/cdk8s:forgejo_images",
        "//cluster/cdk8s:gateway",
        "//cluster/cdk8s:metadata",
        "//cluster/cdk8s:pod_spec_patches",
        "//cluster/cdk8s:probes",
        "//cluster/cdk8s/crd_bindings/cert_manager:certificate",
        "@pypi//cdk8s",
        "@pypi//cdk8s_plus_34",
        "@pypi//constructs",
    ],
)

py_library(
    name = "migration",
    srcs = ["migration.py"],
    deps = [
        ":console",
        "//cluster/cdk8s:forgejo_images",
        "//cluster/cdk8s:metadata",
        "//cluster/cdk8s:pod_spec_patches",
        "//cluster/cdk8s/agentplane:container_security",
        "//cluster/cdk8s/agentplane:node_scheduling",
        "@pypi//cdk8s",
        "@pypi//cdk8s_plus_34",
        "@pypi//constructs",
    ],
)

py_library(
    name = "charts",
    srcs = ["charts.py"],
    visibility = [
        "//cluster/cdk8s:__pkg__",
        "//cluster/validation:__pkg__",
    ],
    deps = [
        ":console",
        ":database",
        ":kube_api_proxy",
        ":migration",
        "//cluster/cdk8s:artifact_generators",
        "//cluster/cdk8s:fleet_rules",
        "//cluster/cdk8s:flux",
        "//cluster/cdk8s:forgejo_images",
        "//cluster/cdk8s:generation",
        "//cluster/cdk8s/crd_bindings/flux:kustomization",
        "//cluster/cdk8s/crd_bindings/source_watcher:artifactgenerator",
        "//cluster/cdk8s/ssh_mcp:config",
        "@pypi//cdk8s",
        "@pypi//cdk8s_plus_34",
    ],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    deps = [
        ":charts",
        "@pypi//cdk8s",
        "@pypi//pytest",
    ],
)

py_test(
    name = "test_console",
    # Synth imports the console's Settings, and with it the console runtime.
    size = "medium",
    srcs = ["test_console.py"],
    data = ["@nodejs_linux_amd64//:bin/node"],
    env = {"JSII_NODE": "$(rootpath @nodejs_linux_amd64//:bin/node)"},
    deps = [
        ":conftest",
        ":console",
        "//:conftest",
        "//haku/console:settings",
        "//util:settings_contract",
        "@pypi//more_itertools",
        "@pypi//pytest_bazel",
        "@pypi//pyyaml",
    ],
)

py_library(
    name = "flux_kustomizations",
    srcs = ["flux_kustomizations.py"],
    visibility = ["//cluster/cdk8s:__pkg__"],
    deps = [
        "//cluster/cdk8s:artifact_generators",
        "//cluster/cdk8s:flux",
        "//cluster/cdk8s:generation",
        "//cluster/cdk8s/crd_bindings/flux:kustomization",
        "//cluster/cdk8s/crd_bindings/source_watcher:artifactgenerator",
        "@pypi//cdk8s",
    ],
)
