# gazelle:ignore

load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

py_library(
    name = "patch_qwen38_template",
    srcs = ["patch_qwen38_template.py"],
)

py_binary(
    name = "derive_qwen38_template",
    main_module = "cluster.cdk8s.ollama.patch_qwen38_template",
    deps = [":patch_qwen38_template"],
)

sh_binary(
    name = "stage_tabbyapi_checkpoint",
    srcs = ["stage_tabbyapi_checkpoint.sh"],
)

py_test(
    name = "test_patch_qwen38_template",
    srcs = ["test_patch_qwen38_template.py"],
    data = ["qwen38-chat-template.jinja"],
    deps = [
        ":patch_qwen38_template",
        "//:conftest",
        "@pypi//jinja2",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@rules_python//python/runfiles",
    ],
)

py_library(
    name = "app",
    srcs = ["app.py"],
    data = [
        "link-ssd-models.sh",
        "nginx.conf",
        "nginx-auth-proxy.conf.template",
        "qwen38-ssd-derived-shards.tsv",
        "qwen38-ssd-shards.tsv",
        "setup-gpt-oss-v2.sh.j2",
    ],
    # Clients in other packages read SERVICE.
    visibility = ["//cluster/cdk8s:__subpackages__"],
    deps = [
        ":tabby",
        ":tabby_endpoint",
        "//cluster/cdk8s:container_resources",
        "//cluster/cdk8s:flux",
        "//cluster/cdk8s:gateway",
        "//cluster/cdk8s:manifest_roots",
        "//cluster/cdk8s:namespaces",
        "//cluster/cdk8s:piraeus_storage",
        "//cluster/cdk8s:reflector",
        "//cluster/cdk8s:secret_ref",
        "//cluster/cdk8s:service_ref",
        "//cluster/cdk8s:volume_claim",
        "//cluster/cdk8s/external_secrets:minted_secret",
        "//cluster/cdk8s/providers/external_secrets:externalsecret",
        "//cluster/cdk8s/providers/flux:kustomization",
        "//model_catalog:ollama",
        "@pypi//cdk8s",
        "@pypi//cdk8s_plus_34",
        "@pypi//constructs",
        "@pypi//jinja2",
        "@rules_python//python/runfiles",
    ],
)

py_library(
    name = "tabby",
    srcs = ["tabby.py"],
    data = [
        "tabbyapi-chat-template.jinja",
        "tabbyapi-config.yml",
    ],
    visibility = ["//cluster/cdk8s:__subpackages__"],
    deps = [
        ":tabby_endpoint",
        "//cluster/cdk8s:cilium",
        "//cluster/cdk8s:container_resources",
        "//cluster/cdk8s:service_ref",
        "//cluster/cdk8s/monitoring:alloy_endpoints",
        "//cluster/cdk8s/providers/prometheus_operator:podmonitor",
        "//model_catalog:catalog",
        "@pypi//cdk8s",
        "@pypi//cdk8s_plus_34",
        "@pypi//constructs",
        "@rules_python//python/runfiles",
    ],
)

py_library(
    name = "tabby_endpoint",
    srcs = ["tabby_endpoint.py"],
    visibility = ["//cluster/cdk8s/litellm:__pkg__"],
)
