# gazelle:ignore

load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

py_library(
    name = "patch_qwen38_template",
    srcs = ["patch_qwen38_template.py"],
)

py_binary(
    name = "derive_qwen38_template",
    srcs = ["derive_qwen38_template_cli.py"],
    main = "derive_qwen38_template_cli.py",
    deps = [":patch_qwen38_template"],
)

py_test(
    name = "test_patch_qwen38_template",
    srcs = ["test_patch_qwen38_template.py"],
    data = ["//cluster/k8s:qwen38_chat_template"],
    deps = [
        ":patch_qwen38_template",
        "//:conftest",
        "//util/bazel:runfiles",
        "@pypi//jinja2",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "flux_kustomizations",
    srcs = ["flux_kustomizations.py"],
    visibility = ["//cluster/cdk8s:__pkg__"],
    deps = [
        "//cluster/cdk8s:flux",
        "//cluster/cdk8s:generation",
        "//cluster/cdk8s/providers/flux:kustomization",
        "//cluster/cdk8s/providers/source_watcher:artifactgenerator",
        "@pypi//cdk8s",
    ],
)

py_library(
    name = "app",
    srcs = ["app.py"],
    # Clients in other packages read SERVICE.
    visibility = ["//cluster/cdk8s:__subpackages__"],
    deps = [
        "//cluster/cdk8s:gateway",
        "//cluster/cdk8s:generation",
        "//cluster/cdk8s:manifest_roots",
        "//cluster/cdk8s:namespaces",
        "//cluster/cdk8s:secret_ref",
        "//cluster/cdk8s:service_ref",
        "//cluster/cdk8s/external_secrets:minted_secret",
        "//cluster/cdk8s/providers/external_secrets:externalsecret",
        "@pypi//cdk8s",
        "@pypi//cdk8s_plus_34",
        "@pypi//constructs",
    ],
)
