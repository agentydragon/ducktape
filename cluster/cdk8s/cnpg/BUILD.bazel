# gazelle:ignore

load("//devinfra/python:defs.bzl", "py_library", "py_test")

py_library(
    name = "cluster",
    srcs = ["cluster.py"],
    visibility = ["//cluster/cdk8s:deployment_consumers"],
    deps = [
        "//cluster/cdk8s:node_scheduling",
        "//cluster/cdk8s:piraeus_storage",
        "//cluster/cdk8s:secret_ref",
        "//cluster/cdk8s:service_ref",
        "//cluster/cdk8s/providers/cnpg:cluster",
        "//cluster/cdk8s/providers/cnpg:database",
        "@pypi//cdk8s",
        "@pypi//constructs",
    ],
)

py_test(
    name = "test_cluster",
    srcs = ["test_cluster.py"],
    data = ["@nodejs_linux_amd64//:bin/node"],
    env = {"JSII_NODE": "$(rootpath @nodejs_linux_amd64//:bin/node)"},
    deps = [
        ":cluster",
        "//:conftest",
        "//cluster/cdk8s:conftest",
        "//cluster/cdk8s/providers/cnpg:database",
        "@pypi//cdk8s",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "backup",
    srcs = ["backup.py"],
    visibility = ["//cluster/cdk8s:__subpackages__"],
    deps = [
        ":cluster",
        "//cluster/cdk8s/providers/cnpg:objectstore",
        "//cluster/cdk8s/providers/cnpg:scheduledbackup",
        "//cluster/cdk8s/seaweedfs:s3",
        "@pypi//cdk8s",
        "@pypi//constructs",
    ],
)

py_library(
    name = "operator",
    srcs = ["operator.py"],
    visibility = ["//cluster/cdk8s:__pkg__"],
    deps = [
        "//cluster/cdk8s:helm",
        "//cluster/cdk8s:manifest_roots",
        "//cluster/cdk8s:namespaces",
        "//cluster/cdk8s:node_scheduling",
        "//cluster/cdk8s/providers/flux:helmrelease",
        "//cluster/cdk8s/providers/prometheus_operator:pod_monitor",
        "//cluster/cdk8s/providers/prometheus_operator:podmonitor",
        "@pypi//cdk8s",
    ],
)
