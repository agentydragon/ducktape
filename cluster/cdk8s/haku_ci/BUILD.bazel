# gazelle:ignore

load("//devinfra/python:defs.bzl", "py_library", "py_test")

py_library(
    name = "egress_gateway",
    srcs = ["egress_gateway.py"],
    visibility = ["//cluster/cdk8s/agentplane:__pkg__"],
    deps = [
        "//agentplane/egress:sidecar_config",
        "//cluster/cdk8s:config_format",
        "//cluster/cdk8s:node_scheduling",
        "//cluster/cdk8s:service_ref",
        "//cluster/cdk8s:settings_file",
        "//cluster/cdk8s/agentplane:egress",
        "//cluster/cdk8s/agentplane:environment",
        "//cluster/cdk8s/cert_manager:cluster_ca",
        "//cluster/cdk8s/forgejo_registry:pull_credentials",
        "//cluster/cdk8s/providers/agentplane:workload_credential",
        "//cluster/cdk8s/providers/cilium:network_policy",
        "@pypi//cdk8s",
        "@pypi//cdk8s_plus_34",
        "@pypi//constructs",
    ],
)

py_library(
    name = "runner",
    srcs = ["runner.py"],
    visibility = [
        "//cluster/cdk8s:__pkg__",
        "//cluster/cdk8s/agentplane:__pkg__",
    ],
    deps = [
        ":runner_config",
        "//cluster/cdk8s:cilium",
        "//cluster/cdk8s:flux",
        "//cluster/cdk8s:manifest_roots",
        "//cluster/cdk8s:namespaces",
        "//cluster/cdk8s:service_ref",
        "//cluster/cdk8s/forgejo:secret_copy",
        "//cluster/cdk8s/providers/keda:scaledjob",
        "//cluster/cdk8s/providers/keda:triggerauthentication",
        "@pypi//cdk8s",
        "@pypi//cdk8s_plus_34",
    ],
)

py_library(
    name = "runner_config",
    srcs = ["runner_config.py"],
    deps = [
        "@pypi//pydantic",
        "@pypi//pyyaml",
    ],
)

py_test(
    name = "test_runner",
    srcs = ["test_runner.py"],
    data = ["@nodejs_linux_amd64//:bin/node"],
    env = {"JSII_NODE": "$(rootpath @nodejs_linux_amd64//:bin/node)"},
    deps = [
        ":runner",
        "//cluster/cdk8s:conftest",
        "@pypi//cdk8s",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_secret_contract",
    srcs = ["test_secret_contract.py"],
    data = [
        "//cluster/k8s:haku/forgejo-tea/haku-forgejo-tea.sops.yaml",
        "@nodejs_linux_amd64//:bin/node",
    ],
    env = {"JSII_NODE": "$(rootpath @nodejs_linux_amd64//:bin/node)"},
    deps = [
        ":runner",
        "@pypi//pytest_bazel",
        "@pypi//pyyaml",
        "@rules_python//python/runfiles",
    ],
