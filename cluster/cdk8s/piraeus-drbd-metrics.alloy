// This runs in a narrowly scheduled host-network Piraeus monitoring Pod, where
// loopback is shared with DRBD Reactor. Reactor listens only on 9942 and Alloy's
// admin listener stays on loopback. Only remote-write traffic leaves the Pod.
prometheus.remote_write "mimir" {
  endpoint {
    url = sys.env("MIMIR_PUSH_URL")
  }

  wal {
    max_keepalive_time = "720h"
  }
}

prometheus.scrape "drbd_reactor" {
  targets = [{
    "__address__" = "127.0.0.1:9942",
    "instance"    = sys.env("NODE_NAME"),
    "node"        = sys.env("NODE_NAME"),
  }]

  job_name        = "piraeus-datastore/linstor-satellite"
  metrics_path    = "/metrics"
  scrape_interval = "60s"
  scrape_timeout  = "10s"
  forward_to      = [prometheus.remote_write.mimir.receiver]
}
