load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//cluster/cdk8s:__subpackages__"])

py_library(
    name = "app",
    srcs = ["app.py"],
    visibility = ["//cluster/cdk8s:__subpackages__"],
    deps = [
        ":config",
        ":egress",
        ":egress_proxy_url",
        "//agentplane/action_service/policies:resources",
        "//agentplane/egress:resources",
        "//cluster/cdk8s:agent_access_profiles",
        "//cluster/cdk8s:config_format",
        "//cluster/cdk8s:generation",
        "//cluster/cdk8s:manifest_roots",
        "//cluster/cdk8s:namespaces",
        "//cluster/cdk8s:secret_ref",
        "//cluster/cdk8s:service_ref",
        "//cluster/cdk8s/clickhouse:client",
        "//cluster/cdk8s/external_secrets:minted_secret",
        "//cluster/cdk8s/forgejo_registry:pull_credentials",
        "//cluster/cdk8s/providers/external_secrets:externalsecret",
        "@pypi//cdk8s",
        "@pypi//cdk8s_plus_34",
        "@pypi//constructs",
    ],
)

py_library(
    name = "backup",
    srcs = ["backup.py"],
    deps = [
        "//cluster/cdk8s:flux",
        "//cluster/cdk8s:manifest_roots",
        "//cluster/cdk8s:restic_backup",
        "//cluster/cdk8s/providers/flux:kustomization",
        "//cluster/cdk8s/seaweedfs:s3",
        "@pypi//cdk8s",
    ],
)

py_library(
    name = "egress",
    srcs = ["egress.py"],
    visibility = ["//cluster/cdk8s:__subpackages__"],
    deps = [
        "//agentplane/crds:egresscredential",
        "//agentplane/crds:policybinding",
        "//agentplane/crds:policyset",
        "//agentplane/egress:sidecar_config",
        "//agentplane/workload_auth:audience",
        "//cluster/cdk8s:cilium",
        "//cluster/cdk8s:config_format",
        "//cluster/cdk8s:settings_file",
        "//cluster/cdk8s/agentplane:actions",
        "//cluster/cdk8s/agentplane:egress",
        "//cluster/cdk8s/agentplane:egress_credentials",
        "//cluster/cdk8s/agentplane:egress_policies",
        "//cluster/cdk8s/clickhouse:client",
        "//cluster/cdk8s/external_secrets:single_secret_store",
        "//cluster/cdk8s/providers/agentplane:egress_credential",
        "//cluster/cdk8s/providers/agentplane:policy_binding",
        "//cluster/cdk8s/providers/agentplane:policy_set",
        "//cluster/cdk8s/providers/cilium:network_policy",
        "//util:settings_contract",
        "@pypi//cdk8s",
        "@pypi//cdk8s_plus_34",
        "@pypi//constructs",
    ],
)

py_test(
    name = "test_app",
    # Synth imports the console's Settings, and with it the console runtime.
    size = "medium",
    srcs = ["test_app.py"],
    data = ["@nodejs_linux_amd64//:bin/node"],
    env = {"JSII_NODE": "$(rootpath @nodejs_linux_amd64//:bin/node)"},
    deps = [
        ":app",
        ":egress",
        "//:conftest",
        "//cluster/cdk8s:agent_rbac_base",
        "//cluster/cdk8s:agent_shared_rbac",
        "//cluster/cdk8s/clickhouse:client",
        "//cluster/cdk8s/clickhouse:installation",
        "//cluster/cdk8s/haku:charts",
        "@pypi//cdk8s",
        "@pypi//more_itertools",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "config",
    srcs = ["config.py"],
    deps = [
        ":egress_proxy_url",
        "//cluster/cdk8s:openclaw_gateway",
        "//model_catalog:catalog",
    ],
)

py_library(
    name = "egress_proxy_url",
    srcs = ["egress_proxy_url.py"],
)
