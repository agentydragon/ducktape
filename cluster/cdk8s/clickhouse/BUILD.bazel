# gazelle:ignore

load("//devinfra/python:defs.bzl", "py_library")

package(default_visibility = ["//cluster/cdk8s:__pkg__"])

py_library(
    name = "client",
    srcs = ["client.py"],
    visibility = [
        "//cluster/cdk8s:__pkg__",
        "//cluster/cdk8s/clickhouse:__pkg__",
        "//cluster/cdk8s/grafana:__pkg__",
        "//cluster/cdk8s/langfuse:__pkg__",
        "//cluster/validation:__pkg__",
    ],
    deps = [
        "//cluster/cdk8s:secret_ref",
        "//cluster/cdk8s:service_ref",
        "@pypi//cdk8s",
        "@pypi//cdk8s_plus_34",
        "@pypi//constructs",
    ],
)

py_library(
    name = "schema",
    srcs = ["schema.py"],
    data = ["schema.sql"],
    visibility = [
        "//cluster/cdk8s:__pkg__",
        "//cluster/validation:__pkg__",
    ],
    deps = [
        ":client",
        "//cluster/cdk8s:fleet_rules",
        "//cluster/cdk8s:flux",
        "//cluster/cdk8s:generation",
        "//cluster/cdk8s:manifest_roots",
        "//cluster/cdk8s:pod_policy",
        "//cluster/cdk8s/providers/flux:kustomization",
        "@pypi//cdk8s",
        "@pypi//cdk8s_plus_34",
    ],
)

py_library(
    name = "installation",
    srcs = ["installation.py"],
    deps = [
        ":client",
        "//cluster/cdk8s:agent_access_profiles",
        "//cluster/cdk8s:flux",
        "//cluster/cdk8s:manifest_roots",
        "//cluster/cdk8s:node_scheduling",
        "//cluster/cdk8s:public_coder_proxy",
        "//cluster/cdk8s:service_ref",
        "//cluster/cdk8s/providers/clickhouse:clickhouseinstallation",
        "//cluster/cdk8s/providers/clickhouse:clickhousekeeperinstallation",
        "//cluster/cdk8s/providers/flux:kustomization",
        "//cluster/cdk8s/providers/prometheus_operator:pod_monitor",
        "//cluster/cdk8s/providers/prometheus_operator:podmonitor",
        "@pypi//cdk8s",
        "@pypi//cdk8s_plus_34",
    ],
)

py_library(
    name = "operator",
    srcs = ["operator.py"],
    deps = [
        "//cluster/cdk8s:flux",
        "//cluster/cdk8s:helm",
        "//cluster/cdk8s:manifest_roots",
        "//cluster/cdk8s:namespaces",
        "//cluster/cdk8s/providers/flux:helmrelease",
        "//cluster/cdk8s/providers/flux:kustomization",
        "@pypi//cdk8s",
    ],
)
