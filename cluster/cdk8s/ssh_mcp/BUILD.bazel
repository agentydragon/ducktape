# gazelle:ignore

load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//cluster/cdk8s:__pkg__"])

py_library(
    name = "config",
    srcs = ["config.py"],
    data = [
        "//ssh_keys:atlas-host-ed25519.pub",
        "//ssh_keys:public-coder-agent-devbox.pub",
        "//ssh_keys:public-coder-devbox-host.pub",
        "//ssh_keys:rugged-host-ed25519.pub",
        "//ssh_keys:wyrm2-host-ed25519.pub",
    ],
    visibility = ["//cluster/cdk8s:__subpackages__"],
    deps = [
        "//cluster/cdk8s:manifest_roots",
        "//cluster/cdk8s:service_ref",
        "//util/bazel:runfiles",
        "//x/ssh_mcp_server:server",
        "@pypi//cdk8s",
        "@pypi//cdk8s_plus_34",
    ],
)

py_library(
    name = "backend",
    srcs = ["backend.py"],
    visibility = ["//cluster/cdk8s:__subpackages__"],
    deps = [
        ":config",
        "//cluster/cdk8s:cilium",
        "//cluster/cdk8s:config_format",
        "//cluster/cdk8s:forgejo_images",
        "//cluster/cdk8s:namespaces",
        "//cluster/cdk8s:pod_policy",
        "//cluster/cdk8s:probes",
        "//cluster/cdk8s:secret_ref",
        "//cluster/cdk8s/external_secrets:minted_secret",
        "//cluster/cdk8s/providers/cilium:ciliumnetworkpolicy",
        "//cluster/cdk8s/providers/cilium:network_policy",
        "//cluster/cdk8s/providers/external_secrets:externalsecret",
        "//cluster/cdk8s/public_coder:devbox",
        "//cluster/scripts:nebula_mesh",
        "@pypi//cdk8s",
        "@pypi//cdk8s_plus_34",
        "@pypi//constructs",
    ],
)

py_library(
    name = "sshpiper",
    srcs = ["sshpiper.py"],
    visibility = ["//cluster/cdk8s:__subpackages__"],
    deps = [
        ":config",
        "//third_party/sshpiper:pipe",
        "@pypi//cdk8s",
        "@pypi//constructs",
    ],
)

py_library(
    name = "generation",
    srcs = ["generation.py"],
    deps = [
        ":backend",
        ":config",
        ":sshpiper",
        "//cluster/cdk8s:fleet_rules",
        "//cluster/cdk8s:flux",
        "//cluster/cdk8s:manifest_roots",
        "//cluster/cdk8s/providers/flux:kustomization",
        "//cluster/scripts:nebula_mesh",
        "//util/bazel:runfiles",
        "@pypi//cdk8s",
    ],
)

py_test(
    name = "test_consumers",
    # Syntheses import the agentplane Services' Settings and need jsii's Node runtime.
    size = "medium",
    srcs = ["test_consumers.py"],
    data = [
        "//:nebula-mesh.json",
        "@nodejs_linux_amd64//:bin/node",
    ],
    env = {"JSII_NODE": "$(rootpath @nodejs_linux_amd64//:bin/node)"},
    deps = [
        ":backend",
        ":config",
        ":sshpiper",
        "//:conftest",
        "//cluster/cdk8s/agentplane:conftest",
        "//cluster/cdk8s/public_coder:devbox",
        "//cluster/scripts:nebula_mesh",
        "//util/bazel:runfiles",
        "@pypi//cdk8s",
        "@pypi//more_itertools",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//pyyaml",
    ],
)
