# gazelle:ignore

load("//devinfra/python:defs.bzl", "py_library", "py_test")

py_library(
    name = "app",
    srcs = ["app.py"],
    visibility = ["//cluster/cdk8s:__pkg__"],
    deps = [
        "//cluster/cdk8s:flux",
        "//cluster/cdk8s:helm",
        "//cluster/cdk8s:manifest_roots",
        "//cluster/cdk8s:namespaces",
        "//cluster/cdk8s:node_scheduling",
        "@pypi//cdk8s",
    ],
)

py_library(
    name = "janitor",
    srcs = ["janitor.py"],
    visibility = ["//cluster/cdk8s:__subpackages__"],
    deps = [
        "//cluster/cdk8s/providers/kyverno:cleanup_policy",
        "//cluster/cdk8s/providers/kyverno:cleanuppolicy",
        "@pypi//cdk8s",
        "@pypi//constructs",
    ],
)

py_library(
    name = "policies",
    srcs = ["policies.py"],
    visibility = ["//cluster/cdk8s:__pkg__"],
    deps = [
        ":proxy_injection",
        "//cluster/cdk8s:flux",
        "//cluster/cdk8s:manifest_roots",
        "//cluster/cdk8s:namespaces",
        "//cluster/cdk8s/providers/kyverno:cluster_policy",
        "//cluster/cdk8s/providers/kyverno:clusterpolicy",
        "@pypi//cdk8s",
        "@pypi//cdk8s_plus_34",
    ],
)

py_library(
    name = "proxy_injection",
    srcs = ["proxy_injection.py"],
    visibility = ["//cluster/cdk8s/kyverno:__pkg__"],
    deps = [
        "//cluster/cdk8s/providers/kyverno:cluster_policy",
        "//cluster/cdk8s/providers/kyverno:clusterpolicy",
        "@pypi//cdk8s",
    ],
)

py_library(
    name = "apply",
    testonly = True,
    srcs = ["apply.py"],
    visibility = ["//cluster/cdk8s:__subpackages__"],
    deps = [
        "//util/bazel:runfiles",
        "@pypi//pyyaml",
    ],
)

py_library(
    name = "test_support",
    testonly = True,
    srcs = ["test_utils.py"],
    deps = [
        ":apply",
        ":policies",
        ":proxy_injection",
        "//util/bazel:runfiles",
        "@pypi//cdk8s",
        "@pypi//pyyaml",
    ],
)

py_test(
    name = "test_default_vpa_requests_only",
    srcs = ["test_default_vpa_requests_only.py"],
    data = [
        "@multitool//tools/kyverno",
        "@nodejs_linux_amd64//:bin/node",
    ] + glob(["testdata/namespace_vpa_*.yaml"]),
    env = {"JSII_NODE": "$(rootpath @nodejs_linux_amd64//:bin/node)"},
    deps = [
        ":apply",
        ":test_support",
        "//cluster/cdk8s:namespaces",
        "//cluster/cdk8s/testing:scratch",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//pyyaml",
    ],
)

