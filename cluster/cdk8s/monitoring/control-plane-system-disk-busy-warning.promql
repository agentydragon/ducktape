label_replace(
  rate(node_disk_io_time_seconds_total{device!~"^(loop|ram|fd|dm-|sr|nbd|drbd).*"}[10m]),
  "disk", "$1", "device", "^(.+)$"
)
* on (namespace, pod) group_left (node)
  max by (namespace, pod, node) (
    kube_pod_info{namespace="monitoring", pod=~"prometheus-node-exporter-.+"}
  )
* on (node, disk) group_left (device_path) cluster:talos_system_disk_device_info{disk!~"^(loop|ram|fd|dm-|sr|nbd|drbd).*"}
> 0.50
