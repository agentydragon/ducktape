sum by (namespace, pod, node, device_path) (
  label_replace(
    rate(
      container_fs_writes_bytes_total{
        device=~"^/dev/.+", container!="", pod!="", namespace!="kube-system"
      }[10m]
    ),
    "device_path", "$1", "device", "^(.+)$"
  )
  * on (node, device_path) group_left () cluster:talos_system_disk_device_info{disk!~"^(loop|ram|fd|dm-|sr|nbd|drbd).*"}
) > 1048576
