(
  max by (node, namespace, pod, container) (
    rate(container_pressure_io_stalled_seconds_total{container!=""}[5m])
  )
  > 0.3
)
and on (node, namespace, pod, container)
(
  max by (node, namespace, pod, container) (
    rate(container_memory_failures_total{failure_type="pgmajfault", scope="container", container!=""}[5m])
  )
  > 5
)
