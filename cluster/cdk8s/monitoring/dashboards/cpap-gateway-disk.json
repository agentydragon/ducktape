{
  "__inputs": [
    {
      "name": "DS_MIMIR",
      "label": "Mimir",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": []
  },
  "description": "Guest root filesystem capacity and use for the stateless CPAP gateway VM. The current guest has no separate /boot filesystem mount, so boot-partition usage is not exposed here. This does not measure OptiPlex host storage or Kubernetes pod storage.",
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": "${DS_MIMIR}",
      "description": "Guest root filesystem. Used bytes are size minus free; root-reserved blocks are included in free. Capacity is the filesystem visible inside the VM, separate from KubeVirt and host storage. Only the CPAP gateway guest filesystem collector is scraped by monitoring Alloy.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_MIMIR}"
          },
          "expr": "max by (mountpoint) (node_filesystem_size_bytes{namespace=\"cpap-sync\",service=\"cpap-gateway-metrics\",endpoint=\"node-metrics\",mountpoint=\"/\"})",
          "legendFormat": "Capacity",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_MIMIR}"
          },
          "expr": "max by (mountpoint) (node_filesystem_size_bytes{namespace=\"cpap-sync\",service=\"cpap-gateway-metrics\",endpoint=\"node-metrics\",mountpoint=\"/\"}) - max by (mountpoint) (node_filesystem_free_bytes{namespace=\"cpap-sync\",service=\"cpap-gateway-metrics\",endpoint=\"node-metrics\",mountpoint=\"/\"})",
          "legendFormat": "Used",
          "refId": "B"
        }
      ],
      "title": "Guest root filesystem: used and capacity",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_MIMIR}",
      "description": "Guest root filesystem. Used bytes are size minus free; root-reserved blocks are included in free. Capacity is the filesystem visible inside the VM, separate from KubeVirt and host storage. Only the CPAP gateway guest filesystem collector is scraped by monitoring Alloy.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 20,
            "showPoints": "never"
          },
          "min": 0,
          "max": 100,
          "decimals": 1
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_MIMIR}"
          },
          "expr": "100 * (1 - max by (mountpoint) (node_filesystem_free_bytes{namespace=\"cpap-sync\",service=\"cpap-gateway-metrics\",endpoint=\"node-metrics\",mountpoint=\"/\"}) / max by (mountpoint) (node_filesystem_size_bytes{namespace=\"cpap-sync\",service=\"cpap-gateway-metrics\",endpoint=\"node-metrics\",mountpoint=\"/\"}))",
          "legendFormat": "Used",
          "refId": "A"
        }
      ],
      "title": "Guest root filesystem: used percent",
      "type": "timeseries"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["cpap", "kubevirt", "storage"],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "CPAP gateway disk",
  "uid": "cpap-gateway-disk",
  "version": 1
}
