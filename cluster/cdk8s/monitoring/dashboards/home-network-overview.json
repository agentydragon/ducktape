    {
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "Times the gateway's uptime went back to zero in the last 7 days.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "id": 6,
      "title": "Gateway reboots (7d)",
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "resets(att_gateway_uptime_seconds[7d])",
          "legendFormat": "",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "Largest delay between the newest sample a home Alloy has collected and the newest it has delivered to Mimir. Grows while home is cut off, drains after it reconnects.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "id": 7,
      "title": "Home metrics backlog",
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "max(max by (node) (clamp_min(max by (pod) (prometheus_remote_storage_highest_timestamp_in_seconds{job=\"alloy-node\"}) - max by (pod) (prometheus_remote_storage_queue_highest_sent_timestamp_seconds{job=\"alloy-node\"}), 0) * on (pod) group_left (node) max by (pod, node) (kube_pod_info{namespace=\"monitoring\",created_by_name=\"alloy-node\",node=~\"wyrm2|optiplex\"})))",
          "legendFormat": "",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 300
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 8,
      "panels": [],
      "title": "Connectivity",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "Each row is one link or node over time. A blank stretch means Mimir has no samples for it: home was unreachable and the data was not (or not yet) replayed from a home buffer. The OVH-side Ready rows go Down during an outage; the rows scraped at home show what home itself saw once their buffer is replayed.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "id": 9,
      "title": "Home connectivity timeline",
      "type": "state-timeline",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "att_gateway_wan_up",
          "legendFormat": "Gateway WAN",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "att_gateway_optical_up",
          "legendFormat": "Gateway fiber",
          "refId": "B",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "min(att_gateway_scrape_success)",
          "legendFormat": "Gateway status pages readable",
          "refId": "C",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "max by (node) (kube_node_status_condition{condition=\"Ready\",status=\"true\",node=~\"wyrm2|optiplex\"})",
          "legendFormat": "{{node}} Ready (seen from OVH)",
          "refId": "D",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "up{job=\"kubelet\",metrics_path=\"/metrics\",node=~\"wyrm2|optiplex\"}",
          "legendFormat": "{{node}} kubelet scraped",
          "refId": "E",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red"
                },
                "1": {
                  "text": "Up",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "alignValue": "left",
        "rowHeight": 0.8,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "Traffic through the gateway's WAN port.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "id": 10,
      "title": "Internet throughput (gateway WAN)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "rate(att_gateway_wan_receive_bytes_total[5m]) * 8",
          "legendFormat": "download",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "rate(att_gateway_wan_transmit_bytes_total[5m]) * 8",
          "legendFormat": "upload",
          "refId": "B",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false,
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "Traffic on each home node's Nebula interface, which carries all of its cluster traffic to OVH, including metrics remote-write.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "id": 11,
      "title": "Home to OVH tunnel (Nebula)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "rate(node_network_receive_bytes_total{job=\"node-exporter\",device=~\"nebula.*\"}[5m]) * 8 * on (instance) group_left (nodename) max by (instance, nodename) (node_uname_info{job=\"node-exporter\",nodename=~\"wyrm2|optiplex\"})",
          "legendFormat": "{{nodename}} in",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "rate(node_network_transmit_bytes_total{job=\"node-exporter\",device=~\"nebula.*\"}[5m]) * 8 * on (instance) group_left (nodename) max by (instance, nodename) (node_uname_info{job=\"node-exporter\",nodename=~\"wyrm2|optiplex\"})",
          "legendFormat": "{{nodename}} out",
          "refId": "B",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false,
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
