load("@io_bazel_rules_go//go:def.bzl", "go_test")

_TOPOLOGY_DATA = [
    "//cluster/kubespand/qemu_tests:vmlinuz",
    "//cluster/kubespand/qemu_tests/talos:talos_nocloud_image",
    "//cluster/kubespand/qemu_tests/vms/discovery:initramfs",
    "//cluster/kubespand/qemu_tests/vms/kubespan:initramfs",
]

_TOPOLOGY_TAGS = [
    "cpu:4",
    "requires_qemu",
]

# QEMU tests run multiple VMs under TCG (no KVM) — need more CPU than the
# platform default (3 compute units).
_QEMU_EXEC_PROPERTIES = {"EstimatedComputeUnits": "8"}

_TOPOLOGY_DEPS = [
    "//cluster/kubespand/qemu_tests",
    "@com_github_siderolabs_talos_pkg_machinery//config/types/v1alpha1",
]

# Parameterized topology tests: flat × {kubespand,talos}, cross_subnet × {kubespand,talos}.
go_test(
    name = "topology_test",
    timeout = "long",
    srcs = [
        "flat_test.go",
        "topology_test_helper.go",
    ],
    data = _TOPOLOGY_DATA,
    exec_properties = _QEMU_EXEC_PROPERTIES,
    tags = _TOPOLOGY_TAGS,
    deps = _TOPOLOGY_DEPS,
)

# Trustd CSR flow test: parameterized by worker type.
go_test(
    name = "trustd_test",
    timeout = "long",
    srcs = ["trustd_test.go"],
    data = [
        "//cluster/kubespand/qemu_tests:vmlinuz",
        "//cluster/kubespand/qemu_tests/talos:talos_nocloud_image",
        "//cluster/kubespand/qemu_tests/vms/discovery:initramfs",
        "//cluster/kubespand/qemu_tests/vms/trustd:initramfs",
    ],
    exec_properties = _QEMU_EXEC_PROPERTIES,
    tags = [
        "cpu:4",
        "requires_qemu",
    ],
    deps = [
        "//cluster/kubespand/qemu_tests",
    ],
)
