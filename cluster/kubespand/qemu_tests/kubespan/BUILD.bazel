load("@io_bazel_rules_go//go:def.bzl", "go_test")

_TOPOLOGY_DATA = [
    "//cluster/kubespand/qemu_tests:vmlinuz",
    "//cluster/kubespand/qemu_tests/talos:talos_nocloud_image",
    "//cluster/kubespand/qemu_tests/talos:testdata/cp-kubespan.yaml",
    "//cluster/kubespand/qemu_tests/talos:testdata/cp-kubespan-cross.yaml",
    "//cluster/kubespand/qemu_tests/talos:testdata/talosconfig.yaml",
    "//cluster/kubespand/qemu_tests/vms/discovery:initramfs",
    "//cluster/kubespand/qemu_tests/vms/kubespan:initramfs",
]

_TOPOLOGY_TAGS = [
    "cpu:4",
    "requires_qemu",
]

# Each topology test gets its own RBE worker (4 VMs each: discovery + CP + VM-A + VM-B).
go_test(
    name = "flat_test",
    timeout = "long",
    srcs = [
        "flat_test.go",
        "topology_test_helper.go",
    ],
    data = _TOPOLOGY_DATA,
    tags = _TOPOLOGY_TAGS,
    deps = [
        "//cluster/kubespand/qemu_tests",
    ],
)

go_test(
    name = "cross_subnet_test",
    timeout = "long",
    srcs = [
        "cross_subnet_test.go",
        "topology_test_helper.go",
    ],
    data = _TOPOLOGY_DATA,
    tags = _TOPOLOGY_TAGS,
    deps = [
        "//cluster/kubespand/qemu_tests",
    ],
)

# Trustd CSR flow test: boots 3 VMs (discovery + Talos CP + kubespand).
go_test(
    name = "trustd_test",
    timeout = "long",
    srcs = ["trustd_test.go"],
    data = [
        "//cluster/kubespand/qemu_tests:vmlinuz",
        "//cluster/kubespand/qemu_tests/talos:talos_nocloud_image",
        "//cluster/kubespand/qemu_tests/talos:testdata/talosconfig.yaml",
        "//cluster/kubespand/qemu_tests/talos:testdata/vps-controlplane.yaml",
        "//cluster/kubespand/qemu_tests/vms/discovery:initramfs",
        "//cluster/kubespand/qemu_tests/vms/trustd:initramfs",
    ],
    tags = [
        "cpu:4",
        "requires_qemu",
    ],
    deps = [
        "//cluster/kubespand/qemu_tests",
    ],
)
