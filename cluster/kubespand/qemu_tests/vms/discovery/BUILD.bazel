load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")
load("//cluster/kubespand/qemu_tests:initramfs.bzl", "initramfs")

go_library(
    name = "discovery_lib",
    testonly = True,
    srcs = ["main.go"],
    importpath = "github.com/agentydragon/ducktape/cluster/kubespand/qemu_tests/vms/discovery",
    visibility = ["//visibility:private"],
    deps = [
        "//cluster/kubespand/qemu_tests/vms/initlib",
    ],
)

go_binary(
    name = "discovery",
    testonly = True,
    embed = [":discovery_lib"],
    goarch = "amd64",
    goos = "linux",
    static = "on",
    visibility = ["//cluster/kubespand:__subpackages__"],
)

initramfs(
    name = "initramfs",
    testonly = True,
    extra_binaries = {
        "@discovery_service_binary//file": "/discovery-service",
    },
    init = ":discovery",
    visibility = ["//cluster/kubespand:__subpackages__"],
)
