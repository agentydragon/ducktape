load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "trustd_lib",
    testonly = True,
    srcs = ["main.go"],
    importpath = "github.com/agentydragon/ducktape/cluster/kubespand/qemu_tests/vms/trustd",
    deps = [
        "//cluster/kubespand/qemu_tests",
        "//cluster/kubespand/qemu_tests/vms/initlib",
        "//cluster/kubespand/qemu_tests/vms/kubespanlib",
        "@com_github_cosi_project_runtime//pkg/resource",
        "@com_github_cosi_project_runtime//pkg/safe",
        "@com_github_cosi_project_runtime//pkg/state",
        "@com_github_siderolabs_talos_pkg_machinery//resources/kubespan",
        "@com_github_siderolabs_talos_pkg_machinery//resources/secrets",
    ],
)

go_binary(
    name = "trustd",
    testonly = True,
    embed = [":trustd_lib"],
    goarch = "amd64",
    goos = "linux",
    static = "on",
    visibility = ["//cluster/kubespand:__subpackages__"],
)

genrule(
    name = "initramfs",
    testonly = True,
    srcs = [
        "@alpine_minirootfs_x86_64//file",
        "//cluster/kubespand",
        "//cluster/kubespand/cmd/apid",
        ":trustd",
        "//cluster/kubespand/qemu_tests:modules_tree",
    ],
    outs = ["initramfs.cpio.gz"],
    cmd = """
        set -e
        D=$$(mktemp -d)
        tar -xzf $(location @alpine_minirootfs_x86_64//file) -C $$D
        mkdir -p $$D/var/lib/kubespan $$D/etc/kubespan $$D/system/run/machined
        cp $(location :trustd) $$D/init && chmod +x $$D/init
        cp $(location //cluster/kubespand:kubespand) $$D/kubespand && chmod +x $$D/kubespand
        cp $(location //cluster/kubespand/cmd/apid) $$D/apid && chmod +x $$D/apid
        tar -xf $(location //cluster/kubespand/qemu_tests:modules_tree) -C $$D
        (cd $$D && find . -print0 | cpio --null -o -H newc 2>/dev/null) | gzip -9 > $@
        rm -rf $$D
    """,
    visibility = ["//cluster/kubespand:__subpackages__"],
)
