load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")
load("//cluster/kubespand/qemu_tests:initramfs.bzl", "initramfs")

go_library(
    name = "trustd_lib",
    testonly = True,
    srcs = ["main.go"],
    importpath = "github.com/agentydragon/ducktape/cluster/kubespand/qemu_tests/vms/trustd",
    deps = [
        "//cluster/kubespand/qemu_tests/vms/initlib",
        "//cluster/kubespand/qemu_tests/vms/kubespanlib",
        "@com_github_cosi_project_runtime//api/v1alpha1",
        "@com_github_cosi_project_runtime//pkg/resource",
        "@com_github_cosi_project_runtime//pkg/safe",
        "@com_github_cosi_project_runtime//pkg/state",
        "@com_github_cosi_project_runtime//pkg/state/protobuf/client",
        "@com_github_siderolabs_talos_pkg_machinery//resources/kubespan",
        "@com_github_siderolabs_talos_pkg_machinery//resources/secrets",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//credentials/insecure",
    ],
)

go_binary(
    name = "trustd",
    testonly = True,
    embed = [":trustd_lib"],
    goarch = "amd64",
    goos = "linux",
    static = "on",
    visibility = ["//cluster/kubespand:__subpackages__"],
)

initramfs(
    name = "initramfs",
    testonly = True,
    extra_binaries = {
        "//cluster/kubespand": "/kubespand",
        "//cluster/kubespand/cmd/apid": "/apid",
    },
    extra_dirs = [
        "/var/lib/kubespan",
        "/etc/kubespan",
        "/system/run/machined",
    ],
    init = ":trustd",
    visibility = ["//cluster/kubespand:__subpackages__"],
)
