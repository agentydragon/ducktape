load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")
load("//cluster/kubespand/qemu_tests:initramfs.bzl", "initramfs")

go_library(
    name = "router_lib",
    testonly = True,
    srcs = ["main.go"],
    importpath = "github.com/agentydragon/ducktape/cluster/kubespand/qemu_tests/vms/router",
    visibility = ["//visibility:private"],
    deps = [
        "//cluster/kubespand/qemu_tests/vms/initlib",
        "@com_github_google_nftables//:nftables",
        "@com_github_google_nftables//expr",
    ],
)

go_binary(
    name = "router",
    testonly = True,
    embed = [":router_lib"],
    goarch = "amd64",
    goos = "linux",
    static = "on",
    visibility = ["//cluster/kubespand:__subpackages__"],
)

initramfs(
    name = "initramfs",
    testonly = True,
    init = ":router",
    visibility = ["//cluster/kubespand:__subpackages__"],
)
