load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")
load("//cluster/kubespand/qemu_tests:initramfs.bzl", "initramfs")

go_library(
    name = "kubespan_lib",
    testonly = True,
    srcs = ["main.go"],
    importpath = "github.com/agentydragon/ducktape/cluster/kubespand/qemu_tests/vms/kubespan",
    deps = [
        "//cluster/kubespand/qemu_tests/vms/initlib",
        "//cluster/kubespand/qemu_tests/vms/kubespanlib",
    ],
)

go_binary(
    name = "kubespan",
    testonly = True,
    embed = [":kubespan_lib"],
    goarch = "amd64",
    goos = "linux",
    static = "on",
    visibility = ["//cluster/kubespand:__subpackages__"],
)

initramfs(
    name = "initramfs",
    testonly = True,
    extra_binaries = {
        "//cluster/kubespand": "/kubespand",
        "//cluster/kubespand/cmd/apid": "/apid",
    },
    extra_dirs = [
        "/var/lib/kubespan",
        "/etc/kubespan",
        "/system/run/machined",
    ],
    init = ":kubespan",
    visibility = ["//cluster/kubespand:__subpackages__"],
)
