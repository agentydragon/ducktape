load("@io_bazel_rules_go//go:def.bzl", "go_library")

go_library(
    name = "qemu_tests",
    testonly = True,
    srcs = [
        "helpers.go",
        "talos_config_gen.go",
        "talos_helpers.go",
    ],
    importpath = "github.com/agentydragon/ducktape/cluster/kubespand/qemu_tests",
    visibility = ["//cluster/kubespand:__subpackages__"],
    deps = [
        "//cluster/kubespand/agentconfig",
        "//cluster/kubespand/qemu_tests/probepb",
        "@com_github_cosi_project_runtime//api/v1alpha1",
        "@com_github_cosi_project_runtime//pkg/controller/generic",
        "@com_github_cosi_project_runtime//pkg/safe",
        "@com_github_cosi_project_runtime//pkg/state",
        "@com_github_cosi_project_runtime//pkg/state/protobuf/client",
        "@com_github_siderolabs_crypto//x509",
        "@com_github_siderolabs_talos_pkg_machinery//client",
        "@com_github_siderolabs_talos_pkg_machinery//client/config",
        "@com_github_siderolabs_talos_pkg_machinery//config",
        "@com_github_siderolabs_talos_pkg_machinery//config/generate/secrets",
        "@com_github_siderolabs_talos_pkg_machinery//config/types/v1alpha1",
        "@com_github_siderolabs_talos_pkg_machinery//resources/cluster",
        "@com_github_siderolabs_talos_pkg_machinery//resources/kubespan",
        "@com_github_siderolabs_talos_pkg_machinery//role",
        "@in_gopkg_yaml_v3//:yaml_v3",
        "@io_bazel_rules_go//go/runfiles",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//credentials/insecure",
    ],
)

# ─ Extract vmlinuz from Alpine linux-virt .apk ──────────────────────────────
genrule(
    name = "vmlinuz",
    srcs = ["@alpine_linux_virt//file"],
    outs = ["vmlinuz-virt"],
    cmd = "tar --warning=no-unknown-keyword -xzf $< -O boot/vmlinuz-virt > $@",
    visibility = ["//cluster/kubespand:__subpackages__"],
)

# ─ Extract full kernel modules tree for modprobe ─────────────────────────────
genrule(
    name = "modules_tree",
    srcs = [
        "@alpine_linux_virt//file",
        "extract_modules.sh",
    ],
    outs = ["modules_tree.tar"],
    cmd = "$(location extract_modules.sh) $(location @alpine_linux_virt//file) $@",
    visibility = ["//cluster/kubespand:__subpackages__"],
)
