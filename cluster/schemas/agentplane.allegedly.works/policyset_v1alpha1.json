{
  "type": "object",
  "required": [
    "spec"
  ],
  "properties": {
    "spec": {
      "type": "object",
      "required": [
        "rules"
      ],
      "properties": {
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "description": "One typed rule: `type` selects the kind, and each kind admits exactly the fields its `oneOf` branch names. `kubernetes_role_binding` binds an existing Role or ClusterRole in each of `namespaces`; `kubernetes_cluster_role_binding` binds an existing ClusterRole cluster-wide.",
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "kubernetes_role_binding",
                  "kubernetes_cluster_role_binding"
                ]
              },
              "role": {
                "description": "The role to bind. A `Role` must exist in each of `namespaces`; a rule never defines rules of its own.",
                "type": "object",
                "required": [
                  "kind",
                  "name"
                ],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "Role",
                      "ClusterRole"
                    ]
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "namespaces": {
                "description": "Named explicitly, never selected, so labeling a namespace grants nothing.",
                "type": "array",
                "minItems": 1,
                "x-kubernetes-list-type": "set",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "clusterRole": {
                "description": "The ClusterRole bound cluster-wide.",
                "type": "string",
                "minLength": 1
              }
            },
            "oneOf": [
              {
                "properties": {
                  "type": {
                    "enum": [
                      "kubernetes_role_binding"
                    ]
                  }
                },
                "required": [
                  "role",
                  "namespaces"
                ],
                "not": {
                  "required": [
                    "clusterRole"
                  ]
                }
              },
              {
                "properties": {
                  "type": {
                    "enum": [
                      "kubernetes_cluster_role_binding"
                    ]
                  }
                },
                "required": [
                  "clusterRole"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "role"
                      ]
                    },
                    {
                      "required": [
                        "namespaces"
                      ]
                    }
                  ]
                }
              }
            ]
          }
        }
      }
    }
  }
}
