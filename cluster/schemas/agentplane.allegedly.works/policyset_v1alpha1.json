{
  "type": "object",
  "required": [
    "spec"
  ],
  "properties": {
    "spec": {
      "type": "object",
      "required": [
        "rules"
      ],
      "properties": {
        "rules": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "description": "One typed rule: `type` selects the kind, and each kind admits exactly the fields its `oneOf` branch names. `kubernetes_role_binding` binds an existing Role or ClusterRole in each of `namespaces`; `kubernetes_cluster_role_binding` binds an existing ClusterRole cluster-wide; `egress` lets the subject reach `hosts` through the egress proxy. A request matching any one egress rule of a subject's sets is allowed.",
            "type": "object",
            "required": [
              "type"
            ],
            "x-kubernetes-validations": [
              {
                "rule": "!has(self.hosts) || !self.hosts.exists(h, h == '*') || (!has(self.credentialRef) && (!has(self.clusterInternal) || !self.clusterInternal))",
                "message": "A blanket host rule cannot set clusterInternal or credentialRef."
              }
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "kubernetes_role_binding",
                  "kubernetes_cluster_role_binding",
                  "egress"
                ]
              },
              "role": {
                "description": "The role to bind. A `Role` must exist in each of `namespaces`; a rule never defines rules of its own.",
                "type": "object",
                "required": [
                  "kind",
                  "name"
                ],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "Role",
                      "ClusterRole"
                    ]
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "namespaces": {
                "description": "Named explicitly, never selected, so labeling a namespace grants nothing.",
                "type": "array",
                "minItems": 1,
                "x-kubernetes-list-type": "set",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "clusterRole": {
                "description": "The ClusterRole bound cluster-wide.",
                "type": "string",
                "minLength": 1
              },
              "hosts": {
                "description": "Exact lowercase hostnames, or `*.` followed by a domain to match every subdomain of it (not the domain itself), or `*` for any public destination. Blanket rules cannot set credentialRef or clusterInternal; they do not bypass authentication, bindings, method/path checks or address filtering.",
                "type": "array",
                "minItems": 1,
                "maxItems": 256,
                "items": {
                  "type": "string",
                  "maxLength": 256,
                  "pattern": "^(\\*|(\\*\\.)?[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*)$"
                }
              },
              "methods": {
                "description": "HTTP methods the rule admits; omitted means any method.",
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "enum": [
                    "GET",
                    "HEAD",
                    "POST",
                    "PUT",
                    "PATCH",
                    "DELETE",
                    "OPTIONS",
                    "CONNECT",
                    "TRACE"
                  ]
                }
              },
              "paths": {
                "description": "Path patterns the rule admits, as the proxy matches them; omitted means any path.",
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "clusterInternal": {
                "description": "Whether this rule's hosts are inside the cluster and meant to be; omitted means false. The proxy resolves every admitted host and refuses one that points at a private address, which is what stops an allowed name from reaching a Service, a Pod or a node, DNS rebinding included. Setting this lifts that refusal for this rule's hosts only, and never for loopback or link-local, which are the sandbox's own interfaces rather than the cluster.",
                "type": "boolean"
              },
              "credentialRef": {
                "description": "The EgressCredential this rule lets a subject present, in the same namespace. The credential declares where it is substituted; this rule decides where it may go. A request that presents no placeholder is admitted by the rule and forwarded untouched.",
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "oneOf": [
              {
                "properties": {
                  "type": {
                    "enum": [
                      "kubernetes_role_binding"
                    ]
                  }
                },
                "required": [
                  "role",
                  "namespaces"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "clusterRole"
                      ]
                    },
                    {
                      "required": [
                        "hosts"
                      ]
                    },
                    {
                      "required": [
                        "methods"
                      ]
                    },
                    {
                      "required": [
                        "paths"
                      ]
                    },
                    {
                      "required": [
                        "clusterInternal"
                      ]
                    },
                    {
                      "required": [
                        "credentialRef"
                      ]
                    }
                  ]
                }
              },
              {
                "properties": {
                  "type": {
                    "enum": [
                      "kubernetes_cluster_role_binding"
                    ]
                  }
                },
                "required": [
                  "clusterRole"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "role"
                      ]
                    },
                    {
                      "required": [
                        "namespaces"
                      ]
                    },
                    {
                      "required": [
                        "hosts"
                      ]
                    },
                    {
                      "required": [
                        "methods"
                      ]
                    },
                    {
                      "required": [
                        "paths"
                      ]
                    },
                    {
                      "required": [
                        "clusterInternal"
                      ]
                    },
                    {
                      "required": [
                        "credentialRef"
                      ]
                    }
                  ]
                }
              },
              {
                "properties": {
                  "type": {
                    "enum": [
                      "egress"
                    ]
                  }
                },
                "required": [
                  "hosts"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "role"
                      ]
                    },
                    {
                      "required": [
                        "namespaces"
                      ]
                    },
                    {
                      "required": [
                        "clusterRole"
                      ]
                    }
                  ]
                }
              }
            ]
          }
        }
      }
    }
  }
}
