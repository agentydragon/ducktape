{
  "type": "object",
  "required": ["spec"],
  "properties": {
    "spec": {
      "type": "object",
      "required": ["subjects", "policies"],
      "properties": {
        "subjects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "description": "Exactly one of sandbox or sandboxSelector.",
            "type": "object",
            "oneOf": [
              {
                "required": ["sandbox"]
              },
              {
                "required": ["sandboxSelector"]
              }
            ],
            "properties": {
              "sandbox": {
                "description": "One Sandbox in the binding's namespace, by name.",
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "sandboxSelector": {
                "description": "Every Sandbox in the binding's namespace carrying all of these labels.",
                "type": "object",
                "required": ["matchLabels"],
                "properties": {
                  "matchLabels": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "policies": {
          "description": "EgressPolicy names in the binding's namespace.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expiresAt": {
          "description": "After this instant the binding contributes nothing.",
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "status": {
      "type": "object",
      "properties": {
        "observedGeneration": {
          "type": "integer",
          "format": "int64"
        },
        "conditions": {
          "type": "array",
          "x-kubernetes-list-type": "map",
          "x-kubernetes-list-map-keys": ["type"],
          "items": {
            "description": "A metav1.Condition; the proxy sets Active.",
            "type": "object",
            "required": ["type", "status", "lastTransitionTime", "reason", "message"],
            "properties": {
              "type": {
                "type": "string",
                "maxLength": 316,
                "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*/)?(([A-Za-z0-9][-A-Za-z0-9_.]*)?[A-Za-z0-9])$"
              },
              "status": {
                "type": "string",
                "enum": ["True", "False", "Unknown"]
              },
              "observedGeneration": {
                "type": "integer",
                "format": "int64",
                "minimum": 0
              },
              "lastTransitionTime": {
                "type": "string",
                "format": "date-time"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^[A-Za-z]([A-Za-z0-9_,:]*[A-Za-z0-9_])?$"
              },
              "message": {
                "type": "string",
                "maxLength": 32768
              }
            }
          }
        },
        "resolvedPolicies": {
          "description": "How many of spec.policies name an existing EgressPolicy.",
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
