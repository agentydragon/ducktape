{
  "type": "object",
  "required": ["spec"],
  "properties": {
    "spec": {
      "type": "object",
      "required": ["subjects", "policies"],
      "properties": {
        "subjects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["sandbox"],
            "properties": {
              "sandbox": {
                "description": "One Sandbox in the binding's namespace, by name.",
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "policies": {
          "description": "EgressPolicy names in the binding's namespace.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expiresAt": {
          "description": "After this instant the binding contributes nothing.",
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
