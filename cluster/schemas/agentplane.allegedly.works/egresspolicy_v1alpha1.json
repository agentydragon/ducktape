{
  "type": "object",
  "required": ["spec"],
  "properties": {
    "spec": {
      "type": "object",
      "required": ["rules"],
      "properties": {
        "rules": {
          "description": "Rules are alternatives; a request matching any one of them is allowed.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["hosts"],
            "properties": {
              "hosts": {
                "description": "Exact lowercase hostnames, or `*.` followed by a domain to match every subdomain of it (not the domain itself).",
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^(\\*\\.)?[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$"
                }
              },
              "methods": {
                "description": "HTTP methods the rule admits; omitted means any method.",
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS", "CONNECT", "TRACE"]
                }
              },
              "paths": {
                "description": "Path patterns the rule admits, as the proxy matches them; omitted means any path.",
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "credential": {
                "description": "The credential the proxy substitutes on a matching request: it replaces the placeholder value in the named header with the Secret key's value. The Secret lives in the policy's namespace and is mounted only into the proxy.",
                "type": "object",
                "required": ["secretRef", "header", "placeholder"],
                "properties": {
                  "secretRef": {
                    "type": "object",
                    "required": ["name", "key"],
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "key": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "header": {
                    "type": "string",
                    "minLength": 1
                  },
                  "placeholder": {
                    "description": "The inert value the sandbox sends in the header.",
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
