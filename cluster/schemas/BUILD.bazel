# kubeconform schemas for this repo's own CRDs, one file per served version
# (<group>/<kind>_<version>.json); each is its CRD's openAPIV3Schema, dumped by
# `bb run //x/agentplane/crds:generate_bin` and pinned by //x/agentplane/crds:test_generate.
filegroup(
    name = "schemas",
    srcs = glob(["**/*.json"]),
    visibility = ["//x/agentplane/crds:__pkg__"],
)
