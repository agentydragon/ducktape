version: 1
metadata:
  name: SSO - Browsertrix
  labels:
    blueprints.goauthentik.io/description: "Browsertrix private web archive proxy provider, application, and single-user access binding"

entries:
  - model: authentik_providers_proxy.proxyprovider
    id: browsertrix-provider
    state: present
    identifiers:
      name: browsertrix
    attrs:
      external_host: "https://archive.allegedly.works"
      # Browsertrix's frontend proxies /api to the backend and serves /data/ for
      # signed WACZ downloads, keeping every browser-visible path behind this
      # one Authentik-protected upstream.
      internal_host: "http://browsertrix-cloud-frontend.browsertrix.svc.cluster.local:80"
      mode: proxy
      authentication_flow: !Find [authentik_flows.flow, [slug, default-authentication-flow]]
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      access_token_validity: "hours=24"

  - model: authentik_core.application
    id: browsertrix-app
    state: present
    identifiers:
      slug: browsertrix
    attrs:
      name: Browsertrix Archive
      provider: !KeyOf browsertrix-provider
      meta_description: "Private Browsertrix web archive"
      meta_launch_url: "https://archive.allegedly.works"
      open_in_new_tab: true

  - model: authentik_policies.policybinding
    state: present
    identifiers:
      target: !KeyOf browsertrix-app
      user: !Find [authentik_core.user, [username, agentydragon]]
      order: 0
