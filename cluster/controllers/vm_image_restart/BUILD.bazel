load("@aspect_rules_py//py:defs.bzl", "py_image_layer", aspect_py_binary = "py_binary")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("//devinfra/python:defs.bzl", "py_library")
load("//props:oci.bzl", "py_image_entrypoint", "py_image_env")

py_library(
    name = "controller_lib",
    srcs = ["controller.py"],
    deps = ["@pypi//kubernetes_asyncio"],
)

aspect_py_binary(
    name = "controller",
    main = "controller.py",
    deps = [":controller_lib"],
)

py_image_layer(
    name = "controller_layer",
    binary = ":controller",
    group = "65532",
    owner = "65532",
)

oci_image(
    name = "image",
    base = "@debian_trixie_slim_linux_amd64",
    entrypoint = py_image_entrypoint("controller"),
    env = py_image_env(binary_name = "controller"),
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [":controller_layer"],
    user = "65532:65532",
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["vm-image-restart:latest"],
)
