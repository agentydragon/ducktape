            "options": "/^B$/"
          },
          "topic": "series"
        },
        {
          "id": "labelsToFields",
          "options": {},
          "filter": {
            "id": "byRefId",
            "options": "/^C$/"
          },
          "topic": "series"
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": ["Time", "node", "storage_pool", "Value #C"]
            }
          },
          "filter": {
            "id": "byRefId",
            "options": "/^C$/"
          },
          "topic": "series"
        },
        {
          "id": "labelsToFields",
          "options": {},
          "filter": {
            "id": "byRefId",
            "options": "/^D$/"
          },
          "topic": "series"
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": ["Time", "node", "storage_pool", "Value #D"]
            }
          },
          "filter": {
            "id": "byRefId",
