    {
      "id": 32,
      "title": "Physical pool usage",
      "description": "Physical bytes used and raw capacity per storage node and pool. These series do not include per-volume estimates or ext4/XFS host filesystem bytes.",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "datasource": "${DS_MIMIR}",
      "targets": [
        {
          "expr": "disk_usage:pool_used_bytes{node=~\"$pool_node\"}",
          "legendFormat": "{{storage_pool}} used",
          "refId": "A"
        },
        {
          "expr": "disk_usage:pool_capacity_bytes{node=~\"$pool_node\"}",
          "legendFormat": "{{storage_pool}} capacity",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^ssd · /"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#5794F2"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^hdd · /"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#FF9830"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/ · capacity$/"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [10, 10],
                  "fill": "dash"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
