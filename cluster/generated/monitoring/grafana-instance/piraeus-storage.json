          "instant": true,
          "refId": "A"
        },
        {
          "expr": "max by (node, storage_pool, phase, resource, persistentvolume, namespace, persistentvolumeclaim) (disk_usage:volume_capacity_bytes{node=~\"$node\"})",
          "format": "table",
          "instant": true,
          "refId": "B"
        }
