    {
      "id": 31,
      "title": "Copy limits / pool capacity",
      "description": "Diskful PV capacity limits divided by raw pool capacity. This is not a physical-use percentage and can exceed 100%.",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 11
