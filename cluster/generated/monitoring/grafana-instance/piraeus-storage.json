    {
      "id": 36,
      "title": "15 largest estimated diskful copy allocations",
      "description": "Top 15 per-copy allocation estimates on selected Piraeus storage nodes. Labels show namespace/PVC, node/pool, and PV phase; copies without a PVC use the LINSTOR resource name. These estimates are not a decomposition of pool physical use.",
      "type": "barchart",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 36
      },
      "datasource": "${DS_MIMIR}",
      "targets": [
        {
          "expr": "topk(15, (label_join(label_join(label_join(sum by (node, storage_pool, phase, resource, persistentvolume, namespace, persistentvolumeclaim) (disk_usage:volume_allocated_bytes{node=~\"$node\", persistentvolumeclaim!=\"\"}), \"copy\", \"/\", \"namespace\", \"persistentvolumeclaim\"), \"location\", \"/\", \"node\", \"storage_pool\"), \"copy\", \" · \", \"copy\", \"location\", \"phase\")) or (label_join(label_join(label_join(sum by (node, storage_pool, phase, resource, persistentvolume, namespace, persistentvolumeclaim) (disk_usage:volume_allocated_bytes{node=~\"$node\", persistentvolumeclaim=\"\"}), \"copy\", \"/\", \"namespace\", \"resource\"), \"location\", \"/\", \"node\", \"storage_pool\"), \"copy\", \" · \", \"copy\", \"location\", \"phase\")))",
          "format": "table",
          "instant": true,
          "refId": "A",
          "legendFormat": "{{copy}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#5794F2"
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0,
            "axisPlacement": "auto",
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xField": "copy",
        "stacking": "none",
        "showValue": "never",
        "barWidth": 0.8,
        "groupWidth": 0.7,
        "xTickLabelMaxLength": 0,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc",
          "hideZeros": true
        }
      }
    },
    {
      "id": 37,
      "title": "Diskful copy allocation estimates and PV limits",
      "description": "One row per storage-node copy, including retained or unmounted resources without a current PVC identity. Estimated allocation and PV capacity limit are separate values; PV phase distinguishes Bound, Released, and Available copies.",
      "type": "table",
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 48
