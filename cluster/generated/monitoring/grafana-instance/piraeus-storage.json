    {
      "id": 34,
      "title": "Piraeus thin-pool accounting by storage node",
      "description": "Physical pool usage and capacity are shown separately from the sum of diskful PV limits. Uncommitted headroom is capacity minus those limits and may be negative.",
      "type": "table",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "datasource": "${DS_MIMIR}",
      "targets": [
        {
          "expr": "disk_usage:pool_capacity_bytes{node=~\"$node\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "disk_usage:pool_used_bytes{node=~\"$node\"}",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "expr": "disk_usage:pool_used_bytes{node=~\"$node\"} / on (node, storage_pool) disk_usage:pool_capacity_bytes{node=~\"$node\"}",
          "format": "table",
          "instant": true,
          "refId": "C"
        },
        {
          "expr": "disk_usage:pool_committed_bytes{node=~\"$node\"}",
          "format": "table",
          "instant": true,
          "refId": "D"
        },
        {
          "expr": "disk_usage:pool_committed_bytes{node=~\"$node\"} / on (node, storage_pool) disk_usage:pool_capacity_bytes{node=~\"$node\"}",
          "format": "table",
          "instant": true,
          "refId": "E"
        },
        {
          "expr": "disk_usage:pool_capacity_bytes{node=~\"$node\"} - on (node, storage_pool) disk_usage:pool_committed_bytes{node=~\"$node\"}",
          "format": "table",
          "instant": true,
          "refId": "F"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {},
          "filter": {
            "id": "byRefId",
            "options": "/^A$/"
          },
          "topic": "series"
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": ["Time", "node", "storage_pool", "Value #A"]
            }
          },
          "filter": {
            "id": "byRefId",
            "options": "/^A$/"
          },
          "topic": "series"
        },
        {
          "id": "labelsToFields",
          "options": {},
