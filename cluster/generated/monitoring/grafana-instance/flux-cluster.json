{
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "namespace",
        "label": "Namespace",
        "skipUrlSync": false,
        "query": "label_values(kube_customresource_flux_kustomization_ready, namespace)",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_MIMIR}"
        },
        "current": {
          "text": "All",
          "value": ["$__all"]
        },
        "multi": true,
        "allowCustomValue": true,
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "auto": false,
        "auto_min": "10s",
        "auto_count": 30,
        "definition": "label_values(kube_customresource_flux_kustomization_ready, namespace)"
      }
    ]
  },
  "annotations": {},
  "uid": "eM7_f4V7z",
  "title": "Flux cluster",
  "description": "Flux readiness and reconciliation metrics from kube-state-metrics and the Flux controllers.",
  "tags": ["flux", "kubernetes"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 0,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "refresh": "1m",
  "version": 1,
  "panels": [
    {
      "type": "stat",
      "id": 1,
      "targets": [
        {
          "expr": "count(kube_customresource_flux_kustomization_ready{namespace=~\"$namespace\",status=\"True\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_MIMIR}"
          },
          "instant": true,
          "legendFormat": "ready",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Ready Kustomizations",
      "description": "Kustomizations whose Ready condition is True.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_MIMIR}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "values": false,
          "fields": ""
        },
        "percentChangeColorMode": "standard",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 1,
                "color": "green"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "id": 2,
      "targets": [
        {
          "expr": "sum(kube_customresource_flux_kustomization_ready{namespace=~\"$namespace\",status!=\"True\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_MIMIR}"
          },
          "instant": true,
          "legendFormat": "not ready",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Not-ready Kustomizations",
      "description": "Kustomizations whose current Ready condition is False or Unknown.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_MIMIR}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "area",
