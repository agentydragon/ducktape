      "id": 4,
      "description": "Elapsed time from the workflow run's recorded queued/created timestamp to its recorded start. This does not measure runner assignment; GitHub can retain the original created_at on reruns."
    },
    {
      "type": "stat",
      "transparent": false,
      "repeatDirection": "h",
      "title": "Failure Rate",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cdviz"
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT\n  COALESCE(\n    100.0 * COUNT(*) FILTER (WHERE outcome IN ('fail', 'failure', 'error')) / NULLIF(COUNT(*), 0),\n    0\n  ) AS failure_rate\nFROM cdviz.pipelinerun\nWHERE\n  ($__timeFilter(queued_at) OR $__timeFilter(finished_at))\n  AND COALESCE(NULLIF(last_payload -> 'subject' -> 'content' ->> 'pipelineName', ''), 'unknown') = ANY(ARRAY[${selected_value:sqlstring}]::text[])\n  AND finished_at IS NOT NULL",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cdviz"
          },
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "gridPos": {
