    },
    {
      "type": "timeseries",
      "transparent": false,
      "repeatDirection": "h",
      "title": "Pipeline Total Number of Run per Day",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cdviz"
      },
      "targets": [
        {
          "format": "time_series",
          "rawSql": "SELECT\n  time_bucket('1 day', COALESCE(finished_at, started_at, queued_at)) AS time,\n  CASE\n    WHEN outcome IN ('cancel', 'cancelled', 'canceled') THEN 'cancelled'\n    WHEN finished_at IS NULL AND started_at IS NOT NULL THEN 'running'\n    WHEN finished_at IS NULL THEN 'queued'\n    WHEN outcome = 'success' THEN 'success'\n    WHEN outcome = 'pass' THEN 'pass'\n    WHEN outcome = 'fail' THEN 'fail'\n    WHEN outcome = 'failure' THEN 'fail'\n    WHEN outcome = 'error' THEN 'error'\n    WHEN outcome = 'skip' THEN 'skip'\n    WHEN outcome = 'skipped' THEN 'skip'\n    ELSE COALESCE(outcome, 'unknown')\n  END AS status,\n  COUNT(*) AS count\nFROM cdviz.pipelinerun\nWHERE\n  ($__timeFilter(queued_at) OR $__timeFilter(finished_at))\n  AND (finished_at IS NOT NULL OR started_at IS NOT NULL OR queued_at IS NOT NULL)\n  AND COALESCE(NULLIF(last_payload -> 'subject' -> 'content' ->> 'pipelineName', ''), 'unknown') = ANY(ARRAY[${selected_value:sqlstring}]::text[])\nGROUP BY time, status\nORDER BY time, status",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cdviz"
          },
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "left",
            "axisWidth": 1,
            "barAlignment": 0,
            "barWidthFactor": 1,
            "drawStyle": "bars",
            "fillOpacity": 50,
            "gradientMode": "opacity",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 0,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "showValues": false,
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*(fail|error).*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*(cancel|skip).*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "semi-dark-orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*(pass|success|complet|resolved).*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*detected.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*(reported|warn|withdrawn).*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*(open|unknown|other).*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*duplicate.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "gray"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": ["sum", "max"],
          "width": 300
        }
      },
      "id": 7
    },
    {
      "type": "row",
      "collapsed": true,
      "id": 8,
      "panels": [
        {
          "type": "table",
          "title": "$selected_value - Summary",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cdviz"
          },
          "targets": [
            {
              "format": "table",
              "rawSql": "SELECT\n  COALESCE(NULLIF(last_payload -> 'subject' -> 'content' ->> 'pipelineName', ''), 'unknown') AS \"Pipeline\",\n  outcome AS \"Outcome\",\n  queued_at AS \"Queued\",\n  started_at AS \"Started\",\n  finished_at AS \"Finished\",\n  ROUND(EXTRACT(EPOCH FROM (finished_at - started_at))::numeric, 1) AS \"Runtime (s)\",\n  ROUND(EXTRACT(EPOCH FROM (started_at - queued_at))::numeric, 1) AS \"Creation-to-start (s)\",\n  last_payload -> 'customData' -> 'github' -> 'workflow_run' ->> 'head_branch' AS \"Branch\",\n  last_payload -> 'customData' -> 'github' -> 'workflow_run' ->> 'head_sha' AS \"Head SHA\",\n  (\n    SELECT string_agg(pr.value ->> 'number', ', ' ORDER BY pr.ordinality)\n    FROM jsonb_array_elements(COALESCE(last_payload -> 'customData' -> 'github' -> 'workflow_run' -> 'pull_requests', '[]'::jsonb)) WITH ORDINALITY AS pr(value, ordinality)\n  ) AS \"PRs\",\n  COALESCE(last_payload -> 'subject' -> 'content' ->> 'uri', last_payload -> 'subject' -> 'content' ->> 'url') AS \"URL\"\nFROM cdviz.pipelinerun\nWHERE $__timeFilter(COALESCE(finished_at, started_at, queued_at))\n  AND COALESCE(NULLIF(last_payload -> 'subject' -> 'content' ->> 'pipelineName', ''), 'unknown') = ANY(ARRAY[${selected_value:sqlstring}]::text[])\nORDER BY COALESCE(finished_at, started_at, queued_at) DESC NULLS LAST\nLIMIT ${limit}",
              "datasource": {
                "type": "grafana-postgresql-datasource",
                "uid": "cdviz"
              },
              "editorMode": "code",
              "rawQuery": true
            }
          ],
          "gridPos": {
            "h": 16,
            "w": 24,
            "x": 0,
            "y": 12
          },
          "fieldConfig": {
            "defaults": {
              "custom": {
                "align": "auto",
                "cellOptions": {
                  "type": "auto"
                },
                "inspect": false
              }
            },
            "overrides": []
          },
          "options": {
            "showHeader": true,
            "cellHeight": "sm",
            "footer": {
              "show": false,
              "reducer": ["sum"],
              "countRows": false
            }
          },
          "id": 9,
          "description": "Creation-to-start is the interval from workflow creation/queue timestamp to recorded start, not runner assignment time. GitHub may retain the original created_at on a rerun."
        }
      ],
      "title": "Pipeline: Latest $limit Executions",
      "gridPos": {
        "x": 0,
        "y": 13,
        "h": 1,
        "w": 24
      }
