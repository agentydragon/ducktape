    {
      "type": "timeseries",
      "transparent": false,
      "repeatDirection": "h",
      "title": "Pipeline Total Duration per Day",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cdviz"
      },
      "targets": [
        {
          "format": "time_series",
          "rawSql": "SELECT\n  time_bucket('1 day', finished_at) AS time,\n  SUM(extract('epoch' from (finished_at - started_at))) AS total_duration\nFROM cdviz.pipelinerun\nWHERE\n  ($__timeFilter(queued_at) OR $__timeFilter(finished_at))\n  AND COALESCE(NULLIF(last_payload -> 'subject' -> 'content' ->> 'pipelineName', ''), 'unknown') = ANY(ARRAY[${selected_value:sqlstring}]::text[])\n  AND finished_at IS NOT NULL\nGROUP BY time\nORDER BY time",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cdviz"
          },
          "editorMode": "code",
          "rawQuery": true
        }
