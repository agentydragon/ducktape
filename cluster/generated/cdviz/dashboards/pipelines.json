    {
      "type": "stat",
      "transparent": false,
      "repeatDirection": "h",
      "title": "Avg Creation-to-Start Time",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cdviz"
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT\n  COALESCE(AVG(extract('epoch' from (started_at - queued_at))), 0) AS avg_queue_time\nFROM cdviz.pipelinerun\nWHERE\n  ($__timeFilter(queued_at) OR $__timeFilter(finished_at))\n  AND COALESCE(NULLIF(last_payload -> 'subject' -> 'content' ->> 'pipelineName', ''), 'unknown') = ANY(ARRAY[${selected_value:sqlstring}]::text[])\n  AND finished_at IS NOT NULL\n  AND queued_at IS NOT NULL",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cdviz"
          },
          "editorMode": "code",
          "rawQuery": true
