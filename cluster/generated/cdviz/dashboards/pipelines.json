        },
        "query": "SELECT DISTINCT COALESCE(NULLIF(payload -> 'subject' -> 'content' ->> 'pipelineName', ''), 'unknown') AS __value\nFROM cdviz.cdevents_lake\nWHERE $__timeFilter(timestamp)\nAND subject = 'pipelinerun'\nORDER BY __value",
        "sort": 5,
        "refresh": 2,
        "current": {
          "text": "All",
