  "panels": [
    {
      "id": 1,
      "title": "How to read these clocks",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 6
      },
      "options": {
        "mode": "markdown",
        "content": "Each row is one head occurrence in the arrival cohort. **PR head event** starts at GitHub\u2019s PR opening or head-change timestamp: a proxy, not the commit\u2019s actual push time. **Workflow creation proxy** starts at the first observed workflow. Select one clock for comparable percentiles.\n\nResults use job completion timestamps, before webhook or agent delivery. Green replays the **latest observed required-check policy**; this is not historical merge eligibility. Missing results remain pending or unknown. Timed rates include censored heads in their denominators; younger heads are still observing. Blank timings mean no sample."
      }
    },
    {
      "id": 2,
      "title": "First verdict latency",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cdviz"
      },
      "targets": [
        {
          "refId": "feedback_2",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cdviz"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "WITH feedback AS (\n  SELECT *\n  FROM cdviz.ci_feedback($__timeFrom(), $__timeTo())\n  WHERE (\n    ${scope:sqlstring} = 'all'\n    OR (${scope:sqlstring} = 'PR' AND pr IS NOT NULL)\n    OR (${scope:sqlstring} = 'devel' AND pr IS NULL AND branch IN ('devel', 'main'))\n  )\n    AND (${clock:sqlstring} = 'all' OR clock = ${clock:sqlstring})\n)\nSELECT\n  COUNT(*) FILTER (WHERE first_verdict IN ('red', 'green') AND first_verdict_seconds IS NOT NULL) AS n,\n  PERCENTILE_CONT(0.50) WITHIN GROUP (ORDER BY first_verdict_seconds)\n    FILTER (WHERE first_verdict IN ('red', 'green') AND first_verdict_seconds IS NOT NULL) AS p50_seconds,\n  PERCENTILE_CONT(0.90) WITHIN GROUP (ORDER BY first_verdict_seconds)\n    FILTER (WHERE first_verdict IN ('red', 'green') AND first_verdict_seconds IS NOT NULL) AS p90_seconds,\n  PERCENTILE_CONT(0.99) WITHIN GROUP (ORDER BY first_verdict_seconds)\n    FILTER (WHERE first_verdict IN ('red', 'green') AND first_verdict_seconds IS NOT NULL) AS p99_seconds\nFROM feedback"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "custom": {
            "minWidth": 80,
            "width": 120
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "n"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "displayName",
                "value": "Heads (N)"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p50_seconds"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "displayName",
                "value": "P50"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p90_seconds"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "displayName",
                "value": "P90"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p99_seconds"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "displayName",
                "value": "P99"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "P50/P90/P99 from arrival to the first red or green verdict. N counts only heads with a verdict; null quantiles with N=0 are intentionally blank, not zero."
    },
    {
      "id": 3,
      "title": "First red vs first green",
      "type": "table",
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cdviz"
      },
      "targets": [
        {
          "refId": "feedback_3",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cdviz"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "WITH feedback AS (\n  SELECT *\n  FROM cdviz.ci_feedback($__timeFrom(), $__timeTo())\n  WHERE (\n    ${scope:sqlstring} = 'all'\n    OR (${scope:sqlstring} = 'PR' AND pr IS NOT NULL)\n    OR (${scope:sqlstring} = 'devel' AND pr IS NULL AND branch IN ('devel', 'main'))\n  )\n    AND (${clock:sqlstring} = 'all' OR clock = ${clock:sqlstring})\n), verdicts(verdict) AS (VALUES ('red'::text), ('green'::text)), latencies AS (\n  SELECT samples.verdict, samples.seconds\n  FROM feedback\n  CROSS JOIN LATERAL (VALUES\n    ('red'::text, feedback.red_seconds),\n    ('green'::text, feedback.green_seconds)\n  ) AS samples(verdict, seconds)\n)\nSELECT\n  verdicts.verdict,\n  COUNT(latencies.seconds) AS n,\n  PERCENTILE_CONT(0.50) WITHIN GROUP (ORDER BY latencies.seconds) AS p50_seconds,\n  PERCENTILE_CONT(0.90) WITHIN GROUP (ORDER BY latencies.seconds) AS p90_seconds\nFROM verdicts\nLEFT JOIN latencies\n  ON latencies.verdict = verdicts.verdict\n  AND latencies.seconds IS NOT NULL\nGROUP BY verdicts.verdict\nORDER BY CASE verdicts.verdict WHEN 'red' THEN 1 ELSE 2 END"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "custom": {
            "minWidth": 80,
            "width": 120
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "n"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "displayName",
                "value": "Heads (N)"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p50_seconds"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "displayName",
                "value": "P50"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p90_seconds"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "displayName",
                "value": "P90"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "verdict"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Verdict type"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "Independent first-red and first-green clocks, so a recovered head contributes to both. N counts heads with that observed timestamp; absent samples stay blank."
    },
    {
      "id": 4,
      "title": "First-verdict latency (${bucket:text} buckets)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
