      "description": "Both rates use every head at least the threshold old as of the dashboard end, including censored heads. Still-observing counts arrivals younger than that threshold. Verdict counts first red or green; green counts heads with observed all-required-gates green. Empty denominators have blank rates, not 0%."
    },
    {
      "id": 7,
      "title": "Required-policy replay coverage",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cdviz"
      },
      "targets": [
        {
          "refId": "feedback_7",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cdviz"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "WITH feedback AS (\n  SELECT *\n  FROM cdviz.ci_feedback($__timeFrom(), $__timeTo())\n  WHERE (\n    ${scope:sqlstring} = 'all'\n    OR (${scope:sqlstring} = 'PR' AND pr IS NOT NULL)\n    OR (${scope:sqlstring} = 'devel' AND pr IS NULL AND branch IN ('devel', 'main'))\n  )\n    AND (${clock:sqlstring} = 'all' OR clock = ${clock:sqlstring})\n)\nSELECT\n  COUNT(*) AS heads,\n  MAX(policy_observed_at) AS latest_observed_policy_replay,\n  COUNT(*) FILTER (WHERE policy_observed_at IS NOT NULL) AS policy_snapshot_heads,\n  COUNT(*) FILTER (\n    WHERE policy_observed_at IS NOT NULL\n      AND required_gates > 0\n      AND observed_gates = required_gates\n  ) AS fully_observed_gate_heads,\n  COUNT(*) FILTER (\n    WHERE missing_gates IS NOT NULL AND BTRIM(missing_gates) <> ''\n  ) AS heads_with_named_missing_gates,\n  COUNT(*) FILTER (WHERE policy_observed_at IS NULL) AS heads_without_policy\nFROM feedback"
        }
      ],
