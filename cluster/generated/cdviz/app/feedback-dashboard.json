        {
          "refId": "feedback_5",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cdviz"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "WITH feedback AS (\n  SELECT *\n  FROM cdviz.ci_feedback($__timeFrom(), $__timeTo())\n  WHERE (\n    ${scope:sqlstring} = 'all'\n    OR (${scope:sqlstring} = 'PR' AND pr IS NOT NULL)\n    OR (${scope:sqlstring} = 'devel' AND pr IS NULL AND branch IN ('devel', 'main'))\n  )\n    AND (${clock:sqlstring} = 'all' OR clock = ${clock:sqlstring})\n)\nSELECT state, COUNT(*) AS heads\nFROM feedback\nGROUP BY state\nORDER BY CASE state\n  WHEN 'green' THEN 1\n  WHEN 'red' THEN 2\n  WHEN 'pending' THEN 3\n  WHEN 'cancelled' THEN 4\n  WHEN 'superseded' THEN 5\n  ELSE 6\nEND"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "custom": {
            "minWidth": 80,
            "width": 120
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "heads"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "displayName",
                "value": "Heads"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "state"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Outcome"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "Counts by exact-head state in the arrival cohort. Canceled and superseded are separate from red/green verdicts; pending and unknown remain visible."
    },
    {
      "id": 6,
      "title": "Verdict / green within 5 / 10 / 20 minutes",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cdviz"
      },
      "targets": [
        {
          "refId": "feedback_6",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cdviz"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "WITH feedback AS (\n  SELECT *\n  FROM cdviz.ci_feedback($__timeFrom(), $__timeTo())\n  WHERE (\n    ${scope:sqlstring} = 'all'\n    OR (${scope:sqlstring} = 'PR' AND pr IS NOT NULL)\n    OR (${scope:sqlstring} = 'devel' AND pr IS NULL AND branch IN ('devel', 'main'))\n  )\n    AND (${clock:sqlstring} = 'all' OR clock = ${clock:sqlstring})\n), limits(label, seconds) AS (\n  VALUES ('5 minutes'::text, 300), ('10 minutes'::text, 600), ('20 minutes'::text, 1200)\n)\nSELECT\n  limits.label,\n  COUNT(*) FILTER (\n    WHERE $__timeTo()::timestamptz - feedback.arrived_at >= limits.seconds * INTERVAL '1 second'\n  ) AS eligible_heads,\n  COUNT(*) FILTER (\n    WHERE $__timeTo()::timestamptz - feedback.arrived_at < limits.seconds * INTERVAL '1 second'\n  ) AS still_observing,\n  COUNT(*) FILTER (\n    WHERE $__timeTo()::timestamptz - feedback.arrived_at >= limits.seconds * INTERVAL '1 second'\n      AND feedback.first_verdict IN ('red', 'green')\n      AND feedback.first_verdict_seconds <= limits.seconds\n  ) AS heads_with_verdict,\n  100.0 * COUNT(*) FILTER (\n    WHERE $__timeTo()::timestamptz - feedback.arrived_at >= limits.seconds * INTERVAL '1 second'\n      AND feedback.first_verdict IN ('red', 'green')\n      AND feedback.first_verdict_seconds <= limits.seconds\n  ) / NULLIF(COUNT(*) FILTER (\n    WHERE $__timeTo()::timestamptz - feedback.arrived_at >= limits.seconds * INTERVAL '1 second'\n  ), 0) AS verdict_rate_percent,\n  COUNT(*) FILTER (\n    WHERE $__timeTo()::timestamptz - feedback.arrived_at >= limits.seconds * INTERVAL '1 second'\n      AND feedback.green_seconds <= limits.seconds\n  ) AS heads_green,\n  100.0 * COUNT(*) FILTER (\n    WHERE $__timeTo()::timestamptz - feedback.arrived_at >= limits.seconds * INTERVAL '1 second'\n      AND feedback.green_seconds <= limits.seconds\n  ) / NULLIF(COUNT(*) FILTER (\n    WHERE $__timeTo()::timestamptz - feedback.arrived_at >= limits.seconds * INTERVAL '1 second'\n  ), 0) AS green_rate_percent\nFROM feedback\nCROSS JOIN limits\nGROUP BY limits.label, limits.seconds\nORDER BY limits.seconds"
        }
      ],
