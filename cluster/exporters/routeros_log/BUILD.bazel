load("@aspect_rules_py//py:defs.bzl", "py_image_layer", aspect_py_binary = "py_binary")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("//devinfra/python:defs.bzl", "py_library", "py_test")
load("//props:oci.bzl", "py_image_entrypoint", "py_image_env")

py_library(
    name = "api",
    srcs = ["api.py"],
)

py_library(
    name = "entries",
    srcs = ["entries.py"],
)

py_library(
    name = "main",
    srcs = ["main.py"],
    deps = [
        ":api",
        ":entries",
        ":settings",
        "@pypi//httpx",
        "@pypi//prometheus_client",
    ],
)

py_library(
    name = "settings",
    srcs = ["settings.py"],
    visibility = ["//cluster/cdk8s/monitoring:__pkg__"],
    deps = [
        "@pypi//pydantic",
        "@pypi//pydantic_settings",
    ],
)

py_test(
    name = "test_api",
    srcs = ["test_api.py"],
    deps = [
        ":api",
        "//:conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_entries",
    srcs = ["test_entries.py"],
    deps = [
        ":entries",
        "//:conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_main",
    srcs = ["test_main.py"],
    deps = [
        ":api",
        ":entries",
        ":main",
        ":settings",
        "//:conftest",
        "@pypi//httpx",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

aspect_py_binary(
    name = "main_image_bin",
    main = "main.py",
    deps = [":main"],
)

py_image_layer(
    name = "layers",
    binary = ":main_image_bin",
    group = "65532",
    owner = "65532",
)

oci_image(
    name = "image",
    base = "@debian_trixie_slim_linux_amd64",
    entrypoint = py_image_entrypoint("main_image_bin"),
    env = py_image_env(binary_name = "main_image_bin"),
    labels = {
        "org.opencontainers.image.source": "https://github.com/agentydragon/ducktape",
        "org.opencontainers.image.title": "routeros-log-shipper",
    },
    tars = [":layers"],
    user = "65532:65532",
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["routeros-log-shipper:latest"],
)
