py_test(
    name = "test_flux_build",
    # The whole cluster manifest tree below is fetched inside this test's own clock on RBE,
    # which is minutes against the ~7s the test itself spends; see
    # <debug/2026_08_rbe_small_test_timeouts.md>.
    size = "medium",
    srcs = ["test_flux_build.py"],
    # validate_flux_build needs the whole tree the root kustomization references.
    # cluster_all_files' glob stops at sub-package boundaries, so the cluster/k8s
    # sub-packages contribute their manifests via :manifests filegroups. :flux
    # carries the flux CLI as runfiles.
    data = [
        "//cluster/k8s:cluster_all_files",
        "//cluster/k8s:flux_system_files",
        "//cluster/k8s/agents/loki-read-proxy:manifests",
        "//cluster/k8s/cli-proxy-api:manifests",
        "//cluster/k8s/home-assistant/app:manifests",
        "//cluster/k8s/litellm/app:manifests",
        "//cluster/k8s/litellm/tana:manifests",
        "//cluster/k8s/talos-cloud-controller-manager:manifests",
    ],
    deps = [
        ":flux",
        "//util/bazel:runfiles",
        "@pypi//pytest_bazel",
    ],
)

