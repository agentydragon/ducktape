py_test(
    name = "test_flux_build",
    # The whole cluster manifest tree below is fetched inside this test's own clock on RBE,
    # which is minutes against the ~7s the test itself spends; see
    # <devinfra/debug/2026_08_rbe_small_test_timeouts.md>.
    size = "medium",
    srcs = ["test_flux_build.py"],
    # validate_flux_build needs the whole tree the root kustomization references.
    # cluster_all_files' glob stops at package boundaries, so each local package
    # supplies its Kustomize inputs through a filegroup. :flux carries the CLI.
    data = [
        "//cluster:generated_manifests",
        "//cluster/k8s:cluster_all_files",
        "//cluster/k8s/agentplane-staging:manifests",
        "//cluster/k8s/authentik/app/blueprints:authentik_blueprints",
        "//cluster/k8s/cli-proxy-api:manifests",
        "//cluster/k8s/flux/flux-system:flux_system_files",
        "//cluster/k8s/home-assistant/app:manifests",
        "//cluster/k8s/litellm/app:manifests",
    ],
    deps = [
        ":flux",
        "//util/bazel:runfiles",
        "@pypi//pytest_bazel",
    ],
)

