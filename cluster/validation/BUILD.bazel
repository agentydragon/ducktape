# gazelle:ignore

load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = [
    "//cluster:__subpackages__",
    "//devinfra/precommit:__pkg__",
])

# Shared inputs for tests that walk the hand-written manifest roots or render Flux paths.
# Each package glob stops at its Bazel package boundary; this filegroup makes those inputs
# available at their repo-relative paths in the Linux runfiles tree.
filegroup(
    name = "cluster_k8s_inputs",
    testonly = True,
    srcs = [
        "//cluster/k8s:cluster_all_files",
        "//cluster/k8s/agentplane-staging:manifests",
        "//cluster/k8s/authentik/app/blueprints:authentik_blueprints",
        "//cluster/k8s/cli-proxy-api:manifests",
        "//cluster/k8s/flux/flux-system:flux_system_files",
        "//cluster/k8s/home-assistant/app:manifests",
        "//cluster/k8s/litellm/app:manifests",
    ],
)

py_test(
    name = "test_cluster",
    srcs = ["test_cluster.py"],
    deps = [
        ":cluster",
        ":flux",
        ":k8s",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "k8s",
    srcs = ["k8s.py"],
    deps = [
        "@pypi//pydantic",
        "@pypi//pyyaml",
