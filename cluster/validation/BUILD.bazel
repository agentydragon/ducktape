py_test(
    name = "test_cluster_integration",
    srcs = ["test_cluster_integration.py"],
    # The grocy user-perms overlays (in cluster_all_files) reference the
    # user-perms-base sub-package, which the glob stops at — bring it in via its
    # :manifests filegroup so their kustomize builds resolve.
    data = [
        "//cluster/k8s:cluster_all_files",
        "//cluster/k8s:flux_bootstrap_files",
        "//cluster/k8s/grocy/user-perms-base:manifests",
        "@multitool//tools/kustomize",
    ],
    deps = [
        ":authentik_blueprints",
        ":checks",
        ":cluster",
        ":crd_layering",
        ":dependencies",
        ":flux",
        ":flux_bootstrap_auth",
        ":health_checks",
        ":image_automation",
        ":kustomize",
        ":terraform_backends",
        "//util/bazel:runfiles",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_flux_build",
    srcs = ["test_flux_build.py"],
    # validate_flux_build needs the whole tree the root kustomization references.
    # cluster_all_files' glob stops at sub-package boundaries, so the cluster/k8s
    # sub-packages contribute their manifests via :manifests filegroups. :flux
    # carries the flux CLI as runfiles.
    data = [
        "//cluster/k8s:cluster_all_files",
        "//cluster/k8s:flux_system_files",
        "//cluster/k8s/agents/attic-jwt-rotation:manifests",
        "//cluster/k8s/agents/authentik-jwt-rotation:manifests",
        "//cluster/k8s/grocy/user-perms-base:manifests",
        "//cluster/k8s/haku/dispatch/litellm:manifests",
        "//cluster/k8s/inventree/token-provisioner:manifests",
        "//cluster/k8s/litellm/app:manifests",
        "//cluster/k8s/litellm/tana:manifests",
        "//cluster/k8s/talos-cloud-controller-manager:manifests",
    ],
    deps = [
        ":flux",
        "//util/bazel:runfiles",
        "@pypi//pytest_bazel",
    ],
)

