+#[cfg(test)]
+mod database_pool_tests {
+    use sea_orm::Database;
+
+    use super::database_connect_options;
+    use crate::config::DatabaseConfig;
+
+    #[tokio::test]
+    async fn database_max_connections_configures_the_sqlite_pool() {
+        let cases = [
+            ("url = \"sqlite::memory:\"\n", 10),
+            (
+                "url = \"sqlite::memory:\"\nmax-connections = 32\n",
+                32,
+            ),
+        ];
+
+        for (toml, expected_max_connections) in cases {
+            let config: DatabaseConfig = toml::from_str(toml).unwrap();
+            let db = Database::connect(database_connect_options(&config))
+                .await
+                .unwrap();
+            assert_eq!(
+                db.get_sqlite_connection_pool()
+                    .options()
+                    .get_max_connections(),
+                expected_max_connections
+            );
+        }
+    }
+}
