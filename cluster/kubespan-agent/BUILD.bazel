load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

go_library(
    name = "kubespan-agent_lib",
    srcs = [
        "config.go",
        "discovery.go",
        "identity.go",
        "main.go",
        "peerstate.go",
        "routing.go",
        "wireguard.go",
    ],
    importpath = "github.com/agentydragon/ducktape/cluster/kubespan-agent",
    visibility = ["//visibility:private"],
    deps = [
        "@com_github_google_nftables//:nftables",
        "@com_github_google_nftables//binaryutil",
        "@com_github_google_nftables//expr",
        "@com_github_mdlayher_netx//eui64",
        "@com_github_siderolabs_discovery_api//api/v1alpha1/client/pb",
        "@com_github_siderolabs_discovery_client//pkg/client",
        "@com_github_vishvananda_netlink//:netlink",
        "@com_zx2c4_golang_wireguard_wgctrl//:wgctrl",
        "@com_zx2c4_golang_wireguard_wgctrl//wgtypes",
        "@in_gopkg_yaml_v3//:yaml_v3",
        "@org_go4_netipx//:netipx",
        "@org_golang_x_sys//unix",
        "@org_uber_go_zap//:zap",
    ],
)

go_binary(
    name = "kubespan-agent",
    embed = [":kubespan-agent_lib"],
    goarch = "amd64",
    goos = "linux",
    static = "on",
    visibility = ["//visibility:public"],
)

go_test(
    name = "kubespan-agent_test",
    srcs = ["peerstate_test.go"],
    embed = [":kubespan-agent_lib"],
)

# OCI image for kubespand (used by E2E tests).
pkg_tar(
    name = "kubespand_layer",
    testonly = True,
    srcs = [":kubespan-agent"],
    package_dir = "/",
    remap_paths = {"kubespan-agent": "kubespand"},
)

oci_image(
    name = "kubespand_image",
    testonly = True,
    base = "@debian_slim_linux_amd64",
    entrypoint = ["/kubespand"],
    tars = [":kubespand_layer"],
    visibility = ["//visibility:public"],
)

oci_load(
    name = "kubespand_load",
    testonly = True,
    image = ":kubespand_image",
    repo_tags = ["kubespand:latest"],
)

filegroup(
    name = "kubespand_tarball",
    testonly = True,
    srcs = [":kubespand_load"],
    output_group = "tarball",
    visibility = ["//visibility:public"],
)
