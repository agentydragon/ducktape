load("@aspect_rules_py//py:defs.bzl", aspect_py_binary = "py_binary")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//cluster/rotators:image.bzl", "rotator_image")
load("//devinfra/python:defs.bzl", "py_library", "py_test")

py_library(
    name = "config",
    srcs = ["config.py"],
    visibility = [
        "//cluster/cdk8s:__pkg__",
        "//cluster/cdk8s/nix_cache:__pkg__",
    ],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "rotate",
    srcs = ["rotate.py"],
    deps = [
        ":config",
        "//cluster/rotators:sops",
        "//cluster/rotators:sops_stamps",
        "@pypi//httpx",
        "@pypi//pydantic",
        "@pypi//pygit2",
        "@pypi//pyyaml",
        "@pypi//typer",
    ],
)

py_test(
    name = "test_rotate",
    srcs = ["test_rotate.py"],
    deps = [
        ":config",
        ":rotate",
        "//:conftest",
        "//cluster/rotators:sops",
        "@pypi//certifi",
        "@pypi//httpx",
        "@pypi//pydantic",
        "@pypi//pygit2",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//pyyaml",
    ],
)

# Local/operator-only tool (needs SOPS decrypt access to cluster secrets) —
# deliberately not a dep of ":layers"/":image" below, so it never ships in the
# attic-jwt-rotation container image.
py_library(
    name = "sync_pubkeys",
    srcs = ["sync_pubkeys.py"],
    deps = [
        "@pypi//pyyaml",
        "@pypi//typer",
    ],
)

py_test(
    name = "test_sync_pubkeys",
    srcs = ["test_sync_pubkeys.py"],
    deps = [
        ":sync_pubkeys",
        "//:conftest",
        "@pypi//pytest_bazel",
    ],
)

aspect_py_binary(
    name = "sync_pubkeys_bin",
    main = "sync_pubkeys.py",
    deps = [":sync_pubkeys"],
)

# kubectl binary layer — placed at /usr/local/bin/kubectl.
# The rotator exec's the running attic pod to mint JWTs:
# `kubectl exec deploy/attic-next -- atticadm make-token …` (so atticadm runs in its
# native nix environment and the HS256 signing secret never leaves the attic pod).
pkg_tar(
    name = "kubectl_layer",
    srcs = ["@kubectl_linux_amd64//file:kubectl"],
    package_dir = "/usr/local/bin",
)

rotator_image(
    name = "image",
    repo_tag = "attic-jwt-rotation:latest",
    tool_layers = [
        "//cluster/rotators:sops_layer",
        ":kubectl_layer",
    ],
)
