load("//cluster/rotators:image.bzl", "rotator_image")
load("//devinfra/python:defs.bzl", "py_library", "py_test")

py_library(
    name = "config",
    srcs = ["config.py"],
    # cluster/cdk8s/forgejo/token_rotation.py builds the roster from this model.
    visibility = [
        "//cluster/cdk8s:__pkg__",
        "//cluster/cdk8s/forgejo:__pkg__",
    ],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "rotate",
    srcs = ["rotate.py"],
    deps = [
        ":config",
        "//cluster/rotators:git_publish",
        "//cluster/rotators:sops",
        "//cluster/rotators:sops_stamps",
        "@pypi//httpx",
        "@pypi//pyyaml",
        "@pypi//typer",
    ],
)

py_test(
    name = "test_rotate",
    srcs = ["test_rotate.py"],
    deps = [
        ":config",
        ":rotate",
        "//:conftest",
        "@pypi//httpx",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//pyyaml",
    ],
)

rotator_image(
    name = "image",
    repo_tag = "forgejo-token-rotation:latest",
    tool_layers = [
        "@trixie_authentik_rotation//:flat",
        "//cluster/rotators:sops_layer",
    ],
)
