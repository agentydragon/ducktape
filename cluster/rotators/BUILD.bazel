load("//devinfra/python:defs.bzl", "py_library", "py_test")

py_library(
    name = "sops_stamps",
    srcs = ["sops_stamps.py"],
    visibility = ["//cluster/rotators:__subpackages__"],
    deps = ["@pypi//pyyaml"],
)

py_library(
    name = "sops",
    srcs = ["sops.py"],
    visibility = ["//cluster/rotators:__subpackages__"],
    deps = [
        "//devinfra:prettier_cli",
        "@pypi//pyyaml",
    ],
)

py_test(
    name = "test_sops",
    srcs = ["test_sops.py"],
    deps = [
        ":sops",
        "//:conftest",
        "@pypi//pytest_bazel",
        "@pypi//pyyaml",
    ],
)

py_test(
    name = "test_sops_stamps",
    srcs = ["test_sops_stamps.py"],
    deps = [
        ":sops_stamps",
        "//:conftest",
        "@pypi//pytest_bazel",
    ],
)
