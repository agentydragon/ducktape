load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//devinfra/python:defs.bzl", "py_library", "py_test")

py_library(
    name = "sops_stamps",
    srcs = ["sops_stamps.py"],
    visibility = ["//cluster/rotators:__subpackages__"],
    deps = ["@pypi//pyyaml"],
)

py_library(
    name = "sops",
    srcs = ["sops.py"],
    visibility = ["//cluster/rotators:__subpackages__"],
    deps = [
        "//devinfra:prettier_cli",
        "@pypi//pyyaml",
    ],
)

py_test(
    name = "test_sops",
    srcs = ["test_sops.py"],
    deps = [
        ":sops",
        "//:conftest",
        "@pypi//pytest_bazel",
        "@pypi//pyyaml",
    ],
)

py_test(
    name = "test_sops_stamps",
    srcs = ["test_sops_stamps.py"],
    deps = [
        ":sops_stamps",
        "//:conftest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "git_publish",
    srcs = ["git_publish.py"],
    visibility = [
        "//cluster/rotators/authentik_jwt_rotation:__pkg__",
        "//cluster/rotators/forgejo_token_rotation:__pkg__",
    ],
)

py_test(
    name = "test_git_publish",
    srcs = ["test_git_publish.py"],
    deps = [
        ":git_publish",
        "//:conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

pkg_tar(
    name = "sops_layer",
    srcs = ["@sops_linux_amd64//file:sops"],
    package_dir = "/usr/local/bin",
    visibility = ["//cluster/rotators:__subpackages__"],
)
