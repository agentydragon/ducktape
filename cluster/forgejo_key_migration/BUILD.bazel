load("@aspect_rules_py//py:defs.bzl", "py_image_layer", aspect_py_binary = "py_binary")
load("@rules_oci//oci:defs.bzl", "oci_image")
load("//devinfra/oci:py_image.bzl", "py_image_entrypoint", "py_image_env")
load("//devinfra/python:defs.bzl", "py_library")

py_library(
    name = "migrate",
    srcs = ["migrate.py"],
    deps = [
        "@pypi//psycopg",
        "@pypi//psycopg_binary",  # keep: psycopg loads its binary implementation dynamically.
        "@pypi//pycryptodome",
    ],
)

aspect_py_binary(
    name = "migrate_bin",
    main = "migrate.py",
    deps = [":migrate"],
)

py_image_layer(
    name = "layers",
    binary = ":migrate_bin",
    group = "1000",
    owner = "1000",
)

oci_image(
    name = "image",
    base = "@debian_trixie_slim_linux_amd64",
    entrypoint = py_image_entrypoint("migrate_bin"),
    env = py_image_env(),
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [":layers"],
    user = "1000:1000",
)
