load("//devinfra/tf:defs.bzl", "tf_module")

exports_files(
    ["cilium-values.yaml"],
    visibility = ["//cluster:__subpackages__"],
)

tf_module(
    name = "main",
    data = [
        "//:nebula-mesh.json",
        "//cluster:generated/talos-cloud-controller-manager/helmrelease.k8s.yaml",
        "//cluster/k8s/flux/flux-system:flux_bootstrap_files",
    ],
    providers = {
        "proxmox": "bpg/proxmox:~>0.113.0",
        "talos": "siderolabs/talos:~>0.11.0",
        "kubernetes": "hashicorp/kubernetes:~>3.2.0",
        "helm": "hashicorp/helm:~>3.3.0",
        "local": "hashicorp/local:~>2.9.0",
        "null": "hashicorp/null:~>3.3.0",
        "sops": "carlpett/sops:~>1.4.0",
        "ovh": "ovh/ovh:~>2.0",
    },
    tflint_config = "//cluster:.tflint.hcl",
    deps = [
        "//tf/modules/nixos-image",
    ],
)
