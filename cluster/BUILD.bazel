# gazelle:ignore

load("//devinfra/python:defs.bzl", "py_binary", "py_library")

exports_files([".tflint.hcl"])

exports_files(["debug/gitlab_gitaly_storage_bench/gitlab-bench.sh"])

# Single generated files for focused consumers (the Terraform bootstrap's talos-ccm
# HelmRelease, direct-file validation contracts).
exports_files(
    glob(["generated/**"]),
    visibility = ["//cluster:__subpackages__"],
)

filegroup(
    name = "grafana_dashboard_manifest",
    srcs = ["generated/monitoring/grafana-instance/grafana-instance.k8s.yaml"],
    visibility = ["//grafana/skill:__pkg__"],
)

# The closed-world generated tree (cluster/cdk8s/manifest_roots.py), whole: the parity test
# fails on any file here the generator does not write.
filegroup(
    name = "generated_manifests",
    srcs = glob(["generated/**"]),
    visibility = ["//cluster:__subpackages__"],
)

# Generator output kept beside hand-written files in the parked tree, for the parity test.
filegroup(
    name = "parked_generated_manifests",
    srcs = glob([
        "parked/**/*.k8s.yaml",
        "parked/haku-openclaw-spike/backup/**",
        "parked/public-coder-agent/backup/kustomization.yaml",
    ]),
    visibility = ["//cluster/cdk8s:__pkg__"],
)

filegroup(
    name = "haku_openclaw_spike_backup_sources",
    srcs = [
        "parked/haku-openclaw-spike/backup/README.md",
        "parked/haku-openclaw-spike/backup/repository.sops.yaml",
    ],
    visibility = ["//cluster/cdk8s:__pkg__"],
)

py_library(
    name = "network_readiness",
    srcs = ["network_readiness.py"],
    deps = [
        "@pypi//kubernetes",
        "@pypi//tenacity",
    ],
)

py_library(
    name = "bootstrap_lib",
    srcs = ["bootstrap.py"],
    deps = [
        ":network_readiness",
        "//util/bazel:runfiles",
        "//util/bazel:workspace",
        "@pypi//kubernetes",
        "@pypi//pygit2",
    ],
)

py_binary(
    name = "bootstrap",
    data = ["@multitool//tools/tofu"],
    main_module = "cluster.bootstrap",
    deps = [":bootstrap_lib"],
)
