# gazelle:ignore

load("//devinfra/python:defs.bzl", "py_binary", "py_library")

exports_files([".tflint.hcl"])

# Single generated files for focused consumers (the Terraform bootstrap's talos-ccm
# HelmRelease, direct-file validation contracts).
exports_files(
    glob(["generated/**"]),
    visibility = ["//cluster:__subpackages__"],
)

# Live acceptance enumerates the committed app catalog without importing its generator.
filegroup(
    name = "agentplane_testing_manifest",
    srcs = ["generated/agentplane-testing/agentplane-testing.k8s.yaml"],
    visibility = ["//agentplane/acceptance:__pkg__"],
)

# Just the central ClusterPolicy manifests, so a per-policy test is not
# invalidated by every unrelated manifest in the cluster (same reasoning as the
# contract filegroups in //cluster/k8s). The retired Haku zone injector lives with its
# package under //haku/x/zones/deploy and is intentionally outside this active filegroup.
filegroup(
    name = "kyverno_policy_files",
    srcs = ["generated/kyverno/policies/policies.k8s.yaml"],
    visibility = ["//cluster/validation/kyverno:__pkg__"],
)

# The closed-world generated tree (cluster/cdk8s/manifest_roots.py), whole: the parity test
# fails on any file here the generator does not write.
filegroup(
    name = "generated_manifests",
    srcs = glob(["generated/**"]),
    visibility = ["//cluster:__subpackages__"],
)

# Generator output kept beside hand-written files in the parked tree, for the parity test.
filegroup(
    name = "parked_generated_manifests",
    srcs = glob([
        "parked/**/*.k8s.yaml",
        "parked/agent-workspaces/kustomization.yaml",
        "parked/agents-mitmproxy/kustomization.yaml",
        "parked/haku-openclaw-spike/**",
    ]),
    visibility = ["//cluster/cdk8s:__pkg__"],
)

py_library(
    name = "network_readiness",
    srcs = ["network_readiness.py"],
    deps = [
        "@pypi//kubernetes",
        "@pypi//tenacity",
    ],
)

py_library(
    name = "bootstrap_lib",
    srcs = ["bootstrap.py"],
    deps = [
        ":network_readiness",
        "//util/bazel:runfiles",
        "//util/bazel:workspace",
        "@pypi//kubernetes",
        "@pypi//pygit2",
    ],
)

py_binary(
    name = "bootstrap",
    data = ["@multitool//tools/tofu"],
    main_module = "cluster.bootstrap",
    deps = [":bootstrap_lib"],
)
