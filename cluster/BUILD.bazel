# gazelle:ignore

load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("//tools/testing:defs.bzl", "py_test")

py_library(
    name = "bootstrap_lib",
    srcs = ["bootstrap.py"],
    deps = [
        "//cluster/scripts:generate_claude_kubeconfig_lib",
        "//util/bazel:runfiles",
        "//util/bazel:workspace",
        "@pypi//kubernetes",
        "@pypi//pydantic",
        "@pypi//pygit2",
        "@pypi//pyyaml",
        "@pypi//tenacity",
    ],
)

py_binary(
    name = "bootstrap",
    data = ["@multitool//tools/tofu"],
    main_module = "cluster.bootstrap",
    deps = [":bootstrap_lib"],
)

py_test(
    name = "test_bootstrap",
    srcs = ["test_bootstrap.py"],
    data = ["@multitool//tools/tofu"],
    imports = [".."],
    deps = [
        ":bootstrap_lib",
        "@pypi//pytest_bazel",
    ],
)
