# gazelle:ignore

load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

exports_files([".tflint.hcl"])

py_library(
    name = "flux_constructs",
    srcs = ["flux_constructs.py"],
    deps = [
        "//third_party/flux:kustomization",
        "@pypi//cdk8s",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "litellm_config",
    srcs = ["litellm_config.py"],
    visibility = [
        "//cluster/k8s/litellm/app:__pkg__",
        "//debug/litellm_probe:__pkg__",
    ],
    deps = ["//cluster/k8s/litellm/app:model_rosters"],
)

py_library(
    name = "litellm_constructs",
    srcs = ["litellm_constructs.py"],
    deps = [
        ":litellm_config",
        "//third_party/external_secrets:externalsecret",
        "//third_party/gateway_api:httproute",
        "//third_party/prometheus_operator:servicemonitor",
        "@pypi//cdk8s",
        "@pypi//cdk8s_plus_33",
        "@pypi//constructs",
    ],
)

py_library(
    name = "generate_manifests_lib",
    srcs = ["generate_manifests.py"],
    visibility = ["//visibility:private"],
    deps = [
        ":flux_constructs",
        ":litellm_constructs",
        "//util/bazel:workspace",
        "@pypi//cdk8s",
    ],
)

py_binary(
    name = "generate_manifests",
    data = ["@nodejs_linux_amd64//:bin/node"],
    env = {"JSII_NODE": "$(rootpath @nodejs_linux_amd64//:bin/node)"},
    main_module = "cluster.generate_manifests",
    visibility = ["//visibility:public"],
    deps = [":generate_manifests_lib"],
)

py_test(
    name = "test_generate_manifests",
    srcs = ["test_generate_manifests.py"],
    data = [
        "//cluster/k8s/litellm/app:flux-kustomization.yaml",
        "//cluster/k8s/litellm/app:kustomization.yaml",
        "//cluster/k8s/litellm/app:litellm.k8s.yaml",
        "@nodejs_linux_amd64//:bin/node",
    ],
    env = {"JSII_NODE": "$(rootpath @nodejs_linux_amd64//:bin/node)"},
    deps = [
        ":generate_manifests_lib",
        "//util/bazel:runfiles",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "network_readiness",
    srcs = ["network_readiness.py"],
    deps = [
        "@pypi//kubernetes",
        "@pypi//tenacity",
    ],
)

py_library(
    name = "bootstrap_lib",
    srcs = ["bootstrap.py"],
    deps = [
        ":network_readiness",
        "//util/bazel:runfiles",
        "//util/bazel:workspace",
        "@pypi//kubernetes",
        "@pypi//pygit2",
    ],
)

py_binary(
    name = "bootstrap",
    data = ["@multitool//tools/tofu"],
    main_module = "cluster.bootstrap",
    deps = [":bootstrap_lib"],
)
