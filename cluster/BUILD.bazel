# gazelle:ignore

load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library")
load("//devinfra/python:defs.bzl", "py_binary", "py_library")

exports_files([".tflint.hcl"])

js_library(
    name = "generate_manifests_lib",
    srcs = ["generate_manifests.mjs"],
    visibility = ["//visibility:private"],
    deps = ["//:node_modules/cdk8s"],
)

# A local Bazel binary is intentional here: the eventual GitHub workflow can run
# this with `bb run`, write the generated YAML into a temporary checkout, and
# commit/publish that output without giving GitHub cluster credentials.
js_binary(
    name = "generate_manifests",
    data = [":generate_manifests_lib"],
    entry_point = "generate_manifests.mjs",
    visibility = ["//visibility:public"],
)

py_library(
    name = "network_readiness",
    srcs = ["network_readiness.py"],
    deps = [
        "@pypi//kubernetes",
        "@pypi//tenacity",
    ],
)

py_library(
    name = "bootstrap_lib",
    srcs = ["bootstrap.py"],
    deps = [
        ":network_readiness",
        "//util/bazel:runfiles",
        "//util/bazel:workspace",
        "@pypi//kubernetes",
        "@pypi//pygit2",
    ],
)

py_binary(
    name = "bootstrap",
    data = ["@multitool//tools/tofu"],
    main_module = "cluster.bootstrap",
    deps = [":bootstrap_lib"],
)
