# gazelle:ignore

load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

exports_files([".tflint.hcl"])

py_library(
    name = "generate_manifests_lib",
    srcs = ["generate_manifests.py"],
    visibility = ["//visibility:private"],
    deps = [
        "//cluster/k8s/litellm/app:model_rosters",
        "//tana/litellm_proxy:model_registry",
        "@pypi//cdk8s",
        "@pypi//cdk8s_plus_33",
    ],
)

py_binary(
    name = "generate_manifests",
    data = ["@nodejs_linux_amd64//:bin/node"],
    env = {"JSII_NODE": "$(rootpath @nodejs_linux_amd64//:bin/node)"},
    main_module = "cluster.generate_manifests",
    visibility = ["//visibility:public"],
    deps = [":generate_manifests_lib"],
)

py_test(
    name = "test_generate_manifests",
    srcs = ["test_generate_manifests.py"],
    data = [
        "//cluster/k8s:litellm/servicemonitor/servicemonitor.yaml",
        "//cluster/k8s/litellm/app:deployment.yaml",
        "//cluster/k8s/litellm/app:httproute.yaml",
        "//cluster/k8s/litellm/app:proxy-config.yaml",
        "//cluster/k8s/litellm/app:service.yaml",
        "//cluster/k8s/litellm/app:serviceaccount.yaml",
        "//cluster/k8s/litellm/tana:custom_handler.py",
        "//cluster/k8s/litellm/tana:deployment.yaml",
        "//cluster/k8s/litellm/tana:forgejo-images-creds-eso.yaml",
        "//cluster/k8s/litellm/tana:httproute.yaml",
        "//cluster/k8s/litellm/tana:proxy-config.yaml",
        "//cluster/k8s/litellm/tana:service.yaml",
        "//cluster/k8s/x/haku/dispatch/litellm:cnp-workers-litellm.yaml",
        "//cluster/k8s/x/haku/dispatch/litellm:deployment.yaml",
        "//cluster/k8s/x/haku/dispatch/litellm:service.yaml",
        "//cluster/k8s/x/haku/dispatch/litellm:workers-litellm-config.yaml",
        "@nodejs_linux_amd64//:bin/node",
    ],
    env = {"JSII_NODE": "$(rootpath @nodejs_linux_amd64//:bin/node)"},
    deps = [
        ":generate_manifests_lib",
        "//util/bazel:runfiles",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//pyyaml",
    ],
)

py_library(
    name = "network_readiness",
    srcs = ["network_readiness.py"],
    deps = [
        "@pypi//kubernetes",
        "@pypi//tenacity",
    ],
)

py_library(
    name = "bootstrap_lib",
    srcs = ["bootstrap.py"],
    deps = [
        ":network_readiness",
        "//util/bazel:runfiles",
        "//util/bazel:workspace",
        "@pypi//kubernetes",
        "@pypi//pygit2",
    ],
)

py_binary(
    name = "bootstrap",
    data = ["@multitool//tools/tofu"],
    main_module = "cluster.bootstrap",
    deps = [":bootstrap_lib"],
)
