# Inherit repo root environment, including cluster/infra CLIs (talosctl,
# kyverno, nebula, awscli2, hcloud, ovhcloud-cli) now in the flake devShell.
source_up

# Best-effort sops decrypt. direnv runs the .envrc under `set -e`, so a bare
# `var=$(sops -d ...)` that exits non-zero (e.g. when the file's age recipients
# don't include the current user's SOPS_AGE_KEY) aborts the whole .envrc with
# `direnv: error exit status 128` and silently leaves the rest of the shell
# unset. Wrap each call to swallow the failure and emit a single warning so the
# rest of the cluster env still loads.
_sops_extract() {
  # usage: _sops_extract <var-label> <jsonpath> <file>
  local label="$1" path="$2" file="$3" out
  if ! out=$(sops -d --extract "$path" "$file" 2>/dev/null); then
    echo "WARNING: sops failed to decrypt ${label} from ${file} (no matching age key?) — leaving env unset" >&2
    return 1
  fi
  printf '%s' "$out"
}

# Proxmox API token (SOPS-encrypted, ../secrets/shared/cluster-tokens.yaml).
# A legacy HCloud token remains in that SOPS file for account-history access,
# but active cluster bootstrap no longer consumes it.
export PROXMOX_VE_API_TOKEN=$(_sops_extract PROXMOX_VE_API_TOKEN '["proxmox_ve_api_token"]' ../secrets/shared/cluster-tokens.yaml || true)

# Set talos config and kubeconfig (generated by terraform)
export TALOSCONFIG="$PWD/terraform/main/talosconfig.yml"
export KUBECONFIG="$PWD/terraform/main/kubeconfig"

# PG connection for OpenTofu state backend (CNPG tofu-state-db in k8s).
# Credentials from SOPS (no cluster access needed).
# From k8s workers: uses ClusterIP directly (no port-forward needed).
# From non-workers: use kubectl port-forward -n tofu-state svc/tofu-state-db-ovh-rw 15432:5432
_pg_user="tfstate"
_pg_name="tfstate"
_pg_pass=$(_sops_extract tofu-state-db-password '["stringData"]["password"]' k8s/tofu-state/db/credentials.sops.yaml || true)
if [ -n "$_pg_pass" ]; then
  _cluster_ip=""
  if [ -s "$KUBECONFIG" ]; then
    _cluster_ip=$(timeout 3 kubectl get svc -n tofu-state tofu-state-db-ovh-rw -o jsonpath='{.spec.clusterIP}' 2>/dev/null)
  fi
  if [ -n "$_cluster_ip" ] && timeout 1 bash -c "echo >/dev/tcp/$_cluster_ip/5432" 2>/dev/null; then
    export PG_CONN_STR="postgres://${_pg_user}:${_pg_pass}@${_cluster_ip}:5432/${_pg_name}?sslmode=disable"
    echo "PG_CONN_STR configured (ClusterIP ${_cluster_ip})"
  else
    export PG_CONN_STR="postgres://${_pg_user}:${_pg_pass}@localhost:15432/${_pg_name}?sslmode=disable"
    echo "PG_CONN_STR configured (port-forward to localhost:15432 required)"
    echo "Run: kubectl port-forward -n tofu-state svc/tofu-state-db-ovh-rw 15432:5432"
  fi
else
  echo "WARNING: Could not decrypt tofu-state-db credentials from SOPS. PG_CONN_STR not set."
fi

cat <<'EOF'
🚀 Talos Kubernetes Cluster Environment
═══════════════════════════════════════
Authentik: https://auth.allegedly.works

get-passwords  - Retrieve Authentik passwords (akadmin & agentydragon@gmail.com)
EOF

# Add scripts directory to PATH
PATH_add scripts
