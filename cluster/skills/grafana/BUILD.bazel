# gazelle:ignore

load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")
load("//skills:defs.bzl", "skill_package")

package(default_visibility = ["//visibility:public"])

exports_files(["dashboard_visual_test.py"])

py_binary(
    name = "verify_dashboard",
    srcs = ["verify_dashboard.py"],
    data = [
        "//cluster:generated/monitoring/grafana-instance/grafana-instance.k8s.yaml",
        "//cluster/cdk8s/monitoring/dashboards",
        "@chrome_headless_shell//:executable",
    ],
    env = {
        "CHROMIUM_HEADLESS_SHELL": "$(rootpath @chrome_headless_shell//:executable)",
    },
    main = "verify_dashboard.py",
    deps = [
        "//util/bazel:runfiles",
        "@pypi//httpx",
        "@pypi//playwright",
        "@pypi//pyyaml",
    ],
)

py_test(
    name = "test_verify_dashboard",
    srcs = ["test_verify_dashboard.py"],
    data = ["verify_dashboard.py"],
    deps = [
        "//util/bazel:runfiles",
        "@pypi//httpx",
        "@pypi//playwright",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//pyyaml",
    ],
)

py_library(
    name = "visual_browser",
    testonly = True,
    srcs = ["visual_browser.py"],
    deps = [
        "//util/testing:visual_capture",
        "@pypi//playwright",
    ],
)

py_library(
    name = "visual_harness",
    testonly = True,
    srcs = ["visual_harness.py"],
    deps = [
        "//third_party/containers:grafana_visual",
        "//third_party/containers:prometheus_visual",
        "//third_party/containers:ryuk",
        "//util:oci",
        "//util/testing:container_logs",
        "//util/testing:undeclared_outputs",
        "@pypi//docker",
        "@pypi//httpx",
        "@pypi//testcontainers",
    ],
)

skill_package(
    name = "grafana",
    srcs = [
        "SKILL.md",
        "verify_dashboard.py",
    ],
)
