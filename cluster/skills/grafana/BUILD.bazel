# gazelle:ignore

load("//devinfra/python:defs.bzl", "py_binary", "py_test")
load("//skills:defs.bzl", "skill_package")

package(default_visibility = ["//visibility:public"])

py_binary(
    name = "verify_dashboard",
    srcs = ["verify_dashboard.py"],
    data = [
        "//cluster:generated/monitoring/grafana-instance/grafana-instance.k8s.yaml",
        "//cluster/cdk8s/monitoring:dashboards",
        "@chrome_headless_shell//:executable",
    ],
    env = {
        "CHROMIUM_HEADLESS_SHELL": "$(rootpath @chrome_headless_shell//:executable)",
    },
    main = "verify_dashboard.py",
    deps = [
        "//util/bazel:runfiles",
        "@pypi//httpx",
        "@pypi//playwright",
        "@pypi//pyyaml",
    ],
)

py_test(
    name = "test_verify_dashboard",
    srcs = ["test_verify_dashboard.py"],
    data = ["verify_dashboard.py"],
    deps = [
        "//util/bazel:runfiles",
        "@pypi//httpx",
        "@pypi//playwright",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//pyyaml",
    ],
)

py_test(
    name = "piraeus_dashboard_visual_test",
    srcs = ["test_piraeus_dashboard_visual.py"],
    data = ["//cluster/cdk8s/monitoring:piraeus_dashboard"],
    main = "test_piraeus_dashboard_visual.py",
    requires_docker = True,
    tags = ["visual"],
    deps = [
        "//third_party/containers:grafana_visual",
        "//third_party/containers:prometheus_visual",
        "//util:oci",
        "//util/bazel:runfiles",
        "//util/testing:frontend_visual",
        "//util/testing:undeclared_outputs",
        "//util/testing:visual_capture",
        "@pypi//docker",
        "@pypi//httpx",
        "@pypi//playwright",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",
        "@pypi//pytest_bazel",
    ],
)

skill_package(
    name = "grafana",
    srcs = [
        "SKILL.md",
        "verify_dashboard.py",
    ],
)
