# gazelle:ignore

load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")
load("//skills:defs.bzl", "skill_package")
load(":visual_test.bzl", "grafana_dashboard_visual_test")

package(default_visibility = ["//visibility:public"])

py_binary(
    name = "verify_dashboard",
    srcs = ["verify_dashboard.py"],
    data = [
        "//cluster:generated/monitoring/grafana-instance/grafana-instance.k8s.yaml",
        "//cluster/cdk8s/monitoring:dashboards",
        "@chrome_headless_shell//:executable",
    ],
    env = {
        "CHROMIUM_HEADLESS_SHELL": "$(rootpath @chrome_headless_shell//:executable)",
    },
    main = "verify_dashboard.py",
    deps = [
        "//util/bazel:runfiles",
        "@pypi//httpx",
        "@pypi//playwright",
        "@pypi//pyyaml",
    ],
)

py_test(
    name = "test_verify_dashboard",
    srcs = ["test_verify_dashboard.py"],
    data = ["verify_dashboard.py"],
    deps = [
        "//util/bazel:runfiles",
        "@pypi//httpx",
        "@pypi//playwright",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//pyyaml",
    ],
)

py_library(
    name = "visual_harness",
    testonly = True,
    srcs = ["visual_harness.py"],
    deps = [
        "//third_party/containers:grafana_visual",
        "//third_party/containers:prometheus_visual",
        "//third_party/containers:ryuk",
        "//util:oci",
        "//util/testing:container_logs",
        "//util/testing:undeclared_outputs",
        "@pypi//docker",
        "@pypi//httpx",
        "@pypi//testcontainers",
    ],
)

py_library(
    name = "piraeus_metrics",
    testonly = True,
    srcs = ["piraeus_metrics.py"],
    deps = ["//util/testing:frontend_visual"],
)

grafana_dashboard_visual_test(
    name = "piraeus_dashboard_visual_test",
    src = "test_piraeus_dashboard_visual.py",
    dashboard = "//cluster/cdk8s/monitoring:piraeus_dashboard",
    fixture = ":piraeus_metrics",
)

skill_package(
    name = "grafana",
    srcs = [
        "SKILL.md",
        "verify_dashboard.py",
    ],
)
