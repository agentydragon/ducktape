# gazelle:ignore
# Cluster validation scripts
#
# Two binaries:
#   validate_cluster — kustomizations + helm templates (unified, fast local checks)
#   validate_sealed_secrets — sealed secret decryption (separate, needs terraform state)
#
# Binaries (kustomize, flux, kubeseal, helm, tofu) are managed via rules_multitool.
#
# Usage:
#   bazel run //cluster/scripts/validate_cluster
#   bazel run //cluster/scripts/validate_cluster:validate_sealed_secrets

load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("//tools/testing:defs.bzl", "py_test")

package(default_visibility = [
    "//cluster:__subpackages__",
    "//tools/precommit:__pkg__",
])

# ============================================================================
# Kustomization validation — domain modules
# ============================================================================

py_library(
    name = "k8s",
    srcs = ["k8s.py"],
    imports = ["../../.."],
    deps = [
        "@pypi//pydantic",
        "@pypi//pyyaml",
    ],
)

py_library(
    name = "kustomize",
    srcs = ["kustomize.py"],
    imports = ["../../.."],
    deps = [
        ":k8s",
        "//util/bazel:runfiles",
        "@pypi//pydantic",
        "@pypi//pyyaml",
    ],
)

py_library(
    name = "flux",
    srcs = ["flux.py"],
    imports = ["../../.."],
    deps = [
        ":k8s",
        "//util/bazel:runfiles",
        "@pypi//pydantic",
        "@pypi//pyyaml",
    ],
)

py_library(
    name = "cluster",
    srcs = ["cluster.py"],
    imports = ["../../.."],
    deps = [
        ":flux",
        ":k8s",
        ":kustomize",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "checks",
    srcs = ["checks.py"],
    imports = ["../../.."],
    deps = [
        ":cluster",
        ":flux",
        ":k8s",
        ":kustomize",
    ],
)

py_library(
    name = "dependencies",
    srcs = ["dependencies.py"],
    imports = ["../../.."],
    deps = [
        ":cluster",
        ":flux",
    ],
)

py_library(
    name = "main",
    srcs = ["main.py"],
    imports = ["../../.."],
    deps = [
        ":checks",
        ":cluster",
        ":dependencies",
        ":flux",
        ":helm_templates",
        ":kustomize",
        "//util/bazel:workspace",
    ],
)

py_binary(
    name = "validate_cluster",
    data = [
        "//cluster/terraform/bootstrap/infrastructure:cilium-values.yaml",
        "@multitool//tools/flux",
        "@multitool//tools/helm",
        "@multitool//tools/kustomize",
    ],
    imports = ["../../.."],
    main_module = "cluster.scripts.validate_cluster.main",
    deps = [":main"],
)

# ============================================================================
# Sealed secrets validation (separate binary — different deps/trigger pattern)
# ============================================================================

py_library(
    name = "sealed_secrets",
    srcs = ["sealed_secrets.py"],
    imports = ["../../.."],
    deps = [
        ":cluster",
        "//util/bazel:runfiles",
        "//util/bazel:workspace",
    ],
)

py_binary(
    name = "validate_sealed_secrets",
    data = [
        "@multitool//tools/kubeseal",
        "@multitool//tools/tofu",
    ],
    imports = ["../../.."],
    main_module = "cluster.scripts.validate_cluster.sealed_secrets",
    deps = [":sealed_secrets"],
)

py_library(
    name = "helm_templates",
    srcs = ["helm_templates.py"],
    imports = ["../../.."],
    deps = ["//util/bazel:runfiles"],
)

