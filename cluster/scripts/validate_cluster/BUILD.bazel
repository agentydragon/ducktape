py_test(
    name = "test_dependencies",
    srcs = ["test_dependencies.py"],
    imports = ["../../.."],
    deps = [
        ":dependencies",
        ":flux",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
