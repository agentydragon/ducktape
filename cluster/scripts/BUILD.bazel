# gazelle:ignore
# Cluster utility scripts (non-validation).
# Validators are in //cluster/validation/.

load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

py_test(
    name = "test_seaweedfs_master_persistence_prepare",
    srcs = ["test_seaweedfs_master_persistence_prepare.py"],
    deps = [
        ":seaweedfs_master_persistence",
        "//:conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "seaweedfs_master_canary",
    srcs = ["seaweedfs_master_canary.py"],
    deps = [
        "@pypi//boto3",
        "@pypi//botocore",
        "@pypi//kubernetes",
    ],
)

py_binary(
    name = "seaweedfs_master_canary_bin",
    main_module = "cluster.scripts.seaweedfs_master_canary",
    deps = [":seaweedfs_master_canary"],
)

py_library(
    name = "seaweedfs_master_persistence",
    srcs = ["seaweedfs_master_persistence.py"],
)

py_binary(
    name = "seaweedfs_master_persistence_bin",
    main_module = "cluster.scripts.seaweedfs_master_persistence",
    deps = [":seaweedfs_master_persistence"],
)

# Verify Authentik authentication works end-to-end
py_binary(
    name = "check_authentik_login",
    srcs = ["check_authentik_login.py"],
)

py_binary(
    name = "ovh_hil_availability",
    srcs = ["ovh_hil_availability.py"],
)

# Typed loader for nebula-mesh.json. Shared by render_mobile_nebula_config and
# the validation test in //cluster/validation/.
py_library(
    name = "nebula_mesh",
    srcs = ["nebula_mesh.py"],
    data = ["//:nebula-mesh.json"],
    visibility = ["//cluster:__subpackages__"],
    deps = ["@pypi//pydantic"],
)

py_binary(
    name = "render_mobile_nebula_config",
    srcs = ["render_mobile_nebula_config.py"],
    deps = [
        ":nebula_mesh",
        "@pypi//pyyaml",
    ],
)

py_test(
    name = "test_seaweedfs_master_persistence",
    size = "large",
    srcs = ["test_seaweedfs_master_persistence.py"],
    data = [
        "@seaweed_adminscript_crd//file",
        "@seaweed_bucket_crd//file",
        "@seaweed_bucketlifecyclepolicy_crd//file",
        "@seaweed_operator_role//file",
        "@seaweed_resourcereferencegrant_crd//file",
        "@seaweed_s3credentials_crd//file",
        "@seaweed_s3identity_crd//file",
        "@seaweed_s3oidcprovider_crd//file",
        "@seaweed_s3policy_crd//file",
        "@seaweed_s3policybinding_crd//file",
        "@seaweed_seaweed_crd//file",
        "@seaweed_seaweedbackup_crd//file",
        "@seaweed_seaweedcsidriver_crd//file",
        "@seaweed_seaweedrestore_crd//file",
    ],
    requires_docker = True,
    deps = [
        ":seaweedfs_master_persistence",
        "//util/bazel:runfiles",
        "//util/testing:undeclared_outputs",
        "@pypi//boto3",
        "@pypi//botocore",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//pyyaml",
        "@pypi//testcontainers",
    ],
)
