#!/usr/bin/env bash
set -euo pipefail

# Retrieve provisioned passwords from Kubernetes secrets.

show_secret() {
	local label="$1" ns="$2" secret="$3" key="$4"
	local value
	value=$(kubectl get secret -n "$ns" "$secret" \
		-o jsonpath="{.data.$key}" 2>/dev/null | base64 -d 2>/dev/null || true)
	if [ -n "$value" ] && [ "$value" != "null" ]; then
		printf "%-31s %s\n" "$label:" "$value"
	else
		printf "%-31s %s\n" "$label:" "[Not found]"
	fi
}

echo "=== Authentik Passwords ==="
echo ""
show_secret "Admin (akadmin)" authentik authentik-admin-password AUTHENTIK_BOOTSTRAP_PASSWORD
show_secret "User (agentydragon@gmail.com)" agentydragon agentydragon-user-password user_password

echo ""
echo "=== Atuin (atuin.allegedly.works) ==="
echo ""
show_secret "User (agentydragon)" agentydragon atuin-user-password user_password
echo "  First machine:  atuin login -u agentydragon -p <password>"
echo "  Save key:       cat ~/.local/share/atuin/key"
echo "  Other machines: atuin login -u agentydragon -p <password> -k <key>"

echo ""
echo "=== Props (props.allegedly.works) ==="
echo ""
show_secret "App user (props)" props props-db-app password
show_secret "Evaluator (evaluator)" props props-evaluator-credentials password

echo ""
