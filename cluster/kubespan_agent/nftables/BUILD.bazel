load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")
load("//cluster/kubespan_agent:upstream.bzl", "TALOS_ADAPTERS_NETWORK", "TALOS_CONTROLLERS_NETWORK", "talos_copy")

# Upstream Talos adapter/controller sources pulled at a pinned tag.
# See MODULE.bazel http_archive "talos_internal" for the pinned version.
# Patches in third_party/siderolabs/talos_internal/patches/ are applied at
# fetch time (removes internal adapter import and preCreateIptablesNFTable).

talos_copy(
    name = "upstream_compiler",
    src = TALOS_ADAPTERS_NETWORK + "nftables_rule.go",
    out = "nftables_rule.go",
)

talos_copy(
    name = "upstream_ipset",
    src = TALOS_ADAPTERS_NETWORK + "ipset.go",
    out = "ipset.go",
)

talos_copy(
    name = "upstream_constants",
    src = TALOS_ADAPTERS_NETWORK + "network.go",
    out = "network.go",
)

talos_copy(
    name = "upstream_controller",
    src = TALOS_CONTROLLERS_NETWORK + "nftables_chain.go",
    out = "nftables_chain.go",
)

go_library(
    name = "nftables",
    srcs = [
        ":upstream_compiler",
        ":upstream_constants",
        ":upstream_controller",
        ":upstream_ipset",
    ],
    importpath = "github.com/agentydragon/ducktape/cluster/kubespan_agent/nftables",
    visibility = ["//cluster/kubespan_agent:__subpackages__"],
    deps = [
        "@com_github_cosi_project_runtime//pkg/controller",
        "@com_github_cosi_project_runtime//pkg/safe",
        "@com_github_google_nftables//:nftables",
        "@com_github_google_nftables//binaryutil",
        "@com_github_google_nftables//expr",
        "@com_github_siderolabs_gen//xslices",
        "@com_github_siderolabs_talos_pkg_machinery//constants",
        "@com_github_siderolabs_talos_pkg_machinery//nethelpers",
        "@com_github_siderolabs_talos_pkg_machinery//resources/network",
        "@org_go4_netipx//:netipx",
        "@org_golang_x_sys//unix",
        "@org_uber_go_zap//:zap",
    ],
)

go_test(
    name = "nftables_test",
    srcs = ["compiler_test.go"],
    embed = [":nftables"],
    deps = [
        "@com_github_google_nftables//expr",
        "@com_github_siderolabs_talos_pkg_machinery//nethelpers",
        "@com_github_siderolabs_talos_pkg_machinery//resources/network",
    ],
)
