load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

# Upstream Talos source files pulled at a pinned tag and transformed into our package.
# See MODULE.bazel http_archive "talos_internal" for the pinned version.

_TALOS_ADAPTERS = "@talos_internal//:internal/app/machined/pkg/adapters/network/"

_TALOS_CONTROLLERS = "@talos_internal//:internal/app/machined/pkg/controllers/network/"

genrule(
    name = "upstream_compiler",
    srcs = [_TALOS_ADAPTERS + "nftables_rule.go"],
    outs = ["compiler_upstream.go"],
    cmd = "sed 's/^package network$$/package nftables/' $< > $@",
)

genrule(
    name = "upstream_ipset",
    srcs = [_TALOS_ADAPTERS + "ipset.go"],
    outs = ["ipset_upstream.go"],
    cmd = "sed 's/^package network$$/package nftables/' $< > $@",
)

genrule(
    name = "upstream_constants",
    srcs = [_TALOS_ADAPTERS + "network.go"],
    outs = ["constants_upstream.go"],
    cmd = "sed 's/^package network$$/package nftables/' $< > $@",
)

# The controller needs more transformations than a simple sed (remove Talos-internal
# adapter import, remove preCreateIptablesNFTable, rename controller type), so we
# use an awk script for the transformation.
genrule(
    name = "upstream_controller",
    srcs = [_TALOS_CONTROLLERS + "nftables_chain.go"],
    outs = ["controller_upstream.go"],
    cmd = "awk -f $(location :transform_controller.awk) $< > $@",
    tools = [":transform_controller.awk"],
)

go_library(
    name = "nftables",
    srcs = [
        # All generated from upstream Talos sources:
        ":upstream_compiler",
        ":upstream_constants",
        ":upstream_controller",
        ":upstream_ipset",
    ],
    importpath = "github.com/agentydragon/ducktape/cluster/kubespan_agent/nftables",
    visibility = ["//cluster/kubespan_agent:__subpackages__"],
    deps = [
        "@com_github_cosi_project_runtime//pkg/controller",
        "@com_github_cosi_project_runtime//pkg/safe",
        "@com_github_google_nftables//:nftables",
        "@com_github_google_nftables//binaryutil",
        "@com_github_google_nftables//expr",
        "@com_github_siderolabs_gen//xslices",
        "@com_github_siderolabs_talos_pkg_machinery//constants",
        "@com_github_siderolabs_talos_pkg_machinery//nethelpers",
        "@com_github_siderolabs_talos_pkg_machinery//resources/network",
        "@org_go4_netipx//:netipx",
        "@org_golang_x_sys//unix",
        "@org_uber_go_zap//:zap",
    ],
)

go_test(
    name = "nftables_test",
    srcs = ["compiler_test.go"],
    embed = [":nftables"],
    deps = [
        "@com_github_google_nftables//expr",
        "@com_github_siderolabs_talos_pkg_machinery//nethelpers",
        "@com_github_siderolabs_talos_pkg_machinery//resources/network",
    ],
)
