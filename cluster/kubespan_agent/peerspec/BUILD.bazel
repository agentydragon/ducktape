load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//cluster/kubespan_agent:upstream.bzl", "TALOS_CONTROLLERS_KUBESPAN", "talos_copy")

# Upstream Talos peer spec controller pulled at a pinned tag and patched.
# See MODULE.bazel http_archive "talos_internal" for the pinned version.
# Patches in third_party/siderolabs/talos_internal/patches/ are applied at
# fetch time (adapts cluster.Identity → kubespan.Identity, injects endpoint
# filtering, replaces affiliate self-check with PublicKey self-check).

talos_copy(
    name = "upstream_peer_spec",
    src = TALOS_CONTROLLERS_KUBESPAN + "peer_spec.go",
    out = "peer_spec.go",
)

go_library(
    name = "peerspec",
    srcs = [
        "peer_spec_filters.go",
        ":upstream_peer_spec",
    ],
    importpath = "github.com/agentydragon/ducktape/cluster/kubespan_agent/peerspec",
    visibility = ["//cluster/kubespan_agent:__subpackages__"],
    deps = [
        "@com_github_cosi_project_runtime//pkg/controller",
        "@com_github_cosi_project_runtime//pkg/resource",
        "@com_github_cosi_project_runtime//pkg/safe",
        "@com_github_cosi_project_runtime//pkg/state",
        "@com_github_siderolabs_gen//optional",
        "@com_github_siderolabs_talos_pkg_machinery//resources/cluster",
        "@com_github_siderolabs_talos_pkg_machinery//resources/config",
        "@com_github_siderolabs_talos_pkg_machinery//resources/kubespan",
        "@org_go4_netipx//:netipx",
        "@org_uber_go_zap//:zap",
    ],
)
