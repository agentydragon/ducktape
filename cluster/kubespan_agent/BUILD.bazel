load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

go_library(
    name = "kubespan_agent_lib",
    srcs = [
        "controller_discovery.go",
        "controller_identity.go",
        "controller_manager.go",
        "main.go",
    ],
    importpath = "github.com/agentydragon/ducktape/cluster/kubespan_agent",
    visibility = ["//visibility:private"],
    deps = [
        "//cluster/kubespan_agent/config",
        "//cluster/kubespan_agent/discovery",
        "//cluster/kubespan_agent/identity",
        "//cluster/kubespan_agent/peerstate",
        "//cluster/kubespan_agent/resources",
        "//cluster/kubespan_agent/routing",
        "//cluster/kubespan_agent/wireguard",
        "@com_github_cosi_project_runtime//pkg/controller",
        "@com_github_cosi_project_runtime//pkg/controller/runtime",
        "@com_github_cosi_project_runtime//pkg/resource",
        "@com_github_cosi_project_runtime//pkg/safe",
        "@com_github_cosi_project_runtime//pkg/state",
        "@com_github_cosi_project_runtime//pkg/state/impl/inmem",
        "@com_github_cosi_project_runtime//pkg/state/impl/namespaced",
        "@com_github_siderolabs_talos_pkg_machinery//constants",
        "@com_github_siderolabs_talos_pkg_machinery//resources/kubespan",
        "@org_uber_go_zap//:zap",
    ],
)

go_binary(
    name = "kubespand",
    embed = [":kubespan_agent_lib"],
    goarch = "amd64",
    goos = "linux",
    static = "on",
    visibility = ["//visibility:public"],
)

go_test(
    name = "e2e_test",
    srcs = ["e2e_test.go"],
    data = [
        ":kubespand_tarball",
        "//third_party/siderolabs:discovery_service_tarball",
        "//third_party/siderolabs:talos_v1_9_5_tarball",
    ],
    embed = [":kubespan_agent_lib"],
    tags = ["requires_docker"],
    deps = [
        "//cluster/kubespan_agent/config",
        "@com_github_fsouza_go_dockerclient//:go-dockerclient",
        "@in_gopkg_yaml_v3//:yaml_v3",
    ],
)

pkg_tar(
    name = "kubespand_layer",
    testonly = True,
    srcs = [":kubespand"],
    package_dir = "/",
)

oci_image(
    name = "kubespand_image",
    testonly = True,
    base = "@debian_slim_linux_amd64",
    entrypoint = ["/kubespand"],
    tars = [":kubespand_layer"],
    visibility = ["//visibility:public"],
)

oci_load(
    name = "kubespand_load",
    testonly = True,
    image = ":kubespand_image",
    repo_tags = ["kubespand:latest"],
)

filegroup(
    name = "kubespand_tarball",
    testonly = True,
    srcs = [":kubespand_load"],
    output_group = "tarball",
    visibility = ["//visibility:public"],
)
