load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//cluster/kubespan_agent:upstream.bzl", "TALOS_CONTROLLERS_KUBESPAN", "talos_copy")

# Upstream Talos endpoint controller pulled at a pinned tag.
# See MODULE.bazel http_archive "talos_internal" for the pinned version.

talos_copy(
    name = "upstream_endpoint",
    src = TALOS_CONTROLLERS_KUBESPAN + "endpoint.go",
    out = "endpoint.go",
)

go_library(
    name = "endpoint",
    srcs = [":upstream_endpoint"],
    importpath = "github.com/agentydragon/ducktape/cluster/kubespan_agent/endpoint",
    visibility = ["//cluster/kubespan_agent:__subpackages__"],
    deps = [
        "@com_github_cosi_project_runtime//pkg/controller",
        "@com_github_cosi_project_runtime//pkg/safe",
        "@com_github_cosi_project_runtime//pkg/state",
        "@com_github_siderolabs_gen//optional",
        "@com_github_siderolabs_gen//value",
        "@com_github_siderolabs_talos_pkg_machinery//resources/cluster",
        "@com_github_siderolabs_talos_pkg_machinery//resources/config",
        "@com_github_siderolabs_talos_pkg_machinery//resources/kubespan",
        "@org_uber_go_zap//:zap",
    ],
)
