load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

py_library(
    name = "generate",
    srcs = ["generate.py"],
    deps = [
        "//util/bazel:workspace",
        "@pypi//pyyaml",
    ],
)

py_binary(
    name = "generate_bin",
    main_module = "cluster.ssh_targets.generate",
    deps = [":generate"],
)

py_test(
    name = "test_generate",
    srcs = ["test_generate.py"],
    data = [
        "//cluster/k8s:agents/public-coder-agent/devbox/service.yaml",
        "//cluster/k8s:agents/public-coder-agent/sshpiper/pipe-devbox.yaml",
        "//cluster/k8s:ssh-mcp/known_hosts",
        "//cluster/k8s:ssh-mcp/settings.yaml",
        "//ssh_keys:public-coder-agent-devbox.pub",
        "//ssh_keys:public-coder-devbox-host.pub",
    ],
    deps = [
        ":generate",
        "//:conftest",
        "//util/bazel:runfiles",
        "@pypi//pytest_bazel",
    ],
)
