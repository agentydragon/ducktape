load("@io_bazel_rules_go//proto:def.bzl", "go_proto_library")
load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("//devinfra/python:defs.bzl", "py_library", "py_test")
load("//devinfra/python:grpc.bzl", "py_grpc_service_library")
load("//devinfra/python:proto.bzl", "py_proto_library_with_mypy_stubs")

# gazelle:resolve py platform_sessions.provider.session_provider_pb2 //platform_sessions/provider:session_provider_pb2
# gazelle:resolve py platform_sessions.provider.session_provider_pb2_grpc //platform_sessions/provider:session_provider_pb2_grpc

package(default_visibility = ["//visibility:public"])

py_library(
    name = "results",
    srcs = ["results.py"],
    deps = ["//platform_sessions:probe"],
)

py_library(
    name = "probe_support",
    srcs = ["probe_support.py"],
    deps = [
        "//platform_sessions:probe_types",
        "//platform_sessions/provider:session_provider_pb2",
        "@pypi//protobuf",  # keep: mypy follows generated protobuf interfaces
        "@pypi//types_protobuf",  # keep: mypy follows generated protobuf interfaces
    ],
)

py_test(
    name = "probe_support_test",
    srcs = ["probe_support_test.py"],
    data = [
        "testdata/probe_outcome_examples.json",
        "testdata/probe_source_examples.json",
    ],
    deps = [
        ":probe_support",
        "//:conftest",
        "//platform_sessions:probe_types",
        "//platform_sessions/provider:session_provider_pb2",
        "@pypi//protobuf",  # keep: mypy follows generated protobuf interfaces
        "@pypi//pytest",
        "@pypi//types_protobuf",  # keep: mypy follows generated protobuf interfaces
        "@rules_python//python/runfiles",
    ],
)

py_library(
    name = "control_auth",
    srcs = ["control_auth.py"],
    deps = ["@pypi//grpcio"],
)

py_library(
    name = "control_server",
    srcs = ["control_server.py"],
    deps = [
        ":control_auth",
        "@pypi//grpcio",
    ],
)

py_test(
    name = "control_auth_test",
    srcs = ["control_auth_test.py"],
    deps = [
        ":control_auth",
        "//:conftest",
        "@pypi//grpcio",
        "@pypi//pytest",
    ],
)

py_test(
    name = "control_server_test",
    srcs = ["control_server_test.py"],
    deps = [
        ":control_server",
        "//:conftest",
        "@pypi//cryptography",
        "@pypi//grpcio",
        "@pypi//pytest",
    ],
)

proto_library(
    name = "session_provider_proto",
    srcs = ["session_provider.proto"],
    deps = [
        "@protobuf//:duration_proto",
        "@protobuf//:empty_proto",
        "@protobuf//:timestamp_proto",
    ],
)

go_proto_library(
    name = "session_provider_go_proto",
    compilers = [
        "@io_bazel_rules_go//proto:go_proto",
        "@io_bazel_rules_go//proto:go_grpc_v2",
    ],
    importpath = "github.com/agentydragon/ducktape/platform_sessions/provider/providerpb",
    proto = ":session_provider_proto",
)

py_proto_library_with_mypy_stubs(
    name = "session_provider_pb2",
    deps = [
        ":session_provider_proto",
        "@protobuf//:duration_proto",
        "@protobuf//:empty_proto",
        "@protobuf//:timestamp_proto",
    ],
)

py_grpc_service_library(
    name = "session_provider_pb2_grpc",
    async_only = True,
    proto = ":session_provider_proto",
    py_proto = ":session_provider_pb2",
)

py_library(
    name = "validation",
    srcs = ["validation.py"],
    deps = [
        "//platform_sessions:routes",
        "//platform_sessions/provider:session_provider_pb2",
        "@pypi//protobuf",
    ],
)

py_library(
    name = "server",
    srcs = ["server.py"],
    deps = [
        ":instance_ownership",
        ":validation",
        "//platform_sessions:limits",
        "//platform_sessions/provider:session_provider_pb2",
        "//platform_sessions/provider:session_provider_pb2_grpc",
        "@pypi//grpcio",
        "@pypi//protobuf",  # keep: mypy follows generated protobuf interfaces
        "@pypi//types_protobuf",  # keep: mypy follows generated protobuf interfaces
    ],
)

py_library(
    name = "provider_runtime",
    srcs = ["provider_runtime.py"],
    deps = [
        ":instance_ownership",
        ":server",
    ],
)

py_test(
    name = "server_test",
    srcs = ["server_test.py"],
    data = ["//platform_sessions:protocol_validation_examples"],
    deps = [
        ":instance_ownership",
        ":server",
        ":validation",
        "//:conftest",
        "//platform_sessions:limits",
        "//platform_sessions/provider:session_provider_pb2",
        "//platform_sessions/provider:session_provider_pb2_grpc",
        "@pypi//filelock",
        "@pypi//grpcio",
        "@pypi//protobuf",  # keep: mypy follows generated protobuf interfaces
        "@pypi//pytest",
        "@pypi//types_protobuf",  # keep: mypy follows generated protobuf interfaces
        "@rules_python//python/runfiles",
    ],
)

