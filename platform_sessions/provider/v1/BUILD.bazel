load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("//devinfra/python:grpc.bzl", "py_grpc_service_library")
load("//devinfra/python:proto.bzl", "py_proto_library_with_mypy_stubs")

package(default_visibility = ["//visibility:public"])

proto_library(
    name = "session_provider_proto",
    srcs = ["session_provider.proto"],
    deps = [
        "@protobuf//:duration_proto",
        "@protobuf//:timestamp_proto",
    ],
)

py_proto_library_with_mypy_stubs(
    name = "session_provider_pb2",
    deps = [":session_provider_proto"],
)

py_grpc_service_library(
    name = "session_provider_pb2_grpc",
    async_only = True,
    proto = ":session_provider_proto",
    py_proto = ":session_provider_pb2",
)
