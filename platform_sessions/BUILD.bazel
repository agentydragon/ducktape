load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "registry",
    srcs = ["registry.py"],
    deps = ["@pypi//pydantic"],
)

py_test(
    name = "registry_test",
    srcs = ["registry_test.py"],
    deps = [
        ":registry",
        "//:conftest",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "routes",
    srcs = ["routes.py"],
    deps = [":registry"],
)

py_test(
    name = "routes_test",
    srcs = ["routes_test.py"],
    deps = [
        ":routes",
        "//:conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "service",
    srcs = ["service.py"],
    data = ["//platform_sessions/frontend:assets"],
    deps = [
        ":registry",
        "@pypi//fastapi",
    ],
)

py_test(
    name = "service_test",
    srcs = ["service_test.py"],
    deps = [
        ":registry",
        ":service",
        "//:conftest",
        "@pypi//fastapi",
        "@pypi//httpx",  # keep: fastapi.testclient requires httpx at runtime
        "@pypi//pydantic",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "proxy",
    srcs = ["proxy.py"],
    deps = [
        ":registry",
        ":routes",
        "@pypi//fastapi",
        "@pypi//pydantic",
        "@pypi//starlette",
    ],
)

py_test(
    name = "proxy_test",
    srcs = ["proxy_test.py"],
    deps = [
        ":proxy",
        ":registry",
        ":routes",
        ":service",
        "//:conftest",
        "@pypi//fastapi",
        "@pypi//httpx",  # keep: fastapi.testclient requires httpx at runtime
        "@pypi//pydantic",
        "@pypi//pytest_bazel",
    ],
)
