load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "registry",
    srcs = ["registry.py"],
    deps = ["@pypi//pydantic"],
)

py_test(
    name = "registry_test",
    srcs = ["registry_test.py"],
    deps = [
        ":registry",
        "//:conftest",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_library(
    name = "routes",
    srcs = ["routes.py"],
    deps = [":registry"],
)

py_test(
    name = "routes_test",
    srcs = ["routes_test.py"],
    deps = [
        ":routes",
        "//:conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
