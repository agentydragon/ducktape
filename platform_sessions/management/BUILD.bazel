# gazelle:resolve py platform_sessions.management.v1.management_pb2_grpc //platform_sessions/management/v1:management_pb2_grpc

package(default_visibility = ["//visibility:public"])

py_library(
    name = "service",
    srcs = ["service.py"],
    deps = [
        "//platform_sessions:limits",
        "//platform_sessions/management/v1:management_pb2",
        "//platform_sessions/management/v1:management_pb2_grpc",
        "//platform_sessions/provider:control_client",
        "//platform_sessions/provider/v1:session_provider_pb2",
        "@pypi//grpcio",
        "@pypi//protobuf",
    ],
)

py_library(
    name = "server",
    srcs = ["server.py"],
    deps = [
        ":service",
        "//platform_sessions/management/v1:management_pb2_grpc",
        "//platform_sessions/provider:control_auth",
        "//platform_sessions/provider:control_client",
        "@pypi//grpcio",
        "@pypi//protobuf",  # keep: mypy follows generated protobuf interfaces
        "@pypi//types_protobuf",  # keep: mypy follows generated protobuf interfaces
    ],
)

py_library(
    name = "http",
    srcs = ["http.py"],
    deps = [
        "//platform_sessions:auth",
        "//platform_sessions:host",
        "//platform_sessions:limits",
        "@pypi//fastapi",
        "@pypi//httpx",
    ],
)

py_test(
    name = "service_test",
    srcs = ["service_test.py"],
    deps = [
        ":server",
        ":service",
        "//:conftest",
        "//platform_sessions/management/v1:management_pb2",
        "//platform_sessions/management/v1:management_pb2_grpc",
        "//platform_sessions/provider:control_client",
        "//platform_sessions/provider/v1:session_provider_pb2",
        "@pypi//grpcio",
        "@pypi//protobuf",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "http_test",
    srcs = ["http_test.py"],
    data = ["//platform_sessions/management/facade/cmd:management_facade"],
    env = {"MANAGEMENT_FACADE_RLOCATION": "$(rlocationpath //platform_sessions/management/facade/cmd:management_facade)"},
    deps = [
        ":http",
        ":server",
        "//:conftest",
        "//platform_sessions:auth",
        "//platform_sessions/provider:control_client",
        "//platform_sessions/provider/v1:session_provider_pb2",
        "@pypi//fastapi",
        "@pypi//httpx",
        "@pypi//protobuf",  # keep: mypy follows generated protobuf interfaces
        "@pypi//pytest_bazel",
        "@pypi//types_protobuf",  # keep: mypy follows generated protobuf interfaces
        "@rules_python//python/runfiles",
    ],
)
