load("@io_bazel_rules_go//proto:def.bzl", "go_proto_library")
load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("//devinfra/go:proto_openapi.bzl", "proto_openapi")

package(default_visibility = ["//visibility:public"])

proto_library(
    name = "management_proto",
    srcs = ["management.proto"],
    deps = [
        "//platform_sessions/provider:session_provider_proto",
        "@googleapis//google/api:annotations_proto",
        "@protobuf//:empty_proto",
    ],
)

go_proto_library(
    name = "management_go_proto",
    compilers = [
        "@io_bazel_rules_go//proto:go_proto",
        "@io_bazel_rules_go//proto:go_grpc_v2",
        "//devinfra/go:grpc_gateway",
    ],
    importpath = "github.com/agentydragon/ducktape/platform_sessions/management/managementpb",
    proto = ":management_proto",
    deps = [
        "//platform_sessions/provider:session_provider_go_proto",
        "@org_golang_google_genproto_googleapis_api//annotations",
    ],
)

proto_openapi(
    name = "management_openapi",
    proto = ":management_proto",
)
