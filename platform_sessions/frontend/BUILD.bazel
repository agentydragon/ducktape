load("@aspect_rules_js//js:defs.bzl", "js_test")
load("@io_bazel_rules_go//go:def.bzl", "go_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "assets",
    srcs = [
        "status.css",
        "status.html",
        "status.js",
    ],
)

js_test(
    name = "status_test",
    data = [":assets"],
    entry_point = "status_test.mjs",
)

go_library(
    name = "frontend",
    srcs = ["assets.go"],
    embedsrcs = [
        "status.css",
        "status.html",
        "status.js",
    ],
    importpath = "github.com/agentydragon/ducktape/platform_sessions/frontend",
)
