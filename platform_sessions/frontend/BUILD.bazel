load("@aspect_rules_ts//ts:defs.bzl", "ts_config")
load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//devinfra/js:spa_bundle.bzl", "spa_bundle")
load("//devinfra/js:ts_library.bzl", "ts_library")
load("//devinfra/python:defs.bzl", "py_test")

package(default_visibility = ["//visibility:public"])

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
)

ts_library(
    name = "main",
    srcs = ["main.tsx"],
    tsconfig = ":tsconfig",
    deps = [
        "//:node_modules/@mantine/core",
        "//:node_modules/@types/react",
        "//:node_modules/@types/react-dom",
        "//:node_modules/react",
        "//:node_modules/react-dom",
    ],
)

spa_bundle(
    name = "bundle",
    entry_point = "main.js",
    index_html = "status.html",
    jsx = "automatic",
    deps = [":main"],
)

py_test(
    name = "browser_test",
    srcs = ["browser_test.py"],
    data = [":bundle"],
    tags = ["visual"],
    deps = [
        "//:conftest",
        "//devinfra/testing:output_writer",
        "//util:playwright",  # keep: pytest plugin
        "//util/testing:asgi",
        "//util/testing/frontend_visual:capture",
        "//util/testing/frontend_visual:context",
        "@pypi//fastapi",
        "@pypi//playwright",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",  # keep: pytest async plugin
        "@pypi//pytest_bazel",
        "@rules_python//python/runfiles",
    ],
)

go_library(
    name = "frontend",
    srcs = ["assets.go"],
    importpath = "github.com/agentydragon/ducktape/platform_sessions/frontend",
)
