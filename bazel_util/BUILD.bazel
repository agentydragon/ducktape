"""Bazel integration utilities: subprocess helpers, runfiles, workspace detection."""

load("@rules_python//python:defs.bzl", "py_library")
load("//tools/testing:defs.bzl", "py_test")

py_library(
    name = "subprocess",
    srcs = ["subprocess.py"],
    visibility = ["//visibility:public"],
)

py_library(
    name = "workspace",
    srcs = ["workspace.py"],
    visibility = ["//visibility:public"],
)

py_library(
    name = "runfiles",
    srcs = ["runfiles.py"],
    visibility = ["//visibility:public"],
    deps = ["@rules_python//python/runfiles"],
)

py_test(
    name = "test_subprocess",
    srcs = ["test_subprocess.py"],
    deps = [
        ":subprocess",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)
