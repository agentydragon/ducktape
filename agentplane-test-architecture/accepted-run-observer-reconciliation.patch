+type remoteRunTestClient struct {
+	bbspb.BuildBuddyServiceClient
+
+	logs *scriptedBuildBuddyClient
+
+	runCalls                         int
+	cancelCalls                      int
+	getInvocationCalls               int
+	getInvocationErr                 error
+	getInvocationBeforeExecutionDone bool
+	getExecutionInvocationID         string
+	getExecutionResponse             *espb.GetExecutionResponse
+	getExecutionErr                  error
+	executionDone                    bool
+}
+
+func (c *remoteRunTestClient) Run(context.Context, *rnpb.RunRequest, ...grpc.CallOption) (*rnpb.RunResponse, error) {
+	c.runCalls++
+	return &rnpb.RunResponse{InvocationId: "runner-invocation"}, nil
+}
+
+func (c *remoteRunTestClient) GetEventLog(ctx context.Context, req *elpb.GetEventLogChunkRequest, opts ...grpc.CallOption) (bbspb.BuildBuddyService_GetEventLogClient, error) {
+	return c.logs.GetEventLog(ctx, req, opts...)
+}
+
+func (c *remoteRunTestClient) GetInvocation(_ context.Context, req *inpb.GetInvocationRequest, _ ...grpc.CallOption) (*inpb.GetInvocationResponse, error) {
+	c.getInvocationCalls++
+	if c.getInvocationErr != nil {
+		return nil, c.getInvocationErr
+	}
+	if !c.executionDone {
+		c.getInvocationBeforeExecutionDone = true
+	}
+	return &inpb.GetInvocationResponse{Invocation: []*inpb.Invocation{{
+		InvocationId: req.GetLookup().GetInvocationId(),
+		Success:      c.executionDone,
+	}}}, nil
+}
+
+func (c *remoteRunTestClient) GetExecution(_ context.Context, req *espb.GetExecutionRequest, _ ...grpc.CallOption) (*espb.GetExecutionResponse, error) {
+	c.getExecutionInvocationID = req.GetExecutionLookup().GetInvocationId()
+	if c.getExecutionErr != nil {
+		return nil, c.getExecutionErr
+	}
+	return c.getExecutionResponse, nil
+}
+
+func (c *remoteRunTestClient) CancelExecutions(context.Context, *inpb.CancelExecutionsRequest, ...grpc.CallOption) (*inpb.CancelExecutionsResponse, error) {
+	c.cancelCalls++
+	return &inpb.CancelExecutionsResponse{}, nil
+}
+
+type scriptedWaitExecutionClient struct {
+	repb.ExecutionClient
+
+	response      *repb.ExecuteResponse
+	err           error
+	requestedName string
+	onTerminal    func()
+}
+
+func (c *scriptedWaitExecutionClient) WaitExecution(_ context.Context, req *repb.WaitExecutionRequest, _ ...grpc.CallOption) (repb.Execution_WaitExecutionClient, error) {
+	c.requestedName = req.GetName()
+	if c.err != nil {
+		return nil, c.err
+	}
+	operation := &longrunningpb.Operation{Name: req.GetName(), Done: true}
+	if c.response != nil {
+		packedResponse, err := anypb.New(c.response)
+		if err != nil {
+			return nil, err
+		}
+		operation.Result = &longrunningpb.Operation_Response{Response: packedResponse}
+	}
+	return &scriptedWaitExecutionStream{
+		operation:  operation,
+		onTerminal: c.onTerminal,
+	}, nil
+}
+
+type scriptedWaitExecutionStream struct {
+	grpc.ClientStream
+
+	operation  *longrunningpb.Operation
+	onTerminal func()
+}
+
+func (s *scriptedWaitExecutionStream) Recv() (*longrunningpb.Operation, error) {
+	if s.onTerminal != nil {
+		s.onTerminal()
+	}
+	return s.operation, nil
+}
+
+func newRemoteRunTestClient(logErr error) *remoteRunTestClient {
+	var logScript []scriptedRecv
+	if logErr != nil {
+		logScript = []scriptedRecv{{err: logErr}}
+	}
+	return &remoteRunTestClient{
+		logs:                 &scriptedBuildBuddyClient{script: logScript},
+		getExecutionResponse: &espb.GetExecutionResponse{Execution: []*espb.Execution{{ExecutionId: "runner-execution"}}},
+	}
+}
+
+func newScriptedWaitExecutionClient(client *remoteRunTestClient, exitCode int32) *scriptedWaitExecutionClient {
+	return &scriptedWaitExecutionClient{
+		response: &repb.ExecuteResponse{Result: &repb.ActionResult{ExitCode: exitCode}},
+		onTerminal: func() {
+			client.executionDone = true
+		},
+	}
+}
