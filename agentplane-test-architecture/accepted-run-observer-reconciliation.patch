+func TestAttemptRun_NormalLogCompletionWaitFailureDoesNotRetryAcceptedRun(t *testing.T) {
+	ctx := context.Background()
+	client := newRemoteRunTestClient(nil)
+	execClient := &scriptedWaitExecutionClient{err: status.InternalError("execution result unavailable")}
+	require.True(t, shouldRetryRemoteRun(ctx, execClient.err), "the same transient error is retryable before Run accepts an invocation")
+
+	inRsp, execRsp, err := attemptRun(ctx, client, execClient, &rnpb.RunRequest{})
+
+	require.ErrorIs(t, err, errAcceptedRunOutcomeUnknown)
+	require.Nil(t, inRsp)
+	require.Nil(t, execRsp)
+	require.False(t, shouldRetryRemoteRun(ctx, err), "a result-read failure after Run acceptance must not resubmit the invocation")
+	require.Equal(t, 1, client.runCalls)
+	require.Equal(t, 1, client.getInvocationCalls, "the normal logs-complete path still reads invocation metadata")
+	require.Zero(t, client.cancelCalls, "an observer-side result-read failure is not user cancellation")
+}
