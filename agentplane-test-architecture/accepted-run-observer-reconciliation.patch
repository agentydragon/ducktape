+func TestAttemptRun_ReconcilesAcceptedRunAfterLogObserverError(t *testing.T) {
+	ctx := context.Background()
+	client := newRemoteRunTestClient(status.InternalError("RST_STREAM INTERNAL_ERROR"))
+	execClient := newScriptedWaitExecutionClient(client, 0)
+
+	inRsp, execRsp, err := attemptRun(ctx, client, execClient, &rnpb.RunRequest{})
+
+	require.NoError(t, err)
+	require.Equal(t, 1, client.runCalls, "the accepted runner must not be resubmitted")
+	require.Zero(t, client.cancelCalls, "log observation failure must not cancel accepted work")
+	require.Equal(t, "runner-invocation", client.getExecutionInvocationID)
+	require.Equal(t, "runner-execution", execClient.requestedName, "reconciliation must wait for the execution attached to the accepted invocation")
+	require.Equal(t, 1, client.getInvocationCalls)
+	require.False(t, client.getInvocationBeforeExecutionDone, "fallback metadata must be fetched after terminal execution")
+	require.Equal(t, "runner-invocation", inRsp.GetInvocation()[0].GetInvocationId())
+	require.True(t, inRsp.GetInvocation()[0].GetSuccess())
+	require.EqualValues(t, 0, execRsp.GetResult().GetExitCode())
+}
+
+func TestAttemptRun_PreservesRemoteFailureAfterLogObserverError(t *testing.T) {
+	ctx := context.Background()
+	client := newRemoteRunTestClient(status.InternalError("RST_STREAM INTERNAL_ERROR"))
+	execClient := newScriptedWaitExecutionClient(client, 1)
+
+	_, execRsp, err := attemptRun(ctx, client, execClient, &rnpb.RunRequest{})
+
+	require.NoError(t, err)
+	require.EqualValues(t, 1, execRsp.GetResult().GetExitCode(), "the caller must retain the real nonzero remote exit code")
+	require.Equal(t, 1, client.runCalls)
+	require.Zero(t, client.cancelCalls)
+}
+
+func TestAttemptRun_UnknownResultAfterLogObserverErrorDoesNotRetryOrCancel(t *testing.T) {
+	ctx := context.Background()
+	client := newRemoteRunTestClient(status.InternalError("RST_STREAM INTERNAL_ERROR"))
+	execClient := &scriptedWaitExecutionClient{err: status.InternalError("execution result unavailable")}
+
+	inRsp, execRsp, err := attemptRun(ctx, client, execClient, &rnpb.RunRequest{})
+
+	require.ErrorIs(t, err, errAcceptedRunOutcomeUnknown)
+	require.Nil(t, inRsp)
+	require.Nil(t, execRsp)
+	require.False(t, shouldRetryRemoteRun(ctx, err), "an accepted run with unknown outcome must never be resubmitted")
+	require.Equal(t, 1, client.runCalls)
+	require.Zero(t, client.cancelCalls, "failure to observe the result is not user cancellation")
+}
