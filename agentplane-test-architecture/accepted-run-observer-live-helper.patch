+func TestPassedContractRequiresSuccessfulTerminalStatus(t *testing.T) {
+	exitCode := int32(expectedRemoteExitCode)
+	cliExitCode := expectedRemoteExitCode
+	base := report{
+		RunAttempts:                  1,
+		RunForwardAttempts:           1,
+		RunForwardSucceeded:          1,
+		AcceptedInvocationID:         "accepted-iid",
+		LogStreamAttempts:            1,
+		LogStreamMatched:             1,
+		LogStreamForwardAttempts:     1,
+		LogChunksReceivedUpstream:    1,
+		LogChunksForwarded:           1,
+		ObserverErrorsInjected:       1,
+		ExecutionIDs:                 []string{"execution-id"},
+		GetExecutionAttempts:         1,
+		GetExecutionForwardAttempts:  1,
+		WaitExecutionStreams:         1,
+		WaitExecutionForwardAttempts: 1,
+		WaitExecutionNames:           []string{"execution-id"},
+		TerminalOperations:           1,
+		TerminalResultUnpackOK:       true,
+		TerminalResultStatusCode:     0,
+		RemoteExitCode:               &exitCode,
+		GetInvocationForwardAttempts: 1,
+		GetInvocationAfterTerminal:   1,
+		CLIExitCode:                  &cliExitCode,
+		CLIInvocationIDMatches:       true,
+	}
+	if !(&probe{report: base}).passedContract() {
+		t.Fatal("valid terminal result should satisfy probe contract")
+	}
+	base.TerminalResultStatusCode = 13
+	if (&probe{report: base}).passedContract() {
+		t.Fatal("non-OK terminal status must fail the probe contract")
+	}
+}
+
+func TestProxyServiceDescriptorsRejectUnmatchedCallsWithoutForwarding(t *testing.T) {
+	p := &probe{runName: "remote run", script: "safe nonce script", state: &state{}}
+	server := grpc.NewServer()
+	server.RegisterService(&buildBuddyServiceDesc, p)
+	server.RegisterService(&executionServiceDesc, p)
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	serveDone := make(chan error, 1)
+	go func() { serveDone <- server.Serve(listener) }()
+	t.Cleanup(func() {
+		server.Stop()
+		<-serveDone
+		_ = listener.Close()
+	})
+
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	t.Cleanup(cancel)
+	conn, err := grpc.DialContext(ctx, listener.Addr().String(), grpc.WithTransportCredentials(insecure.NewCredentials()), grpc.WithBlock())
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = conn.Close() })
+
+	bbClient := bbspb.NewBuildBuddyServiceClient(conn)
+	logStream, err := bbClient.GetEventLog(ctx, &elpb.GetEventLogChunkRequest{InvocationId: "unmatched"})
+	if err == nil {
+		_, err = logStream.Recv()
+	}
+	if status.Code(err) != codes.FailedPrecondition {
+		t.Fatalf("GetEventLog error code = %s, want %s", status.Code(err), codes.FailedPrecondition)
+	}
+	if _, err := bbClient.CancelExecutions(ctx, &inpb.CancelExecutionsRequest{InvocationId: "unmatched"}); status.Code(err) != codes.FailedPrecondition {
+		t.Fatalf("CancelExecutions error code = %s, want %s", status.Code(err), codes.FailedPrecondition)
+	}
+	if _, err := bbClient.GetExecution(ctx, &espb.GetExecutionRequest{ExecutionLookup: &espb.ExecutionLookup{InvocationId: "unmatched"}}); status.Code(err) != codes.FailedPrecondition {
+		t.Fatalf("GetExecution error code = %s, want %s", status.Code(err), codes.FailedPrecondition)
+	}
+	if _, err := bbClient.GetInvocation(ctx, &inpb.GetInvocationRequest{Lookup: &inpb.InvocationLookup{InvocationId: "unmatched"}}); status.Code(err) != codes.FailedPrecondition {
+		t.Fatalf("GetInvocation error code = %s, want %s", status.Code(err), codes.FailedPrecondition)
+	}
+	if _, err := bbClient.Run(ctx, &rnpb.RunRequest{Name: "wrong run"}); status.Code(err) != codes.PermissionDenied {
+		t.Fatalf("Run error code = %s, want %s", status.Code(err), codes.PermissionDenied)
+	}
+
+	waitStream, err := repb.NewExecutionClient(conn).WaitExecution(ctx, &repb.WaitExecutionRequest{Name: "unmatched"})
+	if err == nil {
+		_, err = waitStream.Recv()
+	}
+	if status.Code(err) != codes.FailedPrecondition {
+		t.Fatalf("WaitExecution error code = %s, want %s", status.Code(err), codes.FailedPrecondition)
+	}
+
+	p.state.mu.Lock()
+	defer p.state.mu.Unlock()
+	if p.state.r.RunAttempts != 1 || p.state.r.RunForwardAttempts != 0 || p.state.r.RunForwardSucceeded != 0 {
+		t.Fatalf("Run counters = attempts:%d forwards:%d successes:%d, want 1/0/0", p.state.r.RunAttempts, p.state.r.RunForwardAttempts, p.state.r.RunForwardSucceeded)
+	}
+	if p.state.r.LogStreamAttempts != 1 || p.state.r.LogStreamMatched != 0 || p.state.r.LogStreamForwardAttempts != 0 || p.state.r.CancelAttempts != 1 || p.state.r.CancelForwardAttempts != 0 || p.state.r.GetExecutionAttempts != 1 || p.state.r.GetExecutionForwardAttempts != 0 || p.state.r.GetInvocationAttempts != 1 || p.state.r.GetInvocationForwardAttempts != 0 || p.state.r.WaitExecutionStreams != 1 || p.state.r.WaitExecutionForwardAttempts != 0 {
+		t.Fatalf("unexpected forwarding counters: %+v", p.state.r)
+	}
+}
