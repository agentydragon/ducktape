@@ -0,0 +1,27 @@
+"""Render the deployment profiles consumed by test_render in one process."""
+
+import os
+from pathlib import Path
+
+from agentplane.system_tests.deployment import render_fixture
+
+_TEST_RENDER_VARIANTS = (
+    render_fixture.FixtureVariant.LOCAL_MODEL,
+    render_fixture.FixtureVariant.LOCAL_MODEL_POD,
+    render_fixture.FixtureVariant.LOCAL_MODEL_CENTRAL,
+    render_fixture.FixtureVariant.LOCAL_MODEL_CENTRAL_SERVICES,
+    render_fixture.FixtureVariant.LOCAL_MODEL_CENTRAL_BUDGET,
+    render_fixture.FixtureVariant.LOCAL_MODEL_VM,
+    render_fixture.FixtureVariant.LOCAL_MODEL_FIRECRACKER,
+)
+
+
+def main() -> None:
+    output = Path(os.environ["K3S_FIXTURE_DIR"])
+    for variant in _TEST_RENDER_VARIANTS:
+        render_fixture.render_variant(output, variant)
+    render_fixture.render_full_virtualized_profiles(output)
+
+
+if __name__ == "__main__":
+    main()
