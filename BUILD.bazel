# Gazelle exclusions
# Most .gitignore patterns are handled by .bazelignore (root-level directories)
# or don't need exclusion (cache dirs with no .py files like __pycache__)
# gazelle:exclude ansible
# gazelle:exclude homeassistant  # TODO: merge @pypi_homeassistant into @pypi to enable Gazelle here
#
# Deliberately unbazelized trees: one-off scripts, investigations, doc-run
# artifacts, host configs. Pull a tree out of this list to bazelize it.
# gazelle:exclude cluster/docs/inference
# gazelle:exclude cluster/k8s/sdr
# gazelle:exclude cluster/k8s/x
# gazelle:exclude debug/atlas
# gazelle:exclude debug/kernel-6.18-amd-kvm-stall
# gazelle:exclude debug/sqlite_storage_bench
# gazelle:exclude nix/nixos
# gazelle:exclude tgarchive
# gazelle:exclude x/domains
# gazelle:exclude x/ember_evals
# gazelle:exclude x/local_llm
# gazelle:exclude x/rl_finetune

# gazelle:python_root
# gazelle:python_generation_mode file
# gazelle:python_default_visibility NONE
# gazelle:python_manifest_file_name devinfra/gazelle_python.yaml
# The codebase pattern is one py_library per .py file, with py_binary targets hand-written
# (main_module, no srcs) and named off the module stems so Gazelle never manages them.
# Enforced by patches/rules_python_gazelle_ducktape.patch, which replaced a
# `map_kind py_binary py_library` directive here: Gazelle applies map_kind to existing
# hand-written py_binary rules too, rewriting their kind.
#
# Bazel-provided libraries (not from PyPI)
# gazelle:resolve py rules_python.python.runfiles @rules_python//python/runfiles
# gazelle:resolve py python.runfiles @rules_python//python/runfiles
# gazelle:resolve py pkg.private @rules_pkg//pkg/private:manifest
#
# The generated manifest maps dotted namespace-package keys (opentelemetry.sdk,
# google.oauth2, testcontainers.postgres, ...) but has no bare-module entry, so a
# plain `import opentelemetry` doesn't resolve; pin it to the dist owning the root.
# gazelle:resolve py opentelemetry @pypi//opentelemetry_api
#
# FreeCAD provides these modules at runtime (scripts run inside its bundled
# Python); the stubs dist supplies types for mypy, mirroring the hand-written deps.
# gazelle:resolve py FreeCAD @pypi//freecad_stubs
# gazelle:resolve py FreeCADGui @pypi//freecad_stubs
# gazelle:resolve py Part @pypi//freecad_stubs
# gazelle:resolve py Sketcher @pypi//freecad_stubs
# gazelle:resolve py TechDraw @pypi//freecad_stubs
# gazelle:resolve py TechDrawGui @pypi//freecad_stubs
#
# Non-standard import paths (import name doesn't match directory structure)
# gazelle:resolve py samplebooks_parts_data //inventree_utils/samplebooks_import:samplebooks_parts_data
# haku/shared is a nested Bazel module (bazelignored), so Gazelle cannot index the library
# that provides this namespace-package import; pin it to the module's label.
# gazelle:resolve py haku.console.tool_calls @ducktape_haku//haku/console:tool_calls
# cluster/k8s/x is excluded above, so Gazelle cannot index the target providing this import.
# gazelle:resolve py cluster.k8s.x.haku.dispatch.litellm.generate_workers_litellm //cluster/k8s/x/haku/dispatch/litellm:generate_workers_litellm

load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_js//npm:defs.bzl", "npm_link_package")
load("@bazel_skylib//rules:native_binary.bzl", "native_test")
load("@image_pins//:pins.bzl", "RBE_WORKER_DIGEST", "RBE_WORKER_IMAGE")
load("@npm_ducktape//:defs.bzl", "npm_link_all_packages")
load("@rules_python//python:packaging.bzl", "py_package", "py_wheel")
load("@rules_python//python/uv:lock.bzl", "lock")
load("//devinfra/python:defs.bzl", "py_library")

# Visibility is controlled per-target. Gazelle uses python_default_visibility NONE
# so targets default to private. Public targets explicitly set visibility.

# Link workspace npm packages
npm_link_all_packages(name = "node_modules")

# Link the first-party shared bridge-protocol package (@haku/console-bridge) built by the
# ducktape_haku nested module. First-party npm_package links (src = …) must live in the root
# package; the console frontend then depends on //:node_modules/@haku/console-bridge the same
# way it depends on //:node_modules/react.
npm_link_package(
    name = "node_modules/@haku/console-bridge",
    src = "@ducktape_haku//bridge_protocol:pkg",
)

# Export workspace files for npm_translate_lock data tracking
exports_files([
    "buildbuddy.yaml",
    "mypy.ini",
    "nebula-mesh.json",
    "package.json",
    "pnpm-workspace.yaml",
    "requirements_bazel.txt",
    "ruff.toml",
])

# The SOPS creation_rules, pinned by //cluster/validation:test_rotations_config:
# a rotation whose state file matches no rule cannot be encrypted at all.
filegroup(
    name = "sops_config",
    srcs = [".sops.yaml"],
    visibility = ["//cluster/validation:__pkg__"],
)

# Root conftest.py for shared pytest configuration
# Tests can depend on this for pytest-asyncio auto mode and common markers
py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "@pypi//pytest",
        "@pypi//pytest_asyncio",
    ],
)

# ESLint configuration as js_library
# This makes the config and its npm dependencies available to the ESLint aspect
# no-lint: This is a config file, not a target to lint (avoids aspect self-application)
js_library(
    name = "eslintrc",
    srcs = ["eslint.config.js"],
    tags = ["no-lint"],
    visibility = ["//devinfra:__subpackages__"],
    deps = [
        ":node_modules/@eslint/js",
        ":node_modules/@typescript-eslint/eslint-plugin",
        ":node_modules/@typescript-eslint/parser",
        ":node_modules/eslint-plugin-import-x",
        ":node_modules/eslint-plugin-react",
        ":node_modules/eslint-plugin-react-hooks",
        ":node_modules/eslint-plugin-svelte",
        ":node_modules/globals",
        ":node_modules/svelte",  # peer dep of svelte-eslint-parser & eslint-plugin-svelte
        ":node_modules/svelte-eslint-parser",
        ":node_modules/typescript",  # peer dep of @typescript-eslint/parser & plugin
    ],
)

# Prettier configuration as js_library
# Makes the config and its plugins available to the prettier binary in //devinfra:prettier_bin
# no-lint: This is a config file, not a target to lint
js_library(
    name = "prettierrc",
    srcs = [".prettierrc.cjs"],
    tags = ["no-lint"],
    visibility = ["//devinfra:__subpackages__"],
    deps = [
        ":node_modules/prettier-plugin-svelte",
        ":node_modules/svelte",
    ],
)

# Generate requirements_bazel.txt from pyproject.toml
# Run: bazel run //:requirements.update
#
# IMPORTANT: This target requires direct network access to PyPI for dependency resolution.
# dockerNetwork=bridge gives the RBE action outbound internet access (off by default).
lock(
    name = "requirements",
    srcs = ["pyproject.toml"],
    out = "requirements_bazel.txt",
    exec_properties = {"dockerNetwork": "bridge"},
    # Generated py_binary has mypy errors (str/Path reassignment) — skip lint on generated code.
    tags = [
        "no-lint",
        "no-mypy",
    ],
)

# Test that requirements_bazel.txt is up to date
# Run: bazel test //:requirements_test
native_test(
    name = "requirements_test",
    src = ":requirements.update",
    exec_properties = {"dockerNetwork": "bridge"},
    tags = [
        "no-cache",
        "requires-network",
    ],
)

platform(
    name = "linux_x64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

platform(
    name = "rbe_linux_x64",
    exec_properties = {
        # Custom image layered on BuildBuddy's rbe-ubuntu24-04 with git,
        # ca-certificates, and podman for e2e tests.
        # Built by .github/workflows/container-images.yml, pinned in devinfra/image_pins.json.
        "container-image": "docker://" + RBE_WORKER_IMAGE + "@" + RBE_WORKER_DIGEST,
        # BuildBuddy Firecracker isolation for all RBE actions (better isolation + runner recycling)
        "workload-isolation-type": "firecracker",
        "recycle-runner": "true",
        # Start Docker daemon for all RBE actions (lightweight with Firecracker).
        # Needed for tests (QEMU, integration) and genrules (Talos imager).
        # With recycle-runner, Docker starts once per VM and persists.
        # Defined here (not via --remote_default_exec_properties in .bazelrc)
        # to avoid duplicate-key crash when --config=rbe is expanded twice
        # (e.g., both buildbuddy.bazelrc and auth-proxy/bazelrc enable it).
        "init-dockerd": "true",
        "EstimatedComputeUnits": "3",
        # Extra disk for Docker-heavy genrules (Talos imager: ~500 MB image + 2.2 GB output).
        # Default workspace slack is 2 GB which is insufficient.
        "EstimatedFreeDiskBytes": "10GB",
    },
    parents = ["@buildbuddy_toolchain//:platform_linux_x86_64"],
)

# bbr wheel — standalone `bb remote` wrapper (own package, not bundled into
# claude-hooks, so it's available when using the Rust claude-hook binary).
py_package(
    name = "bbr_pkg",
    packages = ["devinfra"],
    deps = ["//devinfra:bbr"],
)

py_wheel(
    name = "bbr_wheel",
    distribution = "bbr",
    entry_points = {
        "console_scripts": ["bbr = devinfra.bbr:main"],
    },
    python_requires = ">=3.13",
    requires = ["pygit2>=1.14"],
    version = "0.1.0",
    visibility = ["//visibility:public"],
    deps = [":bbr_pkg"],
)

# Git hooks wheel — ducktape-* console scripts, precommit runners, cluster validation.
# Installed in devtools so the ducktape-* git hooks are available alongside
# the Rust claude-hook binary.
py_package(
    name = "ducktape_git_hooks_pkg",
    packages = [
        "devinfra",
        "devinfra.precommit",
        "devinfra.precommit.enforce_bazel_tests",
    ],
    deps = ["//devinfra/precommit:git_hook"],
)

py_wheel(
    name = "ducktape_git_hooks_wheel",
    distribution = "ducktape_git_hooks",
    entry_points = {
        "console_scripts": [
            "ducktape-precommit = devinfra.precommit.git_hook:main_pre_commit",
            "ducktape-pytest-main-check = devinfra.precommit.git_hook:main_pytest_main_check",
            "ducktape-prepare-commit-msg = devinfra.precommit.git_hook:main_prepare_commit_msg",
            "ducktape-enforce-bazel-tests = devinfra.precommit.git_hook:main_enforce_bazel_tests",
        ],
    },
    python_requires = ">=3.13",
    # SYNC: This list must match propagatedBuildInputs in nix/packages/default.nix
    # (ducktape-git-hooks). When adding a dependency, update BOTH places.
    requires = [
        "networkx",
        "opentelemetry-api",
        "opentelemetry-sdk",
        "pygit2>=1.14",
        "pydantic>=2.0",
        "pyyaml",
        "ducktape-util",
    ],
    version = "0.1.0",
    visibility = ["//visibility:public"],
    deps = [":ducktape_git_hooks_pkg"],
)

# Claude hooks wheel — Python statusline only. Active hook dispatch is the Rust
# `claude-hook` binary packaged separately by Nix.
py_package(
    name = "claude_hooks_pkg",
    packages = [
        "devinfra.claude",
        "devinfra.claude.claude_api",
        "devinfra.claude.claude_api.hooks",
        "devinfra.claude.statusline",
    ],
    deps = [
        "//devinfra/claude/statusline",
    ],
)

py_wheel(
    name = "claude_hooks_wheel",
    distribution = "claude_hooks",
    entry_points = {
        "console_scripts": [
            "claude-statusline = devinfra.claude.statusline.statusline:main",
        ],
    },
    python_requires = ">=3.13",
    # SYNC: This list must match propagatedBuildInputs in nix/packages/default.nix
    # (claude-hooks). The Nix derivation provides these at runtime on NixOS/devShell.
    # When adding a dependency, update BOTH places.
    #
    # `aiquota` is the local artifact-pinned wheel (not on PyPI); the statusline
    # imports it for quota data. Nix provides it via the aiquota derivation in
    # propagatedBuildInputs (which also brings typer/atomicwrites transitively).
    requires = [
        "aiquota",
        "httpx",
        "platformdirs",
        "pydantic>=2.0",
        "rich",
    ],
    version = "0.1.0",
    visibility = ["//visibility:public"],
    deps = [":claude_hooks_pkg"],
)

# Ducktape wheel - bundles CLI tools for distribution
py_package(
    name = "ducktape_pkg",
    packages = [
        "agent_core",
        "cluster.skills.hetzner_vnc_screenshot",
        "cluster.skills.proxmox_vm",
        "devinfra.gc",
        "devinfra.ws",
        "difftree",
        "git_commit_ai",
        "gmail_api",
        "gmail_archiver",
        "gmail_archiver.cli",
        "gmail_archiver.planners",
        "mako_utils",
        "mcp_infra",
        "openai_utils",
    ],
    deps = [
        # CLI tool entry points. Each dep must transitively reach the module
        # named in the console_scripts entry below — adding a name to the
        # `packages` list above does not pull in any source files; py_package
        # only collects files reachable from `deps`. The imports check in
        # nix/packages/default.nix guards against this regressing again.
        "//difftree:cli",
        "//git_commit_ai:git_commit_ai_lib",
        "//gmail_archiver:main",
        "//cluster/skills/hetzner_vnc_screenshot:vnc_screenshot",
        "//cluster/skills/proxmox_vm:vm_interact",
        "//devinfra/gc:workspace_gc",
        "//devinfra/ws:cli",
    ],
)

py_wheel(
    name = "wheel",
    distribution = "ducktape",
    entry_points = {
        "console_scripts": [
            "workspace-gc = devinfra.gc.workspace_gc:main",
            "git-commit-ai = git_commit_ai.cli:main",
            "difftree = difftree.cli:main",
            "gmail-archiver = gmail_archiver.main:app",
            "hetzner-vnc-screenshot = cluster.skills.hetzner_vnc_screenshot.vnc_screenshot:app",
            "vm-interact = cluster.skills.proxmox_vm.vm_interact:app",
            "ws = devinfra.ws.cli:main",
        ],
    },
    python_requires = ">=3.13",
    requires = [
        # git_commit_ai deps
        "aiodocker",
        "anyio",
        "compact-json",
        "fastmcp>=3.4.4,<3.5",
        "httpx",
        "jinja2",
        "mako>=1.3",
        "mcp",
        "openai",
        "pydantic>=2.0",
        "pyhamcrest",
        "pygit2>=1.14",
        "rich",
        "structlog",
        "tenacity",
        "typer",
        # difftree deps
        "click>=8.0",
        "unidiff>=0.7.0",
        # gmail_archiver deps
        "beautifulsoup4",
        "google-api-python-client",
        "google-auth-httplib2",
        "google-auth-oauthlib",
        "pydantic-settings",
        "python-dateutil",
        "pyyaml",
        # skills deps
        "asyncvnc>=1.3.0",
        "hcloud>=2.0.0",
        "pillow>=10.0.0",
        "websockets>=15.0",
        "ducktape-util",
        # workspace-gc deps
        "humanize>=4.0.0",
        "pygithub>=1.77",
