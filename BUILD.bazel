# Gazelle exclusions
# Most .gitignore patterns are handled by .bazelignore (root-level directories)
# or don't need exclusion (cache dirs with no .py files like __pycache__)
# gazelle:exclude ansible
# gazelle:exclude homeassistant  # TODO: merge @pypi_homeassistant into @pypi to enable Gazelle here
# gazelle:exclude claude/claude_hooks  # complex internal imports
# gazelle:exclude k8s-old  # legacy k8s configs, deps not in main requirements

# gazelle:python_root
# gazelle:python_generation_mode file
#
# Resolve local packages with fine-grained targets.
# These packages have multiple py_library targets for different modules,
# so we tell gazelle which target provides the base package namespace.
# gazelle:resolve py agent_core //agent_core
#
# props/core has per-file targets
# gazelle:resolve py props.core.agent_types //props/core:agent_types
# gazelle:resolve py props.core.ids //props/core:ids
# gazelle:resolve py props.core.splits //props/core:splits
# gazelle:resolve py props.core.display //props/core:display
# gazelle:resolve py props.core.agent_workspace //props/core:agent_workspace
# gazelle:resolve py props.core.oci_utils //props/core:oci_utils
# gazelle:resolve py props.core.docker_env //props/core:docker_env
# gazelle:resolve py props.core.eval_api_models //props/core:eval_api_models
# gazelle:resolve py props.core.exceptions //props/core:exceptions
# gazelle:resolve py props.core.eval_client //props/core:eval_client
# gazelle:resolve py props.core.agent_helpers //props/core:agent_helpers
# gazelle:resolve py props.core.loop_utils //props/core:loop_utils
# gazelle:resolve py props.core.runs_context //props/core:runs_context
# gazelle:resolve py props.core.agent_pkg_utils //props/core:agent_pkg_utils
#
# props/db has per-file targets
# gazelle:resolve py props.db.config //props/db:config
# gazelle:resolve py props.db.models //props/db:models
# gazelle:resolve py props.db.session //props/db:session
# gazelle:resolve py props.db.examples //props/db:examples
# gazelle:resolve py props.db.snapshots //props/db:snapshots
# gazelle:resolve py props.db.snapshot_io //props/db:snapshot_io
# gazelle:resolve py props.db.agent_definition_ids //props/db:agent_definition_ids
# gazelle:resolve py props.db.query_builders //props/db:query_builders
# gazelle:resolve py props.db.setup //props/db:setup
#
# props/critic_dev has per-file targets
# gazelle:resolve py props.critic_dev.optimize.main //props/critic_dev/optimize:main_lib
# gazelle:resolve py props.critic_dev.optimize.test_e2e //props/critic_dev/optimize:test_e2e_lib
# gazelle:resolve py props.critic_dev.improve.main //props/critic_dev/improve:main_lib
