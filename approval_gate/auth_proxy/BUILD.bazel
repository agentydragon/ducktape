load("@aspect_rules_py//py:defs.bzl", "py_image_layer", aspect_py_binary = "py_binary")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load", "oci_push")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("//props:oci.bzl", "py_image_entrypoint", "py_image_env")
load("//tools/testing:defs.bzl", "py_test")

py_library(
    name = "proxy",
    srcs = ["proxy.py"],
    imports = ["../.."],
    visibility = ["//visibility:public"],
    deps = [
        "//util:env",
        "@pypi//authlib",
        "@pypi//fastmcp",
        "@pypi//uvicorn",
    ],
)

py_binary(
    name = "auth_proxy",
    imports = ["../.."],
    main_module = "approval_gate.auth_proxy.proxy",
    visibility = ["//visibility:public"],
    deps = [":proxy"],
)

# ── OCI Image ─────────────────────────────────────────────────────────────────

aspect_py_binary(
    name = "auth_proxy_bin",
    imports = ["../.."],
    main = "proxy.py",
    deps = [":proxy"],
)

py_image_layer(
    name = "layers",
    binary = ":auth_proxy_bin",
    group = "1000",
    owner = "1000",
)

oci_image(
    name = "image",
    base = "@debian_slim_linux_amd64",
    entrypoint = py_image_entrypoint("auth_proxy_bin"),
    env = py_image_env(binary_name = "auth_proxy_bin"),
    tars = [":layers"],
    user = "1000:1000",
    visibility = ["//visibility:public"],
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["approval-gate-auth-proxy:latest"],
    visibility = ["//visibility:public"],
)

oci_push(
    name = "push",
    image = ":image",
    remote_tags = ["latest"],
    repository = "registry.allegedly.works/approval-gate/auth-proxy",
)

# ── Tests ─────────────────────────────────────────────────────────────────────

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    imports = ["../.."],
    deps = [
        "@pypi//pytest",
        "@pypi//pytest_asyncio",
    ],
)

py_test(
    name = "test_proxy",
    srcs = ["test_proxy.py"],
    deps = [
        ":conftest",
        ":proxy",
        "@pypi//httpx",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",
        "@pypi//pytest_bazel",
        "@pypi//respx",
        "@pypi//starlette",
    ],
)
