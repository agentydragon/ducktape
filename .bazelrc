common --enable_bzlmod
common --experimental_isolated_extension_usages
# Disable Aspect telemetry (aspect_tools_telemetry) so builds don't POST to telemetry.aspect.build
common --repo_env=DO_NOT_TRACK=1
# rules_python's toolchain repository rule puts the hermetic interpreter's __pycache__ at
# RULES_PYTHON_PYCACHE_DIR, else under XDG_CACHE_HOME, else under TMP, and records the variable it read as a
# repository input. Nix devshells give every shell a fresh TMP, so without this pin each shell misses
# --repo_contents_cache and extracts another copy of the toolchain.
common --repo_env=RULES_PYTHON_PYCACHE_DIR=/tmp/rules_python_pycache

# Suppress -Wmaybe-uninitialized from protobuf's upb C decoder. Keep this on
# the one translation unit that emits it, in both target and host builds.
build --per_file_copt=external/protobuf[+]/upb/wire/decode[.]c@-Wno-maybe-uninitialized
build --host_per_file_copt=external/protobuf[+]/upb/wire/decode[.]c@-Wno-maybe-uninitialized

# Protobuf's C++ sources still use Abseil's deprecated pointer-taking mutex
# guards and string-resize helper, plus Protobuf's deprecated GetRepeatedEnum.
# Cleanup: remove when Protobuf adopts the reference-taking guards, replacement
# string helper, and GetRepeatedEnumValue().
build --per_file_copt=external/protobuf[+]/src/google/protobuf/.*[.]cc@-Wno-deprecated-declarations
build --host_per_file_copt=external/protobuf[+]/src/google/protobuf/.*[.]cc@-Wno-deprecated-declarations

# Suppress noisy warnings from OR-Tools' own sources — upstream code rather
# than something this repo can fix. Keep this scoped to OR-Tools so repo code
# still uses the normal warning policy.
# -Wsign-compare: signed/unsigned comparisons throughout the 9.15 release.
# -Wrange-loop-construct: `for (const auto [a, b] : container)` over containers
#   of std::pair/tuple copies the structured binding instead of binding a
#   reference (ortools/sat/precedences.cc, linear_propagation.cc, diffn_util.cc,
#   pseudo_costs.cc, etc.).
# -Wcomment: ASCII-art diagrams in comments (ortools/util/fixed_shape_binary_tree.h)
#   contain backslashes gcc parses as line-continuations.
# -Wdeprecated-declarations: generated OR-Tools protobuf sources include protobuf
#   headers that still call RepeatedPtrField(Arena*), which protobuf deprecated.
# -Wnarrowing: OR-Tools' integer-resolution queue initializes an int trail level
#   from its unsigned AssignmentInfo::level field.
# -Wunused-but-set-variable: `has_all_diffs` is assigned but unused in
#   ortools/sat/cp_model_expand.cc.
# -Wparentheses: objective comparisons in ortools/sat/cp_model_presolve.cc
#   rely on C++ operator precedence that gcc warns about.
# -Wunused-result: OR-Tools ignores protobuf TextFormat::PrintToString's
#   boolean result in its debug-string helpers.
# -Warray-bounds and -Wmaybe-uninitialized: optimizer diagnostics in SVector
#   and OR-Tools SAT code, including inlined Abseil helpers.
# -Wstrict-aliasing: OR-Tools Glop's type-punned row/permutation conversions.
build --per_file_copt=external/or-tools[+]/.*@-Wno-sign-compare,-Wno-range-loop-construct,-Wno-comment,-Wno-deprecated-declarations,-Wno-narrowing,-Wno-unused-but-set-variable,-Wno-parentheses,-Wno-unused-result,-Wno-array-bounds,-Wno-maybe-uninitialized,-Wno-strict-aliasing
build --host_per_file_copt=external/or-tools[+]/.*@-Wno-sign-compare,-Wno-range-loop-construct,-Wno-comment,-Wno-deprecated-declarations,-Wno-narrowing,-Wno-unused-but-set-variable,-Wno-parentheses,-Wno-unused-result,-Wno-array-bounds,-Wno-maybe-uninitialized,-Wno-strict-aliasing

# Reduce runfiles disk usage (prevents "No space left on device" on CI runners).
# Each py_test creates a runfiles tree with ~2,458 symlinks for the Python toolchain;
# with many targets this exhausts the default 20 GB BuildBuddy disk.
# --nobuild_runfile_links: don't eagerly create runfiles trees during build phase
#   (created on-demand for test/run). Safe for CI where we only `bazel test` or `bazel run`.
# --nolegacy_external_runfiles: skip duplicate legacy external/<repo> runfiles path,
#   keeping only the modern ../<repo> path. Halves external dep symlink count.
build --nobuild_runfile_links
build --nolegacy_external_runfiles

# No MODULE.bazel.lock: a ~14 MB file, mostly the rules_distroless `apt` resolution, that every
# MODULE.bazel change would regenerate, for about 16 s off a cold sweep. Trade-off and when to
# revisit: devinfra/debug/bazel_module_lockfile.md.
common --lockfile_mode=off

# Bazel cancels in-flight Skyframe computations when the heap is under pressure
# (--skyframe_high_water_mark_*_gc_drops_per_invocation, 10 each by default), and a cancelled
# module extension restarts from scratch. With the lockfile off, the rules_distroless `apt`
# extension runs on every cold server: it parses ~350 MB of Debian indexes in 1-1.5 GB of
# heap, and those allocations themselves trigger the pressure that restarts it, over and over,
# until a graph-wide sweep runs out of heap (#11120). Never shed state.
common --skyframe_high_water_mark_full_gc_drops_per_invocation=0
common --skyframe_high_water_mark_minor_gc_drops_per_invocation=0

# Lint + typecheck enabled by default on all builds.
# Combines lint (ruff, ESLint, pytest-main), typecheck (mypy), and Rust checks (clippy, rustfmt).
# Use Python 3.14 for mypy to parse Python 3.14 syntax (e.g., homeassistant).
# --config=nolint skips ruff, ESLint, mypy, pytest-main, clippy and rustfmt (see build:nolint below).
build --@rules_python//python/config_settings:python_version=3.14
build --aspects=//devinfra/lint:linters.bzl%ruff,//devinfra/lint:linters.bzl%mypy_aspect,//devinfra/lint:linters.bzl%eslint,//devinfra/lint:pytest_main.bzl%pytest_main_aspect,@rules_rust//rust:defs.bzl%rust_clippy_aspect,@rules_rust//rust:defs.bzl%rustfmt_aspect
build --output_groups=+rules_lint_report,+mypy,+pytest_main_checks,+clippy_checks,+rustfmt_checks

# Make ruff + ESLint findings fail the build, so code that doesn't lint clean no longer
# bazel-builds, as with mypy/clippy/rustfmt.
# --config=nolint still bypasses it (see build:nolint below).
build --@aspect_rules_lint//lint:fail_on_violation

# Skip lint and typecheck. Ruff and ESLint run as validation actions, which
# --output_groups cannot drop; --norun_validations skips them, and also every other
# rule's validation actions.
build:nolint --output_groups=-rules_lint_report,-mypy,-pytest_main_checks,-clippy_checks,-rustfmt_checks
build:nolint --norun_validations

# Remote Build Execution (BuildBuddy). Kept in an importable fragment so the
# NixOS integration fixture exercises the exact workspace policy.
import %workspace%/devinfra/bazel/rbe.bazelrc

# Formatting: use bazel run //devinfra/format (fix) or //devinfra/format.check (check)
# Supports: prettier (JS/TS/CSS/HTML/MD), ruff (Python), shfmt (Shell), buildifier (Bazel), rustfmt (Rust)

# Workspace status command populates volatile metadata (repo URL, branch, user)
# for BuildBuddy UI. Stamping is off by default for hermeticity; release builds
# opt in with --stamp to embed commit/content info via expand_template rules.
build --workspace_status_command=devinfra/stamp.sh

# Use shell-based bootstrap instead of system_python.  The default
# (system_python) starts with `#!/usr/bin/env python3` which picks up whatever
# system Python is on PATH.  This causes _sre.MAGIC mismatches when system
# Python differs from the hermetic 3.13 toolchain, and stdlib shadowing when
# files like `types.py` exist in the package directory.  The script bootstrap
# invokes the hermetic interpreter directly, avoiding both issues.
#
# Subprocess-spawning code uses bazel_subprocess.py to propagate PYTHONPATH.
common --@rules_python//python/config_settings:bootstrap_impl=script

# Don't generate empty __init__.py stubs in runfiles. Fixes protobuf namespace
# packages (google.*) and FreeCAD conda C extension shadowing repo-wide.
common --incompatible_default_to_explicit_init_py

# Quiet output mode — reduces progress spam for non-interactive contexts.
# --curses=no: disable curses UI
# --show_progress_rate_limit=30: at most one progress update every 30 seconds
common:quiet --curses=no
common:quiet --show_progress_rate_limit=30

# rustc emits .rmeta first so dependent crates start before codegen finishes. Measured
# 2026-10-29 on the debundle chain: cold critical path 610 -> 536 s, elapsed 682 -> 653 s,
# +14% actions; devinfra/debug/2026_10_29_rust_pipelined_compilation.md.
build --@rules_rust//rust/settings:pipelined_compilation=True

# Keep the global Go race setting stable across test and build commands so
# analysis can be reused. Non-pure go_binary roots that publish normal
# executables explicitly set race = "off"; pure = "on" targets stay no-cgo.
build --@io_bazel_rules_go//go/config:race

# CI and AI agent modes both use quiet output.
common:ci --config=quiet
common:ci --announce_rc
# Remote retry policy history. Bazel's default is 5. #12468 set 0 because a
# retry resubmitted actions after the outer runner was cancelled (a fresh Execute
# 105 ms after the CANCELLED result; devinfra/buildbuddy/debug/ci_remote_cancellation/
# rpc_retry_trace.md), so superseded runs kept burning executor time. Zero also
# disables recovery from transient executor errors: the 2026-10-29 ci-reports
# window had 16 of 225 PR and 2 of 66 devel test invocations fail on gRPC
# Unavailable (Firecracker start timeout / pause refused, one CAS miss), each a red
# head needing a re-push. One retry recovers those while bounding the
# post-cancellation resubmission to a single extra attempt.
# CLEANUP(added 2026-10-29): the resubmission itself is bazelbuild/bazel#30954,
#   fixed upstream by 29b6ec37 (absent from 9.2.0 and 9.3.1; in 10.0.0-pre
#   builds). Once .bazelversion pins a release containing it, drop this override
#   and return to the default retry count.
build:ci --remote_retries=1
# Live targets remain part of CI builds so their remote lint/typecheck actions
# stay covered. Only their credentialed test processes are excluded.
test:ci --test_tag_filters=-live_openai_api,-manual
# Opt in to credentialed, real-model tests with `--config=ci --config=live-openai`.
test:live-openai --test_tag_filters=live_openai_api,-manual,-ollama
test:live-openai --test_env=OPENAI_BASE_URL=https://litellm.allegedly.works/v1
test:live-openai --test_env=OPENAI_MODEL=chatgpt-sub/oai-responses/gpt-6-luna
common:ai_agent --config=quiet
