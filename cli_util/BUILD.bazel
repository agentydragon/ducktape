"""CLI utilities package."""

load("@rules_python//python:defs.bzl", "py_library")
load("//tools/lint:linters.bzl", "ruff_test")

py_library(
    name = "cli_util",
    srcs = [
        "__init__.py",
        "decorators.py",
        "logging.py",
    ],
    imports = [".."],
    visibility = ["//visibility:public"],
    deps = [
        "@pypi//structlog",
        "@pypi//typer",
    ],
)

ruff_test(
    name = "ruff",
    srcs = [":cli_util"],
)

py_library(
    name = "decorators",
    srcs = ["decorators.py"],
    visibility = ["//:__subpackages__"],
)

py_library(
    name = "logging",
    srcs = ["logging.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "@pypi//structlog",
        "@pypi//typer_slim",
    ],
)
