"""Git commit AI package."""

load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")

# `git_commit_ai_lib` is the full library bundle: it must transitively reach
# every module shipped under the `git_commit_ai` top-level package, including
# cli.py — otherwise the umbrella ducktape wheel (which depends on this lib)
# silently drops the entry-point script. Adding new modules here is how they
# get into both the in-tree binaries and the published wheel.
py_library(
    name = "git_commit_ai_lib",
    data = ["commit_editmsg.mako"],
    visibility = ["//visibility:public"],
    deps = [
        ":agent_backend",
        ":cli",
        ":editor",
        "//git_commit_ai/git_ro:formatting",
        "//git_commit_ai/git_ro:server",
    ],
)

py_library(
    name = "cli",
    srcs = ["cli.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":agent_backend",
        ":config",
        ":editor",
        "//util:typer",
        "//util/bazel:workspace",
        "@pypi//pygit2",
        "@pypi//typer",
    ],
)

py_library(
    name = "config",
    srcs = ["config.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "@pypi//platformdirs",
        "@pypi//pydantic",
        "@pypi//pydantic_settings",
        "@pypi//pyyaml",
    ],
)

py_binary(
    name = "git_commit_ai",
    main_module = "git_commit_ai.cli",
    visibility = ["//:__subpackages__"],
    deps = [":cli"],
)

