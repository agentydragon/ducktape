"""Home Assistant component installer OCI image."""

load("@aspect_rules_py//py:defs.bzl", "py_image_layer", aspect_py_binary = "py_binary")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("//devinfra/python:defs.bzl", "py_library", "py_test")
load("//props:oci.bzl", "py_image_entrypoint", "py_image_env")

aspect_py_binary(
    name = "install_bin",
    main = "install.py",
    deps = [":install"],
)

py_image_layer(
    name = "layers",
    binary = ":install_bin",
    group = "1000",
    owner = "1000",
)

oci_image(
    name = "image",
    base = "@debian_trixie_slim_linux_amd64",
    entrypoint = py_image_entrypoint("install_bin"),
    env = py_image_env(binary_name = "install_bin"),
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [":layers"],
    user = "1000:1000",
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["homeassistant-component-installer:latest"],
)

py_library(
    name = "install",
    srcs = ["install.py"],
    deps = [
        ":settings",
        "@pypi//httpx2",
    ],
)

py_library(
    name = "settings",
    srcs = ["settings.py"],
    visibility = ["//cluster/cdk8s/home_assistant:__pkg__"],
    deps = [
        "//homeassistant/provisioner:yaml_settings",
        "@pypi//pydantic",
        "@pypi//pydantic_settings",
    ],
)

py_test(
    name = "test_install",
    srcs = ["test_install.py"],
    deps = [
        ":install",
        ":settings",
        "//:conftest",
        "//homeassistant/provisioner:conftest",
        "@pypi//httpx2",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//pytest_httpx2",
    ],
)
