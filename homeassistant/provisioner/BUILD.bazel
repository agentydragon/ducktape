# gazelle:ignore
"""Home Assistant onboarding provisioner OCI image."""

load("@aspect_rules_py//py:defs.bzl", "py_image_layer", aspect_py_binary = "py_binary")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("//devinfra/python:defs.bzl", "py_library", "py_test")
load("//props:oci.bzl", "py_image_entrypoint", "py_image_env")

py_library(
    name = "settings",
    srcs = ["settings.py"],
    imports = ["."],
    visibility = ["//visibility:public"],
    deps = [
        "@pypi//pydantic",
        "@pypi//pydantic_settings",
        "@pypi//pyyaml",
    ],
)

py_library(
    name = "component_installer",
    srcs = ["component_installer.py"],
    imports = ["."],
    deps = [
        ":settings",
        "@pypi//httpx2",
    ],
)

py_library(
    name = "client",
    srcs = ["client.py"],
    imports = ["."],
    deps = [
        ":settings",
        "@pypi//aiohttp",
        "@pypi//httpx2",
        "@pypi//pydantic",
        "@pypi//tenacity",
    ],
)

py_library(
    name = "provision",
    srcs = ["provision.py"],
    imports = ["."],
    visibility = ["//visibility:public"],
    deps = [
        ":client",
        ":component_installer",
        ":settings",
        "@pypi//aiohttp",
        "@pypi//httpx2",
    ],
)

py_test(
    name = "test_provision",
    srcs = ["test_provision.py"],
    imports = ["."],
    deps = [
        ":client",
        ":provision",
        ":settings",
        "//:conftest",
        "@pypi//aiohttp",
        "@pypi//httpx2",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//pytest_httpx2",  # keep: pytest plugin (auto-loaded), not a direct import
        "@pypi//respx",
    ],
)

py_test(
    name = "test_component_installer",
    srcs = ["test_component_installer.py"],
    imports = ["."],
    deps = [
        ":component_installer",
        "//:conftest",
        "@pypi//httpx2",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//pytest_httpx2",  # keep: pytest plugin (auto-loaded), not a direct import
    ],
)

aspect_py_binary(
    name = "provision_bin",
    main = "provision.py",
    deps = [":provision"],
)

py_image_layer(
    name = "layers",
    binary = ":provision_bin",
    group = "1000",
    owner = "1000",
)

oci_image(
    name = "image",
    base = "@debian_trixie_slim_linux_amd64",
    entrypoint = py_image_entrypoint("provision_bin"),
    env = py_image_env(binary_name = "provision_bin"),
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [":layers"],
    user = "1000:1000",
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["homeassistant-provisioner:latest"],
)
