"""The Home Assistant API client the provisioner images share."""

load("//devinfra/python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//homeassistant/provisioner:__subpackages__"])

py_library(
    name = "client",
    srcs = ["client.py"],
    deps = [
        ":endpoint",
        "@pypi//httpx2",
        "@pypi//pydantic",
        "@pypi//tenacity",
        "@pypi//wsproto",
    ],
)

py_library(
    name = "endpoint",
    srcs = ["endpoint.py"],
    visibility = [
        "//cluster/cdk8s/home_assistant:__pkg__",
        "//homeassistant/provisioner:__subpackages__",
    ],
    deps = ["@pypi//pydantic"],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    deps = [
        ":client",
        ":endpoint",
        "@pypi//httpx2",
        "@pypi//pytest",
    ],
)

py_test(
    name = "test_client",
    srcs = ["test_client.py"],
    deps = [
        ":client",
        ":conftest",
        ":endpoint",
        "//:conftest",
        "@pypi//httpx2",
        "@pypi//pydantic",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
        "@pypi//pytest_httpx2",
        "@pypi//respx",
    ],
)

py_library(
    name = "yaml_settings",
    srcs = ["yaml_settings.py"],
    visibility = [
        "//cluster/cdk8s/home_assistant:__pkg__",
        "//homeassistant/provisioner:__subpackages__",
    ],
    deps = [
        "@pypi//pydantic_settings",
        "@pypi//pyyaml",
    ],
)
