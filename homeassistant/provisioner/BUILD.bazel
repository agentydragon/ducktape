# gazelle:ignore
"""Home Assistant onboarding provisioner OCI image."""

# Home Assistant deps use the separate @pypi_homeassistant hub.

load("@aspect_rules_py//py:defs.bzl", "py_image_layer", aspect_py_binary = "py_binary")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("//devinfra/python:defs.bzl", "py_library", "py_test")
load("//props:oci.bzl", "py_image_entrypoint", "py_image_env")

py_library(
    name = "settings",
    srcs = ["settings.py"],
    imports = ["."],
    visibility = ["//visibility:public"],
    deps = [
        "@pypi_homeassistant//pydantic",
        "@pypi_homeassistant//pydantic_settings",
        "@pypi_homeassistant//pyyaml",
    ],
)

py_library(
    name = "component_installer",
    srcs = ["component_installer.py"],
    imports = ["."],
    deps = [":settings"],
)

py_library(
    name = "provision",
    srcs = ["provision.py"],
    imports = ["."],
    visibility = ["//visibility:public"],
    deps = [
        ":component_installer",
        ":settings",
        "@pypi_homeassistant//aiohttp",
    ],
)

py_library(
    name = "test_support",
    testonly = True,
    srcs = ["test_support.py"],
    imports = ["."],
    deps = [":settings"],
)

py_test(
    name = "test_provision",
    srcs = ["test_provision.py"],
    imports = ["."],
    deps = [
        ":provision",
        ":test_support",
        "//:conftest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_component_installer",
    srcs = ["test_component_installer.py"],
    imports = ["."],
    deps = [
        ":component_installer",
        ":test_support",
        "//:conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_settings",
    srcs = ["test_settings.py"],
    imports = ["."],
    deps = [
        ":settings",
        ":test_support",
        "//:conftest",
        "@pypi//pytest",
        "@pypi//pytest_bazel",
    ],
)

aspect_py_binary(
    name = "provision_bin",
    main = "provision.py",
    deps = [":provision"],
)

py_image_layer(
    name = "layers",
    binary = ":provision_bin",
    group = "1000",
    owner = "1000",
)

oci_image(
    name = "image",
    base = "@debian_trixie_slim_linux_amd64",
    entrypoint = py_image_entrypoint("provision_bin"),
    env = py_image_env(binary_name = "provision_bin"),
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tars = [":layers"],
    user = "1000:1000",
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["homeassistant-provisioner:latest"],
)
