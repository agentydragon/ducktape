"""Home Assistant API proxy — per-token entity access control."""

load("@aspect_rules_py//py:defs.bzl", "py_image_layer", aspect_py_binary = "py_binary")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("//devinfra/python:defs.bzl", "py_binary", "py_library", "py_test")
load("//props:oci.bzl", "py_image_entrypoint", "py_image_env")

# =============================================================================
# Library targets (one per .py file)
# =============================================================================

py_library(
    name = "config",
    srcs = ["config.py"],
    deps = [
        "@pypi//pydantic",
        "@pypi//pyyaml",
    ],
)

py_library(
    name = "policy",
    srcs = ["policy.py"],
    deps = [
        ":config",
        "@pypi//hass_client",
    ],
)

py_library(
    name = "proxy",
    srcs = ["proxy.py"],
    deps = [
        ":config",
        ":policy",
        "@pypi//fastapi",
        "@pypi//httpx",
        "@pypi//uvicorn",
    ],
)

# =============================================================================
# Binary target
# =============================================================================

py_binary(
    name = "homeassistant_proxy",
    main_module = "homeassistant.proxy.proxy",
    deps = [":proxy"],
)

# =============================================================================
# OCI Image
# =============================================================================

aspect_py_binary(
    name = "homeassistant_proxy_bin",
    main = "proxy.py",
    deps = [":proxy"],
)

py_image_layer(
    name = "layers",
    binary = ":homeassistant_proxy_bin",
    group = "1000",
    owner = "1000",
)

oci_image(
    name = "image",
    base = "@debian_slim_linux_amd64",
    entrypoint = py_image_entrypoint("homeassistant_proxy_bin"),
    env = py_image_env(binary_name = "homeassistant_proxy_bin"),
    labels = {"org.opencontainers.image.source": "https://github.com/agentydragon/ducktape"},
    tags = ["ghcr_push"],
    tars = [":layers"],
    user = "1000:1000",
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["homeassistant-proxy:latest"],
)

# =============================================================================
# Tests
# =============================================================================

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
)

py_test(
    name = "test_policy",
    srcs = ["test_policy.py"],
    deps = [
        ":config",
        ":conftest",
        ":policy",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_proxy",
    srcs = ["test_proxy.py"],
    deps = [
        ":config",
        ":conftest",
        ":policy",
        ":proxy",
        "@pypi//httpx",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",
        "@pypi//pytest_bazel",
        "@pypi//respx",
    ],
)
