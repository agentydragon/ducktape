load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("//tools/lint:linters.bzl", "ruff_test")

py_library(
    name = "rspcache",
    srcs = [
        "__init__.py",
        "admin_app.py",
        "cli.py",
        "codegen.py",
        "events.py",
        "models.py",
        "responses_db.py",
    ],
    imports = [".."],
    visibility = ["//visibility:public"],
    deps = [
        "//openai_utils:model",
        "@pypi//asyncpg",
        "@pypi//canonicaljson",
        "@pypi//fastapi",
        "@pypi//httpx",
        "@pypi//openai",
        "@pypi//pydantic",
        "@pypi//pyyaml",
        "@pypi//sqlalchemy",
        "@pypi//typer",
        "@pypi//uvicorn",
    ],
)

py_binary(
    name = "rspcache_cli",
    srcs = ["cli.py"],
    imports = [".."],
    main = "cli.py",
    visibility = ["//:__subpackages__"],
    deps = [
        ":__init__",
        "@pypi//httpx",
        "@pypi//typer_slim",
        "@pypi//uvicorn",
    ],
)

ruff_test(
    name = "ruff",
    srcs = [":rspcache"],
)

# --- OCI Image ---

pkg_tar(
    name = "cli_tar",
    srcs = [":rspcache_cli"],
    include_runfiles = True,
    package_dir = "/app",
    strip_prefix = ".",
)

oci_image(
    name = "image",
    base = "@python_slim_linux_amd64",
    cmd = [
        "run",
        "--app",
        "proxy",
        "--host",
        "0.0.0.0",
        "--port",
        "8000",
    ],
    entrypoint = ["/app/rspcache_cli"],
    env = {
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONUNBUFFERED": "1",
    },
    exposed_ports = [
        "8000/tcp",
        "8100/tcp",
    ],
    tars = [":cli_tar"],
    workdir = "/opt/adgn",
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["rspcache:latest"],
)

py_library(
    name = "__init__",
    srcs = ["__init__.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "@pypi//canonicaljson",
        "@pypi//fastapi",
        "@pypi//httpx",
        "@pypi//openai",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "admin_app",
    srcs = ["admin_app.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":__init__",
        "//openai_utils:model",
        "@pypi//asyncpg",
        "@pypi//fastapi",
        "@pypi//openai",
        "@pypi//pydantic",
    ],
)

py_binary(
    name = "codegen",
    srcs = ["codegen.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":__init__",
        "@pypi//fastapi",
        "@pypi//httpx",
        "@pypi//pyyaml",
    ],
)

py_library(
    name = "events",
    srcs = ["events.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":__init__",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "models",
    srcs = ["models.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "@pypi//openai",
        "@pypi//pydantic",
    ],
)

py_library(
    name = "responses_db",
    srcs = ["responses_db.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":__init__",
        "@pypi//asyncpg",
        "@pypi//openai",
        "@pypi//pydantic",
        "@pypi//sqlalchemy",
    ],
)
