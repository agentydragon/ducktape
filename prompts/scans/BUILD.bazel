"""Standalone codebase scanning scripts (stdlib only)."""

load("@rules_python//python:defs.bzl", "py_library")
load("//devinfra/python:defs.bzl", "py_binary")

py_library(
    name = "scan_comments",
    srcs = ["scan_comments.py"],
)

py_binary(
    name = "scan_comments_bin",
    main_module = "prompts.scans.scan_comments",
    visibility = ["//:__subpackages__"],
    deps = [":scan_comments"],
)

