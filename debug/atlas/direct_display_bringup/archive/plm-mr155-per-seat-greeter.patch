+// The variables specific to this helper's seat: the daemon sets the first four,
+// pam_systemd sets XDG_SESSION_ID. Written to the per-instance environment file
+// AND dropped from our environment before the shared-manager broadcast.
+// XDG_SESSION_ID keys each seat's kwin to its own logind session (kwin resolves
+// it when choosing the session to TakeControl of, defaulting to "auto"); without
+// it the greeter kwins race for one session and the losers run with no input
+// devices. The adopted session also seat-filters GPUs, so no device pinning.
+static constexpr const char *perSeatVars[] = {"SDDM_SOCKET", "XDG_SEAT", "XDG_SEAT_PATH", "XDG_VTNR", "XDG_SESSION_ID"};
+
+// Write the per-seat environment file that this seat's templated units load via
+// EnvironmentFile=. It carries the variables that must stay off the shared user
+// manager: the daemon's per-seat socket/seat/VT and the helper's logind session.
+static void writeInstanceEnvFile(const QString &seat)
+{
+    const QString runtimeDir = qEnvironmentVariable("XDG_RUNTIME_DIR");
+    if (runtimeDir.isEmpty()) {
+        qWarning() << "XDG_RUNTIME_DIR is not set; cannot write per-seat environment file";
+        return;
+    }
+
+    const QString dir = runtimeDir + QLatin1String("/plasma-login");
+    if (!QDir().mkpath(dir)) {
+        qWarning() << "Could not create" << dir;
+        return;
+    }
+
+    QSaveFile file(dir + QLatin1Char('/') + seat + QLatin1String(".env"));
+    if (!file.open(QIODevice::WriteOnly | QIODevice::Truncate)) {
+        qWarning() << "Could not open" << file.fileName() << ':' << file.errorString();
+        return;
+    }
+
+    QTextStream stream(&file);
+    const auto writeVar = [&stream](const char *name) {
+        if (qEnvironmentVariableIsSet(name)) {
+            stream << QLatin1String(name) << QLatin1Char('=') << qEnvironmentVariable(name) << QLatin1Char('\n');
+        }
+    };
+    for (const char *name : perSeatVars) {
+        writeVar(name); // XDG_VTNR is set (and written) on seat0 only
+    }
+
+    stream.flush();
+    if (stream.status() != QTextStream::Ok) {
+        // A write error would leave a truncated file (e.g. missing SDDM_SOCKET).
+        // Discard it so the units fail loudly on the absent EnvironmentFile rather
+        // than starting a greeter that silently cannot reach the daemon.
+        file.cancelWriting();
+        qWarning() << "Failed to write per-seat environment file" << file.fileName();
+    } else if (!file.commit()) {
+        qWarning() << "Failed to commit per-seat environment file" << file.fileName();
+    }
