@@ -0,0 +1,17 @@
+[Unit]
+Description=Plasma Login
+PartOf=plasma-login-wayland@%i.target
+After=plasma-login-kwin_wayland@%i.service
+
+[Service]
+Environment=WAYLAND_DISPLAY=wayland-login-%i
+EnvironmentFile=%t/plasma-login/%i.env
+# Dropping BusName=org.kde.KWin removed the Type=dbus readiness barrier (two
+# compositors cannot own one name on the shared user bus). Wait for this seat's
+# compositor socket instead; QT_WAYLAND_RECONNECT only covers a lost connection,
+# not the first connect. TimeoutStartSec bounds the wait so a missing compositor
+# fails loudly instead of hanging (the manager default can be infinity).
+ExecStartPre=/bin/sh -c 'while [ ! -S %t/wayland-login-%i ]; do sleep 0.1; done'
+TimeoutStartSec=30
+ExecStart=@CMAKE_INSTALL_FULL_LIBEXECDIR@/plasma-login-greeter
+Slice=session.slice
