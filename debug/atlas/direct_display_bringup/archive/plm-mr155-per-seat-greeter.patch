+[Unit]
+Description=Plasma Wallpaper on Login screen
+PartOf=plasma-login-wayland@%i.target
+After=plasma-login-kwin_wayland@%i.service
+
+[Service]
+Environment=WAYLAND_DISPLAY=wayland-login-%i
+EnvironmentFile=%t/plasma-login/%i.env
+# Wait for this seat's compositor socket in place of the dropped Type=dbus
+# readiness barrier; QT_WAYLAND_RECONNECT only covers a lost connection, not the
+# first connect. TimeoutStartSec bounds the wait so a missing compositor fails
+# loudly instead of hanging (the manager default can be infinity).
+ExecStartPre=/bin/sh -c 'while [ ! -S %t/wayland-login-%i ]; do sleep 0.1; done'
+TimeoutStartSec=30
+ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/plasma-login-wallpaper
+Slice=background.slice
diff --git a/src/frontend/wallpaper/wallpaperapp.cpp b/src/frontend/wallpaper/wallpaperapp.cpp
index 6ea7985..862e21e 100644
--- a/src/frontend/wallpaper/wallpaperapp.cpp
+++ b/src/frontend/wallpaper/wallpaperapp.cpp
@@ -25,6 +25,27 @@
 
 #include "wallpaperapp.h"
 
+// Per-seat wallpaper service name (bug 520483). A D-Bus name element allows only
+// [A-Za-z0-9_], but seat names can contain '-' (e.g. "seat-two"), so map every
+// non-alphanumeric character to '_'. The greeter's BlurScreenBridge sanitizes
+// identically so both ends agree on the name.
+static QString wallpaperServiceName()
+{
+    const QString seat = qEnvironmentVariable("XDG_SEAT");
+    if (seat.isEmpty()) {
+        return QStringLiteral("org.kde.plasma.wallpaper");
+    }
+    QString element = seat;
+    for (QChar &c : element) {
+        const char16_t u = c.unicode();
+        const bool allowed = (u >= 'a' && u <= 'z') || (u >= 'A' && u <= 'Z') || (u >= '0' && u <= '9');
+        if (!allowed) {
+            c = QLatin1Char('_');
+        }
+    }
+    return QStringLiteral("org.kde.plasma.wallpaper.") + element;
+}
+
 WallpaperApp::WallpaperApp(int &argc, char **argv)
     : QGuiApplication(argc, argv)
 {
@@ -39,8 +60,11 @@ WallpaperApp::WallpaperApp(int &argc, char **argv)
 
     auto bus = QDBusConnection::sessionBus();
     bus.registerObject(QStringLiteral("/Wallpaper"), this, QDBusConnection::ExportScriptableSlots);
-    if (!bus.registerService(QStringLiteral("org.kde.plasma.wallpaper"))) {
-        qWarning() << "Failed to register DBus service org.kde.plasma.wallpaper:" << bus.lastError().message();
+    // One plasmalogin user runs a wallpaper per seat on the shared bus, so a single
+    // well-known name would collide and the losing seat's blur would go dark.
+    const QString serviceName = wallpaperServiceName();
+    if (!bus.registerService(serviceName)) {
+        qWarning() << "Failed to register DBus service" << serviceName << ':' << bus.lastError().message();
     }
 }
 
