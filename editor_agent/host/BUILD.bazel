"""Editor agent host package."""

load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("//tools/lint:linters.bzl", "ruff_test")

# Init script for the container image (called as /init)
filegroup(
    name = "init_script",
    srcs = ["definition/init"],
    visibility = ["//editor_agent/runtime:__pkg__"],
)

py_library(
    name = "editor_agent_host",
    srcs = [
        "__init__.py",
        "agent_runner.py",
        "cli.py",
        "runner.py",
        "submit_server.py",
    ],
    data = glob(["definition/**/*"]),
    imports = ["../.."],
    visibility = ["//visibility:public"],
    deps = [
        "//agent_core",
        "//agent_core:mcp_provider",
        "//agent_pkg/host:bootstrap_handler",
        "//agent_pkg/host:builder",
        "//agent_pkg/host:init_runner",
        "//cli_util",
        "//editor_agent/runtime:editor_agent_runtime",
        "//mcp_infra",
        "//mcp_infra/compositor",
        "//mcp_infra/display",
        "//mcp_infra/exec:docker",
        "//mcp_infra/resources",
        "//net_util",
        "//openai_utils",
        "@pypi//aiodocker",
        "@pypi//fastmcp",
        "@pypi//typer",
    ],
)

py_binary(
    name = "adgn-editor-docker",
    srcs = ["cli.py"],
    imports = ["../.."],
    main = "cli.py",
    visibility = ["//:__subpackages__"],
    deps = [
        "//agent_pkg/host:builder",
        "//cli_util",
        "//openai_utils",
        "@pypi//aiodocker",
        "@pypi//typer_slim",
    ],
)

py_test(
    name = "test_runner_session",
    srcs = ["test_runner_session.py"],
    data = ["//editor_agent/runtime:load"],
    imports = ["../.."],
    tags = ["requires_docker"],
    deps = [
        ":conftest",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",  # keep
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_editor_e2e_steps",
    srcs = ["test_editor_e2e_steps.py"],
    data = ["//editor_agent/runtime:load"],
    imports = ["../.."],
    tags = ["requires_docker"],
    deps = [
        ":conftest",
        "//agent_core_testing",
        "@pypi//pyhamcrest",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",  # keep
        "@pypi//pytest_bazel",
    ],
)

py_test(
    name = "test_submit_server",
    srcs = ["test_submit_server.py"],
    imports = ["../.."],
    deps = [
        ":conftest",
        "@pypi//fastmcp",
        "@pypi//pytest",
        "@pypi//pytest_asyncio",  # keep
        "@pypi//pytest_bazel",
    ],
)

ruff_test(
    name = "ruff",
    srcs = [":editor_agent_host"],
)

py_library(
    name = "__init__",
    srcs = ["__init__.py"],
    visibility = ["//:__subpackages__"],
)

py_library(
    name = "agent_runner",
    srcs = ["agent_runner.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//agent_core",
        "//agent_core:mcp_provider",
        "//agent_pkg/host:init_runner",
        "//openai_utils",
        "@pypi//aiodocker",
        "@pypi//fastmcp",
    ],
)

py_library(
    name = "runner",
    srcs = ["runner.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//mcp_infra",
        "//mcp_infra/exec:docker",
        "//net_util",
        "@pypi//aiodocker",
        "@pypi//fastmcp",
    ],
)

py_library(
    name = "submit_server",
    srcs = ["submit_server.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//mcp_infra",
        "//openai_utils",
        "@pypi//fastmcp",
    ],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//test_util",
        "@pypi//pytest",
    ],
)
