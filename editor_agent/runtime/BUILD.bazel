load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("//tools/oci:defs.bzl", "dedup_python_tar")

# NOTE: No aggregator target - use specific per-file targets like :cli, :constants
# This is the Gazelle-compatible pattern (python_generation_mode = file)

py_library(
    name = "cli",
    srcs = ["cli.py"],
    data = glob(["docs/**/*.md"]),
    imports = ["../.."],
    visibility = ["//:__subpackages__"],
    deps = [
        ":constants",
        "//agent_pkg/runtime:mcp",
        "//agent_pkg/runtime:output",
        "//cli_util:decorators",
        "//cli_util:logging",
        "@pypi//typer",
    ],
)

py_binary(
    name = "editor_submit",
    srcs = ["cli.py"],
    imports = ["../.."],
    main = "cli.py",
    visibility = ["//:__subpackages__"],
    deps = [
        ":constants",
        "//agent_pkg/runtime:mcp",
        "//agent_pkg/runtime:output",
        "//cli_util:decorators",
        "//cli_util:logging",
        "@pypi//typer_slim",
    ],
)

# --- OCI Image ---

# Package the py_binary and its runfiles into /app
pkg_tar(
    name = "editor_submit_tar_raw",
    srcs = [":editor_submit"],
    include_runfiles = True,
    package_dir = "/app",
    strip_prefix = ".",
)

dedup_python_tar(
    name = "editor_submit_tar",
    src = ":editor_submit_tar_raw",
)

# Tar with /init symlink pointing to the py_binary.
# The host framework calls `/init` via docker exec (see agent_pkg.host.builder).
pkg_tar(
    name = "init_symlink_tar",
    symlinks = {"/init": "/app/editor_submit"},
)

# OCI image: distroless base + Python app + /init symlink
oci_image(
    name = "image",
    base = "@distroless_cc_linux_amd64",
    cmd = ["init"],
    entrypoint = ["/app/editor_submit"],
    env = {
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONUNBUFFERED": "1",
    },
    tars = [
        ":editor_submit_tar",
        ":init_symlink_tar",
    ],
    workdir = "/workspace",
)

# Load image into local Docker daemon
# Run: bazel run //editor_agent/runtime:load
# For tarball: bazel build //editor_agent/runtime:load --output_groups=+tarball
oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["adgn-editor:latest"],
    visibility = ["//visibility:public"],
)

py_library(
    name = "constants",
    srcs = ["constants.py"],
    visibility = ["//:__subpackages__"],
)
