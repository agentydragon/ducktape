load("@aspect_bazel_lib//lib:copy_file.bzl", "copy_file")
load("@aspect_rules_ts//ts:proto.bzl", "ts_proto_library")
load("//devinfra/python:proto.bzl", "py_proto_library_with_mypy_stubs")
load("@protobuf//bazel:proto_library.bzl", "proto_library")

package(default_visibility = ["//visibility:public"])

# gazelle:proto disable

# Keep the upstream import path for protos that need local bindings as well as Go genproto.
copy_file(
    name = "status_source",
    src = "@googleapis//google/rpc:status.proto",
    out = "status.proto",
)

proto_library(
    name = "status_proto",
    srcs = [":status_source"],
    deps = ["@protobuf//:any_proto"],
)

py_proto_library_with_mypy_stubs(
    name = "status_pb2",
    deps = [":status_proto"],
)

ts_proto_library(
    name = "status_pb",
    copy_files = False,
    node_modules = "//:node_modules",
    proto = ":status_proto",
)
