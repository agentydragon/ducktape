#!/bin/bash
# crun wrapper for gVisor environments
#
# gVisor doesn't provide /proc/self/setgroups, which crun tries to open
# when setting up containers. The OCI annotation run.oci.keep_original_groups=1
# tells crun to skip this step.
#
# This wrapper intercepts crun invocations, finds the OCI bundle directory,
# and injects the annotation into config.json before delegating to real crun.
#
# Usage:
#   podman build --runtime /path/to/crun-gvisor-wrapper -t image .
#   podman run --runtime /path/to/crun-gvisor-wrapper image cmd

BUNDLE_DIR=""
for i in $(seq 1 $#); do
    if [ "${!i}" = "--bundle" ] || [ "${!i}" = "-b" ]; then
        j=$((i + 1))
        BUNDLE_DIR="${!j}"
        break
    fi
done

if [ -n "$BUNDLE_DIR" ] && [ -f "$BUNDLE_DIR/config.json" ]; then
    python3 -c "
import json
p = '$BUNDLE_DIR/config.json'
with open(p) as f: c = json.load(f)
c.setdefault('annotations', {})['run.oci.keep_original_groups'] = '1'
with open(p, 'w') as f: json.dump(c, f)
" 2>/dev/null
fi

exec /usr/bin/crun "$@"
