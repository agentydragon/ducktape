load("@rules_rust//rust:defs.bzl", "rust_binary")

rust_binary(
    name = "process_api_re",
    srcs = [
        "src/adopter.rs",
        "src/cgroup.rs",
        "src/control_server.rs",
        "src/firecracker_init.rs",
        "src/io.rs",
        "src/main.rs",
        "src/oom_killer.rs",
        "src/pid_tree.rs",
        "src/proc_handle.rs",
        "src/state.rs",
