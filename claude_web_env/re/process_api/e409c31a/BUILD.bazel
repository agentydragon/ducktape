    # To match: rustflags = ["-C", "target-feature=+crt-static"]
    visibility = ["//visibility:public"],
    deps = [
        "@crates//:bytes",
        "@crates//:clap",
        "@crates//:env_logger",
        "@crates//:futures",
        "@crates//:http",
        "@crates//:http-body-util",
        "@crates//:hyper",
        "@crates//:hyper-util",
        "@crates//:libc",
        "@crates//:log",
        "@crates//:nix",
        "@crates//:parking_lot",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:tokio",
        "@crates//:tokio-tungstenite",
        # New dependencies in e409c31a:
        # "@crates//:tokio-vsock",     # vsock support (tokio-vsock 0.7.2)
        # "@crates//:jsonwebtoken",    # JWT auth token validation (jsonwebtoken 9.3.1)
    ],
)
